/**
 * AC-033 (FR-021 browser clause, SM-3): a processing whose route response is
 * delayed — the fake provider holds the request (`pause`) until the test
 * releases it — never shows a draft or a note of the previous scope:
 *   1. when the member signs out and an account of ANOTHER company signs in
 *      (in another tab of the same browser) before the response arrives;
 *   2. when the member is removed from the company before it arrives (the
 *      route rechecks membership before returning a draft; the browser
 *      drops whatever comes back).
 * The member is a dedicated account of company A (notesWorld), so signing it
 * out or removing it never touches the shared seed accounts. A page-wide
 * observer records whether a draft review was rendered at any moment.
 */

async function signedInMember(
  browser: Browser,
  world: MeetingNotesE2EWorld,
  label: string,
): Promise<{ context: BrowserContext; page: Page; member: { email: string; password: string; userId: string }; 
verifyTraffic: () => void }> {
  const member = await world.createCompanyAccount(label);
  const context = await browser.newContext();
  const page = await context.newPage();
  const verifyTraffic = guardLocalSupabaseTraffic(page, label);
  await closePlacementToasts(page);
  await login(page, member.email, member.password);
  return { context, page, member, verifyTraffic };
}

function delayedDraft(tag: string) {
  const draftText = `Company A draft ${tag}`;
  return {
    draftText,
    outcome: {
      kind: 'pause' as const,
      then: successOutcome({
        summary: { keyPoints: [draftText], decisions: [], nextSteps: [] },
        actionItems: [{ description: `Company A item ${tag}`, assigneeName: null }],
      }),
    },
  };
}

