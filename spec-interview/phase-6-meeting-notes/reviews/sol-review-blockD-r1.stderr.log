// is replaced; auth.getUser(), RLS, RPCs, and the fake provider are real.
export async function cookies() {
  const current = globalThis.__meetingNotesChildCookies ?? [];
  return {
    getAll: () => current.map(({ name, value }) => ({ name, value })),
    set: () => undefined,
  };
