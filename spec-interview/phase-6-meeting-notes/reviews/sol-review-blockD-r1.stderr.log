  const [editing, setEditing] = useState<MeetingNoteDetail | null>(null);
  const detail = useMeetingNoteDetail(noteId, !deleted);
  // Kept here (not in the panel) so a draft survives opening the edit form.
  const aiFlow = useMeetingNoteAiFlow(noteId);

  useEffect(() => {
    // The query is disabled once deleted, so dropping it cannot trigger a refetch.
    if (deleted && scope) removeMeetingNoteQueries(queryClient, scope, noteId);
  }, [deleted, noteId, queryClient, scope]);

  const back = (
    <Button asChild variant="ghost" size="sm" className="-ml-2 h-8 w-fit gap-1.5">
      <Link href={MEETINGS_PATH}>
        <ArrowLeft className="size-4" aria-hidden="true" />
        Meetings
      </Link>
    </Button>
  );

  if (deleted) {
    return (
      <div className="flex max-w-4xl flex-col gap-4">
        {back}
        <p className="text-sm text-muted-foreground" role="status">
          This note was deleted. Opening Meetings…
        </p>
      </div>
    );
  }

  if (detail.isPending) {
    return (
      <div className="flex max-w-4xl flex-col gap-4">
        {back}
        <p className="flex items-center gap-2 text-sm text-muted-foreground" role="status">
          <Loader2 className="size-4 animate-spin" aria-hidden="true" />
          Loading note…
        </p>
      </div>
    );
  }

  const missing = detail.isError && detail.error instanceof MeetingNotesApiError && detail.error.status === 404;
  // A failed refresh of a note already on screen is shown next to it; it
  // never unmounts an open editor and its unsaved draft (block B review B-3).
  const refreshError =
    detail.isError && !missing ? (
      <div
        className="flex flex-wrap items-center gap-3 rounded-md border border-destructive/40 bg-destructive/10 px-3 
py-2 text-sm text-destructive"
        role="alert"
        data-testid="meeting-note-refresh-error"
      >
        <span className="min-w-0 flex-1">The latest version could not be loaded. 
{describeMeetingNoteError(detail.error)}</span>
        <Button type="button" size="sm" variant="outline" onClick={() => void detail.refetch()}>
          Try again
        </Button>
      </div>
    ) : null;

  if (editing) {
    return (
      <div className="flex max-w-4xl flex-col gap-4">
        <h2 className="text-lg font-semibold">Edit meeting note</h2>
        {missing ? (
          <p
            className="rounded-md border border-destructive/40 bg-destructive/10 px-3 py-2 text-sm text-destructive"
            role="alert"
            data-testid="meeting-note-refresh-error"
          >
            This note may have been deleted, or you no longer have access to it. Copy anything you still need.
          </p>
        ) : (
          refreshError
        )}
        <div className="rounded-xl border border-[var(--vo-line-soft)] bg-card p-6">
          <MeetingNoteEditPanel
            note={editing}
            onCancel={() => setEditing(null)}
            onSaved={() => {
              setEditing(null);
              showSuccess({ description: 'Changes saved.' });
            }}
          />
        </div>
      </div>
    );
  }

  if (detail.isError && (missing || detail.data === undefined)) {
    return (
      <div className="flex max-w-4xl flex-col gap-4">
        {back}
        <div className="rounded-xl border border-[var(--vo-line-soft)] bg-card p-6" role="alert" 
data-testid="meeting-note-unavailable">
          <p className="font-medium">{missing ? 'Meeting note not found' : 'The note could not be loaded'}</p>
          <p className="mt-1 text-sm text-muted-foreground">
            {missing
              ? 'It may have been deleted, or it belongs to another company.'
              : describeMeetingNoteError(detail.error)}
          </p>
          {missing ? null : (
            <Button type="button" size="sm" variant="outline" className="mt-3" onClick={() => void detail.refetch()}>
              Try again
            </Button>
          )}
        </div>
      </div>
    );
  }

  const note = detail.data;
  if (!note) return null;

  return (
    <div className="flex max-w-4xl flex-col gap-4">
      {back}
      {refreshError}
      <article
        className="flex flex-col gap-6 rounded-xl border border-[var(--vo-line-soft)] bg-card p-6"
        data-testid="meeting-note-view"
        data-note-id={note.id}
        data-revision={note.revision}
      >
        <header className="flex flex-col gap-3">
          <div className="flex flex-wrap items-start justify-between gap-3">
            <h2 className="min-w-0 break-words text-2xl font-semibold" data-testid="meeting-note-title">
              {note.title}
            </h2>
            <div className="flex flex-wrap items-center gap-2" data-testid="meeting-note-actions">
              {note.rights.canEdit ? (
                <Button
                  type="button"
                  size="sm"
                  className="gap-1.5"
                  onClick={() => setEditing(note)}
                  data-testid="meeting-note-edit-button"
                >
                  <Pencil className="size-4" aria-hidden="true" />
                  Edit
                </Button>
              ) : null}
              <MeetingNoteHistoryDialog note={note} />
              {note.rights.canDelete ? <MeetingNoteDeleteButton note={note} onDeleted={() => setDeleted(true)} /> : 
null}
              <MeetingNoteExportControls note={note} />
            </div>
          </div>
          <p className="flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-muted-foreground">
            <time dateTime={note.meetingDate} data-testid="meeting-note-date">
              {formatMeetingDate(note.meetingDate)}
            </time>
            <span aria-hidden="true">·</span>
            {note.spaceName === null ? (
              <Badge variant="outline" className="text-[11px]" data-testid="meeting-note-space-removed">
                Space removed
              </Badge>
            ) : (
              <span data-testid="meeting-note-space">{note.spaceName}</span>
            )}
            <span aria-hidden="true">·</span>
            <span data-testid="meeting-note-author">By {note.authorName}</span>
          </p>
          <p className="text-xs text-muted-foreground">
            Revision {note.revision} · Updated {formatMeetingNoteTimestamp(note.updatedAt)}
          </p>
        </header>

        <Section title="Participants">
          <MeetingNoteParticipantList participants={note.participants} />
        </Section>

        <Section title="Notes">
          <MeetingNoteContent html={note.content} emptyText="No notes written yet." />
        </Section>

        <Section title="Summary" testId="meeting-note-summary">
          {note.summary ? (
            <p className="whitespace-pre-wrap break-words text-sm leading-relaxed">{note.summary}</p>
          ) : (
            <p className="text-sm text-muted-foreground">No summary yet.</p>
          )}
        </Section>

        {note.rights.canEdit ? (
          <Section title="AI draft" testId="meeting-note-ai-section">
            <MeetingNoteAiPanel note={note} flow={aiFlow} />
          </Section>
        ) : null}

        <Section title="Action items" testId="meeting-note-action-items-section">
          <MeetingNoteActionItems note={note} />
        </Section>

        <Section title="Transcript" testId="meeting-note-transcript-section">
          <MeetingNoteTranscriptSection noteId={note.id} transcriptId={note.transcriptId} />
          {note.rights.canEdit ? <MeetingNoteTranscriptUpload mode="attach" note={note} /> : null}
        </Section>
      </article>
    </div>
  );
}
// src/components/meeting-notes/MeetingNoteTranscriptUpload.tsx
// Transcript file pickers (Phase 6 FR-012, FR-013, J5/J6):
//   * mode "create" — "New note from transcript" in a space: the note is
//     created at upload (title = file name, date = today) and its view opens;
//   * mode "attach" — "Attach transcript" / "Replace transcript" on a note
//     (editors only): replaces the stored transcript immediately, against the
//     note's revision (409 → the newer note is shown; try again on it).
// The browser pre-checks extension, emptiness, and size (≤1 MB) to answer
// fast; the route stays the authority (UTF-8/binary checks, limits) and its
// refusal is shown as is. Every request runs through the scope fence. The
// button carries data-space-action so a parent clickable surface (space
// detail panel) never treats it as navigation.
'use client';

import { useRouter } from 'next/navigation';
import { FileUp, Loader2 } from 'lucide-react';
import { useId, useRef, useState, type ChangeEvent } from 'react';

import { Button } from '@/components/ui/button';
import {
  useAttachMeetingNoteTranscript,
  useCreateMeetingNoteFromTranscript,
} from '@/hooks/mutations/useMeetingNoteTranscriptMutations';
import { useNotification } from '@/hooks/useNotification';
import { MeetingNoteConflictError, MeetingNotesApiError } from '@/lib/meeting-notes/client-api';
import { describeMeetingNoteError } from '@/lib/meeting-notes/form-errors';
import { meetingNotePath } from '@/lib/meeting-notes/ui-paths';
import { MEETING_NOTE_TRANSCRIPT_LIMITS } from '@/lib/meeting-notes/validation';
import type { MeetingNoteDetail } from '@/types/meeting-notes';

export type MeetingNoteTranscriptUploadProps =
  | { mode: 'create'; spaceId: string; spaceName: string; className?: string }
  | { mode: 'attach'; note: MeetingNoteDetail; className?: string };

const ACCEPT = [...MEETING_NOTE_TRANSCRIPT_LIMITS.extensions, 'text/plain', 'text/vtt'].join(',');

/** A message when the file is certainly refused; null to let the route decide. */
function precheck(file: File): string | null {
  const name = file.name.toLowerCase();
  if (!MEETING_NOTE_TRANSCRIPT_LIMITS.extensions.some((extension) => name.endsWith(extension))) {
    return 'The transcript must be a .txt, .vtt, or .srt file.';
  }
  if (file.size === 0) return 'The transcript file is empty.';
  if (file.size > MEETING_NOTE_TRANSCRIPT_LIMITS.maxBytes) return 'The transcript file must be at most 1 MB.';
  return null;
}

function describeUploadError(error: unknown): string {
  if (error instanceof MeetingNoteConflictError) {
    return 'This note was changed by someone else. The latest version is shown; attach the transcript again if you 
still want to replace it.';
  }
  if (error instanceof MeetingNotesApiError && error.code.startsWith('MEETING_NOTE_TRANSCRIPT_')) return error.message;
  if (error instanceof MeetingNotesApiError && error.status === 413) return 'The transcript file must be at most 1 
MB.';
  return describeMeetingNoteError(error);
}

export function MeetingNoteTranscriptUpload(props: MeetingNoteTranscriptUploadProps) {
  const router = useRouter();
  const { showSuccess } = useNotification();
  const inputRef = useRef<HTMLInputElement>(null);
  const errorId = useId();
  const [error, setError] = useState<string | null>(null);
  const create = useCreateMeetingNoteFromTranscript();
  const attach = useAttachMeetingNoteTranscript();
  const pending = create.isPending || attach.isPending;

  const onFile = (event: ChangeEvent<HTMLInputElement>) => {
    const file = event.target.files?.[0] ?? null;
    // Let the same file be chosen again after a refusal.
    event.target.value = '';
    if (!file) return;
    const refused = precheck(file);
    if (refused) {
      setError(refused);
      return;
    }
    setError(null);
    if (props.mode === 'create') {
      create.mutate(
        { spaceId: props.spaceId, file },
        {
          onSuccess: (note) => router.push(meetingNotePath(note.id)),
          onError: (failure) => setError(describeUploadError(failure)),
        }
      );
    } else {
      attach.mutate(
        { noteId: props.note.id, expectedRevision: props.note.revision, file },
        {
          onSuccess: () => showSuccess({ description: 'Transcript attached. The previous transcript was replaced.' }),
          onError: (failure) => setError(describeUploadError(failure)),
        }
      );
    }
  };

  const label =
    props.mode === 'create'
      ? 'New note from transcript'
      : props.note.hasTranscript
        ? 'Replace transcript'
        : 'Attach transcript';
  const accessibleName = props.mode === 'create' ? `New note from transcript in ${props.spaceName}` : label;

  return (
    <div className={props.className ?? 'flex flex-col gap-1.5'} 
data-testid={`meeting-note-transcript-upload-${props.mode}`}>
      <input
        ref={inputRef}
        type="file"
        accept={ACCEPT}
        className="sr-only"
        tabIndex={-1}
        aria-hidden="true"
        onChange={onFile}
        data-testid="meeting-note-transcript-file-input"
      />
      <Button
        type="button"
        size="sm"
        variant="outline"
        className="h-8 w-fit gap-1.5"
        disabled={pending}
        aria-label={accessibleName}
        aria-describedby={error ? errorId : undefined}
        onClick={() => inputRef.current?.click()}
        data-space-action
        data-testid={props.mode === 'create' ? 'meeting-note-new-from-transcript' : 'meeting-note-attach-transcript'}
      >
        {pending ? <Loader2 className="size-3.5 animate-spin" aria-hidden="true" /> : <FileUp className="size-3.5" 
aria-hidden="true" />}
        {pending ? 'Uploading…' : label}
      </Button>
      {props.mode === 'create' ? null : (
        <p className="text-xs text-muted-foreground">.txt, .vtt, or .srt, at most 1 MB. Replaces the stored 
transcript.</p>
      )}
      {error ? (
        <p id={errorId} className="text-xs text-destructive" role="alert" 
data-testid="meeting-note-transcript-upload-error">
          {error}
        </p>
      ) : null}
    </div>
  );
}
// src/hooks/mutations/useMeetingNoteTranscriptMutations.ts
// Transcript uploads (Phase 6 FR-012, FR-013; T10 routes, T13 UI): "New note
// from transcript" creates the note at upload; "Attach transcript" replaces
// the stored transcript of a note against its revision (409 →
// MeetingNoteConflictError with the newer note). Both run through the scope
// fence (useMeetingNotesScopedMutation) and settle the viewer's meeting-note
// cache like every other note write.
'use client';

import { useQueryClient } from '@tanstack/react-query';

import {
  settleMeetingNoteCache,
  settleMeetingNoteConflictCache,
} from '@/hooks/mutations/useMeetingNoteMutations';
import { useMeetingNotesScopedMutation } from '@/hooks/mutations/useMeetingNotesScopedMutation';
import { attachMeetingNoteTranscript, createMeetingNoteFromTranscript } from '@/lib/meeting-notes/client-api';
import type { MeetingNoteDetail } from '@/types/meeting-notes';

export interface CreateMeetingNoteFromTranscriptVariables {
  spaceId: string;
  file: File;
}

export function useCreateMeetingNoteFromTranscript() {
  const queryClient = useQueryClient();
  return useMeetingNotesScopedMutation<MeetingNoteDetail, CreateMeetingNoteFromTranscriptVariables>({
    name: 'create-note-from-transcript',
    // The file leaves the MutationCache once nothing observes the call.
    gcTime: 0,
    mutationFn: ({ spaceId, file }, { signal }) => createMeetingNoteFromTranscript(spaceId, file, signal),
    onSuccess: (note, _variables, scope) => settleMeetingNoteCache(queryClient, scope, note),
  });
}

export interface AttachMeetingNoteTranscriptVariables {
  noteId: string;
  expectedRevision: number;
  file: File;
}

export function useAttachMeetingNoteTranscript() {
  const queryClient = useQueryClient();
  return useMeetingNotesScopedMutation<MeetingNoteDetail, AttachMeetingNoteTranscriptVariables>({
    name: 'attach-transcript',
    gcTime: 0,
    mutationFn: ({ noteId, expectedRevision, file }, { signal }) =>
      attachMeetingNoteTranscript(noteId, expectedRevision, file, signal),
    onSuccess: (note, _variables, scope) => settleMeetingNoteCache(queryClient, scope, note),
    onError: (error, _variables, scope) => settleMeetingNoteConflictCache(queryClient, scope, error),
  });
}
// src/components/meeting-notes/MeetingNoteAiSuggestionRow.tsx
// One suggested action item of the AI draft under review (Phase 6 FR-017,
// FR-018, AC-010, AC-027): accept checkbox (a suggestion that repeats an
// existing item arrives unchecked, marked "Already exists"), editable
// description (1–1,000 characters), assignee from the current members
// (pre-filled only when the suggested name resolved to exactly one member;
// otherwise unassigned with the suggested name as a hint), optional due date
// (calendar date, never converted through Date), and Reject / Undo. AI text
// is rendered as text only.
'use client';

import { Undo2, X } from 'lucide-react';
import { useId } from 'react';

import { Badge } from '@/components/ui/badge';
import { Button } from '@/components/ui/button';
import { Input } from '@/components/ui/input';
import { Label } from '@/components/ui/label';
import { Textarea } from '@/components/ui/textarea';
import { cn } from '@/lib/utils';
import { codePointLength, MEETING_NOTE_LIMITS } from '@/lib/meeting-notes/validation';
import type { MeetingNoteAiEditableSuggestion } from '@/hooks/ui/useMeetingNoteAiFlow';
import type { User } from '@/types/database';
import { MeetingNoteActionItemAssigneeSelect } from './MeetingNoteActionItemAssigneeSelect';

export interface MeetingNoteAiSuggestionRowProps {
  suggestion: MeetingNoteAiEditableSuggestion;
  index: number;
  members: readonly User[];
  disabled: boolean;
  onChange: (next: MeetingNoteAiEditableSuggestion) => void;
}

const DATE_ONLY = /^\d{4}-\d{2}-\d{2}$/;

function preview(text: string): string {
  const trimmed = text.trim();
  return trimmed.length > 60 ? `${trimmed.slice(0, 57)}…` : trimmed || 'empty suggestion';
}

/** Whether an accepted suggestion can be applied as written. */
export function isMeetingNoteAiSuggestionValid(suggestion: MeetingNoteAiEditableSuggestion): boolean {
  const length = codePointLength(suggestion.description.trim());
  return (
    length >= 1 &&
    length <= MEETING_NOTE_LIMITS.itemDescriptionMaxChars &&
    (suggestion.dueDate === '' || DATE_ONLY.test(suggestion.dueDate))
  );
}

export function MeetingNoteAiSuggestionRow({ suggestion, index, members, disabled, onChange }: 
MeetingNoteAiSuggestionRowProps) {
  const ids = { description: useId(), descriptionError: useId(), assignee: useId(), hint: useId(), dueDate: useId() };
  const number = index + 1;
  const length = codePointLength(suggestion.description.trim());
  const descriptionInvalid = length < 1 || length > MEETING_NOTE_LIMITS.itemDescriptionMaxChars;
  const duplicate = suggestion.duplicateOfItemId !== null;
  const state = suggestion.rejected ? 'rejected' : suggestion.accepted ? 'accepted' : 'unchecked';
  const unmatchedName =
    suggestion.suggestedAssigneeName !== null && suggestion.resolvedAssignee === null ? 
suggestion.suggestedAssigneeName : null;
  const storedAssignee = suggestion.resolvedAssignee
    ? { id: suggestion.resolvedAssignee.userId, name: suggestion.resolvedAssignee.displayName, isFormerMember: false }
    : null;

  if (suggestion.rejected) {
    return (
      <li
        className="flex items-center justify-between gap-3 rounded-lg border border-dashed 
border-[var(--vo-line-soft)] px-3 py-2"
        data-testid="meeting-note-ai-suggestion"
        data-state={state}
        data-duplicate={duplicate ? 'true' : 'false'}
      >
        <p className="min-w-0 truncate text-sm text-muted-foreground line-through">{suggestion.description}</p>
        <Button
          type="button"
          size="sm"
          variant="ghost"
          className="h-8 shrink-0 gap-1.5"
          disabled={disabled}
          aria-label={`Undo reject of suggestion ${number}: ${preview(suggestion.description)}`}
          onClick={() => onChange({ ...suggestion, rejected: false })}
          data-testid="meeting-note-ai-suggestion-undo"
        >
          <Undo2 className="size-3.5" aria-hidden="true" />
          Undo
        </Button>
      </li>
    );
  }

  return (
    <li
      className={cn(
        'flex flex-col gap-3 rounded-lg border border-[var(--vo-line-soft)] p-3',
        !suggestion.accepted && 'bg-muted/30'
      )}
      data-testid="meeting-note-ai-suggestion"
      data-state={state}
      data-duplicate={duplicate ? 'true' : 'false'}
    >
      <div className="flex flex-wrap items-center justify-between gap-2">
        <label className="flex cursor-pointer items-center gap-2 text-sm font-medium">
          <input
            type="checkbox"
            className="size-4 accent-primary"
            checked={suggestion.accepted}
            disabled={disabled}
            onChange={(event) => onChange({ ...suggestion, accepted: event.target.checked })}
            aria-label={`Accept suggestion ${number}: ${preview(suggestion.description)}`}
            data-testid="meeting-note-ai-suggestion-accept"
          />
          Accept
        </label>
        <div className="flex items-center gap-2">
          {duplicate ? (
            <Badge variant="outline" className="text-[11px]" data-testid="meeting-note-ai-suggestion-duplicate">
              Already exists
            </Badge>
          ) : null}
          <Button
            type="button"
            size="sm"
            variant="ghost"
            className="h-8 gap-1.5 text-muted-foreground"
            disabled={disabled}
            aria-label={`Reject suggestion ${number}: ${preview(suggestion.description)}`}
            onClick={() => onChange({ ...suggestion, rejected: true })}
            data-testid="meeting-note-ai-suggestion-reject"
          >
            <X className="size-3.5" aria-hidden="true" />
            Reject
          </Button>
        </div>
      </div>

      <div className="flex flex-col gap-1.5">
        <Label htmlFor={ids.description}>Description</Label>
        <Textarea
          id={ids.description}
          value={suggestion.description}
          rows={2}
          disabled={disabled}
          aria-invalid={descriptionInvalid ? 'true' : 'false'}
          aria-describedby={descriptionInvalid ? ids.descriptionError : undefined}
          onChange={(event) => onChange({ ...suggestion, description: event.target.value })}
          data-testid="meeting-note-ai-suggestion-description"
        />
        {descriptionInvalid ? (
          <p id={ids.descriptionError} className="text-xs text-destructive" role="alert">
            Enter a description of 1 to {MEETING_NOTE_LIMITS.itemDescriptionMaxChars.toLocaleString('en-US')} 
characters.
          </p>
        ) : null}
      </div>

      <div className="grid gap-3 sm:grid-cols-2">
        <div className="flex flex-col gap-1.5" data-testid="meeting-note-ai-suggestion-assignee">
          <Label htmlFor={ids.assignee}>Assignee</Label>
          <MeetingNoteActionItemAssigneeSelect
            id={ids.assignee}
            value={suggestion.assigneeId}
            members={members}
            storedAssignee={storedAssignee}
            disabled={disabled}
            describedById={unmatchedName ? ids.hint : undefined}
            onChange={(assigneeId) => onChange({ ...suggestion, assigneeId })}
          />
          {unmatchedName ? (
            <p id={ids.hint} className="text-xs text-muted-foreground" data-testid="meeting-note-ai-suggestion-hint">
              Suggested: <span>{unmatchedName}</span> (not matched to one member)
            </p>
          ) : null}
        </div>
        <div className="flex flex-col gap-1.5">
          <Label htmlFor={ids.dueDate}>Due date</Label>
          <Input
            id={ids.dueDate}
            type="date"
            className="h-9"
            value={suggestion.dueDate}
            disabled={disabled}
            onChange={(event) => onChange({ ...suggestion, dueDate: event.target.value })}
            data-testid="meeting-note-ai-suggestion-due-date"
          />
        </div>
      </div>
    </li>
  );
}
// src/components/meeting-notes/MeetingNoteAiSummaryEditor.tsx
// One section of the AI draft summary (key points, decisions, or next steps;
// Phase 6 FR-016, FR-018) as an editable list: each entry is plain text in
// its own labelled textarea, removable; entries can be added. Limits mirror
// the Apply route (at most 100 entries, each at most 2,000 characters).
'use client';

import { Plus, X } from 'lucide-react';
import { useId } from 'react';

import { Button } from '@/components/ui/button';
import { Textarea } from '@/components/ui/textarea';
import { codePointLength, MEETING_NOTE_AI_SUMMARY_LIMITS } from '@/lib/meeting-notes/validation';

export interface MeetingNoteAiSummaryEditorProps {
  /** Section key, used in test ids. */
  section: 'keyPoints' | 'decisions' | 'nextSteps';
  title: string;
  entries: string[];
  disabled: boolean;
  onChange: (entries: string[]) => void;
}

export function MeetingNoteAiSummaryEditor({ section, title, entries, disabled, onChange }: 
MeetingNoteAiSummaryEditorProps) {
  const headingId = useId();
  const full = entries.length >= MEETING_NOTE_AI_SUMMARY_LIMITS.maxEntriesPerSection;

  return (
    <fieldset className="flex flex-col gap-2" aria-labelledby={headingId} 
data-testid={`meeting-note-ai-summary-${section}`}>
      <legend id={headingId} className="text-xs font-semibold uppercase tracking-[0.08em] text-muted-foreground">
        {title}
      </legend>
      {entries.length === 0 ? <p className="text-sm text-muted-foreground">No entries.</p> : null}
      <ol className="flex flex-col gap-2">
        {entries.map((entry, index) => {
          const tooLong = codePointLength(entry) > MEETING_NOTE_AI_SUMMARY_LIMITS.maxEntryChars;
          const label = `${title} ${index + 1}`;
          return (
            <li key={index} className="flex items-start gap-2">
              <div className="flex min-w-0 flex-1 flex-col gap-1">
                <Textarea
                  value={entry}
                  rows={2}
                  aria-label={label}
                  aria-invalid={tooLong ? 'true' : 'false'}
                  disabled={disabled}
                  onChange={(event) => onChange(entries.map((value, position) => (position === index ? 
event.target.value : value)))}
                  data-testid="meeting-note-ai-summary-entry"
                />
                {tooLong ? (
                  <p className="text-xs text-destructive" role="alert">
                    At most {MEETING_NOTE_AI_SUMMARY_LIMITS.maxEntryChars.toLocaleString('en-US')} characters.
                  </p>
                ) : null}
              </div>
              <Button
                type="button"
                variant="ghost"
                size="icon"
                className="size-8 shrink-0 text-muted-foreground"
                aria-label={`Remove ${label}`}
                disabled={disabled}
                onClick={() => onChange(entries.filter((_, position) => position !== index))}
              >
                <X className="size-4" aria-hidden="true" />
              </Button>
            </li>
          );
        })}
      </ol>
      <Button
        type="button"
        variant="ghost"
        size="sm"
        className="h-8 w-fit gap-1.5"
        disabled={disabled || full}
        onClick={() => onChange([...entries, ''])}
        aria-label={`Add an entry to ${title}`}
      >
        <Plus className="size-3.5" aria-hidden="true" />
        Add entry
      </Button>
    </fieldset>
  );
}

