// src/app/api/meeting-notes/[id]/ai/process/route.ts
// Start of AI processing (Phase 6 T12; SPEC FR-015–FR-017, FR-020–FR-022,
// FR-031, BR-013).
//
// POST, body { ticket, idempotencyKey? }. In order:
//   1. origin guard, session (auth.getUser → users.supabase_uid), rate limit
//      (beginMeetingNoteMutation);
//   2. the ticket's signature and 24-hour validity (its key included) BEFORE
//      any operation lookup: an expired ticket is refused whether or not an
//      operation record still exists, and is never dispatched;
//   3. the ticket's user, company, and note must be the authenticated
//      application user's (users.id), their CURRENT company, and the path
//      note; a client-sent key must equal the ticket's;
//   4. admission, dispatch, and settlement (src/lib/meeting-notes/ai/processing.ts):
//      the service-role client is built only now, after steps 1–3, and the
//      actor passed to admission is the route's users.id.
// Responses never contain the API key, the transcript, provider text, or the
// ticket secret. A replay returns the operation's status only (operations
// keep no content). Error bodies carry a stable `code` and a sanitized
// message; provider failures carry `retryable` ("Try again" = a new ticket
// and a new admission).
import { NextRequest, NextResponse } from 'next/server';

import { MEETING_NOTE_AI_CAPABILITIES } from '@/lib/meeting-notes/ai/capabilities';
import { runMeetingNoteAiProcessing, type MeetingNoteAiProcessingOutcome } from '@/lib/meeting-notes/ai/processing';
import { MeetingNoteAiTicketConfigError, verifyMeetingNoteAiTicket } from '@/lib/meeting-notes/ai/ticket';
import type { MeetingNoteDbError } from '@/lib/meeting-notes/errors';
import {
  beginMeetingNoteMutation,
  internalError,
  meetingNoteError,
  meetingNoteErrorWithData,
  notFound,
  ok,
  parsePathId,
  parseWith,
  readJsonObject,
  type MeetingNoteRouteContext,
} from '@/lib/meeting-notes/route-support';
import { startMeetingNoteAiProcessingBodySchema } from '@/lib/meeting-notes/validation';
import { createSupabaseServerClient } from '@/lib/supabase/server-client';
import type { MeetingNoteAiProcessResponse, MeetingNoteAiProvider } from '@/types/meeting-notes';

export const dynamic = 'force-dynamic';

interface RouteParams {
  params: Promise<{ id: string }>;
}

const PATH = '/api/meeting-notes/[id]/ai/process';
/** Client closed the request (nginx convention); the browser never reads it. */
const CLIENT_CLOSED_STATUS = 499;

function num(value: unknown): number | null {
  return typeof value === 'number' && Number.isFinite(value) ? value : null;
}

function str(value: unknown): string | null {
  return typeof value === 'string' ? value : null;
}

function isProvider(value: unknown): value is MeetingNoteAiProvider {
  return typeof value === 'string' && Object.hasOwn(MEETING_NOTE_AI_CAPABILITIES, value);
}

/** Admission refusal → HTTP, with the non-sensitive hints the UI needs. */
function admissionRefusal(error: MeetingNoteDbError, ctx: MeetingNoteRouteContext): NextResponse {
  const detail = error.detail ?? {};
  switch (error.token) {
    case 'MEETING_NOTE_AI_TICKET_EXPIRED':
      return meetingNoteError(410, error.token, ctx);
    case 'MEETING_NOTE_AI_BINDING_MISMATCH':
      return meetingNoteError(409, error.token, ctx);
    case 'MEETING_NOTE_AI_NOT_CONFIGURED':
      return meetingNoteErrorWithData(409, error.token, ctx, { canConfigure: ctx.dbUser.role === 'admin' });
    case 'MEETING_NOTE_AI_SETTINGS_STALE': {
      const provider = detail.provider;
      return meetingNoteErrorWithData(409, error.token, ctx, {
        // FR-015: the NEW notice (provider name) the user must see before processing.
        settings: {
          provider: isProvider(provider) ? provider : null,
          providerLabel: isProvider(provider) ? MEETING_NOTE_AI_CAPABILITIES[provider].label : null,
          model: str(detail.model),
          reasoningLevel: str(detail.reasoning_level),
          revision: num(detail.current_revision),
        },
      });
    }
    case 'MEETING_NOTE_AI_SOURCE_STALE':
      return meetingNoteErrorWithData(409, error.token, ctx, {
        currentRevision: num(detail.current_revision),
        transcriptId: str(detail.transcript_id),
      });
    case 'MEETING_NOTE_AI_LIMIT_REACHED': {
      const resetAt = str(detail.reset_at);
      return meetingNoteErrorWithData(429, error.token, ctx, {
        limit: num(detail.limit),
        used: num(detail.used),
        usageDay: str(detail.usage_day),
        resetAt: resetAt ? new Date(resetAt).toISOString() : null,
      });
    }
    case 'MEETING_NOTE_NOT_FOUND':
      return notFound('MEETING_NOTE_NOT_FOUND', ctx);
    case 'MEETING_NOTE_FORBIDDEN':
      return meetingNoteError(403, error.token, ctx, 'meetingNotes.aiProcess.authorize');
    default:
      return internalError(error, ctx, 'meetingNotes.aiProcess.admit');
  }
}

function withData(status: number, code: string, message: string, ctx: MeetingNoteRouteContext, data: Record<string, 
unknown>) {
  return NextResponse.json(
    { error: message, code, correlationId: ctx.correlationId, ...data },
    { status, headers: { 'x-correlation-id': ctx.correlationId } }
  );
}

function outcomeResponse(
  outcome: MeetingNoteAiProcessingOutcome,
  ctx: MeetingNoteRouteContext,
  binding: { sourceRevision: number; transcriptId: string }
): NextResponse {
  switch (outcome.kind) {
    case 'refused':
      return admissionRefusal(outcome.error, ctx);
    case 'replay': {
      const body: MeetingNoteAiProcessResponse = {
        operationId: outcome.replay.operationId,
        status: outcome.replay.status,
        replay: true,
        sourceRevision: binding.sourceRevision,
        transcriptId: binding.transcriptId,
        draft: null,
        usage: outcome.usage,
      };
      return ok(body, ctx);
    }
    case 'preflight_refused':
      return withData(422, outcome.failure.code, outcome.failure.message, ctx, {
        operationId: outcome.operationId,
        status: outcome.status,
        retryable: outcome.failure.retryable,
        estimatedInputTokens: outcome.failure.estimatedInputTokens ?? null,
        maxInputTokens: outcome.failure.maxInputTokens ?? null,
        usage: outcome.usage,
      });
    case 'cancelled_before_send':
    case 'client_gone':
      return meetingNoteErrorWithData(CLIENT_CLOSED_STATUS, 'MEETING_NOTE_AI_CANCELLED', ctx, {
        operationId: outcome.operationId,
        status: outcome.status,
      });
    case 'not_dispatchable':
      return meetingNoteErrorWithData(409, 'MEETING_NOTE_AI_OPERATION_ENDED', ctx, {
        operationId: outcome.operationId,
        status: outcome.status,
        retryable: true,
      });
    case 'provider_failure':
      return withData(502, outcome.failure.code, outcome.failure.message, ctx, {
        operationId: outcome.operationId,
        status: outcome.status,
        retryable: outcome.failure.retryable,
        usage: outcome.usage,
      });
    case 'access_lost':
      return outcome.reason === 'not_found'
        ? meetingNoteErrorWithData(404, 'MEETING_NOTE_NOT_FOUND', ctx, { operationId: outcome.operationId, status: 
outcome.status })
        : meetingNoteErrorWithData(403, 'MEETING_NOTE_FORBIDDEN', ctx, { operationId: outcome.operationId, status: 
outcome.status });
    case 'settled_elsewhere':
      return meetingNoteErrorWithData(409, 'MEETING_NOTE_AI_DRAFT_DISCARDED', ctx, {
        operationId: outcome.operationId,
        status: outcome.status,
        retryable: true,
      });
    case 'succeeded': {
      const body: MeetingNoteAiProcessResponse = {
        operationId: outcome.operationId,
        status: 'succeeded',
        replay: false,
        sourceRevision: outcome.sourceRevision,
        transcriptId: outcome.transcriptId,
        draft: outcome.draft,
        usage: outcome.usage,
      };
      return ok(body, ctx);
    }
  }
}

/**
 * POST /api/meeting-notes/[id]/ai/process { ticket, idempotencyKey? }
 * 200 MeetingNoteAiProcessResponse — a new operation's draft, or a replay's status (no draft).
 * 400 MEETING_NOTE_AI_TICKET_INVALID (malformed, bad signature, issued in the future);
 * 410 MEETING_NOTE_AI_TICKET_EXPIRED; 409 MEETING_NOTE_AI_BINDING_MISMATCH;
 * 404 MEETING_NOTE_NOT_FOUND / 403 MEETING_NOTE_FORBIDDEN (also when access was lost while processing);
 * 409 MEETING_NOTE_AI_NOT_CONFIGURED {canConfigure} / _SETTINGS_STALE {settings} / _SOURCE_STALE {currentRevision, 
transcriptId}
 *     / _OPERATION_ENDED / _DRAFT_DISCARDED;
 * 429 MEETING_NOTE_AI_LIMIT_REACHED {limit, used, usageDay, resetAt};
 * 422 MEETING_NOTE_AI_TRANSCRIPT_TOO_LONG_FOR_MODEL (FR-020; not counted);
 * 502 provider failure codes (src/lib/meeting-notes/ai/provider-errors.ts) {retryable, status, usage};
 * 499 MEETING_NOTE_AI_CANCELLED (the client left); 503 MEETING_NOTE_AI_UNAVAILABLE (ticket secret missing).
 */
export async function POST(request: NextRequest, { params }: RouteParams): Promise<NextResponse> {
  const begun = await beginMeetingNoteMutation(request, PATH, 'meeting-note:ai-process');
  if (!begun.ok) {
    await request.body?.cancel().catch(() => undefined);
    return begun.response;
  }
  const ctx = begun.value;

  const id = parsePathId((await params).id, 'MEETING_NOTE_NOT_FOUND', ctx);
  if (!id.ok) {
    await request.body?.cancel().catch(() => undefined);
    return id.response;
  }

  const raw = await readJsonObject(request, ctx);
  if (!raw.ok) return raw.response;
  const body = parseWith(startMeetingNoteAiProcessingBodySchema, raw.value, ctx);
  if (!body.ok) return body.response;

  // 2. Signature and expiry first: no operation is looked up for a bad or old ticket.
  let verified;
  try {
    verified = verifyMeetingNoteAiTicket(body.value.ticket);
  } catch (error) {
    if (error instanceof MeetingNoteAiTicketConfigError) {
      console.error(JSON.stringify({ event: 'meeting_notes_ticket_secret_unconfigured', correlationId: 
ctx.correlationId }));
      return meetingNoteError(503, 'MEETING_NOTE_AI_UNAVAILABLE', ctx, 'meetingNotes.aiProcess.config');
    }
    return internalError(error, ctx, 'meetingNotes.aiProcess.ticket');
  }
  if (!verified.ok) {
    return verified.reason === 'expired'
      ? meetingNoteError(410, 'MEETING_NOTE_AI_TICKET_EXPIRED', ctx)
      : meetingNoteError(400, 'MEETING_NOTE_AI_TICKET_INVALID', ctx);
  }
  const ticket = verified.payload;

  // 3. The ticket must belong to this caller, their current company, and this note.
  if (ticket.userId !== ctx.dbUser.id) {
    return meetingNoteError(409, 'MEETING_NOTE_AI_BINDING_MISMATCH', ctx, 'meetingNotes.aiProcess.binding');
  }
  if (!ctx.dbUser.companyId || ticket.companyId !== ctx.dbUser.companyId) {
    return notFound('MEETING_NOTE_NOT_FOUND', ctx);
  }
  if (
    ticket.noteId.toLowerCase() !== id.value.toLowerCase() ||
    (body.value.idempotencyKey !== undefined && body.value.idempotencyKey.toLowerCase() !== 
ticket.idempotencyKey.toLowerCase())
  ) {
    return meetingNoteError(409, 'MEETING_NOTE_AI_BINDING_MISMATCH', ctx, 'meetingNotes.aiProcess.binding');
  }

  // 4. Server-only RPCs, after the caller was authorized above.
  try {
    const service = await createSupabaseServerClient('service_role');
    const outcome = await runMeetingNoteAiProcessing({ ...ctx, service }, ticket, request.signal);
    return outcomeResponse(outcome, ctx, { sourceRevision: ticket.sourceRevision, transcriptId: ticket.transcriptId });
  } catch (error) {
    return internalError(error, ctx, 'meetingNotes.aiProcess');
  }
}
// src/lib/meeting-notes/ai/processing.ts
// The server side of "Process transcript" after the start route verified the
// ticket and bound it to the authenticated application user (Phase 6 T12;
// SPEC FR-015, FR-016, FR-017, FR-020, FR-021, FR-022, FR-031, BR-013).
//
// Order (each step only after the previous one):
//   1. admission (service_role RPC, actor = the route's users.id): re-checks
//      current membership and editor rights FIRST, then replay / binding /
//      settings revision / source / limit, and reserves one unit. A replay
//      returns the stored status only — never a draft, never a dispatch.
//   2. normalize the transcript (FR-014) and run the FR-020 size preflight:
//      a refusal settles `released` (not counted) — nothing was sent.
//   3. client already gone → `released` (never sent).
//   4. mark dispatched; a refused transition (the stale job already failed
//      the operation) means the request is NOT sent.
//   5. exactly one provider request with the ADMITTED snapshot (provider,
//      model, reasoning level, key) — never the current settings — and an
//      AbortSignal tied to the client request plus the adapter deadline
//      (default 180 s, MEETING_NOTES_AI_TIMEOUT_MS; always far below the
//      10-minute stale job).
//   6. settlement, by outcome:
//        draft received, client still there, caller still a member and
//          editor, note still exists                → succeeded (counted)
//        draft received but the client left, or the caller lost access, or
//          the note is gone                         → discarded (counted)
//        processed_failure, client still there      → failed (counted)
//        processed_failure because the client left  → discarded (counted)
//        preprocessing_rejected (listed initial rejection) → refunded
//        never_sent after the dispatch mark (connection refused, cancelled
//          just before fetch)                       → refunded (`released`
//          is only valid from admitted)
//      A settlement that did not change the operation, or ended in another
//      status (e.g. the stale job failed it first), drops the draft.
// The decrypted key and the transcript live only in this call's memory; they
// are never logged, returned, or stored. Nothing here reads or writes note
// content: the draft is returned to the caller, and only Apply stores it.
import 'server-only';

import type { SupabaseClient } from '@supabase/supabase-js';

import { MeetingNoteDbError } from '@/lib/meeting-notes/errors';
import { computeMeetingNoteRights } from '@/lib/meeting-notes/note-detail';
import { SupabaseMeetingNoteAiOperationRepository } from 
'@/repositories/implementations/supabase/SupabaseMeetingNoteAiOperationRepository';
import type { IMeetingNoteRepository } from '@/repositories/interfaces/IMeetingNoteRepository';
import type { MeetingNoteAiAdmission, MeetingNoteAiReplay } from 
'@/repositories/interfaces/IMeetingNoteAiOperationRepository';
import type { User } from '@/types/database';
import type {
  MeetingNoteAiOperationStatus,
  MeetingNoteAiReviewDraft,
  MeetingNoteAiSettlementOutcome,
  MeetingNoteAiUsage,
} from '@/types/meeting-notes';

import {
  generateMeetingNoteDraft,
  MEETING_NOTE_AI_MAX_TIMEOUT_MS,
  preflightMeetingNoteAiTranscript,
  type MeetingNoteAiDraftFailure,
} from './adapters';
import { buildMeetingNoteAiReviewDraft } from './draft-review';
import { meetingNoteAiFailure, meetingNoteAiTooLongFailure } from './provider-errors';
import { meetingNoteAiTicketIssuedAt, type MeetingNoteAiTicketPayload } from './ticket';
import { normalizeTranscriptForProvider } from './transcript-normalizer';

/** Optional server-only override of the provider deadline (ms), clamped to 1 s – 300 s. */
export const MEETING_NOTES_AI_TIMEOUT_ENV = 'MEETING_NOTES_AI_TIMEOUT_MS';

function configuredTimeoutMs(): number | undefined {
  const raw = process.env[MEETING_NOTES_AI_TIMEOUT_ENV]?.trim();
  if (!raw) return undefined;
  const value = Number(raw);
  if (!Number.isFinite(value)) return undefined;
  return Math.min(Math.max(Math.floor(value), 1_000), MEETING_NOTE_AI_MAX_TIMEOUT_MS);
}

export interface MeetingNoteAiProcessingContext {
  correlationId: string;
  /** The user's server client (session cookies). */
  supabase: SupabaseClient;
  /** The user's repository (RLS). */
  repository: IMeetingNoteRepository;
  dbUser: User;
  /** Service-role client, built only after the route authenticated the user. */
  service: SupabaseClient;
}

export type MeetingNoteAiProcessingOutcome =
  /** Admission refused (expired, binding, rights, settings stale, source stale, limit, not configured). */
  | { kind: 'refused'; error: MeetingNoteDbError }
  /** The ticket's operation already exists: its status, no draft, no dispatch. */
  | { kind: 'replay'; replay: MeetingNoteAiReplay; usage: MeetingNoteAiUsage | null }
  /** FR-020 (or an out-of-matrix snapshot): refused before dispatch; released (not counted). */
  | { kind: 'preflight_refused'; operationId: string; status: MeetingNoteAiOperationStatus | null; failure: 
MeetingNoteAiDraftFailure; usage: MeetingNoteAiUsage | null }
  /** The client left before anything was sent; released. */
  | { kind: 'cancelled_before_send'; operationId: string; status: MeetingNoteAiOperationStatus | null }
  /** The operation could not be marked dispatched (already terminal); nothing sent. */
  | { kind: 'not_dispatchable'; operationId: string; status: MeetingNoteAiOperationStatus | null }
  /** The provider call failed; settled per its counting class. */
  | { kind: 'provider_failure'; operationId: string; status: MeetingNoteAiOperationStatus | null; failure: 
MeetingNoteAiDraftFailure; usage: MeetingNoteAiUsage | null }
  /** The client left after dispatch: discarded (counted), no draft. */
  | { kind: 'client_gone'; operationId: string; status: MeetingNoteAiOperationStatus | null }
  /** The caller lost membership/editor rights, or the note is gone: discarded, no draft. */
  | { kind: 'access_lost'; operationId: string; status: MeetingNoteAiOperationStatus | null; reason: 'not_found' | 
'forbidden' }
  /** The settlement did not record success (e.g. the stale job failed it first): no draft. */
  | { kind: 'settled_elsewhere'; operationId: string; status: MeetingNoteAiOperationStatus | null }
  | {
      kind: 'succeeded';
      operationId: string;
      sourceRevision: number;
      transcriptId: string;
      draft: MeetingNoteAiReviewDraft;
      usage: MeetingNoteAiUsage | null;
    };

function logEvent(event: string, fields: Record<string, unknown>): void {
  // Identifiers and codes only — never the key, the transcript, or provider text.
  console.info(JSON.stringify({ event, ...fields }));
}

async function ownUsage(ctx: MeetingNoteAiProcessingContext): Promise<MeetingNoteAiUsage | null> {
  try {
    const usage = await new SupabaseMeetingNoteAiOperationRepository(ctx.supabase).getOwnCompanyUsage();
    return { limit: usage.limit, used: usage.used, usageDay: usage.usageDay, resetAt: usage.resetAt };
  } catch {
    // A removed member has no company usage to read; the response carries none.
    return null;
  }
}

/**
 * Settles the operation; returns the resulting status and whether this call
 * recorded `outcome`. A failing settlement is logged (ids only) and reported
 * as not recorded: the stale job then fails the operation (counted).
 */
async function settle(
  ctx: MeetingNoteAiProcessingContext,
  operations: SupabaseMeetingNoteAiOperationRepository,
  operationId: string,
  outcome: MeetingNoteAiSettlementOutcome
): Promise<{ status: MeetingNoteAiOperationStatus | null; recorded: boolean }> {
  try {
    const result = await operations.settle(operationId, outcome);
    return { status: result.status, recorded: result.changed && result.status === outcome };
  } catch (error) {
    logEvent('meeting_notes_ai_settle_failed', {
      correlationId: ctx.correlationId,
      operationId,
      outcome,
      sqlstate: error instanceof MeetingNoteDbError ? error.sqlstate : undefined,
    });
    return { status: null, recorded: false };
  }
}

interface AccessCheck {
  ok: true;
  members: Array<{ userId: string; displayName: string }>;
  items: Array<{ id: string; description: string }>;
}

/**
 * FR-021: before a draft is returned, the caller must still be a member of
 * the note's company with editor rights, and the note must still exist. Read
 * with the caller's session (RLS hides the note from a removed member); also
 * loads what the review draft needs (current members, existing items).
 */
async function recheckAccess(
  ctx: MeetingNoteAiProcessingContext,
  noteId: string
): Promise<AccessCheck | { ok: false; reason: 'not_found' | 'forbidden' }> {
  const { data: fresh, error } = await ctx.supabase
    .from('users')
    .select('id, company_id, role')
    .eq('id', ctx.dbUser.id)
    .maybeSingle<{ id: string; company_id: string | null; role: User['role'] }>();
  if (error) throw new MeetingNoteDbError(error.code, error.message, error.details);
  if (!fresh || !fresh.company_id) return { ok: false, reason: 'not_found' };

  const note = await ctx.repository.findById(noteId);
  if (!note || note.companyId !== fresh.company_id) return { ok: false, reason: 'not_found' };

  const participants = await ctx.repository.findParticipants(noteId);
  const rights = computeMeetingNoteRights(
    { id: fresh.id, companyId: fresh.company_id, role: fresh.role },
    note,
    participants.map((participant) => participant.userId)
  );
  if (!rights.canEdit) return { ok: false, reason: 'forbidden' };

  const [members, items] = await Promise.all([
    ctx.repository.listCurrentMembers(fresh.company_id),
    ctx.repository.findActionItems(noteId),
  ]);
  return { ok: true, members, items: items.map((item) => ({ id: item.id, description: item.description })) };
}

/**
 * Runs admission → preflight → one dispatch → settlement for a VERIFIED
 * ticket whose user/company/note already equal the authenticated caller's.
 */
export async function runMeetingNoteAiProcessing(
  ctx: MeetingNoteAiProcessingContext,
  ticket: MeetingNoteAiTicketPayload,
  signal: AbortSignal
): Promise<MeetingNoteAiProcessingOutcome> {
  const operations = new SupabaseMeetingNoteAiOperationRepository(ctx.service);

  let admitted: MeetingNoteAiAdmission | MeetingNoteAiReplay;
  try {
    admitted = await operations.admit({
      actorUserId: ctx.dbUser.id,
      companyId: ticket.companyId,
      noteId: ticket.noteId,
      idempotencyKey: ticket.idempotencyKey,
      ticketIssuedAt: meetingNoteAiTicketIssuedAt(ticket),
      sourceRevision: ticket.sourceRevision,
      transcriptId: ticket.transcriptId,
      settingsRevision: ticket.settingsRevision,
    });
  } catch (error) {
    if (error instanceof MeetingNoteDbError && error.token !== null) return { kind: 'refused', error };
    throw error;
  }

  if (admitted.replay) {
    return { kind: 'replay', replay: admitted, usage: await ownUsage(ctx) };
  }

  const admission = admitted;
  const operationId = admission.operationId;
  let marked = false;
  let settled = false;
  try {
    const transcript = normalizeTranscriptForProvider(admission.transcript);

    const preflight = preflightMeetingNoteAiTranscript({
      provider: admission.provider,
      model: admission.model,
      transcript,
    });
    if (!preflight.ok) {
      const result = await settle(ctx, operations, operationId, 'released');
      settled = true;
      // A snapshot outside the matrix (settings saved under an older matrix)
      // is a never-sent configuration error; nothing is sent either way.
      const failure =
        preflight.code === 'MEETING_NOTE_AI_TRANSCRIPT_TOO_LONG_FOR_MODEL'
          ? meetingNoteAiTooLongFailure(admission.provider, preflight)
          : meetingNoteAiFailure(admission.provider, 'MEETING_NOTE_AI_CONFIGURATION_INVALID', false);
      return { kind: 'preflight_refused', operationId, status: result.status, failure, usage: await ownUsage(ctx) };
    }

    if (signal.aborted) {
      const result = await settle(ctx, operations, operationId, 'released');
      settled = true;
      return { kind: 'cancelled_before_send', operationId, status: result.status };
    }

    try {
      await operations.markDispatched(operationId);
      marked = true;
    } catch (error) {
      if (error instanceof MeetingNoteDbError && error.token === 'MEETING_NOTE_AI_OPERATION_INVALID_TRANSITION') {
        settled = true;
        const status = error.detail?.status;
        return {
          kind: 'not_dispatchable',
          operationId,
          status: typeof status === 'string' ? (status as MeetingNoteAiOperationStatus) : null,
        };
      }
      throw error;
    }

    const result = await generateMeetingNoteDraft({
      provider: admission.provider,
      model: admission.model,
      reasoningLevel: admission.reasoningLevel,
      apiKey: admission.apiKey,
      transcript,
      signal,
      timeoutMs: configuredTimeoutMs(),
    });

    if (!result.ok) {
      const clientLeft = signal.aborted && result.kind === 'processed_failure';
      const outcome: MeetingNoteAiSettlementOutcome =
        result.kind === 'processed_failure' ? (clientLeft ? 'discarded' : 'failed') : 'refunded';
      const settlement = await settle(ctx, operations, operationId, outcome);
      settled = true;
      logEvent('meeting_notes_ai_processing_failed', {
        correlationId: ctx.correlationId,
        operationId,
        kind: result.kind,
        code: result.code,
        status: settlement.status,
      });
      if (clientLeft) return { kind: 'client_gone', operationId, status: settlement.status };
      return { kind: 'provider_failure', operationId, status: settlement.status, failure: result, usage: await 
ownUsage(ctx) };
    }

    if (signal.aborted) {
      const settlement = await settle(ctx, operations, operationId, 'discarded');
      settled = true;
      return { kind: 'client_gone', operationId, status: settlement.status };
    }

    let access: Awaited<ReturnType<typeof recheckAccess>>;
    try {
      access = await recheckAccess(ctx, ticket.noteId);
    } catch (error) {
      await settle(ctx, operations, operationId, 'discarded');
      settled = true;
      throw error;
    }
    if (!access.ok) {
      const settlement = await settle(ctx, operations, operationId, 'discarded');
      settled = true;
      return { kind: 'access_lost', operationId, status: settlement.status, reason: access.reason };
    }

    const draft = buildMeetingNoteAiReviewDraft(result.draft, access.members, access.items);
    const settlement = await settle(ctx, operations, operationId, 'succeeded');
    settled = true;
    if (!settlement.recorded) {
      return { kind: 'settled_elsewhere', operationId, status: settlement.status };
    }
    if (signal.aborted) {
      // Left between the recheck and the settlement: the draft is dropped; the
      // operation stays `succeeded` (counted either way).
      return { kind: 'client_gone', operationId, status: settlement.status };
    }
    return {
      kind: 'succeeded',
      operationId,
      sourceRevision: admission.sourceRevision,
      transcriptId: admission.transcriptId,
      draft,
      usage: await ownUsage(ctx),
    };
  } finally {
    if (!settled) {
      // An unexpected error: never leave the reservation without an outcome
      // when one can be recorded (released before the dispatch mark, failed
      // after it — counted, as the request may have left).
      if (marked) {
        await settle(ctx, operations, operationId, 'failed');
      } else {
        // The provider was never called. If the dispatch mark committed but
        // its reply was lost, `released` is refused (valid only from
        // admitted): nothing was sent, so the operation is refunded.
        const released = await settle(ctx, operations, operationId, 'released');
        if (released.status === 'dispatched') await settle(ctx, operations, operationId, 'refunded');
      }
    }
  }
}

