// src/repositories/implementations/supabase/SupabaseMeetingNoteAiOperationRepository.ts
// AI usage and processing operations (Phase 6 T9; migration 20261013154823).
// Construct with the user's server client for getOwnCompanyUsage (RPC granted
// to authenticated, scoped to the caller's company), and with the
// service-role client for admit / markDispatched / settle (service_role-only
// RPCs), only after the route authorized the application user. Server-only:
// an admission carries a decrypted API key and the transcript text.
// Deliberately not re-exported from the implementations index, which client
// code may import.
import 'server-only';

import type { PostgrestError, SupabaseClient } from '@supabase/supabase-js';

import { MeetingNoteDbError } from '@/lib/meeting-notes/errors';
import type {
  AdmitMeetingNoteAiOperationParams,
  IMeetingNoteAiOperationRepository,
  MeetingNoteAiAdmission,
  MeetingNoteAiCompanyUsage,
  MeetingNoteAiOperationTransition,
  MeetingNoteAiReplay,
  MeetingNoteAiSettlement,
} from '@/repositories/interfaces/IMeetingNoteAiOperationRepository';
import type {
  MeetingNoteAiOperationStatus,
  MeetingNoteAiProvider,
  MeetingNoteAiSettlementOutcome,
  MeetingNoteAiUsage,
} from '@/types/meeting-notes';

const PROVIDERS: ReadonlySet<string> = new Set<MeetingNoteAiProvider>(['anthropic', 'openai', 'kimi', 'glm']);
const STATUSES: ReadonlySet<string> = new Set<MeetingNoteAiOperationStatus>([
  'admitted',
  'dispatched',
  'succeeded',
  'failed',
  'discarded',
  'refunded',
  'released',
]);

type Row = Record<string, unknown>;

function toDbError(error: PostgrestError): MeetingNoteDbError {
  return new MeetingNoteDbError(error.code, error.message, error.details);
}

/** A fixed message: never the payload (it could carry the key or transcript). */
function invalidShape(what: string): MeetingNoteDbError {
  return new MeetingNoteDbError(undefined, `${what} returned an unexpected shape`, null);
}

function asRow(data: unknown, what: string): Row {
  if (!data || typeof data !== 'object' || Array.isArray(data)) throw invalidShape(what);
  return data as Row;
}

function str(row: Row, key: string, what: string): string {
  const value = row[key];
  if (typeof value !== 'string') throw invalidShape(what);
  return value;
}

function int(row: Row, key: string, what: string): number {
  const raw = row[key];
  const value = typeof raw === 'string' ? Number(raw) : raw;
  if (typeof value !== 'number' || !Number.isSafeInteger(value)) throw invalidShape(what);
  return value;
}

function bool(row: Row, key: string, what: string): boolean {
  const value = row[key];
  if (typeof value !== 'boolean') throw invalidShape(what);
  return value;
}

function provider(row: Row, what: string): MeetingNoteAiProvider {
  const value = row.provider;
  if (typeof value !== 'string' || !PROVIDERS.has(value)) throw invalidShape(what);
  return value as MeetingNoteAiProvider;
}

function status(row: Row, what: string): MeetingNoteAiOperationStatus {
  const value = row.status;
  if (typeof value !== 'string' || !STATUSES.has(value)) throw invalidShape(what);
  return value as MeetingNoteAiOperationStatus;
}

function usage(row: Row, what: string): MeetingNoteAiUsage {
  return {
    limit: int(row, 'limit', what),
    used: int(row, 'used', what),
    usageDay: str(row, 'usage_day', what),
    resetAt: new Date(str(row, 'reset_at', what)).toISOString(),
  };
}

export class SupabaseMeetingNoteAiOperationRepository implements IMeetingNoteAiOperationRepository {
  constructor(private readonly supabase: SupabaseClient) {}

  async getOwnCompanyUsage(): Promise<MeetingNoteAiCompanyUsage> {
    const what = 'get_meeting_note_ai_usage';
    const { data, error } = await this.supabase.rpc(what);
    if (error) throw toDbError(error);
    const row = asRow(data, what);
    return {
      configured: bool(row, 'configured', what),
      ...usage({ ...row, limit: row.daily_limit }, what),
    };
  }

  async admit(params: AdmitMeetingNoteAiOperationParams): Promise<MeetingNoteAiAdmission | MeetingNoteAiReplay> {
    const what = 'admit_meeting_note_ai_operation';
    const { data, error } = await this.supabase.rpc(what, {
      p_actor_user_id: params.actorUserId,
      p_company_id: params.companyId,
      p_note_id: params.noteId,
      p_idempotency_key: params.idempotencyKey,
      p_ticket_issued_at: params.ticketIssuedAt,
      p_source_revision: params.sourceRevision,
      p_transcript_id: params.transcriptId,
      p_settings_revision: params.settingsRevision,
    });
    if (error) throw toDbError(error);
    const row = asRow(data, what);
    const base = {
      operationId: str(row, 'operation_id', what),
      admissionDay: str(row, 'admission_day', what),
      provider: provider(row, what),
      model: str(row, 'model', what),
      reasoningLevel: str(row, 'reasoning_level', what),
      settingsRevision: int(row, 'settings_revision', what),
    };
    if (bool(row, 'replay', what)) {
      return { replay: true, status: status(row, what), ...base };
    }
    if (status(row, what) !== 'admitted') throw invalidShape(what);
    return {
      replay: false,
      status: 'admitted',
      ...base,
      sourceRevision: int(row, 'source_revision', what),
      transcriptId: str(row, 'transcript_id', what),
      apiKey: str(row, 'api_key', what),
      transcript: str(row, 'transcript', what),
      usage: usage(asRow(row.usage, what), what),
    };
  }

  async markDispatched(operationId: string): Promise<MeetingNoteAiOperationTransition> {
    const what = 'mark_meeting_note_ai_operation_dispatched';
    const { data, error } = await this.supabase.rpc(what, { p_operation_id: operationId });
    if (error) throw toDbError(error);
    const row = asRow(data, what);
    return { operationId: str(row, 'operation_id', what), status: status(row, what), changed: bool(row, 'changed', 
what) };
  }

  async settle(operationId: string, outcome: MeetingNoteAiSettlementOutcome): Promise<MeetingNoteAiSettlement> {
    const what = 'settle_meeting_note_ai_operation';
    const { data, error } = await this.supabase.rpc(what, { p_operation_id: operationId, p_outcome: outcome });
    if (error) throw toDbError(error);
    const row = asRow(data, what);
    return {
      operationId: str(row, 'operation_id', what),
      status: status(row, what),
      changed: bool(row, 'changed', what),
      counted: bool(row, 'counted', what),
      admissionDay: str(row, 'admission_day', what),
    };
  }
}
// src/lib/meeting-notes/ai/ticket.ts
// Signed processing tickets for the meeting-note AI flow (Phase 6 T9; FR-015,
// FR-031). A ticket is issued by the server when the provider notice is shown
// and is presented by the start request. It carries its issue time, a
// SERVER-GENERATED idempotency key, and the binding (application user,
// company, note, source note revision, transcript identity, AI settings
// revision), signed with HMAC-SHA256. A client can neither choose a key nor
// move a key to a new ticket: changing any byte invalidates the signature.
//
// Format: "mnt1.<base64url(canonical JSON payload)>.<base64url(HMAC-SHA256)>",
// the MAC computed over "mnt1.<payload segment>".
//
// Secrets (server-only environment, never NEXT_PUBLIC_):
//   MEETING_NOTES_TICKET_SECRET           required, >= 32 bytes with >= 16 distinct
//                                         bytes (random); signs and verifies.
//   MEETING_NOTES_TICKET_SECRET_PREVIOUS  optional, >= 32 bytes when set; verifies
//                                         only, so a rotation keeps outstanding
//                                         tickets valid for their 24 hours.
// There is no fallback: a missing or short secret raises
// MeetingNoteAiTicketConfigError (callers answer with a configuration error).
// Neither secret is ever logged or included in an error message.
import 'server-only';

import { createHmac, randomUUID, timingSafeEqual } from 'node:crypto';
import { z } from 'zod';

const PREFIX = 'mnt1';
const VERSION = 1;
/** A ticket and its idempotency key are valid for 24 hours after issuance. */
export const MEETING_NOTE_AI_TICKET_TTL_SECONDS = 24 * 60 * 60;
/** Accepted clock skew for an issue time in the future. */
const MAX_FUTURE_SKEW_SECONDS = 60;
const MIN_SECRET_BYTES = 32;
/** A random 32+ byte secret has far more distinct bytes; fewer means a placeholder or a typed word. */
const MIN_SECRET_DISTINCT_BYTES = 16;
/** A real ticket is ~450 characters; anything far longer is not a ticket. */
const MAX_TICKET_LENGTH = 2_048;
const MAC_BYTES = 32;
const SEGMENT = /^[A-Za-z0-9_-]+$/;

export const MEETING_NOTES_TICKET_SECRET_ENV = 'MEETING_NOTES_TICKET_SECRET';
export const MEETING_NOTES_TICKET_SECRET_PREVIOUS_ENV = 'MEETING_NOTES_TICKET_SECRET_PREVIOUS';

/** What a ticket binds: the operation's identity apart from its key and time. */
export interface MeetingNoteAiTicketBinding {
  /** Application users.id of the authenticated requester. */
  userId: string;
  companyId: string;
  noteId: string;
  /** Note revision the notice was shown for (the draft's source revision). */
  sourceRevision: number;
  /** Stored-transcript identity the notice was shown for. */
  transcriptId: string;
  /** AI settings revision the notice was shown for. */
  settingsRevision: number;
}

export interface MeetingNoteAiTicketPayload extends MeetingNoteAiTicketBinding {
  v: typeof VERSION;
  /** Issue time, whole seconds since the Unix epoch. */
  iat: number;
  /** Server-generated idempotency key (UUID), unique per ticket. */
  idempotencyKey: string;
}

export interface IssuedMeetingNoteAiTicket {
  ticket: string;
  payload: MeetingNoteAiTicketPayload;
  /** ISO time after which the ticket and its key are rejected as expired. */
  expiresAt: string;
}

export type MeetingNoteAiTicketRejection = 'malformed' | 'invalid_signature' | 'expired' | 'not_yet_valid';

export type MeetingNoteAiTicketVerification =
  | { ok: true; payload: MeetingNoteAiTicketPayload; expiresAt: string }
  | { ok: false; reason: MeetingNoteAiTicketRejection };

/** The ticket secret is missing or too short (no fallback exists). */
export class MeetingNoteAiTicketConfigError extends Error {
  constructor() {
    super('The meeting-notes ticket secret is not configured.');
    this.name = 'MeetingNoteAiTicketConfigError';
  }
}

const uuid = z.guid();
const revision = z.number().int().min(1).max(Number.MAX_SAFE_INTEGER);

const payloadSchema = z
  .object({
    v: z.literal(VERSION),
    iat: z.number().int().min(0).max(Number.MAX_SAFE_INTEGER),
    idempotencyKey: uuid,
    userId: uuid,
    companyId: uuid,
    noteId: uuid,
    sourceRevision: revision,
    transcriptId: uuid,
    settingsRevision: revision,
  })
  .strict();

const bindingSchema = payloadSchema.omit({ v: true, iat: true, idempotencyKey: true });

function secretFrom(name: string, required: boolean): Buffer | null {
  const value = process.env[name];
  if (value === undefined || value === '') {
    if (required) throw new MeetingNoteAiTicketConfigError();
    return null;
  }
  const bytes = Buffer.from(value, 'utf8');
  if (bytes.length < MIN_SECRET_BYTES || new Set(bytes).size < MIN_SECRET_DISTINCT_BYTES) {
    throw new MeetingNoteAiTicketConfigError();
  }
  return bytes;
}

function currentSecret(): Buffer {
  const secret = secretFrom(MEETING_NOTES_TICKET_SECRET_ENV, true);
  if (!secret) throw new MeetingNoteAiTicketConfigError();
  return secret;
}

/** Throws MeetingNoteAiTicketConfigError unless tickets can be issued and verified. */
export function assertMeetingNoteAiTicketConfigured(): void {
  currentSecret();
  secretFrom(MEETING_NOTES_TICKET_SECRET_PREVIOUS_ENV, false);
}

function mac(secret: Buffer, signedPart: string): Buffer {
  return createHmac('sha256', secret).update(signedPart, 'utf8').digest();
}

/** Fixed key order: the payload bytes depend only on the values. */
function canonicalJson(payload: MeetingNoteAiTicketPayload): string {
  return JSON.stringify({
    v: payload.v,
    iat: payload.iat,
    idempotencyKey: payload.idempotencyKey,
    userId: payload.userId,
    companyId: payload.companyId,
    noteId: payload.noteId,
    sourceRevision: payload.sourceRevision,
    transcriptId: payload.transcriptId,
    settingsRevision: payload.settingsRevision,
  });
}

function expiresAtOf(iat: number): string {
  return new Date((iat + MEETING_NOTE_AI_TICKET_TTL_SECONDS) * 1000).toISOString();
}

/** The issue time as the ISO instant the admission RPC binds. */
export function meetingNoteAiTicketIssuedAt(payload: Pick<MeetingNoteAiTicketPayload, 'iat'>): string {
  return new Date(payload.iat * 1000).toISOString();
}

/**
 * Signs a new ticket with a fresh server-generated idempotency key. Call only
 * after the route authorized the user (current membership and editor rights).
 */
export function issueMeetingNoteAiTicket(
  binding: MeetingNoteAiTicketBinding,
  nowMs: number = Date.now()
): IssuedMeetingNoteAiTicket {
  const secret = currentSecret();
  secretFrom(MEETING_NOTES_TICKET_SECRET_PREVIOUS_ENV, false);
  const checked = bindingSchema.parse(binding);
  const payload: MeetingNoteAiTicketPayload = {
    v: VERSION,
    iat: Math.floor(nowMs / 1000),
    idempotencyKey: randomUUID(),
    ...checked,
  };
  const encoded = Buffer.from(canonicalJson(payload), 'utf8').toString('base64url');
  const signedPart = `${PREFIX}.${encoded}`;
  const ticket = `${signedPart}.${mac(secret, signedPart).toString('base64url')}`;
  return { ticket, payload, expiresAt: expiresAtOf(payload.iat) };
}

function macMatches(secret: Buffer, signedPart: string, received: Buffer): boolean {
  const expected = mac(secret, signedPart);
  return received.length === expected.length && timingSafeEqual(received, expected);
}

/**
 * Verifies a presented ticket: format, signature (current secret, then the
 * previous one), payload shape, and the 24-hour validity of the ticket and its
 * key. Throws MeetingNoteAiTicketConfigError when the secret is missing.
 */
export function verifyMeetingNoteAiTicket(ticket: unknown, nowMs: number = Date.now()): 
MeetingNoteAiTicketVerification {
  const current = currentSecret();
  const previous = secretFrom(MEETING_NOTES_TICKET_SECRET_PREVIOUS_ENV, false);

  if (typeof ticket !== 'string' || ticket.length > MAX_TICKET_LENGTH) return { ok: false, reason: 'malformed' };
  const parts = ticket.split('.');
  if (parts.length !== 3 || parts[0] !== PREFIX || !SEGMENT.test(parts[1]) || !SEGMENT.test(parts[2])) {
    return { ok: false, reason: 'malformed' };
  }
  const received = Buffer.from(parts[2], 'base64url');
  if (received.length !== MAC_BYTES || received.toString('base64url') !== parts[2]) {
    return { ok: false, reason: 'malformed' };
  }

  const signedPart = `${PREFIX}.${parts[1]}`;
  const signed = macMatches(current, signedPart, received) || (previous !== null && macMatches(previous, signedPart, 
received));
  if (!signed) return { ok: false, reason: 'invalid_signature' };

  let decoded: unknown;
  try {
    decoded = JSON.parse(new TextDecoder('utf-8', { fatal: true }).decode(Buffer.from(parts[1], 'base64url')));
  } catch {
    return { ok: false, reason: 'malformed' };
  }
  const parsed = payloadSchema.safeParse(decoded);
  if (!parsed.success) return { ok: false, reason: 'malformed' };
  const payload = parsed.data;

  const nowSeconds = Math.floor(nowMs / 1000);
  if (payload.iat > nowSeconds + MAX_FUTURE_SKEW_SECONDS) return { ok: false, reason: 'not_yet_valid' };
  if (nowSeconds >= payload.iat + MEETING_NOTE_AI_TICKET_TTL_SECONDS) return { ok: false, reason: 'expired' };

  return { ok: true, payload, expiresAt: expiresAtOf(payload.iat) };
}
// src/app/api/meeting-notes/[id]/ai/ticket/route.ts
// Processing ticket for the meeting-note AI flow (Phase 6 T9; FR-015, FR-031).
//
// POST issues the provider notice data and a signed processing ticket. It is
// called when the notice is shown. The route authorizes the session user
// first (auth.getUser → users.supabase_uid → current users row), reads the
// note under RLS (members of the note's company only), and requires editor
// rights (author while a member, current participant, or company admin —
// BR-003, the same rule the database applies) and a stored transcript. Only
// then does it read the AI settings metadata and today's usage (both through
// the user's session, own company only) and sign a ticket bound to the user,
// company, note, note revision, transcript identity, and settings revision,
// with a fresh SERVER-GENERATED idempotency key. Nothing is reserved here:
// the admission RPC re-checks membership, rights, settings revision, source,
// and the limit when processing starts. The API key is never read here.
import { NextRequest, NextResponse } from 'next/server';

import {
  issueMeetingNoteAiTicket,
  MeetingNoteAiTicketConfigError,
} from '@/lib/meeting-notes/ai/ticket';
import { computeMeetingNoteRights } from '@/lib/meeting-notes/note-detail';
import {
  beginMeetingNoteMutation,
  internalError,
  meetingNoteError,
  meetingNoteErrorWithData,
  notFound,
  ok,
  parsePathId,
} from '@/lib/meeting-notes/route-support';
import { SupabaseMeetingNoteAiOperationRepository } from 
'@/repositories/implementations/supabase/SupabaseMeetingNoteAiOperationRepository';
import { SupabaseMeetingNoteAiSettingsRepository } from 
'@/repositories/implementations/supabase/SupabaseMeetingNoteAiSettingsRepository';
import type { MeetingNoteAiTicketResponse } from '@/types/meeting-notes';

export const dynamic = 'force-dynamic';

interface RouteParams {
  params: Promise<{ id: string }>;
}

const PATH = '/api/meeting-notes/[id]/ai/ticket';

/**
 * POST /api/meeting-notes/[id]/ai/ticket (no body) → 200 MeetingNoteAiTicketResponse.
 * 404 MEETING_NOTE_NOT_FOUND (missing, other company, or caller removed);
 * 403 MEETING_NOTE_FORBIDDEN (member without edit rights);
 * 409 MEETING_NOTE_AI_TRANSCRIPT_REQUIRED (no stored transcript);
 * 409 MEETING_NOTE_AI_NOT_CONFIGURED { canConfigure } (no provider; admins get the settings hint);
 * 503 MEETING_NOTE_AI_UNAVAILABLE (server ticket secret missing — configuration error).
 */
export async function POST(request: NextRequest, { params }: RouteParams): Promise<NextResponse> {
  // No body is read; release it whatever happens.
  await request.body?.cancel().catch(() => undefined);

  const begun = await beginMeetingNoteMutation(request, PATH, 'meeting-note:ai-ticket');
  if (!begun.ok) return begun.response;
  const ctx = begun.value;

  const id = parsePathId((await params).id, 'MEETING_NOTE_NOT_FOUND', ctx);
  if (!id.ok) return id.response;

  try {
    const note = await ctx.repository.findById(id.value);
    if (!note || !ctx.dbUser.companyId || note.companyId !== ctx.dbUser.companyId) {
      return notFound('MEETING_NOTE_NOT_FOUND', ctx);
    }
    const participants = await ctx.repository.findParticipants(note.id);
    const rights = computeMeetingNoteRights(
      ctx.dbUser,
      note,
      participants.map((participant) => participant.userId)
    );
    if (!rights.canEdit) {
      return meetingNoteError(403, 'MEETING_NOTE_FORBIDDEN', ctx, 'meetingNotes.aiTicket.authorize');
    }
    if (!note.transcriptId) {
      return meetingNoteError(409, 'MEETING_NOTE_AI_TRANSCRIPT_REQUIRED', ctx, 'meetingNotes.aiTicket');
    }

    const settings = await new SupabaseMeetingNoteAiSettingsRepository(ctx.supabase).findByCompany(note.companyId);
    if (!settings.configured || !settings.provider || !settings.model || !settings.reasoningLevel || 
!settings.revision) {
      return meetingNoteErrorWithData(409, 'MEETING_NOTE_AI_NOT_CONFIGURED', ctx, {
        canConfigure: ctx.dbUser.role === 'admin',
      });
    }

    const usage = await new SupabaseMeetingNoteAiOperationRepository(ctx.supabase).getOwnCompanyUsage();

    let issued;
    try {
      issued = issueMeetingNoteAiTicket({
        userId: ctx.dbUser.id,
        companyId: note.companyId,
        noteId: note.id,
        sourceRevision: note.revision,
        transcriptId: note.transcriptId,
        settingsRevision: settings.revision,
      });
    } catch (error) {
      if (error instanceof MeetingNoteAiTicketConfigError) {
        // The event names the condition only; never the variable's value.
        console.error(
          JSON.stringify({ event: 'meeting_notes_ticket_secret_unconfigured', correlationId: ctx.correlationId })
        );
        return meetingNoteError(503, 'MEETING_NOTE_AI_UNAVAILABLE', ctx, 'meetingNotes.aiTicket.config');
      }
      throw error;
    }

    const body: MeetingNoteAiTicketResponse = {
      ticket: issued.ticket,
      expiresAt: issued.expiresAt,
      provider: settings.provider,
      model: settings.model,
      reasoningLevel: settings.reasoningLevel,
      settingsRevision: settings.revision,
      noteRevision: note.revision,
      transcriptId: note.transcriptId,
      usage: {
        limit: usage.limit,
        used: usage.used,
        usageDay: usage.usageDay,
        resetAt: usage.resetAt,
        limitReached: usage.used >= usage.limit,
      },
    };
    return ok(body, ctx);
  } catch (error) {
    return internalError(error, ctx, 'meetingNotes.aiTicket');
  }
}
// src/lib/meeting-notes/note-detail.ts
// Phase 6 FR-005 / BR-003: composes a note view from repository reads made
// with the caller's session (RLS: members of the note's company) and derives
// the caller's rights on the state that was read. The database re-checks every
// right on write; these flags only drive the UI.
import type { IMeetingNoteRepository } from '@/repositories/interfaces/IMeetingNoteRepository';
import type { ActionItem, MeetingNote, User } from '@/types/database';
import type {
  MeetingNoteActionItemView,
  MeetingNoteDetail,
  MeetingNoteRights,
  MeetingNoteVersion,
  MeetingNoteVersionParticipant,
  MeetingNoteVersionView,
} from '@/types/meeting-notes';

export interface MeetingNoteDetailOptions {
  /** Include the stored transcript text (up to 1 MB). */
  includeTranscript?: boolean;
}

/** BR-003 on a read state: author, current participant, or admin, each while a member. */
export function computeMeetingNoteRights(
  viewer: Pick<User, 'id' | 'companyId' | 'role'>,
  note: Pick<MeetingNote, 'companyId' | 'authorUserId'>,
  participantIds: readonly string[]
): MeetingNoteRights {
  if (!viewer.companyId || viewer.companyId !== note.companyId) {
    return { canEdit: false, canDelete: false };
  }
  const isAdmin = viewer.role === 'admin';
  const isAuthor = note.authorUserId === viewer.id;
  return {
    canEdit: isAdmin || isAuthor || participantIds.includes(viewer.id),
    canDelete: isAdmin || isAuthor,
  };
}

export function toActionItemViews(
  items: readonly ActionItem[],
  currentMemberIds: ReadonlySet<string>
): MeetingNoteActionItemView[] {
  return items.map((item) => ({
    ...item,
    assigneeIsCurrentMember: item.assigneeId === null ? null : currentMemberIds.has(item.assigneeId),
  }));
}

/** Action items with their assignee-membership flag. */
export async function loadActionItemViews(
  repository: IMeetingNoteRepository,
  companyId: string | null,
  items: readonly ActionItem[]
): Promise<MeetingNoteActionItemView[]> {
  const assigneeIds = items.flatMap((item) => (item.assigneeId ? [item.assigneeId] : []));
  const members = companyId ? await repository.findCurrentMemberIds(companyId, assigneeIds) : new Set<string>();
  return toActionItemViews(items, members);
}

/** The note view, or null when the note is missing or not visible to the caller. */
export async function loadMeetingNoteDetail(
  repository: IMeetingNoteRepository,
  viewer: Pick<User, 'id' | 'companyId' | 'role'>,
  noteId: string,
  options: MeetingNoteDetailOptions = {}
): Promise<MeetingNoteDetail | null> {
  const note = await repository.findById(noteId);
  if (!note) return null;

  const [participants, items, spaceName, transcript] = await Promise.all([
    repository.findParticipants(note.id),
    repository.findActionItems(note.id),
    note.roomId ? repository.findSpaceName(note.roomId) : Promise.resolve(null),
    options.includeTranscript && note.transcriptId ? repository.findTranscript(note.id) : Promise.resolve(null),
  ]);

  const participantIds = participants.map((participant) => participant.userId);
  const assigneeIds = items.flatMap((item) => (item.assigneeId ? [item.assigneeId] : []));
  const members = await repository.findCurrentMemberIds(note.companyId, [...participantIds, ...assigneeIds]);

  const detail: MeetingNoteDetail = {
    ...note,
    spaceName,
    participants: participants.map((participant: MeetingNoteVersionParticipant) => ({
      ...participant,
      isCurrentMember: members.has(participant.userId),
    })),
    actionItems: toActionItemViews(items, members),
    hasTranscript: note.transcriptId !== null,
    rights: computeMeetingNoteRights(viewer, note, participantIds),
  };
  if (options.includeTranscript) {
    detail.transcript = transcript;
  }
  return detail;
}

/**
 * A version with each participant snapshot flagged as a current member of
 * `companyId` or not (FR-030: "Former member" in versions too). Names stay the
 * snapshot the version recorded.
 */
export async function loadMeetingNoteVersionView(
  repository: IMeetingNoteRepository,
  companyId: string,
  version: MeetingNoteVersion
): Promise<MeetingNoteVersionView> {
  const members = await repository.findCurrentMemberIds(
    companyId,
    version.participants.map((participant) => participant.userId)
  );
  return {
    ...version,
    participants: version.participants.map((participant) => ({
      ...participant,
      isCurrentMember: members.has(participant.userId),
    })),
  };
}
