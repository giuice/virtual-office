      </SelectTrigger>
      <SelectContent onKeyDown={(event) => event.stopPropagation()}>
        <SelectItem value={UNASSIGNED}>Unassigned</SelectItem>
        {extra ? (
          <SelectItem value={extra.id}>{extra.isFormerMember ? `${extra.name} (Former member)` : 
extra.name}</SelectItem>
        ) : null}
        {sorted.map((member) => (
          <SelectItem key={member.id} value={member.id}>
            {member.displayName}
          </SelectItem>
        ))}
      </SelectContent>
    </Select>
  );
}
// src/lib/meeting-notes/ai/client-flow-errors.ts
// What a failed AI ticket / processing / Apply request means for the note
// view's AI flow (Phase 6 T13; SPEC FR-015, FR-021, FR-023, FR-025, §11) and
// the text the user sees. Browser-side: reads only the non-sensitive hints the
// routes send (limit, resetAt, provider label, retryable). The routes and the
// database stay the authority for every rule.
import { MeetingNotesApiError } from '@/lib/meeting-notes/client-api';
import { formatMeetingNoteTimestamp } from '@/lib/meeting-notes/format';
import { describeMeetingNoteError } from '@/lib/meeting-notes/form-errors';
import { describeMeetingNoteItemError } from '@/lib/meeting-notes/item-errors';
import { MEETING_NOTE_LIMITS } from '@/lib/meeting-notes/validation';

export type MeetingNoteAiFlowError =
  /** No provider configured (FR-025): the controls turn disabled. */
  | { kind: 'not_configured'; canConfigure: boolean }
  /** Daily limit reached (FR-023): limit and reset time. */
  | { kind: 'limit_reached'; limit: number | null; resetAt: string | null }
  /** The AI settings changed after the notice (FR-015): a new notice must be shown. */
  | { kind: 'settings_stale'; providerLabel: string | null }
  /** The ticket is older than 24 hours or unusable: a new notice must be shown. */
  | { kind: 'ticket_expired' }
  /** The note or its transcript changed after the notice. */
  | { kind: 'source_stale' }
  /** The note is gone or the caller lost access (removed, deleted). */
  | { kind: 'access_lost' }
  /** The browser request was aborted (Cancel, leaving the page, scope change). */
  | { kind: 'cancelled' }
  /** Anything else: provider failure, too long for the model, network, server. */
  | { kind: 'failed'; message: string; retryable: boolean };

function num(value: unknown): number | null {
  return typeof value === 'number' && Number.isFinite(value) ? value : null;
}

function str(value: unknown): string | null {
  return typeof value === 'string' && value.length > 0 ? value : null;
}

function isAbort(error: unknown): boolean {
  return error instanceof DOMException && error.name === 'AbortError';
}

/** Classifies a failed ticket or processing request. */
export function classifyMeetingNoteAiError(error: unknown): MeetingNoteAiFlowError {
  if (isAbort(error)) return { kind: 'cancelled' };
  if (!(error instanceof MeetingNotesApiError)) {
    return { kind: 'failed', message: 'Something went wrong. Try again.', retryable: true };
  }
  const { details } = error;
  switch (error.code) {
    case 'MEETING_NOTE_AI_NOT_CONFIGURED':
      return { kind: 'not_configured', canConfigure: details.canConfigure === true };
    case 'MEETING_NOTE_AI_LIMIT_REACHED':
      return { kind: 'limit_reached', limit: num(details.limit), resetAt: str(details.resetAt) };
    case 'MEETING_NOTE_AI_SETTINGS_STALE': {
      const settings = details.settings && typeof details.settings === 'object' ? (details.settings as Record<string, 
unknown>) : {};
      return { kind: 'settings_stale', providerLabel: str(settings.providerLabel) };
    }
    case 'MEETING_NOTE_AI_TICKET_EXPIRED':
    case 'MEETING_NOTE_AI_TICKET_INVALID':
      return { kind: 'ticket_expired' };
    case 'MEETING_NOTE_AI_SOURCE_STALE':
    case 'MEETING_NOTE_AI_BINDING_MISMATCH':
      return { kind: 'source_stale' };
    case 'MEETING_NOTE_AI_CANCELLED':
      return { kind: 'cancelled' };
    default:
      break;
  }
  if (error.status === 404 || error.status === 403) return { kind: 'access_lost' };
  // 422 too long for the model, 502 provider failures, 409 operation ended /
  // draft discarded: the route's message is fixed and sanitized per code.
  if (error.code.startsWith('MEETING_NOTE_AI_') && error.message) {
    return { kind: 'failed', message: error.message, retryable: details.retryable !== false };
  }
  return { kind: 'failed', message: describeMeetingNoteError(error), retryable: true };
}

/** The daily-limit message (FR-023), with the reset time in the viewer's local time. */
export function describeMeetingNoteAiLimit(limit: number | null, resetAt: string | null): string {
  const reached =
    limit === null
      ? "Your company reached today's AI processing limit."
      : `Your company reached today's limit of ${limit} AI ${limit === 1 ? 'processing' : 'processings'}.`;
  return resetAt ? `${reached} It resets at ${formatMeetingNoteTimestamp(resetAt)}.` : reached;
}

/** User-facing text of a flow error (not used for not_configured, which disables the controls). */
export function describeMeetingNoteAiFlowError(error: MeetingNoteAiFlowError): string {
  switch (error.kind) {
    case 'not_configured':
      return 'An admin needs to configure AI.';
    case 'limit_reached':
      return describeMeetingNoteAiLimit(error.limit, error.resetAt);
    case 'settings_stale':
      return 'The AI settings changed. Review the new notice before processing.';
    case 'ticket_expired':
      return 'This notice expired. Review the notice again before processing.';
    case 'source_stale':
      return 'The note changed since the notice was shown. Reload the note and try again.';
    case 'access_lost':
      return 'This note no longer exists or you no longer have access to it.';
    case 'cancelled':
      return 'Processing was cancelled.';
    case 'failed':
      return error.message;
  }
}

/** What a failed Apply means: a conflict, the 100-item limit, lost access, or another refusal. */
export type MeetingNoteAiApplyFailure =
  | { kind: 'conflict' }
  | { kind: 'item_limit'; message: string }
  | { kind: 'access_lost'; message: string }
  | { kind: 'other'; message: string };

export function classifyMeetingNoteAiApplyError(error: unknown): MeetingNoteAiApplyFailure {
  if (error instanceof MeetingNotesApiError) {
    if (error.code === 'MEETING_NOTE_STALE_REVISION') return { kind: 'conflict' };
    if (error.code === 'MEETING_NOTE_ITEM_LIMIT_REACHED') {
      return {
        kind: 'item_limit',
        message: `${MEETING_NOTE_LIMITS.maxItemsPerNote} items maximum: nothing was applied. Accept fewer action 
items, or delete some from the note first.`,
      };
    }
    if (error.status === 404 || error.status === 403) {
      return {
        kind: 'access_lost',
        message: 'This note no longer exists or you no longer have access to it. The draft was discarded.',
      };
    }
    if (
      error.code === 'MEETING_NOTE_SUMMARY_INVALID' ||
      error.code === 'MEETING_NOTE_AI_APPLY_ITEMS_INVALID' ||
      error.code === 'MEETING_NOTE_AI_APPLY_EMPTY'
    ) {
      return { kind: 'other', message: error.message };
    }
  }
  return { kind: 'other', message: describeMeetingNoteItemError(error) };
}
// src/lib/meeting-notes/client-api.ts
// Browser-side calls to the meeting-note routes (T3 notes, versions, and
// action items, T4 search, T7 Markdown export, T10 transcript uploads, T13 AI
// ticket / processing / Apply). The session cookie identifies the caller; the routes resolve the
// company and authorize every change, so nothing here is trusted for that.
// Every call takes an AbortSignal: reads get TanStack's, writes and the export
// get the scope fence's (useMeetingNotesScopedMutation), so a retired
// account's requests are aborted and their responses never applied.
import type { PaginatedResult } from '@/types/common';
import type {
  MeetingNoteActionItemFieldsInput,
  MeetingNoteActionItemView,
  MeetingNoteAiApplyInput,
  MeetingNoteAiApplyResult,
  MeetingNoteAiProcessResponse,
  MeetingNoteAiTicketResponse,
  MeetingNoteDetail,
  MeetingNoteListItem,
  MeetingNoteSearchResult,
  MeetingNoteVersionSummary,
  MeetingNoteVersionView,
} from '@/types/meeting-notes';

/** Notes per page in a space's Notes tab (the route allows 1..100). */
export const SPACE_NOTES_PAGE_SIZE = 20;
/** Results per page on the Meetings page (the route allows 1..50). */
export const MEETING_SEARCH_PAGE_SIZE = 20;

/**
 * A failed meeting-note request: HTTP status (0 = network), the route's error
 * code, and the non-sensitive hints the route sent next to them (e.g. the AI
 * routes' `limit`/`resetAt`, `settings`, `retryable`, `canConfigure`).
 */
export class MeetingNotesApiError extends Error {
  readonly status: number;
  readonly code: string;
  readonly details: Readonly<Record<string, unknown>>;

  constructor(status: number, code: string, message: string, details: Readonly<Record<string, unknown>> = {}) {
    super(message);
    this.name = 'MeetingNotesApiError';
    this.status = status;
    this.code = code;
    this.details = details;
  }
}

/**
 * 409 MEETING_NOTE_STALE_REVISION: another change landed first. Carries the
 * note's current state as the route read it, so the UI can show it (FR-007).
 */
export class MeetingNoteConflictError extends MeetingNotesApiError {
  readonly currentRevision: number;
  readonly note: MeetingNoteDetail;

  constructor(message: string, currentRevision: number, note: MeetingNoteDetail) {
    super(409, 'MEETING_NOTE_STALE_REVISION', message);
    this.name = 'MeetingNoteConflictError';
    this.currentRevision = currentRevision;
    this.note = note;
  }
}

/**
 * 409 MEETING_NOTE_ITEM_STALE_REVISION: the action item changed first. Carries
 * the item's current state so the UI can show it and retry on it.
 */
export class MeetingNoteItemConflictError extends MeetingNotesApiError {
  readonly currentRevision: number;
  readonly item: MeetingNoteActionItemView;

  constructor(message: string, currentRevision: number, item: MeetingNoteActionItemView) {
    super(409, 'MEETING_NOTE_ITEM_STALE_REVISION', message);
    this.name = 'MeetingNoteItemConflictError';
    this.currentRevision = currentRevision;
    this.item = item;
  }
}

/** Retry only failures a retry can fix: network errors and 5xx (never 4xx/429). */
export function shouldRetryMeetingNotesRequest(failureCount: number, error: unknown): boolean {
  if (failureCount >= 2) return false;
  if (!(error instanceof MeetingNotesApiError)) return false;
  return error.status === 0 || error.status >= 500;
}

export interface MeetingNotesPage<T> {
  items: T[];
  /** Offset of the next page; null when there is none. */
  nextCursor: number | null;
  hasMore: boolean;
  totalCount: number | null;
}

/** The search route's filters, already resolved to the route's parameters. */
export interface MeetingNoteSearchParams {
  /** Trimmed query; '' = list mode (newest meeting first). */
  q: string;
  /** Only this space; null = every space. Never set together with `spaceRemoved`. */
  spaceId: string | null;
  /** Only notes whose space was deleted. */
  spaceRemoved: boolean;
  /** ISO date-time with offset, inclusive. */
  from: string | null;
  /** ISO date-time with offset, exclusive. */
  to: string | null;
}

/** The editable fields of a note (content is sanitized again by the route). */
export interface MeetingNoteFieldsPayload {
  title: string;
  /** ISO 8601 date-time with offset. */
  meetingDate: string;
  content: string;
  participantIds: string[];
}

function asRecord(value: unknown): Record<string, unknown> {
  return value && typeof value === 'object' && !Array.isArray(value) ? (value as Record<string, unknown>) : {};
}

function invalidResponse(status = 200): MeetingNotesApiError {
  return new MeetingNotesApiError(status, 'INVALID_RESPONSE', 'Unexpected response from the server.');
}

function isNoteDetail(value: unknown): value is MeetingNoteDetail {
  const note = asRecord(value);
  return (
    typeof note.id === 'string' &&
    typeof note.revision === 'number' &&
    typeof note.title === 'string' &&
    typeof note.content === 'string' &&
    Array.isArray(note.participants) &&
    typeof note.rights === 'object' &&
    note.rights !== null
  );
}

function isItemView(value: unknown): value is MeetingNoteActionItemView {
  const item = asRecord(value);
  return (
    typeof item.id === 'string' &&
    typeof item.noteId === 'string' &&
    typeof item.description === 'string' &&
    typeof item.revision === 'number' &&
    typeof item.completed === 'boolean'
  );
}

/** The error a failed response stands for; a stale-revision 409 with its note or item becomes a conflict. */
async function toApiError(response: Response): Promise<MeetingNotesApiError> {
  let body: Record<string, unknown> = {};
  try {
    body = asRecord(await response.json());
  } catch {
    // Non-JSON error body.
  }
  const code = typeof body.code === 'string' ? body.code : `HTTP_${response.status}`;
  const message = typeof body.error === 'string' ? body.error : `Request failed (${response.status})`;
  if (response.status === 409 && code === 'MEETING_NOTE_STALE_REVISION' && isNoteDetail(body.note)) {
    const currentRevision = typeof body.currentRevision === 'number' ? body.currentRevision : body.note.revision;
    return new MeetingNoteConflictError(message, currentRevision, body.note);
  }
  if (response.status === 409 && code === 'MEETING_NOTE_ITEM_STALE_REVISION' && isItemView(body.item)) {
    const currentRevision = typeof body.currentRevision === 'number' ? body.currentRevision : body.item.revision;
    return new MeetingNoteItemConflictError(message, currentRevision, body.item);
  }
  // The hints only: never the note or item a body may carry.
  const { error: _error, code: _code, correlationId: _correlationId, note: _note, item: _item, ...details } = body;
  void [_error, _code, _correlationId, _note, _item];
  return new MeetingNotesApiError(response.status, code, message, details);
}

/** One JSON request to a meeting-note route; any failure becomes a MeetingNotesApiError. */
async function requestJson(url: string, init: RequestInit = {}): Promise<unknown> {
  let response: Response;
  try {
    response = await fetch(url, {
      ...init,
      credentials: 'same-origin',
      cache: 'no-store',
      // JSON bodies are strings; a FormData body gets its multipart boundary from fetch.
      headers: typeof init.body === 'string' ? { 'Content-Type': 'application/json' } : undefined,
    });
  } catch (error) {
    if (init.signal?.aborted) throw error;
    throw new MeetingNotesApiError(0, 'NETWORK_ERROR', 'Could not reach the server.');
  }
  if (!response.ok) throw await toApiError(response);
  try {
    return await response.json();
  } catch {
    throw invalidResponse(response.status);
  }
}

function toPage<T>(body: PaginatedResult<T>): MeetingNotesPage<T> {
  if (!body || !Array.isArray(body.items)) throw invalidResponse();
  const cursor = typeof body.nextCursor === 'number' ? body.nextCursor : Number(body.nextCursor);
  const hasMore = body.hasMore === true && Number.isInteger(cursor) && cursor >= 0;
  return {
    items: body.items,
    nextCursor: hasMore ? cursor : null,
    hasMore,
    totalCount: typeof body.totalCount === 'number' ? body.totalCount : null,
  };
}

async function getPage<T>(url: string, signal?: AbortSignal): Promise<MeetingNotesPage<T>> {
  const body = await requestJson(url, { method: 'GET', signal });
  return toPage(body as PaginatedResult<T>);
}

function readNote(body: unknown): MeetingNoteDetail {
  const note = asRecord(body).note;
  if (!isNoteDetail(note)) throw invalidResponse();
  return note;
}

function notePath(noteId: string): string {
  return `/api/meeting-notes/${encodeURIComponent(noteId)}`;
}

/** GET /api/meeting-notes — one space's notes, newest meeting date first. */
export function fetchSpaceMeetingNotes(
  spaceId: string,
  cursor: number,
  signal?: AbortSignal
): Promise<MeetingNotesPage<MeetingNoteListItem>> {
  const params = new URLSearchParams({
    spaceId,
    limit: String(SPACE_NOTES_PAGE_SIZE),
    cursor: String(cursor),
  });
  return getPage<MeetingNoteListItem>(`/api/meeting-notes?${params.toString()}`, signal);
}

/** GET /api/meeting-notes/search — company notes, ranked (or by date when `q` is empty). */
export function fetchMeetingNoteSearch(
  search: MeetingNoteSearchParams,
  cursor: number,
  signal?: AbortSignal
): Promise<MeetingNotesPage<MeetingNoteSearchResult>> {
  const params = new URLSearchParams({
    limit: String(MEETING_SEARCH_PAGE_SIZE),
    cursor: String(cursor),
  });
  if (search.q) params.set('q', search.q);
  if (search.spaceRemoved) params.set('removed', 'true');
  else if (search.spaceId) params.set('spaceId', search.spaceId);
  if (search.from) params.set('from', search.from);
  if (search.to) params.set('to', search.to);
  return getPage<MeetingNoteSearchResult>(`/api/meeting-notes/search?${params.toString()}`, signal);
}

/** GET /api/meeting-notes/[id] — the note view; with `includeTranscript`, also the stored transcript text. */
export async function fetchMeetingNoteDetail(
  noteId: string,
  options: { includeTranscript?: boolean } = {},
  signal?: AbortSignal
): Promise<MeetingNoteDetail> {
  const query = options.includeTranscript ? '?include=transcript' : '';
  return readNote(await requestJson(`${notePath(noteId)}${query}`, { method: 'GET', signal }));
}

/** POST /api/meeting-notes — creates a note in a space of the caller's company. */
export async function createMeetingNote(
  spaceId: string,
  fields: MeetingNoteFieldsPayload,
  signal?: AbortSignal
): Promise<MeetingNoteDetail> {
  return readNote(
    await requestJson('/api/meeting-notes', { method: 'POST', body: JSON.stringify({ spaceId, ...fields }), signal })
  );
}

/** PATCH /api/meeting-notes/[id] — full replacement against `expectedRevision` (409 → MeetingNoteConflictError). */
export async function updateMeetingNote(
  noteId: string,
  expectedRevision: number,
  fields: MeetingNoteFieldsPayload,
  signal?: AbortSignal
): Promise<MeetingNoteDetail> {
  return readNote(
    await requestJson(notePath(noteId), {
      method: 'PATCH',
      body: JSON.stringify({ expectedRevision, ...fields }),
      signal,
    })
  );
}

/** POST /api/meeting-notes/[id]/restore — restores a version as a new version (409 → MeetingNoteConflictError). */
export async function restoreMeetingNoteVersion(
  noteId: string,
  expectedRevision: number,
  versionId: string,
  signal?: AbortSignal
): Promise<MeetingNoteDetail> {
  return readNote(
    await requestJson(`${notePath(noteId)}/restore`, {
      method: 'POST',
      body: JSON.stringify({ expectedRevision, versionId }),
      signal,
    })
  );
}

/** One transcript file (.txt/.vtt/.srt, at most 1 MB) as multipart form data with the given fields. */
function transcriptForm(file: File, fields: Record<string, string>): FormData {
  const form = new FormData();
  for (const [name, value] of Object.entries(fields)) form.set(name, value);
  form.set('file', file, file.name);
  return form;
}

/** POST /api/meeting-notes/transcript — "New note from transcript" in a space of the caller's company. */
export async function createMeetingNoteFromTranscript(
  spaceId: string,
  file: File,
  signal?: AbortSignal
): Promise<MeetingNoteDetail> {
  return readNote(
    await requestJson('/api/meeting-notes/transcript', {
      method: 'POST',
      body: transcriptForm(file, { spaceId }),
      signal,
    })
  );
}

/** PUT /api/meeting-notes/[id]/transcript — replaces the stored transcript (409 → MeetingNoteConflictError). */
export async function attachMeetingNoteTranscript(
  noteId: string,
  expectedRevision: number,
  file: File,
  signal?: AbortSignal
): Promise<MeetingNoteDetail> {
  return readNote(
    await requestJson(`${notePath(noteId)}/transcript`, {
      method: 'PUT',
      body: transcriptForm(file, { expectedRevision: String(expectedRevision) }),
      signal,
    })
  );
}

/** DELETE /api/meeting-notes/[id]?expectedRevision=N (409 → MeetingNoteConflictError). */
export async function deleteMeetingNote(noteId: string, expectedRevision: number, signal?: AbortSignal): Promise<void> 
{
  const params = new URLSearchParams({ expectedRevision: String(expectedRevision) });
  await requestJson(`${notePath(noteId)}?${params.toString()}`, { method: 'DELETE', signal });
}

/** GET /api/meeting-notes/[id]/versions — the history, newest first. */
export async function fetchMeetingNoteVersions(
  noteId: string,
  signal?: AbortSignal
): Promise<{ revision: number; versions: MeetingNoteVersionSummary[] }> {
  const body = asRecord(await requestJson(`${notePath(noteId)}/versions`, { method: 'GET', signal }));
  if (!Array.isArray(body.versions) || typeof body.revision !== 'number') throw invalidResponse();
  return { revision: body.revision, versions: body.versions as MeetingNoteVersionSummary[] };
}

/** GET /api/meeting-notes/[id]/versions/[versionId] — one immutable version. */
export async function fetchMeetingNoteVersion(
  noteId: string,
  versionId: string,
  signal?: AbortSignal
): Promise<MeetingNoteVersionView> {
  const body = asRecord(
    await requestJson(`${notePath(noteId)}/versions/${encodeURIComponent(versionId)}`, { method: 'GET', signal })
  );
  const version = asRecord(body.version);
  if (typeof version.id !== 'string' || typeof version.content !== 'string' || !Array.isArray(version.participants)) {
    throw invalidResponse();
  }
  return body.version as MeetingNoteVersionView;
}

function itemPath(noteId: string, itemId?: string): string {
  const base = `${notePath(noteId)}/items`;
  return itemId === undefined ? base : `${base}/${encodeURIComponent(itemId)}`;
}

function readItem(body: unknown): MeetingNoteActionItemView {
  const item = asRecord(body).item;
  if (!isItemView(item)) throw invalidResponse();
  return item;
}

/** POST /api/meeting-notes/[id]/items — an editor adds an item (400 MEETING_NOTE_ITEM_LIMIT_REACHED at 100). */
export async function createMeetingNoteActionItem(
  noteId: string,
  fields: MeetingNoteActionItemFieldsInput,
  signal?: AbortSignal
): Promise<MeetingNoteActionItemView> {
  return readItem(await requestJson(itemPath(noteId), { method: 'POST', body: JSON.stringify(fields), signal }));
}

/** PATCH /api/meeting-notes/[id]/items/[itemId] — full replacement (409 → MeetingNoteItemConflictError). */
export async function updateMeetingNoteActionItem(
  noteId: string,
  itemId: string,
  expectedRevision: number,
  fields: MeetingNoteActionItemFieldsInput,
  signal?: AbortSignal
): Promise<MeetingNoteActionItemView> {
  return readItem(
    await requestJson(itemPath(noteId, itemId), {
      method: 'PATCH',
      body: JSON.stringify({ expectedRevision, ...fields }),
      signal,
    })
  );
}

/** DELETE /api/meeting-notes/[id]/items/[itemId]?expectedRevision=N (409 → MeetingNoteItemConflictError). */
export async function deleteMeetingNoteActionItem(
  noteId: string,
  itemId: string,
  expectedRevision: number,
  signal?: AbortSignal
): Promise<void> {
  const params = new URLSearchParams({ expectedRevision: String(expectedRevision) });
  await requestJson(`${itemPath(noteId, itemId)}?${params.toString()}`, { method: 'DELETE', signal });
}

/** PUT /api/meeting-notes/[id]/items/[itemId]/completion — editors and the current assignee. */
export async function setMeetingNoteActionItemCompleted(
  noteId: string,
  itemId: string,
  expectedRevision: number,
  completed: boolean,
  signal?: AbortSignal
): Promise<MeetingNoteActionItemView> {
  return readItem(
    await requestJson(`${itemPath(noteId, itemId)}/completion`, {
      method: 'PUT',
      body: JSON.stringify({ expectedRevision, completed }),
      signal,
    })
  );
}

export interface MeetingNoteMarkdownFile {
  blob: Blob;
  filename: string;
}

/** The download name the route chose (`filename*` first), or a fallback. */
function filenameFrom(disposition: string | null): string {
  const fallback = 'meeting-note.md';
  if (!disposition) return fallback;
  const extended = /filename\*=UTF-8''([^;]+)/i.exec(disposition);
  if (extended) {
    try {
      return decodeURIComponent(extended[1].trim()) || fallback;
    } catch {
      // Malformed encoding: use the plain name.
    }
  }
  const plain = /filename="([^"]+)"/i.exec(disposition);
  return plain?.[1] || fallback;
}

/**
 * GET /api/meeting-notes/[id]/export — the note as a .md file (FR-027). The
 * meeting date is written as a calendar day in `timeZone` (the viewer's).
 */
export async function fetchMeetingNoteMarkdown(
  noteId: string,
  options: { includeTranscript: boolean; timeZone: string },
  signal?: AbortSignal
): Promise<MeetingNoteMarkdownFile> {
  const params = new URLSearchParams({
    includeTranscript: options.includeTranscript ? 'true' : 'false',
    timeZone: options.timeZone,
  });
  let response: Response;
  try {
    response = await fetch(`${notePath(noteId)}/export?${params.toString()}`, {
      method: 'GET',
      credentials: 'same-origin',
      cache: 'no-store',
      signal,
    });
  } catch (error) {
    if (signal?.aborted) throw error;
    throw new MeetingNotesApiError(0, 'NETWORK_ERROR', 'Could not reach the server.');
  }
  if (!response.ok) throw await toApiError(response);
  return { blob: await response.blob(), filename: filenameFrom(response.headers.get('content-disposition')) };
}

// ---------------------------------------------------------------------------
// AI processing (T13 UI over the T9/T12 routes; FR-015, FR-018, FR-021, FR-031).
// The ticket carries the provider notice; one ticket starts one operation
// ("Try again" asks for a new ticket). AI text is data: render it as text only.
// ---------------------------------------------------------------------------

function isAiTicket(value: unknown): value is MeetingNoteAiTicketResponse {
  const body = asRecord(value);
  const usage = asRecord(body.usage);
  return (
    typeof body.ticket === 'string' &&
    typeof body.expiresAt === 'string' &&
    typeof body.provider === 'string' &&
    typeof body.model === 'string' &&
    typeof body.settingsRevision === 'number' &&
    typeof body.noteRevision === 'number' &&
    typeof usage.limit === 'number' &&
    typeof usage.used === 'number' &&
    typeof usage.resetAt === 'string'
  );
}

function isStringList(value: unknown): value is string[] {
  return Array.isArray(value) && value.every((entry) => typeof entry === 'string');
}

function isReviewDraft(value: unknown): boolean {
  const draft = asRecord(value);
  const summary = asRecord(draft.summary);
  return (
    isStringList(summary.keyPoints) &&
    isStringList(summary.decisions) &&
    isStringList(summary.nextSteps) &&
    Array.isArray(draft.items) &&
    draft.items.every((item) => typeof asRecord(item).description === 'string')
  );
}

function isAiProcessResponse(value: unknown): value is MeetingNoteAiProcessResponse {
  const body = asRecord(value);
  return (
    typeof body.operationId === 'string' &&
    typeof body.status === 'string' &&
    typeof body.replay === 'boolean' &&
    typeof body.sourceRevision === 'number' &&
    typeof body.transcriptId === 'string' &&
    (body.draft === null || isReviewDraft(body.draft))
  );
}

/** POST /api/meeting-notes/[id]/ai/ticket — the provider notice, today's usage, and a signed ticket. */
export async function fetchMeetingNoteAiTicket(noteId: string, signal?: AbortSignal): 
Promise<MeetingNoteAiTicketResponse> {
  const body = await requestJson(`${notePath(noteId)}/ai/ticket`, { method: 'POST', signal });
  if (!isAiTicket(body)) throw invalidResponse();
  return body;
}

/**
 * POST /api/meeting-notes/[id]/ai/process — starts the ticket's operation and
 * waits for its draft (up to a minute or more). Aborting `signal` cancels the
 * request; the server then aborts the provider call and discards the draft.
 */
export async function processMeetingNoteAiDraft(
  noteId: string,
  ticket: string,
  signal?: AbortSignal
): Promise<MeetingNoteAiProcessResponse> {
  const body = await requestJson(`${notePath(noteId)}/ai/process`, {
    method: 'POST',
    body: JSON.stringify({ ticket }),
    signal,
  });
  if (!isAiProcessResponse(body)) throw invalidResponse();
  return body;
}

export interface MeetingNoteAiApplyResponse {
  note: MeetingNoteDetail;
  /** The route returns the result without the note id (it is the path's). */
  applied: Omit<MeetingNoteAiApplyResult, 'noteId'>;
}

/** POST /api/meeting-notes/[id]/ai/apply — at the draft's source revision (409 → MeetingNoteConflictError). */
export async function applyMeetingNoteAiDraft(
  noteId: string,
  input: MeetingNoteAiApplyInput,
  signal?: AbortSignal
): Promise<MeetingNoteAiApplyResponse> {
  const body = await requestJson(`${notePath(noteId)}/ai/apply`, {
    method: 'POST',
    body: JSON.stringify(input),
    signal,
  });
  const applied = asRecord(asRecord(body).applied);
  if (typeof applied.versionId !== 'string' || !Array.isArray(applied.itemIds)) throw invalidResponse();
  return { note: readNote(body), applied: applied as unknown as MeetingNoteAiApplyResponse['applied'] };
}
// src/lib/meeting-notes/validation.ts
// Phase 6 request contracts for the meeting-note routes (FR-001, FR-011,
// AC-002, AC-009). Limits mirror SPEC §10 and the database checks, which stay
// the final authority. Each issue's message is a stable error code; lengths
// count Unicode code points, like Postgres char_length.
import { z } from 'zod';

export const MEETING_NOTE_LIMITS = {
  titleMaxChars: 200,
  contentMaxChars: 100_000,
  maxParticipants: 50,
  itemDescriptionMaxChars: 1_000,
  maxItemsPerNote: 100,
} as const;

/** Upper bound of a request body (sanitization runs on at most this much). */
export const MEETING_NOTE_MAX_BODY_BYTES = 1_048_576;

/**
 * Transcript files (FR-012, FR-013): .txt, .vtt, or .srt (case-insensitive),
 * 1..1,048,576 bytes (1 MB) of UTF-8 text. The database checks the stored
 * text against the same byte limit.
 */
export const MEETING_NOTE_TRANSCRIPT_LIMITS = {
  maxBytes: 1_048_576,
  extensions: ['.txt', '.vtt', '.srt'],
  /** Title fallback when the file name has no usable characters. */
  fallbackTitle: 'Transcript',
} as const;

/** Unicode code points (Postgres char_length), not UTF-16 units. */
export function codePointLength(value: string): number {
  return Array.from(value).length;
}

/**
 * Text Postgres can store: no NUL (22P05) and well-formed UTF-16 (a lone
 * surrogate cannot be encoded as UTF-8; PostgREST rejects the JSON body).
 */
export function isStorableText(value: string): boolean {
  return !value.includes('\u0000') && value.isWellFormed();
}

const ISO_DATE = /^\d{4}-\d{2}-\d{2}$/;

/** A real calendar date 'YYYY-MM-DD' that Postgres accepts (no year 0000: 22008). */
function isCalendarDate(value: string): boolean {
  if (!ISO_DATE.test(value) || value.startsWith('0000')) return false;
  const parsed = new Date(`${value}T00:00:00Z`);
  return !Number.isNaN(parsed.getTime()) && parsed.toISOString().slice(0, 10) === value;
}

const ISO_OFFSET = /([+-])(\d{2}):(\d{2})$/;

/**
 * An ISO date-time (already accepted by z.iso.datetime) that Postgres
 * timestamptz accepts too: zod allows year 0000 (Postgres 22008) and offsets
 * up to ±23:59 (Postgres allows at most ±15:59, else 22009).
 */
function isPostgresDateTime(value: string): boolean {
  if (value.startsWith('0000')) return false;
  const offset = ISO_OFFSET.exec(value);
  return offset === null || Number(offset[2]) <= 15;
}

const revisionSchema = (code: string) =>
  z.number({ error: code }).int({ error: code }).min(1, { error: code }).max(Number.MAX_SAFE_INTEGER, { error: code });

const titleSchema = z
  .string({ error: 'MEETING_NOTE_TITLE_INVALID' })
  .trim()
  .refine((value) => {
    const length = codePointLength(value);
    return length >= 1 && length <= MEETING_NOTE_LIMITS.titleMaxChars && isStorableText(value);
  }, { error: 'MEETING_NOTE_TITLE_INVALID' });

const meetingDateSchema = z.iso
  .datetime({ offset: true, error: 'MEETING_NOTE_DATE_REQUIRED' })
  .refine(isPostgresDateTime, { error: 'MEETING_NOTE_DATE_REQUIRED' });

// Raw content; its 100,000-char limit applies AFTER sanitization (route).
const contentSchema = z.string({ error: 'MEETING_NOTE_CONTENT_REQUIRED' });

const participantIdsSchema = z
  .array(z.guid({ error: 'MEETING_NOTE_PARTICIPANTS_INVALID' }), { error: 'MEETING_NOTE_PARTICIPANTS_INVALID' })
  .max(MEETING_NOTE_LIMITS.maxParticipants, { error: 'MEETING_NOTE_TOO_MANY_PARTICIPANTS' })
  .refine((ids) => new Set(ids.map((id) => id.toLowerCase())).size === ids.length, {
    error: 'MEETING_NOTE_PARTICIPANTS_INVALID',
  });

export const createMeetingNoteBodySchema = z.object({
  spaceId: z.guid({ error: 'MEETING_NOTE_SPACE_INVALID' }),
  title: titleSchema,
  meetingDate: meetingDateSchema,
  content: contentSchema.default(''),
  participantIds: participantIdsSchema.default([]),
});

// Full replacement: every field is required so a missing one never wipes data.
export const updateMeetingNoteBodySchema = z.object({
  expectedRevision: revisionSchema('MEETING_NOTE_REVISION_REQUIRED'),
  title: titleSchema,
  meetingDate: meetingDateSchema,
  content: contentSchema,
  participantIds: participantIdsSchema,
});

export const restoreMeetingNoteBodySchema = z.object({
  expectedRevision: revisionSchema('MEETING_NOTE_REVISION_REQUIRED'),
  versionId: z.guid({ error: 'MEETING_NOTE_VERSION_INVALID' }),
});

const descriptionSchema = z
  .string({ error: 'MEETING_NOTE_ITEM_DESCRIPTION_INVALID' })
  .trim()
  .refine((value) => {
    const length = codePointLength(value);
    return length >= 1 && length <= MEETING_NOTE_LIMITS.itemDescriptionMaxChars && isStorableText(value);
  }, { error: 'MEETING_NOTE_ITEM_DESCRIPTION_INVALID' });

const assigneeSchema = z.guid({ error: 'MEETING_NOTE_ITEM_ASSIGNEE_INVALID' }).nullable();

const dueDateSchema = z
  .string({ error: 'MEETING_NOTE_ITEM_DUE_DATE_INVALID' })
  .refine(isCalendarDate, { error: 'MEETING_NOTE_ITEM_DUE_DATE_INVALID' })
  .nullable();

export const createActionItemBodySchema = z.object({
  description: descriptionSchema,
  assigneeId: assigneeSchema.default(null),
  dueDate: dueDateSchema.default(null),
});

// Full replacement, like the note update.
export const updateActionItemBodySchema = z.object({
  expectedRevision: revisionSchema('MEETING_NOTE_ITEM_REVISION_REQUIRED'),
  description: descriptionSchema,
  assigneeId: assigneeSchema,
  dueDate: dueDateSchema,
});

export const actionItemCompletionBodySchema = z.object({
  expectedRevision: revisionSchema('MEETING_NOTE_ITEM_REVISION_REQUIRED'),
  completed: z.boolean({ error: 'MEETING_NOTE_ITEM_COMPLETED_REQUIRED' }),
});

/** `?expectedRevision=` of DELETE requests. */
export const expectedRevisionParamSchema = (code: string) =>
  z
    .string({ error: code })
    .regex(/^[1-9]\d{0,15}$/, { error: code })
    .transform(Number)
    .pipe(revisionSchema(code));

export const listMeetingNotesQuerySchema = z.object({
  spaceId: z.guid({ error: 'MEETING_NOTE_SPACE_INVALID' }),
  limit: z.coerce.number({ error: 'BAD_REQUEST' }).int({ error: 'BAD_REQUEST' }).min(1, { error: 'BAD_REQUEST' 
}).max(100, { error: 'BAD_REQUEST' }).default(20),
  cursor: z.coerce.number({ error: 'BAD_REQUEST' }).int({ error: 'BAD_REQUEST' }).min(0, { error: 'BAD_REQUEST' 
}).max(1_000_000, { error: 'BAD_REQUEST' }).default(0),
});

export const MEETING_NOTE_SEARCH_LIMITS = {
  queryMaxChars: 200,
  maxPageSize: 50,
  defaultPageSize: 20,
  maxOffset: 10_000,
} as const;

const searchPeriodBoundSchema = z.iso
  .datetime({ offset: true, error: 'MEETING_NOTE_SEARCH_PERIOD_INVALID' })
  .refine(isPostgresDateTime, { error: 'MEETING_NOTE_SEARCH_PERIOD_INVALID' })
  .optional();

/**
 * `GET /api/meeting-notes/search` query (FR-026). `q` empty = list mode;
 * `spaceId` and `removed=true` are mutually exclusive; `from` inclusive, `to`
 * exclusive (ISO date-time with offset); `cursor` is an offset.
 */
export const searchMeetingNotesQuerySchema = z
  .object({
    q: z
      .string({ error: 'BAD_REQUEST' })
      .trim()
      .refine((value) => codePointLength(value) <= MEETING_NOTE_SEARCH_LIMITS.queryMaxChars, {
        error: 'MEETING_NOTE_SEARCH_QUERY_TOO_LONG',
      })
      .refine(isStorableText, { error: 'MEETING_NOTE_SEARCH_INVALID' })
      .default(''),
    spaceId: z.guid({ error: 'MEETING_NOTE_SPACE_INVALID' }).optional(),
    removed: z
      .enum(['true', 'false'], { error: 'BAD_REQUEST' })
      .default('false')
      .transform((value) => value === 'true'),
    from: searchPeriodBoundSchema,
    to: searchPeriodBoundSchema,
    limit: z.coerce
      .number({ error: 'BAD_REQUEST' })
      .int({ error: 'BAD_REQUEST' })
      .min(1, { error: 'BAD_REQUEST' })
      .max(MEETING_NOTE_SEARCH_LIMITS.maxPageSize, { error: 'BAD_REQUEST' })
      .default(MEETING_NOTE_SEARCH_LIMITS.defaultPageSize),
    cursor: z.coerce
      .number({ error: 'BAD_REQUEST' })
      .int({ error: 'BAD_REQUEST' })
      .min(0, { error: 'BAD_REQUEST' })
      .max(MEETING_NOTE_SEARCH_LIMITS.maxOffset, { error: 'BAD_REQUEST' })
      .default(0),
  })
  .superRefine((value, context) => {
    if (value.spaceId !== undefined && value.removed) {
      context.addIssue({ code: 'custom', message: 'MEETING_NOTE_SEARCH_FILTER_INVALID', path: ['removed'] });
    }
    if (value.from !== undefined && value.to !== undefined && Date.parse(value.from) > Date.parse(value.to)) {
      context.addIssue({ code: 'custom', message: 'MEETING_NOTE_SEARCH_PERIOD_INVALID', path: ['from'] });
    }
  });

export type SearchMeetingNotesQuery = z.infer<typeof searchMeetingNotesQuerySchema>;

const TIME_ZONE_NAME = /^[A-Za-z0-9_+\-/]{1,64}$/;

/** true for an IANA time zone name this runtime's Intl accepts. */
export function isSupportedTimeZone(timeZone: string): boolean {
  if (!TIME_ZONE_NAME.test(timeZone)) return false;
  try {
    new Intl.DateTimeFormat('en-US', { timeZone });
    return true;
  } catch {
    return false;
  }
}

/**
 * `GET /api/meeting-notes/[id]/export` query (FR-027): `includeTranscript`
 * 'true' | 'false' (default false); `timeZone` the zone the meeting date is
 * written in (default UTC).
 */
export const exportMeetingNoteQuerySchema = z.object({
  includeTranscript: z
    .enum(['true', 'false'], { error: 'BAD_REQUEST' })
    .default('false')
    .transform((value) => value === 'true'),
  timeZone: z.string({ error: 'BAD_REQUEST' }).refine(isSupportedTimeZone, { error: 'BAD_REQUEST' }).default('UTC'),
});

/** Path ids: a malformed id is answered like a missing one. */
export const pathIdSchema = z.guid();

export type CreateMeetingNoteBody = z.infer<typeof createMeetingNoteBodySchema>;
export type UpdateMeetingNoteBody = z.infer<typeof updateMeetingNoteBodySchema>;
export type RestoreMeetingNoteBody = z.infer<typeof restoreMeetingNoteBodySchema>;
/**
 * POST /api/meeting-notes/[id]/ai/process (T12): the signed ticket from the
 * notice, and optionally the key the client believes it carries — which must
 * then equal the ticket's (a client can never choose a key).
 */
export const startMeetingNoteAiProcessingBodySchema = z.object({
  ticket: z.string({ error: 'MEETING_NOTE_AI_TICKET_INVALID' }).min(1, { error: 'MEETING_NOTE_AI_TICKET_INVALID' 
}).max(4_096, {
    error: 'MEETING_NOTE_AI_TICKET_INVALID',
  }),
  idempotencyKey: z.guid({ error: 'MEETING_NOTE_AI_BINDING_MISMATCH' }).optional(),
});

/** Draft summary limits (mirror the provider draft schema, T11). */
export const MEETING_NOTE_AI_SUMMARY_LIMITS = {
  maxEntriesPerSection: 100,
  maxEntryChars: 2_000,
} as const;

const summaryEntriesSchema = z
  .array(
    z.string({ error: 'MEETING_NOTE_SUMMARY_INVALID' }).refine(
      (value) => codePointLength(value) <= MEETING_NOTE_AI_SUMMARY_LIMITS.maxEntryChars && isStorableText(value),
      { error: 'MEETING_NOTE_SUMMARY_INVALID' }
    ),
    { error: 'MEETING_NOTE_SUMMARY_INVALID' }
  )
  .max(MEETING_NOTE_AI_SUMMARY_LIMITS.maxEntriesPerSection, { error: 'MEETING_NOTE_SUMMARY_INVALID' });

/** POST /api/meeting-notes/[id]/ai/apply (T12): edited summary + accepted items at the draft's source revision. */
export const applyMeetingNoteAiDraftBodySchema = z.object({
  expectedRevision: revisionSchema('MEETING_NOTE_REVISION_REQUIRED'),
  summary: z.object(
    {
      keyPoints: summaryEntriesSchema,
      decisions: summaryEntriesSchema,
      nextSteps: summaryEntriesSchema,
    },
    { error: 'MEETING_NOTE_SUMMARY_INVALID' }
  ),
  items: z
    .array(
      z.object({
        description: descriptionSchema,
        assigneeId: assigneeSchema.default(null),
        dueDate: dueDateSchema.default(null),
      }),
      { error: 'MEETING_NOTE_AI_APPLY_ITEMS_INVALID' }
    )
    .max(MEETING_NOTE_LIMITS.maxItemsPerNote, { error: 'MEETING_NOTE_AI_APPLY_ITEMS_INVALID' }),
});

export type CreateActionItemBody = z.infer<typeof createActionItemBodySchema>;
export type UpdateActionItemBody = z.infer<typeof updateActionItemBodySchema>;
export type ActionItemCompletionBody = z.infer<typeof actionItemCompletionBodySchema>;

