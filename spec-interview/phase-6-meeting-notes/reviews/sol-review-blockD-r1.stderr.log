// src/lib/meeting-notes/ai/adapters/transport.ts
// Shared transport guard of the meeting-note provider adapters (Phase 6 T11).
// Every SDK client gets `fetch: createDispatchFetch(state, credential)` and
// `maxRetries: 0`; the wrapper:
//   * refuses a second outbound request on the same call (exactly one request
//     per call, even if an SDK tried to retry);
//   * refuses to send when the signal is already aborted (never sent);
//   * never follows a redirect (`redirect: 'manual'`): a 3xx from the provider
//     or a gateway IS the initial response and is classified like any other
//     non-2xx (not a listed rejection → counted), so no second request is
//     made and no credential is forwarded to another origin;
//   * rebuilds the outgoing headers from an allowlist and sets ONLY the
//     admitted credential: whatever the SDKs pick up from the server
//     environment (ANTHROPIC_CUSTOM_HEADERS / OPENAI_CUSTOM_HEADERS, ambient
//     keys or tokens, organization/project ids) never leaves the server;
//   * records whether the request was handed to the network (`dispatched`),
//     whether the connection was refused / the host did not resolve (no byte
//     can have reached the provider), and the INITIAL response status plus a
//     bounded copy of a non-2xx body for FR-022 classification — so counting
//     never depends on SDK error parsing or on provider text.
// createRequestControl joins the caller's AbortSignal with the adapter's own
// deadline (the SDK's timeout stops at response headers; the deadline also
// covers the streamed body).
import 'server-only';

import type { MeetingNoteAiProvider } from '@/types/meeting-notes';

import {
  classifyMeetingNoteAiPreProcessingRejection,
  type MeetingNoteAiModelCapability,
  type MeetingNoteAiReasoningLevel,
} from '../capabilities';
import {
  meetingNoteAiFailure,
  meetingNoteAiRejectionFailure,
  type MeetingNoteAiDraftFailure,
  type MeetingNoteAiUsageReport,
} from '../provider-errors';

type FetchInput = string | URL | Request;

export interface MeetingNoteAiDispatchState {
  dispatched: boolean;
  /** Connection refused or DNS failure before any request byte could leave. */
  unreachable: boolean;
  /** Status of the provider's initial response, once headers arrived. */
  initialStatus: number | null;
  /** Parsed JSON of a non-2xx initial body (≤64 KB), else null. */
  initialErrorBody: unknown;
}

export function createDispatchState(): MeetingNoteAiDispatchState {
  return { dispatched: false, unreachable: false, initialStatus: null, initialErrorBody: null };
}

const MAX_ERROR_BODY_BYTES = 64 * 1024;
/** Error codes that prove the TCP connection was never established. */
const UNREACHABLE_CODES: ReadonlySet<string> = new Set(['ECONNREFUSED', 'ENOTFOUND', 'EAI_AGAIN']);

function abortError(): Error {
  const error = new Error('The meeting-note AI request was aborted before it was sent.');
  error.name = 'AbortError';
  return error;
}

/** Walks `cause` links (undici wraps socket errors as `TypeError: fetch failed`). */
function isUnreachableError(err: unknown): boolean {
  let current: unknown = err;
  for (let depth = 0; depth < 5 && current !== null && typeof current === 'object'; depth += 1) {
    const code = (current as { code?: unknown }).code;
    if (typeof code === 'string' && UNREACHABLE_CODES.has(code)) return true;
    current = (current as { cause?: unknown }).cause;
  }
  return false;
}

async function readBoundedJson(response: Response): Promise<unknown> {
  const reader = response.body?.getReader();
  if (!reader) return null;
  const chunks: Uint8Array[] = [];
  let size = 0;
  try {
    for (;;) {
      const { done, value } = await reader.read();
      if (done) break;
      size += value.byteLength;
      if (size > MAX_ERROR_BODY_BYTES) {
        await reader.cancel();
        return null;
      }
      chunks.push(value);
    }
  } catch {
    return null;
  }
  const bytes = new Uint8Array(size);
  let offset = 0;
  for (const chunk of chunks) {
    bytes.set(chunk, offset);
    offset += chunk.byteLength;
  }
  try {
    return JSON.parse(new TextDecoder().decode(bytes)) as unknown;
  } catch {
    return null;
  }
}

/** The credential admitted with the operation, and how the provider expects it. */
export interface MeetingNoteAiAdmittedCredential {
  scheme: 'x-api-key' | 'bearer';
  apiKey: string;
}

/**
 * Request headers the SDKs legitimately send besides the credential. Every
 * other header — including any credential-bearing one — is dropped.
 */
const ALLOWED_REQUEST_HEADERS: ReadonlySet<string> = new Set([
  'accept',
  'content-type',
  'user-agent',
  'anthropic-version',
  'x-stainless-arch',
  'x-stainless-helper-method',
  'x-stainless-lang',
  'x-stainless-os',
  'x-stainless-package-version',
  'x-stainless-retry-count',
  'x-stainless-runtime',
  'x-stainless-runtime-version',
  'x-stainless-timeout',
]);

function outgoingHeaders(source: HeadersInit | undefined, credential: MeetingNoteAiAdmittedCredential): Headers {
  const headers = new Headers();
  for (const [name, value] of new Headers(source)) {
    if (ALLOWED_REQUEST_HEADERS.has(name)) headers.set(name, value);
  }
  if (credential.scheme === 'x-api-key') headers.set('x-api-key', credential.apiKey);
  else headers.set('authorization', `Bearer ${credential.apiKey}`);
  return headers;
}

export function createDispatchFetch(
  state: MeetingNoteAiDispatchState,
  credential: MeetingNoteAiAdmittedCredential
): (input: FetchInput, init?: RequestInit) => Promise<Response> {
  return async (input, init) => {
    if (state.dispatched) throw new Error('Only one outbound request is allowed per meeting-note AI call.');
    // The SDKs pass a URL plus an init; a Request object would carry its own
    // headers past the allowlist, so it is refused before anything is sent.
    if (input instanceof Request) throw new Error('The meeting-note AI transport only accepts a URL.');
    if (init?.signal?.aborted) throw abortError();
    const guarded: RequestInit = { ...init, headers: outgoingHeaders(init?.headers, credential), redirect: 'manual' };
    state.dispatched = true;
    let response: Response;
    try {
      response = await fetch(input, guarded);
    } catch (err) {
      if (isUnreachableError(err)) state.unreachable = true;
      throw err;
    }
    state.initialStatus = response.status;
    if (!response.ok) state.initialErrorBody = await readBoundedJson(response.clone());
    return response;
  };
}

export interface MeetingNoteAiRequestControl {
// src/lib/meeting-notes/ai/adapters/openai-compatible.ts
// Chat Completions adapter for OpenAI, Kimi, and GLM (Phase 6 T11) via the
// official `openai` SDK pointed at each provider's OpenAI-compatible base URL.
// Request: model, [system prompt, ONE user message holding only the normalized
// transcript], the matrix's output-budget field (`max_completion_tokens` or
// GLM's `max_tokens`) = the model's maxOutputTokens, `response_format`
// (json_schema strict for OpenAI/Kimi, json_object for GLM — validated after
// parsing), the matrix's reasoning fragment (`reasoning_effort` or GLM's
// `thinking`), stream: true, and — OpenAI only — `stream_options.include_usage`.
// No temperature/top_p (fixed or unsupported on these reasoning models).
// Streaming: as in the Anthropic adapter, the initial response is awaited
// separately from the chunk iteration, so a `data: {"error":…}` chunk after the
// 200 is counted while an initial listed rejection can be refunded (FR-022).
import 'server-only';

import OpenAI from 'openai';
import type { ChatCompletionCreateParamsStreaming } from 'openai/resources/chat/completions';
import type { ResponseFormatJSONObject, ResponseFormatJSONSchema } from 'openai/resources/shared';

import { MEETING_NOTE_AI_CAPABILITIES } from '../capabilities';
import { MEETING_NOTE_AI_DRAFT_JSON_SCHEMA, MEETING_NOTE_AI_DRAFT_SCHEMA_NAME } from '../draft-schema';
import { MEETING_NOTE_AI_SYSTEM_PROMPT } from '../prompt';
import {
  mergeWireFragment,
  type MeetingNoteAiAdapterRequest,
  type MeetingNoteAiStreamOutcome,
} from './transport';

export function buildOpenAiCompatibleDraftRequest(
  request: Pick<MeetingNoteAiAdapterRequest, 'provider' | 'model' | 'level' | 'transcript'>
): ChatCompletionCreateParamsStreaming {
  const capability = MEETING_NOTE_AI_CAPABILITIES[request.provider];
  const responseFormat: ResponseFormatJSONSchema | ResponseFormatJSONObject =
    capability.jsonOutput === 'json_schema'
      ? {
          type: 'json_schema',
          json_schema: { name: MEETING_NOTE_AI_DRAFT_SCHEMA_NAME, strict: true, schema: { 
...MEETING_NOTE_AI_DRAFT_JSON_SCHEMA } },
        }
      : { type: 'json_object' };
  const base: ChatCompletionCreateParamsStreaming = {
    model: request.model.id,
    messages: [
      { role: 'system', content: MEETING_NOTE_AI_SYSTEM_PROMPT },
      { role: 'user', content: request.transcript },
    ],
    response_format: responseFormat,
    stream: true,
    ...(request.provider === 'openai' ? { stream_options: { include_usage: true } } : {}),
  };
  if (capability.outputBudgetParam === 'max_completion_tokens') base.max_completion_tokens = 
request.model.maxOutputTokens;
  else base.max_tokens = request.model.maxOutputTokens;
  return mergeWireFragment(base, request.level.wire);
}

function finishOf(finishReason: string | null, refused: boolean): MeetingNoteAiStreamOutcome['finish'] {
  if (refused) return 'refusal';
  switch (finishReason) {
    case null:
      return 'incomplete';
    case 'stop':
      return 'end';
    case 'length':
      return 'length';
    // OpenAI/Kimi content filter; GLM "sensitive".
    case 'content_filter':
    case 'sensitive':
      return 'refusal';
    default:
      return 'other';
  }
}

export async function runOpenAiCompatibleDraftRequest(
  request: MeetingNoteAiAdapterRequest
): Promise<MeetingNoteAiStreamOutcome> {
  const client = new OpenAI({
    apiKey: request.apiKey,
    // Explicit values stop the SDK reading OPENAI_API_KEY / ADMIN_KEY / ORG_ID /
    // PROJECT_ID / WEBHOOK_SECRET / OPENAI_LOG. The SDK still reads
    // OPENAI_CUSTOM_HEADERS, so the transport (request.fetch) rebuilds the
    // headers from an allowlist and sets only the admitted key — nothing
    // ambient reaches OpenAI, Kimi, or GLM.
    adminAPIKey: null,
    organization: null,
    project: null,
    webhookSecret: null,
    baseURL: request.baseUrl,
    maxRetries: 0,
    timeout: request.sdkTimeoutMs,
    fetch: request.fetch,
    logLevel: 'off',
  });

  // Phase 1: initial response (non-2xx and connection failures throw here).
  const stream = await client.chat.completions.create(buildOpenAiCompatibleDraftRequest(request), {
    signal: request.signal,
  });

  // Phase 2: inside an accepted response.
  let text = '';
  let refused = false;
  let finishReason: string | null = null;
  const usage: MeetingNoteAiStreamOutcome['usage'] = {};
  for await (const chunk of stream) {
    if (chunk.usage) {
      usage.inputTokens = chunk.usage.prompt_tokens;
      usage.outputTokens = chunk.usage.completion_tokens;
    }
    const choice = chunk.choices?.[0];
    if (!choice) continue;
    if (typeof choice.delta?.content === 'string') text += choice.delta.content;
    if (choice.delta?.refusal) refused = true;
    if (choice.finish_reason) finishReason = choice.finish_reason;
  }
  return { text, finish: finishOf(finishReason, refused), usage };
}
// src/lib/meeting-notes/ai/adapters/anthropic.ts
// Anthropic Messages adapter (Phase 6 T11) via the official `@anthropic-ai/sdk`.
// Request: model, max_tokens = the model's maxOutputTokens, system prompt, ONE
// user message holding only the normalized transcript, `output_config` =
// { format: json_schema draft schema } merged with the matrix's reasoning
// fragment ({ effort }), stream: true. No `thinking` (adaptive is the default
// and `disabled`/`budget_tokens` are rejected on these models), no sampling
// parameters, no server-side `fallbacks` (FR-016/BR-013: no fallback to a
// model the admin did not choose).
// Streaming: the initial response (status + headers) is awaited separately
// from the event iteration, so an error that arrives after the 200 — such as
// an `overloaded_error` SSE event — is "inside an accepted response" and
// counted, while an initial 529 can be classified as a rejection (FR-022).
import 'server-only';

import Anthropic from '@anthropic-ai/sdk';

import { MEETING_NOTE_AI_DRAFT_JSON_SCHEMA } from '../draft-schema';
import { MEETING_NOTE_AI_SYSTEM_PROMPT } from '../prompt';
import {
  mergeWireFragment,
  type MeetingNoteAiAdapterRequest,
  type MeetingNoteAiStreamOutcome,
} from './transport';

export function buildAnthropicDraftRequest(
  request: Pick<MeetingNoteAiAdapterRequest, 'model' | 'level' | 'transcript'>
): Anthropic.MessageCreateParamsStreaming {
  const base: Anthropic.MessageCreateParamsStreaming = {
    model: request.model.id,
    max_tokens: request.model.maxOutputTokens,
    system: MEETING_NOTE_AI_SYSTEM_PROMPT,
    messages: [{ role: 'user', content: request.transcript }],
    output_config: { format: { type: 'json_schema', schema: { ...MEETING_NOTE_AI_DRAFT_JSON_SCHEMA } } },
    stream: true,
  };
  return mergeWireFragment(base, request.level.wire);
}

function finishOf(stopReason: string | null, stopped: boolean): MeetingNoteAiStreamOutcome['finish'] {
  if (!stopped || stopReason === null) return 'incomplete';
  switch (stopReason) {
    case 'end_turn':
    case 'stop_sequence':
      return 'end';
    case 'max_tokens':
    case 'model_context_window_exceeded':
      return 'length';
    case 'refusal':
      return 'refusal';
    default:
      return 'other';
  }
}

export async function runAnthropicDraftRequest(request: MeetingNoteAiAdapterRequest): 
Promise<MeetingNoteAiStreamOutcome> {
  const client = new Anthropic({
    apiKey: request.apiKey,
    // An explicit key and a null token stop the SDK's own credential chain and
    // ANTHROPIC_AUTH_TOKEN; the SDK still reads ANTHROPIC_CUSTOM_HEADERS, so
    // the transport (request.fetch) rebuilds the headers from an allowlist and
    // sets only the admitted key. logLevel 'off' ignores ANTHROPIC_LOG.
    authToken: null,
    baseURL: request.baseUrl,
    maxRetries: 0,
    timeout: request.sdkTimeoutMs,
    fetch: request.fetch,
    logLevel: 'off',
  });

  // Phase 1: resolves once a 2xx response's headers arrived; a non-2xx
  // initial response or a connection failure throws here.
  const stream = await client.messages.create(buildAnthropicDraftRequest(request), { signal: request.signal });

  // Phase 2: everything below is inside an accepted response.
  let text = '';
  let stopReason: string | null = null;
  let stopped = false;
  const usage: MeetingNoteAiStreamOutcome['usage'] = {};
  for await (const event of stream) {
    switch (event.type) {
      case 'message_start':
        usage.inputTokens = event.message.usage.input_tokens;
        break;
      case 'content_block_delta':
        if (event.delta.type === 'text_delta') text += event.delta.text;
        break;
      case 'message_delta':
        stopReason = event.delta.stop_reason;
        usage.outputTokens = event.usage.output_tokens;
        break;
      case 'message_stop':
        stopped = true;
        break;
      default:
        break;
    }
  }
  return { text, finish: finishOf(stopReason, stopped), usage };
}

