// src/lib/meeting-notes/ai/adapters/transport.ts
// Shared transport guard of the meeting-note provider adapters (Phase 6 T11).
// Every SDK client gets `fetch: createDispatchFetch(state, credential)` and
// `maxRetries: 0`; the wrapper:
//   * refuses a second outbound request on the same call (exactly one request
//     per call, even if an SDK tried to retry);
//   * refuses to send when the signal is already aborted (never sent);
//   * never follows a redirect (`redirect: 'manual'`): a 3xx from the provider
//     or a gateway IS the initial response and is classified like any other
//     non-2xx (not a listed rejection → counted), so no second request is
//     made and no credential is forwarded to another origin;
//   * rebuilds the outgoing headers from an allowlist and sets ONLY the
//     admitted credential: whatever the SDKs pick up from the server
//     environment (ANTHROPIC_CUSTOM_HEADERS / OPENAI_CUSTOM_HEADERS, ambient
//     keys or tokens, organization/project ids) never leaves the server;
//   * records whether the request was handed to the network (`dispatched`),
//     whether the connection was refused / the host did not resolve (no byte
//     can have reached the provider), and the INITIAL response status plus a
//     bounded copy of a non-2xx body for FR-022 classification — so counting
//     never depends on SDK error parsing or on provider text.
// createRequestControl joins the caller's AbortSignal with the adapter's own
// deadline (the SDK's timeout stops at response headers; the deadline also
// covers the streamed body).
import 'server-only';

import type { MeetingNoteAiProvider } from '@/types/meeting-notes';

import {
  classifyMeetingNoteAiPreProcessingRejection,
  type MeetingNoteAiModelCapability,
  type MeetingNoteAiReasoningLevel,
} from '../capabilities';
import {
  meetingNoteAiFailure,
  meetingNoteAiRejectionFailure,
  type MeetingNoteAiDraftFailure,
  type MeetingNoteAiUsageReport,
} from '../provider-errors';

type FetchInput = string | URL | Request;

export interface MeetingNoteAiDispatchState {
  dispatched: boolean;
  /** Connection refused or DNS failure before any request byte could leave. */
  unreachable: boolean;
  /** Status of the provider's initial response, once headers arrived. */
  initialStatus: number | null;
  /** Parsed JSON of a non-2xx initial body (≤64 KB), else null. */
  initialErrorBody: unknown;
}

export function createDispatchState(): MeetingNoteAiDispatchState {
  return { dispatched: false, unreachable: false, initialStatus: null, initialErrorBody: null };
}

const MAX_ERROR_BODY_BYTES = 64 * 1024;
/** Error codes that prove the TCP connection was never established. */
const UNREACHABLE_CODES: ReadonlySet<string> = new Set(['ECONNREFUSED', 'ENOTFOUND', 'EAI_AGAIN']);

function abortError(): Error {
  const error = new Error('The meeting-note AI request was aborted before it was sent.');
  error.name = 'AbortError';
  return error;
}

/** Walks `cause` links (undici wraps socket errors as `TypeError: fetch failed`). */
function isUnreachableError(err: unknown): boolean {
  let current: unknown = err;
  for (let depth = 0; depth < 5 && current !== null && typeof current === 'object'; depth += 1) {
    const code = (current as { code?: unknown }).code;
    if (typeof code === 'string' && UNREACHABLE_CODES.has(code)) return true;
    current = (current as { cause?: unknown }).cause;
  }
  return false;
}

async function readBoundedJson(response: Response): Promise<unknown> {
  const reader = response.body?.getReader();
  if (!reader) return null;
  const chunks: Uint8Array[] = [];
  let size = 0;
  try {
    for (;;) {
      const { done, value } = await reader.read();
      if (done) break;
      size += value.byteLength;
      if (size > MAX_ERROR_BODY_BYTES) {
        await reader.cancel();
        return null;
      }
      chunks.push(value);
    }
  } catch {
    return null;
  }
  const bytes = new Uint8Array(size);
  let offset = 0;
  for (const chunk of chunks) {
    bytes.set(chunk, offset);
    offset += chunk.byteLength;
  }
  try {
    return JSON.parse(new TextDecoder().decode(bytes)) as unknown;
  } catch {
    return null;
  }
}

/** The credential admitted with the operation, and how the provider expects it. */
export interface MeetingNoteAiAdmittedCredential {
  scheme: 'x-api-key' | 'bearer';
  apiKey: string;
}

/**
 * Request headers the SDKs legitimately send besides the credential. Every
 * other header — including any credential-bearing one — is dropped.
 */
const ALLOWED_REQUEST_HEADERS: ReadonlySet<string> = new Set([
  'accept',
  'content-type',
  'user-agent',
  'anthropic-version',
  'x-stainless-arch',
  'x-stainless-helper-method',
  'x-stainless-lang',
  'x-stainless-os',
  'x-stainless-package-version',
  'x-stainless-retry-count',
  'x-stainless-runtime',
  'x-stainless-runtime-version',
  'x-stainless-timeout',
]);

function outgoingHeaders(source: HeadersInit | undefined, credential: MeetingNoteAiAdmittedCredential): Headers {
  const headers = new Headers();
  for (const [name, value] of new Headers(source)) {
    if (ALLOWED_REQUEST_HEADERS.has(name)) headers.set(name, value);
  }
  if (credential.scheme === 'x-api-key') headers.set('x-api-key', credential.apiKey);
  else headers.set('authorization', `Bearer ${credential.apiKey}`);
  return headers;
}

export function createDispatchFetch(
  state: MeetingNoteAiDispatchState,
  credential: MeetingNoteAiAdmittedCredential
): (input: FetchInput, init?: RequestInit) => Promise<Response> {
  return async (input, init) => {
    if (state.dispatched) throw new Error('Only one outbound request is allowed per meeting-note AI call.');
    // The SDKs pass a URL plus an init; a Request object would carry its own
    // headers past the allowlist, so it is refused before anything is sent.
    if (input instanceof Request) throw new Error('The meeting-note AI transport only accepts a URL.');
    if (init?.signal?.aborted) throw abortError();
    const guarded: RequestInit = { ...init, headers: outgoingHeaders(init?.headers, credential), redirect: 'manual' };
    state.dispatched = true;
    let response: Response;
    try {
      response = await fetch(input, guarded);
    } catch (err) {
      if (isUnreachableError(err)) state.unreachable = true;
      throw err;
    }
    state.initialStatus = response.status;
    if (!response.ok) state.initialErrorBody = await readBoundedJson(response.clone());
    return response;
  };
}

export interface MeetingNoteAiRequestControl {
  signal: AbortSignal;
  /** Why the request was aborted, if it was. */
  readonly reason: 'timeout' | 'cancelled' | null;
  dispose(): void;
}

export function createRequestControl(callerSignal: AbortSignal | undefined, timeoutMs: number): 
MeetingNoteAiRequestControl {
  const controller = new AbortController();
  let reason: 'timeout' | 'cancelled' | null = null;
  const onCallerAbort = () => {
    reason ??= 'cancelled';
    controller.abort();
  };
  if (callerSignal?.aborted) onCallerAbort();
  else callerSignal?.addEventListener('abort', onCallerAbort, { once: true });
  const timer = setTimeout(() => {
    reason ??= 'timeout';
    controller.abort();
  }, timeoutMs);
  return {
    signal: controller.signal,
    get reason() {
      return reason;
    },
    dispose() {
      clearTimeout(timer);
      callerSignal?.removeEventListener('abort', onCallerAbort);
    },
  };
}

/**
 * Maps anything thrown while sending or reading the response to a failure.
 * The decision uses only the dispatch state and the abort reason:
 *   not dispatched           → never sent (cancelled before send / invalid configuration)
 *   connection refused / DNS → never sent (provider unreachable)
 *   deadline / caller abort  → counted timeout / cancellation
 *   initial non-2xx          → matrix classification (listed → refunded, else counted;
 *                              a 3xx redirect is never followed and is counted)
 *   initial 2xx              → counted: the stream had begun (mid-stream error or drop)
 *   no response yet          → counted: connection lost after the request was sent
 */
export function mapMeetingNoteAiTransportError(
  provider: MeetingNoteAiProvider,
  state: MeetingNoteAiDispatchState,
  control: MeetingNoteAiRequestControl
): MeetingNoteAiDraftFailure {
  if (!state.dispatched) {
    return control.reason
      ? meetingNoteAiFailure(provider, 'MEETING_NOTE_AI_CANCELLED_BEFORE_SEND', false)
      : meetingNoteAiFailure(provider, 'MEETING_NOTE_AI_CONFIGURATION_INVALID', false);
  }
  if (state.unreachable) return meetingNoteAiFailure(provider, 'MEETING_NOTE_AI_PROVIDER_UNREACHABLE', true);
  const status = state.initialStatus;
  if (status !== null && (status < 200 || status >= 300)) {
    const category = classifyMeetingNoteAiPreProcessingRejection(provider, status, state.initialErrorBody);
    return category
      ? meetingNoteAiRejectionFailure(provider, category, status)
      : meetingNoteAiFailure(provider, 'MEETING_NOTE_AI_PROVIDER_ERROR', true, { providerStatus: status });
  }
  if (control.reason === 'timeout') return meetingNoteAiFailure(provider, 'MEETING_NOTE_AI_TIMEOUT', true);
  if (control.reason === 'cancelled') return meetingNoteAiFailure(provider, 'MEETING_NOTE_AI_CANCELLED', true);
  if (status !== null) return meetingNoteAiFailure(provider, 'MEETING_NOTE_AI_STREAM_INTERRUPTED', true);
  return meetingNoteAiFailure(provider, 'MEETING_NOTE_AI_CONNECTION_LOST', true);
}

/**
 * Merges a capability-matrix wire fragment into a request body: plain-object
 * values are merged one level deep (Anthropic `output_config.effort` beside
 * `output_config.format`), anything else is set. The fragment holds only
 * documented provider fields, so the merged body keeps the base's type.
 */
export function mergeWireFragment<T extends object>(base: T, wire: Readonly<Record<string, unknown>>): T {
  const merged: Record<string, unknown> = { ...(base as Record<string, unknown>) };
  for (const [key, value] of Object.entries(wire)) {
    const current = merged[key];
    const isPlain = (v: unknown): v is Record<string, unknown> => v !== null && typeof v === 'object' && 
!Array.isArray(v);
    merged[key] = isPlain(current) && isPlain(value) ? { ...current, ...value } : value;
  }
  return merged as T;
}

/** What an adapter read from a stream that ended without throwing. */
export interface MeetingNoteAiStreamOutcome {
  /** Concatenated model text (thinking/reasoning content excluded). */
  text: string;
  /**
   * end: normal stop; length: output budget reached (truncated); refusal: the
   * model or a provider filter declined; incomplete: the stream ended without
   * its stop signal; other: any other stop reason.
   */
  finish: 'end' | 'length' | 'refusal' | 'incomplete' | 'other';
  usage: MeetingNoteAiUsageReport;
}

export interface MeetingNoteAiAdapterRequest {
  provider: MeetingNoteAiProvider;
  apiKey: string;
  baseUrl: string;
  model: MeetingNoteAiModelCapability;
  level: MeetingNoteAiReasoningLevel;
  transcript: string;
  fetch: (input: FetchInput, init?: RequestInit) => Promise<Response>;
  signal: AbortSignal;
  /** SDK header timeout; kept above the adapter deadline so the deadline decides. */
  sdkTimeoutMs: number;
}
// src/lib/meeting-notes/request-origin.ts
// Cross-origin request guard of the mutating meeting-notes routes (Phase 6,
// block C review C-3). SameSite=Lax session cookies are still sent by a
// sibling origin of the same site (another subdomain), which can submit a
// credentialed form or multipart POST without any preflight. Every mutating
// meeting-notes route therefore refuses a request that a browser marks as
// coming from another origin:
//   * Sec-Fetch-Site `cross-site` or `same-site` → refused (browser-set; a page
//     cannot forge it). `same-origin` and `none` (user-initiated) continue.
//   * Origin present → it must be the app's own origin: the request's Host
//     (or X-Forwarded-Host, which Next.js fills from Host), the request URL's
//     origin, or NEXT_PUBLIC_APP_URL. `null` or an unparsable Origin is refused.
//   * Neither header → allowed. Browsers send Origin on every POST/PUT/PATCH/
//     DELETE fetch and form submission, so a cross-origin browser request
//     always carries one; a request without both comes from a non-browser
//     client (server-to-server, tests), which holds no victim's cookies.
// Host/X-Forwarded-Host are trusted because Next.js builds request.url from
// its own listen address, not the public host. A forged value cannot help an
// attacking PAGE (a non-safelisted header triggers a CORS preflight these
// routes never approve); a non-browser client can forge it, but such a client
// holds no victim's cookies and is not what this guard defends against.
import 'server-only';

const REFUSED_FETCH_SITES: ReadonlySet<string> = new Set(['cross-site', 'same-site']);

function originOf(value: string | undefined | null): string | null {
  if (!value) return null;
  try {
    const url = new URL(value.trim());
    return url.protocol === 'http:' || url.protocol === 'https:' ? url.origin : null;
  } catch {
    return null;
  }
}

/** First value of a possibly comma-separated forwarding header, lower-cased. */
function firstHost(value: string | null): string | null {
  const first = value?.split(',')[0]?.trim().toLowerCase();
  return first ? first : null;
}

function isOwnOrigin(request: Request, origin: string): boolean {
  const parsed = originOf(origin);
  if (!parsed) return false;
  if (parsed === originOf(request.url)) return true;
  if (parsed === originOf(process.env.NEXT_PUBLIC_APP_URL)) return true;
  const host = new URL(parsed).host.toLowerCase();
  return host === firstHost(request.headers.get('host')) || host === 
firstHost(request.headers.get('x-forwarded-host'));
}

/** True when a browser marked the request as coming from another origin. */
export function isCrossOriginMeetingNoteRequest(request: Request): boolean {
  const fetchSite = request.headers.get('sec-fetch-site')?.trim().toLowerCase();
  if (fetchSite && REFUSED_FETCH_SITES.has(fetchSite)) return true;
  const origin = request.headers.get('origin');
  if (origin === null) return false;
  return !isOwnOrigin(request, origin);
}
// src/lib/meeting-notes/ai/provider-errors.ts
// Outcome codes, sanitized messages, and counting classes of a meeting-note
// draft request (Phase 6 T11; SPEC FR-020, FR-021, FR-022, §11).
//
// Counting classes (`kind`) for T12's settlement:
//   never_sent             — the provider cannot have received the transcript:
//                            preflight refusal, invalid configuration, abort
//                            before the request was handed to the network, or a
//                            connection that was refused / a host that did not
//                            resolve (no request byte can have left). Not counted.
//   preprocessing_rejected — the provider's INITIAL response was a non-2xx
//                            rejection whose status + type/code is listed in the
//                            capability matrix (classifyMeetingNoteAiPreProcessingRejection).
//                            Refunded.
//   processed_failure      — everything else after the request was sent:
//                            unlisted statuses/codes, non-envelope bodies, errors
//                            after the stream began, connection loss, timeout,
//                            cancellation after send, refusal, malformed /
//                            truncated / empty / invalid output. Counted.
// Messages are fixed per code: they never contain the API key, an
// Authorization header, the transcript, or provider text (which can echo input).
import 'server-only';

import type { MeetingNoteAiDraft, MeetingNoteAiProvider } from '@/types/meeting-notes';

import { MEETING_NOTE_AI_CAPABILITIES, type MeetingNoteAiRejectionCategory } from './capabilities';

export type MeetingNoteAiFailureKind = 'never_sent' | 'preprocessing_rejected' | 'processed_failure';

export type MeetingNoteAiFailureCode =
  // never_sent
  | 'MEETING_NOTE_AI_TRANSCRIPT_TOO_LONG_FOR_MODEL'
  | 'MEETING_NOTE_AI_CONFIGURATION_INVALID'
  | 'MEETING_NOTE_AI_CANCELLED_BEFORE_SEND'
  | 'MEETING_NOTE_AI_PROVIDER_UNREACHABLE'
  // preprocessing_rejected (by matrix category)
  | 'MEETING_NOTE_AI_PROVIDER_AUTH_FAILED'
  | 'MEETING_NOTE_AI_PROVIDER_RATE_LIMITED'
  | 'MEETING_NOTE_AI_PROVIDER_OVERLOADED'
  | 'MEETING_NOTE_AI_PROVIDER_UNAVAILABLE'
  // processed_failure
  | 'MEETING_NOTE_AI_PROVIDER_ERROR'
  | 'MEETING_NOTE_AI_STREAM_INTERRUPTED'
  | 'MEETING_NOTE_AI_CONNECTION_LOST'
  | 'MEETING_NOTE_AI_TIMEOUT'
  | 'MEETING_NOTE_AI_CANCELLED'
  | 'MEETING_NOTE_AI_REFUSED'
  | 'MEETING_NOTE_AI_OUTPUT_TRUNCATED'
  | 'MEETING_NOTE_AI_OUTPUT_MALFORMED'
  | 'MEETING_NOTE_AI_OUTPUT_INVALID'
  | 'MEETING_NOTE_AI_OUTPUT_EMPTY';

export interface MeetingNoteAiUsageReport {
  inputTokens?: number;
  outputTokens?: number;
}

export interface MeetingNoteAiDraftSuccess {
  ok: true;
  draft: MeetingNoteAiDraft;
  usage?: MeetingNoteAiUsageReport;
  /** Always true: a draft needs exactly one outbound request. */
  dispatched: true;
}

export interface MeetingNoteAiDraftFailure {
  ok: false;
  kind: MeetingNoteAiFailureKind;
  code: MeetingNoteAiFailureCode;
  /** Sanitized, user-presentable text (no key, transcript, or provider text). */
  message: string;
  /** Whether "Try again" can reasonably succeed without a settings change. */
  retryable: boolean;
  /**
   * Whether the outbound HTTP request was handed to the network (fetch was
   * called). False for preflight/config refusals and aborts before send; true
   * for everything the provider may have seen — and for a refused connection,
   * which is `never_sent` although fetch was attempted.
   */
  dispatched: boolean;
  /** Matrix category of a listed pre-processing rejection. */
  rejectionCategory?: MeetingNoteAiRejectionCategory;
  /** HTTP status of the provider's initial non-2xx response (no body is kept). */
  providerStatus?: number;
  /** FR-020 refusal details (the message names the limit). */
  estimatedInputTokens?: number;
  maxInputTokens?: number;
}

export type MeetingNoteAiDraftResult = MeetingNoteAiDraftSuccess | MeetingNoteAiDraftFailure;

function providerLabel(provider: MeetingNoteAiProvider): string {
  return MEETING_NOTE_AI_CAPABILITIES[provider].label;
}

const NOT_RETRYABLE: ReadonlySet<MeetingNoteAiFailureCode> = new Set<MeetingNoteAiFailureCode>([
  'MEETING_NOTE_AI_TRANSCRIPT_TOO_LONG_FOR_MODEL',
  'MEETING_NOTE_AI_CONFIGURATION_INVALID',
  'MEETING_NOTE_AI_PROVIDER_AUTH_FAILED',
  'MEETING_NOTE_AI_REFUSED',
]);

const KIND_BY_CODE: Readonly<Record<MeetingNoteAiFailureCode, MeetingNoteAiFailureKind>> = {
  MEETING_NOTE_AI_TRANSCRIPT_TOO_LONG_FOR_MODEL: 'never_sent',
  MEETING_NOTE_AI_CONFIGURATION_INVALID: 'never_sent',
  MEETING_NOTE_AI_CANCELLED_BEFORE_SEND: 'never_sent',
  MEETING_NOTE_AI_PROVIDER_UNREACHABLE: 'never_sent',
  MEETING_NOTE_AI_PROVIDER_AUTH_FAILED: 'preprocessing_rejected',
  MEETING_NOTE_AI_PROVIDER_RATE_LIMITED: 'preprocessing_rejected',
  MEETING_NOTE_AI_PROVIDER_OVERLOADED: 'preprocessing_rejected',
  MEETING_NOTE_AI_PROVIDER_UNAVAILABLE: 'preprocessing_rejected',
  MEETING_NOTE_AI_PROVIDER_ERROR: 'processed_failure',
  MEETING_NOTE_AI_STREAM_INTERRUPTED: 'processed_failure',
  MEETING_NOTE_AI_CONNECTION_LOST: 'processed_failure',
  MEETING_NOTE_AI_TIMEOUT: 'processed_failure',
  MEETING_NOTE_AI_CANCELLED: 'processed_failure',
  MEETING_NOTE_AI_REFUSED: 'processed_failure',
  MEETING_NOTE_AI_OUTPUT_TRUNCATED: 'processed_failure',
  MEETING_NOTE_AI_OUTPUT_MALFORMED: 'processed_failure',
  MEETING_NOTE_AI_OUTPUT_INVALID: 'processed_failure',
  MEETING_NOTE_AI_OUTPUT_EMPTY: 'processed_failure',
};

function messageFor(code: MeetingNoteAiFailureCode, provider: MeetingNoteAiProvider): string {
  const label = providerLabel(provider);
  switch (code) {
    case 'MEETING_NOTE_AI_TRANSCRIPT_TOO_LONG_FOR_MODEL':
      return 'The transcript is too long for the configured AI model.';
    case 'MEETING_NOTE_AI_CONFIGURATION_INVALID':
      return 'The AI settings are not valid. Ask an admin to review them.';
    case 'MEETING_NOTE_AI_CANCELLED_BEFORE_SEND':
      return 'Processing was cancelled before the transcript was sent.';
    case 'MEETING_NOTE_AI_PROVIDER_UNREACHABLE':
      return `${label} could not be reached. Try again later.`;
    case 'MEETING_NOTE_AI_PROVIDER_AUTH_FAILED':
      return `${label} rejected the API key or its permissions. Ask an admin to check the AI settings.`;
    case 'MEETING_NOTE_AI_PROVIDER_RATE_LIMITED':
      return `${label} refused the request because of a rate or usage limit on the company's account. Try again 
later.`;
    case 'MEETING_NOTE_AI_PROVIDER_OVERLOADED':
      return `${label} is overloaded right now. Try again in a few minutes.`;
    case 'MEETING_NOTE_AI_PROVIDER_UNAVAILABLE':
      return `${label} is unavailable right now. Try again later.`;
    case 'MEETING_NOTE_AI_PROVIDER_ERROR':
      return `${label} returned an error while processing the transcript.`;
    case 'MEETING_NOTE_AI_STREAM_INTERRUPTED':
      return `${label} stopped with an error while writing the draft.`;
    case 'MEETING_NOTE_AI_CONNECTION_LOST':
      return `The connection to ${label} was lost before the draft arrived.`;
    case 'MEETING_NOTE_AI_TIMEOUT':
      return `${label} did not finish the draft in time.`;
    case 'MEETING_NOTE_AI_CANCELLED':
      return 'Processing was cancelled after the transcript was sent.';
    case 'MEETING_NOTE_AI_REFUSED':
      return `${label} declined to process this transcript.`;
    case 'MEETING_NOTE_AI_OUTPUT_TRUNCATED':
      return `${label} stopped before the draft was complete.`;
    case 'MEETING_NOTE_AI_OUTPUT_MALFORMED':
      return `${label} returned a draft that could not be read.`;
    case 'MEETING_NOTE_AI_OUTPUT_INVALID':
      return `${label} returned a draft in an unexpected format.`;
    case 'MEETING_NOTE_AI_OUTPUT_EMPTY':
      return `${label} returned an empty draft.`;
  }
}

export function meetingNoteAiFailure(
  provider: MeetingNoteAiProvider,
  code: MeetingNoteAiFailureCode,
  dispatched: boolean,
  extra: Pick<
    MeetingNoteAiDraftFailure,
    'rejectionCategory' | 'providerStatus' | 'estimatedInputTokens' | 'maxInputTokens'
  > = {}
): MeetingNoteAiDraftFailure {
  return {
    ok: false,
    kind: KIND_BY_CODE[code],
    code,
    message: messageFor(code, provider),
    retryable: !NOT_RETRYABLE.has(code),
    dispatched,
    ...extra,
  };
}

/** FR-020 refusal; the message names the limit and the two ways out. */
export function meetingNoteAiTooLongFailure(
  provider: MeetingNoteAiProvider,
  details: { estimatedInputTokens: number; maxInputTokens: number; modelLabel: string }
): MeetingNoteAiDraftFailure {
  const failure = meetingNoteAiFailure(provider, 'MEETING_NOTE_AI_TRANSCRIPT_TOO_LONG_FOR_MODEL', false, {
    estimatedInputTokens: details.estimatedInputTokens,
    maxInputTokens: details.maxInputTokens,
  });
  const fmt = (n: number) => n.toLocaleString('en-US');
  return {
    ...failure,
    message:
      `The transcript is too long for ${details.modelLabel}: about ${fmt(details.estimatedInputTokens)} tokens, ` +
      `limit ${fmt(details.maxInputTokens)}. Use a smaller file or ask an admin to choose a model with a larger 
context.`,
  };
}

const CODE_BY_CATEGORY: Readonly<Record<MeetingNoteAiRejectionCategory, MeetingNoteAiFailureCode>> = {
  authentication: 'MEETING_NOTE_AI_PROVIDER_AUTH_FAILED',
  permission: 'MEETING_NOTE_AI_PROVIDER_AUTH_FAILED',
  rate_limit: 'MEETING_NOTE_AI_PROVIDER_RATE_LIMITED',
  overloaded: 'MEETING_NOTE_AI_PROVIDER_OVERLOADED',
  unavailable: 'MEETING_NOTE_AI_PROVIDER_UNAVAILABLE',
};

export function meetingNoteAiRejectionFailure(
  provider: MeetingNoteAiProvider,
  category: MeetingNoteAiRejectionCategory,
  status: number
): MeetingNoteAiDraftFailure {
  return meetingNoteAiFailure(provider, CODE_BY_CATEGORY[category], true, {
    rejectionCategory: category,
    providerStatus: status,
  });
}

