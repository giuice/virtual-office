// note has a summary) → provider notice → "Process" → progress with "Cancel"
// → review and "Apply"; failures show what happened and "Try again" (a new
// operation). The flow's state lives in the note view (useMeetingNoteAiFlow),
// so it survives switching to the edit form and dies with the page.
'use client';

import Link from 'next/link';
import { Loader2, Settings, Sparkles, X } from 'lucide-react';
import { useEffect, useRef } from 'react';

import { Button } from '@/components/ui/button';
import { useCompany } from '@/contexts/CompanyContext';
import { useMeetingNoteAiSettings } from '@/hooks/queries/useMeetingNoteAiSettings';
import type { MeetingNoteAiFlow } from '@/hooks/ui/useMeetingNoteAiFlow';
import { describeMeetingNoteAiFlowError } from '@/lib/meeting-notes/ai/client-flow-errors';
import { AI_SETTINGS_PATH } from '@/lib/meeting-notes/ui-paths';
import type { MeetingNoteAiProviderOption, MeetingNoteAiTicketResponse, MeetingNoteDetail } from 
'@/types/meeting-notes';
import { MeetingNoteAiNotice, MeetingNoteAiNoticeLoading } from './MeetingNoteAiNotice';
import { MeetingNoteAiReview } from './MeetingNoteAiReview';

export interface MeetingNoteAiPanelProps {
  note: MeetingNoteDetail;
  flow: MeetingNoteAiFlow;
}

function labelsFor(ticket: MeetingNoteAiTicketResponse, providers: readonly MeetingNoteAiProviderOption[]) {
  const provider = providers.find((option) => option.id === ticket.provider);
  const model = provider?.models.find((option) => option.id === ticket.model);
  return { providerLabel: provider?.label ?? ticket.provider, modelLabel: model?.label ?? ticket.model };
}

function NotConfigured({ canConfigure }: { canConfigure: boolean }) {
  return (
    <div className="flex flex-col gap-2" data-testid="meeting-note-ai-not-configured">
      <div>
        <Button type="button" size="sm" className="gap-1.5" disabled data-testid="meeting-note-ai-start">
          <Sparkles className="size-4" aria-hidden="true" />
          Generate summary
        </Button>
      </div>
      <p className="text-sm text-muted-foreground" role="status">
        An admin needs to configure AI.
      </p>
      {canConfigure ? (
        <Button asChild size="sm" variant="outline" className="w-fit gap-1.5">
          <Link href={AI_SETTINGS_PATH} data-testid="meeting-note-ai-settings-link">
            <Settings className="size-4" aria-hidden="true" />
            Open AI settings
          </Link>
        </Button>
      ) : null}
    </div>
  );
}

function Processing({ providerLabel, onCancel }: { providerLabel: string; onCancel: () => void }) {
  const cancelRef = useRef<HTMLButtonElement>(null);
  useEffect(() => {
    cancelRef.current?.focus();
  }, []);
  return (
    <div className="flex flex-wrap items-center gap-3 rounded-lg border border-[var(--vo-line-soft)] p-4" 
data-testid="meeting-note-ai-progress">
      <p className="flex min-w-0 flex-1 items-center gap-2 text-sm" role="status" aria-live="polite">
        <Loader2 className="size-4 shrink-0 animate-spin" aria-hidden="true" />
        Processing the transcript with {providerLabel}… This can take up to a minute. Leaving this page cancels it.
      </p>
      <Button
        ref={cancelRef}
        type="button"
        size="sm"
        variant="outline"
        className="gap-1.5"
        onClick={onCancel}
        data-testid="meeting-note-ai-cancel"
      >
        <X className="size-4" aria-hidden="true" />
        Cancel
      </Button>
    </div>
  );
}

function FlowError({
  message,
  canRetry,
  onRetry,
  onClose,
}: {
  message: string;
  canRetry: boolean;
  onRetry: () => void;
  onClose: () => void;
}) {
  const alertRef = useRef<HTMLDivElement>(null);
  useEffect(() => {
    alertRef.current?.focus();
  }, []);
  return (
    <div
      ref={alertRef}
      tabIndex={-1}
      className="flex flex-col gap-2 rounded-md border border-destructive/40 bg-destructive/10 px-3 py-2 text-sm 
outline-none"
      role="alert"
      data-testid="meeting-note-ai-error"
    >
      <p className="text-destructive">{message}</p>
      <div className="flex flex-wrap gap-2">
        {canRetry ? (
          <Button type="button" size="sm" onClick={onRetry} data-testid="meeting-note-ai-try-again">
            Try again
          </Button>
        ) : null}
        <Button type="button" size="sm" variant="ghost" onClick={onClose} data-testid="meeting-note-ai-error-close">
          Close
        </Button>
      </div>
    </div>
  );
}

export function MeetingNoteAiPanel({ note, flow }: MeetingNoteAiPanelProps) {
  const settings = useMeetingNoteAiSettings();
  const { companyUsers } = useCompany();
  const { state } = flow;
  const providers = settings.data?.providers ?? [];

  if (!note.rights.canEdit) return null;

  // FR-025: unconfigured (as last read, or as a route just answered).
  // A route's answer counts until the refreshed settings say AI is configured again.
  const notConfiguredByRoute =
    state.phase === 'error' && state.error.kind === 'not_configured' && settings.data?.settings.configured !== true
      ? state.error
      : null;
  // A draft under review stays reviewable: Apply needs no provider.
  if ((state.phase === 'idle' && settings.data?.settings.configured === false) || notConfiguredByRoute) {
    return (
      <NotConfigured canConfigure={settings.data?.canManage === true || notConfiguredByRoute?.canConfigure === true} />
    );
  }

  if (state.phase === 'preparing') return <MeetingNoteAiNoticeLoading />;

  if (state.phase === 'notice') {
    const labels = labelsFor(state.ticket, providers);
    return (
      <MeetingNoteAiNotice
        ticket={state.ticket}
        providerLabel={labels.providerLabel}
        modelLabel={labels.modelLabel}
        banner={state.banner}
        onProcess={flow.confirm}
        onCancel={flow.close}
      />
    );
  }

  if (state.phase === 'processing') {
    return <Processing providerLabel={labelsFor(state.ticket, providers).providerLabel} onCancel={flow.cancel} />;
  }

  if (state.phase === 'error') {
    return (
      <FlowError
        message={describeMeetingNoteAiFlowError(state.error)}
        canRetry={state.error.kind !== 'limit_reached' && state.error.kind !== 'access_lost' && note.hasTranscript}
        onRetry={flow.start}
        onClose={flow.close}
      />
    );
  }

  if (state.phase === 'review') {
    return (
      <MeetingNoteAiReview
        draft={state.draft}
        noteRevision={note.revision}
        existingItemCount={note.actionItems.length}
        members={companyUsers}
        applying={state.applying}
        applyError={state.applyError}
        conflict={state.conflict}
        onChange={flow.updateDraft}
        onApply={flow.apply}
        onDiscard={flow.discard}
        onReprocess={flow.start}
      />
    );
  }

  // Idle.
  const hasSummary = note.summary !== null && note.summary.trim() !== '';
  return (
    <div className="flex flex-col gap-2" data-testid="meeting-note-ai-idle">
      <div>
        <Button
          type="button"
          size="sm"
          className="gap-1.5"
          disabled={!note.hasTranscript || settings.isPending}
          onClick={flow.start}
          data-testid="meeting-note-ai-start"
        >
          <Sparkles className="size-4" aria-hidden="true" />
          {hasSummary ? 'Reprocess transcript' : 'Generate summary'}
        </Button>
      </div>
      {!note.hasTranscript ? (
        <p className="text-sm text-muted-foreground">Attach a transcript to generate a summary and action items.</p>
      ) : (
        <p className="text-xs text-muted-foreground">
          Drafts a summary and action items from the stored transcript. You review the draft before anything is saved.
        </p>
      )}
      {state.message ? (
        <p className="text-sm text-muted-foreground" role="status" data-testid="meeting-note-ai-message">
          {state.message}
        </p>
      ) : null}
    </div>
  );
}
// src/components/meeting-notes/MeetingNoteAiNotice.tsx
// The provider notice shown before processing (Phase 6 FR-015, FR-023): which
// provider and model receive the transcript text, today's usage with the
// reset time in the viewer's local time, and "Process". When the company has
// reached its limit, Process is disabled and the limit message is shown.
// Shown again (with a banner) when the AI settings changed or the notice
// expired; the user must confirm again.
'use client';

import { Info, Loader2, Sparkles } from 'lucide-react';
import { useEffect, useId, useRef } from 'react';

import { Button } from '@/components/ui/button';
import { describeMeetingNoteAiLimit } from '@/lib/meeting-notes/ai/client-flow-errors';
import { formatMeetingNoteTimestamp } from '@/lib/meeting-notes/format';
import type { MeetingNoteAiNoticeBanner } from '@/hooks/ui/useMeetingNoteAiFlow';
import type { MeetingNoteAiTicketResponse } from '@/types/meeting-notes';

export interface MeetingNoteAiNoticeProps {
  ticket: MeetingNoteAiTicketResponse;
  providerLabel: string;
  modelLabel: string;
  banner: MeetingNoteAiNoticeBanner | null;
  onProcess: () => void;
  onCancel: () => void;
}

function bannerText(banner: MeetingNoteAiNoticeBanner): string {
  if (banner.kind === 'expired') return 'The previous notice expired. Review it again before processing.';
  return banner.providerLabel
    ? `The AI settings changed: the provider is now ${banner.providerLabel}. Review the new notice before processing.`
    : 'The AI settings changed. Review the new notice before processing.';
}

export function MeetingNoteAiNotice({ ticket, providerLabel, modelLabel, banner, onProcess, onCancel }: 
MeetingNoteAiNoticeProps) {
  const headingId = useId();
  const headingRef = useRef<HTMLHeadingElement>(null);
  const { usage } = ticket;
  const limitReached = usage.limitReached || usage.used >= usage.limit;

  useEffect(() => {
    headingRef.current?.focus();
  }, []);

  return (
    <div
      className="flex flex-col gap-3 rounded-lg border border-[var(--vo-line-soft)] bg-muted/30 p-4"
      role="region"
      aria-labelledby={headingId}
      data-testid="meeting-note-ai-notice"
      data-provider={ticket.provider}
      data-reset-at={usage.resetAt}
    >
      {banner ? (
        <p
          className="flex items-start gap-2 rounded-md border border-amber-500/40 bg-amber-500/10 px-3 py-2 text-sm"
          role="alert"
          data-testid="meeting-note-ai-notice-banner"
        >
          <Info className="mt-0.5 size-4 shrink-0" aria-hidden="true" />
          {bannerText(banner)}
        </p>
      ) : null}
      <h4 id={headingId} ref={headingRef} tabIndex={-1} className="text-sm font-semibold outline-none">
        Before processing
      </h4>
      <p className="text-sm" data-testid="meeting-note-ai-notice-provider">
        The transcript text of this note will be sent to <strong>{providerLabel}</strong> (model {modelLabel}) to
        draft a summary and action items. Nothing in the note changes until you review and apply the draft.
      </p>
      <p className="text-xs text-muted-foreground" data-testid="meeting-note-ai-notice-usage">
        AI processings today: {usage.used} of {usage.limit}. The count resets at 
{formatMeetingNoteTimestamp(usage.resetAt)}.
      </p>
      {limitReached ? (
        <p className="text-sm text-destructive" role="alert" data-testid="meeting-note-ai-limit">
          {describeMeetingNoteAiLimit(usage.limit, usage.resetAt)}
        </p>
      ) : null}
      <div className="flex flex-wrap items-center gap-2">
        <Button
          type="button"
          size="sm"
          className="gap-1.5"
          disabled={limitReached}
          onClick={onProcess}
          data-testid="meeting-note-ai-process"
        >
          <Sparkles className="size-4" aria-hidden="true" />
          Process
        </Button>
        <Button type="button" size="sm" variant="ghost" onClick={onCancel} data-testid="meeting-note-ai-notice-cancel">
          Cancel
        </Button>
      </div>
    </div>
  );
}

