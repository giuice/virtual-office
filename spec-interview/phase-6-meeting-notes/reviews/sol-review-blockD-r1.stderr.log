/**
 * AC-016, UI part (FR-021, FR-022, FR-023, BR-008): in the note view,
 *   * the provider failing AFTER processing → the note and transcript are
 *     unchanged, an error with "Try again" appears, and usage grows by one;
 *   * "Try again" is a new operation (new notice); a listed pre-processing
 *     rejection (OpenAI 503 service_unavailable_error/server_is_overloaded)
 *     → error with "Try again" and usage unchanged;
 *   * the company reaching its daily limit between the notice and "Process"
 *     → processing is refused with the limit and the reset time in the
 *     viewer's local time, and the provider receives nothing.
 * Counting rules per outcome, timeouts, malformed output, and the midnight
 * reset are covered by the DB integration suite (meeting-note-ai-processing,
 * meeting-note-ai-usage). Usage is read through the real ticket route.
 */
test.describe('meeting notes — AI processing errors and the daily limit (AC-016 UI)', () => {
  test('errors offer "Try again" with the right counting; the limit is shown with its local reset time', async ({
    primaryPage,
    notesWorld,
  }) => {
    await fakeAi.reset();
    await configureFakeOpenAi(primaryPage, notesWorld);
    try {
      const tag = notesWorld.runTag;
      const page = primaryPage;
      const space = await notesWorld.createSpace('AI errors room');
      const noteId = await notesWorld.createNote(page, {
        spaceId: space.id,
        title: `${MEETING_NOTES_E2E_PREFIX} AI errors ${tag}`,
        meetingDate: new Date(),
        content: '<p>Manual notes</p>',
      });
      const transcript = `Ana: The release moves to Monday ${tag}.`;
      await notesWorld.setSummaryAndTranscriptUnsafe(noteId, { summary: null, transcript });
      const before = await notesWorld.readNote(page, noteId);
      const usage0 = await readAiUsage(page, noteId);

      const expectNoteUnchanged = async () => {
        const now = await notesWorld.readNote(page, noteId);
        expect(now.note?.summary).toBeNull();
        expect(now.note?.actionItems).toEqual([]);
        expect(now.note?.revision).toBe(before.note?.revision);
        expect(await readStoredTranscript(page, noteId)).toBe(transcript);
      };

      // 1. The provider fails after processing: error + "Try again", counted.
      await fakeAi.script('openai', { kind: 'error_after_processing', status: 500 });
      await openNote(page, noteId);
      await openAiNotice(page);
      await page.getByTestId('meeting-note-ai-process').click();
      const firstError = aiSection(page).getByTestId('meeting-note-ai-error');
      await expect(firstError).toBeVisible({ timeout: 60_000 });
      await expect(firstError.getByTestId('meeting-note-ai-try-again')).toBeVisible();
      await expect(page.getByTestId('meeting-note-ai-review')).toHaveCount(0);
      await expectNoteUnchanged();
      expect((await readAiUsage(page, noteId)).used).toBe(usage0.used + 1);

      // 2. "Try again" = a new notice and operation; a listed pre-processing rejection is not counted.
      await fakeAi.script('openai', {
        kind: 'rejection',
        status: 503,
        errorType: 'service_unavailable_error',
        errorCode: 'server_is_overloaded',
      });
      await openAiNotice(page, firstError.getByTestId('meeting-note-ai-try-again'));
      await page.getByTestId('meeting-note-ai-process').click();
      const secondError = aiSection(page).getByTestId('meeting-note-ai-error');
      await expect(secondError).toBeVisible({ timeout: 60_000 });
      await expect(secondError.getByTestId('meeting-note-ai-try-again')).toBeVisible();
      await expectNoteUnchanged();
      expect((await readAiUsage(page, noteId)).used).toBe(usage0.used + 1);
      expect(await fakeAi.received('openai')).toBe(2);

      // 3. The limit is reached after the notice was shown: refused with the limit and local reset time.
      const limit = usage0.used + 2;
      expect(limit, 'the day already used almost the whole maximum limit').toBeLessThanOrEqual(200);
      await setAiDailyLimit(page, limit);
      const notice = await openAiNotice(page, secondError.getByTestId('meeting-note-ai-try-again'));
      await expect(notice.getByTestId('meeting-note-ai-notice-usage')).toContainText(`${usage0.used + 1} of ${limit}`);
      await expect(page.getByTestId('meeting-note-ai-process')).toBeEnabled();
      // Another processing of the company uses the last unit meanwhile.
      await fakeAi.script(
        'openai',
        successOutcome({
          summary: { keyPoints: [`Elsewhere ${tag}`], decisions: [], nextSteps: [] },
          actionItems: [],
        }),
      );
      expect(await processThroughApi(page, noteId)).toBe(200);
      const full = await readAiUsage(page, noteId);
      expect(full.used).toBe(limit);
      expect(await fakeAi.received('openai')).toBe(3);

      await page.getByTestId('meeting-note-ai-process').click();
      const limitError = aiSection(page).getByTestId('meeting-note-ai-error');
      await expect(limitError).toBeVisible({ timeout: 30_000 });
      const localReset = await page.evaluate(
        (iso) => new Intl.DateTimeFormat(undefined, { dateStyle: 'medium', timeStyle: 'short' }).format(new Date(iso)),
        full.resetAt,
      );
      await expect(limitError).toContainText(`limit of ${limit} AI processings`);
      await expect(limitError).toContainText(`It resets at ${localReset}.`);
      await expect(limitError.getByTestId('meeting-note-ai-try-again')).toHaveCount(0);
      expect(await fakeAi.received('openai'), 'a refused start never reaches the provider').toBe(3);
      await expectNoteUnchanged();

      // A new notice says the same and does not offer "Process".
      await limitError.getByTestId('meeting-note-ai-error-close').click();
      const limitedNotice = await openAiNotice(page);
      await expect(limitedNotice.getByTestId('meeting-note-ai-limit')).toContainText(`It resets at ${localReset}.`);
      await expect(page.getByTestId('meeting-note-ai-process')).toBeDisabled();
    } finally {
      await fakeAi.reset();
      await notesWorld.resetAiSettingsUnsafe();
    }
  });
});
import { expect, test } from '../fixtures/meeting-notes';
import { localDay, MEETING_NOTES_E2E_PREFIX } from '../helpers/meeting-notes-e2e';
import {
  chooseTranscriptFile,
  configureFakeOpenAi,
  E2E_AI_MODEL_LABEL,
  E2E_AI_PROVIDER_LABEL,
  fakeAi,
  openAiNotice,
  processToReview,
  readStoredTranscript,
  successOutcome,
  suggestions,
  transcriptFile,
} from '../helpers/meeting-notes-ai-e2e';

/**
 * AC-010 (FR-012, FR-015, FR-016, FR-018, BR-006, BR-010), the J5 journey in
 * the real UI: a member chooses "New note from transcript" in a space's Notes
 * tab → the note exists at once (title = file name, today's date, the
 * transcript stored) → the notice names the provider and model → "Process"
 * returns a draft that changes nothing → the member edits the summary,
 * reassigns one suggestion, rejects one, accepts another → Apply stores
 * exactly the edited summary and the two accepted items in one new version →
 * attaching a new transcript replaces it immediately and keeps the summary.
 * Only the external provider is replaced (fake AI server, OpenAI protocol).
 */
test.describe('meeting notes — transcript to applied AI draft (AC-010)', () => {
  test('upload, notice, process, review, and Apply store exactly the reviewed draft; a new transcript keeps the 
summary', async ({
    primaryPage,
    secondaryPage,
    messagingData,
    notesWorld,
  }) => {
    await fakeAi.reset();
    await configureFakeOpenAi(primaryPage, notesWorld);
    try {
      const tag = notesWorld.runTag;
      const space = await notesWorld.createSpace('Transcript room');
      const primaryName = await notesWorld.displayNameOf(messagingData.primary.userId);
      const secondaryName = await notesWorld.displayNameOf(messagingData.secondary.userId);
      const page = secondaryPage;

      // "New note from transcript" in the space's Notes tab.
      const fileBase = `${MEETING_NOTES_E2E_PREFIX} Planning sync ${tag}`;
      const transcript = [
        `${primaryName}: I will update the changelog before Friday.`,
        'Zephyrine: Someone has to book the demo room.',
        `${secondaryName}: Launch stays on Friday.`,
      ].join('\n');
      await page.goto('/floor-plan');
      const card = page.getByTestId(`space-${space.id}`);
      await expect(card).toBeVisible({ timeout: 30_000 });
      await card.click();
      const panel = page.getByRole('region', { name: `Details for ${space.name}` });
      await expect(panel).toBeVisible();
      await panel.getByRole('tab', { name: 'Notes' }).click();
      await chooseTranscriptFile(
        page,
        panel.getByRole('button', { name: `New note from transcript in ${space.name}` }),
        transcriptFile(`${fileBase}.txt`, transcript),
      );

      // The note exists immediately and its view opens.
      await expect(page).toHaveURL(/\/meetings\/[0-9a-f-]{36}$/, { timeout: 30_000 });
      const noteId = new URL(page.url()).pathname.split('/').pop() ?? '';
      const view = page.getByTestId('meeting-note-view');
      await expect(view).toHaveAttribute('data-note-id', noteId, { timeout: 30_000 });
      await expect(page.getByTestId('meeting-note-title')).toHaveText(fileBase);
      const created = await notesWorld.readNote(page, noteId);
      expect(created.status).toBe(200);
      expect(created.note?.title).toBe(fileBase);
      expect(localDay(new Date(created.note?.meetingDate ?? ''))).toBe(localDay(new Date()));
      expect(created.note?.summary).toBeNull();
      expect(created.note?.actionItems).toEqual([]);
      expect(await readStoredTranscript(page, noteId)).toBe(transcript);
      const versionsBefore = (await notesWorld.readVersions(page, noteId)).length;

      // The notice names the provider (and model) before anything is sent.
      await fakeAi.script(
        'openai',
        successOutcome({
          summary: {
            keyPoints: [`Launch stays on Friday ${tag}`],
            decisions: [`Ship the beta ${tag}`],
            nextSteps: [`Prepare the release notes ${tag}`],
          },
          actionItems: [
            { description: `Update the changelog ${tag}`, assigneeName: primaryName },
            { description: `Book the demo room ${tag}`, assigneeName: 'Zephyrine' },
            { description: `Order pizza ${tag}`, assigneeName: null },
          ],
        }),
      );
      const notice = await openAiNotice(page);
      await expect(notice.getByTestId('meeting-note-ai-notice-provider')).toContainText(E2E_AI_PROVIDER_LABEL);
      await expect(notice.getByTestId('meeting-note-ai-notice-provider')).toContainText(E2E_AI_MODEL_LABEL);
      expect(await fakeAi.received('openai'), 'nothing is sent before "Process"').toBe(0);

      const review = await processToReview(page);
      expect(await fakeAi.received('openai')).toBe(1);

      // The draft changed nothing yet (BR-006).
      const pending = await notesWorld.readNote(page, noteId);
      expect(pending.note?.summary).toBeNull();
      expect(pending.note?.actionItems).toEqual([]);
      expect(pending.note?.revision).toBe(created.note?.revision);

      // Edit the summary.
      const firstKeyPoint = review.getByRole('textbox', { name: 'Key points 1' });
      await expect(firstKeyPoint).toHaveValue(`Launch stays on Friday ${tag}`);
      await firstKeyPoint.fill(`Launch moves to Monday ${tag}`);

      const rows = suggestions(page);
      await expect(rows).toHaveCount(3);
      for (let index = 0; index < 3; index += 1) {
        await expect(rows.nth(index)).toHaveAttribute('data-state', 'accepted');
      }
      // Reassign the first suggestion to the member.
      const firstAssignee = rows.nth(0).getByRole('combobox', { name: 'Assignee' });
      await firstAssignee.click();
      await page.getByRole('option', { name: secondaryName, exact: true }).click();
      await expect(firstAssignee).toContainText(secondaryName);
      // Accept the second as suggested (unassigned: "Zephyrine" is no member) with a due date.
      await expect(rows.nth(1).getByTestId('meeting-note-ai-suggestion-hint')).toContainText('Zephyrine');
      await expect(rows.nth(1).getByRole('combobox', { name: 'Assignee' })).toContainText('Unassigned');
      await rows.nth(1).getByLabel('Due date').fill('2026-11-05');
      // Reject the third.
      await rows.nth(2).getByTestId('meeting-note-ai-suggestion-reject').click();
      await expect(rows.nth(2)).toHaveAttribute('data-state', 'rejected');

      await review.getByTestId('meeting-note-ai-apply').click();
      await expect(page.getByTestId('meeting-note-ai-review')).toHaveCount(0, { timeout: 30_000 });
      await expect(page.getByTestId('meeting-note-summary')).toContainText(`Launch moves to Monday ${tag}`);

      // Exactly the reviewed summary and the two accepted items, in one new version.
      const applied = await notesWorld.readNote(page, noteId);
      expect(applied.note?.summary).toBe(
        [
          'Key points',
          `- Launch moves to Monday ${tag}`,
          '',
          'Decisions',
          `- Ship the beta ${tag}`,
          '',
          'Next steps',
          `- Prepare the release notes ${tag}`,
        ].join('\n'),
      );
      const items = (applied.note?.actionItems ?? [])
        .map((item) => ({ description: item.description, assigneeId: item.assigneeId, dueDate: item.dueDate, 
completed: item.completed }))
        .sort((a, b) => a.description.localeCompare(b.description));
      expect(items).toEqual([
        { description: `Book the demo room ${tag}`, assigneeId: null, dueDate: '2026-11-05', completed: false },
        { description: `Update the changelog ${tag}`, assigneeId: messagingData.secondary.userId, dueDate: null, 
completed: false },
      ]);
      expect((await notesWorld.readVersions(page, noteId)).length).toBe(versionsBefore + 1);
      await expect(page.getByTestId('meeting-note-item')).toHaveCount(2);

      // Attach a new transcript: replaced immediately, the summary unchanged.
      const replacement = `${secondaryName}: Second take ${tag}. We keep Monday.`;
      await chooseTranscriptFile(
        page,
        page.getByTestId('meeting-note-attach-transcript'),
        transcriptFile('second take.txt', replacement),
      );
      await expect.poll(() => readStoredTranscript(page, noteId), { timeout: 30_000 }).toBe(replacement);
      const afterAttach = await notesWorld.readNote(page, noteId);
      expect(afterAttach.note?.summary).toBe(applied.note?.summary);
      expect(afterAttach.note?.actionItems.length).toBe(2);
      await page.getByTestId('meeting-note-transcript-toggle').click();
      await expect(page.getByTestId('meeting-note-transcript')).toHaveText(replacement, { timeout: 30_000 });
    } finally {
      await fakeAi.reset();
      await notesWorld.resetAiSettingsUnsafe();
    }
  });
});
import { expect, test } from '../fixtures/meeting-notes';
import { MEETING_NOTES_E2E_PREFIX } from '../helpers/meeting-notes-e2e';
import {
  configureFakeOpenAi,
  fakeAi,
  openAiNotice,
  processToReview,
  successOutcome,
  suggestions,
} from '../helpers/meeting-notes-ai-e2e';
import { openNote } from '../helpers/meeting-notes-ui';

/**
 * AC-027 (FR-018, FR-019), UI part: an editor reprocesses the stored
 * transcript of a note that already has a summary and three action items (one
 * completed). The draft repeats one existing item (different case and
 * spacing) and proposes two new ones: the repeat arrives unchecked and marked
 * "Already exists", Apply appends only the two accepted new items, and the
 * three existing items — including the completion — are unchanged. The
 * 100-item refusal of Apply is covered by the DB integration suite.
 */
test.describe('meeting notes — reprocess with existing items (AC-027)', () => {
  test('a repeated item arrives unchecked as "Already exists"; Apply appends only the accepted new items', async ({
    primaryPage,
    notesWorld,
  }) => {
    await fakeAi.reset();
    await configureFakeOpenAi(primaryPage, notesWorld);
    try {
      const tag = notesWorld.runTag;
      const page = primaryPage;
      const space = await notesWorld.createSpace('Reprocess room');
      const noteId = await notesWorld.createNote(page, {
        spaceId: space.id,
        title: `${MEETING_NOTES_E2E_PREFIX} Reprocess ${tag}`,
        meetingDate: new Date(),
        content: '<p>Weekly sync</p>',
      });
      await notesWorld.addActionItem(page, noteId, `Send the agenda ${tag}`);
      const budget = await notesWorld.addActionItem(page, noteId, `Review the budget ${tag}`);
      await notesWorld.addActionItem(page, noteId, `Call the vendor ${tag}`);
      const completion = await page.request.put(`/api/meeting-notes/${noteId}/items/${budget.id}/completion`, {
        data: { expectedRevision: budget.revision, completed: true },
      });
      expect(completion.status(), await completion.text()).toBe(200);
      await notesWorld.setSummaryAndTranscriptUnsafe(noteId, {
        summary: `Key points\n- Earlier summary ${tag}`,
        transcript: `Ana: Review the budget. Bruno: draft the press release and update the roadmap ${tag}.`,
      });
      const before = await notesWorld.readNote(page, noteId);
      expect(before.note?.actionItems).toHaveLength(3);
      const existing = (before.note?.actionItems ?? []).map((item) => ({
        id: item.id,
        description: item.description,
        completed: item.completed,
        revision: item.revision,
        assigneeId: item.assigneeId,
        dueDate: item.dueDate,
      }));
      expect(existing.find((item) => item.id === budget.id)?.completed).toBe(true);
      const versionsBefore = (await notesWorld.readVersions(page, noteId)).length;

      await fakeAi.script(
        'openai',
        successOutcome({
          summary: {
            keyPoints: [`The budget is on track ${tag}`],
            decisions: [],
            nextSteps: [`Publish the press release ${tag}`],
          },
          actionItems: [
            { description: `  REVIEW   THE BUDGET ${tag.toUpperCase()} `, assigneeName: null },
            { description: `Draft the press release ${tag}`, assigneeName: null },
            { description: `Update the roadmap ${tag}`, assigneeName: null },
          ],
        }),
      );

      // Reprocess (the note already has a summary).
      await openNote(page, noteId);
      const start = page.getByTestId('meeting-note-ai-start');
      await expect(start).toHaveText(/Reprocess transcript/);
      await openAiNotice(page);
      const review = await processToReview(page);

      const rows = suggestions(page);
      await expect(rows).toHaveCount(3);
      await expect(rows.nth(0)).toHaveAttribute('data-duplicate', 'true');
      await expect(rows.nth(0).getByTestId('meeting-note-ai-suggestion-duplicate')).toHaveText('Already exists');
      await expect(rows.nth(0).getByTestId('meeting-note-ai-suggestion-accept')).not.toBeChecked();
      await expect(rows.nth(0)).toHaveAttribute('data-state', 'unchecked');
      for (const index of [1, 2]) {
        await expect(rows.nth(index)).toHaveAttribute('data-duplicate', 'false');
        await expect(rows.nth(index).getByTestId('meeting-note-ai-suggestion-accept')).toBeChecked();
      }

      await review.getByTestId('meeting-note-ai-apply').click();
      await expect(page.getByTestId('meeting-note-ai-review')).toHaveCount(0, { timeout: 30_000 });
      await expect(page.getByTestId('meeting-note-item')).toHaveCount(5, { timeout: 15_000 });

      const after = await notesWorld.readNote(page, noteId);
      const items = after.note?.actionItems ?? [];
      expect(items).toHaveLength(5);
      // The existing items, completion included, are untouched.
      for (const item of existing) {
        const now = items.find((candidate) => candidate.id === item.id);
        expect(now, `existing item ${item.description}`).toBeDefined();
        expect({
          id: now?.id,
          description: now?.description,
          completed: now?.completed,
          revision: now?.revision,
          assigneeId: now?.assigneeId,
          dueDate: now?.dueDate,
        }).toEqual(item);
      }
      // Only the two accepted new items were appended; the repeat was not.
      const added = items.filter((item) => !existing.some((old) => old.id === item.id)).map((item) => 
item.description).sort();
      expect(added).toEqual([`Draft the press release ${tag}`, `Update the roadmap ${tag}`]);
      expect(items.filter((item) => item.description.toLowerCase().includes('review the budget'))).toHaveLength(1);
      expect(after.note?.summary).toBe(
        ['Key points', `- The budget is on track ${tag}`, '', 'Next steps', `- Publish the press release 
${tag}`].join('\n'),
      );
      expect((await notesWorld.readVersions(page, noteId)).length).toBe(versionsBefore + 1);
    } finally {
      await fakeAi.reset();
      await notesWorld.resetAiSettingsUnsafe();
    }
  });
});
import { expect, test } from '../fixtures/meeting-notes';
import { MEETING_NOTES_E2E_PREFIX } from '../helpers/meeting-notes-e2e';
import { aiSection } from '../helpers/meeting-notes-ai-e2e';
import {
  actionItemRow,
  fillActionItemForm,
  openNote,
  saveActionItemForm,
  saveNoteForm,
} from '../helpers/meeting-notes-ui';

/**
 * AC-018 (FR-025): with no AI provider configured for the company, a member
 * who may edit a note (with a stored transcript) sees the AI controls
 * disabled with "An admin needs to configure AI" and no settings link, while
 * manual editing (fields and action items) works; an admin additionally gets
 * a link that opens the company page's AI settings section.
 */
test.describe('meeting notes — AI not configured (AC-018)', () => {
  test('AI controls are disabled with the message; manual editing works; only the admin gets the settings link', async 
({
    primaryPage,
    secondaryPage,
    notesWorld,
  }) => {
    await notesWorld.resetAiSettingsUnsafe();
    const tag = notesWorld.runTag;
    const space = await notesWorld.createSpace('No AI room');
    const member = secondaryPage;
    const noteId = await notesWorld.createNote(member, {
      spaceId: space.id,
      title: `${MEETING_NOTES_E2E_PREFIX} No AI ${tag}`,
      meetingDate: new Date(),
      content: '<p>Written by hand</p>',
    });
    await notesWorld.setSummaryAndTranscriptUnsafe(noteId, { summary: null, transcript: `Ana: Hello ${tag}.` });

    // The member (author, so an editor): disabled controls, the message, no link.
    await openNote(member, noteId);
    const memberAi = aiSection(member);
    await expect(memberAi.getByTestId('meeting-note-ai-not-configured')).toBeVisible({ timeout: 30_000 });
    await expect(memberAi.getByTestId('meeting-note-ai-start')).toBeDisabled();
    await expect(memberAi).toContainText('An admin needs to configure AI.');
    await expect(memberAi.getByTestId('meeting-note-ai-settings-link')).toHaveCount(0);

    // Manual editing works: the fields and an action item.
    const newTitle = `${MEETING_NOTES_E2E_PREFIX} No AI edited ${tag}`;
    await member.getByTestId('meeting-note-edit-button').click();
    await member.getByLabel('Title', { exact: true }).fill(newTitle);
    await saveNoteForm(member);
    await expect(member.getByTestId('meeting-note-title')).toHaveText(newTitle);
    const description = `Send the minutes ${tag}`;
    await member.getByTestId('meeting-note-item-add').click();
    await fillActionItemForm(member, { description });
    await saveActionItemForm(member);
    await expect(actionItemRow(member, description)).toBeVisible();
    const stored = await notesWorld.readNote(member, noteId);
    expect(stored.note?.title).toBe(newTitle);
    expect(stored.note?.actionItems.map((item) => item.description)).toEqual([description]);

    // The admin: the same disabled controls plus the link to the AI settings.
    const admin = primaryPage;
    await openNote(admin, noteId);
    const adminAi = aiSection(admin);
    await expect(adminAi.getByTestId('meeting-note-ai-not-configured')).toBeVisible({ timeout: 30_000 });
    await expect(adminAi.getByTestId('meeting-note-ai-start')).toBeDisabled();
    await expect(adminAi).toContainText('An admin needs to configure AI.');
    const link = adminAi.getByTestId('meeting-note-ai-settings-link');
    await expect(link).toHaveAttribute('href', '/company?tab=settings#ai-settings');
    await link.click();
    await expect(admin).toHaveURL(/\/company\?tab=settings#ai-settings$/, { timeout: 30_000 });
    await expect(admin.locator('#ai-settings')).toBeVisible({ timeout: 30_000 });
    await expect(admin.getByTestId('ai-settings-status')).toHaveText('AI is not configured yet.');
  });
});

