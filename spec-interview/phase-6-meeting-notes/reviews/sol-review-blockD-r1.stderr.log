// src/hooks/mutations/useMeetingNotesScopedMutation.ts
// The one mutation shape of the meeting-notes client layer (Phase 6 FR-021
// browser clause; block B review B-2). Each call records the scope (users.id
// + company id) it started in as its onMutate result and mutationKey prefix,
// and runs its request with an AbortSignal registered under that scope. When
// the scope retires (useMeetingNotesScopeLifecycle) the request is aborted,
// the mutation leaves the MutationCache, and every callback of the call — the
// hook's and the caller's — is skipped, so a late response never downloads a
// file, writes the cache, or shows a toast in another account's session.
// Mutations always run (networkMode 'always'): offline, the request fails at
// once with a network error the UI shows, instead of waiting paused.
'use client';

import { useMutation, type MutateOptions, type UseMutationResult } from '@tanstack/react-query';
import { useCallback, useEffect, useRef } from 'react';

import { meetingNoteQueryKeys, useMeetingNotesScope } from '@/hooks/queries/useMeetingNotes';
import { MeetingNotesApiError } from '@/lib/meeting-notes/client-api';
import {
  isCurrentMeetingNotesOrigin,
  isCurrentMeetingNotesScope,
  openMeetingNotesRequest,
  releaseMeetingNotesRequest,
  type MeetingNotesMutationOrigin,
  type MeetingNotesScope,
} from '@/lib/meeting-notes/scope-fence';

export interface MeetingNotesRequestContext {
  scope: MeetingNotesScope;
  /** Aborted when the scope retires (and on unmount with `abortOnUnmount`). */
  signal: AbortSignal;
}

export interface MeetingNotesScopedMutationOptions<TData, TVariables> {
  /** Names the mutation inside its scope's mutationKey. */
  name: string;
  mutationFn: (variables: TVariables, request: MeetingNotesRequestContext) => Promise<TData>;
  /** Runs only while the call's scope is still the signed-in one. */
  onSuccess?: (data: TData, variables: TVariables, scope: MeetingNotesScope) => void;
  /** Runs only while the call's scope is still the signed-in one. */
  onError?: (error: Error, variables: TVariables, scope: MeetingNotesScope) => void;
  /** Abort the request when the calling component unmounts (e.g. a download). */
  abortOnUnmount?: boolean;
  /** How long a settled call stays in the MutationCache once unobserved. */
  gcTime?: number;
}

export type MeetingNotesMutateOptions<TData, TVariables> = MutateOptions<
  TData,
  Error,
  TVariables,
  MeetingNotesMutationOrigin
>;

export type MeetingNotesScopedMutationResult<TData, TVariables> = Omit<
  UseMutationResult<TData, Error, TVariables, MeetingNotesMutationOrigin>,
  'mutate' | 'mutateAsync'
> & {
  mutate: (variables: TVariables, options?: MeetingNotesMutateOptions<TData, TVariables>) => void;
};

function noSession(): MeetingNotesApiError {
  return new MeetingNotesApiError(401, 'NO_SESSION', 'Your session is not ready. Reload the page and try again.');
}

/** The caller's callbacks, each skipped once the call's scope is no longer current. */
function fenceCallbacks<TData, TVariables>(
  options: MeetingNotesMutateOptions<TData, TVariables> | undefined
): MeetingNotesMutateOptions<TData, TVariables> | undefined {
  if (!options) return undefined;
  const { onSuccess, onError, onSettled } = options;
  return {
    onSuccess: onSuccess
      ? (data, variables, origin, context) => {
          if (isCurrentMeetingNotesOrigin(origin)) onSuccess(data, variables, origin, context);
        }
      : undefined,
    onError: onError
      ? (error, variables, origin, context) => {
          if (isCurrentMeetingNotesOrigin(origin)) onError(error, variables, origin, context);
        }
      : undefined,
    onSettled: onSettled
      ? (data, error, variables, origin, context) => {
          if (isCurrentMeetingNotesOrigin(origin)) onSettled(data, error, variables, origin, context);
        }
      : undefined,
  };
}

export function useMeetingNotesScopedMutation<TData, TVariables>(
  options: MeetingNotesScopedMutationOptions<TData, TVariables>
): MeetingNotesScopedMutationResult<TData, TVariables> {
  const scope = useMeetingNotesScope();
  const { abortOnUnmount = false } = options;
  const owned = useRef(new Set<AbortController>());

  useEffect(() => {
    const controllers = owned.current;
    return () => {
      if (abortOnUnmount) controllers.forEach((controller) => controller.abort());
      controllers.clear();
    };
  }, [abortOnUnmount]);

  const mutation = useMutation<TData, Error, TVariables, MeetingNotesMutationOrigin>({
    mutationKey: scope
      ? [...meetingNoteQueryKeys.scope(scope.userId, scope.companyId), 'mutation', options.name]
      : ['meeting-notes', 'no-scope', 'mutation', options.name],
    networkMode: 'always',
    retry: 0,
    gcTime: options.gcTime,
    onMutate: () => {
      if (!scope) throw noSession();
      return { scope };
    },
    mutationFn: async (variables) => {
      if (!scope || !isCurrentMeetingNotesScope(scope)) throw noSession();
      const controller = openMeetingNotesRequest(scope);
      owned.current.add(controller);
      try {
        return await options.mutationFn(variables, { scope, signal: controller.signal });
      } finally {
        owned.current.delete(controller);
        releaseMeetingNotesRequest(scope, controller);
      }
    },
    onSuccess: (data, variables, origin) => {
      if (origin && isCurrentMeetingNotesOrigin(origin)) options.onSuccess?.(data, variables, origin.scope);
    },
    onError: (error, variables, origin) => {
      if (origin && isCurrentMeetingNotesOrigin(origin)) options.onError?.(error, variables, origin.scope);
    },
  });

  const { mutate: rawMutate, mutateAsync: _unfenced, ...rest } = mutation;
  void _unfenced;
  const mutate = useCallback(
    (variables: TVariables, callbacks?: MeetingNotesMutateOptions<TData, TVariables>) => {
      rawMutate(variables, fenceCallbacks(callbacks));
    },
    [rawMutate]
  );

  return { ...rest, mutate };
}
// src/lib/meeting-notes/scope-fence.ts
// Browser-side scope fence of the meeting-notes client layer (Phase 6
// FR-021 browser clause; block B review B-1/B-2). A scope is the signed-in
// application users.id plus the company id. Every meeting-note request a
// mutation starts registers an AbortController under the scope it started
// in; when that scope retires (sign-out, account switch, company change),
// MeetingNotesScopeBoundary aborts those requests and late callbacks of the
// retired scope are dropped (no download, no cache write, no toast).
//
// The current scope is written only by MeetingNotesScopeBoundary (mounted
// once in the root layout, inside CompanyProvider). Until it has run, no
// scope is current, so nothing a mutation returns is applied.

export interface MeetingNotesScope {
  /** Application users.id (never auth.uid()). */
  userId: string;
  companyId: string;
}

/** What a scoped mutation's onMutate returns: the scope it started in. */
export interface MeetingNotesMutationOrigin {
  scope: MeetingNotesScope;
}

let currentKey: string | null = null;
const inFlight = new Map<string, Set<AbortController>>();

export function meetingNotesScopeKey(scope: MeetingNotesScope): string {
  return `${scope.userId}:${scope.companyId}`;
}

/** Called by MeetingNotesScopeBoundary whenever the signed-in scope changes. */
export function setCurrentMeetingNotesScope(scope: MeetingNotesScope | null): void {
  currentKey = scope ? meetingNotesScopeKey(scope) : null;
}

/** Whether `scope` is still the signed-in user's scope. */
export function isCurrentMeetingNotesScope(scope: MeetingNotesScope | null | undefined): boolean {
  return Boolean(scope) && currentKey !== null && currentKey === meetingNotesScopeKey(scope as MeetingNotesScope);
}

/** Whether a mutation's onMutate result names the current scope. */
export function isCurrentMeetingNotesOrigin(origin: unknown): origin is MeetingNotesMutationOrigin {
  if (!origin || typeof origin !== 'object' || !('scope' in origin)) return false;
  return isCurrentMeetingNotesScope((origin as MeetingNotesMutationOrigin).scope);
}

/**
 * A controller for one request of `scope`; aborted at once when the scope is
 * not current, otherwise when it retires. Release it when the request settles.
 */
export function openMeetingNotesRequest(scope: MeetingNotesScope): AbortController {
  const controller = new AbortController();
  if (!isCurrentMeetingNotesScope(scope)) {
    controller.abort();
    return controller;
  }
  const key = meetingNotesScopeKey(scope);
  const set = inFlight.get(key) ?? new Set<AbortController>();
  set.add(controller);
  inFlight.set(key, set);
  return controller;
}

export function releaseMeetingNotesRequest(scope: MeetingNotesScope, controller: AbortController): void {
  const key = meetingNotesScopeKey(scope);
  const set = inFlight.get(key);
  if (!set) return;
  set.delete(controller);
  if (set.size === 0) inFlight.delete(key);
}

/** Aborts every request still in flight for `scope`. */
export function abortMeetingNotesScopeRequests(scope: MeetingNotesScope): void {
  const key = meetingNotesScopeKey(scope);
  const set = inFlight.get(key);
  inFlight.delete(key);
  set?.forEach((controller) => controller.abort());
}
// src/hooks/queries/useMeetingNotesScopeLifecycle.ts
// Retires a meeting-notes scope when the signed-in application user or the
// company changes (sign-out, account switch in this or another tab, company
// change; Phase 6 FR-021 browser clause, block B review B-1/B-2): requests of
// the old scope are aborted, its meeting-note and AI-settings queries are
// cancelled and removed, and its mutations (variables, results, errors) leave
// the MutationCache. Mounted once, by MeetingNotesScopeBoundary.
'use client';

import { useQueryClient, type QueryClient } from '@tanstack/react-query';
import { useEffect, useRef } from 'react';

import { meetingNoteAiSettingsQueryKey } from '@/hooks/queries/useMeetingNoteAiSettings';
import { meetingNoteQueryKeys, useMeetingNotesScope } from '@/hooks/queries/useMeetingNotes';
import {
  abortMeetingNotesScopeRequests,
  meetingNotesScopeKey,
  setCurrentMeetingNotesScope,
  type MeetingNotesScope,
} from '@/lib/meeting-notes/scope-fence';

/** Drops everything the client holds for a scope that is no longer signed in. */
export function retireMeetingNotesScope(queryClient: QueryClient, scope: MeetingNotesScope): void {
  abortMeetingNotesScopeRequests(scope);
  const keys = [
    meetingNoteQueryKeys.scope(scope.userId, scope.companyId),
    meetingNoteAiSettingsQueryKey(scope.userId, scope.companyId),
  ];
  for (const queryKey of keys) {
    void queryClient.cancelQueries({ queryKey });
    queryClient.removeQueries({ queryKey });
  }
  // Scoped mutations carry the scope as their mutationKey prefix.
  const mutationCache = queryClient.getMutationCache();
  for (const mutation of mutationCache.findAll({ mutationKey: meetingNoteQueryKeys.scope(scope.userId, 
scope.companyId) })) {
    mutationCache.remove(mutation);
  }
}

export function useMeetingNotesScopeLifecycle(): void {
  const queryClient = useQueryClient();
  const scope = useMeetingNotesScope();
  const previous = useRef<MeetingNotesScope | null>(null);

  useEffect(() => {
    const before = previous.current;
    if (before && (!scope || meetingNotesScopeKey(before) !== meetingNotesScopeKey(scope))) {
      // Retire first: from here on no callback of the old scope applies.
      setCurrentMeetingNotesScope(null);
      retireMeetingNotesScope(queryClient, before);
    }
    previous.current = scope;
    setCurrentMeetingNotesScope(scope);
  }, [queryClient, scope]);
}
// src/hooks/queries/useMeetingNotes.ts
// Meeting-note read queries (Phase 6 FR-003, FR-004, FR-026). Every key starts
// with the viewer's application users.id and company id, so a cached page of
// one account or company is never shown to another.
'use client';

import { useInfiniteQuery } from '@tanstack/react-query';
import { useMemo } from 'react';

import { useCompany } from '@/contexts/CompanyContext';
import {
  fetchMeetingNoteSearch,
  fetchSpaceMeetingNotes,
  shouldRetryMeetingNotesRequest,
  type MeetingNoteSearchParams,
} from '@/lib/meeting-notes/client-api';
import type { MeetingNotesScope } from '@/lib/meeting-notes/scope-fence';

/** Prefix of every meeting-note query; mutations invalidate below it. */
export const MEETING_NOTES_QUERY_KEY = ['meeting-notes'] as const;

export const meetingNoteQueryKeys = {
  /** Everything one viewer has cached for one company. */
  scope: (userId: string, companyId: string) => [...MEETING_NOTES_QUERY_KEY, userId, companyId] as const,
  /** A space's Notes tab. */
  space: (userId: string, companyId: string, spaceId: string) =>
    [...meetingNoteQueryKeys.scope(userId, companyId), 'space', spaceId] as const,
  /** Every search / list on the Meetings page. */
  searches: (userId: string, companyId: string) =>
    [...meetingNoteQueryKeys.scope(userId, companyId), 'search'] as const,
  search: (userId: string, companyId: string, params: MeetingNoteSearchParams) =>
    [
      ...meetingNoteQueryKeys.searches(userId, companyId),
      {
        q: params.q,
        spaceId: params.spaceId,
        spaceRemoved: params.spaceRemoved,
        from: params.from,
        to: params.to,
      },
    ] as const,
  /** Everything cached for one note (view, transcript, history). */
  noteRoot: (userId: string, companyId: string, noteId: string) =>
    [...meetingNoteQueryKeys.scope(userId, companyId), 'note', noteId] as const,
  /** A note's view (without the transcript text). */
  note: (userId: string, companyId: string, noteId: string) =>
    [...meetingNoteQueryKeys.noteRoot(userId, companyId, noteId), 'detail'] as const,
  /** A note's view with the stored transcript text. */
  noteTranscript: (userId: string, companyId: string, noteId: string) =>
    [...meetingNoteQueryKeys.noteRoot(userId, companyId, noteId), 'transcript'] as const,
  /** A note's version list. */
  versions: (userId: string, companyId: string, noteId: string) =>
    [...meetingNoteQueryKeys.noteRoot(userId, companyId, noteId), 'versions'] as const,
  /** One immutable version. */
  version: (userId: string, companyId: string, noteId: string, versionId: string) =>
    [...meetingNoteQueryKeys.versions(userId, companyId, noteId), versionId] as const,
};

/**
 * The signed-in viewer's application user id and company id; null until both
 * are known. The object keeps its identity while both ids stay the same.
 */
export function useMeetingNotesScope(): MeetingNotesScope | null {
  const { company, currentUserProfile } = useCompany();
  const userId = currentUserProfile?.id;
  const companyId = company?.id;
  return useMemo(() => (userId && companyId ? { userId, companyId } : null), [userId, companyId]);
}

/** A space's notes, newest meeting date first, paged by the route's offset cursor. */
export function useSpaceMeetingNotes(spaceId: string) {
  const scope = useMeetingNotesScope();
  return useInfiniteQuery({
    queryKey: meetingNoteQueryKeys.space(scope?.userId ?? '', scope?.companyId ?? '', spaceId),
    enabled: scope !== null && spaceId.length > 0,
    initialPageParam: 0,
    queryFn: ({ pageParam, signal }) => fetchSpaceMeetingNotes(spaceId, pageParam, signal),
    getNextPageParam: (lastPage) => (lastPage.hasMore ? lastPage.nextCursor ?? undefined : undefined),
    staleTime: 30_000,
    retry: shouldRetryMeetingNotesRequest,
  });
}

/**
 * Company notes for the Meetings page: ranked search when `params.q` is set,
 * otherwise every note within the filters by meeting date. Callers debounce
 * `params.q` (the route allows 120 requests per minute per user) and pass
 * `enabled: false` while the filters are invalid.
 */
export function useMeetingNoteSearch(params: MeetingNoteSearchParams, enabled = true) {
  const scope = useMeetingNotesScope();
  const userId = scope?.userId ?? '';
  const companyId = scope?.companyId ?? '';
  return useInfiniteQuery({
    queryKey: meetingNoteQueryKeys.search(userId, companyId, params),
    enabled: enabled && scope !== null,
    initialPageParam: 0,
    queryFn: ({ pageParam, signal }) => fetchMeetingNoteSearch(params, pageParam, signal),
    getNextPageParam: (lastPage) => (lastPage.hasMore ? lastPage.nextCursor ?? undefined : undefined),
    // While new filters load, keep the previous results of the SAME viewer and
    // company on screen (shown as stale); never another account's results.
    placeholderData: (previous, previousQuery) => {
      const key = previousQuery?.queryKey;
      return key && key[1] === userId && key[2] === companyId && userId !== '' ? previous : undefined;
    },
    staleTime: 30_000,
    retry: shouldRetryMeetingNotesRequest,
  });
}
// src/hooks/queries/useMeetingNote.ts
// One meeting note's reads (Phase 6 FR-005, FR-009): the note view, its stored
// transcript, its version list, and one version. Keys sit under
// meetingNoteQueryKeys.scope(users.id, company.id), so a cached note of one
// account or company is never shown to another and every note mutation's
// scope invalidation refreshes them.
'use client';

import { useQuery } from '@tanstack/react-query';

import { meetingNoteQueryKeys, useMeetingNotesScope } from '@/hooks/queries/useMeetingNotes';
import {
  fetchMeetingNoteDetail,
  fetchMeetingNoteVersion,
  fetchMeetingNoteVersions,
  shouldRetryMeetingNotesRequest,
} from '@/lib/meeting-notes/client-api';

/** The note view; 404 means missing or not visible (another company). */
export function useMeetingNoteDetail(noteId: string, enabled = true) {
  const scope = useMeetingNotesScope();
  return useQuery({
    queryKey: meetingNoteQueryKeys.note(scope?.userId ?? '', scope?.companyId ?? '', noteId),
    enabled: enabled && scope !== null && noteId.length > 0,
    queryFn: ({ signal }) => fetchMeetingNoteDetail(noteId, {}, signal),
    staleTime: 15_000,
    retry: shouldRetryMeetingNotesRequest,
  });
}

/** The stored transcript text (up to 1 MB), loaded only when asked for. */
export function useMeetingNoteTranscript(noteId: string, transcriptId: string | null, enabled: boolean) {
  const scope = useMeetingNotesScope();
  return useQuery({
    queryKey: [...meetingNoteQueryKeys.noteTranscript(scope?.userId ?? '', scope?.companyId ?? '', noteId), 
transcriptId],
    enabled: enabled && scope !== null && noteId.length > 0 && transcriptId !== null,
    queryFn: async ({ signal }) => {
      const note = await fetchMeetingNoteDetail(noteId, { includeTranscript: true }, signal);
      return note.transcript ?? null;
    },
    staleTime: 60_000,
    retry: shouldRetryMeetingNotesRequest,
  });
}

/** The note's versions, newest first, with the note's current revision. */
export function useMeetingNoteVersions(noteId: string, enabled: boolean) {
  const scope = useMeetingNotesScope();
  return useQuery({
    queryKey: meetingNoteQueryKeys.versions(scope?.userId ?? '', scope?.companyId ?? '', noteId),
    enabled: enabled && scope !== null && noteId.length > 0,
    queryFn: ({ signal }) => fetchMeetingNoteVersions(noteId, signal),
    staleTime: 15_000,
    retry: shouldRetryMeetingNotesRequest,
  });
}

/** One immutable version (never changes once written, so it stays cached). */
export function useMeetingNoteVersion(noteId: string, versionId: string | null) {
  const scope = useMeetingNotesScope();
  return useQuery({
    queryKey: meetingNoteQueryKeys.version(scope?.userId ?? '', scope?.companyId ?? '', noteId, versionId ?? ''),
    enabled: scope !== null && noteId.length > 0 && versionId !== null,
    queryFn: ({ signal }) => fetchMeetingNoteVersion(noteId, versionId ?? '', signal),
    staleTime: Infinity,
    retry: shouldRetryMeetingNotesRequest,
  });
}

