content: '', participantIds: [attacker.appUserId] },
          }),
        ],
        ['DELETE note', await callRoute(cookies, deleteNote, { method: 'DELETE', path: 
`/api/meeting-notes/${n}?expectedRevision=${target.revision}`, params: { id: n } })],
