--          MEETING_NOTE_FORBIDDEN; the note's revision must equal
--          p_expected_revision — the draft's source revision — else
--          MEETING_NOTE_STALE_REVISION {current_revision} (covers a
--          transcript replaced or the note edited while the draft was
--          generated, FR-018, AC-030).
--       3. each assignee must be a current member of the note's company
--          (MEETING_NOTE_ITEM_ASSIGNEE_NOT_MEMBER); the snapshot name is
--          taken now.
--       4. accepted items are appended in the given order (created_at =
--          clock_timestamp() per row so the list keeps that order), creator
--          = caller (id + name snapshot), revision 1, not completed. The
--          capacity trigger (100 per note, under the note lock already held)
--          raises MEETING_NOTE_ITEM_LIMIT_REACHED and the whole Apply rolls
--          back. Existing items are never read for update, modified, or
--          removed (completion included).
--       5. summary := p_summary and generated_by := 'ai' when p_summary is
--          not NULL (a NULL summary keeps the current summary and generator:
--          an items-only Apply never erases a summary); revision + 1,
--          edited_by := caller; one immutable version of the new state
--          (private.meeting_note_insert_version).
--     Duplicates (FR-018/FR-019): suggestions matching an existing item
--     arrive unchecked in the UI; an item the user explicitly accepts anyway
--     is appended (the user's decision) and its index is reported in
--     `duplicate_indexes` (0-based positions in p_items whose normalized
--     description equals an existing item's, read under the note lock).
--     Returns {note_id, revision, version_id, item_ids[], duplicate_indexes[]}.
--
-- Error tokens (message = token; SQLSTATE; DETAIL JSON where listed):
--   22023 MEETING_NOTE_REVISION_REQUIRED
--   22023 MEETING_NOTE_SUMMARY_INVALID
--   22023 MEETING_NOTE_AI_APPLY_ITEMS_INVALID
--   22023 MEETING_NOTE_AI_APPLY_EMPTY
--   22023 MEETING_NOTE_ITEM_DESCRIPTION_INVALID
--   22023 MEETING_NOTE_ITEM_ASSIGNEE_NOT_MEMBER
--   22023 MEETING_NOTE_ITEM_LIMIT_REACHED {"limit": 100}
--   P0002 MEETING_NOTE_NOT_FOUND (missing, other company, caller removed)
--   42501 MEETING_NOTE_FORBIDDEN
--   P0001 MEETING_NOTE_STALE_REVISION {"current_revision": n}
--
-- Rollback (order: FIRST roll the application back to a build without the
-- Apply route, THEN run this SQL). No data is lost: applied summaries, items,
-- and versions stay.
--   begin;
--   drop function if exists public.apply_meeting_note_ai_draft(uuid, bigint, text, jsonb);
--   drop function if exists private.meeting_note_ai_normalize_description(text);
--   commit;

create or replace function private.meeting_note_ai_normalize_description(p_description text)
returns text
language sql
stable
security definer
set search_path = ''
as $$
  select pg_catalog.lower(
           extensions.unaccent(
             'extensions.unaccent'::regdictionary,
             pg_catalog.regexp_replace(pg_catalog.btrim(p_description, E' \t\r\n'), '\s+', ' ', 'g')
           )
         );
$$;

alter function private.meeting_note_ai_normalize_description(text) owner to postgres;
revoke all on function private.meeting_note_ai_normalize_description(text) from public, anon, authenticated, 
service_role;

create or replace function public.apply_meeting_note_ai_draft(
  p_note_id uuid,
  p_expected_revision bigint,
  p_summary text,
  p_items jsonb
)
returns jsonb
language plpgsql
volatile
security definer
set search_path = ''
as $$
declare
  v_lock record;
  v_items jsonb := '[]'::jsonb;
  v_element jsonb;
  v_description text;
  v_assignee_id uuid;
  v_due_date date;
  v_assignee_name text;
  v_existing text[];
  v_item_ids uuid[] := '{}';
  v_duplicates integer[] := '{}';
  v_item_id uuid;
  v_index integer := 0;
  v_revision bigint;
  v_version_id uuid;
begin
  -- 0. Arguments (no lock is taken before they are valid).
  if p_expected_revision is null then
    raise exception 'MEETING_NOTE_REVISION_REQUIRED' using errcode = '22023';
  end if;
  if p_summary is not null
     and (pg_catalog.btrim(p_summary, E' \t\r\n') = ''
          or pg_catalog.char_length(p_summary) > 100000) then
    raise exception 'MEETING_NOTE_SUMMARY_INVALID' using errcode = '22023';
  end if;
  if p_items is null
     or pg_catalog.jsonb_typeof(p_items) <> 'array'
     or pg_catalog.jsonb_array_length(p_items) > 100 then
    raise exception 'MEETING_NOTE_AI_APPLY_ITEMS_INVALID' using errcode = '22023';
  end if;

  for v_element in select e.value from pg_catalog.jsonb_array_elements(p_items) as e(value)
  loop
    if pg_catalog.jsonb_typeof(v_element) <> 'object'
       or pg_catalog.jsonb_typeof(v_element -> 'description') is distinct from 'string'
       or coalesce(pg_catalog.jsonb_typeof(v_element -> 'assignee_id'), 'null') not in ('null', 'string')
       or coalesce(pg_catalog.jsonb_typeof(v_element -> 'due_date'), 'null') not in ('null', 'string')
       or exists (
         select 1
         from pg_catalog.jsonb_object_keys(v_element) as k(key)
         where k.key not in ('description', 'assignee_id', 'due_date')
       ) then
      raise exception 'MEETING_NOTE_AI_APPLY_ITEMS_INVALID' using errcode = '22023';
    end if;

    v_description := v_element ->> 'description';
    perform private.meeting_note_item_validate_description(v_description);

    begin
      v_assignee_id := (v_element ->> 'assignee_id')::uuid;
      v_due_date := null;
      if v_element ->> 'due_date' is not null then
        if (v_element ->> 'due_date') !~ '^\d{4}-\d{2}-\d{2}$' then
          raise exception 'MEETING_NOTE_AI_APPLY_ITEMS_INVALID' using errcode = '22023';
        end if;
        v_due_date := (v_element ->> 'due_date')::date;
      end if;
    exception
      when invalid_text_representation or datetime_field_overflow or invalid_datetime_format then
        raise exception 'MEETING_NOTE_AI_APPLY_ITEMS_INVALID' using errcode = '22023';
    end;

    v_items := v_items || pg_catalog.jsonb_build_array(
      pg_catalog.jsonb_build_object('description', v_description, 'assignee_id', v_assignee_id, 'due_date', v_due_date)
    );
  end loop;

  if p_summary is null and pg_catalog.jsonb_array_length(v_items) = 0 then
    raise exception 'MEETING_NOTE_AI_APPLY_EMPTY' using errcode = '22023';
  end if;

  -- 1–2. Caller (KEY SHARE) → note (FOR UPDATE); rights and source revision
  -- on the locked pre-change state.
  select * into v_lock from private.meeting_note_lock_for_change(p_note_id, 'MEETING_NOTE_NOT_FOUND');
  if v_lock.can_edit is not true then
    raise exception 'MEETING_NOTE_FORBIDDEN' using errcode = '42501';
  end if;
  if v_lock.note_revision <> p_expected_revision then
    raise exception 'MEETING_NOTE_STALE_REVISION'
      using errcode = 'P0001',
            detail = pg_catalog.format('{"current_revision": %s}', v_lock.note_revision);
  end if;

  -- Existing descriptions, read under the note lock (no item insert can
  -- interleave: every insertion path takes the same note lock).
  select coalesce(pg_catalog.array_agg(private.meeting_note_ai_normalize_description(i.description)), '{}')
  into v_existing
  from public.meeting_note_action_items as i
  where i.note_id = p_note_id;

  -- 3–4. Append the accepted items in order.
  for v_element in select e.value from pg_catalog.jsonb_array_elements(v_items) as e(value)
  loop
    v_assignee_id := (v_element ->> 'assignee_id')::uuid;
    v_assignee_name := private.meeting_note_item_resolve_assignee(v_lock.note_company_id, v_assignee_id);
    v_description := v_element ->> 'description';

    if private.meeting_note_ai_normalize_description(v_description) = any (v_existing) then
      v_duplicates := v_duplicates || v_index;
    end if;

    insert into public.meeting_note_action_items
      (note_id, description, assignee_id, assignee_name, due_date, completed,
       creator_user_id, creator_name, revision, created_at, updated_at)
    values
      (p_note_id, v_description, v_assignee_id, v_assignee_name, (v_element ->> 'due_date')::date, false,
       v_lock.caller_id, v_lock.caller_name, 1, pg_catalog.clock_timestamp(), pg_catalog.clock_timestamp())
    returning id into v_item_id;

    v_item_ids := v_item_ids || v_item_id;
    v_index := v_index + 1;
  end loop;

  -- 5. Summary, revision, one version.
  -- A NULL summary (all sections left empty) keeps the current summary and
  -- its generator: an items-only Apply never erases a summary.
  update public.meeting_notes as n
  set summary = coalesce(p_summary, n.summary),
      generated_by = case when p_summary is null then n.generated_by else 'ai'::public.note_generator end,
      revision = n.revision + 1,
      edited_by = v_lock.caller_id,
      updated_at = pg_catalog.now()
  where n.id = p_note_id
  returning n.revision into v_revision;

  v_version_id := private.meeting_note_insert_version(p_note_id, v_lock.caller_id, v_lock.caller_name);

  return pg_catalog.jsonb_build_object(
    'note_id', p_note_id,
    'revision', v_revision,
    'version_id', v_version_id,
    'item_ids', pg_catalog.to_jsonb(v_item_ids),
    'duplicate_indexes', pg_catalog.to_jsonb(v_duplicates)
  );
end;
$$;

alter function public.apply_meeting_note_ai_draft(uuid, bigint, text, jsonb) owner to postgres;
revoke all on function public.apply_meeting_note_ai_draft(uuid, bigint, text, jsonb) from public, anon, authenticated, 
service_role;
grant execute on function public.apply_meeting_note_ai_draft(uuid, bigint, text, jsonb) to authenticated;

comment on function public.apply_meeting_note_ai_draft(uuid, bigint, text, jsonb) is
  'Phase 6 T12: an editor applies an AI draft at its source revision — summary, appended accepted items (capacity 
100), one version — in one transaction under the caller → note lock order; all or nothing.';
// src/app/api/meeting-notes/[id]/ai/apply/route.ts
// Apply of a reviewed AI draft (Phase 6 T12; SPEC FR-007, FR-008, FR-011,
// FR-018, FR-019, BR-006).
//
// POST, body { expectedRevision, summary: {keyPoints[], decisions[],
// nextSteps[]}, items: [{description, assigneeId?, dueDate?}] }:
// expectedRevision is the draft's SOURCE revision (the start response's
// sourceRevision). The edited summary is stored as plain text
// (formatMeetingNoteAiSummary; all sections empty keeps the current
// summary); accepted items are appended. The write is one
// call to public.apply_meeting_note_ai_draft with the USER's session: the
// database resolves the caller from auth.uid(), re-checks editor rights on
// the locked note, requires the source revision, enforces the 100-item
// capacity, and creates one version — all or nothing. Nothing provider-side
// is involved; Apply works on what the user submitted.
import { NextRequest, NextResponse } from 'next/server';

import { formatMeetingNoteAiSummary } from '@/lib/meeting-notes/ai/draft-review';
import { loadMeetingNoteDetail } from '@/lib/meeting-notes/note-detail';
import {
  beginMeetingNoteMutation,
  internalError,
  meetingNoteError,
  notFound,
  noteMutationErrorResponse,
  ok,
  parsePathId,
  parseWith,
  readJsonObject,
} from '@/lib/meeting-notes/route-support';
import { applyMeetingNoteAiDraftBodySchema, codePointLength, MEETING_NOTE_LIMITS } from 
'@/lib/meeting-notes/validation';
import type { MeetingNoteAiApplyResult } from '@/types/meeting-notes';

export const dynamic = 'force-dynamic';

interface RouteParams {
  params: Promise<{ id: string }>;
}

/**
 * POST /api/meeting-notes/[id]/ai/apply → 200 { note, applied: {revision, versionId, itemIds, duplicateIndexes} }.
 * 409 MEETING_NOTE_STALE_REVISION with the current note (the note or its transcript changed since the draft's source);
 * 403 MEETING_NOTE_FORBIDDEN; 404 MEETING_NOTE_NOT_FOUND; 400 MEETING_NOTE_SUMMARY_INVALID /
 * MEETING_NOTE_AI_APPLY_ITEMS_INVALID / MEETING_NOTE_AI_APPLY_EMPTY / MEETING_NOTE_ITEM_DESCRIPTION_INVALID /
 * MEETING_NOTE_ITEM_ASSIGNEE_NOT_MEMBER / MEETING_NOTE_ITEM_LIMIT_REACHED (nothing changed).
 */
export async function POST(request: NextRequest, { params }: RouteParams): Promise<NextResponse> {
  const begun = await beginMeetingNoteMutation(request, '/api/meeting-notes/[id]/ai/apply', 'meeting-note:write');
  if (!begun.ok) {
    await request.body?.cancel().catch(() => undefined);
    return begun.response;
  }
  const ctx = begun.value;

  const id = parsePathId((await params).id, 'MEETING_NOTE_NOT_FOUND', ctx);
  if (!id.ok) {
    await request.body?.cancel().catch(() => undefined);
    return id.response;
  }

  const raw = await readJsonObject(request, ctx);
  if (!raw.ok) return raw.response;
  const body = parseWith(applyMeetingNoteAiDraftBodySchema, raw.value, ctx);
  if (!body.ok) return body.response;

  const summary = formatMeetingNoteAiSummary(body.value.summary);
  if (summary !== null && codePointLength(summary) > MEETING_NOTE_LIMITS.contentMaxChars) {
    return meetingNoteError(400, 'MEETING_NOTE_SUMMARY_INVALID', ctx);
  }

  let applied: MeetingNoteAiApplyResult;
  try {
    applied = await ctx.repository.applyAiDraft({
      noteId: id.value,
      expectedRevision: body.value.expectedRevision,
      summary,
      items: body.value.items,
    });
  } catch (error) {
    return noteMutationErrorResponse(error, ctx, id.value, 'meetingNotes.aiApply');
  }

  try {
    const note = await loadMeetingNoteDetail(ctx.repository, ctx.dbUser, id.value);
    // Deleted by another request right after this change committed.
    if (!note) return notFound('MEETING_NOTE_NOT_FOUND', ctx);
    return ok(
      {
        note,
        applied: {
          revision: applied.revision,
          versionId: applied.versionId,
          itemIds: applied.itemIds,
          duplicateIndexes: applied.duplicateIndexes,
        },
      },
      ctx
    );
  } catch (error) {
    return internalError(error, ctx, 'meetingNotes.aiApply.load');
  }
}
// src/lib/meeting-notes/ai/draft-review.ts
// Turns a provider draft into the reviewable draft of the start route and an
// edited summary into the stored text of Apply (Phase 6 T12; SPEC FR-016,
// FR-017, FR-018, BR-006). Pure functions: no I/O, nothing logged.
//
// Name resolution (FR-017) is LOCAL: the provider never receives the member
// roster (FR-016); it returns names as written in the transcript, and they are
// matched here against the company's CURRENT members only:
//   1. exact full display name (case- and accent-insensitive, trimmed, inner
//      whitespace collapsed) — exactly one member → that member; two or more
//      members with that same name → unassigned;
//   2. otherwise the whole suggested name equal to the FIRST name (first
//      token of the display name) of exactly one current member → that member;
//   3. otherwise (several first-name matches, none, a former member) →
//      unassigned.
// "Already exists" (FR-018): a suggestion whose normalized description equals
// an existing item's is marked with that item's id (the UI shows it
// unchecked). Same key as SQL private.meeting_note_ai_normalize_description
// (trim, collapse whitespace, strip accents, lower case); characters that
// unaccent and Unicode decomposition treat differently (e.g. ß, æ) can differ
// between the two, which only affects the informational mark.
import 'server-only';

import type {
  MeetingNoteAiDraft,
  MeetingNoteAiDraftSummary,
  MeetingNoteAiReviewDraft,
} from '@/types/meeting-notes';

export interface MeetingNoteAiMember {
  userId: string;
  displayName: string;
}

/** Comparison key: NFD, combining marks removed, lower case, trimmed, single spaces. */
export function meetingNoteAiComparisonKey(value: string): string {
  return value
    .normalize('NFD')
    .replace(/\p{M}+/gu, '')
    .toLowerCase()
    .trim()
    .replace(/\s+/gu, ' ');
}

function firstName(key: string): string {
  const space = key.indexOf(' ');
  return space === -1 ? key : key.slice(0, space);
}

/** The single current member a suggested name designates, else null (FR-017). */
export function resolveMeetingNoteAiAssignee(
  suggestedName: string | null,
  members: readonly MeetingNoteAiMember[]
): MeetingNoteAiMember | null {
  if (suggestedName === null) return null;
  const wanted = meetingNoteAiComparisonKey(suggestedName);
  if (wanted === '') return null;

  const keyed = members
    .map((member) => ({ member, key: meetingNoteAiComparisonKey(member.displayName) }))
    .filter((entry) => entry.key !== '');

  const exact = keyed.filter((entry) => entry.key === wanted);
  if (exact.length === 1) return exact[0].member;
  if (exact.length > 1) return null;

  const byFirstName = keyed.filter((entry) => firstName(entry.key) === wanted);
  return byFirstName.length === 1 ? byFirstName[0].member : null;
}

/** The reviewable draft: assignees resolved locally, duplicates of existing items marked. */
export function buildMeetingNoteAiReviewDraft(
  draft: MeetingNoteAiDraft,
  members: readonly MeetingNoteAiMember[],
  existingItems: ReadonlyArray<{ id: string; description: string }>
): MeetingNoteAiReviewDraft {
  const existing = new Map<string, string>();
  for (const item of existingItems) {
    const key = meetingNoteAiComparisonKey(item.description);
    if (!existing.has(key)) existing.set(key, item.id);
  }
  return {
    summary: {
      keyPoints: [...draft.summary.keyPoints],
      decisions: [...draft.summary.decisions],
      nextSteps: [...draft.summary.nextSteps],
    },
    items: draft.actionItems.map((item) => {
      const resolved = resolveMeetingNoteAiAssignee(item.assigneeName, members);
      return {
        description: item.description,
        suggestedAssigneeName: item.assigneeName,
        resolvedAssignee: resolved ? { userId: resolved.userId, displayName: resolved.displayName } : null,
        duplicateOfItemId: existing.get(meetingNoteAiComparisonKey(item.description)) ?? null,
      };
    }),
  };
}

const SECTION_TITLES: ReadonlyArray<[keyof MeetingNoteAiDraftSummary, string]> = [
  ['keyPoints', 'Key points'],
  ['decisions', 'Decisions'],
  ['nextSteps', 'Next steps'],
];

/**
 * Stored summary format (plain text; the note view renders it as text with
 * pre-wrapped lines, the export escapes it). Each non-empty section is a
 * heading line followed by one "- " line per entry; sections are separated by
 * a blank line; line breaks inside an entry become spaces. All sections empty
 * → null (Apply then keeps the note's current summary). Example:
 *   Key points
 *   - Launch stays on Friday.
 *
 *   Next steps
 *   - Bruno updates the changelog.
 */
export function formatMeetingNoteAiSummary(summary: MeetingNoteAiDraftSummary): string | null {
  const blocks: string[] = [];
  for (const [key, title] of SECTION_TITLES) {
    const entries = summary[key].map((entry) => entry.replace(/\s+/gu, ' ').trim()).filter((entry) => entry !== '');
    if (entries.length > 0) blocks.push([title, ...entries.map((entry) => `- ${entry}`)].join('\n'));
  }
  return blocks.length > 0 ? blocks.join('\n\n') : null;
}
// src/lib/meeting-notes/ai/adapters/index.ts
// Server-only entry point of the meeting-note AI adapters (Phase 6 T11;
// SPEC FR-016, FR-020, FR-021, FR-022, AC-026, AC-029). T12 calls
// generateMeetingNoteDraft with the snapshot taken at admission and the
// transcript ALREADY normalized (normalizeTranscriptForProvider).
//
// Per call, in order: matrix check of provider/model/reasoning level and key
// presence → FR-020 size preflight → base URL (server env override, refused in
// production) → caller-abort check → exactly ONE outbound streaming request
// (SDK retries off, a second request refused and redirects never followed by
// the transport guard, which also sends only allowlisted headers plus the
// admitted key) → deadline/abort check → stop reason check → JSON parse +
// shared draft-schema validation.
// Nothing here logs the key, the transcript, or provider text.
//
// Timeout: 180 s by default (SM-1 expects ≤60 s for a one-hour transcript;
// T9's stale job fails dispatched operations after 10 minutes, so the
// deadline must stay well below that). The deadline covers the whole streamed
// response, not only the headers.
import 'server-only';

import type { MeetingNoteAiProvider } from '@/types/meeting-notes';

import { findMeetingNoteAiModel, MEETING_NOTE_AI_CAPABILITIES } from '../capabilities';
import { resolveMeetingNoteAiBaseUrl } from '../base-url';
import { parseMeetingNoteAiDraft } from '../draft-schema';
import { preflightMeetingNoteAiTranscript } from '../preflight';
import {
  meetingNoteAiFailure,
  meetingNoteAiTooLongFailure,
  type MeetingNoteAiDraftResult,
} from '../provider-errors';
import { runAnthropicDraftRequest } from './anthropic';
import { runOpenAiCompatibleDraftRequest } from './openai-compatible';
import {
  createDispatchFetch,
  createDispatchState,
  createRequestControl,
  mapMeetingNoteAiTransportError,
  type MeetingNoteAiStreamOutcome,
} from './transport';

export const MEETING_NOTE_AI_DEFAULT_TIMEOUT_MS = 180_000;
/** Upper bound for a caller-supplied timeout (stale-operation job: 10 min). */
export const MEETING_NOTE_AI_MAX_TIMEOUT_MS = 300_000;
const SDK_TIMEOUT_MARGIN_MS = 5_000;

export interface GenerateMeetingNoteDraftInput {
  provider: MeetingNoteAiProvider;
  model: string;
  reasoningLevel: string;
  /** The company's provider key (from the admission snapshot). Never logged or returned. */
  apiKey: string;
  /** Normalized transcript; the ONLY content sent to the provider. */
  transcript: string;
  /** Aborts the outbound request (client left the page). */
  signal?: AbortSignal;
  /** Deadline for the whole request, 1 ms – 300 s; default 180 s. */
  timeoutMs?: number;
}

function outcomeFailure(provider: MeetingNoteAiProvider, outcome: MeetingNoteAiStreamOutcome) {
  switch (outcome.finish) {
    case 'refusal':
      return meetingNoteAiFailure(provider, 'MEETING_NOTE_AI_REFUSED', true);
    case 'length':
      return meetingNoteAiFailure(provider, 'MEETING_NOTE_AI_OUTPUT_TRUNCATED', true);
    case 'incomplete':
      return meetingNoteAiFailure(provider, 'MEETING_NOTE_AI_STREAM_INTERRUPTED', true);
    case 'other':
      return meetingNoteAiFailure(provider, 'MEETING_NOTE_AI_OUTPUT_INVALID', true);
    case 'end':
      return null;
  }
}

export async function generateMeetingNoteDraft(input: GenerateMeetingNoteDraftInput): 
Promise<MeetingNoteAiDraftResult> {
  const { provider } = input;
  if (!Object.hasOwn(MEETING_NOTE_AI_CAPABILITIES, provider)) {
    // Unknown provider: no label to name; fall back to a neutral one.
    return meetingNoteAiFailure('openai', 'MEETING_NOTE_AI_CONFIGURATION_INVALID', false);
  }
  const model = findMeetingNoteAiModel(provider, input.model);
  const level = model?.reasoningLevels.find((entry) => entry.id === input.reasoningLevel);
  if (!model || !level || typeof input.apiKey !== 'string' || input.apiKey.trim() === '') {
    return meetingNoteAiFailure(provider, 'MEETING_NOTE_AI_CONFIGURATION_INVALID', false);
  }

  const preflight = preflightMeetingNoteAiTranscript({ provider, model: model.id, transcript: input.transcript });
  if (!preflight.ok) {
    return preflight.code === 'MEETING_NOTE_AI_TRANSCRIPT_TOO_LONG_FOR_MODEL'
      ? meetingNoteAiTooLongFailure(provider, preflight)
      : meetingNoteAiFailure(provider, preflight.code, false);
  }

  const baseUrl = resolveMeetingNoteAiBaseUrl(provider);
  if (!baseUrl.ok) return meetingNoteAiFailure(provider, baseUrl.code, false);

  if (input.signal?.aborted) return meetingNoteAiFailure(provider, 'MEETING_NOTE_AI_CANCELLED_BEFORE_SEND', false);

  const timeoutMs = Math.min(
    Math.max(1, Math.floor(input.timeoutMs ?? MEETING_NOTE_AI_DEFAULT_TIMEOUT_MS)),
    MEETING_NOTE_AI_MAX_TIMEOUT_MS
  );
  const state = createDispatchState();
  const control = createRequestControl(input.signal, timeoutMs);
  const protocol = MEETING_NOTE_AI_CAPABILITIES[provider].protocol;
  const request = {
    provider,
    apiKey: input.apiKey,
    baseUrl: baseUrl.baseUrl,
    model,
    level,
    transcript: input.transcript,
    fetch: createDispatchFetch(state, {
      scheme: protocol === 'anthropic-messages' ? 'x-api-key' : 'bearer',
      apiKey: input.apiKey,
    }),
    signal: control.signal,
    sdkTimeoutMs: timeoutMs + SDK_TIMEOUT_MARGIN_MS,
  };

  try {
    const outcome =
      protocol === 'anthropic-messages' ? await runAnthropicDraftRequest(request) : await 
runOpenAiCompatibleDraftRequest(request);

    // The SDKs end an aborted stream silently. Whatever was read before the
    // deadline or the caller's abort — even a complete draft and a stop
    // signal followed by a stalled connection — the call did not finish in
    // time: a counted timeout/cancellation, and the draft is discarded.
    if (control.reason) {
      return mapMeetingNoteAiTransportError(provider, state, control);
    }
    const stopFailure = outcomeFailure(provider, outcome);
    if (stopFailure) return stopFailure;

    const parsed = parseMeetingNoteAiDraft(outcome.text);
    if (!parsed.ok) {
      const code =
        parsed.reason === 'empty'
          ? 'MEETING_NOTE_AI_OUTPUT_EMPTY'
          : parsed.reason === 'malformed'
            ? 'MEETING_NOTE_AI_OUTPUT_MALFORMED'
            : 'MEETING_NOTE_AI_OUTPUT_INVALID';
      return meetingNoteAiFailure(provider, code, true);
    }
    const hasUsage = outcome.usage.inputTokens !== undefined || outcome.usage.outputTokens !== undefined;
    return { ok: true, draft: parsed.draft, dispatched: true, ...(hasUsage ? { usage: outcome.usage } : {}) };
  } catch {
    // The thrown error is not inspected or logged: SDK errors can carry
    // provider text. The dispatch state decides.
    return mapMeetingNoteAiTransportError(provider, state, control);
  } finally {
    control.dispose();
  }
}

