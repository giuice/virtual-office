 187 /**
 188  * FR-021 preliminary check: the caller must still be a member of the note's
 189  * company with editor rights, and the note must still exist. Read with the
 190  * caller's session (RLS hides the note from a removed member); also loads
 191  * what the review draft needs (current members, existing items). Access can
 192  * still be lost after this read, so success is recorded only by the atomic
 193  * finalization, which repeats the check on locked rows.
 194  */
 195 async function recheckAccess(
 196   ctx: MeetingNoteAiProcessingContext,
 197   noteId: string
 198 ): Promise<AccessCheck | { ok: false; reason: 'not_found' | 'forbidden' }> {
 199   const { data: fresh, error } = await ctx.supabase
 200     .from('users')
 201     .select('id, company_id, role')
 202     .eq('id', ctx.dbUser.id)
 203     .maybeSingle<{ id: string; company_id: string | null; role: User['role'] }>();
 204   if (error) throw new MeetingNoteDbError(error.code, error.message, error.details);
 205   if (!fresh || !fresh.company_id) return { ok: false, reason: 'not_found' };
 206 
 207   const note = await ctx.repository.findById(noteId);
 208   if (!note || note.companyId !== fresh.company_id) return { ok: false, reason: 'not_found' };
 209 
 210   const participants = await ctx.repository.findParticipants(noteId);
 211   const rights = computeMeetingNoteRights(
 212     { id: fresh.id, companyId: fresh.company_id, role: fresh.role },
 213     note,
 214     participants.map((participant) => participant.userId)
 215   );
 216   if (!rights.canEdit) return { ok: false, reason: 'forbidden' };
 217 
 218   const [members, items] = await Promise.all([
 219     ctx.repository.listCurrentMembers(fresh.company_id),
 220     ctx.repository.findActionItems(noteId),
 221   ]);
 222   return { ok: true, members, items: items.map((item) => ({ id: item.id, description: item.description })) };
 223 }
