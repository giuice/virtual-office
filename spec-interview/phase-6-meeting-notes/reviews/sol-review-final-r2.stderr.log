 138 async function ownUsage(ctx: MeetingNoteAiProcessingContext): Promise<MeetingNoteAiUsage | null> {
 139   try {
 140     const usage = await new SupabaseMeetingNoteAiOperationRepository(ctx.supabase).getOwnCompanyUsage();
 141     return { limit: usage.limit, used: usage.used, usageDay: usage.usageDay, resetAt: usage.resetAt };
 142   } catch {
 143     // A removed member has no company usage to read; the response carries none.
 144     return null;
 145   }
 146 }
 147 
 148 /**
 149  * Settles the operation; returns the resulting status and whether this call
 150  * recorded `outcome`. A failing settlement is logged (ids only) and reported
 151  * as not recorded: the stale job then fails the operation (counted).
 152  */
 153 async function settle(
 154   ctx: MeetingNoteAiProcessingContext,
 155   operations: SupabaseMeetingNoteAiOperationRepository,
 156   operationId: string,
 157   outcome: MeetingNoteAiSettlementOutcome
 158 ): Promise<{ status: MeetingNoteAiOperationStatus | null; recorded: boolean }> {
 159   try {
 160     const result = await operations.settle(operationId, outcome);
 161     return { status: result.status, recorded: result.changed && result.status === outcome };
 162   } catch (error) {
 163     // A refused transition still reports the operation's current status
 164     // (e.g. `released` refused because the dispatch mark committed).
 165     if (error instanceof MeetingNoteDbError && error.token === 'MEETING_NOTE_AI_OPERATION_INVALID_TRANSITION') {
 166       const status = error.detail?.status;
 167       if (typeof status === 'string') {
 168         return { status: status as MeetingNoteAiOperationStatus, recorded: false };
 169       }
 170     }
 171     logEvent('meeting_notes_ai_settle_failed', {
 172       correlationId: ctx.correlationId,
 173       operationId,
 174       outcome,
 175       sqlstate: error instanceof MeetingNoteDbError ? error.sqlstate : undefined,
 176     });
 177     return { status: null, recorded: false };
 178   }
 179 }
 180 
 181 interface AccessCheck {
 182   ok: true;
 183   members: Array<{ userId: string; displayName: string }>;
 184   items: Array<{ id: string; description: string }>;
 185 }
 186 
 187 /**
 188  * FR-021 preliminary check: the caller must still be a member of the note's
 189  * company with editor rights, and the note must still exist. Read with the
 190  * caller's session (RLS hides the note from a removed member); also loads
 191  * what the review draft needs (current members, existing items). Access can
 192  * still be lost after this read, so success is recorded only by the atomic
 193  * finalization, which repeats the check on locked rows.
 194  */
 195 async function recheckAccess(
 196   ctx: MeetingNoteAiProcessingContext,
 197   noteId: string
 198 ): Promise<AccessCheck | { ok: false; reason: 'not_found' | 'forbidden' }> {
 199   const { data: fresh, error } = await ctx.supabase
 200     .from('users')
 201     .select('id, company_id, role')
 202     .eq('id', ctx.dbUser.id)
 203     .maybeSingle<{ id: string; company_id: string | null; role: User['role'] }>();
 204   if (error) throw new MeetingNoteDbError(error.code, error.message, error.details);
 205   if (!fresh || !fresh.company_id) return { ok: false, reason: 'not_found' };
 206 
 207   const note = await ctx.repository.findById(noteId);
 208   if (!note || note.companyId !== fresh.company_id) return { ok: false, reason: 'not_found' };
 209 
 210   const participants = await ctx.repository.findParticipants(noteId);
 211   const rights = computeMeetingNoteRights(
 212     { id: fresh.id, companyId: fresh.company_id, role: fresh.role },
 213     note,
 214     participants.map((participant) => participant.userId)
 215   );
 216   if (!rights.canEdit) return { ok: false, reason: 'forbidden' };
 217 
 218   const [members, items] = await Promise.all([
 219     ctx.repository.listCurrentMembers(fresh.company_id),
 220     ctx.repository.findActionItems(noteId),
 221   ]);
 222   return { ok: true, members, items: items.map((item) => ({ id: item.id, description: item.description })) };
 223 }
 224 
 225 /**
 226  * Runs admission → preflight → one dispatch → settlement for a VERIFIED
 227  * ticket whose user/company/note already equal the authenticated caller's.
 228  */
 229 export async function runMeetingNoteAiProcessing(
 230   ctx: MeetingNoteAiProcessingContext,
 231   ticket: MeetingNoteAiTicketPayload,
 232   signal: AbortSignal
 233 ): Promise<MeetingNoteAiProcessingOutcome> {
 234   const operations = new SupabaseMeetingNoteAiOperationRepository(ctx.service);
 235 
 236   let admitted: MeetingNoteAiAdmission | MeetingNoteAiReplay;
 237   try {
 238     admitted = await operations.admit({
 239       actorUserId: ctx.dbUser.id,
 240       companyId: ticket.companyId,
 241       noteId: ticket.noteId,
 242       idempotencyKey: ticket.idempotencyKey,
 243       ticketIssuedAt: meetingNoteAiTicketIssuedAt(ticket),
 244       sourceRevision: ticket.sourceRevision,
 245       transcriptId: ticket.transcriptId,
 246       settingsRevision: ticket.settingsRevision,
 247     });
 248   } catch (error) {
 249     if (error instanceof MeetingNoteDbError && error.token !== null) return { kind: 'refused', error };
 250     throw error;
 251   }
 252 
 253   if (admitted.replay) {
 254     return { kind: 'replay', replay: admitted, usage: await ownUsage(ctx) };
 255   }
 256 
 257   const admission = admitted;
 258   const operationId = admission.operationId;
 259   let marked = false;
 260   let settled = false;
 261   try {
 262     const transcript = normalizeTranscriptForProvider(admission.transcript);
 263 
 264     const preflight = preflightMeetingNoteAiTranscript({
 265       provider: admission.provider,
 266       model: admission.model,
 267       transcript,
 268     });
 269     if (!preflight.ok) {
 270       const result = await settle(ctx, operations, operationId, 'released');
 271       settled = true;
 272       // A snapshot outside the matrix (settings saved under an older matrix)
 273       // is a never-sent configuration error; nothing is sent either way.
 274       const failure =
 275         preflight.code === 'MEETING_NOTE_AI_TRANSCRIPT_TOO_LONG_FOR_MODEL'
 276           ? meetingNoteAiTooLongFailure(admission.provider, preflight)
 277           : meetingNoteAiFailure(admission.provider, 'MEETING_NOTE_AI_CONFIGURATION_INVALID', false);
 278       return { kind: 'preflight_refused', operationId, status: result.status, failure, usage: await ownUsage(ctx) 
};
 279     }
 280 
 281     if (signal.aborted) {
 282       const result = await settle(ctx, operations, operationId, 'released');
 283       settled = true;
 284       return { kind: 'cancelled_before_send', operationId, status: result.status };
 285     }
 286 
 287     try {
 288       await operations.markDispatched(operationId);
 289       marked = true;
 290     } catch (error) {
 291       if (error instanceof MeetingNoteDbError && error.token === 'MEETING_NOTE_AI_OPERATION_INVALID_TRANSITION') {
 292         settled = true;
 293         const status = error.detail?.status;
 294         return {
 295           kind: 'not_dispatchable',
 296           operationId,
 297           status: typeof status === 'string' ? (status as MeetingNoteAiOperationStatus) : null,
 298         };
 299       }
 300       throw error;
 301     }
 302 
 303     const result = await generateMeetingNoteDraft({
 304       provider: admission.provider,
 305       model: admission.model,
 306       reasoningLevel: admission.reasoningLevel,
 307       apiKey: admission.apiKey,
 308       transcript,
 309       signal,
 310       timeoutMs: configuredTimeoutMs(),
 311     });
 312 
 313     if (!result.ok) {
 314       const clientLeft = signal.aborted && result.kind === 'processed_failure';
 315       const outcome: MeetingNoteAiSettlementOutcome =
 316         result.kind === 'processed_failure' ? (clientLeft ? 'discarded' : 'failed') : 'refunded';
 317       const settlement = await settle(ctx, operations, operationId, outcome);
 318       settled = true;
 319       logEvent('meeting_notes_ai_processing_failed', {
 320         correlationId: ctx.correlationId,
 321         operationId,
 322         kind: result.kind,
 323         code: result.code,
 324         status: settlement.status,
 325       });
 326       if (clientLeft) return { kind: 'client_gone', operationId, status: settlement.status };
 327       return { kind: 'provider_failure', operationId, status: settlement.status, failure: result, usage: await 
ownUsage(ctx) };
 328     }
 329 
 330     if (signal.aborted) {
 331       const settlement = await settle(ctx, operations, operationId, 'discarded');
 332       settled = true;
 333       return { kind: 'client_gone', operationId, status: settlement.status };
 334     }
 335 
 336     // Preliminary read with the caller's session: an early exit when access
 337     // is already gone, and the roster/items the review draft needs. It is NOT
 338     // the authorization of the result — the finalization below is.
 339     let access: Awaited<ReturnType<typeof recheckAccess>>;
 340     try {
 341       access = await recheckAccess(ctx, ticket.noteId);
 342     } catch (error) {
 343       await settle(ctx, operations, operationId, 'discarded');
 344       settled = true;
 345       throw error;
 346     }
 347     if (signal.aborted) {
 348       // Left while access was being read: nothing has been finalized yet.
 349       const settlement = await settle(ctx, operations, operationId, 'discarded');
 350       settled = true;
 351       return { kind: 'client_gone', operationId, status: settlement.status };
 352     }
 353     if (!access.ok) {
 354       const settlement = await settle(ctx, operations, operationId, 'discarded');
 355       settled = true;
 356       return { kind: 'access_lost', operationId, status: settlement.status, reason: access.reason };
 357     }
 358 
 359     const draft = buildMeetingNoteAiReviewDraft(result.draft, access.members, access.items);
 360 
 361     let finalization: MeetingNoteAiSuccessFinalization;
 362     try {
 363       finalization = await operations.finalizeSuccess(operationId, ctx.dbUser.id);
 364     } catch (error) {
 365       // Unknown whether it committed: never return the draft. `discarded` is a
 366       // no-op when the finalization did commit (a terminal operation never
 367       // changes), so the stored outcome is whichever committed first.
 368       logEvent('meeting_notes_ai_finalize_failed', {
 369         correlationId: ctx.correlationId,
 370         operationId,
 371         sqlstate: error instanceof MeetingNoteDbError ? error.sqlstate : undefined,
 372       });
 373       const settlement = await settle(ctx, operations, operationId, 'discarded');
 374       settled = true;
 375       return { kind: 'settled_elsewhere', operationId, status: settlement.status };
 376     }
 377     settled = true;
 378     if (finalization.changed && finalization.status === 'discarded' && finalization.access !== 'ok') {
 379       return { kind: 'access_lost', operationId, status: finalization.status, reason: finalization.access };
 380     }
 381     if (!finalization.changed || finalization.status !== 'succeeded' || finalization.access !== 'ok') {
 382       return { kind: 'settled_elsewhere', operationId, status: finalization.status };
 383     }
 384     if (signal.aborted) {
 385       // Left while the finalization ran or after it committed: the draft is
 386       // dropped; the operation stays `succeeded` (counted either way).
 387       return { kind: 'client_gone', operationId, status: finalization.status };
 388     }
 389     return {
 390       kind: 'succeeded',
 391       operationId,
 392       sourceRevision: admission.sourceRevision,
 393       transcriptId: admission.transcriptId,
 394       draft,
 395       usage: finalization.usage,
 396     };
 397   } finally {
 398     if (!settled) {
 399       // An unexpected error: never leave the reservation without an outcome
 400       // when one can be recorded (released before the dispatch mark, failed
 401       // after it — counted, as the request may have left).
 402       if (marked) {
 403         await settle(ctx, operations, operationId, 'failed');
 404       } else {
 405         // The provider was never called. If the dispatch mark committed but
 406         // its reply was lost, `released` is refused (valid only from
 407         // admitted): nothing was sent, so the operation is refunded.
 408         const released = await settle(ctx, operations, operationId, 'released');
 409         if (released.status === 'dispatched') await settle(ctx, operations, operationId, 'refunded');
 410       }
 411     }
 412   }
 413 }
src/hooks/mutations/useMeetingNoteAiMutations.ts
   1 // src/hooks/mutations/useMeetingNoteAiMutations.ts
   2 // The AI flow's requests (Phase 6 T13; FR-015, FR-018, FR-021, FR-031):
   3 // the ticket (provider notice + usage), processing (the draft), and Apply.
   4 // Each runs through useMeetingNotesScopedMutation: its request is aborted
   5 // when the signed-in scope (users.id + company) retires, and a late answer of
   6 // a retired scope runs no callback, so no draft, cache write, or navigation
   7 // of the previous account ever happens. Ticket and processing are also
   8 // aborted when the note view unmounts (leaving the page cancels, FR-021);
   9 // processing can also be cancelled by the user (`cancelSignal`). Settled
  10 // calls leave the MutationCache as soon as nothing observes them (gcTime 0),
  11 // so neither tickets nor drafts linger there.
  12 // A processing response that carries a draft is handed to the flow only
  13 // after a fresh read of the note through the user's own session confirms
  14 // that they still edit it in the same company (FR-021 browser clause): the
  15 // server authorizes the draft when it finalizes, but the 200 may still be in
  16 // transit when an admin removes the member, and this browser retires the
  17 // scope only after membership reconciliation. On a lost access (404/403, a
  18 // note of another company, no edit right) the draft is dropped, the flow
  19 // shows "access lost", and the note's queries are refetched; the scope itself
  20 // retires through the normal membership reconciliation. On success the note
  21 // it read refreshes this viewer's cache when newer, so the review compares
  22 // the draft with the note's current revision.
  23 'use client';
  24 
  25 import { useQueryClient, type QueryClient } from '@tanstack/react-query';
  26 
  27 import {
  28   settleMeetingNoteCache,
  29   settleMeetingNoteConflictCache,
  30 } from '@/hooks/mutations/useMeetingNoteMutations';
  31 import { useMeetingNotesScopedMutation } from '@/hooks/mutations/useMeetingNotesScopedMutation';
  32 import { meetingNoteAiSettingsQueryKey } from '@/hooks/queries/useMeetingNoteAiSettings';
  33 import { meetingNoteQueryKeys } from '@/hooks/queries/useMeetingNotes';
  34 import {
  35   applyMeetingNoteAiDraft,
  36   fetchMeetingNoteAiTicket,
  37   fetchMeetingNoteDetail,
  38   MeetingNotesApiError,
  39   processMeetingNoteAiDraft,
  40   type MeetingNoteAiApplyResponse,
  41 } from '@/lib/meeting-notes/client-api';
  42 import type { MeetingNotesScope } from '@/lib/meeting-notes/scope-fence';
  43 import type {
  44   MeetingNoteAiApplyInput,
  45   MeetingNoteAiProcessResponse,
  46   MeetingNoteAiTicketResponse,
  47   MeetingNoteDetail,
  48 } from '@/types/meeting-notes';
  49 
  50 /** One signal aborted when either input is. */
  51 function eitherSignal(primary: AbortSignal, secondary: AbortSignal | undefined): AbortSignal {
  52   if (!secondary) return primary;
  53   const controller = new AbortController();
  54   if (primary.aborted || secondary.aborted) {
  55     controller.abort();
  56     return controller.signal;
  57   }
  58   const abort = () => controller.abort();
  59   primary.addEventListener('abort', abort, { once: true });
  60   secondary.addEventListener('abort', abort, { once: true });
  61   return controller.signal;
  62 }
  63 
  64 /** After an AI refusal: refresh what it says is outdated (settings, the note, or access). */
  65 function refreshAfterAiError(queryClient: QueryClient, scope: MeetingNotesScope, noteId: string, error: Error): 
void {
  66   if (!(error instanceof MeetingNotesApiError) || error.status === 0) return;
  67   if (error.code === 'MEETING_NOTE_AI_NOT_CONFIGURED' || error.code === 'MEETING_NOTE_AI_SETTINGS_STALE') {
  68     void queryClient.invalidateQueries({ queryKey: meetingNoteAiSettingsQueryKey(scope.userId, scope.companyId) 
});
  69   }
  70   if (
  71     error.code === 'MEETING_NOTE_AI_SOURCE_STALE' ||
  72     error.code === 'MEETING_NOTE_AI_TRANSCRIPT_REQUIRED' ||
  73     error.status === 404 ||
  74     error.status === 403
  75   ) {
  76     void queryClient.invalidateQueries({ queryKey: meetingNoteQueryKeys.noteRoot(scope.userId, scope.companyId, 
noteId) });
  77   }
  78 }
  79 
  80 /**
  81  * Confirms, with the user's session, that the draft's note is still readable
  82  * and editable by the caller in `scope`'s company, and returns that fresh
  83  * note; throws the access-lost error the flow shows otherwise. Uses the
  84  * request's signal, so Cancel, leaving the page, and a retiring scope abort
  85  * it too.
  86  */
  87 async function confirmDraftAccess(
  88   noteId: string,
  89   scope: MeetingNotesScope,
  90   signal: AbortSignal
  91 ): Promise<MeetingNoteDetail> {
  92   const note = await fetchMeetingNoteDetail(noteId, {}, signal);
  93   if (note.id.toLowerCase() !== noteId.toLowerCase() || note.companyId !== scope.companyId) {
  94     throw new MeetingNotesApiError(404, 'MEETING_NOTE_NOT_FOUND', 'This meeting note is no longer available.');
  95   }
  96   if (!note.rights.canEdit) {
  97     throw new MeetingNotesApiError(403, 'MEETING_NOTE_FORBIDDEN', 'You can no longer edit this meeting note.');
  98   }
  99   return note;
 100 }
 101 
 102 /**
 103  * Stores the note read by the access check unless the cache already holds
 104  * that revision or a newer one: a note edited elsewhere before the ticket was
 105  * issued would otherwise stay at its old revision in this view, and the
 106  * review would report the draft's newer source as a conflict.
 107  */
 108 function storeConfirmedNote(queryClient: QueryClient, scope: MeetingNotesScope, note: MeetingNoteDetail): void {
 109   const cached = queryClient.getQueryData<MeetingNoteDetail>(
 110     meetingNoteQueryKeys.note(scope.userId, scope.companyId, note.id)
 111   );
 112   if (cached && cached.revision >= note.revision) return;
 113   settleMeetingNoteCache(queryClient, scope, note);
 114 }
