  51 
  52 export function MeetingNoteForm({
  53   initial,
  54   submitLabel,
  55   submitting,
  56   submitError,
  57   onSubmit,
  58   onCancel,
  59   header,
  60 }: MeetingNoteFormProps) {
  61   const ids = {
  62     title: useId(),
  63     titleError: useId(),
