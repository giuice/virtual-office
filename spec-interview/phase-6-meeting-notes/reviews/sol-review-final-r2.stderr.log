  59 
  60 export type MeetingNoteErrorToken = (typeof MEETING_NOTE_ERROR_TOKENS)[number];
  61 
  62 const KNOWN_TOKENS: ReadonlySet<string> = new Set(MEETING_NOTE_ERROR_TOKENS);
  63 
  64 export function isMeetingNoteErrorToken(value: string): value is MeetingNoteErrorToken {
  65   return KNOWN_TOKENS.has(value);
  66 }
  67 
  68 /**
  69  * A database error from a meeting-note RPC. `token` is set only for the
  70  * documented message tokens; anything else is an unexpected failure whose
  71  * message must not reach the client.
  72  */
  73 export class MeetingNoteDbError extends Error {
  74   readonly sqlstate: string | undefined;
  75   readonly token: MeetingNoteErrorToken | null;
  76   /** Parsed DETAIL JSON (e.g. {"current_revision": 3}); null when absent or not JSON. */
  77   readonly detail: Record<string, unknown> | null;
  78 
  79   constructor(sqlstate: string | undefined, message: string, detail: string | null | undefined) {
  80     super(message);
  81     this.name = 'MeetingNoteDbError';
  82     this.sqlstate = sqlstate;
  83     this.token = isMeetingNoteErrorToken(message) ? message : null;
  84     this.detail = parseDetail(detail);
  85   }
  86 
  87   /** The current revision reported by a stale-revision error, if any. */
  88   get currentRevision(): number | null {
  89     const value = this.detail?.current_revision;
  90     return typeof value === 'number' && Number.isSafeInteger(value) ? value : null;
  91   }
  92 }
  93 
  94 function parseDetail(detail: string | null | undefined): Record<string, unknown> | null {
  95   if (!detail) return null;
  96   try {
  97     const parsed: unknown = JSON.parse(detail);
  98     return typeof parsed === 'object' && parsed !== null && !Array.isArray(parsed)
  99       ? (parsed as Record<string, unknown>)
 100       : null;
 101   } catch {
 102     return null;
 103   }
 104 }

