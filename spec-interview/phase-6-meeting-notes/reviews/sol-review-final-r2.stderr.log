  83 /** Optional server-only override of the provider deadline (ms), clamped to 1 s – 300 s. */
  84 export const MEETING_NOTES_AI_TIMEOUT_ENV = 'MEETING_NOTES_AI_TIMEOUT_MS';
  85 
  86 function configuredTimeoutMs(): number | undefined {
  87   const raw = process.env[MEETING_NOTES_AI_TIMEOUT_ENV]?.trim();
  88   if (!raw) return undefined;
  89   const value = Number(raw);
  90   if (!Number.isFinite(value)) return undefined;
  91   return Math.min(Math.max(Math.floor(value), 1_000), MEETING_NOTE_AI_MAX_TIMEOUT_MS);
  92 }
  93 
  94 export interface MeetingNoteAiProcessingContext {
  95   correlationId: string;
  96   /** The user's server client (session cookies). */
  97   supabase: SupabaseClient;
  98   /** The user's repository (RLS). */
  99   repository: IMeetingNoteRepository;
 100   dbUser: User;
 101   /** Service-role client, built only after the route authenticated the user. */
 102   service: SupabaseClient;
 103 }
 104 
 105 export type MeetingNoteAiProcessingOutcome =
 106   /** Admission refused (expired, binding, rights, settings stale, source stale, limit, not configured). */
 107   | { kind: 'refused'; error: MeetingNoteDbError }
 108   /** The ticket's operation already exists: its status, no draft, no dispatch. */
 109   | { kind: 'replay'; replay: MeetingNoteAiReplay; usage: MeetingNoteAiUsage | null }
 110   /** FR-020 (or an out-of-matrix snapshot): refused before dispatch; released (not counted). */
 111   | { kind: 'preflight_refused'; operationId: string; status: MeetingNoteAiOperationStatus | null; failure: 
MeetingNoteAiDraftFailure; usage: MeetingNoteAiUsage | null }
 112   /** The client left before anything was sent; released. */
 113   | { kind: 'cancelled_before_send'; operationId: string; status: MeetingNoteAiOperationStatus | null }
 114   /** The operation could not be marked dispatched (already terminal); nothing sent. */
 115   | { kind: 'not_dispatchable'; operationId: string; status: MeetingNoteAiOperationStatus | null }
 116   /** The provider call failed; settled per its counting class. */
 117   | { kind: 'provider_failure'; operationId: string; status: MeetingNoteAiOperationStatus | null; failure: 
MeetingNoteAiDraftFailure; usage: MeetingNoteAiUsage | null }
 118   /** The client left after dispatch: discarded (counted), no draft. */
 119   | { kind: 'client_gone'; operationId: string; status: MeetingNoteAiOperationStatus | null }
 120   /** The caller lost membership/editor rights, or the note is gone: discarded, no draft. */
 121   | { kind: 'access_lost'; operationId: string; status: MeetingNoteAiOperationStatus | null; reason: 'not_found' 
| 'forbidden' }
 122   /** The settlement did not record success (e.g. the stale job failed it first): no draft. */
 123   | { kind: 'settled_elsewhere'; operationId: string; status: MeetingNoteAiOperationStatus | null }
 124   | {
 125       kind: 'succeeded';
 126       operationId: string;
 127       sourceRevision: number;
 128       transcriptId: string;
 129       draft: MeetingNoteAiReviewDraft;
 130       usage: MeetingNoteAiUsage | null;
 131     };
 132 
 133 function logEvent(event: string, fields: Record<string, unknown>): void {
 134   // Identifiers and codes only — never the key, the transcript, or provider text.
 135   console.info(JSON.stringify({ event, ...fields }));
 136 }
