 752 create or replace function public.get_meeting_note_ai_usage()
 753 returns jsonb
 754 language plpgsql
 755 stable
 756 security definer
 757 set search_path = ''
 758 as $$
 759 declare
 760   v_uid text := (select auth.uid())::text;
 761   v_company_id uuid;
 762   v_limit integer;
 763   v_configured boolean;
 764   v_day date := private.meeting_note_ai_usage_day(pg_catalog.now());
 765 begin
 766   if v_uid is not null then
 767     select u.company_id into v_company_id
 768     from public.users as u
 769     where u.supabase_uid = v_uid;
 770   end if;
 771   if v_company_id is null then
 772     raise exception 'MEETING_NOTE_AI_USAGE_FORBIDDEN' using errcode = '42501';
 773   end if;
 774 
 775   select s.daily_limit into v_limit
 776   from public.meeting_note_ai_settings as s
 777   where s.company_id = v_company_id;
 778   v_configured := found;
 779 
 780   return pg_catalog.jsonb_build_object(
 781     'configured', v_configured,
 782     'daily_limit', coalesce(v_limit, 20),
 783     'used', private.meeting_note_ai_used_count(v_company_id, v_day),
 784     'usage_day', v_day,
 785     'reset_at', private.meeting_note_ai_reset_at(v_day)
 786   );
 787 end;
 788 $$;
