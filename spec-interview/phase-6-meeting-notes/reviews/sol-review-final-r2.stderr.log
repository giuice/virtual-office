 202  * 502 provider failure codes (src/lib/meeting-notes/ai/provider-errors.ts) {retryable, status, usage};
 203  * 499 MEETING_NOTE_AI_CANCELLED (the client left); 503 MEETING_NOTE_AI_UNAVAILABLE (ticket secret missing).
 204  */
 205 export async function POST(request: NextRequest, { params }: RouteParams): Promise<NextResponse> {
 206   const begun = await beginMeetingNoteMutation(request, PATH, 'meeting-note:ai-process');
 207   if (!begun.ok) {
 208     await request.body?.cancel().catch(() => undefined);
 209     return begun.response;
 210   }
 211   const ctx = begun.value;
 212 
 213   const id = parsePathId((await params).id, 'MEETING_NOTE_NOT_FOUND', ctx);
 214   if (!id.ok) {
 215     await request.body?.cancel().catch(() => undefined);
 216     return id.response;
 217   }
 218 
 219   const raw = await readJsonObject(request, ctx);
 220   if (!raw.ok) return raw.response;
 221   const body = parseWith(startMeetingNoteAiProcessingBodySchema, raw.value, ctx);
 222   if (!body.ok) return body.response;
 223 
 224   // 2. Signature and expiry first: no operation is looked up for a bad or old ticket.
 225   let verified;
 226   try {
 227     verified = verifyMeetingNoteAiTicket(body.value.ticket);
 228   } catch (error) {
 229     if (error instanceof MeetingNoteAiTicketConfigError) {
 230       console.error(JSON.stringify({ event: 'meeting_notes_ticket_secret_unconfigured', correlationId: 
ctx.correlationId }));
 231       return meetingNoteError(503, 'MEETING_NOTE_AI_UNAVAILABLE', ctx, 'meetingNotes.aiProcess.config');
 232     }
 233     return internalError(error, ctx, 'meetingNotes.aiProcess.ticket');
 234   }
 235   if (!verified.ok) {
 236     return verified.reason === 'expired'
 237       ? meetingNoteError(410, 'MEETING_NOTE_AI_TICKET_EXPIRED', ctx)
 238       : meetingNoteError(400, 'MEETING_NOTE_AI_TICKET_INVALID', ctx);
 239   }
 240   const ticket = verified.payload;
 241 
 242   // 3. The ticket must belong to this caller, their current company, and this note.
 243   if (ticket.userId !== ctx.dbUser.id) {
 244     return meetingNoteError(409, 'MEETING_NOTE_AI_BINDING_MISMATCH', ctx, 'meetingNotes.aiProcess.binding');
 245   }
 246   if (!ctx.dbUser.companyId || ticket.companyId !== ctx.dbUser.companyId) {
 247     return notFound('MEETING_NOTE_NOT_FOUND', ctx);
 248   }
 249   if (
 250     ticket.noteId.toLowerCase() !== id.value.toLowerCase() ||
 251     (body.value.idempotencyKey !== undefined && body.value.idempotencyKey.toLowerCase() !== 
ticket.idempotencyKey.toLowerCase())
 252   ) {
 253     return meetingNoteError(409, 'MEETING_NOTE_AI_BINDING_MISMATCH', ctx, 'meetingNotes.aiProcess.binding');
 254   }
 255 
 256   // 4. Server-only RPCs, after the caller was authorized above.
 257   try {
 258     const service = await createSupabaseServerClient('service_role');
 259     const outcome = await runMeetingNoteAiProcessing({ ...ctx, service }, ticket, request.signal);
 260     return outcomeResponse(outcome, ctx, { sourceRevision: ticket.sourceRevision, transcriptId: 
ticket.transcriptId });
 261   } catch (error) {
 262     return internalError(error, ctx, 'meetingNotes.aiProcess');
 263   }
 264 }
