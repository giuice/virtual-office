  61       }
  62     );
  63   };
  64 
  65   const loadNewer = () => {
  66     if (!conflict) return;
  67     setBackup(pending);
  68     setBase(conflict.note);
  69     setConflict(null);
  70     setConflictOpen(false);
  71     update.reset();
  72   };
  73 
  74   // A conflict is answered by the dialog and the banner, not as a form error.
  75   const formError = update.error instanceof MeetingNoteConflictError ? null : update.error;
