  19 /** Prefix of every meeting-note query; mutations invalidate below it. */
  20 export const MEETING_NOTES_QUERY_KEY = ['meeting-notes'] as const;
  21 
  22 export const meetingNoteQueryKeys = {
  23   /** Everything one viewer has cached for one company. */
  24   scope: (userId: string, companyId: string) => [...MEETING_NOTES_QUERY_KEY, userId, companyId] as const,
  25   /** A space's Notes tab. */
  26   space: (userId: string, companyId: string, spaceId: string) =>
  27     [...meetingNoteQueryKeys.scope(userId, companyId), 'space', spaceId] as const,
  28   /** Every search / list on the Meetings page. */
  29   searches: (userId: string, companyId: string) =>
  30     [...meetingNoteQueryKeys.scope(userId, companyId), 'search'] as const,
  31   search: (userId: string, companyId: string, params: MeetingNoteSearchParams) =>
  32     [
  33       ...meetingNoteQueryKeys.searches(userId, companyId),
  34       {
  35         q: params.q,
  36         spaceId: params.spaceId,
  37         spaceRemoved: params.spaceRemoved,
  38         from: params.from,
  39         to: params.to,
  40       },
  41     ] as const,
  42   /** Everything cached for one note (view, transcript, history). */
  43   noteRoot: (userId: string, companyId: string, noteId: string) =>
  44     [...meetingNoteQueryKeys.scope(userId, companyId), 'note', noteId] as const,
  45   /** A note's view (without the transcript text). */
  46   note: (userId: string, companyId: string, noteId: string) =>
  47     [...meetingNoteQueryKeys.noteRoot(userId, companyId, noteId), 'detail'] as const,
  48   /** A note's view with the stored transcript text. */
  49   noteTranscript: (userId: string, companyId: string, noteId: string) =>
  50     [...meetingNoteQueryKeys.noteRoot(userId, companyId, noteId), 'transcript'] as const,
  51   /** A note's version list. */
  52   versions: (userId: string, companyId: string, noteId: string) =>
  53     [...meetingNoteQueryKeys.noteRoot(userId, companyId, noteId), 'versions'] as const,
  54   /** One immutable version. */
  55   version: (userId: string, companyId: string, noteId: string, versionId: string) =>
  56     [...meetingNoteQueryKeys.versions(userId, companyId, noteId), versionId] as const,
  57 };
  58 
  59 /**
  60  * The signed-in viewer's application user id and company id; null until both
  61  * are known. The object keeps its identity while both ids stay the same.
  62  */
  63 export function useMeetingNotesScope(): MeetingNotesScope | null {
  64   const { company, currentUserProfile } = useCompany();
  65   const userId = currentUserProfile?.id;
  66   const companyId = company?.id;
  67   return useMemo(() => (userId && companyId ? { userId, companyId } : null), [userId, companyId]);
  68 }
  69 
  70 /** A space's notes, newest meeting date first, paged by the route's offset cursor. */
  71 export function useSpaceMeetingNotes(spaceId: string) {
  72   const scope = useMeetingNotesScope();
  73   return useInfiniteQuery({
  74     queryKey: meetingNoteQueryKeys.space(scope?.userId ?? '', scope?.companyId ?? '', spaceId),
  75     enabled: scope !== null && spaceId.length > 0,
  76     initialPageParam: 0,
  77     queryFn: ({ pageParam, signal }) => fetchSpaceMeetingNotes(spaceId, pageParam, signal),
  78     getNextPageParam: (lastPage) => (lastPage.hasMore ? lastPage.nextCursor ?? undefined : undefined),
  79     staleTime: 30_000,
  80     retry: shouldRetryMeetingNotesRequest,
  81   });
  82 }
  83 
  84 /**
  85  * Company notes for the Meetings page: ranked search when `params.q` is set,
  86  * otherwise every note within the filters by meeting date. Callers debounce
  87  * `params.q` (the route allows 120 requests per minute per user) and pass
  88  * `enabled: false` while the filters are invalid.
  89  */
  90 export function useMeetingNoteSearch(params: MeetingNoteSearchParams, enabled = true) {
  91   const scope = useMeetingNotesScope();
  92   const userId = scope?.userId ?? '';
  93   const companyId = scope?.companyId ?? '';
  94   return useInfiniteQuery({
  95     queryKey: meetingNoteQueryKeys.search(userId, companyId, params),
  96     enabled: enabled && scope !== null,
  97     initialPageParam: 0,
  98     queryFn: ({ pageParam, signal }) => fetchMeetingNoteSearch(params, pageParam, signal),
  99     getNextPageParam: (lastPage) => (lastPage.hasMore ? lastPage.nextCursor ?? undefined : undefined),
 100     // While new filters load, keep the previous results of the SAME viewer and
 101     // company on screen (shown as stale); never another account's results.
 102     placeholderData: (previous, previousQuery) => {
 103       const key = previousQuery?.queryKey;
 104       return key && key[1] === userId && key[2] === companyId && userId !== '' ? previous : undefined;
 105     },
 106     staleTime: 30_000,
 107     retry: shouldRetryMeetingNotesRequest,
 108   });
 109 }
 640 create or replace function public.mark_meeting_note_ai_operation_dispatched(p_operation_id uuid)
 641 returns jsonb
 642 language plpgsql
 643 volatile
 644 security definer
 645 set search_path = ''
 646 as $$
 647 declare
 648   v_operation public.meeting_note_ai_operations%rowtype;
 649   v_changed boolean := false;
 650 begin
 651   if p_operation_id is null then
 652     raise exception 'MEETING_NOTE_AI_INVALID_ARGUMENT' using errcode = '22023';
 653   end if;
 654 
 655   select o.* into v_operation
 656   from public.meeting_note_ai_operations as o
 657   where o.id = p_operation_id
 658   for update;
 659   if not found then
 660     raise exception 'MEETING_NOTE_AI_OPERATION_NOT_FOUND' using errcode = 'P0002';
 661   end if;
 662 
 663   if v_operation.status = 'admitted' then
 664     update public.meeting_note_ai_operations as o
 665     set status = 'dispatched',
 666         dispatched_at = pg_catalog.now()
 667     where o.id = p_operation_id
 668     returning o.* into v_operation;
 669     v_changed := true;
 670   elsif v_operation.status <> 'dispatched' then
 671     raise exception 'MEETING_NOTE_AI_OPERATION_INVALID_TRANSITION'
 672       using errcode = 'P0001',
 673             detail = pg_catalog.jsonb_build_object('status', v_operation.status)::text;
 674   end if;
 675 
 676   return pg_catalog.jsonb_build_object(
 677     'operation_id', v_operation.id,
 678     'status', v_operation.status,
 679     'changed', v_changed,
 680     'dispatched_at', v_operation.dispatched_at
 681   );
 682 end;
 683 $$;
 684 
