  26 
  27 export function MeetingNoteEditPanel({ note, onSaved, onCancel }: MeetingNoteEditPanelProps) {
  28   const update = useUpdateMeetingNote();
  29   const [base, setBase] = useState(note);
  30   const [pending, setPending] = useState<MeetingNoteFieldsPayload | null>(null);
  31   const [conflict, setConflict] = useState<MeetingNoteConflictError | null>(null);
  32   const [conflictOpen, setConflictOpen] = useState(false);
  33   const [backup, setBackup] = useState<MeetingNoteFieldsPayload | null>(null);
  34 
  35   const initial = useMemo<MeetingNoteFormInitialValues>(
  36     () => ({
