 112 function withData(status: number, code: string, message: string, ctx: MeetingNoteRouteContext, data: 
Record<string, unknown>) {
 113   return NextResponse.json(
 114     { error: message, code, correlationId: ctx.correlationId, ...data },
 115     { status, headers: { 'x-correlation-id': ctx.correlationId } }
 116   );
 117 }
 118 
 119 function outcomeResponse(
 120   outcome: MeetingNoteAiProcessingOutcome,
 121   ctx: MeetingNoteRouteContext,
 122   binding: { sourceRevision: number; transcriptId: string }
 123 ): NextResponse {
 124   switch (outcome.kind) {
 125     case 'refused':
 126       return admissionRefusal(outcome.error, ctx);
 127     case 'replay': {
 128       const body: MeetingNoteAiProcessResponse = {
 129         operationId: outcome.replay.operationId,
 130         status: outcome.replay.status,
 131         replay: true,
 132         sourceRevision: binding.sourceRevision,
 133         transcriptId: binding.transcriptId,
 134         draft: null,
 135         usage: outcome.usage,
 136       };
 137       return ok(body, ctx);
 138     }
 139     case 'preflight_refused':
 140       return withData(422, outcome.failure.code, outcome.failure.message, ctx, {
 141         operationId: outcome.operationId,
 142         status: outcome.status,
 143         retryable: outcome.failure.retryable,
 144         estimatedInputTokens: outcome.failure.estimatedInputTokens ?? null,
 145         maxInputTokens: outcome.failure.maxInputTokens ?? null,
 146         usage: outcome.usage,
 147       });
 148     case 'cancelled_before_send':
 149     case 'client_gone':
 150       return meetingNoteErrorWithData(CLIENT_CLOSED_STATUS, 'MEETING_NOTE_AI_CANCELLED', ctx, {
 151         operationId: outcome.operationId,
 152         status: outcome.status,
 153       });
 154     case 'not_dispatchable':
 155       return meetingNoteErrorWithData(409, 'MEETING_NOTE_AI_OPERATION_ENDED', ctx, {
 156         operationId: outcome.operationId,
 157         status: outcome.status,
 158         retryable: true,
 159       });
 160     case 'provider_failure':
 161       return withData(502, outcome.failure.code, outcome.failure.message, ctx, {
 162         operationId: outcome.operationId,
 163         status: outcome.status,
 164         retryable: outcome.failure.retryable,
 165         usage: outcome.usage,
 166       });
 167     case 'access_lost':
 168       return outcome.reason === 'not_found'
 169         ? meetingNoteErrorWithData(404, 'MEETING_NOTE_NOT_FOUND', ctx, { operationId: outcome.operationId, 
status: outcome.status })
 170         : meetingNoteErrorWithData(403, 'MEETING_NOTE_FORBIDDEN', ctx, { operationId: outcome.operationId, 
status: outcome.status });
 171     case 'settled_elsewhere':
 172       return meetingNoteErrorWithData(409, 'MEETING_NOTE_AI_DRAFT_DISCARDED', ctx, {
 173         operationId: outcome.operationId,
 174         status: outcome.status,
 175         retryable: true,
 176       });
 177     case 'succeeded': {
 178       const body: MeetingNoteAiProcessResponse = {
 179         operationId: outcome.operationId,
 180         status: 'succeeded',
 181         replay: false,
 182         sourceRevision: outcome.sourceRevision,
 183         transcriptId: outcome.transcriptId,
 184         draft: outcome.draft,
 185         usage: outcome.usage,
 186       };
 187       return ok(body, ctx);
 188     }
 189   }
 190 }
