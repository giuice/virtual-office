   1 // src/components/meeting-notes/MeetingNoteForm.tsx
   2 // Create / edit form of a meeting note (FR-001, FR-002, FR-030): title
   3 // (1–200), meeting date (a local day), participants (≤ 50, current members;
   4 // former members already listed may stay), and rich text (≤ 100,000
