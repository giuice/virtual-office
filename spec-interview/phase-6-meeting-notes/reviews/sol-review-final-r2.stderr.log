   1 // src/lib/meeting-notes/ai/processing.ts
   2 // The server side of "Process transcript" after the start route verified the
   3 // ticket and bound it to the authenticated application user (Phase 6 T12;
   4 // SPEC FR-015, FR-016, FR-017, FR-020, FR-021, FR-022, FR-031, BR-013).
   5 //
   6 // Order (each step only after the previous one):
   7 //   1. admission (service_role RPC, actor = the route's users.id): re-checks
   8 //      current membership and editor rights FIRST, then replay / binding /
   9 //      settings revision / source / limit, and reserves one unit. A replay
  10 //      returns the stored status only — never a draft, never a dispatch.
  11 //   2. normalize the transcript (FR-014) and run the FR-020 size preflight:
  12 //      a refusal settles `released` (not counted) — nothing was sent.
  13 //   3. client already gone → `released` (never sent).
  14 //   4. mark dispatched; a refused transition (the stale job already failed
  15 //      the operation) means the request is NOT sent.
  16 //   5. exactly one provider request with the ADMITTED snapshot (provider,
  17 //      model, reasoning level, key) — never the current settings — and an
  18 //      AbortSignal tied to the client request plus the adapter deadline
  19 //      (default 180 s, MEETING_NOTES_AI_TIMEOUT_MS; always far below the
  20 //      10-minute stale job).
  21 //   6. settlement, by outcome:
  22 //        draft received, client still there, caller still a member and
  23 //          editor, note still exists                → succeeded (counted),
  24 //          recorded ONLY by finalize_meeting_note_ai_success, which re-checks
  25 //          membership, editor rights, and note existence on locked rows
  26 //          (actor users FOR KEY SHARE → note FOR UPDATE → operation) in the
  27 //          same transaction that writes `succeeded`; it discards instead
  28 //          when access was lost after the preliminary session read
  29 //        draft received but the client left, or the caller lost access, or
  30 //          the note is gone                         → discarded (counted)
  31 //        processed_failure, client still there      → failed (counted)
  32 //        processed_failure because the client left  → discarded (counted)
  33 //        preprocessing_rejected (listed initial rejection) → refunded
  34 //        never_sent after the dispatch mark (connection refused, cancelled
  35 //          just before fetch)                       → refunded (`released`
  36 //          is only valid from admitted)
  37 //      A settlement that did not change the operation, or ended in another
  38 //      status (e.g. the stale job failed it first), drops the draft.
  39 //   Cancellation (FR-021/AC-034): the client signal is checked after EVERY
  40 //   await that follows the provider call, up to the moment the finalization
  41 //   request is sent; a cancellation seen there settles `discarded` (counted,
  42 //   never refunded), so a replay reports `discarded`. Once the finalization
  43 //   request was sent, that transaction alone decides the outcome: a
  44 //   cancellation arriving while it runs or after it committed leaves
  45 //   `succeeded` (the draft is still dropped, 499) — the database cannot
  46 //   observe the closed connection. The usage returned with a draft comes
  47 //   from the same finalization transaction; no read follows it.
  48 // The decrypted key and the transcript live only in this call's memory; they
  49 // are never logged, returned, or stored. Nothing here reads or writes note
  50 // content: the draft is returned to the caller, and only Apply stores it.
  51 import 'server-only';
  52 
  53 import type { SupabaseClient } from '@supabase/supabase-js';
  54 
  55 import { MeetingNoteDbError } from '@/lib/meeting-notes/errors';
  56 import { computeMeetingNoteRights } from '@/lib/meeting-notes/note-detail';
  57 import { SupabaseMeetingNoteAiOperationRepository } from 
'@/repositories/implementations/supabase/SupabaseMeetingNoteAiOperationRepository';
  58 import type { IMeetingNoteRepository } from '@/repositories/interfaces/IMeetingNoteRepository';
  59 import type {
  60   MeetingNoteAiAdmission,
  61   MeetingNoteAiReplay,
  62   MeetingNoteAiSuccessFinalization,
  63 } from '@/repositories/interfaces/IMeetingNoteAiOperationRepository';
  64 import type { User } from '@/types/database';
  65 import type {
  66   MeetingNoteAiOperationStatus,
  67   MeetingNoteAiReviewDraft,
  68   MeetingNoteAiSettlementOutcome,
  69   MeetingNoteAiUsage,
  70 } from '@/types/meeting-notes';
  71 
  72 import {
  73   generateMeetingNoteDraft,
  74   MEETING_NOTE_AI_MAX_TIMEOUT_MS,
  75   preflightMeetingNoteAiTranscript,
  76   type MeetingNoteAiDraftFailure,
  77 } from './adapters';
  78 import { buildMeetingNoteAiReviewDraft } from './draft-review';
  79 import { meetingNoteAiFailure, meetingNoteAiTooLongFailure } from './provider-errors';
  80 import { meetingNoteAiTicketIssuedAt, type MeetingNoteAiTicketPayload } from './ticket';
  81 import { normalizeTranscriptForProvider } from './transcript-normalizer';
