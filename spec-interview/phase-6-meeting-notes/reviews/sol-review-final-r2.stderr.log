 120 export function useMeetingNoteAiTicket() {
 121   const queryClient = useQueryClient();
 122   return useMeetingNotesScopedMutation<MeetingNoteAiTicketResponse, MeetingNoteAiTicketVariables>({
 123     name: 'ai-ticket',
 124     abortOnUnmount: true,
 125     gcTime: 0,
 126     mutationFn: ({ noteId }, { signal }) => fetchMeetingNoteAiTicket(noteId, signal),
 127     onError: (error, { noteId }, scope) => refreshAfterAiError(queryClient, scope, noteId, error),
 128   });
 129 }
