  40   'MEETING_NOTE_AI_INVALID_ARGUMENT',
  41   'MEETING_NOTE_AI_OUTCOME_INVALID',
  42   // P0001 (DETAIL JSON where noted)
  43   'MEETING_NOTE_AI_TICKET_EXPIRED',
  44   'MEETING_NOTE_AI_BINDING_MISMATCH',
  45   'MEETING_NOTE_AI_NOT_CONFIGURED',
