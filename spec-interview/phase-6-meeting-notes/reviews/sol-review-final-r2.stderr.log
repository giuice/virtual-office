   1 // src/repositories/implementations/supabase/SupabaseMeetingNoteAiOperationRepository.ts
   2 // AI usage and processing operations (Phase 6 T9; migration 20261013154823).
   3 // Construct with the user's server client for getOwnCompanyUsage (RPC granted
   4 // to authenticated, scoped to the caller's company), and with the
   5 // service-role client for admit / markDispatched / settle / finalizeSuccess (service_role-only
   6 // RPCs), only after the route authorized the application user. Server-only:
   7 // an admission carries a decrypted API key and the transcript text.
   8 // Deliberately not re-exported from the implementations index, which client
   9 // code may import.
  10 import 'server-only';
  11 
  12 import type { PostgrestError, SupabaseClient } from '@supabase/supabase-js';
  13 
  14 import { MeetingNoteDbError } from '@/lib/meeting-notes/errors';
  15 import type {
  16   AdmitMeetingNoteAiOperationParams,
  17   IMeetingNoteAiOperationRepository,
  18   MeetingNoteAiAdmission,
  19   MeetingNoteAiCompanyUsage,
  20   MeetingNoteAiOperationTransition,
  21   MeetingNoteAiReplay,
  22   MeetingNoteAiFinalizationAccess,
  23   MeetingNoteAiSettlement,
  24   MeetingNoteAiSuccessFinalization,
  25 } from '@/repositories/interfaces/IMeetingNoteAiOperationRepository';
  26 import type {
  27   MeetingNoteAiOperationStatus,
  28   MeetingNoteAiProvider,
  29   MeetingNoteAiSettlementOutcome,
  30   MeetingNoteAiUsage,
  31 } from '@/types/meeting-notes';
  32 
  33 const PROVIDERS: ReadonlySet<string> = new Set<MeetingNoteAiProvider>(['anthropic', 'openai', 'kimi', 'glm']);
  34 const STATUSES: ReadonlySet<string> = new Set<MeetingNoteAiOperationStatus>([
  35   'admitted',
  36   'dispatched',
  37   'succeeded',
  38   'failed',
  39   'discarded',
  40   'refunded',
  41   'released',
  42 ]);
  43 
  44 type Row = Record<string, unknown>;
  45 
  46 function toDbError(error: PostgrestError): MeetingNoteDbError {
  47   return new MeetingNoteDbError(error.code, error.message, error.details);
  48 }
  49 
  50 /** A fixed message: never the payload (it could carry the key or transcript). */
  51 function invalidShape(what: string): MeetingNoteDbError {
  52   return new MeetingNoteDbError(undefined, `${what} returned an unexpected shape`, null);
  53 }
  54 
  55 function asRow(data: unknown, what: string): Row {
  56   if (!data || typeof data !== 'object' || Array.isArray(data)) throw invalidShape(what);
  57   return data as Row;
  58 }
  59 
  60 function str(row: Row, key: string, what: string): string {
  61   const value = row[key];
  62   if (typeof value !== 'string') throw invalidShape(what);
  63   return value;
  64 }
  65 
  66 function int(row: Row, key: string, what: string): number {
  67   const raw = row[key];
  68   const value = typeof raw === 'string' ? Number(raw) : raw;
  69   if (typeof value !== 'number' || !Number.isSafeInteger(value)) throw invalidShape(what);
  70   return value;
  71 }
  72 
  73 function bool(row: Row, key: string, what: string): boolean {
  74   const value = row[key];
  75   if (typeof value !== 'boolean') throw invalidShape(what);
  76   return value;
  77 }
  78 
  79 function provider(row: Row, what: string): MeetingNoteAiProvider {
  80   const value = row.provider;
  81   if (typeof value !== 'string' || !PROVIDERS.has(value)) throw invalidShape(what);
  82   return value as MeetingNoteAiProvider;
  83 }
  84 
  85 function status(row: Row, what: string): MeetingNoteAiOperationStatus {
  86   const value = row.status;
  87   if (typeof value !== 'string' || !STATUSES.has(value)) throw invalidShape(what);
  88   return value as MeetingNoteAiOperationStatus;
  89 }
  90 
  91 function usage(row: Row, what: string): MeetingNoteAiUsage {
  92   return {
  93     limit: int(row, 'limit', what),
  94     used: int(row, 'used', what),
  95     usageDay: str(row, 'usage_day', what),
  96     resetAt: new Date(str(row, 'reset_at', what)).toISOString(),
  97   };
  98 }
  99 
 100 const ACCESS: ReadonlySet<string> = new Set<MeetingNoteAiFinalizationAccess>(['ok', 'not_found', 'forbidden']);
 101 
 102 function settlement(row: Row, what: string): MeetingNoteAiSettlement {
 103   return {
 104     operationId: str(row, 'operation_id', what),
 105     status: status(row, what),
 106     changed: bool(row, 'changed', what),
 107     counted: bool(row, 'counted', what),
 108     admissionDay: str(row, 'admission_day', what),
 109   };
 110 }
 111 
 112 export class SupabaseMeetingNoteAiOperationRepository implements IMeetingNoteAiOperationRepository {
 113   constructor(private readonly supabase: SupabaseClient) {}
 114 
 115   async getOwnCompanyUsage(): Promise<MeetingNoteAiCompanyUsage> {
 116     const what = 'get_meeting_note_ai_usage';
 117     const { data, error } = await this.supabase.rpc(what);
 118     if (error) throw toDbError(error);
 119     const row = asRow(data, what);
 120     return {
 121       configured: bool(row, 'configured', what),
 122       ...usage({ ...row, limit: row.daily_limit }, what),
 123     };
 124   }
 125 
 126   async admit(params: AdmitMeetingNoteAiOperationParams): Promise<MeetingNoteAiAdmission | MeetingNoteAiReplay> {
 127     const what = 'admit_meeting_note_ai_operation';
 128     const { data, error } = await this.supabase.rpc(what, {
 129       p_actor_user_id: params.actorUserId,
 130       p_company_id: params.companyId,
 131       p_note_id: params.noteId,
 132       p_idempotency_key: params.idempotencyKey,
 133       p_ticket_issued_at: params.ticketIssuedAt,
 134       p_source_revision: params.sourceRevision,
 135       p_transcript_id: params.transcriptId,
 136       p_settings_revision: params.settingsRevision,
 137     });
 138     if (error) throw toDbError(error);
 139     const row = asRow(data, what);
 140     const base = {
 141       operationId: str(row, 'operation_id', what),
 142       admissionDay: str(row, 'admission_day', what),
 143       provider: provider(row, what),
 144       model: str(row, 'model', what),
 145       reasoningLevel: str(row, 'reasoning_level', what),
 146       settingsRevision: int(row, 'settings_revision', what),
 147     };
 148     if (bool(row, 'replay', what)) {
 149       return { replay: true, status: status(row, what), ...base };
 150     }
 151     if (status(row, what) !== 'admitted') throw invalidShape(what);
 152     return {
 153       replay: false,
 154       status: 'admitted',
 155       ...base,
 156       sourceRevision: int(row, 'source_revision', what),
 157       transcriptId: str(row, 'transcript_id', what),
 158       apiKey: str(row, 'api_key', what),
 159       transcript: str(row, 'transcript', what),
 160       usage: usage(asRow(row.usage, what), what),
 161     };
 162   }
 163 
 164   async markDispatched(operationId: string): Promise<MeetingNoteAiOperationTransition> {
 165     const what = 'mark_meeting_note_ai_operation_dispatched';
 166     const { data, error } = await this.supabase.rpc(what, { p_operation_id: operationId });
 167     if (error) throw toDbError(error);
 168     const row = asRow(data, what);
 169     return { operationId: str(row, 'operation_id', what), status: status(row, what), changed: bool(row, 
'changed', what) };
 170   }
 171 
 172   async settle(operationId: string, outcome: MeetingNoteAiSettlementOutcome): Promise<MeetingNoteAiSettlement> {
 173     const what = 'settle_meeting_note_ai_operation';
 174     const { data, error } = await this.supabase.rpc(what, { p_operation_id: operationId, p_outcome: outcome });
 175     if (error) throw toDbError(error);
 176     return settlement(asRow(data, what), what);
 177   }
 178 
 179   async finalizeSuccess(operationId: string, actorUserId: string): Promise<MeetingNoteAiSuccessFinalization> {
 180     const what = 'finalize_meeting_note_ai_success';
 181     const { data, error } = await this.supabase.rpc(what, { p_operation_id: operationId, p_actor_user_id: 
actorUserId });
 182     if (error) throw toDbError(error);
 183     const row = asRow(data, what);
 184     const access = row.access;
 185     if (typeof access !== 'string' || !ACCESS.has(access)) throw invalidShape(what);
 186     const result: MeetingNoteAiSuccessFinalization = {
 187       ...settlement(row, what),
 188       access: access as MeetingNoteAiFinalizationAccess,
 189       usage: row.usage === null || row.usage === undefined ? null : usage(asRow(row.usage, what), what),
 190     };
 191     // Success is only ever reported together with a confirmed access.
 192     if (result.status === 'succeeded' && result.changed && (result.access !== 'ok' || result.usage === null)) {
 193       throw invalidShape(what);
 194     }
 195     return result;
 196   }
 197 }
