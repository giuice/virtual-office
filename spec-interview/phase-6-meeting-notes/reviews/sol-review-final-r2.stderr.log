  32 // Network fault: when MEETING_NOTES_CHILD_DROP_RPC_REPLY names an RPC, its
  33 // request reaches the local database and commits, then the reply is lost
  34 // (the caller sees a fetch failure). Installed before the route loads.
  35 const dropReplyOf = process.env.MEETING_NOTES_CHILD_DROP_RPC_REPLY;
  36 if (dropReplyOf) {
  37   const realFetch = globalThis.fetch;
  38   globalThis.fetch = async (input, init) => {
  39     const url = typeof input === 'string' ? input : input instanceof URL ? input.href : input.url;
  40     const response = await realFetch(input, init);
  41     if (url.includes(`/rest/v1/rpc/${dropReplyOf}`)) {
  42       await response.arrayBuffer();
  43       throw new TypeError('fetch failed');
  44     }
  45     return response;
  46   };
  47 }
