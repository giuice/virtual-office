 148 /**
 149  * Settles the operation; returns the resulting status and whether this call
 150  * recorded `outcome`. A failing settlement is logged (ids only) and reported
 151  * as not recorded: the stale job then fails the operation (counted).
 152  */
 153 async function settle(
 154   ctx: MeetingNoteAiProcessingContext,
 155   operations: SupabaseMeetingNoteAiOperationRepository,
 156   operationId: string,
 157   outcome: MeetingNoteAiSettlementOutcome
 158 ): Promise<{ status: MeetingNoteAiOperationStatus | null; recorded: boolean }> {
 159   try {
 160     const result = await operations.settle(operationId, outcome);
 161     return { status: result.status, recorded: result.changed && result.status === outcome };
 162   } catch (error) {
 163     // A refused transition still reports the operation's current status
 164     // (e.g. `released` refused because the dispatch mark committed).
 165     if (error instanceof MeetingNoteDbError && error.token === 'MEETING_NOTE_AI_OPERATION_INVALID_TRANSITION') {
 166       const status = error.detail?.status;
 167       if (typeof status === 'string') {
 168         return { status: status as MeetingNoteAiOperationStatus, recorded: false };
 169       }
 170     }
 171     logEvent('meeting_notes_ai_settle_failed', {
 172       correlationId: ctx.correlationId,
 173       operationId,
 174       outcome,
 175       sqlstate: error instanceof MeetingNoteDbError ? error.sqlstate : undefined,
 176     });
 177     return { status: null, recorded: false };
 178   }
 179 }
