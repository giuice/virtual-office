   4 // reject each suggested action item, then "Apply" (one version; the summary
   5 // replaces the note's summary, accepted items are appended; existing items
   6 // are never changed) or "Discard draft". Apply is checked by the route
   7 // against the draft's source revision: when the note changed since (edited,
   8 // or its transcript replaced) the draft cannot be applied and a reprocess is
   9 // offered. Nothing here is stored before Apply; AI text is shown as text only.
  10 'use client';
  11 
  12 import { AlertTriangle, Check, Loader2, RefreshCw, Trash2 } from 'lucide-react';
  13 import { useEffect, useId, useRef } from 'react';
  14 
  15 import { Button } from '@/components/ui/button';
  16 import {
  17   meetingNoteAiApplyInput,
  18   type MeetingNoteAiEditableDraft,
  19   type MeetingNoteAiEditableSuggestion,
  20 } from '@/hooks/ui/useMeetingNoteAiFlow';
  21 import { codePointLength, MEETING_NOTE_AI_SUMMARY_LIMITS, MEETING_NOTE_LIMITS } from 
'@/lib/meeting-notes/validation';
  22 import type { User } from '@/types/database';
  23 import type { MeetingNoteAiDraftSummary } from '@/types/meeting-notes';
  24 import { isMeetingNoteAiSuggestionValid, MeetingNoteAiSuggestionRow } from './MeetingNoteAiSuggestionRow';
  25 import { MeetingNoteAiSummaryEditor } from './MeetingNoteAiSummaryEditor';
  26 
  27 export interface MeetingNoteAiReviewProps {
  28   draft: MeetingNoteAiEditableDraft;
  29   /** The note's current revision and item count as last read. */
  30   noteRevision: number;
  31   existingItemCount: number;
  32   members: readonly User[];
  33   applying: boolean;
  34   applyError: string | null;
  35   conflict: boolean;
  36   onChange: (update: (draft: MeetingNoteAiEditableDraft) => MeetingNoteAiEditableDraft) => void;
  37   onApply: () => void;
  38   onDiscard: () => void;
  39   onReprocess: () => void;
  40 }
  41 
  42 const SECTIONS: ReadonlyArray<[keyof MeetingNoteAiDraftSummary, string]> = [
  43   ['keyPoints', 'Key points'],
  44   ['decisions', 'Decisions'],
  45   ['nextSteps', 'Next steps'],
  46 ];
  47 
  48 function summaryValid(summary: MeetingNoteAiDraftSummary): boolean {
  49   return SECTIONS.every(([key]) => {
  50     const entries = summary[key];
  51     return (
  52       entries.length <= MEETING_NOTE_AI_SUMMARY_LIMITS.maxEntriesPerSection &&
  53       entries.every((entry) => codePointLength(entry) <= MEETING_NOTE_AI_SUMMARY_LIMITS.maxEntryChars)
  54     );
  55   });
  56 }
  57 
  58 export function MeetingNoteAiReview({
  59   draft,
  60   noteRevision,
  61   existingItemCount,
  62   members,
  63   applying,
  64   applyError,
  65   conflict,
  66   onChange,
  67   onApply,
  68   onDiscard,
  69   onReprocess,
  70 }: MeetingNoteAiReviewProps) {
  71   const headingId = useId();
  72   const headingRef = useRef<HTMLHeadingElement>(null);
  73 
  74   useEffect(() => {
  75     headingRef.current?.focus();
  76   }, []);
  77 
  78   const input = meetingNoteAiApplyInput(draft);
  79   const accepted = draft.items.filter((item) => item.accepted && !item.rejected);
  80   const keepsSummary = SECTIONS.every(([key]) => input.summary[key].length === 0);
  81   const itemsValid = accepted.every(isMeetingNoteAiSuggestionValid);
  82   const nothingToApply = keepsSummary && accepted.length === 0;
  83   // The cached note moved past the draft's source: the route will refuse Apply.
  84   const sourceChanged = conflict || noteRevision !== draft.sourceRevision;
  85   const overCapacity = existingItemCount + accepted.length > MEETING_NOTE_LIMITS.maxItemsPerNote;
  86   const canApply = !applying && !sourceChanged && !nothingToApply && itemsValid && summaryValid(draft.summary);
  87 
  88   const setSummary = (key: keyof MeetingNoteAiDraftSummary, entries: string[]) =>
  89     onChange((current) => ({ ...current, summary: { ...current.summary, [key]: entries } }));
  90   const setItem = (next: MeetingNoteAiEditableSuggestion) =>
  91     onChange((current) => ({
  92       ...current,
  93       items: current.items.map((item) => (item.key === next.key ? next : item)),
  94     }));
  95 
  96   return (
  97     <div
  98       className="flex flex-col gap-5 rounded-lg border border-[var(--vo-line-soft)] p-4"
  99       role="region"
 100       aria-labelledby={headingId}
 101       aria-busy={applying}
 102       data-testid="meeting-note-ai-review"
 103       data-source-revision={draft.sourceRevision}
 104     >
 105       <div className="flex flex-col gap-1">
 106         <h4 id={headingId} ref={headingRef} tabIndex={-1} className="text-sm font-semibold outline-none">
 107           Review the AI draft
 108         </h4>
 109         <p className="text-xs text-muted-foreground">
 110           Nothing is saved until you apply. The summary replaces the note&apos;s summary; accepted action items 
are
 111           added to the note. Existing action items are never changed.
 112           {draft.usage ? ` AI processings today: ${draft.usage.used} of ${draft.usage.limit}.` : ''}
 113         </p>
 114       </div>
 115 
 116       {sourceChanged ? (
 117         <div
 118           className="flex flex-col gap-2 rounded-md border border-destructive/40 bg-destructive/10 px-3 py-2 
text-sm"
 119           role="alert"
 120           data-testid="meeting-note-ai-conflict"
 121         >
 122           <p className="flex items-start gap-2">
 123             <AlertTriangle className="mt-0.5 size-4 shrink-0" aria-hidden="true" />
 124             The note changed since this draft was generated (it was edited or its transcript was replaced), so 
this
 125             draft can no longer be applied. Reprocess the current transcript to get a new draft.
 126           </p>
 127           <div className="flex flex-wrap gap-2">
 128             <Button type="button" size="sm" className="gap-1.5" onClick={onReprocess} 
data-testid="meeting-note-ai-reprocess">
 129               <RefreshCw className="size-4" aria-hidden="true" />
 130               Reprocess
 131             </Button>
 132           </div>
 133         </div>
 134       ) : null}
 135 
 136       <section className="flex flex-col gap-4" aria-label="Draft summary">
 137         <h5 className="text-xs font-bold uppercase tracking-[0.12em] text-muted-foreground">Summary</h5>
 138         {SECTIONS.map(([key, title]) => (
 139           <MeetingNoteAiSummaryEditor
 140             key={key}
 141             section={key}
 142             title={title}
 143             entries={draft.summary[key]}
 144             disabled={applying}
 145             onChange={(entries) => setSummary(key, entries)}
 146           />
 147         ))}
 148         {keepsSummary ? (
 149           <p className="text-xs text-muted-foreground" data-testid="meeting-note-ai-keeps-summary">
 150             All summary sections are empty: the note&apos;s current summary will be kept.
 151           </p>
 152         ) : null}
 153       </section>
 154 
 155       <section className="flex flex-col gap-3" aria-label="Suggested action items">
 156         <h5 className="text-xs font-bold uppercase tracking-[0.12em] text-muted-foreground">
 157           Suggested action items ({accepted.length} of {draft.items.length} accepted)
 158         </h5>
 159         {draft.items.length === 0 ? (
 160           <p className="text-sm text-muted-foreground">No action items were suggested.</p>
 161         ) : (
 162           <ul className="flex flex-col gap-3" aria-label="Suggested action items">
 163             {draft.items.map((item, index) => (
 164               <MeetingNoteAiSuggestionRow
 165                 key={item.key}
 166                 suggestion={item}
 167                 index={index}
 168                 members={members}
 169                 disabled={applying}
 170                 onChange={setItem}
 171               />
 172             ))}
 173           </ul>
 174         )}
 175         {overCapacity ? (
 176           <p className="text-xs text-destructive" role="status" data-testid="meeting-note-ai-capacity">
 177             {MEETING_NOTE_LIMITS.maxItemsPerNote} items maximum: this note has {existingItemCount} action items, 
so
 178             accepting {accepted.length} would exceed the limit and nothing would be applied.
 179           </p>
 180         ) : null}
 181       </section>
 182 
 183       {applyError ? (
 184         <p className="text-sm text-destructive" role="alert" data-testid="meeting-note-ai-apply-error">
 185           {applyError}
 186         </p>
 187       ) : null}
 188       {nothingToApply && !sourceChanged ? (
 189         <p className="text-xs text-muted-foreground" role="status">
 190           Nothing to apply: keep a summary entry or accept at least one action item.
 191         </p>
 192       ) : null}
 193 
 194       <div className="flex flex-wrap items-center gap-2">
 195         <Button type="button" size="sm" className="gap-1.5" disabled={!canApply} onClick={onApply} 
data-testid="meeting-note-ai-apply">
 196           {applying ? <Loader2 className="size-4 animate-spin" aria-hidden="true" /> : <Check className="size-4" 
aria-hidden="true" />}
 197           {applying ? 'Applying…' : 'Apply'}
 198         </Button>
 199         <Button
 200           type="button"
 201           size="sm"
 202           variant="ghost"
 203           className="gap-1.5"
 204           disabled={applying}
 205           onClick={onDiscard}
 206           data-testid="meeting-note-ai-discard"
 207         >
 208           <Trash2 className="size-4" aria-hidden="true" />
 209           Discard draft
 210         </Button>
 211       </div>
 212     </div>
 213   );
 214 }
