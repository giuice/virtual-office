   1 // src/hooks/queries/useMeetingNote.ts
   2 // One meeting note's reads (Phase 6 FR-005, FR-009): the note view, its stored
   3 // transcript, its version list, and one version. Keys sit under
   4 // meetingNoteQueryKeys.scope(users.id, company.id), so a cached note of one
   5 // account or company is never shown to another and every note mutation's
   6 // scope invalidation refreshes them.
   7 'use client';
   8 
   9 import { useQuery } from '@tanstack/react-query';
  10 
  11 import { meetingNoteQueryKeys, useMeetingNotesScope } from '@/hooks/queries/useMeetingNotes';
  12 import {
  13   fetchMeetingNoteDetail,
  14   fetchMeetingNoteVersion,
  15   fetchMeetingNoteVersions,
  16   shouldRetryMeetingNotesRequest,
  17 } from '@/lib/meeting-notes/client-api';
  18 
  19 /** The note view; 404 means missing or not visible (another company). */
  20 export function useMeetingNoteDetail(noteId: string, enabled = true) {
  21   const scope = useMeetingNotesScope();
  22   return useQuery({
  23     queryKey: meetingNoteQueryKeys.note(scope?.userId ?? '', scope?.companyId ?? '', noteId),
  24     enabled: enabled && scope !== null && noteId.length > 0,
  25     queryFn: ({ signal }) => fetchMeetingNoteDetail(noteId, {}, signal),
  26     staleTime: 15_000,
  27     retry: shouldRetryMeetingNotesRequest,
  28   });
  29 }
  30 
  31 /** The stored transcript text (up to 1 MB), loaded only when asked for. */
  32 export function useMeetingNoteTranscript(noteId: string, transcriptId: string | null, enabled: boolean) {
  33   const scope = useMeetingNotesScope();
  34   return useQuery({
  35     queryKey: [...meetingNoteQueryKeys.noteTranscript(scope?.userId ?? '', scope?.companyId ?? '', noteId), 
transcriptId],
  36     enabled: enabled && scope !== null && noteId.length > 0 && transcriptId !== null,
  37     queryFn: async ({ signal }) => {
  38       const note = await fetchMeetingNoteDetail(noteId, { includeTranscript: true }, signal);
  39       return note.transcript ?? null;
  40     },
  41     staleTime: 60_000,
  42     retry: shouldRetryMeetingNotesRequest,
  43   });
  44 }
  45 
  46 /** The note's versions, newest first, with the note's current revision. */
  47 export function useMeetingNoteVersions(noteId: string, enabled: boolean) {
  48   const scope = useMeetingNotesScope();
  49   return useQuery({
  50     queryKey: meetingNoteQueryKeys.versions(scope?.userId ?? '', scope?.companyId ?? '', noteId),
  51     enabled: enabled && scope !== null && noteId.length > 0,
  52     queryFn: ({ signal }) => fetchMeetingNoteVersions(noteId, signal),
  53     staleTime: 15_000,
  54     retry: shouldRetryMeetingNotesRequest,
  55   });
  56 }
  57 
  58 /** One immutable version (never changes once written, so it stays cached). */
  59 export function useMeetingNoteVersion(noteId: string, versionId: string | null) {
  60   const scope = useMeetingNotesScope();
  61   return useQuery({
  62     queryKey: meetingNoteQueryKeys.version(scope?.userId ?? '', scope?.companyId ?? '', noteId, versionId ?? ''),
  63     enabled: scope !== null && noteId.length > 0 && versionId !== null,
  64     queryFn: ({ signal }) => fetchMeetingNoteVersion(noteId, versionId ?? '', signal),
  65     staleTime: Infinity,
  66     retry: shouldRetryMeetingNotesRequest,
  67   });
  68 }
