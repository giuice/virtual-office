  39       participants: base.participants,
  40       content: base.content,
  41     }),
  42     [base]
  43   );
  44   const backupText = useMemo(
  45     () => (backup ? `${backup.title}\n\n${meetingNoteHtmlToText(backup.content)}`.trim() : ''),
  46     [backup]
  47   );
  48 
  49   const submit = (fields: MeetingNoteFieldsPayload) => {
  50     setPending(fields);
  51     update.mutate(
  52       { noteId: base.id, expectedRevision: base.revision, fields },
  53       {
  54         onSuccess: (saved) => onSaved(saved),
  55         onError: (error) => {
  56           if (error instanceof MeetingNoteConflictError) {
  57             setConflict(error);
