  66     participantsLabel: useId(),
  67     participantsError: useId(),
  68     contentLabel: useId(),
  69     contentError: useId(),
  70     editor: useId(),
  71   };
  72   const { company, companyUsers } = useCompany();
  73   const members = useMemo(
  74     () => companyUsers.filter((user) => company !== null && user.companyId === company.id),
  75     [company, companyUsers]
  76   );
  77 
  78   const initialDay = useMemo(() => (initial.meetingDate ? localDayOf(initial.meetingDate) : todayLocalDay()), 
[initial.meetingDate]);
  79   const [title, setTitle] = useState(initial.title);
  80   const [day, setDay] = useState(initialDay);
