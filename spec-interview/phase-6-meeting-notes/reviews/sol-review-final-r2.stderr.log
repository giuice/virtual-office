 167 export function useApplyMeetingNoteAiDraft() {
 168   const queryClient = useQueryClient();
 169   return useMeetingNotesScopedMutation<MeetingNoteAiApplyResponse, ApplyMeetingNoteAiDraftVariables>({
 170     name: 'ai-apply',
 171     gcTime: 0,
 172     mutationFn: ({ noteId, input }, { signal }) => applyMeetingNoteAiDraft(noteId, input, signal),
 173     onSuccess: ({ note }, _variables, scope) => settleMeetingNoteCache(queryClient, scope, note),
 174     onError: (error, { noteId }, scope) => {
 175       settleMeetingNoteConflictCache(queryClient, scope, error);
 176       if (error instanceof MeetingNotesApiError && (error.status === 404 || error.status === 403)) {
 177         void queryClient.invalidateQueries({ queryKey: meetingNoteQueryKeys.noteRoot(scope.userId, 
scope.companyId, noteId) });
 178       }
 179     },
