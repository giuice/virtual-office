 143 export function useProcessMeetingNoteAi() {
 144   const queryClient = useQueryClient();
 145   return useMeetingNotesScopedMutation<ProcessMeetingNoteAiResult, ProcessMeetingNoteAiVariables>({
 146     name: 'ai-process',
 147     abortOnUnmount: true,
 148     gcTime: 0,
 149     mutationFn: async ({ noteId, ticket, cancelSignal }, { scope, signal }) => {
 150       const requestSignal = eitherSignal(signal, cancelSignal);
 151       const response = await processMeetingNoteAiDraft(noteId, ticket, requestSignal);
 152       const confirmedNote = response.draft !== null ? await confirmDraftAccess(noteId, scope, requestSignal) : 
null;
 153       return { ...response, confirmedNote };
 154     },
 155     onSuccess: ({ confirmedNote }, _variables, scope) => {
 156       if (confirmedNote) storeConfirmedNote(queryClient, scope, confirmedNote);
 157     },
 158     onError: (error, { noteId }, scope) => refreshAfterAiError(queryClient, scope, noteId, error),
 159   });
 160 }
