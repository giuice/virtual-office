  95       {backup ? (
  96         <section
  97           aria-labelledby="meeting-note-backup-heading"
  98           className="flex flex-col gap-2 rounded-md border border-[var(--vo-line-soft)] bg-[var(--vo-bg-2)] p-3"
  99           data-testid="meeting-note-unsaved-backup"
 100         >
 101           <div className="flex items-center justify-between gap-2">
 102             <h3 id="meeting-note-backup-heading" className="text-sm font-semibold">
 103               Your earlier unsaved text
 104             </h3>
 105             <Button type="button" size="sm" variant="ghost" onClick={() => setBackup(null)}>
 106               Dismiss
 107             </Button>
 108           </div>
 109           <p className="text-xs text-muted-foreground">
 110             The form now shows the newer version. Copy anything you still need from here.
 111           </p>
 112           <textarea
 113             readOnly
 114             aria-labelledby="meeting-note-backup-heading"
 115             className="min-h-24 w-full resize-y rounded-md border border-input bg-background p-2 text-sm 
focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
 116             value={backupText}
 117           />
 118         </section>
 119       ) : null}
 120 
 121       <MeetingNoteForm
 122         // Remount on a new base so every field shows the newer version.
 123         key={`${base.id}:${base.revision}`}
 124         initial={initial}
 125         submitLabel="Save changes"
 126         submitting={update.isPending}
 127         submitError={formError}
 128         onSubmit={submit}
 129         onCancel={onCancel}
 130       />
 131 
 132       {conflict ? (
 133         <MeetingNoteConflictDialog
 134           open={conflictOpen}
 135           onOpenChange={setConflictOpen}
 136           newer={conflict.note}
 137           mine={pending}
 138           onLoadNewer={loadNewer}
 139         />
 140       ) : null}
 141     </div>
 142   );
 143 }
