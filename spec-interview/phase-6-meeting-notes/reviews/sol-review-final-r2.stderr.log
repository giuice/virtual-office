   1 // src/hooks/ui/useMeetingNoteAiFlow.ts
   2 // State of the note view's AI flow (Phase 6 T13; SPEC J5/J6, FR-015,
   3 // FR-018, FR-019, FR-021, FR-023): idle → provider notice (ticket) →
   4 // processing (cancellable) → review of the transient draft → Apply, with
   5 // errors offering "Try again" (a NEW ticket, i.e. a new operation).
   6 //
   7 // The draft lives only in this hook's React state: never persisted, never
   8 // in a query cache. The hook is used by the note view body, which is keyed by
   9 // the signed-in scope (users.id + company) and the note id, so a scope change
  10 // (sign-out, account switch, removal, company change) or another note mounts
  11 // a fresh flow and the previous draft is gone; the draft also records the
  12 // scope and note it belongs to and is dropped if they ever differ. Requests
  13 // run through the scope fence (late answers of a retired scope run no
  14 // callback), and every callback also checks that it belongs to the flow's
  15 // latest attempt, so a Cancel or Discard is never overridden by a late answer.
  16 // A draft response reaches this hook only after the processing mutation
  17 // re-checked, with the user's session, that they still edit the note in the
  18 // same company (useProcessMeetingNoteAi); lost access arrives as an error.
  19 // Leaving the page aborts pending requests (FR-021).
  20 'use client';
  21 
  22 import { useCallback, useEffect, useRef, useState } from 'react';
  23 
  24 import {
  25   useApplyMeetingNoteAiDraft,
  26   useMeetingNoteAiTicket,
  27   useProcessMeetingNoteAi,
  28 } from '@/hooks/mutations/useMeetingNoteAiMutations';
  29 import { useMeetingNotesScope } from '@/hooks/queries/useMeetingNotes';
  30 import { useNotification } from '@/hooks/useNotification';
  31 import {
  32   classifyMeetingNoteAiApplyError,
  33   classifyMeetingNoteAiError,
  34   type MeetingNoteAiFlowError,
  35 } from '@/lib/meeting-notes/ai/client-flow-errors';
  36 import { meetingNotesScopeKey } from '@/lib/meeting-notes/scope-fence';
  37 import type {
  38   MeetingNoteAiApplyInput,
  39   MeetingNoteAiDraftSummary,
  40   MeetingNoteAiProcessResponse,
  41   MeetingNoteAiTicketResponse,
  42   MeetingNoteAiUsage,
  43 } from '@/types/meeting-notes';
  44 
  45 /** One suggested action item while it is being reviewed. */
  46 export interface MeetingNoteAiEditableSuggestion {
  47   /** Stable React key within the draft. */
  48   key: string;
  49   description: string;
  50   /** users.id of a current member, or null (unassigned). */
  51   assigneeId: string | null;
  52   /** 'YYYY-MM-DD' or '' (none): a calendar date, never converted through Date. */
  53   dueDate: string;
  54   accepted: boolean;
  55   rejected: boolean;
  56   suggestedAssigneeName: string | null;
  57   resolvedAssignee: { userId: string; displayName: string } | null;
  58   duplicateOfItemId: string | null;
  59 }
  60 
  61 /** The transient draft under review (FR-018). */
  62 export interface MeetingNoteAiEditableDraft {
  63   /** Scope (users.id:company.id) and note it was generated for. */
  64   scopeKey: string;
  65   noteId: string;
  66   operationId: string;
  67   /** Note revision and transcript identity at generation start: Apply's expectedRevision. */
  68   sourceRevision: number;
  69   transcriptId: string;
  70   summary: MeetingNoteAiDraftSummary;
  71   items: MeetingNoteAiEditableSuggestion[];
  72   usage: MeetingNoteAiUsage | null;
  73 }
  74 
  75 /** Why the notice is shown again. */
  76 export type MeetingNoteAiNoticeBanner =
  77   | { kind: 'settings_changed'; providerLabel: string | null }
  78   | { kind: 'expired' };
  79 
  80 export type MeetingNoteAiFlowState =
  81   | { phase: 'idle'; message: string | null }
  82   | { phase: 'preparing'; banner: MeetingNoteAiNoticeBanner | null }
  83   | { phase: 'notice'; ticket: MeetingNoteAiTicketResponse; banner: MeetingNoteAiNoticeBanner | null }
  84   | { phase: 'processing'; ticket: MeetingNoteAiTicketResponse }
  85   | { phase: 'error'; error: MeetingNoteAiFlowError }
  86   | {
  87       phase: 'review';
  88       draft: MeetingNoteAiEditableDraft;
  89       applying: boolean;
  90       applyError: string | null;
  91       /** Apply was refused because the note changed since the draft's source (FR-007). */
  92       conflict: boolean;
  93     };
  94 
  95 export interface MeetingNoteAiFlow {
  96   state: MeetingNoteAiFlowState;
  97   /** Fetches a ticket and shows the provider notice ("Generate summary", "Reprocess", "Try again"). */
  98   start: () => void;
  99   /** "Process": starts the notice's operation. */
 100   confirm: () => void;
 101   /** Cancels a running processing (aborts the request). */
 102   cancel: () => void;
 103   /** Closes the notice or an error without processing. */
 104   close: () => void;
 105   /** Drops the draft. */
 106   discard: () => void;
 107   /** Applies the reviewed draft. */
 108   apply: () => void;
 109   updateDraft: (update: (draft: MeetingNoteAiEditableDraft) => MeetingNoteAiEditableDraft) => void;
 110 }
 111 
 112 const IDLE: MeetingNoteAiFlowState = { phase: 'idle', message: null };
 113 
 114 function toEditableDraft(
 115   response: MeetingNoteAiProcessResponse,
 116   scopeKey: string,
 117   noteId: string
 118 ): MeetingNoteAiEditableDraft | null {
 119   if (!response.draft || response.replay || response.status !== 'succeeded') return null;
 120   return {
 121     scopeKey,
 122     noteId,
 123     operationId: response.operationId,
 124     sourceRevision: response.sourceRevision,
 125     transcriptId: response.transcriptId,
 126     summary: {
 127       keyPoints: [...response.draft.summary.keyPoints],
 128       decisions: [...response.draft.summary.decisions],
 129       nextSteps: [...response.draft.summary.nextSteps],
 130     },
 131     items: response.draft.items.map((item, index) => ({
 132       key: `${response.operationId}:${index}`,
 133       description: item.description,
 134       assigneeId: item.resolvedAssignee?.userId ?? null,
 135       dueDate: '',
 136       // FR-018: a suggestion that repeats an existing item arrives unchecked.
 137       accepted: item.duplicateOfItemId === null,
 138       rejected: false,
 139       suggestedAssigneeName: item.suggestedAssigneeName,
 140       resolvedAssignee: item.resolvedAssignee,
 141       duplicateOfItemId: item.duplicateOfItemId,
 142     })),
 143     usage: response.usage,
 144   };
 145 }
 146 
 147 /** The accepted, non-rejected items and the trimmed summary, as Apply takes them. */
 148 export function meetingNoteAiApplyInput(draft: MeetingNoteAiEditableDraft): MeetingNoteAiApplyInput {
 149   const clean = (entries: string[]) => entries.map((entry) => entry.trim()).filter((entry) => entry.length > 0);
 150   return {
 151     expectedRevision: draft.sourceRevision,
 152     summary: {
 153       keyPoints: clean(draft.summary.keyPoints),
 154       decisions: clean(draft.summary.decisions),
 155       nextSteps: clean(draft.summary.nextSteps),
 156     },
 157     items: draft.items
 158       .filter((item) => item.accepted && !item.rejected)
 159       .map((item) => ({
 160         description: item.description.trim(),
 161         assigneeId: item.assigneeId,
 162         dueDate: item.dueDate === '' ? null : item.dueDate,
 163       })),
 164   };
 165 }
 166 
 167 export function useMeetingNoteAiFlow(noteId: string): MeetingNoteAiFlow {
 168   const scope = useMeetingNotesScope();
 169   const scopeKey = scope ? meetingNotesScopeKey(scope) : null;
 170   const { showSuccess } = useNotification();
 171   const ticketRequest = useMeetingNoteAiTicket();
 172   const processRequest = useProcessMeetingNoteAi();
 173   const applyRequest = useApplyMeetingNoteAiDraft();
 174   const [state, setState] = useState<MeetingNoteAiFlowState>(IDLE);
 175 
 176   // Every request belongs to one attempt; any newer action makes older answers moot.
 177   const attempt = useRef(0);
 178   const cancelController = useRef<AbortController | null>(null);
 179 
 180   const abortProcessing = useCallback(() => {
 181     cancelController.current?.abort();
 182     cancelController.current = null;
 183   }, []);
 184 
 185   // Leaving the page cancels the processing request (FR-021).
 186   useEffect(() => abortProcessing, [abortProcessing]);
 187 
 188   const { mutate: requestTicket, reset: resetTicket } = ticketRequest;
 189   const { mutate: requestProcess, reset: resetProcess } = processRequest;
 190   const { mutate: requestApply, reset: resetApply } = applyRequest;
 191 
 192   const fail = useCallback((error: MeetingNoteAiFlowError) => {
 193     setState(error.kind === 'cancelled' ? { phase: 'idle', message: 'Processing was cancelled.' } : { phase: 
'error', error });
 194   }, []);
 195 
 196   const openNotice = useCallback(
 197     (banner: MeetingNoteAiNoticeBanner | null) => {
 198       abortProcessing();
 199       const mine = ++attempt.current;
 200       setState({ phase: 'preparing', banner });
 201       requestTicket(
 202         { noteId },
 203         {
 204           onSuccess: (ticket) => {
 205             if (attempt.current !== mine) return;
 206             resetTicket();
 207             setState({ phase: 'notice', ticket, banner });
 208           },
 209           onError: (error) => {
 210             if (attempt.current !== mine) return;
 211             fail(classifyMeetingNoteAiError(error));
 212           },
 213         }
 214       );
 215     },
 216     [abortProcessing, fail, noteId, requestTicket, resetTicket]
 217   );
 218 
 219   const start = useCallback(() => openNotice(null), [openNotice]);
 220 
 221   const confirm = useCallback(() => {
 222     if (state.phase !== 'notice' || !scopeKey) return;
 223     const { ticket } = state;
 224     // FR-015/FR-031: a notice older than its ticket's 24 hours is shown again.
 225     if (Date.parse(ticket.expiresAt) <= Date.now()) {
 226       openNotice({ kind: 'expired' });
 227       return;
 228     }
 229     abortProcessing();
 230     const controller = new AbortController();
 231     cancelController.current = controller;
 232     const mine = ++attempt.current;
 233     const draftScope = scopeKey;
 234     setState({ phase: 'processing', ticket });
 235     requestProcess(
 236       { noteId, ticket: ticket.ticket, cancelSignal: controller.signal },
 237       {
 238         onSuccess: (response) => {
 239           if (attempt.current !== mine || controller.signal.aborted) return;
 240           cancelController.current = null;
 241           resetProcess();
 242           const draft = toEditableDraft(response, draftScope, noteId);
 243           if (!draft) {
 244             fail({ kind: 'failed', message: 'This processing ended without a draft. Try again.', retryable: true 
});
 245             return;
 246           }
 247           setState({ phase: 'review', draft, applying: false, applyError: null, conflict: false });
 248         },
 249         onError: (error) => {
 250           if (attempt.current !== mine) return;
 251           cancelController.current = null;
 252           const classified = classifyMeetingNoteAiError(error);
 253           if (classified.kind === 'settings_stale') {
 254             openNotice({ kind: 'settings_changed', providerLabel: classified.providerLabel });
 255           } else if (classified.kind === 'ticket_expired') {
 256             openNotice({ kind: 'expired' });
 257           } else {
 258             fail(classified);
 259           }
 260         },
 261       }
 262     );
 263   }, [abortProcessing, fail, noteId, openNotice, requestProcess, resetProcess, scopeKey, state]);
 264 
 265   const cancel = useCallback(() => {
 266     attempt.current += 1;
 267     abortProcessing();
 268     resetProcess();
 269     setState({ phase: 'idle', message: 'Processing was cancelled.' });
 270   }, [abortProcessing, resetProcess]);
 271 
 272   const close = useCallback(() => {
 273     attempt.current += 1;
 274     abortProcessing();
 275     resetTicket();
 276     setState(IDLE);
 277   }, [abortProcessing, resetTicket]);
 278 
 279   const discard = useCallback(() => {
 280     attempt.current += 1;
 281     resetProcess();
 282     resetApply();
 283     setState(IDLE);
 284   }, [resetApply, resetProcess]);
 285 
 286   const updateDraft = useCallback((update: (draft: MeetingNoteAiEditableDraft) => MeetingNoteAiEditableDraft) => {
 287     setState((current) => (current.phase === 'review' ? { ...current, draft: update(current.draft), applyError: 
null } : current));
 288   }, []);
 289 
 290   const apply = useCallback(() => {
 291     if (state.phase !== 'review' || state.applying || state.conflict) return;
 292     const { draft } = state;
 293     const mine = ++attempt.current;
 294     setState({ ...state, applying: true, applyError: null });
 295     requestApply(
 296       { noteId, input: meetingNoteAiApplyInput(draft) },
 297       {
 298         onSuccess: () => {
 299           if (attempt.current !== mine) return;
 300           resetApply();
 301           resetProcess();
 302           setState({ phase: 'idle', message: null });
 303           showSuccess({ description: 'Draft applied to the note.' });
 304         },
 305         onError: (error) => {
 306           if (attempt.current !== mine) return;
 307           const failure = classifyMeetingNoteAiApplyError(error);
 308           if (failure.kind === 'access_lost') {
 309             setState({ phase: 'error', error: { kind: 'access_lost' } });
 310             return;
 311           }
 312           setState((current) =>
 313             current.phase === 'review'
 314               ? {
 315                   ...current,
 316                   applying: false,
 317                   conflict: failure.kind === 'conflict',
 318                   applyError: failure.kind === 'conflict' ? null : failure.message,
 319                 }
 320               : current
 321           );
 322         },
 323       }
 324     );
 325   }, [noteId, requestApply, resetApply, resetProcess, showSuccess, state]);
 326 
 327   // A draft of another scope or note is never shown (defence in depth: the
 328   // view is keyed by both, so this does not happen in normal use).
 329   const visible: MeetingNoteAiFlowState =
 330     state.phase === 'review' && (state.draft.scopeKey !== scopeKey || state.draft.noteId !== noteId) ? IDLE : 
state;
 331 
 332   return { state: visible, start, confirm, cancel, close, discard, apply, updateDraft };
 333 }

