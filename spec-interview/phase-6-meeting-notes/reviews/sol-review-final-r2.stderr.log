   7 'use client';
   8 
   9 import { Loader2 } from 'lucide-react';
  10 import { useId, useMemo, useRef, useState, type FormEvent, type ReactNode } from 'react';
  11 
  12 import { Button } from '@/components/ui/button';
  13 import { Input } from '@/components/ui/input';
  14 import { Label } from '@/components/ui/label';
  15 import { useCompany } from '@/contexts/CompanyContext';
  16 import type { MeetingNoteFieldsPayload } from '@/lib/meeting-notes/client-api';
  17 import { sanitizeMeetingNoteHtml } from '@/lib/meeting-notes/content-sanitizer';
  18 import { describeMeetingNoteError, meetingNoteFieldError, type MeetingNoteFormField } from 
'@/lib/meeting-notes/form-errors';
  19 import { localDayOf, meetingDateFromLocalDay } from '@/lib/meeting-notes/period';
  20 import { codePointLength, MEETING_NOTE_LIMITS } from '@/lib/meeting-notes/validation';
  21 import type { MeetingNoteParticipant } from '@/types/meeting-notes';
  22 import { MeetingNoteParticipantPicker } from './MeetingNoteParticipantPicker';
  23 import { MeetingNoteRichTextEditorLazy } from './MeetingNoteRichTextEditorLazy';
  24 
  25 export interface MeetingNoteFormInitialValues {
  26   title: string;
  27   /** ISO instant; null = today. */
  28   meetingDate: string | null;
  29   participants: MeetingNoteParticipant[];
  30   /** Saved (sanitized) HTML. */
  31   content: string;
  32 }
  33 
  34 export interface MeetingNoteFormProps {
  35   initial: MeetingNoteFormInitialValues;
  36   submitLabel: string;
  37   submitting: boolean;
  38   /** The last failed save, shown next to its field or above the buttons. */
  39   submitError: unknown;
  40   onSubmit: (fields: MeetingNoteFieldsPayload) => void;
  41   onCancel: () => void;
  42   /** Shown above the fields (e.g. the space the note belongs to). */
  43   header?: ReactNode;
  44 }
  45 
  46 type FieldErrors = Partial<Record<MeetingNoteFormField, string>>;
  47 
  48 function todayLocalDay(): string {
  49   return localDayOf(new Date().toISOString());
