   1 // src/hooks/mutations/useMeetingNotesScopedMutation.ts
   2 // The one mutation shape of the meeting-notes client layer (Phase 6 FR-021
   3 // browser clause; block B review B-2). Each call records the scope (users.id
   4 // + company id) it started in as its onMutate result and mutationKey prefix,
   5 // and runs its request with an AbortSignal registered under that scope. When
   6 // the scope retires (useMeetingNotesScopeLifecycle) the request is aborted,
   7 // the mutation leaves the MutationCache, and every callback of the call — the
   8 // hook's and the caller's — is skipped, so a late response never downloads a
   9 // file, writes the cache, or shows a toast in another account's session.
  10 // Mutations always run (networkMode 'always'): offline, the request fails at
  11 // once with a network error the UI shows, instead of waiting paused.
  12 'use client';
  13 
  14 import { useMutation, type MutateOptions, type UseMutationResult } from '@tanstack/react-query';
  15 import { useCallback, useEffect, useRef } from 'react';
  16 
  17 import { meetingNoteQueryKeys, useMeetingNotesScope } from '@/hooks/queries/useMeetingNotes';
  18 import { MeetingNotesApiError } from '@/lib/meeting-notes/client-api';
  19 import {
  20   isCurrentMeetingNotesOrigin,
  21   isCurrentMeetingNotesScope,
  22   openMeetingNotesRequest,
  23   releaseMeetingNotesRequest,
  24   type MeetingNotesMutationOrigin,
  25   type MeetingNotesScope,
  26 } from '@/lib/meeting-notes/scope-fence';
  27 
  28 export interface MeetingNotesRequestContext {
  29   scope: MeetingNotesScope;
  30   /** Aborted when the scope retires (and on unmount with `abortOnUnmount`). */
  31   signal: AbortSignal;
  32 }
  33 
  34 export interface MeetingNotesScopedMutationOptions<TData, TVariables> {
  35   /** Names the mutation inside its scope's mutationKey. */
  36   name: string;
  37   mutationFn: (variables: TVariables, request: MeetingNotesRequestContext) => Promise<TData>;
  38   /** Runs only while the call's scope is still the signed-in one. */
  39   onSuccess?: (data: TData, variables: TVariables, scope: MeetingNotesScope) => void;
  40   /** Runs only while the call's scope is still the signed-in one. */
  41   onError?: (error: Error, variables: TVariables, scope: MeetingNotesScope) => void;
  42   /** Abort the request when the calling component unmounts (e.g. a download). */
  43   abortOnUnmount?: boolean;
  44   /** How long a settled call stays in the MutationCache once unobserved. */
  45   gcTime?: number;
  46 }
  47 
  48 export type MeetingNotesMutateOptions<TData, TVariables> = MutateOptions<
  49   TData,
  50   Error,
  51   TVariables,
  52   MeetingNotesMutationOrigin
  53 >;
  54 
  55 export type MeetingNotesScopedMutationResult<TData, TVariables> = Omit<
  56   UseMutationResult<TData, Error, TVariables, MeetingNotesMutationOrigin>,
  57   'mutate' | 'mutateAsync'
  58 > & {
  59   mutate: (variables: TVariables, options?: MeetingNotesMutateOptions<TData, TVariables>) => void;
  60 };
  61 
  62 function noSession(): MeetingNotesApiError {
  63   return new MeetingNotesApiError(401, 'NO_SESSION', 'Your session is not ready. Reload the page and try again.');
  64 }
  65 
  66 /** The caller's callbacks, each skipped once the call's scope is no longer current. */
  67 function fenceCallbacks<TData, TVariables>(
  68   options: MeetingNotesMutateOptions<TData, TVariables> | undefined
  69 ): MeetingNotesMutateOptions<TData, TVariables> | undefined {
  70   if (!options) return undefined;
  71   const { onSuccess, onError, onSettled } = options;
  72   return {
  73     onSuccess: onSuccess
  74       ? (data, variables, origin, context) => {
  75           if (isCurrentMeetingNotesOrigin(origin)) onSuccess(data, variables, origin, context);
  76         }
  77       : undefined,
  78     onError: onError
  79       ? (error, variables, origin, context) => {
  80           if (isCurrentMeetingNotesOrigin(origin)) onError(error, variables, origin, context);
  81         }
  82       : undefined,
  83     onSettled: onSettled
  84       ? (data, error, variables, origin, context) => {
  85           if (isCurrentMeetingNotesOrigin(origin)) onSettled(data, error, variables, origin, context);
  86         }
  87       : undefined,
  88   };
  89 }
  90 
  91 export function useMeetingNotesScopedMutation<TData, TVariables>(
  92   options: MeetingNotesScopedMutationOptions<TData, TVariables>
  93 ): MeetingNotesScopedMutationResult<TData, TVariables> {
  94   const scope = useMeetingNotesScope();
  95   const { abortOnUnmount = false } = options;
  96   const owned = useRef(new Set<AbortController>());
  97 
  98   useEffect(() => {
  99     const controllers = owned.current;
 100     return () => {
 101       if (abortOnUnmount) controllers.forEach((controller) => controller.abort());
 102       controllers.clear();
 103     };
 104   }, [abortOnUnmount]);
 105 
 106   const mutation = useMutation<TData, Error, TVariables, MeetingNotesMutationOrigin>({
 107     mutationKey: scope
 108       ? [...meetingNoteQueryKeys.scope(scope.userId, scope.companyId), 'mutation', options.name]
 109       : ['meeting-notes', 'no-scope', 'mutation', options.name],
 110     networkMode: 'always',
 111     retry: 0,
 112     gcTime: options.gcTime,
 113     onMutate: () => {
 114       if (!scope) throw noSession();
 115       return { scope };
 116     },
 117     mutationFn: async (variables) => {
 118       if (!scope || !isCurrentMeetingNotesScope(scope)) throw noSession();
 119       const controller = openMeetingNotesRequest(scope);
 120       owned.current.add(controller);
 121       try {
 122         return await options.mutationFn(variables, { scope, signal: controller.signal });
 123       } finally {
 124         owned.current.delete(controller);
 125         releaseMeetingNotesRequest(scope, controller);
 126       }
 127     },
 128     onSuccess: (data, variables, origin) => {
 129       if (origin && isCurrentMeetingNotesOrigin(origin)) options.onSuccess?.(data, variables, origin.scope);
 130     },
 131     onError: (error, variables, origin) => {
 132       if (origin && isCurrentMeetingNotesOrigin(origin)) options.onError?.(error, variables, origin.scope);
 133     },
 134   });
 135 
 136   const { mutate: rawMutate, mutateAsync: _unfenced, ...rest } = mutation;
 137   void _unfenced;
 138   const mutate = useCallback(
 139     (variables: TVariables, callbacks?: MeetingNotesMutateOptions<TData, TVariables>) => {
 140       rawMutate(variables, fenceCallbacks(callbacks));
 141     },
 142     [rawMutate]
 143   );
 144 
 145   return { ...rest, mutate };
 146 }
