  77   return (
  78     <div className="flex flex-col gap-4" data-testid="meeting-note-edit-panel">
  79       {conflict && !conflictOpen ? (
  80         <div
  81           className="flex flex-wrap items-center gap-3 rounded-md border border-amber-500/40 bg-amber-500/10 px-3 
py-2 text-sm"
  82           role="alert"
  83         >
  84           <AlertTriangle className="size-4 flex-none text-amber-600" aria-hidden="true" />
  85           <span className="min-w-0 flex-1">
  86             This note was changed by someone else while you were editing. Saving again will be refused until you
  87             load the newer version.
  88           </span>
  89           <Button type="button" size="sm" variant="outline" onClick={() => setConflictOpen(true)}>
  90             Review newer version
  91           </Button>
  92         </div>
  93       ) : null}
