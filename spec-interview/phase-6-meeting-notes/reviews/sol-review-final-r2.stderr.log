   1 // src/hooks/mutations/useMeetingNoteMutations.ts
   2 // Meeting-note changes (Phase 6 FR-001, FR-007, FR-009, FR-010). The routes
   3 // and the database authorize each change against the note's current
   4 // revision; a stale one fails with MeetingNoteConflictError (409) and never
   5 // overwrites. A successful change, and a 409 (which carries the newer note),
   6 // refresh the viewer's meeting-note scope (space Notes tabs, Meetings search,
   7 // the note and its history). Any other failure leaves the cache alone: a
   8 // request that never reached the server proves nothing changed, and a refetch
   9 // that fails offline must not disturb an open editor (block B review B-3).
  10 // Every change runs through useMeetingNotesScopedMutation (scope fence).
  11 'use client';
  12 
  13 import { hashKey, useQueryClient, type QueryClient } from '@tanstack/react-query';
  14 
  15 import { useMeetingNotesScopedMutation } from '@/hooks/mutations/useMeetingNotesScopedMutation';
  16 import { meetingNoteQueryKeys } from '@/hooks/queries/useMeetingNotes';
  17 import {
  18   createMeetingNote,
  19   deleteMeetingNote,
  20   MeetingNoteConflictError,
  21   restoreMeetingNoteVersion,
  22   updateMeetingNote,
  23   type MeetingNoteFieldsPayload,
  24 } from '@/lib/meeting-notes/client-api';
  25 import type { MeetingNotesScope } from '@/lib/meeting-notes/scope-fence';
  26 import type { MeetingNoteDetail } from '@/types/meeting-notes';
  27 
  28 type Scope = MeetingNotesScope;
  29 
  30 /** Stores the note the route returned and marks every list and history of this viewer stale. */
  31 function settleNote(queryClient: QueryClient, scope: Scope, note: MeetingNoteDetail | null): void {
  32   if (note) {
  33     queryClient.setQueryData(meetingNoteQueryKeys.note(scope.userId, scope.companyId, note.id), note);
  34   }
  35   void queryClient.invalidateQueries({
  36     queryKey: meetingNoteQueryKeys.scope(scope.userId, scope.companyId),
  37     // The view just written above is current; everything else refetches.
  38     predicate: (query) =>
  39       !note || query.queryHash !== hashKey(meetingNoteQueryKeys.note(scope.userId, scope.companyId, note.id)),
  40   });
  41 }
  42 
  43 /** After a 409 the cache takes the newer note the route returned; other failures change nothing. */
  44 function settleConflict(queryClient: QueryClient, scope: Scope, error: unknown): void {
  45   if (error instanceof MeetingNoteConflictError) settleNote(queryClient, scope, error.note);
  46 }
  47 
  48 export interface CreateMeetingNoteVariables {
  49   spaceId: string;
  50   fields: MeetingNoteFieldsPayload;
  51 }
  52 
  53 export function useCreateMeetingNote() {
  54   const queryClient = useQueryClient();
  55   return useMeetingNotesScopedMutation<MeetingNoteDetail, CreateMeetingNoteVariables>({
  56     name: 'create-note',
  57     mutationFn: ({ spaceId, fields }, { signal }) => createMeetingNote(spaceId, fields, signal),
  58     onSuccess: (note, _variables, scope) => settleNote(queryClient, scope, note),
  59   });
  60 }
  61 
  62 export interface UpdateMeetingNoteVariables {
  63   noteId: string;
  64   expectedRevision: number;
  65   fields: MeetingNoteFieldsPayload;
  66 }
  67 
  68 export function useUpdateMeetingNote() {
  69   const queryClient = useQueryClient();
  70   return useMeetingNotesScopedMutation<MeetingNoteDetail, UpdateMeetingNoteVariables>({
  71     name: 'update-note',
  72     mutationFn: ({ noteId, expectedRevision, fields }, { signal }) =>
  73       updateMeetingNote(noteId, expectedRevision, fields, signal),
  74     onSuccess: (note, _variables, scope) => settleNote(queryClient, scope, note),
  75     onError: (error, _variables, scope) => settleConflict(queryClient, scope, error),
  76   });
  77 }
  78 
  79 export interface RestoreMeetingNoteVariables {
  80   noteId: string;
  81   expectedRevision: number;
  82   versionId: string;
  83 }
  84 
  85 export function useRestoreMeetingNoteVersion() {
  86   const queryClient = useQueryClient();
  87   return useMeetingNotesScopedMutation<MeetingNoteDetail, RestoreMeetingNoteVariables>({
  88     name: 'restore-note',
  89     mutationFn: ({ noteId, expectedRevision, versionId }, { signal }) =>
  90       restoreMeetingNoteVersion(noteId, expectedRevision, versionId, signal),
  91     onSuccess: (note, _variables, scope) => settleNote(queryClient, scope, note),
  92     onError: (error, _variables, scope) => settleConflict(queryClient, scope, error),
  93   });
  94 }
  95 
  96 export interface DeleteMeetingNoteVariables {
  97   noteId: string;
  98   expectedRevision: number;
  99 }
 100 
 101 export function useDeleteMeetingNote() {
 102   const queryClient = useQueryClient();
 103   return useMeetingNotesScopedMutation<void, DeleteMeetingNoteVariables>({
 104     name: 'delete-note',
 105     mutationFn: ({ noteId, expectedRevision }, { signal }) => deleteMeetingNote(noteId, expectedRevision, signal),
 106     onSuccess: (_result, { noteId }, scope) => {
 107       // The deleted note's own queries would only answer 404 now: they are
 108       // left alone here and dropped by the view once it stops observing them
 109       // (removeMeetingNoteQueries); every list refetches.
 110       const root = meetingNoteQueryKeys.noteRoot(scope.userId, scope.companyId, noteId);
 111       void queryClient.invalidateQueries({
 112         queryKey: meetingNoteQueryKeys.scope(scope.userId, scope.companyId),
 113         predicate: (query) => !root.every((part, index) => query.queryKey[index] === part),
 114       });
 115     },
 116     onError: (error, _variables, scope) => settleConflict(queryClient, scope, error),
 117   });
 118 }
 119 
 120 /** Drops everything cached for a deleted note (call once nothing observes it any more). */
 121 export function removeMeetingNoteQueries(queryClient: QueryClient, scope: Scope, noteId: string): void {
 122   queryClient.removeQueries({ queryKey: meetingNoteQueryKeys.noteRoot(scope.userId, scope.companyId, noteId) });
 123 }
 124 
 125 /** For other note writes (transcript upload/attach, AI Apply): the same cache settlement. */
 126 export { settleNote as settleMeetingNoteCache, settleConflict as settleMeetingNoteConflictCache };
src/lib/meeting-notes/scope-fence.ts
   1 // src/lib/meeting-notes/scope-fence.ts
   2 // Browser-side scope fence of the meeting-notes client layer (Phase 6
   3 // FR-021 browser clause; block B review B-1/B-2). A scope is the signed-in
   4 // application users.id plus the company id. Every meeting-note request a
   5 // mutation starts registers an AbortController under the scope it started
   6 // in; when that scope retires (sign-out, account switch, company change),
   7 // MeetingNotesScopeBoundary aborts those requests and late callbacks of the
   8 // retired scope are dropped (no download, no cache write, no toast).
   9 //
  10 // The current scope is written only by MeetingNotesScopeBoundary (mounted
  11 // once in the root layout, inside CompanyProvider). Until it has run, no
  12 // scope is current, so nothing a mutation returns is applied.
  13 
  14 export interface MeetingNotesScope {
  15   /** Application users.id (never auth.uid()). */
  16   userId: string;
  17   companyId: string;
  18 }
  19 
  20 /** What a scoped mutation's onMutate returns: the scope it started in. */
  21 export interface MeetingNotesMutationOrigin {
  22   scope: MeetingNotesScope;
  23 }
  24 
  25 let currentKey: string | null = null;
  26 const inFlight = new Map<string, Set<AbortController>>();
  27 
  28 export function meetingNotesScopeKey(scope: MeetingNotesScope): string {
  29   return `${scope.userId}:${scope.companyId}`;
  30 }
  31 
  32 /** Called by MeetingNotesScopeBoundary whenever the signed-in scope changes. */
  33 export function setCurrentMeetingNotesScope(scope: MeetingNotesScope | null): void {
  34   currentKey = scope ? meetingNotesScopeKey(scope) : null;
  35 }
  36 
  37 /** Whether `scope` is still the signed-in user's scope. */
  38 export function isCurrentMeetingNotesScope(scope: MeetingNotesScope | null | undefined): boolean {
  39   return Boolean(scope) && currentKey !== null && currentKey === meetingNotesScopeKey(scope as MeetingNotesScope);
  40 }
  41 
  42 /** Whether a mutation's onMutate result names the current scope. */
  43 export function isCurrentMeetingNotesOrigin(origin: unknown): origin is MeetingNotesMutationOrigin {
  44   if (!origin || typeof origin !== 'object' || !('scope' in origin)) return false;
  45   return isCurrentMeetingNotesScope((origin as MeetingNotesMutationOrigin).scope);
  46 }
  47 
  48 /**
  49  * A controller for one request of `scope`; aborted at once when the scope is
  50  * not current, otherwise when it retires. Release it when the request settles.
  51  */
  52 export function openMeetingNotesRequest(scope: MeetingNotesScope): AbortController {
  53   const controller = new AbortController();
  54   if (!isCurrentMeetingNotesScope(scope)) {
  55     controller.abort();
  56     return controller;
  57   }
  58   const key = meetingNotesScopeKey(scope);
  59   const set = inFlight.get(key) ?? new Set<AbortController>();
  60   set.add(controller);
  61   inFlight.set(key, set);
  62   return controller;
  63 }
  64 
  65 export function releaseMeetingNotesRequest(scope: MeetingNotesScope, controller: AbortController): void {
  66   const key = meetingNotesScopeKey(scope);
  67   const set = inFlight.get(key);
  68   if (!set) return;
  69   set.delete(controller);
  70   if (set.size === 0) inFlight.delete(key);
  71 }
  72 
  73 /** Aborts every request still in flight for `scope`. */
  74 export function abortMeetingNotesScopeRequests(scope: MeetingNotesScope): void {
  75   const key = meetingNotesScopeKey(scope);
  76   const set = inFlight.get(key);
  77   inFlight.delete(key);
  78   set?.forEach((controller) => controller.abort());
  79 }

