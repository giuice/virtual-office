 689 create or replace function public.settle_meeting_note_ai_operation(p_operation_id uuid, p_outcome text)
 690 returns jsonb
 691 language plpgsql
 692 volatile
 693 security definer
 694 set search_path = ''
 695 as $$
 696 declare
 697   v_operation public.meeting_note_ai_operations%rowtype;
 698   v_changed boolean := false;
 699 begin
 700   if p_operation_id is null or p_outcome is null then
 701     raise exception 'MEETING_NOTE_AI_INVALID_ARGUMENT' using errcode = '22023';
 702   end if;
 703   if p_outcome not in ('succeeded', 'failed', 'discarded', 'refunded', 'released') then
 704     raise exception 'MEETING_NOTE_AI_OUTCOME_INVALID' using errcode = '22023';
 705   end if;
 706 
 707   select o.* into v_operation
 708   from public.meeting_note_ai_operations as o
 709   where o.id = p_operation_id
 710   for update;
 711   if not found then
 712     raise exception 'MEETING_NOTE_AI_OPERATION_NOT_FOUND' using errcode = 'P0002';
 713   end if;
 714 
 715   if v_operation.status in ('admitted', 'dispatched') then
 716     -- released only for a request never sent; every other outcome only after
 717     -- the dispatch was recorded.
 718     if (p_outcome = 'released') <> (v_operation.status = 'admitted') then
 719       raise exception 'MEETING_NOTE_AI_OPERATION_INVALID_TRANSITION'
 720         using errcode = 'P0001',
 721               detail = pg_catalog.jsonb_build_object('status', v_operation.status)::text;
 722     end if;
 723 
 724     update public.meeting_note_ai_operations as o
 725     set status = p_outcome,
 726         settled_at = pg_catalog.now()
 727     where o.id = p_operation_id
 728     returning o.* into v_operation;
 729     v_changed := true;
 730   end if;
 731   -- A terminal operation is never settled again (idempotent).
 732 
 733   return pg_catalog.jsonb_build_object(
 734     'operation_id', v_operation.id,
 735     'status', v_operation.status,
 736     'changed', v_changed,
 737     'counted', v_operation.status in ('admitted', 'dispatched', 'succeeded', 'failed', 'discarded'),
 738     'admission_day', v_operation.admission_day,
 739     'settled_at', v_operation.settled_at
 740   );
 741 end;
 742 $$;
 743 
