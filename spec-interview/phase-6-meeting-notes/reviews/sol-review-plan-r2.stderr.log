   1: import { randomUUID } from 'node:crypto';
   2: import { NextResponse } from 'next/server';
   3: import {
   4:   companyMemberRemovalRequestSchema,
   5:   companyMemberRemovalRpcErrorMap,
   6:   parseCompanyMemberRemovalRpcErrorCode,
   7:   parseCompanyMemberRemovalRpcResult,
   8: } from '@/lib/api/company-membership-contracts';
   9: import { requireAuthUser } from '@/lib/auth/session';
  10: import { createSupabaseServerClient } from '@/lib/supabase/server-client';
  11: 
  12: export const dynamic = 'force-dynamic';
  13: 
  14: export async function POST(request: Request): Promise<NextResponse> {
  15:   const correlationId = randomUUID();
  16: 
  17:   try {
  18:     let body: unknown;
  19:     try {
  20:       body = await request.json();
  21:     } catch {
  22:       return NextResponse.json(
  23:         { message: 'Invalid request', code: 'INVALID_REQUEST' },
  24:         { status: 400 },
  25:       );
  26:     }
  27: 
  28:     const parsedBody = companyMemberRemovalRequestSchema.safeParse(body);
  29:     if (!parsedBody.success) {
  30:       return NextResponse.json(
  31:         { message: 'Invalid request', code: 'INVALID_REQUEST' },
  32:         { status: 400 },
  33:       );
  34:     }
  35: 
  36:     const auth = await requireAuthUser();
  37:     if ('errorResponse' in auth) return auth.errorResponse;
  38: 
  39:     // The company and actor IDs are server-derived. The database rechecks the
  40:     // same-company admin rule under the transaction's row locks.
  41:     if (!auth.dbUser.companyId || auth.dbUser.role !== 'admin') {
  42:       return NextResponse.json(
  43:         {
  44:           message: 'Only an admin of this company can remove members',
  45:           code: 'COMPANY_REMOVAL_FORBIDDEN',
  46:         },
  47:         { status: 403 },
  48:       );
  49:     }
  50: 
  51:     const admin = await createSupabaseServerClient('service_role');
  52:     const { data, error } = await admin.rpc(
  53:       'remove_company_member_and_presence',
  54:       {
  55:         p_actor_user_id: auth.dbUser.id,
  56:         p_target_user_id: parsedBody.data.userId,
  57:         p_company_id: auth.dbUser.companyId,
  58:       },
  59:     );
  60: 
  61:     if (error) {
  62:       const errorCode = parseCompanyMemberRemovalRpcErrorCode(error.message);
  63:       const contract = errorCode ? companyMemberRemovalRpcErrorMap[errorCode] : null;
  64:       if (contract) {
  65:         return NextResponse.json(contract.body, { status: contract.status });
  66:       }
  67: 
  68:       console.error('Atomic company member removal failed', {
  69:         correlationId,
  70:         databaseCode: error.code,
  71:       });
  72:       return NextResponse.json(
  73:         { message: 'Failed to remove user from company', code: 'INTERNAL_ERROR' },
  74:         { status: 500 },
  75:       );
  76:     }
  77: 
  78:     const result = parseCompanyMemberRemovalRpcResult(data, {
  79:       actorUserId: auth.dbUser.id,
  80:       targetUserId: parsedBody.data.userId,
  81:       companyId: auth.dbUser.companyId,
  82:     });
  83:     if (!result) {
  84:       console.error('Atomic company member removal returned an invalid result', {
  85:         correlationId,
  86:       });
  87:       return NextResponse.json(
  88:         { message: 'Failed to remove user from company', code: 'INTERNAL_ERROR' },
  89:         { status: 500 },
  90:       );
  91:     }
  92: 
  93:     return NextResponse.json({
  94:       message: 'User removed from company successfully',
  95:       code: result.code,
  96:       result,
  97:     });
  98:   } catch (error) {
  99:     console.error('Atomic company member removal failed', {
 100:       correlationId,
 101:       errorName: error instanceof Error ? error.name : 'UnknownError',
 102:     });
 103:     return NextResponse.json(
 104:       { message: 'Failed to remove user from company', code: 'INTERNAL_ERROR' },
 105:       { status: 500 },
 106:     );
 107:   }
 108: }
