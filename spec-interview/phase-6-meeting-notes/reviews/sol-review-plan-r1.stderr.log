 468: create or replace function private.reject_direct_service_role_membership_write()
 469: returns trigger
 470: language plpgsql
 471: set search_path = pg_catalog
 472: as $$
 473: begin
 474:     if current_user = 'service_role' then
 475:         if tg_table_name = 'invitations' and tg_op = 'INSERT' then
 476:             raise exception 'DIRECT_SERVICE_ROLE_INVITATION_INSERT_FORBIDDEN'
 477:                 using errcode = '42501';
 478:         end if;
 479: 
 480:         if tg_table_name = 'users'
 481:            and tg_op = 'UPDATE'
 482:            and (
 483:              old.company_id is distinct from new.company_id
 484:              or old.role is distinct from new.role
 485:            ) then
 486:             raise exception 'DIRECT_SERVICE_ROLE_MEMBERSHIP_UPDATE_FORBIDDEN'
 487:                 using errcode = '42501';
 488:         end if;
 489:     end if;
 490: 
 491:     return new;
 492: end;
 493: $$;
