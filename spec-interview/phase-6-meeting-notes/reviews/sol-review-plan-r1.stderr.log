 150:     // in the DB schema (ON DELETE CASCADE). If not, they need to be deleted manually
 151:     // using the IMeetingNoteActionItemRepository before or after this call.
 152:     const { error, count } = await this.client
 153:       .from(this.TABLE_NAME)
 154:       .delete()
 155:       .eq('id', id);
 156: 
 157:     if (error) {
 158:       console.error('Error deleting meeting note:', error);
 159:       return false;
 160:     }
 161:     return (count ?? 0) > 0;
 162:   }
