 116: create or replace function public.expire_knock_requests()
 117: returns integer
 118: language plpgsql
 119: security definer
 120: set search_path = pg_catalog
 121: as $$
 122: declare
 123:     v_operation_time timestamptz := pg_catalog.clock_timestamp();
 124:     v_expired_count integer := 0;
 125:     v_deleted_count integer := 0;
 126: begin
 127:     with expirable as materialized (
 128:         select kr.id
 129:         from public.knock_requests as kr
 130:         where kr.status in ('pending', 'approved')
 131:           and kr.consumed_at is null
 132:           and kr.expires_at <= v_operation_time
 133:         order by kr.expires_at, kr.id
 134:         for update skip locked
 135:         limit 1000
 136:     )
 137:     update public.knock_requests as kr
 138:     set status = 'expired',
 139:         updated_at = v_operation_time
 140:     from expirable
 141:     where kr.id = expirable.id;
 142: 
 143:     get diagnostics v_expired_count = row_count;
 144: 
 145:     with purgeable as materialized (
 146:         select kr.id
 147:         from public.knock_requests as kr
 148:         where kr.status in ('expired', 'denied', 'consumed')
 149:           and kr.updated_at <= v_operation_time - interval '30 days'
 150:         order by kr.updated_at, kr.id
 151:         for update skip locked
 152:         limit 1000
 153:     )
 154:     delete from public.knock_requests as kr
 155:     using purgeable
 156:     where kr.id = purgeable.id;
 157: 
 158:     get diagnostics v_deleted_count = row_count;
 159:     return v_expired_count + v_deleted_count;
 160: end;
 161: $$;
