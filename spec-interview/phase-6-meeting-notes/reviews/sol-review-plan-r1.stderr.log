   1: // src/lib/auth/authorize.ts
   2: // Single authorization gate for messaging routes (audit S-05).
   3: // Rule: every route resolves the requester, checks participation here, and only
   4: // then may use the service-role client for the mutation. RLS stays as
   5: // defense-in-depth, never the primary gate.
   6: import type { NextResponse } from 'next/server';
   7: import type { SupabaseClient } from '@supabase/supabase-js';
   8: import { jsonError } from '@/lib/api/server-error';
   9: import { createSupabaseServerClient } from '@/lib/supabase/server-client';
  10: import { requireAuthUser } from '@/lib/auth/session';
  11: import type { User } from '@/types/database';
  12: 
  13: export { jsonError } from '@/lib/api/server-error';
  14: 
  15: export interface ConversationAccess {
  16:   id: string;
  17:   type: string;
  18:   roomId: string | null;
  19: }
  20: 
  21: export interface ParticipantContext {
  22:   /** User-scoped client — use for reads so RLS still applies. */
  23:   supabase: SupabaseClient;
  24:   /** Service-role client — use ONLY for the mutation after this check passed. */
  25:   serviceClient: SupabaseClient;
  26:   dbUser: User;
  27:   conversation: ConversationAccess;
  28: }
  29: 
  30: export interface MessageParticipantContext extends ParticipantContext {
  31:   message: {
  32:     id: string;
  33:     conversationId: string;
  34:     senderId: string | null;
  35:   };
  36: }
  37: 
  38: export interface AuthzFailure {
  39:   errorResponse: NextResponse;
  40: }
  41: 
  42: export function isAuthzFailure(result: object): result is AuthzFailure {
  43:   return 'errorResponse' in result;
  44: }
  45: 
  46: async function loadConversationAccess(
  47:   serviceClient: SupabaseClient,
  48:   conversationId: string,
  49:   dbUserId: string
  50: ): Promise<{ conversation: ConversationAccess; isMember: boolean } | AuthzFailure> {
  51:   const { data: row, error } = await serviceClient
  52:     .from('conversations')
  53:     .select('id, type, room_id, conversation_members(user_id)')
  54:     .eq('id', conversationId)
  55:     .eq('conversation_members.user_id', dbUserId)
  56:     .maybeSingle();
  57: 
  58:   if (error) {
  59:     console.error('[authorize] Failed to load conversation:', error.message);
  60:     return { errorResponse: jsonError(500, 'INTERNAL_ERROR', 'Failed to load conversation') };
  61:   }
  62:   if (!row) {
  63:     return { errorResponse: jsonError(404, 'CONVERSATION_NOT_FOUND', 'Conversation not found') };
  64:   }
  65: 
  66:   const conversationMembers = Array.isArray((row as { conversation_members?: unknown }).conversation_members)
  67:     ? ((row as { conversation_members: { user_id: string }[] }).conversation_members ?? [])
  68:     : [];
  69: 
  70:   return {
  71:     conversation: {
  72:       id: row.id,
  73:       type: row.type,
  74:       roomId: row.room_id ?? null,
  75:     },
  76:     isMember: conversationMembers.length > 0,
  77:   };
  78: }
  79: 
  80: export interface ConversationParticipantOptions {
  81:   /**
  82:    * Phase 5 FR-011: the sender the client expects (users.id of its outbox
  83:    * item's owner). When the authenticated user differs, the request is refused
  84:    * with 403 SENDER_MISMATCH before the conversation is read.
  85:    */
  86:   expectedSenderId?: string;
  87:   /**
  88:    * Phase 5 BR-005: answer a missing conversation like a non-member (403
  89:    * NOT_PARTICIPANT) instead of 404, so the outcome is uniform and does not
  90:    * reveal whether a conversation exists.
  91:    */
  92:   missingConversationAsNotParticipant?: boolean;
  93: }
  94: 
  95: function notParticipant(): AuthzFailure {
  96:   return {
  97:     errorResponse: jsonError(403, 'NOT_PARTICIPANT', 'You are not a participant of this conversation'),
  98:   };
  99: }
 100: 
 101: /**
 102:  * Resolves the session and asserts the requester participates in the
 103:  * conversation. Membership authority is now conversation_members (synced from
 104:  * participants[] by DB trigger; participants[] will be removed in Phase 3).
 105:  */
 106: export async function requireConversationParticipant(
 107:   conversationId: string,
 108:   options: ConversationParticipantOptions = {}
 109: ): Promise<ParticipantContext | AuthzFailure> {
 110:   if (!conversationId || typeof conversationId !== 'string') {
 111:     return { errorResponse: jsonError(400, 'BAD_REQUEST', 'conversationId is required') };
 112:   }
 113: 
 114:   const auth = await requireAuthUser();
 115:   if ('errorResponse' in auth) {
 116:     return auth;
 117:   }
 118: 
 119:   const serviceClient = await createSupabaseServerClient('service_role');
 120:   return authorizeConversationParticipant(auth, serviceClient, conversationId, options);
 121: }
 122: 
 123: /** A requester already authenticated by requireAuthUser (auth.getUser + users.supabase_uid). */
 124: export interface AuthenticatedRequester {
 125:   supabase: SupabaseClient;
 126:   dbUser: User;
 127: }
 128: 
 129: /**
 130:  * The participation check of requireConversationParticipant for a requester
 131:  * the route already authenticated — e.g. to charge a per-user budget before
 132:  * validating the request body (Phase 5 T3).
 133:  */
 134: export async function authorizeConversationParticipant(
 135:   auth: AuthenticatedRequester,
 136:   serviceClient: SupabaseClient,
 137:   conversationId: string,
 138:   options: ConversationParticipantOptions = {}
 139: ): Promise<ParticipantContext | AuthzFailure> {
 140:   if (!conversationId || typeof conversationId !== 'string') {
 141:     return { errorResponse: jsonError(400, 'BAD_REQUEST', 'conversationId is required') };
 142:   }
 143: 
 144:   if (
 145:     options.expectedSenderId !== undefined &&
 146:     options.expectedSenderId.toLowerCase() !== auth.dbUser.id.toLowerCase()
 147:   ) {
 148:     return {
 149:       errorResponse: jsonError(403, 'SENDER_MISMATCH', 'The authenticated user is not the expected sender'),
 150:     };
 151:   }
 152: 
 153:   const access = await loadConversationAccess(serviceClient, conversationId, auth.dbUser.id);
 154:   if (isAuthzFailure(access)) {
 155:     if (options.missingConversationAsNotParticipant && access.errorResponse.status === 404) {
 156:       return notParticipant();
 157:     }
 158:     return access;
 159:   }
 160: 
 161:   if (!access.isMember) {
 162:     return notParticipant();
 163:   }
 164: 
 165:   const { conversation } = access;
 166: 
 167:   return {
 168:     supabase: auth.supabase,
 169:     serviceClient,
 170:     dbUser: auth.dbUser,
 171:     conversation,
 172:   };
 173: }
 174: 
 175: /**
 176:  * Same as requireConversationParticipant, but scoped by message — for routes
 177:  * addressed by messageId (react, pin, star, attachment access).
 178:  */
 179: export async function requireMessageParticipant(
 180:   messageId: string
 181: ): Promise<MessageParticipantContext | AuthzFailure> {
 182:   if (!messageId || typeof messageId !== 'string') {
 183:     return { errorResponse: jsonError(400, 'BAD_REQUEST', 'messageId is required') };
 184:   }
 185: 
 186:   const auth = await requireAuthUser();
 187:   if ('errorResponse' in auth) {
 188:     return auth;
 189:   }
 190: 
 191:   const serviceClient = await createSupabaseServerClient('service_role');
 192:   const { data: messageRow, error: messageError } = await serviceClient
 193:     .from('messages')
 194:     .select('id, conversation_id, sender_id')
 195:     .eq('id', messageId)
 196:     .maybeSingle();
 197: 
 198:   if (messageError) {
 199:     console.error('[authorize] Failed to load message:', messageError.message);
 200:     return { errorResponse: jsonError(500, 'INTERNAL_ERROR', 'Failed to load message') };
 201:   }
 202:   if (!messageRow) {
 203:     return { errorResponse: jsonError(404, 'MESSAGE_NOT_FOUND', 'Message not found') };
 204:   }
 205: 
 206:   const access = await loadConversationAccess(serviceClient, messageRow.conversation_id, auth.dbUser.id);
 207:   if (isAuthzFailure(access)) {
 208:     return access;
 209:   }
 210: 
 211:   if (!access.isMember) {
 212:     return {
 213:       errorResponse: jsonError(403, 'NOT_PARTICIPANT', 'You are not a participant of this conversation'),
 214:     };
 215:   }
 216: 
 217:   return {
 218:     supabase: auth.supabase,
 219:     serviceClient,
 220:     dbUser: auth.dbUser,
 221:     conversation: access.conversation,
 222:     message: {
 223:       id: messageRow.id,
 224:       conversationId: messageRow.conversation_id,
 225:       senderId: messageRow.sender_id ?? null,
 226:     },
 227:   };
 228: }
