src/repositories/implementations/supabase/SupabaseMeetingNoteRepository.ts
   1: // src/repositories/implementations/supabase/SupabaseMeetingNoteRepository.ts
   2: import { IMeetingNoteRepository } from '@/repositories/interfaces/IMeetingNoteRepository';
   3: import { MeetingNote } from '@/types/database'; // Removed ActionItem import here
   4: import { PaginationOptions, PaginatedResult } from '@/types/common';
   5: import type { SupabaseClient } from '@supabase/supabase-js';
   6: 
   7: // Helper function to map DB snake_case to TS camelCase for MeetingNote
   8: // Note: This does NOT include actionItems, as they are in a separate table.
   9: function mapToCamelCase(data: any): MeetingNote {
  10:   if (!data) return data;
  11:   return {
  12:     id: data.id,
  13:     roomId: data.room_id,
  14:     title: data.title,
  15:     meetingDate: data.meeting_date,
  16:     transcript: data.transcript,
  17:     summary: data.summary,
  18:     // actionItems: undefined, // Explicitly undefined or omitted
  19:     generatedBy: data.generated_by,
  20:     editedBy: data.edited_by,
  21:     createdAt: data.created_at,
  22:     updatedAt: data.updated_at
  23:   };
  24: }
  25: 
  26: // Helper function to map an array
  27: function mapArrayToCamelCase(dataArray: any[]): MeetingNote[] {
  28:   if (!dataArray) return [];
  29:   return dataArray.map(item => mapToCamelCase(item));
  30: }
  31: 
  32: 
  33: export class SupabaseMeetingNoteRepository implements IMeetingNoteRepository {
  34:   private TABLE_NAME = 'meeting_notes'; // Ensure this matches your Supabase table name
  35:   private client: SupabaseClient;
  36: 
  37:   constructor(client: SupabaseClient) {
  38:     this.client = client;
  39:   }
  40: 
  41:   async findById(id: string): Promise<MeetingNote | null> {
  42:     const { data, error } = await this.client
  43:       .from(this.TABLE_NAME)
  44:       .select('*') // Select only columns from meeting_notes table
  45:       .eq('id', id)
  46:       .single();
  47: 
  48:     if (error && error.code !== 'PGRST116') {
  49:       console.error('Error fetching meeting note by ID:', error);
  50:       throw error;
  51:     }
  52:     // Map DB response (snake_case) to MeetingNote type (camelCase)
  53:     // Action items must be fetched separately using IMeetingNoteActionItemRepository if needed.
  54:     return data ? mapToCamelCase(data) : null;
  55:   }
  56: 
  57:   async findByRoom(roomId: string, options?: PaginationOptions): Promise<PaginatedResult<MeetingNote>> {
  58:     const limit = options?.limit ?? 10;
  59:     const from = typeof options?.cursor === 'number' ? options.cursor : 0;
  60:     const to = from + limit - 1;
  61: 
  62:     // Query meeting notes for the room, ordered by meeting date descending
  63:     const { data, error, count } = await this.client
  64:       .from(this.TABLE_NAME)
  65:       .select('*', { count: 'exact' })
  66:       .eq('room_id', roomId) // Assuming snake_case
  67:       .order('meeting_date', { ascending: false }) // Assuming snake_case
  68:       .range(from, to);
  69: 
  70:     if (error) {
  71:       console.error('Error fetching meeting notes by room:', error);
  72:       throw error;
  73:     }
  74: 
  75:     // Map DB response array
  76:     const items = mapArrayToCamelCase(data || []);
  77:     const nextCursor = items.length === limit ? to + 1 : null;
  78: 
  79:     // Action items must be fetched separately for each note if needed.
  80: 
  81:     return {
  82:       items: items,
  83:       nextCursor: nextCursor,
  84:       hasMore: nextCursor !== null,
  85:       totalCount: count ?? undefined,
  86:     };
  87:   }
  88: 
  89:   // Note: actionItems are handled by the separate repository
  90:   async create(noteData: Omit<MeetingNote, 'id' | 'createdAt' | 'updatedAt' | 'actionItems'>): 
Promise<MeetingNote> {
  91:     // Map MeetingNote type (camelCase) to DB schema (snake_case)
  92:     const dbData = {
  93:         room_id: noteData.roomId,
  94:         title: noteData.title,
  95:         meeting_date: noteData.meetingDate,
  96:         transcript: noteData.transcript,
  97:         summary: noteData.summary,
  98:         // action_items are NOT stored here
  99:         generated_by: noteData.generatedBy,
 100:         edited_by: noteData.editedBy,
 101:         // createdAt/updatedAt handled by Supabase defaults/triggers
 102:     };
 103: 
 104:     const { data, error } = await this.client
 105:       .from(this.TABLE_NAME)
 106:       .insert(dbData)
 107:       .select()
 108:       .single();
 109: 
 110:     if (error || !data) {
 111:       console.error('Error creating meeting note:', error);
 112:       throw error || new Error('Failed to create meeting note or retrieve created data.');
 113:     }
 114:     // Map DB response back to MeetingNote type
 115:     // Note: Created action items must be handled separately using the other repository.
 116:     return mapToCamelCase(data);
 117:   }
 118: 
 119:   // Note: actionItems updates must be handled by the separate repository
 120:   async update(id: string, updates: Partial<Omit<MeetingNote, 'id' | 'createdAt' | 'updatedAt' | 
'actionItems'>>): Promise<MeetingNote | null> {
 121:     // Map updates from camelCase to snake_case
 122:     const { roomId, meetingDate, generatedBy, editedBy, ...restUpdates } = updates;
 123:     const dbUpdates: Record<string, any> = { ...restUpdates }; // title, transcript, summary
 124:     if (roomId !== undefined) dbUpdates.room_id = roomId;
 125:     if (meetingDate !== undefined) dbUpdates.meeting_date = meetingDate;
 126:     // actionItems are NOT updated here
 127:     if (generatedBy !== undefined) dbUpdates.generated_by = generatedBy;
 128:     if (editedBy !== undefined) dbUpdates.edited_by = editedBy;
 129:     // updatedAt handled by Supabase trigger ideally
 130: 
 131:     const { data, error } = await this.client
 132:       .from(this.TABLE_NAME)
 133:       .update(dbUpdates)
 134:       .eq('id', id)
 135:       .select()
 136:       .single();
 137: 
 138:     if (error) {
 139:       console.error('Error updating meeting note:', error);
 140:       if (error.code === 'PGRST116') return null;
 141:       throw error;
 142:     }
 143:     // Map DB response back to MeetingNote type
 144:     // Note: Updated action items must be handled separately.
 145:     return data ? mapToCamelCase(data) : null;
 146:   }
 147: 
 148:   async deleteById(id: string): Promise<boolean> {
 149:     // Note: Deleting a note should ideally cascade delete related action items
 150:     // in the DB schema (ON DELETE CASCADE). If not, they need to be deleted manually
 151:     // using the IMeetingNoteActionItemRepository before or after this call.
 152:     const { error, count } = await this.client
 153:       .from(this.TABLE_NAME)
 154:       .delete()
 155:       .eq('id', id);
 156: 
 157:     if (error) {
 158:       console.error('Error deleting meeting note:', error);
 159:       return false;
 160:     }
 161:     return (count ?? 0) > 0;
 162:   }
 163: 
 164: }
src/lib/auth/session.ts
   1: // src/lib/auth/session.ts
   2: import type { NextResponse } from 'next/server';
   3: import type { SupabaseClient, User as SupabaseAuthUser } from '@supabase/supabase-js';
   4: import { API_ERROR_CODES } from '@/lib/api/error-contract';
   5: import { jsonError } from '@/lib/api/server-error';
   6: import {
   7:   createAuthCorrelationId,
   8:   getAuthErrorCode,
   9:   recordAuthValidation,
  10: } from '@/lib/auth/auth-metrics';
  11: import { createSupabaseServerClient } from '@/lib/supabase/server-client';
  12: import { SupabaseUserRepository } from '@/repositories/implementations/supabase';
  13: import type { User } from '@/types/database';
  14: 
  15: type SessionResult = {
  16:   supabaseUid?: string; // Supabase Auth UID
  17:   userDbId?: string; // Database UUID (from users table)
  18:   error?: string;
  19: };
  20: 
  21: /**
  22:  * Validates the user session and returns the user ID if valid
  23:  * Handles the relationship between Supabase Auth UIDs and Database UUIDs
  24:  *
  25:  * @returns Object containing supabaseUid (Supabase Auth UID), userDbId (Database UUID), and error (if any)
  26:  */
  27: export async function validateUserSession(): Promise<SessionResult> {
  28:   try {
  29:     const supabase = await createSupabaseServerClient();
  30:     
  31:     const { data, error } = await supabase.auth.getUser();
  32:     
  33:     if (error) {
  34:       console.error('Session error:', error.message);
  35:       return { error: error.message };
  36:     }
  37:     
  38:     if (!data.user) {
  39:       return { error: 'No active session' };
  40:     }
  41:     
  42:     const supabaseUid = data.user.id; // This is the Supabase Auth UID
  43:     
  44:     // Get the database user record to fetch the database UUID
  45:     const { data: userRecord, error: userError } = await supabase
  46:       .from('users')
  47:       .select('id') // Database UUID
  48:       .eq('supabase_uid', supabaseUid) // supabase_uid column holds the Supabase Auth UID
  49:       .single();
  50:     
  51:     if (userError) {
  52:       console.error('User lookup error:', userError.message);
  53:       return { supabaseUid, error: 'User record not found' };
  54:     }
  55:     
  56:     // Return both IDs for flexible usage
  57:     return { 
  58:       supabaseUid,   // Supabase Auth UID (from auth)
  59:       userDbId: userRecord.id // Database UUID (from users table)
  60:     };
  61:     
  62:   } catch (error) {
  63:     console.error('Session validation error:', error);
  64:     return { error: 'Failed to validate session' };
  65:   }
  66: }
  67: 
  68: type RequireAuthResult =
  69:   | { supabase: SupabaseClient; dbUser: User; authUser: SupabaseAuthUser }
  70:   | { errorResponse: NextResponse };
  71: 
  72: interface RequireAuthUserOptions {
  73:   correlationId?: string;
  74:   pathname?: string;
  75:   beforeDatabaseOperation?: () => void;
  76: }
  77: 
  78: type RequireAuthUserArgument = RequireAuthUserOptions | (() => void);
  79: 
  80: function normalizeRequireAuthOptions(argument?: RequireAuthUserArgument): RequireAuthUserOptions {
  81:   return typeof argument === 'function' ? { beforeDatabaseOperation: argument } : (argument ?? {});
  82: }
  83: 
  84: export async function requireAuthUser(argument?: RequireAuthUserArgument): Promise<RequireAuthResult> {
  85:   const { correlationId: providedCorrelationId, pathname, beforeDatabaseOperation } = 
normalizeRequireAuthOptions(argument);
  86:   const correlationId = providedCorrelationId ?? createAuthCorrelationId();
  87:   let refreshed = false;
  88:   const supabase = await createSupabaseServerClient(undefined, {
  89:     onAuthCookiesSet: () => {
  90:       refreshed = true;
  91:     },
  92:   });
  93:   let authResult: Awaited<ReturnType<typeof supabase.auth.getUser>>;
  94:   try {
  95:     authResult = await supabase.auth.getUser();
  96:   } catch (error) {
  97:     recordAuthValidation({
  98:       correlationId,
  99:       boundary: 'route',
 100:       pathname: pathname ?? '/unattributed',
 101:       authMethod: 'getUser',
 102:       authStatus: 'error',
 103:       authErrorCode: getAuthErrorCode(error),
 104:       refreshed,
 105:     });
 106:     throw error;
 107:   }
 108: 
 109:   const { data, error } = authResult;
 110:   recordAuthValidation({
 111:     correlationId,
 112:     boundary: 'route',
 113:     pathname: pathname ?? '/unattributed',
 114:     authMethod: 'getUser',
 115:     authStatus: error ? 'error' : data.user ? 'authenticated' : 'unauthenticated',
 116:     authErrorCode: getAuthErrorCode(error),
 117:     refreshed,
 118:   });
 119: 
 120:   if (error || !data.user) {
 121:     const isRateLimited = error?.status === 429;
 122:     return {
 123:       errorResponse: jsonError(
 124:         isRateLimited ? 429 : 401,
 125:         isRateLimited ? API_ERROR_CODES.RATE_LIMITED : API_ERROR_CODES.UNAUTHORIZED,
 126:         isRateLimited ? 'Authentication service rate limit reached' : 'Authentication required',
 127:         { correlationId, cause: error, context: 'requireAuthUser.getUser' }
 128:       ),
 129:     };
 130:   }
 131: 
 132:   const userRepository = new SupabaseUserRepository(supabase);
 133: 
 134:   let dbUser: User | null;
 135:   try {
 136:     beforeDatabaseOperation?.();
 137:     dbUser = await userRepository.findBySupabaseUid(data.user.id);
 138:   } catch (lookupError) {
 139:     return {
 140:       errorResponse: jsonError(
 141:         500,
 142:         API_ERROR_CODES.INTERNAL_ERROR,
 143:         'Failed to load authenticated user profile',
 144:         { correlationId, cause: lookupError, context: 'requireAuthUser.profileLookup' }
 145:       ),
 146:     };
 147:   }
 148: 
 149:   if (!dbUser) {
 150:     return {
 151:       errorResponse: jsonError(
 152:         404,
 153:         API_ERROR_CODES.PROFILE_NOT_FOUND,
 154:         'Authenticated user profile not found',
 155:         { correlationId, context: 'requireAuthUser.profileLookup' }
 156:       ),
 157:     };
 158:   }
 159: 
 160:   return { supabase, dbUser, authUser: data.user };
 161: }
