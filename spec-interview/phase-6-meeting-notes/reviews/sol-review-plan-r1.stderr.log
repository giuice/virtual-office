  16: import { isSpaceStatusEnterable } from './NowBoard';
  17: 
  18: /**
  19:  * Real-data-only detail contract: space metadata, roster, audio, and actions.
  20:  */
  21: export interface SpaceDetailPanelProps {
  22:   space: Space;
  23:   usersInSpace: UserPresenceData[];
  24:   state: {
  25:     userInSpace: boolean;
  26:     privateSpace?: boolean;
  27:     /** Story 3.12 - AC3: Whether space is at full capacity */
  28:     full?: boolean;
  29:     /** Whether direct join/enter is currently allowed */
  30:     canDirectEnter?: boolean;
  31:   };
  32:   /** Story 3.16: Current knock status for this space */
  33:   knockStatus?: KnockStatus;
  34:   /** Story 3.16: Current cooldown remaining for this space */
  35:   knockCooldownRemaining?: number;
  36:   onJoin: () => void;
  37:   onLeave: () => void;
  38:   onKnock?: () => void;
  39:   onUserClick?: (userId: string) => void;
  40:   onClose?: () => void;
  41:   /** Speaking user IDs for status display */
  42:   speakingUserIds?: string[];
  43:   /** Presenting user ID for status display */
  44:   presentingUserId?: string;
  45:   /** Muted user IDs for dimmed display */
  46:   mutedUserIds?: string[];
  47:   className?: string;
  48: }
  49: 
  50: /**
  51:  * SpaceDetailPanel - Expanded real-data details for a space.
  52:  */
  53: export const SpaceDetailPanel: React.FC<SpaceDetailPanelProps> = ({
  54:   space,
  55:   usersInSpace,
  56:   state,
  57:   knockStatus = 'idle',
  58:   knockCooldownRemaining = 0,
  59:   onJoin,
  60:   onLeave,
  61:   onKnock,
  62:   onUserClick,
  63:   onClose,
  64:   speakingUserIds,
  65:   presentingUserId,
  66:   mutedUserIds,
  67:   className,
  68: }) => {
  69:   const {
  70:     userInSpace,
  71:     privateSpace = false,
  72:     full = false,
  73:     canDirectEnter = true,
  74:   } = state;
  75:   const isDirectEntryAvailable = isSpaceStatusEnterable(space.status);
  76:   const formattedType = space.type
  77:     .split('_')
  78:     .map((part) => part.charAt(0).toUpperCase() + part.slice(1))
  79:     .join(' ');
  80: 
  81:   return (
  82:     <section
  83:       className={cn(
  84:         'space-detail-panel',
  85:         'flex h-full flex-col overflow-hidden border-l',
  86:         'animate-in slide-in-from-right-full duration-200 motion-reduce:animate-none',
  87:         className
  88:       )}
  89:       style={{
  90:         backgroundColor: 'var(--vo-detail-panel-bg)',
  91:         borderColor: 'var(--vo-detail-panel-border)',
  92:         boxShadow: 'var(--vo-detail-panel-shadow)',
  93:         backdropFilter: 'blur(var(--vo-detail-panel-backdrop-blur, 16px))',
  94:         WebkitBackdropFilter: 'blur(var(--vo-detail-panel-backdrop-blur, 16px))',
  95:       }}
  96:       // AC7: Click-stop protocol compliance
  97:       data-avatar-interactive="true"
  98:       aria-label={`Details for ${space.name}`}
  99:     >
 100:       <header className="border-b border-[var(--vo-line-soft)] px-4 py-4">
 101:         <div className="flex items-center gap-3">
 102:           <div className="grid size-10 flex-none place-items-center rounded-xl border 
border-[var(--vo-line-soft)] bg-[var(--vo-bg-2)]" aria-hidden="true">
 103:             <SpaceTypeIndicator type={space.type} showLabel={false} size="md" />
 104:           </div>
 105:           <div className="min-w-0 flex-1">
 106:             <h3 className="truncate font-display text-base font-bold text-foreground">{space.name}</h3>
 107:             <p className="mt-0.5 flex flex-wrap items-center gap-1.5 text-xs text-muted-foreground">
 108:               <span>{formattedType}</span>
 109:               <span aria-hidden="true">·</span>
 110:               <span className="capitalize">{space.status.replace('_', ' ')}</span>
 111:               {privateSpace ? <DoorClosed className="size-3.5 text-[var(--vo-warn)]" aria-label="Private space" 
/> : null}
 112:             </p>
 113:           </div>
 114:           {onClose ? (
 115:             <button
 116:               type="button"
 117:               onClick={onClose}
 118:               className="grid size-9 flex-none place-items-center rounded-lg border border-[var(--vo-line)] 
text-muted-foreground transition-colors hover:border-[var(--vo-err)] hover:text-[var(--vo-err)]"
 119:               aria-label="Close panel"
 120:             >
 121:               <X className="size-4" aria-hidden="true" />
 122:             </button>
 123:           ) : null}
 124:         </div>
 125:         <div className="mt-3 flex items-center justify-between rounded-xl border border-[var(--vo-line-soft)] 
bg-[var(--vo-bg-2)] px-3 py-2 text-sm">
 126:           <span className="flex items-center gap-2 text-muted-foreground">
 127:             <Users className="size-4" aria-hidden="true" />
 128:             {usersInSpace.length} {usersInSpace.length === 1 ? 'participant' : 'participants'}
 129:           </span>
 130:           {space.capacity > 0 ? (
 131:             <div className="flex items-center gap-2">
 132:               <CapacityIndicator current={usersInSpace.length} capacity={space.capacity} size="md" />
 133:               {full ? <span className="text-xs font-medium text-destructive">At capacity</span> : null}
 134:             </div>
 135:           ) : <span className="text-xs text-muted-foreground">Unlimited</span>}
 136:         </div>
 137:       </header>
 138: 
 139:       <div className="flex min-h-0 flex-1 flex-col gap-5 overflow-y-auto px-4 py-4">
 140:         {userInSpace ? (
 141:           <div aria-labelledby={`space-audio-${space.id}`} data-space-action>
 142:             <h4 id={`space-audio-${space.id}`} className="mb-2 text-[11px] font-bold uppercase tracking-[0.12em] 
text-muted-foreground">
 143:               Audio &amp; presentation
 144:             </h4>
 145:             <div className="flex min-w-0 flex-wrap items-center justify-between gap-2 rounded-xl border 
border-[var(--vo-line-soft)] bg-[var(--vo-bg-2)] p-2.5" data-testid="space-detail-audio">
 146:               <p className="text-xs text-muted-foreground">Space audio controls</p>
 147:               <div className="flex min-w-0 flex-wrap items-center gap-1">
 148:                 <SpaceAudioControls />
 149:                 <ScreenShareControls isCurrentOccupant />
 150:               </div>
 151:             </div>
 152:           </div>
 153:         ) : null}
 154: 
 155:         <div className="min-h-0" aria-labelledby={`space-roster-${space.id}`}>
 156:           <h4 id={`space-roster-${space.id}`} className="mb-2 text-[11px] font-bold uppercase tracking-[0.12em] 
text-muted-foreground">
 157:             People
 158:           </h4>
 159:           <ParticipantRoster
 160:             users={usersInSpace}
 161:             onUserClick={onUserClick}
 162:             speakingUserIds={speakingUserIds}
 163:             presentingUserId={presentingUserId}
 164:             mutedUserIds={mutedUserIds}
 165:             maxHeight={320}
 166:           />
 167:         </div>
 168:       </div>
 169: 
 170:       <footer className="border-t border-[var(--vo-line-soft)] px-4 py-3">
 171:         <SpaceActionButtons
 172:           state={{
 173:             userInSpace,
 174:             privateSpace,
 175:             hasOccupants: usersInSpace.length > 0,
 176:             full,
 177:             canDirectEnter,
 178:             isDirectEntryAvailable,
 179:           }}
 180:           onJoin={onJoin}
 181:           onLeave={onLeave}
 182:           onKnock={onKnock}
 183:           knockStatus={knockStatus}
 184:           knockCooldownRemaining={knockCooldownRemaining}
 185:         />
 186:       </footer>
 187:     </section>
 188:   );
 189: };
