2:{/* src/providers/query-provider.tsx */}
3:import React, { useState } from 'react'
4:import { QueryClient, QueryClientProvider } from '@tanstack/react-query'
5:import { ReactQueryDevtools } from '@tanstack/react-query-devtools'
6:
7:export function QueryProvider({ children }: { children: React.ReactNode }) {
8:  // Use useState to ensure QueryClient is only created once per component instance
9:  const [queryClient] = useState(() => new QueryClient({
10:    defaultOptions: {
11:      queries: {
12:        // With SSR, we usually want to set some default staleTime
13:        // above 0 to avoid refetching immediately on the client
14:        staleTime: 1000 * 60 * 5, // 5 minutes - Adjust as needed
15:        gcTime: 1000 * 60 * 60,   // 1 hour - How long unused data stays in cache
16:        refetchOnWindowFocus: process.env.NODE_ENV === 'production', // Refetch on focus only in prod
17:        retry: 1, // Retry failed requests once
18:      },
19:      mutations: {
20:        retry: 0, // Don't retry mutations by default
21:      },
22:    },
23:  }))
24:
25:  return (
26:    <QueryClientProvider client={queryClient}>
27:      {children}
28:      {/* Add devtools only in development */}
29:      {process.env.NODE_ENV === 'development' &&
30:        process.env.NEXT_PUBLIC_DISABLE_REACT_QUERY_DEVTOOLS !== 'true' &&
31:        process.env.NEXT_PUBLIC_E2E !== 'true' && (
32:        <ReactQueryDevtools initialIsOpen={false} />
33:      )}
34:    </QueryClientProvider>
35:  )
36:}
