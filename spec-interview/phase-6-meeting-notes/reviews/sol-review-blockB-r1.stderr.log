54:              members={companyUsers}
55:              membersById={membersById}
56:            />
57:          ))}
58:        </ul>
59:      )}
60:
61:      {canEdit ? (
62:        adding && !full ? (
63:          <MeetingNoteActionItemForm
64:            noteId={note.id}
65:            members={companyUsers}
66:            membersById={membersById}
67:            onSaved={() => setAdding(false)}
68:            onCancel={() => setAdding(false)}
69:          />
70:        ) : (
71:          <div className="flex flex-wrap items-center gap-3">
72:            <Button
73:              type="button"
74:              size="sm"
75:              variant="outline"
76:              className="h-8 gap-1.5"
77:              disabled={full}
78:              onClick={() => setAdding(true)}
