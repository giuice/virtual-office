2:// Create / edit form of a meeting note (FR-001, FR-002, FR-030): title
3:// (1–200), meeting date (a local day), participants (≤ 50, current members;
4:// former members already listed may stay), and rich text (≤ 100,000
5:// characters after sanitization). Mirrors the route limits and places the
6:// route's 400 codes next to their field; the route stays the authority.
7:'use client';
8:
9:import { Loader2 } from 'lucide-react';
10:import { useId, useMemo, useRef, useState, type FormEvent, type ReactNode } from 'react';
11:
12:import { Button } from '@/components/ui/button';
13:import { Input } from '@/components/ui/input';
14:import { Label } from '@/components/ui/label';
15:import { useCompany } from '@/contexts/CompanyContext';
16:import type { MeetingNoteFieldsPayload } from '@/lib/meeting-notes/client-api';
17:import { sanitizeMeetingNoteHtml } from '@/lib/meeting-notes/content-sanitizer';
18:import { describeMeetingNoteError, meetingNoteFieldError, type MeetingNoteFormField } from 
'@/lib/meeting-notes/form-errors';
19:import { localDayOf, meetingDateFromLocalDay } from '@/lib/meeting-notes/period';
20:import { codePointLength, MEETING_NOTE_LIMITS } from '@/lib/meeting-notes/validation';
21:import type { MeetingNoteParticipant } from '@/types/meeting-notes';
22:import { MeetingNoteParticipantPicker } from './MeetingNoteParticipantPicker';
23:import { MeetingNoteRichTextEditorLazy } from './MeetingNoteRichTextEditorLazy';
24:
25:export interface MeetingNoteFormInitialValues {
26:  title: string;
27:  /** ISO instant; null = today. */
28:  meetingDate: string | null;
29:  participants: MeetingNoteParticipant[];
30:  /** Saved (sanitized) HTML. */
31:  content: string;
32:}
33:
34:export interface MeetingNoteFormProps {
35:  initial: MeetingNoteFormInitialValues;
36:  submitLabel: string;
37:  submitting: boolean;
38:  /** The last failed save, shown next to its field or above the buttons. */
39:  submitError: unknown;
40:  onSubmit: (fields: MeetingNoteFieldsPayload) => void;
41:  onCancel: () => void;
42:  /** Shown above the fields (e.g. the space the note belongs to). */
43:  header?: ReactNode;
44:}
45:
46:type FieldErrors = Partial<Record<MeetingNoteFormField, string>>;
47:
48:function todayLocalDay(): string {
49:  return localDayOf(new Date().toISOString());
50:}
51:
52:export function MeetingNoteForm({
53:  initial,
54:  submitLabel,
55:  submitting,
56:  submitError,
57:  onSubmit,
58:  onCancel,
59:  header,
60:}: MeetingNoteFormProps) {
61:  const ids = {
62:    title: useId(),
63:    titleError: useId(),
64:    date: useId(),
65:    dateError: useId(),
66:    participantsLabel: useId(),
67:    participantsError: useId(),
68:    contentLabel: useId(),
69:    contentError: useId(),
70:    editor: useId(),
71:  };
72:  const { company, companyUsers } = useCompany();
73:  const members = useMemo(
74:    () => companyUsers.filter((user) => company !== null && user.companyId === company.id),
75:    [company, companyUsers]
76:  );
77:
78:  const initialDay = useMemo(() => (initial.meetingDate ? localDayOf(initial.meetingDate) : todayLocalDay()), 
[initial.meetingDate]);
79:  const [title, setTitle] = useState(initial.title);
80:  const [day, setDay] = useState(initialDay);
81:  const [participants, setParticipants] = useState<MeetingNoteParticipant[]>(initial.participants);
82:  const contentRef = useRef(initial.content);
83:  const [clientErrors, setClientErrors] = useState<FieldErrors>({});
84:  const [lastSubmitError, setLastSubmitError] = useState<unknown>(null);
85:
86:  // A new server error replaces the client-side ones until the next submit.
87:  const serverField = submitError && submitError !== lastSubmitError ? meetingNoteFieldError(submitError) : null;
88:  const errors: FieldErrors = serverField ? { ...clientErrors, [serverField.field]: serverField.message } : 
clientErrors;
89:  const formError =
90:    submitError && submitError !== lastSubmitError && !serverField ? describeMeetingNoteError(submitError) : null;
91:
92:  const focusField = (field: MeetingNoteFormField) => {
93:    const target =
94:      field === 'title' ? ids.title : field === 'date' ? ids.date : field === 'content' ? ids.editor : null;
95:    if (target) document.getElementById(target)?.focus();
96:  };
97:
98:  const validate = (): { fields: MeetingNoteFieldsPayload | null; errors: FieldErrors } => {
99:    const next: FieldErrors = {};
100:    const trimmedTitle = title.trim();
101:    const titleLength = codePointLength(trimmedTitle);
102:    if (titleLength < 1 || titleLength > MEETING_NOTE_LIMITS.titleMaxChars) {
103:      next.title = titleLength < 1 ? 'Enter a title.' : 'The title can have at most 200 characters.';
104:    }
105:    const meetingDate =
106:      day === initialDay && initial.meetingDate ? initial.meetingDate : meetingDateFromLocalDay(day);
107:    if (!meetingDate) next.date = 'Choose the meeting date.';
108:    if (participants.length > MEETING_NOTE_LIMITS.maxParticipants) {
109:      next.participants = 'A note can have at most 50 participants.';
110:    }
111:    const content = contentRef.current;
112:    if (codePointLength(sanitizeMeetingNoteHtml(content)) > MEETING_NOTE_LIMITS.contentMaxChars) {
113:      next.content = 'The notes are too long (at most 100,000 characters).';
114:    }
115:    if (Object.keys(next).length > 0 || !meetingDate) return { fields: null, errors: next };
116:    return {
117:      fields: {
118:        title: trimmedTitle,
119:        meetingDate,
120:        content,
121:        participantIds: participants.map((participant) => participant.userId),
122:      },
123:      errors: next,
124:    };
125:  };
126:
127:  const handleSubmit = (event: FormEvent<HTMLFormElement>) => {
128:    event.preventDefault();
129:    if (submitting) return;
130:    const result = validate();
131:    setClientErrors(result.errors);
132:    setLastSubmitError(submitError);
133:    if (!result.fields) {
134:      const first = (['title', 'date', 'participants', 'content'] as const).find((field) => result.errors[field]);
135:      if (first) focusField(first);
136:      return;
137:    }
138:    onSubmit(result.fields);
139:  };
140:
141:  const fieldError = (id: string, message: string | undefined) =>
142:    message ? (
143:      <p id={id} className="text-xs text-destructive" role="alert">
144:        {message}
145:      </p>
146:    ) : null;
147:
148:  return (
149:    <form className="flex flex-col gap-5" noValidate onSubmit={handleSubmit} aria-busy={submitting} 
data-testid="meeting-note-form">
150:      {header}
151:
152:      <div className="flex flex-col gap-1.5">
153:        <Label htmlFor={ids.title}>Title</Label>
154:        <Input
155:          id={ids.title}
156:          value={title}
157:          required
158:          aria-invalid={errors.title ? 'true' : 'false'}
159:          aria-describedby={errors.title ? ids.titleError : undefined}
160:          onChange={(event) => setTitle(event.target.value)}
161:          disabled={submitting}
162:        />
163:        {fieldError(ids.titleError, errors.title)}
164:      </div>
165:
166:      <div className="flex flex-col gap-1.5">
167:        <Label htmlFor={ids.date}>Meeting date</Label>
168:        <Input
169:          id={ids.date}
170:          type="date"
171:          className="w-48"
172:          value={day}
173:          required
174:          aria-invalid={errors.date ? 'true' : 'false'}
175:          aria-describedby={errors.date ? ids.dateError : undefined}
176:          onChange={(event) => setDay(event.target.value)}
177:          disabled={submitting}
178:        />
179:        {fieldError(ids.dateError, errors.date)}
180:      </div>
181:
182:      <div className="flex flex-col gap-1.5">
183:        <span id={ids.participantsLabel} className="text-sm font-medium leading-none">
184:          Participants
185:        </span>
186:        <MeetingNoteParticipantPicker
187:          labelId={ids.participantsLabel}
188:          describedById={errors.participants ? ids.participantsError : undefined}
189:          value={participants}
190:          members={members}
191:          disabled={submitting}
192:          onChange={setParticipants}
193:        />
194:        {fieldError(ids.participantsError, errors.participants)}
195:      </div>
196:
197:      <div className="flex flex-col gap-1.5">
198:        <span id={ids.contentLabel} className="text-sm font-medium leading-none">
199:          Notes
200:        </span>
201:        <MeetingNoteRichTextEditorLazy
202:          id={ids.editor}
203:          labelId={ids.contentLabel}
204:          describedById={errors.content ? ids.contentError : undefined}
205:          initialContent={initial.content}
206:          invalid={Boolean(errors.content)}
207:          disabled={submitting}
208:          onChange={(html) => {
209:            contentRef.current = html;
210:          }}
211:        />
212:        {fieldError(ids.contentError, errors.content)}
213:      </div>
214:
215:      {formError ? (
216:        <p className="rounded-md border border-destructive/40 bg-destructive/10 px-3 py-2 text-sm 
text-destructive" role="alert">
217:          {formError}
218:        </p>
219:      ) : null}
220:
221:      <div className="flex items-center justify-end gap-2">
222:        <Button type="button" variant="ghost" onClick={onCancel} disabled={submitting}>
223:          Cancel
224:        </Button>
225:        <Button type="submit" disabled={submitting} data-testid="meeting-note-submit">
226:          {submitting ? <Loader2 className="mr-2 size-4 animate-spin" aria-hidden="true" /> : null}
227:          {submitLabel}
228:        </Button>
229:      </div>
230:    </form>
231:  );
232:}
