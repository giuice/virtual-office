2:// Escaping of user and AI text written into a Markdown export (FR-027,
3:// AC-003, SPEC §12). Every character that could start raw HTML becomes an
4:// entity (`<` `>` `&`), so the .md never contains a `<` from user text; the
5:// inline Markdown syntax characters are backslash-escaped, so text can never
6:// form a link, image, emphasis, code span, table cell, or strikethrough; and
7:// the block markers a line may start with (headings, list items, setext
8:// underlines, ordered-list numbers) are escaped at the start of every line.
9:// Escaping more than strictly needed is always safe; escaping less is not.
10:
11:const ENTITIES: Readonly<Record<string, string>> = { '<': '&lt;', '>': '&gt;', '&': '&amp;' };
12:
13:/** Characters escaped wherever they appear. */
14:const ALWAYS_ESCAPED = /[\\`*_[\]~|<>&]/g;
15:
16:/** Block markers that only matter at the start of a line (after optional spaces). */
17:const LINE_START_MARKER = /^(\s*)([#+\-=])/;
18:const LINE_START_ORDERED = /^(\s*\d+)([.)])/;
19:
20:function escapeAlways(text: string): string {
21:  return text.replace(ALWAYS_ESCAPED, (char) => ENTITIES[char] ?? `\\${char}`);
22:}
23:
24:function escapeLineStart(line: string): string {
25:  return line.replace(LINE_START_MARKER, '$1\\$2').replace(LINE_START_ORDERED, '$1\\$2');
26:}
27:
28:/**
29: * Escapes a run of text that sits inside a line. `atLineStart` says whether
30: * the run may begin a line (it then also escapes the block markers).
31: */
32:export function escapeMarkdownText(text: string, atLineStart: boolean): string {
33:  const escaped = escapeAlways(text);
34:  return atLineStart ? escapeLineStart(escaped) : escaped;
35:}
36:
37:/** One-line plain text (a title or a name): whitespace runs collapse to one space. */
38:export function escapeMarkdownLine(text: string): string {
39:  return escapeMarkdownText(text.replace(/\s+/g, ' ').trim(), true);
40:}
41:
42:/**
43: * Multi-line plain text (a summary, an item description, a transcript): blank
44: * lines separate paragraphs, other line breaks are kept as hard breaks, and
45: * every line is escaped as a possible line start. Lines after the first get
46: * `indent` (to continue a list item).
47: */
48:export function escapeMarkdownBlock(text: string, indent = ''): string {
49:  const paragraphs: string[][] = [[]];
50:  for (const raw of text.replace(/\r\n?/g, '\n').split('\n')) {
51:    const line = raw.replace(/[\t\f\v]/g, ' ').trim();
52:    if (line === '') {
53:      if (paragraphs[paragraphs.length - 1].length > 0) paragraphs.push([]);
54:      continue;
55:    }
56:    paragraphs[paragraphs.length - 1].push(escapeLineStart(escapeAlways(line)));
57:  }
58:  return paragraphs
59:    .filter((lines) => lines.length > 0)
60:    .map((lines) => lines.join(`\\\n${indent}`))
61:    .join(`\n\n${indent}`);
