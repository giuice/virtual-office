75:      ) : (
76:        <ul className="flex flex-wrap gap-2" data-testid="meeting-note-participant-picker-list">
77:          {value.map((participant) => {
78:            const member = participant.isCurrentMember ? membersById.get(participant.userId) : undefined;
79:            return (
80:              <li
81:                key={participant.userId}
82:                className="flex items-center gap-2 rounded-full border border-[var(--vo-line-soft)] 
bg-[var(--vo-bg-2)] py-1 pl-1 pr-1.5 text-sm"
83:                data-testid="meeting-note-participant-chip"
84:                data-former-member={participant.isCurrentMember ? undefined : 'true'}
85:              >
86:                <EnhancedAvatarV2 user={member ?? null} fallbackName={participant.displayName} size="sm" 
className="size-6" />
87:                <span className="max-w-[12rem] truncate">{participant.displayName}</span>
88:                {participant.isCurrentMember ? null : (
89:                  <Badge variant="outline" className="text-[10px]">
90:                    Former member
91:                  </Badge>
92:                )}
93:                <button
94:                  type="button"
95:                  className="inline-flex size-6 items-center justify-center rounded-full text-muted-foreground 
hover:bg-[var(--vo-hover-bg)] hover:text-foreground focus-visible:outline-none focus-visible:ring-2 
focus-visible:ring-ring disabled:opacity-40"
96:                  aria-label={`Remove ${participant.displayName}`}
97:                  disabled={disabled}
98:                  onClick={() => remove(participant.userId)}
99:                >
100:                  <X className="size-3.5" aria-hidden="true" />
101:                </button>
102:              </li>
103:            );
104:          })}
105:        </ul>
106:      )}
107:
108:      <div className="flex items-center gap-3">
109:        <Popover
110:          open={open}
111:          onOpenChange={(next) => {
112:            setOpen(next);
113:            if (!next) setQuery('');
114:          }}
115:        >
116:          <PopoverTrigger asChild>
117:            <Button type="button" size="sm" variant="outline" className="h-8 gap-1.5" disabled={disabled || full}>
118:              <Plus className="size-3.5" aria-hidden="true" />
119:              Add participants
120:            </Button>
121:          </PopoverTrigger>
122:          <PopoverContent align="start" className="w-80 p-2" onKeyDown={(event) => event.stopPropagation()}>
123:            <div className="relative">
124:              <Search
125:                className="pointer-events-none absolute left-2.5 top-1/2 size-4 -translate-y-1/2 
text-muted-foreground"
126:                aria-hidden="true"
127:              />
128:              <Input
129:                value={query}
130:                onChange={(event) => setQuery(event.target.value)}
131:                placeholder="Search members"
132:                aria-label="Search members"
133:                className="h-9 pl-8"
134:                autoComplete="off"
135:              />
136:            </div>
137:            {candidates.length === 0 ? (
138:              <p className="px-2 py-3 text-sm text-muted-foreground">
139:                {members.length === 0 ? 'Members are still loading.' : 'No other members match.'}
140:              </p>
141:            ) : (
142:              <ul className="mt-2 max-h-64 overflow-y-auto" aria-label="Company members">
143:                {candidates.map((member) => (
144:                  <li key={member.id}>
145:                    <button
146:                      type="button"
147:                      className="flex w-full items-center gap-2 rounded-md px-2 py-1.5 text-left text-sm 
hover:bg-[var(--vo-hover-bg)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring 
disabled:opacity-40"
148:                      aria-label={`Add ${member.displayName}`}
149:                      disabled={full}
150:                      onClick={() => add(member)}
151:                      data-testid="meeting-note-participant-option"
152:                    >
153:                      <EnhancedAvatarV2 user={member} size="sm" className="size-6" />
154:                      <span className="min-w-0 flex-1 truncate">{member.displayName}</span>
