4:const meetingDateFormatter = new Intl.DateTimeFormat(undefined, { dateStyle: 'medium' });
5:
6:/** The meeting date as a local calendar date; the raw value when unparsable. */
7:export function formatMeetingDate(value: string): string {
8:  const parsed = new Date(value);
9:  return Number.isNaN(parsed.getTime()) ? value : meetingDateFormatter.format(parsed);
10:}
11:
12:/** Label of a note's space; null roomId means the space was deleted (FR-028). */
13:export function meetingNoteSpaceLabel(
14:  roomId: string | null,
15:  spaceNames: ReadonlyMap<string, string>
16:): { label: string; removed: boolean } {
17:  if (roomId === null) return { label: 'Space removed', removed: true };
18:  return { label: spaceNames.get(roomId) ?? 'Unknown space', removed: false };
19:}
20:
21:const timestampFormatter = new Intl.DateTimeFormat(undefined, { dateStyle: 'medium', timeStyle: 'short' });
22:
23:/** A change time (version, last update) in the viewer's local time; the raw value when unparsable. */
24:export function formatMeetingNoteTimestamp(value: string): string {
25:  const parsed = new Date(value);
26:  return Number.isNaN(parsed.getTime()) ? value : timestampFormatter.format(parsed);
27:}
28:
29:const DATE_ONLY = /^\d{4}-\d{2}-\d{2}$/;
30:
31:/**
32: * An action item's due date (FR-011, AC-009). It is a calendar date, not an
33: * instant: it is shown exactly as stored ('YYYY-MM-DD') and never passes
34: * through `Date`, so no time zone can move it to another day. null when the
35: * value is not a date-only string.
36: */
37:export function formatMeetingNoteDueDate(value: string | null): string | null {
38:  return value !== null && DATE_ONLY.test(value) ? value : null;
39:}
