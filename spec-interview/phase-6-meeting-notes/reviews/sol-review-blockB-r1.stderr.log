1:// src/lib/meeting-notes/content-sanitizer.ts
2:// Phase 6 FR-002 / AC-003: the single allow-list for meeting-note rich text.
3:// Used on write by the API routes and meant for reuse on render (T6), so it
4:// must stay isomorphic (no server-only imports).
5://
6:// Allowed: paragraphs, line breaks, headings, bold/strong, italic/em, bulleted
7:// and numbered lists, list items, the task-list markup Tiptap's TaskList /
8:// TaskItem emit (ul[data-type="taskList"], li[data-type="taskItem"][data-checked],
9:// label > input[type=checkbox] + span, div), and links whose href is
10:// http, https, or mailto. Everything else is removed: scripts, styles, event
11:// handlers, iframes, images, forms, classes, inline styles, and any other
12:// URL scheme (javascript:, data:, vbscript:, relative or protocol-relative).
13:import sanitizeHtml from 'sanitize-html';
14:
15:const SAFE_HREF = /^(?:https?:\/\/|mailto:)/i;
16:
17:/** Rel set on every surviving link. */
18:export const MEETING_NOTE_LINK_REL = 'noopener noreferrer nofollow';
19:
20:export const MEETING_NOTE_SANITIZE_OPTIONS: sanitizeHtml.IOptions = {
21:  allowedTags: [
22:    'p',
23:    'br',
24:    'h1',
25:    'h2',
26:    'h3',
27:    'h4',
28:    'h5',
29:    'h6',
30:    'strong',
31:    'b',
32:    'em',
33:    'i',
34:    'ul',
35:    'ol',
36:    'li',
37:    'a',
38:    'label',
39:    'input',
40:    'span',
41:    'div',
42:  ],
43:  allowedAttributes: {
44:    a: ['href', 'rel', { name: 'target', multiple: false, values: ['_blank'] }],
45:    ol: ['start'],
46:    ul: [{ name: 'data-type', multiple: false, values: ['taskList'] }],
47:    li: [
48:      { name: 'data-type', multiple: false, values: ['taskItem'] },
49:      { name: 'data-checked', multiple: false, values: ['true', 'false'] },
50:    ],
51:    input: [
52:      { name: 'type', multiple: false, values: ['checkbox'] },
53:      'checked',
54:      'disabled',
55:    ],
56:  },
57:  allowedSchemes: ['http', 'https', 'mailto'],
58:  allowedSchemesByTag: {},
59:  allowedSchemesAppliedToAttributes: ['href'],
60:  allowProtocolRelative: false,
61:  // Drop the CONTENT of these too, not only the tags.
62:  nonTextTags: ['script', 'style', 'textarea', 'option', 'noscript', 'iframe', 'object', 'embed', 'template', 
'svg', 'math'],
63:  disallowedTagsMode: 'discard',
64:  enforceHtmlBoundary: false,
65:  parseStyleAttributes: false,
66:  transformTags: {
67:    a: (tagName, attribs) => {
68:      const href = (attribs.href ?? '').trim();
69:      const next: sanitizeHtml.Attributes = {};
70:      if (SAFE_HREF.test(href)) {
71:        next.href = href;
72:        next.rel = MEETING_NOTE_LINK_REL;
73:        if (attribs.target === '_blank') next.target = '_blank';
74:      }
75:      return { tagName, attribs: next };
76:    },
77:    ol: (tagName, attribs) => {
78:      const next: sanitizeHtml.Attributes = {};
79:      if (attribs.start !== undefined && /^\d{1,6}$/.test(attribs.start)) next.start = attribs.start;
80:      return { tagName, attribs: next };
81:    },
82:  },
83:  // Only checkbox inputs survive (an input whose type is not exactly
84:  // "checkbox" is removed with its attributes).
85:  exclusiveFilter: (frame) => frame.tag === 'input' && frame.attribs.type !== 'checkbox',
86:};
87:
88:/** Sanitizes meeting-note rich text with the allow-list above. */
89:export function sanitizeMeetingNoteHtml(html: string): string {
90:  // NUL is invalid in Postgres text and replaced by browsers anyway. A lone
91:  // surrogate cannot be stored either and becomes U+FFFD, as the parser
92:  // already does for a surrogate character reference such as &#xD800;.
93:  return sanitizeHtml(html.replace(/\u0000/g, '').toWellFormed(), MEETING_NOTE_SANITIZE_OPTIONS);
94:}
95:
96:const DISPLAY_SANITIZE_OPTIONS: sanitizeHtml.IOptions = {
97:  ...MEETING_NOTE_SANITIZE_OPTIONS,
98:  transformTags: {
99:    ...MEETING_NOTE_SANITIZE_OPTIONS.transformTags,
100:    // A read view never toggles a checklist: the stored state is shown only.
101:    // The allow-list above still filters the result (type, checked, disabled).
102:    input: (tagName, attribs) => ({ tagName, attribs: { ...attribs, disabled: 'disabled' } }),
103:  },
104:};
105:
106:/**
107: * Render-side sanitization (FR-002, AC-003): the same allow-list as on write,
108: * run again on whatever the server returned before it reaches
109: * dangerouslySetInnerHTML; checklist boxes are made read-only.
110: */
111:export function sanitizeMeetingNoteHtmlForDisplay(html: string): string {
112:  return sanitizeHtml(html.replace(/\u0000/g, '').toWellFormed(), DISPLAY_SANITIZE_OPTIONS);
113:}
src/lib/meeting-notes/link-url.ts
1:// src/lib/meeting-notes/link-url.ts
2:// Links a meeting note may hold (FR-002): http, https, and mailto only — the
3:// same schemes the content sanitizer keeps. Used by the editor so a link the
4:// sanitizer would drop is never created in the first place.
5:
6:const SAFE_LINK_HREF = /^(?:https?:\/\/[^\s]+|mailto:[^\s]+)$/i;
7:const EMAIL = /^[^\s@/:]+@[^\s@/:]+\.[^\s@/:]+$/;
8:const BARE_HOST = /^[a-z0-9-]+(?:\.[a-z0-9-]+)+(?::\d+)?(?:[/?#][^\s]*)?$/i;
9:
10:/** true for an absolute http, https, or mailto URL. */
11:export function isSafeMeetingNoteLink(href: string): boolean {
12:  return SAFE_LINK_HREF.test(href.trim());
13:}
14:
15:/**
16: * What a user typed in the link field → a safe href: "example.com/x" gains
17: * https://, "ana@example.com" gains mailto:; null for anything else
18: * (javascript:, data:, relative paths, other schemes).
19: */
20:export function normalizeMeetingNoteLinkInput(raw: string): string | null {
21:  const value = raw.trim();
22:  if (!value) return null;
23:  if (isSafeMeetingNoteLink(value)) return value;
24:  if (EMAIL.test(value)) return `mailto:${value}`;
25:  if (BARE_HOST.test(value)) return `https://${value}`;
26:  return null;
27:}

