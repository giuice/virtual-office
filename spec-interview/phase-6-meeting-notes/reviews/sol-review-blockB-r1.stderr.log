32:const ISO_DATE = /^\d{4}-\d{2}-\d{2}$/;
33:
34:/** A real calendar date 'YYYY-MM-DD' that Postgres accepts (no year 0000: 22008). */
35:function isCalendarDate(value: string): boolean {
36:  if (!ISO_DATE.test(value) || value.startsWith('0000')) return false;
37:  const parsed = new Date(`${value}T00:00:00Z`);
38:  return !Number.isNaN(parsed.getTime()) && parsed.toISOString().slice(0, 10) === value;
39:}
40:
41:const ISO_OFFSET = /([+-])(\d{2}):(\d{2})$/;
42:
43:/**
44: * An ISO date-time (already accepted by z.iso.datetime) that Postgres
45: * timestamptz accepts too: zod allows year 0000 (Postgres 22008) and offsets
46: * up to ±23:59 (Postgres allows at most ±15:59, else 22009).
47: */
48:function isPostgresDateTime(value: string): boolean {
49:  if (value.startsWith('0000')) return false;
50:  const offset = ISO_OFFSET.exec(value);
51:  return offset === null || Number(offset[2]) <= 15;
52:}
