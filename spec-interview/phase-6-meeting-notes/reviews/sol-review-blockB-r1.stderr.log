384:export const MEETING_NOTE_AI_CAPABILITIES: Readonly<Record<MeetingNoteAiProvider, 
MeetingNoteAiProviderCapability>> = {
385:  anthropic: ANTHROPIC,
386:  openai: OPENAI,
387:  kimi: KIMI,
388:  glm: GLM,
389:};
390:
391:/** Provider order shown to admins. */
392:const PROVIDER_ORDER: readonly MeetingNoteAiProvider[] = ['anthropic', 'openai', 'kimi', 'glm'];
393:
394:export function findMeetingNoteAiModel(
395:  provider: MeetingNoteAiProvider,
396:  modelId: string
397:): MeetingNoteAiModelCapability | null {
398:  return MEETING_NOTE_AI_CAPABILITIES[provider].models.find((model) => model.id === modelId) ?? null;
399:}
400:
401:/** Whether an admin's provider/model/reasoning choice is in the matrix. */
402:export function checkMeetingNoteAiSelection(
403:  provider: MeetingNoteAiProvider,
404:  modelId: string,
405:  reasoningLevel: string
406:): 'ok' | 'MEETING_NOTE_AI_MODEL_INVALID' | 'MEETING_NOTE_AI_REASONING_INVALID' {
407:  const model = findMeetingNoteAiModel(provider, modelId);
408:  if (!model) return 'MEETING_NOTE_AI_MODEL_INVALID';
409:  return model.reasoningLevels.some((level) => level.id === reasoningLevel) ? 'ok' : 
'MEETING_NOTE_AI_REASONING_INVALID';
410:}
411:
412:/** The non-secret part of the matrix the admin form needs (no wire data, URLs, or rejections). */
413:export function meetingNoteAiProviderOptions(): MeetingNoteAiProviderOption[] {
414:  return PROVIDER_ORDER.map((id) => {
415:    const provider = MEETING_NOTE_AI_CAPABILITIES[id];
416:    return {
417:      id,
418:      label: provider.label,
419:      models: provider.models.map(
420:        (model): MeetingNoteAiModelOption => ({
421:          id: model.id,
422:          label: model.label,
423:          reasoningLevels: model.reasoningLevels.map(({ id: levelId, label }) => ({ id: levelId, label })),
424:          defaultReasoningLevel: model.defaultReasoningLevel,
425:          contextWindowTokens: model.contextWindowTokens,
426:          maxOutputTokens: model.maxOutputTokens,
427:        })
428:      ),
429:    };
430:  });
431:}
