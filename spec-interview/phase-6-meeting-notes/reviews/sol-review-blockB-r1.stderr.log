367:export interface MeetingNoteMarkdownFile {
368:  blob: Blob;
369:  filename: string;
370:}
371:
372:/** The download name the route chose (`filename*` first), or a fallback. */
373:function filenameFrom(disposition: string | null): string {
374:  const fallback = 'meeting-note.md';
375:  if (!disposition) return fallback;
376:  const extended = /filename\*=UTF-8''([^;]+)/i.exec(disposition);
377:  if (extended) {
378:    try {
379:      return decodeURIComponent(extended[1].trim()) || fallback;
380:    } catch {
381:      // Malformed encoding: use the plain name.
382:    }
383:  }
384:  const plain = /filename="([^"]+)"/i.exec(disposition);
385:  return plain?.[1] || fallback;
386:}
