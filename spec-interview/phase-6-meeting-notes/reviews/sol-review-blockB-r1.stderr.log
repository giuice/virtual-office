672:        await new Promise((resolve) => setTimeout(resolve, 100));
673:      }
674:      expect(payloads.some((p) => p.includes(marker2))).toBe(true);
675:      await new Promise((resolve) => setTimeout(resolve, 1000));
676:      for (const payload of payloads) expectNoCanary(payload);
677:    } finally {
678:      if (channel) await (channel as RealtimeChannel).unsubscribe();
679:    }
680:  });
681:
682:  it('AC-017: no captured server log line contains a canary key', () => {
683:    expect(canaries.length).toBeGreaterThan(5);
684:    // The routes ran (and logged their refusals) in this file.
685:    expect(logLines.some((line) => line.includes('/api/companies/ai-settings') || 
line.includes('aiSettings'))).toBe(true);
686:    for (const line of logLines) expectNoCanary(line);
687:  });
