206:/** GET /api/meeting-notes — one space's notes, newest meeting date first. */
207:export function fetchSpaceMeetingNotes(
208:  spaceId: string,
209:  cursor: number,
210:  signal?: AbortSignal
211:): Promise<MeetingNotesPage<MeetingNoteListItem>> {
212:  const params = new URLSearchParams({
213:    spaceId,
214:    limit: String(SPACE_NOTES_PAGE_SIZE),
215:    cursor: String(cursor),
216:  });
217:  return getPage<MeetingNoteListItem>(`/api/meeting-notes?${params.toString()}`, signal);
218:}
