90:const RFC5987_UNSAFE = /['()*!]/g;
91:
92:/**
93: * Download names for a note's export: an ASCII slug for `filename` and the
94: * readable UTF-8 title for `filename*`; both end with the meeting day.
95: */
96:export function meetingNoteExportFilenames(title: string, day: string | null): { ascii: string; utf8: string } {
97:  const suffix = day && DATE_ONLY.test(day) ? `-${day}` : '';
98:  const slug =
99:    title
100:      .normalize('NFKD')
101:      .replace(/[̀-ͯ]/g, '')
102:      .toLowerCase()
103:      .replace(/[^a-z0-9]+/g, '-')
104:      .replace(/^-+|-+$/g, '')
105:      .slice(0, 80)
106:      .replace(/-+$/, '') || 'meeting-note';
107:  const readable =
108:    Array.from(
109:      title
110:        .toWellFormed()
111:        .replace(/[\u0000-\u001f\u007f-\u009f"\\/:*?<>|]/g, ' ')
112:        .replace(/\s+/g, ' ')
113:        .trim()
114:    )
115:      .slice(0, 120)
116:      .join('')
117:      .trim()
118:      .replace(/^\.+/, '') || 'Meeting note';
119:  return { ascii: `${slug}${suffix}.md`, utf8: `${readable}${day && DATE_ONLY.test(day) ? ` ${day}` : ''}.md` };
120:}
121:
122:/** `Content-Disposition` for the export download. */
123:export function meetingNoteExportContentDisposition(names: { ascii: string; utf8: string }): string {
124:  const encoded = encodeURIComponent(names.utf8).replace(
125:    RFC5987_UNSAFE,
126:    (char) => `%${char.charCodeAt(0).toString(16).toUpperCase()}`
127:  );
128:  return `attachment; filename="${names.ascii}"; filename*=UTF-8''${encoded}`;
129:}
