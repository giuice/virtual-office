106:}
107:
108:function invalidResponse(status = 200): MeetingNotesApiError {
109:  return new MeetingNotesApiError(status, 'INVALID_RESPONSE', 'Unexpected response from the server.');
110:}
111:
112:function isNoteDetail(value: unknown): value is MeetingNoteDetail {
113:  const note = asRecord(value);
114:  return (
115:    typeof note.id === 'string' &&
116:    typeof note.revision === 'number' &&
117:    typeof note.title === 'string' &&
118:    typeof note.content === 'string' &&
119:    Array.isArray(note.participants) &&
120:    typeof note.rights === 'object' &&
121:    note.rights !== null
122:  );
123:}
124:
125:function isItemView(value: unknown): value is MeetingNoteActionItemView {
126:  const item = asRecord(value);
127:  return (
128:    typeof item.id === 'string' &&
129:    typeof item.noteId === 'string' &&
130:    typeof item.description === 'string' &&
131:    typeof item.revision === 'number' &&
132:    typeof item.completed === 'boolean'
133:  );
134:}
135:
136:/** The error a failed response stands for; a stale-revision 409 with its note or item becomes a conflict. */
137:async function toApiError(response: Response): Promise<MeetingNotesApiError> {
138:  let body: Record<string, unknown> = {};
139:  try {
140:    body = asRecord(await response.json());
141:  } catch {
142:    // Non-JSON error body.
143:  }
144:  const code = typeof body.code === 'string' ? body.code : `HTTP_${response.status}`;
145:  const message = typeof body.error === 'string' ? body.error : `Request failed (${response.status})`;
146:  if (response.status === 409 && code === 'MEETING_NOTE_STALE_REVISION' && isNoteDetail(body.note)) {
147:    const currentRevision = typeof body.currentRevision === 'number' ? body.currentRevision : body.note.revision;
148:    return new MeetingNoteConflictError(message, currentRevision, body.note);
149:  }
150:  if (response.status === 409 && code === 'MEETING_NOTE_ITEM_STALE_REVISION' && isItemView(body.item)) {
151:    const currentRevision = typeof body.currentRevision === 'number' ? body.currentRevision : body.item.revision;
152:    return new MeetingNoteItemConflictError(message, currentRevision, body.item);
153:  }
154:  return new MeetingNotesApiError(response.status, code, message);
155:}
156:
157:/** One JSON request to a meeting-note route; any failure becomes a MeetingNotesApiError. */
158:async function requestJson(url: string, init: RequestInit = {}): Promise<unknown> {
159:  let response: Response;
160:  try {
161:    response = await fetch(url, {
162:      ...init,
163:      credentials: 'same-origin',
164:      cache: 'no-store',
165:      headers: init.body !== undefined ? { 'Content-Type': 'application/json' } : undefined,
166:    });
167:  } catch (error) {
168:    if (init.signal?.aborted) throw error;
169:    throw new MeetingNotesApiError(0, 'NETWORK_ERROR', 'Could not reach the server.');
170:  }
171:  if (!response.ok) throw await toApiError(response);
172:  try {
173:    return await response.json();
174:  } catch {
175:    throw invalidResponse(response.status);
176:  }
177:}
178:
179:function toPage<T>(body: PaginatedResult<T>): MeetingNotesPage<T> {
180:  if (!body || !Array.isArray(body.items)) throw invalidResponse();
181:  const cursor = typeof body.nextCursor === 'number' ? body.nextCursor : Number(body.nextCursor);
182:  const hasMore = body.hasMore === true && Number.isInteger(cursor) && cursor >= 0;
183:  return {
184:    items: body.items,
185:    nextCursor: hasMore ? cursor : null,
186:    hasMore,
187:    totalCount: typeof body.totalCount === 'number' ? body.totalCount : null,
188:  };
189:}
190:
191:async function getPage<T>(url: string, signal?: AbortSignal): Promise<MeetingNotesPage<T>> {
192:  const body = await requestJson(url, { method: 'GET', signal });
193:  return toPage(body as PaginatedResult<T>);
194:}
195:
196:function readNote(body: unknown): MeetingNoteDetail {
197:  const note = asRecord(body).note;
198:  if (!isNoteDetail(note)) throw invalidResponse();
199:  return note;
200:}
