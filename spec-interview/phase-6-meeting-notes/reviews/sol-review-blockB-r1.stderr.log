113:export async function DELETE(request: NextRequest, { params }: RouteParams): Promise<NextResponse> {
114:  const begun = await beginMeetingNoteRequest(PATH, 'meeting-note:write');
115:  if (!begun.ok) return begun.response;
116:  const ctx = begun.value;
117:
118:  const id = parsePathId((await params).id, 'MEETING_NOTE_NOT_FOUND', ctx);
119:  if (!id.ok) return id.response;
120:
121:  const revision = parseWith(
122:    expectedRevisionParamSchema('MEETING_NOTE_REVISION_REQUIRED'),
123:    request.nextUrl.searchParams.get('expectedRevision') ?? undefined,
124:    ctx
125:  );
126:  if (!revision.ok) return revision.response;
127:
128:  try {
129:    await ctx.repository.deleteNote(id.value, revision.value);
130:    return ok({ noteId: id.value, deleted: true }, ctx);
131:  } catch (error) {
132:    return noteMutationErrorResponse(error, ctx, id.value, 'meetingNotes.delete');
