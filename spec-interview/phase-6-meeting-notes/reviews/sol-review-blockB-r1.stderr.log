70:const saveBodySchema = z
71:  .object({
72:    expectedRevision: z
73:      .number()
74:      .int()
75:      .min(1)
76:      .max(Number.MAX_SAFE_INTEGER)
77:      .nullable()
78:      .refine((value) => value !== undefined, 'MEETING_NOTE_AI_REVISION_INVALID'),
79:    provider: z.enum(['anthropic', 'openai', 'kimi', 'glm'], { message: 'MEETING_NOTE_AI_PROVIDER_INVALID' }),
80:    model: z.string({ message: 'MEETING_NOTE_AI_MODEL_INVALID' }).min(1, 'MEETING_NOTE_AI_MODEL_INVALID').max(100, 
'MEETING_NOTE_AI_MODEL_INVALID'),
81:    reasoningLevel: z
82:      .string({ message: 'MEETING_NOTE_AI_REASONING_INVALID' })
83:      .min(1, 'MEETING_NOTE_AI_REASONING_INVALID')
84:      .max(32, 'MEETING_NOTE_AI_REASONING_INVALID'),
85:    dailyLimit: z
86:      .number({ message: 'MEETING_NOTE_AI_DAILY_LIMIT_INVALID' })
87:      .int('MEETING_NOTE_AI_DAILY_LIMIT_INVALID')
88:      .min(MEETING_NOTE_AI_MIN_DAILY_LIMIT, 'MEETING_NOTE_AI_DAILY_LIMIT_INVALID')
89:      .max(MEETING_NOTE_AI_MAX_DAILY_LIMIT, 'MEETING_NOTE_AI_DAILY_LIMIT_INVALID'),
90:    // Write-only. null/absent keeps the stored key. Never trimmed or echoed.
91:    apiKey: z
92:      .string({ message: 'MEETING_NOTE_AI_KEY_INVALID' })
93:      .refine(isPlausibleAiApiKey, 'MEETING_NOTE_AI_KEY_INVALID')
94:      .nullable()
95:      .optional(),
96:  })
97:  .strict();
