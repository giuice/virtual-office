55:    }
56:    const chain = editor.chain().focus().extendMarkRange('link');
57:    if (editor.state.selection.empty && !active) {
58:      // No selected text: insert the address itself as the link text.
59:      chain.insertContent({ type: 'text', text: href, marks: [{ type: 'link', attrs: { href } }] }).run();
60:    } else {
61:      chain.setLink({ href }).run();
62:    }
63:    setOpen(false);
64:  };
65:
66:  const remove = () => {
67:    editor?.chain().focus().extendMarkRange('link').unsetLink().run();
68:    setOpen(false);
