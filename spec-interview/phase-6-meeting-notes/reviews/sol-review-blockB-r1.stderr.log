181:/** 500 without SQL, details, or request data (they could carry note text). */
182:export function internalError(error: unknown, ctx: { correlationId: string }, context: string): NextResponse {
183:  const cause =
184:    error instanceof MeetingNoteDbError
185:      ? { code: error.sqlstate, message: error.token ?? 'unexpected database error' }
186:      : { message: error instanceof Error ? error.name : 'unknown' };
187:  return jsonError(500, 'INTERNAL_ERROR', 'Something went wrong. Please try again.', {
188:    correlationId: ctx.correlationId,
189:    cause,
190:    context,
191:  });
192:}
