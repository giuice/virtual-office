1:// src/lib/meeting-notes/form-errors.ts
2:// User-facing text for meeting-note request failures, and which form field a
3:// route's 400 code belongs to (FR-001, AC-002). The route stays the authority;
4:// this only places its answer next to the right field.
5:import { MeetingNotesApiError } from './client-api';
6:
7:export type MeetingNoteFormField = 'title' | 'date' | 'participants' | 'content';
8:
9:const FIELD_ERRORS: Record<string, { field: MeetingNoteFormField; message: string }> = {
10:  MEETING_NOTE_TITLE_INVALID: { field: 'title', message: 'Enter a title of 1 to 200 characters.' },
11:  MEETING_NOTE_DATE_REQUIRED: { field: 'date', message: 'Choose the meeting date.' },
12:  MEETING_NOTE_CONTENT_TOO_LONG: { field: 'content', message: 'The notes are too long (at most 100,000 
characters).' },
13:  MEETING_NOTE_CONTENT_REQUIRED: { field: 'content', message: 'The notes could not be read. Try again.' },
14:  MEETING_NOTE_TOO_MANY_PARTICIPANTS: { field: 'participants', message: 'A note can have at most 50 participants.' 
},
15:  MEETING_NOTE_PARTICIPANTS_INVALID: { field: 'participants', message: 'The participant list is invalid. Remove and 
add them again.' },
16:  MEETING_NOTE_PARTICIPANT_NOT_MEMBER: {
17:    field: 'participants',
18:    message: 'Someone you added is no longer a member of your company. Remove them and try again.',
19:  },
20:};
21:
22:/** The field a failed save points at, or null when it is not about one field. */
23:export function meetingNoteFieldError(error: unknown): { field: MeetingNoteFormField; message: string } | null {
24:  if (!(error instanceof MeetingNotesApiError) || error.status !== 400) return null;
25:  return FIELD_ERRORS[error.code] ?? null;
26:}
27:
28:/** What happened and what to do, for a failed note change. */
29:export function describeMeetingNoteError(error: unknown): string {
30:  if (error instanceof MeetingNotesApiError) {
31:    const field = meetingNoteFieldError(error);
32:    if (field) return field.message;
33:    switch (error.status) {
34:      case 0:
35:        return 'Could not reach the server. Check your connection and try again.';
36:      case 401:
37:        return 'Your session has ended. Sign in again to continue.';
38:      case 403:
39:        return 'You do not have permission to change this note.';
40:      case 404:
41:        return error.code === 'MEETING_NOTE_SPACE_NOT_FOUND'
42:          ? 'This space no longer exists. Choose another space.'
43:          : error.code === 'MEETING_NOTE_VERSION_NOT_FOUND'
44:            ? 'This version no longer exists.'
45:            : 'This note no longer exists or you no longer have access to it.';
46:      case 409:
47:        return 'This note was changed by someone else. Review the newer version and try again.';
48:      case 413:
49:        return 'The notes are too large to save.';
50:      case 429:
51:        return 'Too many changes in a short time. Wait a moment and try again.';
52:      default:
53:        if (error.status >= 500) return 'Something went wrong on the server. Try again.';
54:        return error.message || 'The request could not be completed.';
55:    }
56:  }
57:  return 'Something went wrong. Try again.';
58:}
