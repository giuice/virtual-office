60:/** 500 that records only the SQLSTATE (never database text, which could echo parameters). */
61:function internalError(cause: unknown, correlationId: string, context: string): NextResponse {
62:  const code = cause instanceof MeetingNoteAiSettingsDbError ? cause.sqlstate : undefined;
63:  return jsonError(500, 'INTERNAL_ERROR', 'Something went wrong. Please try again.', {
64:    correlationId,
65:    cause: { code: code ?? (cause instanceof Error ? cause.name : 'unknown') },
66:    context,
67:  });
68:}
