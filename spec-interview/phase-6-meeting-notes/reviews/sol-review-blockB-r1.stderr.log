106:/** 429: the user exhausted a limit (transient). */
107:export function rateLimitExceededResponse(): NextResponse {
108:  return jsonError(429, 'rate_limited', 'Too many requests. Please slow down.');
109:}
110:
111:/** 429: a fail-closed limit could not be checked (transient). */
112:export function rateLimitUnavailableResponse(): NextResponse {
113:  return jsonError(429, 'rate_limited', 'The request could not be rate checked. Please retry shortly.');
114:}
115:
116:/**
117: * Returns a 429 response when the user exceeded the action's limit,
118: * null when the request may proceed. Call AFTER authentication, with the
119: * authenticated user's DB id (users.id, not supabase_uid).
120: *
121: * Fail-open actions: an RPC error (e.g. migration not applied yet) is logged
122: * and the request is allowed — rate limiting must never take those down.
123: * Fail-closed actions (Phase 5 T3: message send budgets): an RPC error or an
124: * unexpected result refuses the request with 429.
125: */
126:export async function enforceRateLimit(
127:  serviceClient: SupabaseClient,
128:  userDbId: string,
129:  action: RateLimitedAction
130:): Promise<NextResponse | null> {
131:  const { limit, windowSeconds, failClosed } = RATE_LIMITS[action];
132:
133:  try {
134:    const { data: allowed, error } = await serviceClient.rpc('check_rate_limit', {
135:      p_user_id: userDbId,
136:      p_action: action,
137:      p_limit: limit,
138:      p_window_seconds: windowSeconds,
139:    });
140:
141:    if (error) {
142:      console.error(`Rate limit check failed for ${action}:`, error);
143:      return failClosed ? rateLimitUnavailableResponse() : null;
144:    }
145:
146:    if (allowed === false) {
147:      return rateLimitExceededResponse();
148:    }
149:
150:    if (failClosed && allowed !== true) {
151:      console.error(`Rate limit check returned an unexpected result for ${action}:`, allowed);
152:      return rateLimitUnavailableResponse();
153:    }
154:
155:    return null;
156:  } catch (error) {
157:    console.error(`Rate limit check threw for ${action}:`, error);
158:    return failClosed ? rateLimitUnavailableResponse() : null;
159:  }
160:}

