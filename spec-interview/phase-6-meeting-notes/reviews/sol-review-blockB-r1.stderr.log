1:import { request } from '@playwright/test';
2:
3:import { LOCAL_MESSAGING_FLAG, assertLocalSupabaseOnly } from './local-supabase-mode';
4:import { sweepMeetingNotesE2ELeftovers } from './meeting-notes-e2e';
5:import { readPresenceRuntimeMode, withLocalMessagingDb } from './messaging-local-db';
6:
7:/** Base URL of the meeting-notes runner (set by playwright.meeting-notes.config.ts). */
8:export const MEETING_NOTES_E2E_BASE_URL_ENV = 'VO_MEETING_NOTES_E2E_BASE_URL';
9:
10:/**
11: * Phase 6 meeting-notes runner global setup (runs after the dev server is up).
12: *
13: * 1. Local Supabase mode only; refuses a non-atomic local Presence mode (the
14: *    floor plan, where the space Notes tab lives, expects `atomic`).
15: * 2. Removes what interrupted runs left: the messaging seed's leftover
16: *    conversations (seed route sweep, which otherwise blocks the next seed)
17: *    and every meeting-notes E2E note, space, member row, and company.
18: */
19:export default async function meetingNotesGlobalSetup(): Promise<void> {
20:  if (process.env[LOCAL_MESSAGING_FLAG] !== '1') {
21:    throw new Error('The meeting-notes E2E runner only runs in local Supabase mode.');
22:  }
23:  assertLocalSupabaseOnly(process.env);
24:
25:  const mode = await withLocalMessagingDb(readPresenceRuntimeMode);
26:  if (mode !== 'atomic') {
27:    throw new Error(
28:      `Local private.presence_runtime_control.mode is '${mode ?? 'missing'}'; restore 'atomic' before meeting-notes 
E2E ` +
29:        '(npm run test:presence:db leaves it legacy).',
30:    );
31:  }
32:
33:  const baseURL = process.env[MEETING_NOTES_E2E_BASE_URL_ENV];
34:  if (!baseURL) throw new Error(`${MEETING_NOTES_E2E_BASE_URL_ENV} is not set.`);
35:  const context = await request.newContext({ baseURL });
36:  try {
37:    const response = await context.delete('/api/test/messaging/seed', {
38:      headers: { 'x-test-secret': process.env.PLAYWRIGHT_TEST_SECRET ?? '' },
39:      data: { action: 'sweep-leftovers' },
40:    });
41:    if (!response.ok()) {
42:      throw new Error(`Sweeping leftover messaging seed data failed: ${response.status()} ${await 
response.text()}`);
43:    }
44:  } finally {
45:    await context.dispose();
46:  }
47:
48:  const removed = await sweepMeetingNotesE2ELeftovers();
49:  console.log(
50:    `[meeting-notes setup] removed leftovers: ${removed.notes} note(s), ${removed.spaces} space(s), ` +
51:      `${removed.users} member row(s), ${removed.companies} company(ies)`,
52:  );
53:}
