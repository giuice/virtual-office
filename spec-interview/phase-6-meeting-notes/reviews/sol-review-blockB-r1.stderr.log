95:export type RateLimitedAction = keyof typeof RATE_LIMITS;
96:
97:/**
98: * The message insertion quota handed to the database, which charges it to
99: * the 'message:create' counter in the transaction of a winning insertion.
100: */
101:export const MESSAGE_INSERTION_QUOTA: InsertionQuota = {
102:  limit: RATE_LIMITS['message:create'].limit,
103:  windowSeconds: RATE_LIMITS['message:create'].windowSeconds,
104:};
