6:'use client';
7:
8:import { Download, Loader2 } from 'lucide-react';
9:import { useId, useState } from 'react';
10:import { useMutation } from '@tanstack/react-query';
11:
12:import { Button } from '@/components/ui/button';
13:import { fetchMeetingNoteMarkdown } from '@/lib/meeting-notes/client-api';
14:import { describeMeetingNoteError } from '@/lib/meeting-notes/form-errors';
15:import type { MeetingNoteDetail } from '@/types/meeting-notes';
16:
17:export interface MeetingNoteExportControlsProps {
18:  note: Pick<MeetingNoteDetail, 'id' | 'hasTranscript'>;
19:}
20:
21:function viewerTimeZone(): string {
22:  try {
23:    return Intl.DateTimeFormat().resolvedOptions().timeZone || 'UTC';
24:  } catch {
25:    return 'UTC';
26:  }
27:}
28:
29:/** Hands a downloaded file to the browser. */
30:function saveFile(blob: Blob, filename: string): void {
31:  const url = URL.createObjectURL(blob);
32:  const anchor = document.createElement('a');
33:  anchor.href = url;
34:  anchor.download = filename;
35:  anchor.rel = 'noopener';
36:  anchor.style.display = 'none';
37:  document.body.appendChild(anchor);
38:  anchor.click();
39:  anchor.remove();
40:  // Give the browser time to start the download before the URL goes away.
41:  window.setTimeout(() => URL.revokeObjectURL(url), 30_000);
42:}
43:
44:export function MeetingNoteExportControls({ note }: MeetingNoteExportControlsProps) {
45:  const checkboxId = useId();
46:  const [includeTranscript, setIncludeTranscript] = useState(false);
47:  const exportFile = useMutation({
48:    mutationFn: (withTranscript: boolean) =>
49:      fetchMeetingNoteMarkdown(note.id, { includeTranscript: withTranscript, timeZone: viewerTimeZone() }),
50:    onSuccess: (file) => saveFile(file.blob, file.filename),
51:  });
52:
53:  return (
54:    <div className="flex flex-col items-end gap-1" data-testid="meeting-note-export">
55:      <div className="flex flex-wrap items-center gap-2">
56:        {note.hasTranscript ? (
57:          <label htmlFor={checkboxId} className="flex cursor-pointer items-center gap-1.5 text-xs 
text-muted-foreground">
58:            <input
59:              id={checkboxId}
60:              type="checkbox"
61:              className="size-3.5 accent-primary"
62:              checked={includeTranscript}
63:              disabled={exportFile.isPending}
64:              onChange={(event) => setIncludeTranscript(event.target.checked)}
65:              data-testid="meeting-note-export-include-transcript"
66:            />
67:            Include transcript
68:          </label>
69:        ) : null}
70:        <Button
71:          type="button"
72:          size="sm"
73:          variant="outline"
74:          className="gap-1.5"
75:          disabled={exportFile.isPending}
76:          onClick={() => exportFile.mutate(note.hasTranscript && includeTranscript)}
77:          data-testid="meeting-note-export-button"
78:        >
79:          {exportFile.isPending ? (
80:            <Loader2 className="size-4 animate-spin" aria-hidden="true" />
81:          ) : (
82:            <Download className="size-4" aria-hidden="true" />
83:          )}
84:          Export Markdown
85:        </Button>
86:      </div>
87:      {exportFile.isError ? (
88:        <p className="text-xs text-destructive" role="alert" data-testid="meeting-note-export-error">
89:          The export failed. {describeMeetingNoteError(exportFile.error)}
90:        </p>
91:      ) : null}
92:    </div>
93:  );
94:}

