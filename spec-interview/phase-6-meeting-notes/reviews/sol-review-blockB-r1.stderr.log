__tests__/api/playwright/meeting-notes/note-conflict.spec.ts
1:import { expect, test } from '../fixtures/meeting-notes';
2:import { MEETING_NOTES_E2E_PREFIX } from '../helpers/meeting-notes-e2e';
3:import { noteEditor, openNote, replaceEditorText } from '../helpers/meeting-notes-ui';
4:
5:/**
6: * AC-005, UI part (FR-007, BR-011): two editors open the same revision; the
7: * first save wins; the second gets the conflict warning showing the newer
8: * state, with its own unsaved text still available, and nothing is
9: * overwritten. Loading the newer version shows it in the form and keeps the
10: * user's earlier text visible. (Restore-vs-save and attach-vs-apply races are
11: * covered at the database level.)
12: */
13:test.describe('meeting notes — concurrent edits (AC-005)', () => {
14:  test('the second save of the same revision shows the conflict and keeps the first change', async ({
15:    primaryPage,
16:    secondaryPage,
17:    messagingData,
18:    notesWorld,
19:  }) => {
20:    const space = await notesWorld.createSpace('Conflict room');
21:    const title = `${MEETING_NOTES_E2E_PREFIX} Conflict ${notesWorld.runTag}`;
22:    const noteId = await notesWorld.createNote(primaryPage, {
23:      spaceId: space.id,
24:      title,
25:      meetingDate: new Date(),
26:      content: '<p>Original text</p>',
27:      participantIds: [messagingData.secondary.userId],
28:    });
29:
30:    const first = primaryPage;
31:    const second = secondaryPage;
32:    // Both open the editor on revision 1.
33:    for (const page of [first, second]) {
34:      const view = await openNote(page, noteId);
35:      await expect(view).toHaveAttribute('data-revision', '1');
36:      await page.getByTestId('meeting-note-edit-button').click();
37:      await noteEditor(page);
38:    }
39:
40:    const firstText = `Admin decision ${notesWorld.runTag}`;
41:    const secondText = `Member decision ${notesWorld.runTag}`;
42:
43:    await replaceEditorText(first, firstText);
44:    await first.getByTestId('meeting-note-submit').click();
45:    const firstView = first.getByTestId('meeting-note-view');
46:    await expect(firstView).toBeVisible({ timeout: 30_000 });
47:    await expect(firstView).toHaveAttribute('data-revision', '2');
48:    await expect(first.getByTestId('meeting-note-content')).toContainText(firstText);
49:
50:    await replaceEditorText(second, secondText);
51:    await second.getByTestId('meeting-note-submit').click();
52:
53:    const dialog = second.getByTestId('meeting-note-conflict-dialog');
54:    await expect(dialog).toBeVisible({ timeout: 30_000 });
55:    await expect(dialog.getByRole('heading', { name: 'This note was changed by someone else' })).toBeVisible();
56:    await expect(dialog.getByTestId('meeting-note-conflict-newer')).toContainText('Revision 2');
57:    await expect(dialog.getByTestId('meeting-note-conflict-newer-title')).toHaveText(title);
58:    await expect(dialog.getByTestId('meeting-note-conflict-newer-content')).toContainText(firstText);
59:    // The user's own text is not lost.
60:    await expect(dialog.getByTestId('meeting-note-conflict-mine')).toHaveValue(new RegExp(secondText));
61:
62:    // Nothing was overwritten: the first change is intact on the server.
63:    const current = await notesWorld.readNote(first, noteId);
64:    expect(current.note?.revision).toBe(2);
65:    expect(current.note?.content).toContain(firstText);
66:    expect(current.note?.content).not.toContain(secondText);
67:
68:    // Loading the newer version puts it in the form; the earlier text stays visible.
69:    await dialog.getByRole('button', { name: 'Load newer version' }).click();
70:    await expect(dialog).toBeHidden();
71:    await expect(await noteEditor(second)).toContainText(firstText);
72:    await expect(second.getByTestId('meeting-note-unsaved-backup')).toContainText('Your earlier unsaved text');
73:    await expect(second.getByTestId('meeting-note-unsaved-backup').getByRole('textbox')).toHaveValue(
74:      new RegExp(secondText),
75:    );
76:  });
77:});
