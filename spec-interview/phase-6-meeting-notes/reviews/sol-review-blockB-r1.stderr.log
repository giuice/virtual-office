100:          backdropFilter: 'blur(var(--vo-detail-panel-backdrop-blur, 16px))',
101:          WebkitBackdropFilter: 'blur(var(--vo-detail-panel-backdrop-blur, 16px))',
102:          maxHeight: '85vh',
103:        }}
104:        // AC8: Stop propagation to prevent card navigation
105:        onPointerDown={(e) => e.stopPropagation()}
