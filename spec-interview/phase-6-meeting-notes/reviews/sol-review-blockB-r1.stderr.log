10:import { useMutation, useQueryClient, type QueryClient } from '@tanstack/react-query';
11:
12:import { meetingNoteQueryKeys, useMeetingNotesScope } from '@/hooks/queries/useMeetingNotes';
13:import {
14:  createMeetingNoteActionItem,
15:  deleteMeetingNoteActionItem,
16:  MeetingNoteItemConflictError,
17:  MeetingNotesApiError,
18:  setMeetingNoteActionItemCompleted,
19:  updateMeetingNoteActionItem,
20:} from '@/lib/meeting-notes/client-api';
21:import type {
22:  MeetingNoteActionItemFieldsInput,
23:  MeetingNoteActionItemView,
24:  MeetingNoteDetail,
25:} from '@/types/meeting-notes';
26:
27:type Scope = { userId: string; companyId: string };
28:
29:type ItemChange = { kind: 'upsert'; item: MeetingNoteActionItemView } | { kind: 'remove'; itemId: string };
30:
31:function requireScope(scope: Scope | null): Scope {
32:  if (!scope) throw new MeetingNotesApiError(401, 'NO_SESSION', 'Your session is not ready. Reload the page and try 
again.');
33:  return scope;
34:}
35:
36:function applyChange(items: MeetingNoteActionItemView[], change: ItemChange): MeetingNoteActionItemView[] {
37:  if (change.kind === 'remove') return items.filter((item) => item.id !== change.itemId);
38:  const index = items.findIndex((item) => item.id === change.item.id);
39:  if (index === -1) return [...items, change.item];
40:  // Never replace a newer cached state with an older response.
41:  if (items[index].revision > change.item.revision) return items;
42:  return items.map((item, position) => (position === index ? change.item : item));
43:}
44:
45:/** Writes the change into the cached note (if any), then refreshes everything of this viewer. */
46:function settleItem(queryClient: QueryClient, scope: Scope, noteId: string, change: ItemChange | null): void {
47:  if (change) {
48:    queryClient.setQueryData<MeetingNoteDetail>(meetingNoteQueryKeys.note(scope.userId, scope.companyId, noteId), 
(note) =>
49:      note ? { ...note, actionItems: applyChange(note.actionItems, change) } : note
50:    );
51:  }
52:  void queryClient.invalidateQueries({ queryKey: meetingNoteQueryKeys.scope(scope.userId, scope.companyId) });
53:}
54:
55:/** After a failure: a 409 brings the newer item; anything else just refreshes. */
56:function settleItemError(queryClient: QueryClient, scope: Scope, noteId: string, error: unknown): void {
57:  settleItem(
58:    queryClient,
59:    scope,
60:    noteId,
61:    error instanceof MeetingNoteItemConflictError ? { kind: 'upsert', item: error.item } : null
62:  );
63:}
