61:      onOpenChange={(next) => {
62:        if (remove.isPending) return;
63:        setOpen(next);
64:        if (!next) {
65:          remove.reset();
66:          setConflict(null);
67:        }
68:      }}
69:    >
70:      <AlertDialogTrigger asChild>
71:        <Button
72:          type="button"
73:          variant="ghost"
74:          size="icon"
75:          className="size-8 text-muted-foreground hover:text-destructive"
76:          aria-label="Delete action item"
77:          data-testid="meeting-note-item-delete"
78:        >
79:          <Trash2 className="size-4" aria-hidden="true" />
80:        </Button>
81:      </AlertDialogTrigger>
82:      <AlertDialogContent>
83:        <AlertDialogHeader>
84:          <AlertDialogTitle>Delete this action item?</AlertDialogTitle>
85:          <AlertDialogDescription className="whitespace-pre-wrap break-words">
86:            {`"${item.description}" will be permanently deleted.`}
