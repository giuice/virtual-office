2:import { daysAgo, MEETING_NOTES_E2E_PREFIX } from '../helpers/meeting-notes-e2e';
3:
4:/**
5: * AC-001 (FR-003; listing part — the note view and its formatting are T6):
6: * a space's "Notes" tab lists the space's notes newest meeting date first,
7: * regardless of creation order, and offers "New note". The member (secondary)
8: * reads the notes the admin (primary) wrote in a private space.
9: */
10:test.describe('meeting notes — space Notes tab (AC-001)', () => {
11:  test('lists the space notes by meeting date, newest first, including a backdated note', async ({
12:    primaryPage,
13:    secondaryPage,
14:    notesWorld,
15:  }) => {
16:    const space = await notesWorld.createSpace('Private notes room', { isPublic: false });
17:
18:    // Creation order differs from meeting-date order on purpose.
19:    const todayTitle = `${MEETING_NOTES_E2E_PREFIX} Today sync ${notesWorld.runTag}`;
20:    const lastMonthTitle = `${MEETING_NOTES_E2E_PREFIX} Last month review ${notesWorld.runTag}`;
21:    const yesterdayTitle = `${MEETING_NOTES_E2E_PREFIX} Yesterday standup ${notesWorld.runTag}`;
22:    const todayId = await notesWorld.createNote(primaryPage, {
23:      spaceId: space.id,
24:      title: todayTitle,
25:      meetingDate: new Date(),
26:      content: '<p>Agenda for today</p>',
27:    });
28:    const lastMonthId = await notesWorld.createNote(primaryPage, {
29:      spaceId: space.id,
30:      title: lastMonthTitle,
31:      meetingDate: daysAgo(31),
32:      content: '<p>Backdated review</p>',
33:    });
34:    const yesterdayId = await notesWorld.createNote(primaryPage, {
35:      spaceId: space.id,
36:      title: yesterdayTitle,
37:      meetingDate: daysAgo(1),
38:      content: '<p>Standup notes</p>',
39:    });
40:
41:    const page = secondaryPage;
42:    await page.goto('/floor-plan');
43:    const card = page.getByTestId(`space-${space.id}`);
44:    await expect(card).toBeVisible({ timeout: 30_000 });
45:    await card.click();
46:
47:    const panel = page.getByRole('region', { name: `Details for ${space.name}` });
48:    await expect(panel).toBeVisible();
49:    const detailsTab = panel.getByRole('tab', { name: 'Details' });
50:    const notesTab = panel.getByRole('tab', { name: 'Notes' });
51:    // Details stays the default tab.
52:    await expect(detailsTab).toHaveAttribute('aria-selected', 'true');
53:
54:    // Keyboard reachable (§13): arrow keys move between the tabs.
55:    await detailsTab.focus();
56:    await page.keyboard.press('ArrowRight');
57:    await expect(notesTab).toBeFocused();
58:    await expect(notesTab).toHaveAttribute('aria-selected', 'true');
59:
60:    const items = panel.getByTestId('space-note-item');
61:    await expect(items).toHaveCount(3, { timeout: 15_000 });
62:    await expect(items.nth(0)).toContainText(todayTitle);
63:    await expect(items.nth(1)).toContainText(yesterdayTitle);
64:    await expect(items.nth(2)).toContainText(lastMonthTitle);
65:    await expect(items.nth(0)).toHaveAttribute('href', `/meetings/${todayId}`);
66:    await expect(items.nth(1)).toHaveAttribute('href', `/meetings/${yesterdayId}`);
67:    await expect(items.nth(2)).toHaveAttribute('href', `/meetings/${lastMonthId}`);
68:    // The author snapshot is shown on each row.
69:    await expect(items.nth(0)).toContainText(process.env.PLAYWRIGHT_PRIMARY_DISPLAY_NAME ?? 'Local Primary');
70:
71:    const newNote = panel.getByRole('link', { name: `New note in ${space.name}` });
72:    await expect(newNote).toHaveAttribute('href', `/meetings/new?spaceId=${space.id}`);
73:
74:    // Switching tabs neither navigated nor closed the panel (click-stop surface).
75:    await expect(page).toHaveURL(/\/floor-plan/);
76:    await expect(panel).toBeVisible();
77:  });
