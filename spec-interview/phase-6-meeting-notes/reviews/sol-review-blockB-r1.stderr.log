5:import { sanitizeMeetingNoteHtml } from './content-sanitizer';
6:
7:const BLOCK_END = /<\/(?:p|h[1-6]|li)>|<br\s*\/?>/gi;
8:
9:export function meetingNoteHtmlToText(html: string): string {
10:  const marked = sanitizeMeetingNoteHtml(html).replace(BLOCK_END, (tag) => `${tag}\n`);
11:  if (typeof DOMParser === 'undefined') {
12:    return marked.replace(/<[^>]*>/g, '').trim();
13:  }
14:  const doc = new DOMParser().parseFromString(`<!doctype html><body>${marked}</body>`, 'text/html');
15:  return (doc.body.textContent ?? '').replace(/\n{3,}/g, '\n\n').trim();
16:}
