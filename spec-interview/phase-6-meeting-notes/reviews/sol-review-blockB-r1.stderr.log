180:
181:create or replace function public.save_meeting_note_ai_settings(
182:  p_actor_user_id uuid,
183:  p_company_id uuid,
184:  p_expected_revision bigint,
185:  p_provider text,
186:  p_model text,
187:  p_reasoning_level text,
188:  p_daily_limit integer,
189:  p_api_key text
190:)
191:returns jsonb
192:language plpgsql
193:security definer
194:set search_path = ''
195:as $$
196:declare
197:  v_actor_id uuid;
198:  v_actor_company_id uuid;
199:  v_actor_role public.user_role;
200:  v_actor_name text;
201:  v_current public.meeting_note_ai_settings%rowtype;
202:  v_exists boolean;
203:  v_inserted integer;
204:  v_secret_name text;
205:  v_secret_id uuid;
206:  v_saved public.meeting_note_ai_settings%rowtype;
207:begin
208:  if p_actor_user_id is null or p_company_id is null then
209:    raise exception 'MEETING_NOTE_AI_SETTINGS_INVALID_ARGUMENT' using errcode = '22023';
210:  end if;
211:
212:  -- (1) Actor row, FOR KEY SHARE; the locking read returns the latest
213:  -- committed version (a removal/demotion that committed first is seen).
214:  select u.id, u.company_id, u.role, u.display_name
215:  into v_actor_id, v_actor_company_id, v_actor_role, v_actor_name
216:  from public.users as u
217:  where u.id = p_actor_user_id
218:  for key share;
219:
220:  -- (2) The company's settings row.
221:  select s.*
222:  into v_current
223:  from public.meeting_note_ai_settings as s
224:  where s.company_id = p_company_id
225:  for update;
226:  v_exists := found;
227:
228:  -- (3) Re-verify on the locked actor row.
229:  if v_actor_id is null
230:     or v_actor_company_id is distinct from p_company_id
231:     or v_actor_role is distinct from 'admin'::public.user_role then
232:    raise exception 'MEETING_NOTE_AI_SETTINGS_FORBIDDEN' using errcode = '42501';
233:  end if;
234:
235:  if v_exists then
236:    if p_expected_revision is null or p_expected_revision <> v_current.revision then
237:      raise exception 'MEETING_NOTE_AI_SETTINGS_STALE_REVISION'
238:        using errcode = 'P0001',
239:              detail = pg_catalog.jsonb_build_object('current_revision', v_current.revision)::text;
240:    end if;
241:  elsif p_expected_revision is not null then
242:    raise exception 'MEETING_NOTE_AI_SETTINGS_STALE_REVISION'
243:      using errcode = 'P0001',
244:            detail = pg_catalog.jsonb_build_object('current_revision', null)::text;
245:  end if;
246:
247:  if p_provider is null or p_provider not in ('anthropic', 'openai', 'kimi', 'glm') then
248:    raise exception 'MEETING_NOTE_AI_PROVIDER_INVALID' using errcode = '22023';
249:  end if;
250:  if p_model is null or p_model !~ '^[A-Za-z0-9][A-Za-z0-9._:/-]{0,99}$' then
251:    raise exception 'MEETING_NOTE_AI_MODEL_INVALID' using errcode = '22023';
252:  end if;
253:  if p_reasoning_level is null or p_reasoning_level !~ '^[a-z][a-z_]{0,31}$' then
254:    raise exception 'MEETING_NOTE_AI_REASONING_INVALID' using errcode = '22023';
255:  end if;
256:  if p_daily_limit is null or p_daily_limit < 1 or p_daily_limit > 200 then
257:    raise exception 'MEETING_NOTE_AI_DAILY_LIMIT_INVALID' using errcode = '22023';
258:  end if;
259:  if p_api_key is null then
260:    if not v_exists then
261:      raise exception 'MEETING_NOTE_AI_KEY_REQUIRED' using errcode = '22023';
262:    end if;
263:  elsif pg_catalog.length(p_api_key) not between 8 and 512 or p_api_key !~ '^[!-~]+$' then
264:    raise exception 'MEETING_NOTE_AI_KEY_INVALID' using errcode = '22023';
265:  end if;
266:
267:  v_secret_name := private.meeting_note_ai_secret_name(p_company_id);
268:  -- "Keep the current key" needs a stored key: a settings row whose secret is
269:  -- gone (manual Vault delete, TRUNCATE without row triggers) must not stay
270:  -- "configured" without one.
271:  if p_api_key is null
272:     and not exists (select 1 from vault.secrets as vs where vs.name = v_secret_name) then
273:    raise exception 'MEETING_NOTE_AI_KEY_REQUIRED' using errcode = '22023';
274:  end if;
275:
276:  if v_exists then
277:    update public.meeting_note_ai_settings as s
278:    set provider = p_provider,
279:        model = p_model,
280:        reasoning_level = p_reasoning_level,
281:        daily_limit = p_daily_limit,
282:        revision = s.revision + 1,
283:        key_last_four = case when p_api_key is null then s.key_last_four
284:                             else pg_catalog.right(p_api_key, 4) end,
285:        updated_by_user_id = v_actor_id,
286:        updated_by_name = v_actor_name,
287:        updated_at = pg_catalog.now()
288:    where s.company_id = p_company_id
289:    returning s.* into v_saved;
290:  else
291:    -- First save. A concurrent first save that committed first wins the
292:    -- primary key; this one then inserts nothing and is stale.
293:    insert into public.meeting_note_ai_settings (
294:      company_id, provider, model, reasoning_level, daily_limit, revision,
295:      key_last_four, updated_by_user_id, updated_by_name, updated_at
296:    )
297:    values (
298:      p_company_id, p_provider, p_model, p_reasoning_level, p_daily_limit, 1,
299:      pg_catalog.right(p_api_key, 4), v_actor_id, v_actor_name, pg_catalog.now()
300:    )
301:    on conflict (company_id) do nothing
302:    returning * into v_saved;
303:    get diagnostics v_inserted = row_count;
304:    if v_inserted = 0 then
305:      select s.revision into v_current.revision
306:      from public.meeting_note_ai_settings as s
307:      where s.company_id = p_company_id;
308:      raise exception 'MEETING_NOTE_AI_SETTINGS_STALE_REVISION'
309:        using errcode = 'P0001',
310:              detail = pg_catalog.jsonb_build_object('current_revision', v_current.revision)::text;
311:    end if;
312:  end if;
313:
314:  if p_api_key is not null then
315:    select vs.id into v_secret_id
316:    from vault.secrets as vs
317:    where vs.name = v_secret_name;
318:    if v_secret_id is null then
319:      perform vault.create_secret(p_api_key, v_secret_name, 'Meeting notes AI provider key');
320:    else
321:      perform vault.update_secret(v_secret_id, p_api_key);
322:    end if;
323:  end if;
324:
325:  return pg_catalog.jsonb_build_object(
326:    'configured', true,
327:    'provider', v_saved.provider,
328:    'model', v_saved.model,
329:    'reasoning_level', v_saved.reasoning_level,
330:    'daily_limit', v_saved.daily_limit,
331:    'revision', v_saved.revision,
332:    'key_last_four', v_saved.key_last_four,
333:    'updated_by_user_id', v_saved.updated_by_user_id,
334:    'updated_by_name', v_saved.updated_by_name,
335:    'updated_at', v_saved.updated_at
336:  );
337:end;
338:$$;
339:
340:alter function public.save_meeting_note_ai_settings(uuid, uuid, bigint, text, text, text, integer, text) owner to 
postgres;
341:revoke all on function public.save_meeting_note_ai_settings(uuid, uuid, bigint, text, text, text, integer, text)
342:  from public, anon, authenticated, service_role;
343:grant execute on function public.save_meeting_note_ai_settings(uuid, uuid, bigint, text, text, text, integer, text)
344:  to service_role;
345:
346:-- ---------------------------------------------------------------------------
347:-- Read key (service_role only)
348:-- ---------------------------------------------------------------------------
349:
350:create or replace function public.read_meeting_note_ai_key(p_company_id uuid)
351:returns jsonb
352:language sql
353:stable
354:security definer
355:set search_path = ''
356:as $$
357:  select pg_catalog.jsonb_build_object(
358:    'revision', s.revision,
359:    'provider', s.provider,
360:    'model', s.model,
361:    'reasoning_level', s.reasoning_level,
362:    'daily_limit', s.daily_limit,
363:    'api_key', ds.decrypted_secret
364:  )
365:  from public.meeting_note_ai_settings as s
366:  join vault.decrypted_secrets as ds
367:    on ds.name = private.meeting_note_ai_secret_name(s.company_id)
368:  where s.company_id = p_company_id
369:$$;
370:
371:alter function public.read_meeting_note_ai_key(uuid) owner to postgres;
372:revoke all on function public.read_meeting_note_ai_key(uuid) from public, anon, authenticated, service_role;
373:grant execute on function public.read_meeting_note_ai_key(uuid) to service_role;

