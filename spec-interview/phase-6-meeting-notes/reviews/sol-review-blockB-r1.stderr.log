415:/**
416: * Removes what interrupted runs left: every note, space, member row, and
417: * company whose name/title/email carries the E2E prefix. Local database only.
418: */
419:export async function sweepMeetingNotesE2ELeftovers(): Promise<Record<string, number>> {
420:  return withLocalMessagingDb(async (db) => {
421:    await asServiceRole(db);
422:    const like = `${MEETING_NOTES_E2E_PREFIX} %`;
423:    const notes = await db.query(
424:      `delete from public.meeting_notes
425:        where title like $1
426:           or room_id in (select id from public.spaces where name like $1)
427:           or company_id in (select id from public.companies where name like $1)`,
428:      [like],
429:    );
430:    const spaces = await db.query('delete from public.spaces where name like $1', [like]);
431:    const users = await db.query('delete from public.users where email like $1', [E2E_EMAIL_PATTERN]);
432:    const companies = await db.query('delete from public.companies where name like $1', [like]);
433:    return {
434:      notes: notes.rowCount ?? 0,
435:      spaces: spaces.rowCount ?? 0,
436:      users: users.rowCount ?? 0,
437:      companies: companies.rowCount ?? 0,
438:    };
439:  });
440:}

