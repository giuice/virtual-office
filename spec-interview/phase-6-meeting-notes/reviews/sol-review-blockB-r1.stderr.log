6:
7:export const MEETING_NOTE_AI_SETTINGS_ERROR_TOKENS = [
8:  // 42501
9:  'MEETING_NOTE_AI_SETTINGS_FORBIDDEN',
10:  // P0001 (DETAIL {"current_revision": n|null})
11:  'MEETING_NOTE_AI_SETTINGS_STALE_REVISION',
12:  // 22023
13:  'MEETING_NOTE_AI_SETTINGS_INVALID_ARGUMENT',
14:  'MEETING_NOTE_AI_PROVIDER_INVALID',
15:  'MEETING_NOTE_AI_MODEL_INVALID',
16:  'MEETING_NOTE_AI_REASONING_INVALID',
17:  'MEETING_NOTE_AI_DAILY_LIMIT_INVALID',
18:  'MEETING_NOTE_AI_KEY_REQUIRED',
19:  'MEETING_NOTE_AI_KEY_INVALID',
20:] as const;
21:
22:export type MeetingNoteAiSettingsErrorToken = (typeof MEETING_NOTE_AI_SETTINGS_ERROR_TOKENS)[number];
23:
24:const KNOWN: ReadonlySet<string> = new Set(MEETING_NOTE_AI_SETTINGS_ERROR_TOKENS);
25:
26:export class MeetingNoteAiSettingsDbError extends Error {
27:  readonly sqlstate: string | undefined;
28:  readonly token: MeetingNoteAiSettingsErrorToken | null;
29:  /** current_revision from a stale-revision DETAIL; null when absent. */
30:  readonly currentRevision: number | null;
31:
32:  constructor(sqlstate: string | undefined, message: string | undefined, detail: string | null | undefined) {
33:    const token = message && KNOWN.has(message) ? (message as MeetingNoteAiSettingsErrorToken) : null;
34:    // The message is the token or a fixed text — never the database text.
35:    super(token ?? 'unexpected AI settings database error');
36:    this.name = 'MeetingNoteAiSettingsDbError';
37:    this.sqlstate = sqlstate;
38:    this.token = token;
39:    this.currentRevision = token === 'MEETING_NOTE_AI_SETTINGS_STALE_REVISION' ? parseRevision(detail) : null;
40:  }
41:}
42:
43:function parseRevision(detail: string | null | undefined): number | null {
44:  if (!detail) return null;
45:  try {
46:    const parsed: unknown = JSON.parse(detail);
47:    if (typeof parsed !== 'object' || parsed === null) return null;
48:    const value = (parsed as Record<string, unknown>).current_revision;
49:    return typeof value === 'number' && Number.isSafeInteger(value) ? value : null;
50:  } catch {
51:    return null;
52:  }
53:}
