93:create table public.meeting_note_ai_settings (
94:  company_id uuid primary key
95:    references public.companies (id) on delete cascade,
96:  provider text not null
97:    constraint meeting_note_ai_settings_provider_check
98:      check (provider in ('anthropic', 'openai', 'kimi', 'glm')),
99:  model text not null
100:    constraint meeting_note_ai_settings_model_check
101:      check (model ~ '^[A-Za-z0-9][A-Za-z0-9._:/-]{0,99}$'),
102:  reasoning_level text not null
103:    constraint meeting_note_ai_settings_reasoning_level_check
104:      check (reasoning_level ~ '^[a-z][a-z_]{0,31}$'),
105:  daily_limit integer not null
106:    constraint meeting_note_ai_settings_daily_limit_check
107:      check (daily_limit between 1 and 200),
108:  revision bigint not null
109:    constraint meeting_note_ai_settings_revision_check
110:      check (revision >= 1),
111:  key_last_four text not null
112:    constraint meeting_note_ai_settings_key_last_four_check
113:      check (key_last_four ~ '^[!-~]{4}$'),
114:  updated_by_user_id uuid
115:    references public.users (id) on delete set null,
116:  updated_by_name text not null,
117:  updated_at timestamptz not null default now()
118:);
