34:/** Local calendar day 'YYYY-MM-DD' of `date` (what a date input shows). */
35:export function localDay(date: Date): string {
36:  const pad = (value: number) => String(value).padStart(2, '0');
37:  return `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())}`;
38:}
39:
40:/** `days` days before now, at local noon (stays inside that local day). */
41:export function daysAgo(days: number): Date {
42:  const date = new Date();
43:  date.setHours(12, 0, 0, 0);
44:  date.setDate(date.getDate() - days);
45:  return date;
46:}
