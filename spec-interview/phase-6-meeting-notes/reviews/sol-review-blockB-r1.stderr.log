91:/** Clicks "Export Markdown" (optionally with "Include transcript") and returns the downloaded file. */
92:export async function exportNoteMarkdown(
93:  page: Page,
94:  options: { includeTranscript?: boolean } = {},
95:): Promise<{ filename: string; text: string }> {
96:  const transcript = page.getByTestId('meeting-note-export-include-transcript');
97:  if (options.includeTranscript !== undefined && (await transcript.count()) > 0) {
98:    await transcript.setChecked(options.includeTranscript);
99:  } else if (options.includeTranscript) {
100:    throw new Error('"Include transcript" is not offered for this note');
101:  }
102:  const downloadEvent = page.waitForEvent('download', { timeout: 30_000 });
103:  await page.getByRole('button', { name: 'Export Markdown' }).click();
104:  const download = await downloadEvent;
105:  const stream = await download.createReadStream();
106:  const chunks: Buffer[] = [];
107:  for await (const chunk of stream) chunks.push(Buffer.from(chunk as Uint8Array));
108:  return { filename: download.suggestedFilename(), text: Buffer.concat(chunks).toString('utf8') };
109:}

