17:/**
18: * GET /api/meeting-notes/[id]/versions/[versionId] — one immutable version
19: * (title, date, participant snapshots, content, summary, editor, time; FR-009).
20: */
21:export async function GET(_request: Request, { params }: RouteParams): Promise<NextResponse> {
22:  const begun = await beginMeetingNoteRequest('/api/meeting-notes/[id]/versions/[versionId]');
23:  if (!begun.ok) return begun.response;
24:  const ctx = begun.value;
25:
26:  const raw = await params;
27:  const id = parsePathId(raw.id, 'MEETING_NOTE_NOT_FOUND', ctx);
28:  if (!id.ok) return id.response;
29:  const versionId = parsePathId(raw.versionId, 'MEETING_NOTE_VERSION_NOT_FOUND', ctx);
30:  if (!versionId.ok) return versionId.response;
31:
32:  try {
33:    const version = await ctx.repository.findVersion(id.value, versionId.value);
34:    if (version) return ok({ version }, ctx);
35:    // Distinguish only what the caller may know: a visible note without that version.
36:    const note = await ctx.repository.findById(id.value);
37:    return notFound(note ? 'MEETING_NOTE_VERSION_NOT_FOUND' : 'MEETING_NOTE_NOT_FOUND', ctx);
38:  } catch (error) {
39:    return internalError(error, ctx, 'meetingNotes.version');
40:  }
41:}
