7:'use client';
8:
9:import { useMemo, useState } from 'react';
10:import { AlertTriangle } from 'lucide-react';
11:
12:import { Button } from '@/components/ui/button';
13:import { useUpdateMeetingNote } from '@/hooks/mutations/useMeetingNoteMutations';
14:import { MeetingNoteConflictError, type MeetingNoteFieldsPayload } from '@/lib/meeting-notes/client-api';
15:import { meetingNoteHtmlToText } from '@/lib/meeting-notes/html-text';
16:import type { MeetingNoteDetail } from '@/types/meeting-notes';
17:import { MeetingNoteConflictDialog } from './MeetingNoteConflictDialog';
18:import { MeetingNoteForm, type MeetingNoteFormInitialValues } from './MeetingNoteForm';
19:
20:export interface MeetingNoteEditPanelProps {
21:  /** The note as it was when editing started; its revision is the save's base. */
22:  note: MeetingNoteDetail;
23:  onSaved: (note: MeetingNoteDetail) => void;
24:  onCancel: () => void;
25:}
26:
27:export function MeetingNoteEditPanel({ note, onSaved, onCancel }: MeetingNoteEditPanelProps) {
28:  const update = useUpdateMeetingNote();
29:  const [base, setBase] = useState(note);
30:  const [pending, setPending] = useState<MeetingNoteFieldsPayload | null>(null);
31:  const [conflict, setConflict] = useState<MeetingNoteConflictError | null>(null);
32:  const [conflictOpen, setConflictOpen] = useState(false);
33:  const [backup, setBackup] = useState<MeetingNoteFieldsPayload | null>(null);
34:
35:  const initial = useMemo<MeetingNoteFormInitialValues>(
36:    () => ({
37:      title: base.title,
38:      meetingDate: base.meetingDate,
39:      participants: base.participants,
40:      content: base.content,
41:    }),
42:    [base]
43:  );
44:  const backupText = useMemo(
45:    () => (backup ? `${backup.title}\n\n${meetingNoteHtmlToText(backup.content)}`.trim() : ''),
46:    [backup]
47:  );
48:
49:  const submit = (fields: MeetingNoteFieldsPayload) => {
50:    setPending(fields);
51:    update.mutate(
52:      { noteId: base.id, expectedRevision: base.revision, fields },
53:      {
54:        onSuccess: (saved) => onSaved(saved),
55:        onError: (error) => {
56:          if (error instanceof MeetingNoteConflictError) {
57:            setConflict(error);
58:            setConflictOpen(true);
59:          }
60:        },
61:      }
62:    );
63:  };
64:
65:  const loadNewer = () => {
66:    if (!conflict) return;
67:    setBackup(pending);
68:    setBase(conflict.note);
69:    setConflict(null);
70:    setConflictOpen(false);
71:    update.reset();
72:  };
73:
74:  // A conflict is answered by the dialog and the banner, not as a form error.
75:  const formError = update.error instanceof MeetingNoteConflictError ? null : update.error;
76:
77:  return (
78:    <div className="flex flex-col gap-4" data-testid="meeting-note-edit-panel">
79:      {conflict && !conflictOpen ? (
80:        <div
81:          className="flex flex-wrap items-center gap-3 rounded-md border border-amber-500/40 bg-amber-500/10 px-3 
py-2 text-sm"
82:          role="alert"
83:        >
84:          <AlertTriangle className="size-4 flex-none text-amber-600" aria-hidden="true" />
85:          <span className="min-w-0 flex-1">
86:            This note was changed by someone else while you were editing. Saving again will be refused until you
87:            load the newer version.
88:          </span>
89:          <Button type="button" size="sm" variant="outline" onClick={() => setConflictOpen(true)}>
90:            Review newer version
91:          </Button>
92:        </div>
93:      ) : null}
94:
95:      {backup ? (
96:        <section
97:          aria-labelledby="meeting-note-backup-heading"
98:          className="flex flex-col gap-2 rounded-md border border-[var(--vo-line-soft)] bg-[var(--vo-bg-2)] p-3"
99:          data-testid="meeting-note-unsaved-backup"
100:        >
101:          <div className="flex items-center justify-between gap-2">
102:            <h3 id="meeting-note-backup-heading" className="text-sm font-semibold">
103:              Your earlier unsaved text
104:            </h3>
105:            <Button type="button" size="sm" variant="ghost" onClick={() => setBackup(null)}>
106:              Dismiss
107:            </Button>
108:          </div>
109:          <p className="text-xs text-muted-foreground">
110:            The form now shows the newer version. Copy anything you still need from here.
111:          </p>
112:          <textarea
113:            readOnly
114:            aria-labelledby="meeting-note-backup-heading"
115:            className="min-h-24 w-full resize-y rounded-md border border-input bg-background p-2 text-sm 
focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
116:            value={backupText}
117:          />
118:        </section>
119:      ) : null}
120:
121:      <MeetingNoteForm
122:        // Remount on a new base so every field shows the newer version.
123:        key={`${base.id}:${base.revision}`}
124:        initial={initial}
125:        submitLabel="Save changes"
126:        submitting={update.isPending}
127:        submitError={formError}
128:        onSubmit={submit}
129:        onCancel={onCancel}
130:      />
131:
132:      {conflict ? (
133:        <MeetingNoteConflictDialog
134:          open={conflictOpen}
135:          onOpenChange={setConflictOpen}
136:          newer={conflict.note}
137:          mine={pending}
138:          onLoadNewer={loadNewer}
139:        />
140:      ) : null}
141:    </div>
142:  );
143:}
