122:            aria-hidden="true"
123:          />
124:        </div>
125:
126:        {/* Scrollable content area */}
127:        <div 
128:          className="overflow-y-auto overscroll-contain"
129:          style={{ maxHeight: 'calc(85vh - 40px)' }}
130:        >
