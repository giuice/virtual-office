5:import { MeetingNotesApiError } from './client-api';
6:import { describeMeetingNoteError } from './form-errors';
7:import { MEETING_NOTE_LIMITS } from './validation';
8:
9:export type MeetingNoteItemField = 'description' | 'assignee' | 'dueDate';
10:
11:export const MEETING_NOTE_ITEM_LIMIT_MESSAGE = `${MEETING_NOTE_LIMITS.maxItemsPerNote} items maximum: this note 
already has ${MEETING_NOTE_LIMITS.maxItemsPerNote} action items. Delete one before adding another.`;
12:
13:const FIELD_ERRORS: Record<string, { field: MeetingNoteItemField; message: string }> = {
14:  MEETING_NOTE_ITEM_DESCRIPTION_INVALID: {
15:    field: 'description',
16:    message: `Enter a description of 1 to ${MEETING_NOTE_LIMITS.itemDescriptionMaxChars.toLocaleString('en-US')} 
characters.`,
17:  },
18:  MEETING_NOTE_ITEM_ASSIGNEE_INVALID: { field: 'assignee', message: 'Choose an assignee from the list.' },
19:  MEETING_NOTE_ITEM_ASSIGNEE_NOT_MEMBER: {
20:    field: 'assignee',
21:    message: 'This person is no longer a member of your company. Choose someone else or leave the item unassigned.',
22:  },
23:  MEETING_NOTE_ITEM_DUE_DATE_INVALID: { field: 'dueDate', message: 'Enter a valid due date or leave it empty.' },
24:};
25:
26:/** The field a failed item save points at, or null when it is not about one field. */
27:export function meetingNoteItemFieldError(error: unknown): { field: MeetingNoteItemField; message: string } | null {
28:  if (!(error instanceof MeetingNotesApiError) || error.status !== 400) return null;
29:  return FIELD_ERRORS[error.code] ?? null;
30:}
31:
32:/** true for the 100-items refusal. */
33:export function isMeetingNoteItemLimitError(error: unknown): boolean {
34:  return error instanceof MeetingNotesApiError && error.code === 'MEETING_NOTE_ITEM_LIMIT_REACHED';
35:}
36:
37:/** What happened and what to do, for a failed action-item change. */
38:export function describeMeetingNoteItemError(error: unknown): string {
39:  if (isMeetingNoteItemLimitError(error)) return MEETING_NOTE_ITEM_LIMIT_MESSAGE;
40:  const field = meetingNoteItemFieldError(error);
41:  if (field) return field.message;
42:  if (error instanceof MeetingNotesApiError) {
43:    switch (error.status) {
44:      case 403:
45:        return 'You do not have permission to change this action item.';
46:      case 404:
47:        return error.code === 'MEETING_NOTE_ITEM_NOT_FOUND'
48:          ? 'This action item no longer exists. The list was refreshed.'
49:          : 'This note no longer exists or you no longer have access to it.';
50:      case 409:
51:        return 'This action item was changed by someone else. Review the newer version and try again.';
52:      default:
53:        break;
54:    }
55:  }
56:  return describeMeetingNoteError(error);
57:}
