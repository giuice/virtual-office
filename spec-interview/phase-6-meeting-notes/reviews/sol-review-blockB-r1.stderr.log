src/components/floor-plan/SpaceAudioControls.tsx
1:/**
2: * Space Audio Controls Component
3: * 
4: * Provides mic toggle, audio status, and permission handling for P2P audio.
5: * Story 8A.4: Mic Controls & Default State
6: * 
7: * Features:
8: * - Mic toggle with Lucide icons
9: * - Keyboard shortcut: M to toggle
10: * - Permission denied UI
11: * - Safari audio enable button
12: */
13:
14:'use client';
15:
16:import React, { useEffect, useCallback } from 'react';
17:import { Mic, MicOff, AlertCircle } from 'lucide-react';
18:import { Button } from '@/components/ui/button';
19:import {
20:	Tooltip,
21:	TooltipContent,
22:	TooltipProvider,
23:	TooltipTrigger,
24:} from '@/components/ui/tooltip';
25:import { cn } from '@/lib/utils';
26:import { useAudio } from '@/contexts/AudioContext';
27:import { useVoiceActivity } from '@/hooks/useVoiceActivity';
28:
29:interface SpaceAudioControlsProps {
30:	className?: string;
31:	onSpeakingChange?: (isSpeaking: boolean) => void;
32:}
33:
34:export function SpaceAudioControls({ className, onSpeakingChange }: SpaceAudioControlsProps) {
35:	const {
36:		webrtcManager,
37:		isMuted,
38:		isAudioEnabled,
39:		isInitializing,
40:		micPermission,
41:		error,
42:		initializeAudio,
43:		toggleMute,
44:		peerCount,
45:	} = useAudio();
46:
47:	// Voice Activity Detection
48:	const localStream = webrtcManager?.getLocalStream() ?? null;
49:	const { isSpeaking } = useVoiceActivity({
50:		stream: localStream,
51:		enabled: isAudioEnabled && !isMuted,
52:		onSpeakingChange,
53:	});
54:
55:	// Keyboard shortcut: M to toggle mute (only when not typing)
56:	useEffect(() => {
57:		const handleKeyDown = (e: KeyboardEvent) => {
58:			const target = e.target instanceof HTMLElement ? e.target : null;
59:			// Ignore if user is typing in any input field or contenteditable
60:			const isTyping =
61:				['INPUT', 'TEXTAREA', 'SELECT'].includes(target?.tagName ?? '') ||
62:				target?.isContentEditable ||
63:				target?.closest('[contenteditable="true"]');
64:
65:			if (e.key.toLowerCase() === 'm' && !isTyping) {
66:				e.preventDefault();
67:				if (isAudioEnabled) {
68:					toggleMute();
69:				}
70:			}
71:		};
72:
73:		window.addEventListener('keydown', handleKeyDown);
74:		return () => window.removeEventListener('keydown', handleKeyDown);
75:	}, [isAudioEnabled, toggleMute]);
76:
77:	// Handle enable audio click
78:	const handleEnableAudio = useCallback(async () => {
79:		await initializeAudio();
80:	}, [initializeAudio]);
81:
82:	// Permission denied state - icon only
83:	if (micPermission === 'denied') {
84:		return (
85:			<TooltipProvider>
86:				<Tooltip>
87:					<TooltipTrigger asChild>
88:						<Button
89:							variant="ghost"
90:							size="icon"
91:							className={cn('size-9 text-destructive', className)}
92:							aria-label="Microphone permission denied"
93:							data-space-action
94:							disabled
95:						>
96:							<MicOff className="size-4" />
97:						</Button>
98:					</TooltipTrigger>
99:					<TooltipContent>
100:						<p>Permissão de microfone negada</p>
101:					</TooltipContent>
102:				</Tooltip>
103:			</TooltipProvider>
104:		);
105:	}
106:
107:	// Audio not initialized - show enable button (icon only)
108:	if (!isAudioEnabled) {
109:		return (
110:			<TooltipProvider>
111:				<Tooltip>
112:					<TooltipTrigger asChild>
113:						<Button
114:							variant="ghost"
115:							size="icon"
116:							className={cn('size-9', className)}
117:							aria-label="Enable microphone"
118:							data-space-action
119:							onClick={() => void handleEnableAudio()}
120:							disabled={isInitializing}
121:						>
122:							{isInitializing ? (
123:								<span className="size-4 animate-pulse">●</span>
124:							) : (
125:								<Mic className="size-4 text-muted-foreground" />
126:							)}
127:						</Button>
128:					</TooltipTrigger>
129:					<TooltipContent>
130:						<p>Entrar no áudio</p>
131:					</TooltipContent>
132:				</Tooltip>
133:			</TooltipProvider>
134:		);
135:	}
136:
137:	// Error state with retry button (icon only)
138:	if (error) {
139:		return (
140:			<TooltipProvider>
141:				<Tooltip>
142:					<TooltipTrigger asChild>
143:						<Button
144:							variant="ghost"
145:							size="icon"
146:							className={cn('size-9 text-amber-500', className)}
147:							aria-label="Retry microphone"
148:							data-space-action
149:							onClick={() => void handleEnableAudio()}
150:						>
151:							<AlertCircle className="size-4" />
152:						</Button>
153:					</TooltipTrigger>
154:					<TooltipContent>
155:						<p>{error} - Clique para tentar novamente</p>
156:					</TooltipContent>
157:				</Tooltip>
158:			</TooltipProvider>
159:		);
160:	}
161:
162:	// Audio enabled - show mic toggle (icon only)
163:	return (
164:		<TooltipProvider>
165:			<Tooltip>
166:				<TooltipTrigger asChild>
167:					<Button
168:						variant={isMuted ? 'ghost' : 'default'}
169:						size="icon"
170:						aria-label={
171:							isMuted
172:								? 'Unmute microphone'
173:								: `Mute microphone${isSpeaking ? ', speaking' : ''}`
174:						}
175:						data-space-action
176:						data-speaking={isSpeaking ? 'true' : 'false'}
177:						onClick={toggleMute}
178:						className={cn(
179:							'size-9 transition-all duration-200',
180:							!isMuted && isSpeaking && 'ring-2 ring-green-500 ring-offset-2',
181:							className
182:						)}
183:					>
184:						{isMuted ? (
185:							<MicOff className="size-4 text-muted-foreground" />
186:						) : (
187:							<Mic className={cn(
188:								'size-4',
189:								isSpeaking ? 'text-green-500' : 'text-foreground'
190:							)} />
191:						)}
192:					</Button>
193:				</TooltipTrigger>
194:				<TooltipContent>
195:					<p>{isMuted ? 'Ativar microfone (M)' : 'Desativar microfone (M)'}</p>
196:					{peerCount > 0 && (
197:						<p className="text-xs text-muted-foreground">{peerCount} conectado{peerCount > 1 ? 's' : ''}</p>
198:					)}
199:				</TooltipContent>
200:			</Tooltip>
201:		</TooltipProvider>
202:	);
203:}
src/components/floor-plan/ScreenShareControls.tsx
1:'use client';
2:
3:import { useState } from 'react';
4:import { AlertCircle, MonitorOff, MonitorUp } from 'lucide-react';
5:import { useAudio } from '@/contexts/AudioContext';
6:import { Button } from '@/components/ui/button';
7:import {
8:  Tooltip,
9:  TooltipContent,
10:  TooltipProvider,
11:  TooltipTrigger,
12:} from '@/components/ui/tooltip';
13:
14:interface ScreenShareControlsProps {
15:  isCurrentOccupant: boolean;
16:  currentUserId?: string;
17:}
18:
19:const CANCELLED_COPY = 'Screen sharing was cancelled.';
20:const UNSUPPORTED_COPY = "Screen sharing isn’t supported in this browser. Use a current supported browser.";
21:
22:function stopInteractivePropagation(event: React.SyntheticEvent): void {
23:  event.stopPropagation();
24:}
25:
26:function isCaptureSupported(): boolean {
27:  return typeof navigator !== 'undefined'
28:    && typeof navigator.mediaDevices?.getDisplayMedia === 'function';
29:}
30:
31:export function ScreenShareControls({
32:  isCurrentOccupant,
33:  currentUserId,
34:}: ScreenShareControlsProps) {
35:  const {
36:    activeScreenShare,
37:    screenShareError,
38:    screenShareStatus,
39:    startScreenShare,
40:    stopScreenShare,
41:    currentUserId: contextCurrentUserId,
42:  } = useAudio();
43:  const [isLocalStartPending, setIsLocalStartPending] = useState(false);
44:
45:  if (!isCurrentOccupant) return null;
46:
47:  const resolvedCurrentUserId = currentUserId ?? contextCurrentUserId;
48:  const isOwner = Boolean(
49:    activeScreenShare
50:    && resolvedCurrentUserId
51:    && activeScreenShare.presenterUserId === resolvedCurrentUserId,
52:  );
53:  const supported = isCaptureSupported();
54:  const isCanonicalBusy = screenShareStatus === 'opening-picker'
55:    || screenShareStatus === 'claiming'
56:    || screenShareStatus === 'stopping';
57:  const localProgress = isLocalStartPending
58:    ? screenShareStatus === 'claiming'
59:      ? 'Starting screen share…'
60:      : 'Opening screen picker…'
61:    : null;
62:  const statusCopy = activeScreenShare
63:    ? `${activeScreenShare.presenterName} is sharing their screen`
64:    : screenShareError ?? 'No one is sharing a screen';
65:  const isCancellation = screenShareError === CANCELLED_COPY;
66:  const actionableError = screenShareError && !isCancellation
67:    ? screenShareError
68:    : !supported
69:      ? UNSUPPORTED_COPY
70:      : null;
71:
72:  const handleStart = async (): Promise<void> => {
73:    setIsLocalStartPending(true);
74:    try {
75:      await startScreenShare();
76:    } finally {
77:      setIsLocalStartPending(false);
78:    }
79:  };
80:
81:  const handleStop = (): void => {
82:    void stopScreenShare('user-stop');
83:  };
84:
85:  const buttonLabel = isOwner
86:    ? 'Stop sharing'
87:    : localProgress ?? 'Share screen';
88:  const tooltip = isOwner
89:    ? 'Stop sharing'
90:    : !supported
91:      ? UNSUPPORTED_COPY
92:      : activeScreenShare
93:        ? `${activeScreenShare.presenterName} is sharing their screen`
94:        : 'Share your screen';
95:  const Icon = isOwner ? MonitorOff : !supported ? AlertCircle : MonitorUp;
96:
97:  return (
98:    <div
99:      className="flex min-w-0 max-w-full flex-col items-start gap-1"
100:      data-space-action
101:      onPointerDown={stopInteractivePropagation}
102:      onClick={stopInteractivePropagation}
103:      onKeyDown={stopInteractivePropagation}
104:    >
105:      <TooltipProvider>
106:        <Tooltip>
107:          <TooltipTrigger asChild>
108:            <Button
109:              type="button"
110:              variant="outline"
111:              size="sm"
112:              className="min-h-9 max-w-full motion-reduce:transition-none [@media(pointer:coarse)]:min-h-11 
[@media(pointer:coarse)]:min-w-11"
113:              aria-label={isOwner ? 'Stop sharing' : 'Share screen'}
114:              disabled={!isOwner && (!supported || isCanonicalBusy || Boolean(activeScreenShare))}
115:              data-screen-share-trigger={!isOwner ? 'true' : undefined}
116:              data-space-action
117:              onClick={isOwner ? handleStop : () => void handleStart()}
118:            >
119:              <Icon className="size-4 shrink-0" aria-hidden="true" />
120:              <span className="hidden truncate md:inline">{buttonLabel}</span>
121:            </Button>
122:          </TooltipTrigger>
123:          <TooltipContent
124:            data-space-action
125:            onPointerDown={stopInteractivePropagation}
126:            onClick={stopInteractivePropagation}
127:            onKeyDown={stopInteractivePropagation}
128:          >
129:            {tooltip}
130:          </TooltipContent>
131:        </Tooltip>
132:      </TooltipProvider>
133:
134:      {localProgress ? (
135:        <span className="max-w-full break-words text-xs leading-5" aria-live="polite">
136:          {localProgress}
137:        </span>
138:      ) : null}
139:      {isCancellation ? (
140:        <span className="max-w-full break-words text-xs leading-5" aria-live="polite">
141:          {CANCELLED_COPY}
142:        </span>
143:      ) : (
144:        <span className="sr-only" aria-live="polite">
145:          {statusCopy}
146:        </span>
147:      )}
148:      {actionableError ? (
149:        <p className="max-w-full break-words text-xs leading-5 text-destructive" role="alert">
150:          {actionableError}
151:        </p>
152:      ) : null}
153:    </div>
154:  );
155:}
