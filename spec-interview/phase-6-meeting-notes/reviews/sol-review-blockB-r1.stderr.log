59:    await author.getByLabel('Space', { exact: true }).selectOption({ label: space.name });
60:    await expect(author.locator(`[data-testid="meeting-note-result"][data-note-id="${keptId}"]`)).toBeVisible({
61:      timeout: 15_000,
62:    });
63:    await expect(author.locator(`[data-testid="meeting-note-result"][data-note-id="${noteId}"]`)).toHaveCount(0);
64:
65:    // Gone for everyone: the API and the view answer "not found".
66:    expect((await notesWorld.readNote(author, noteId)).status).toBe(404);
67:    await participant.goto(`/meetings/${noteId}`);
68:    await expect(participant.getByTestId('meeting-note-unavailable')).toContainText('Meeting note not found', {
69:      timeout: 30_000,
70:    });
71:  });
