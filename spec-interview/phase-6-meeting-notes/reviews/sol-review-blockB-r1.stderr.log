46:    await author.getByTestId('meeting-note-delete-button').click();
47:    let confirm = author.getByRole('alertdialog');
48:    await expect(confirm).toContainText('Delete this meeting note?');
49:    await expect(confirm).toContainText(title);
50:    await confirm.getByRole('button', { name: 'Cancel' }).click();
51:    await expect(confirm).toBeHidden();
52:    expect((await notesWorld.readNote(author, noteId)).status).toBe(200);
