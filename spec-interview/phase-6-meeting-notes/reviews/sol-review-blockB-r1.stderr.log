5:/**
6: * AC-017, UI part (FR-024, BR-009): an admin saves provider, model, reasoning
7: * level, API key, and daily limit 50 in the company page's Settings → AI
8: * section; the key is shown only as its last four characters, the input is
9: * write-only, the metadata survives a reload, and a member sees no AI settings
10: * section (the members-only page has no Settings tab). Route, database, Vault,
11: * Realtime, and log evidence is in the DB integration suite
12: * (__tests__/meeting-notes-db/meeting-note-ai-settings.test.ts).
13: * Only a canary key is used; the company's AI settings are reset before and
14: * after so the shared seed company never keeps a key.
15: */
16:
17:async function openAiSettings(page: Page): Promise<void> {
18:  await page.goto('/company?tab=settings');
19:  const settingsTab = page.getByRole('tab', { name: 'Company Settings' });
20:  await expect(settingsTab).toBeVisible({ timeout: 30_000 });
21:  if ((await settingsTab.getAttribute('data-state')) !== 'active') await settingsTab.click();
22:  await expect(page.getByTestId('ai-settings-section')).toBeVisible({ timeout: 30_000 });
23:}
24:
25:async function choose(page: Page, triggerTestId: string, option: string): Promise<void> {
26:  await page.getByTestId(triggerTestId).click();
27:  await page.getByRole('option', { name: option, exact: true }).click();
28:  await expect(page.getByTestId(triggerTestId)).toContainText(option);
29:}
