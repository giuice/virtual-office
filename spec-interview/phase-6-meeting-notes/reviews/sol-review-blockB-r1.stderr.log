25:/**
26: * GET /api/meeting-notes/[id]/export[?includeTranscript=true|false][&timeZone=IANA]
27: * — the note as a Markdown download (FR-027, AC-019): title, meeting date (as
28: * a calendar day in `timeZone`, default UTC), space or "Space removed",
29: * author, participants, content converted to Markdown, summary, action items,
30: * and the stored transcript only with includeTranscript=true. Read with the
31: * caller's session (RLS); a note of another company answers exactly like a
32: * random id (404). User and AI text is escaped (no raw HTML in the file).
33: */
34:export async function GET(request: NextRequest, { params }: RouteParams): Promise<NextResponse> {
35:  const begun = await beginMeetingNoteRequest('/api/meeting-notes/[id]/export');
36:  if (!begun.ok) return begun.response;
37:  const ctx = begun.value;
38:
39:  const id = parsePathId((await params).id, 'MEETING_NOTE_NOT_FOUND', ctx);
40:  if (!id.ok) return id.response;
41:
42:  const search = request.nextUrl.searchParams;
43:  const query = parseWith(
44:    exportMeetingNoteQuerySchema,
45:    {
46:      includeTranscript: search.get('includeTranscript') ?? undefined,
47:      timeZone: search.get('timeZone') ?? undefined,
48:    },
49:    ctx
50:  );
51:  if (!query.ok) return query.response;
52:  const { includeTranscript, timeZone } = query.value;
53:
54:  try {
55:    const note = await loadMeetingNoteDetail(ctx.repository, ctx.dbUser, id.value, { includeTranscript });
56:    if (!note) return notFound('MEETING_NOTE_NOT_FOUND', ctx);
57:    const markdown = buildMeetingNoteMarkdown(note, { includeTranscript, timeZone });
58:    const names = meetingNoteExportFilenames(note.title, calendarDayInZone(note.meetingDate, timeZone));
59:    return new NextResponse(markdown, {
60:      status: 200,
61:      headers: {
62:        'content-type': 'text/markdown; charset=utf-8',
63:        'content-disposition': meetingNoteExportContentDisposition(names),
64:        'cache-control': 'private, no-store',
65:        'x-content-type-options': 'nosniff',
66:        'x-correlation-id': ctx.correlationId,
67:      },
68:    });
69:  } catch (error) {
70:    return internalError(error, ctx, 'meetingNotes.export');
71:  }
72:}
