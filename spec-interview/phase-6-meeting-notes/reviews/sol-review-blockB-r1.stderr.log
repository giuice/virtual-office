25:/** BR-005: editors, and the item's assignee while they are a current member. */
26:function canToggleItem(item: MeetingNoteActionItemView, canEdit: boolean, viewerId: string | null): boolean {
27:  return canEdit || (viewerId !== null && item.assigneeId === viewerId && item.assigneeIsCurrentMember === true);
28:}
