src/hooks/ui/use-debounced-value.ts
1:'use client';
2:
3:import { useEffect, useState } from 'react';
4:
5:/** `value`, updated only after it has stayed unchanged for `delayMs`. */
6:export function useDebouncedValue<T>(value: T, delayMs: number): T {
7:  const [debounced, setDebounced] = useState(value);
8:
9:  useEffect(() => {
10:    const timer = window.setTimeout(() => setDebounced(value), delayMs);
11:    return () => window.clearTimeout(timer);
12:  }, [value, delayMs]);
13:
14:  return debounced;
15:}
