67:  const [dueDate, setDueDate] = useState(item?.dueDate ?? '');
68:  const [storedAssignee, setStoredAssignee] = useState(() => storedAssigneeOf(item));
69:  const [baseRevision, setBaseRevision] = useState(item?.revision ?? 0);
70:  const [errors, setErrors] = useState<Partial<Record<MeetingNoteItemField, string>>>({});
71:  const [formError, setFormError] = useState<string | null>(null);
72:  const [conflict, setConflict] = useState<MeetingNoteActionItemView | null>(null);
73:
74:  const submitting = create.isPending || update.isPending;
75:  const length = codePointLength(description.trim());
76:
77:  const save = (expectedRevision: number) => {
78:    const trimmed = description.trim();
79:    const nextErrors: Partial<Record<MeetingNoteItemField, string>> = {};
80:    if (length < 1 || length > MEETING_NOTE_LIMITS.itemDescriptionMaxChars) {
81:      nextErrors.description = `Enter a description of 1 to 
${MEETING_NOTE_LIMITS.itemDescriptionMaxChars.toLocaleString('en-US')} characters.`;
82:    }
83:    if (dueDate !== '' && !DATE_ONLY.test(dueDate)) {
84:      nextErrors.dueDate = 'Enter a valid due date or leave it empty.';
85:    }
86:    setErrors(nextErrors);
87:    setFormError(null);
88:    if (Object.keys(nextErrors).length > 0) return;
89:
90:    const fields: MeetingNoteActionItemFieldsInput = {
91:      description: trimmed,
92:      assigneeId,
93:      dueDate: dueDate === '' ? null : dueDate,
94:    };
95:    const handlers = {
96:      onSuccess: () => {
97:        setConflict(null);
98:        onSaved();
99:      },
100:      onError: (error: unknown) => {
101:        if (error instanceof MeetingNoteItemConflictError) {
102:          setConflict(error.item);
103:          return;
104:        }
105:        const field = meetingNoteItemFieldError(error);
106:        if (field) {
107:          setErrors({ [field.field]: field.message });
108:          return;
109:        }
110:        setFormError(describeMeetingNoteItemError(error));
111:      },
112:    };
113:    if (item) {
114:      update.mutate({ noteId, itemId: item.id, expectedRevision, fields }, handlers);
115:    } else {
116:      create.mutate({ noteId, fields }, handlers);
117:    }
118:  };
119:
120:  const handleSubmit = (event: FormEvent<HTMLFormElement>) => {
121:    event.preventDefault();
122:    if (!submitting) save(baseRevision);
123:  };
124:
125:  const saveOverNewer = () => {
126:    if (!conflict) return;
127:    setBaseRevision(conflict.revision);
128:    save(conflict.revision);
129:  };
130:
131:  const loadNewer = () => {
132:    if (!conflict) return;
133:    setDescription(conflict.description);
134:    setAssigneeId(conflict.assigneeId);
135:    setDueDate(conflict.dueDate ?? '');
136:    setStoredAssignee(storedAssigneeOf(conflict));
137:    setBaseRevision(conflict.revision);
138:    setErrors({});
139:    setConflict(null);
140:  };
141:
142:  const fieldError = (id: string, message: string | undefined) =>
143:    message ? (
144:      <p id={id} className="text-xs text-destructive" role="alert">
145:        {message}
146:      </p>
147:    ) : null;
148:
149:  return (
150:    <form
151:      className="flex flex-col gap-3 rounded-lg border border-[var(--vo-line-soft)] bg-[var(--vo-bg-2)] p-3"
152:      noValidate
153:      onSubmit={handleSubmit}
154:      aria-busy={submitting}
155:      aria-label={item ? 'Edit action item' : 'New action item'}
156:      data-testid="meeting-note-item-form"
157:    >
158:      <div className="flex flex-col gap-1.5">
159:        <Label htmlFor={ids.description}>Description</Label>
160:        <Textarea
161:          id={ids.description}
162:          value={description}
163:          rows={2}
164:          required
165:          autoFocus
166:          aria-invalid={errors.description ? 'true' : 'false'}
167:          aria-describedby={errors.description ? ids.descriptionError : undefined}
168:          onChange={(event) => setDescription(event.target.value)}
169:          disabled={submitting}
170:          data-testid="meeting-note-item-description-input"
171:        />
172:        <div className="flex justify-between gap-2">
173:          {fieldError(ids.descriptionError, errors.description) ?? <span />}
174:          <span className="text-xs text-muted-foreground" aria-live="polite">
175:            {length}/{MEETING_NOTE_LIMITS.itemDescriptionMaxChars.toLocaleString('en-US')}
176:          </span>
177:        </div>
178:      </div>
179:
180:      <div className="grid gap-3 sm:grid-cols-2">
181:        <div className="flex flex-col gap-1.5">
182:          <Label htmlFor={ids.assignee}>Assignee</Label>
183:          <MeetingNoteActionItemAssigneeSelect
184:            id={ids.assignee}
185:            value={assigneeId}
186:            members={members}
187:            storedAssignee={storedAssignee}
188:            disabled={submitting}
189:            invalid={Boolean(errors.assignee)}
190:            describedById={errors.assignee ? ids.assigneeError : undefined}
191:            onChange={setAssigneeId}
192:          />
193:          {fieldError(ids.assigneeError, errors.assignee)}
194:        </div>
195:        <div className="flex flex-col gap-1.5">
196:          <Label htmlFor={ids.dueDate}>Due date</Label>
197:          <Input
198:            id={ids.dueDate}
199:            type="date"
200:            className="h-9"
201:            value={dueDate}
202:            aria-invalid={errors.dueDate ? 'true' : 'false'}
203:            aria-describedby={errors.dueDate ? ids.dueDateError : undefined}
204:            onChange={(event) => setDueDate(event.target.value)}
205:            disabled={submitting}
206:            data-testid="meeting-note-item-due-input"
207:          />
208:          {fieldError(ids.dueDateError, errors.dueDate)}
209:        </div>
210:      </div>
211:
212:      {conflict ? (
213:        <MeetingNoteActionItemConflictNotice
214:          newer={conflict}
215:          membersById={membersById}
216:          message="This action item was changed by someone else. Your changes were not saved."
217:        >
218:          <Button type="button" size="sm" variant="ghost" onClick={loadNewer} disabled={submitting}>
219:            Load the newer version
220:          </Button>
221:          <Button type="button" size="sm" onClick={saveOverNewer} disabled={submitting} 
data-testid="meeting-note-item-conflict-retry">
222:            Save my changes again
223:          </Button>
224:        </MeetingNoteActionItemConflictNotice>
225:      ) : null}
226:
227:      {formError ? (
228:        <p
229:          className="rounded-md border border-destructive/40 bg-destructive/10 px-3 py-2 text-sm text-destructive"
230:          role="alert"
231:          data-testid="meeting-note-item-form-error"
232:        >
233:          {formError}
234:        </p>
235:      ) : null}
236:
237:      <div className="flex items-center justify-end gap-2">
238:        <Button type="button" variant="ghost" size="sm" onClick={onCancel} disabled={submitting}>
239:          Cancel
240:        </Button>
241:        <Button type="submit" size="sm" disabled={submitting || conflict !== null} 
data-testid="meeting-note-item-save">
242:          {submitting ? <Loader2 className="mr-2 size-4 animate-spin" aria-hidden="true" /> : null}
243:          {item ? 'Save item' : 'Add item'}
244:        </Button>
245:      </div>
246:    </form>
247:  );
