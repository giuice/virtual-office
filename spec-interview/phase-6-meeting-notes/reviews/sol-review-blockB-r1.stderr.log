17:/**
18: * Story 3.11 - AC8: Mobile Tap-to-Expand (Bottom Sheet Pattern)
19: * - Mobile: tap to expand shows details in bottom sheet modal
20: * - Bottom sheet slides up from bottom of screen
21: * - Close button and swipe-down to dismiss
22: * - Same content as SpaceDetailPanel
23: * - Uses a non-modal Radix Dialog so the global Knock banner remains operable
24: */
25:export interface SpaceDetailBottomSheetProps extends Omit<SpaceDetailPanelProps, 'className'> {
26:  open: boolean;
27:  onOpenChange: (open: boolean) => void;
28:}
