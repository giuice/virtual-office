23:type Scope = { userId: string; companyId: string };
24:
25:function requireScope(scope: Scope | null): Scope {
26:  if (!scope) throw new MeetingNotesApiError(401, 'NO_SESSION', 'Your session is not ready. Reload the page and try 
again.');
27:  return scope;
28:}
