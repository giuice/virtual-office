27:export function MeetingNoteLinkControl({
28:  editor,
29:  disabled,
30:  active,
31:  currentHref,
32:  tabIndex,
33:  onFocus,
34:}: MeetingNoteLinkControlProps) {
35:  const inputId = useId();
36:  const errorId = useId();
37:  const [open, setOpen] = useState(false);
38:  const [value, setValue] = useState('');
39:  const [error, setError] = useState<string | null>(null);
40:
41:  const onOpenChange = (next: boolean) => {
42:    if (next) {
43:      setValue(currentHref);
44:      setError(null);
45:    }
46:    setOpen(next);
