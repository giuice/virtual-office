99:/** The first issue's stable code; a revision issue is reported as such, the rest as BAD_REQUEST. */
100:function validationCode(issues: readonly z.core.$ZodIssue[]): string {
101:  const issue = issues[0];
102:  if (!issue) return 'BAD_REQUEST';
103:  if (/^[A-Z_]+$/.test(issue.message) && issue.message in MESSAGES) return issue.message;
104:  if (issue.path[0] === 'expectedRevision') return 'MEETING_NOTE_AI_REVISION_INVALID';
105:  return 'BAD_REQUEST';
106:}
