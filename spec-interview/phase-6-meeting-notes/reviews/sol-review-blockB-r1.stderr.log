66:/** Retry only failures a retry can fix: network errors and 5xx (never 4xx/429). */
67:export function shouldRetryMeetingNotesRequest(failureCount: number, error: unknown): boolean {
68:  if (failureCount >= 2) return false;
69:  if (!(error instanceof MeetingNotesApiError)) return false;
70:  return error.status === 0 || error.status >= 500;
71:}
