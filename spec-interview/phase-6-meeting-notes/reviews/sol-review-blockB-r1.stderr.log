133:/**
134: * PUT /api/companies/ai-settings — admins of the caller's company only.
135: * Body: { expectedRevision: number|null, provider, model, reasoningLevel,
136: * dailyLimit: 1..200, apiKey?: string|null }. 200 { settings } (masked);
137: * 409 { code, currentRevision, settings } when another save landed first.
138: */
139:export async function PUT(request: NextRequest): Promise<NextResponse> {
140:  const begun = await beginMeetingNoteRequest(PATH, 'meeting-note:ai-settings');
141:  if (!begun.ok) {
142:    await request.body?.cancel().catch(() => undefined);
143:    return begun.response;
144:  }
145:  const ctx = begun.value;
146:  const companyId = ctx.dbUser.companyId;
147:  if (!companyId || ctx.dbUser.role !== 'admin') {
148:    await request.body?.cancel().catch(() => undefined);
149:    return error(403, 'MEETING_NOTE_AI_SETTINGS_FORBIDDEN', ctx.correlationId, 'aiSettings.save.authorize');
150:  }
151:
152:  const contentType = request.headers.get('content-type') ?? '';
153:  if (contentType.split(';')[0].trim().toLowerCase() !== 'application/json') {
154:    await request.body?.cancel().catch(() => undefined);
155:    return error(415, 'UNSUPPORTED_MEDIA_TYPE', ctx.correlationId);
156:  }
157:  const raw = await readBoundedBody(request, MAX_BODY_BYTES);
158:  if (!raw.ok) {
159:    return raw.reason === 'too_large'
160:      ? error(413, 'PAYLOAD_TOO_LARGE', ctx.correlationId)
161:      : error(400, 'BAD_REQUEST', ctx.correlationId);
162:  }
163:  let json: unknown;
164:  try {
165:    json = JSON.parse(new TextDecoder('utf-8', { fatal: true }).decode(raw.bytes));
166:  } catch {
167:    return error(400, 'BAD_REQUEST', ctx.correlationId);
168:  }
169:  const parsed = saveBodySchema.safeParse(json);
170:  if (!parsed.success) return error(400, validationCode(parsed.error.issues), ctx.correlationId);
171:  const body = parsed.data;
172:
173:  const selection = checkMeetingNoteAiSelection(body.provider, body.model, body.reasoningLevel);
174:  if (selection !== 'ok') return error(400, selection, ctx.correlationId);
175:
176:  let service;
177:  try {
178:    service = await createSupabaseServerClient('service_role');
179:  } catch (cause) {
180:    return internalError(cause, ctx.correlationId, 'aiSettings.save.client');
181:  }
182:
183:  try {
184:    const settings = await new SupabaseMeetingNoteAiSettingsRepository(service).save({
185:      actorUserId: ctx.dbUser.id,
186:      companyId,
187:      expectedRevision: body.expectedRevision,
188:      provider: body.provider,
189:      model: body.model,
190:      reasoningLevel: body.reasoningLevel,
191:      dailyLimit: body.dailyLimit,
192:      apiKey: body.apiKey ?? null,
193:    });
194:    return ok({ settings }, ctx);
195:  } catch (cause) {
196:    if (!(cause instanceof MeetingNoteAiSettingsDbError) || cause.token === null) {
197:      return internalError(cause, ctx.correlationId, 'aiSettings.save');
198:    }
199:    if (cause.token === 'MEETING_NOTE_AI_SETTINGS_STALE_REVISION') {
200:      return staleConflict(ctx.supabase, companyId, ctx.correlationId);
201:    }
202:    if (cause.sqlstate === '42501') {
203:      return error(403, cause.token, ctx.correlationId, 'aiSettings.save');
204:    }
205:    return error(400, cause.token, ctx.correlationId, 'aiSettings.save');
206:  }
207:}
