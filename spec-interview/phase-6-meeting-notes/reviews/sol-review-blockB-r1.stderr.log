__tests__/api/playwright/meeting-notes/space-removed.spec.ts
1:import { expect, test } from '../fixtures/meeting-notes';
2:import { MEETING_NOTES_E2E_PREFIX, uniqueSearchWord } from '../helpers/meeting-notes-e2e';
3:
4:/**
5: * AC-020 (FR-028; UI label part — editing rights after deletion are T6, the
6: * database contract is the DB integration suite): once a space is deleted,
7: * its notes stay on the Meetings page and in search, labelled "Space removed",
8: * with their author kept.
9: */
10:test.describe('meeting notes — deleted space (AC-020)', () => {
11:  test('notes of a deleted space show "Space removed" on the Meetings page and in search', async ({
12:    primaryPage,
13:    secondaryPage,
14:    notesWorld,
15:  }) => {
16:    const word = uniqueSearchWord();
17:    const space = await notesWorld.createSpace('Doomed room');
18:    const title = `${MEETING_NOTES_E2E_PREFIX} Retrospective ${word}`;
19:    await notesWorld.createNote(primaryPage, {
20:      spaceId: space.id,
21:      title,
22:      meetingDate: new Date(),
23:      content: `<p>Kept after the space is gone ${word}</p>`,
24:    });
25:
26:    // The admin deletes the space through the real route (no one is inside it).
27:    await notesWorld.deleteSpaceThroughApi(primaryPage, space.id);
28:
29:    const page = secondaryPage;
30:    await page.goto('/meetings');
31:    await expect(page.getByRole('heading', { name: 'Meetings' })).toBeVisible({ timeout: 30_000 });
32:    const authorName = process.env.PLAYWRIGHT_PRIMARY_DISPLAY_NAME ?? 'Local Primary';
33:
34:    // Meetings page list (empty search): the note is listed with the label.
35:    const listed = page.getByTestId('meeting-note-result').filter({ hasText: title });
36:    await expect(listed).toHaveCount(1, { timeout: 15_000 });
37:    await expect(listed.getByTestId('meeting-note-space-removed')).toHaveText('Space removed');
38:    await expect(listed).not.toContainText(space.name);
39:    await expect(listed).toContainText(authorName);
40:
41:    // Search: the same label.
42:    await page.getByLabel('Search notes', { exact: true }).fill(word);
43:    const found = page.getByTestId('meeting-note-result').filter({ hasText: title });
44:    await expect(page.getByTestId('meeting-note-result')).toHaveCount(1, { timeout: 15_000 });
45:    await expect(found.getByTestId('meeting-note-space-removed')).toHaveText('Space removed');
46:
47:    // The "Space removed" filter finds it; the deleted space is no longer a choice.
48:    await page.getByLabel('Space', { exact: true }).selectOption({ label: 'Space removed' });
49:    await expect(found).toHaveCount(1, { timeout: 15_000 });
50:    await expect(page.getByLabel('Space', { exact: true }).locator('option', { hasText: space.name 
})).toHaveCount(0);
51:  });
52:});
__tests__/api/playwright/meeting-notes/note-former-member.spec.ts
1:import { expect, test } from '../fixtures/meeting-notes';
2:import { MEETING_NOTES_E2E_PREFIX } from '../helpers/meeting-notes-e2e';
3:import { noteEditor, openNote, saveNoteForm } from '../helpers/meeting-notes-ui';
4:
5:/**
6: * AC-021, display part (FR-030): a participant who left the company is shown
7: * as "Former member" with the name snapshot, in the view and in the edit
8: * form; saving the note while they are still listed succeeds and keeps them;
9: * they cannot be newly picked. Access and rejoin rules are covered at the
10: * database level.
11: */
12:test.describe('meeting notes — former member participants (AC-021)', () => {
13:  test('shows a removed participant as "Former member" and keeps them on save', async ({
14:    primaryPage,
15:    messagingData,
16:    notesWorld,
17:  }) => {
18:    const space = await notesWorld.createSpace('Former member room');
19:    const leaver = await notesWorld.createCompanyMember('Leaver');
20:    const title = `${MEETING_NOTES_E2E_PREFIX} Former ${notesWorld.runTag}`;
21:    const noteId = await notesWorld.createNote(primaryPage, {
22:      spaceId: space.id,
23:      title,
24:      meetingDate: new Date(),
25:      content: '<p>Before the change</p>',
26:      participantIds: [leaver.id, messagingData.secondary.userId],
27:    });
28:    await notesWorld.removeFromCompany(leaver.id);
29:
30:    const page = primaryPage;
31:    await openNote(page, noteId);
32:    const leaverRow = page.getByTestId('meeting-note-participant').filter({ hasText: leaver.displayName });
33:    await expect(leaverRow).toBeVisible();
34:    await expect(leaverRow).toHaveAttribute('data-former-member', 'true');
35:    await expect(leaverRow.getByTestId('meeting-note-former-member')).toHaveText('Former member');
36:    const secondaryName = await notesWorld.displayNameOf(messagingData.secondary.userId);
37:    const currentRow = page.getByTestId('meeting-note-participant').filter({ hasText: secondaryName });
38:    await expect(currentRow.getByTestId('meeting-note-former-member')).toHaveCount(0);
39:
40:    // The edit form lists them as "Former member" too, removable but not pickable.
41:    await page.getByTestId('meeting-note-edit-button').click();
42:    await noteEditor(page);
43:    const chip = page.getByTestId('meeting-note-participant-chip').filter({ hasText: leaver.displayName });
44:    await expect(chip).toContainText('Former member');
45:    await expect(chip.getByRole('button', { name: `Remove ${leaver.displayName}` })).toBeEnabled();
46:    await page.getByRole('button', { name: 'Add participants' }).click();
47:    await page.getByRole('textbox', { name: 'Search members' }).fill(leaver.displayName);
48:    await expect(page.getByRole('button', { name: `Add ${leaver.displayName}` })).toHaveCount(0);
49:    await page.keyboard.press('Escape');
50:
51:    // Saving with the former member still listed succeeds and keeps them.
52:    const newTitle = `${title} (edited)`;
53:    await page.getByLabel('Title').fill(newTitle);
54:    await saveNoteForm(page);
55:    await expect(page.getByTestId('meeting-note-title')).toHaveText(newTitle);
56:    await expect(page.getByTestId('meeting-note-view')).toHaveAttribute('data-revision', '2');
57:    await expect(
58:      page.getByTestId('meeting-note-participant').filter({ hasText: leaver.displayName }),
59:    ).toHaveAttribute('data-former-member', 'true');
60:
61:    const saved = await notesWorld.readNote(page, noteId);
62:    expect(saved.note?.participants.find((participant) => participant.userId === leaver.id)).toMatchObject({
63:      displayName: leaver.displayName,
64:      isCurrentMember: false,
65:    });
66:  });
67:});
