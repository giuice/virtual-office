67:/** GET — settings metadata, provider options, and whether the caller may save. */
68:export async function fetchMeetingNoteAiSettings(signal?: AbortSignal): Promise<MeetingNoteAiSettingsResponse> {
69:  const body = await request({ method: 'GET', signal });
70:  if (!isSettingsView(body.settings) || !Array.isArray(body.providers) || typeof body.canManage !== 'boolean') {
71:    throw invalidResponse();
72:  }
73:  return body as unknown as MeetingNoteAiSettingsResponse;
74:}
