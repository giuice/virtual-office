1:import { expect, test } from '../fixtures/meeting-notes';
2:import { daysAgo, MEETING_NOTES_E2E_PREFIX } from '../helpers/meeting-notes-e2e';
3:import { openNote } from '../helpers/meeting-notes-ui';
4:
5:/**
6: * AC-006, UI part (FR-008, FR-009, BR-007): a note saved three times shows
7: * three versions with who and when; a viewer who is not an editor opens a
8: * version but cannot restore it; an editor restores version 1, which creates
9: * a fourth version equal to version 1 (title, date, participants, content).
10: */
11:test.describe('meeting notes — history and restore (AC-006)', () => {
12:  test('lists three versions and restores version 1 as a new version', async ({
13:    primaryPage,
14:    secondaryPage,
15:    messagingData,
16:    notesWorld,
17:  }) => {
18:    const space = await notesWorld.createSpace('History room');
19:    const primaryName = await notesWorld.displayNameOf(messagingData.primary.userId);
20:    const secondaryName = await notesWorld.displayNameOf(messagingData.secondary.userId);
21:    const v1Title = `${MEETING_NOTES_E2E_PREFIX} History v1 ${notesWorld.runTag}`;
22:    const v1Date = daysAgo(3);
23:    const noteId = await notesWorld.createNote(primaryPage, {
24:      spaceId: space.id,
25:      title: v1Title,
26:      meetingDate: v1Date,
27:      content: '<p>Version one text</p>',
28:      participantIds: [messagingData.secondary.userId],
29:    });
30:    // Saves 2 and 3 drop the secondary from the participants (no longer an editor).
31:    await notesWorld.updateNote(primaryPage, noteId, {
32:      expectedRevision: 1,
33:      title: `${MEETING_NOTES_E2E_PREFIX} History v2 ${notesWorld.runTag}`,
34:      meetingDate: daysAgo(2),
35:      content: '<p>Version two text</p>',
36:      participantIds: [],
37:    });
38:    await notesWorld.updateNote(primaryPage, noteId, {
39:      expectedRevision: 2,
40:      title: `${MEETING_NOTES_E2E_PREFIX} History v3 ${notesWorld.runTag}`,
41:      meetingDate: daysAgo(1),
42:      content: '<p>Version three text</p>',
43:      participantIds: [],
44:    });
45:
46:    // A viewer who is not an editor: three versions with who/when, no restore.
47:    const viewer = secondaryPage;
48:    await openNote(viewer, noteId);
49:    await viewer.getByTestId('meeting-note-history-button').click();
50:    const viewerVersions = viewer.getByTestId('meeting-note-version-item');
51:    await expect(viewerVersions).toHaveCount(3);
52:    for (const [index, revision] of [3, 2, 1].entries()) {
53:      const item = viewerVersions.nth(index);
54:      await expect(item).toHaveAttribute('data-revision', String(revision));
55:      await expect(item.getByTestId('meeting-note-version-meta')).toContainText(primaryName);
56:      await expect(item.getByTestId('meeting-note-version-meta').locator('time')).toHaveAttribute('datetime', 
/\d{4}-\d{2}-\d{2}T/);
57:    }
58:    await viewer.locator('[data-testid="meeting-note-version-item"][data-revision="1"]').click();
59:    await expect(viewer.getByTestId('meeting-note-version-title')).toHaveText(v1Title);
60:    await expect(viewer.getByTestId('meeting-note-version-content')).toContainText('Version one text');
61:    await expect(viewer.getByTestId('meeting-note-restore-button')).toHaveCount(0);
62:
63:    // The editor (author/admin) restores version 1.
64:    const editor = primaryPage;
65:    await openNote(editor, noteId);
66:    await editor.getByTestId('meeting-note-history-button').click();
67:    await expect(editor.getByTestId('meeting-note-version-item')).toHaveCount(3);
68:    await editor.locator('[data-testid="meeting-note-version-item"][data-revision="1"]').click();
69:    await editor.getByTestId('meeting-note-restore-button').click();
70:    const confirm = editor.getByRole('alertdialog');
71:    await expect(confirm).toContainText('Restore revision 1?');
72:    await confirm.getByTestId('meeting-note-restore-confirm').click();
73:    await expect(confirm).toBeHidden({ timeout: 30_000 });
74:
75:    // A fourth version now heads the list; the note shows version 1's fields.
76:    const editorVersions = editor.getByTestId('meeting-note-version-item');
77:    await expect(editorVersions).toHaveCount(4, { timeout: 15_000 });
78:    await expect(editorVersions.nth(0)).toHaveAttribute('data-revision', '4');
79:    await editor.keyboard.press('Escape');
80:    const view = editor.getByTestId('meeting-note-view');
81:    await expect(view).toHaveAttribute('data-revision', '4');
82:    await expect(editor.getByTestId('meeting-note-title')).toHaveText(v1Title);
83:    await expect(editor.getByTestId('meeting-note-content')).toContainText('Version one text');
84:    await expect(editor.getByTestId('meeting-note-participant').filter({ hasText: secondaryName })).toBeVisible();
85:
86:    // Version 4 equals version 1 on the server.
87:    const versions = await notesWorld.readVersions(editor, noteId);
88:    const byRevision = new Map(versions.map((version) => [version.revision, version]));
89:    const v1 = await notesWorld.readVersion(editor, noteId, byRevision.get(1)?.id ?? '');
90:    const v4 = await notesWorld.readVersion(editor, noteId, byRevision.get(4)?.id ?? '');
91:    expect(v4.title).toBe(v1.title);
92:    expect(new Date(v4.meetingDate).getTime()).toBe(new Date(v1.meetingDate).getTime());
93:    expect(v4.content).toBe(v1.content);
