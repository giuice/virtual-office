155:    expect(md).toContain('&lt;script&gt;alert("t")&lt;/script&gt; \\[click\\](javascript:alert(3))');
156:    expect(md).toContain('&lt;b onmouseover="alert(1)"&gt;Eve&lt;/b&gt; \\[p\\](javascript:alert(2))');
157:    expect(md).toContain('&lt;b&gt;typed tag&lt;/b&gt; \\[md\\](javascript:alert(4))');
158:    expect(md).toContain('- [ ] &lt;img src=x onerror=alert(5)&gt; \\[x\\](javascript:alert(6))');
159:    expect(md).toContain('&lt;script&gt;alert(7)&lt;/script&gt;');
160:    expect(md).toContain('Bob: &lt;script&gt;alert(10)&lt;/script&gt;');
161:    expect(file.filename).not.toMatch(/[<>:"/\\|?*]/);
162:
163:    // Nothing ran in the page.
164:    expect(dialogs).toEqual([]);
165:    expect(await viewer.evaluate(() => (window as unknown as { __mnXss?: string }).__mnXss ?? null)).toBeNull();
166:  });
