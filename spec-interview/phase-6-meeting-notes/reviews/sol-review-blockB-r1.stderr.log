68:function toView(row: SettingsRow, what: string): MeetingNoteAiSettingsView {
69:  const revision = toRevision(row.revision);
70:  if (!isProvider(row.provider) || revision === null) throw invalidShape(what);
71:  return {
72:    configured: true,
73:    provider: row.provider,
74:    model: row.model,
75:    reasoningLevel: row.reasoning_level,
76:    dailyLimit: row.daily_limit,
77:    revision,
78:    keyLastFour: row.key_last_four,
79:    updatedBy: { userId: row.updated_by_user_id, name: row.updated_by_name },
