4:
5:/**
6: * AC-019 (FR-005, FR-027): "Export Markdown" downloads a .md with title, date,
7: * space, author, participants, the content as Markdown, the summary, and the
8: * action items; "Include transcript" adds the transcript. The export is
9: * offered to every viewer; here the secondary member downloads it.
10: *
11: * AC-003, export side (FR-002, FR-027): hostile markup in the title, a
12: * participant's name, the stored content, an item, the summary (AI output),
13: * and the transcript is exported escaped — no raw HTML, no live javascript:
14: * link — and nothing runs in the page while exporting.
15: *
16: * The summary and transcript are stored with trusted local SQL (no product
17: * route writes them before T12/T13).
18: */
19:
20:/** A Markdown link or image whose `]` is not escaped and whose target is javascript:. */
21:const LIVE_JAVASCRIPT_LINK = /(?<!\\)\]\(\s*<?\s*javascript:/i;
22:
23:const FORMATTED_CONTENT = [
24:  '<h1>Agenda</h1>',
25:  '<p>Plain <strong>bold</strong> and <em>italic</em> with <a href="https://example.com/doc">a link</a></p>',
26:  '<ul><li><p>First bullet</p></li></ul>',
27:  '<ol><li><p>First step</p></li></ol>',
28:  '<ul data-type="taskList">',
29:  '<li data-checked="true" data-type="taskItem"><label><input type="checkbox" 
checked="checked"><span></span></label><div><p>Done task</p></div></li>',
30:  '<li data-checked="false" data-type="taskItem"><label><input type="checkbox"><span></span></label><div><p>Open 
task</p></div></li>',
31:  '</ul>',
32:].join('');
33:
34:test.describe('meeting notes — Markdown export (AC-019, AC-003)', () => {
35:  test('exports the note without, then with, the transcript', async ({
36:    primaryPage,
37:    secondaryPage,
38:    messagingData,
39:    notesWorld,
40:  }) => {
41:    const space = await notesWorld.createSpace('Export room');
42:    const tag = notesWorld.runTag;
43:    const title = `${MEETING_NOTES_E2E_PREFIX} Export ${tag}`;
44:    const secondaryName = await notesWorld.displayNameOf(messagingData.secondary.userId);
45:    const authorName = await notesWorld.displayNameOf(messagingData.primary.userId);
46:    const noteId = await notesWorld.createNote(primaryPage, {
47:      spaceId: space.id,
48:      title,
49:      meetingDate: new Date(),
50:      content: FORMATTED_CONTENT,
51:      participantIds: [messagingData.secondary.userId],
52:    });
53:    await notesWorld.addActionItem(primaryPage, noteId, `Send the minutes ${tag}`, {
54:      assigneeId: messagingData.secondary.userId,
55:      dueDate: '2026-11-05',
56:    });
57:    await notesWorld.addActionItem(primaryPage, noteId, `Book the room ${tag}`);
58:    await notesWorld.setSummaryAndTranscriptUnsafe(noteId, {
59:      summary: `Summary of the meeting ${tag}`,
60:      transcript: `Ana: transcript words ${tag}`,
61:    });
62:
63:    const viewer = secondaryPage;
64:    await openNote(viewer, noteId);
65:    const shownDate = (await viewer.getByTestId('meeting-note-date').getAttribute('datetime')) ?? '';
66:    expect(shownDate).not.toBe('');
67:    const localDay = await viewer.evaluate((iso) => {
68:      const date = new Date(iso);
69:      const pad = (value: number) => String(value).padStart(2, '0');
70:      return `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())}`;
71:    }, shownDate);
72:
73:    // Without the transcript (the box starts unticked).
74:    await expect(viewer.getByLabel('Include transcript')).not.toBeChecked();
75:    const plain = await exportNoteMarkdown(viewer);
76:    expect(plain.filename).toBe(`${title} ${localDay}.md`);
77:    const md = plain.text;
78:    expect(md.startsWith(`# ${title}\n`)).toBe(true);
79:    expect(md).toContain(`- **Meeting date:** ${localDay}\n`);
80:    expect(md).toContain(`- **Space:** ${space.name}\n`);
81:    expect(md).toContain(`- **Author:** ${authorName}\n`);
82:    expect(md).toContain(`- **Participants:** ${secondaryName}\n`);
83:    expect(md).toContain('### Agenda');
84:    expect(md).toContain('Plain **bold** and *italic* with [a link](https://example.com/doc)');
85:    expect(md).toContain('- First bullet');
86:    expect(md).toContain('1. First step');
87:    expect(md).toContain('- [x] Done task\n- [ ] Open task');
88:    expect(md).toContain(`## Summary\n\nSummary of the meeting ${tag}\n`);
89:    expect(md).toContain(
90:      [
91:        `- [ ] Send the minutes ${tag}`,
92:        `  - Assignee: ${secondaryName}`,
93:        '  - Due date: 2026-11-05',
94:        '  - Status: open',
95:        `- [ ] Book the room ${tag}`,
96:        '  - Assignee: Unassigned',
97:        '  - Due date: None',
98:        '  - Status: open',
99:      ].join('\n'),
100:    );
101:    expect(md).not.toContain('## Transcript');
102:    expect(md).not.toContain('transcript words');
103:
104:    // With the transcript.
105:    const full = await exportNoteMarkdown(viewer, { includeTranscript: true });
106:    expect(full.text).toContain(`## Transcript\n\nAna: transcript words ${tag}\n`);
107:    expect(full.text.startsWith(md.trimEnd())).toBe(true);
108:  });
