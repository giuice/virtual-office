220:/** GET /api/meeting-notes/search — company notes, ranked (or by date when `q` is empty). */
221:export function fetchMeetingNoteSearch(
222:  search: MeetingNoteSearchParams,
223:  cursor: number,
224:  signal?: AbortSignal
225:): Promise<MeetingNotesPage<MeetingNoteSearchResult>> {
226:  const params = new URLSearchParams({
227:    limit: String(MEETING_SEARCH_PAGE_SIZE),
228:    cursor: String(cursor),
229:  });
230:  if (search.q) params.set('q', search.q);
231:  if (search.spaceRemoved) params.set('removed', 'true');
232:  else if (search.spaceId) params.set('spaceId', search.spaceId);
233:  if (search.from) params.set('from', search.from);
234:  if (search.to) params.set('to', search.to);
235:  return getPage<MeetingNoteSearchResult>(`/api/meeting-notes/search?${params.toString()}`, signal);
236:}
