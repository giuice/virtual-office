389: * GET /api/meeting-notes/[id]/export — the note as a .md file (FR-027). The
390: * meeting date is written as a calendar day in `timeZone` (the viewer's).
391: */
392:export async function fetchMeetingNoteMarkdown(
393:  noteId: string,
394:  options: { includeTranscript: boolean; timeZone: string },
395:  signal?: AbortSignal
396:): Promise<MeetingNoteMarkdownFile> {
397:  const params = new URLSearchParams({
398:    includeTranscript: options.includeTranscript ? 'true' : 'false',
399:    timeZone: options.timeZone,
400:  });
401:  let response: Response;
402:  try {
403:    response = await fetch(`${notePath(noteId)}/export?${params.toString()}`, {
404:      method: 'GET',
405:      credentials: 'same-origin',
406:      cache: 'no-store',
407:      signal,
408:    });
409:  } catch (error) {
410:    if (signal?.aborted) throw error;
411:    throw new MeetingNotesApiError(0, 'NETWORK_ERROR', 'Could not reach the server.');
412:  }
413:  if (!response.ok) throw await toApiError(response);
414:  return { blob: await response.blob(), filename: filenameFrom(response.headers.get('content-disposition')) };
415:}

