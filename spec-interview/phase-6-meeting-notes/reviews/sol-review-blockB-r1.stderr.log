30:export const SpaceDetailBottomSheet: React.FC<SpaceDetailBottomSheetProps> = ({
31:  open,
32:  onOpenChange,
33:  space,
34:  usersInSpace,
35:  state,
36:  knockStatus,
37:  knockCooldownRemaining,
38:  onJoin,
39:  onLeave,
40:  onKnock,
41:  onUserClick,
42:  speakingUserIds,
43:  presentingUserId,
44:  mutedUserIds,
45:}) => {
46:  // Handle close
47:  const handleClose = () => {
48:    onOpenChange(false);
49:  };
50:
51:  // Wrapped handlers to close sheet after action
52:  const handleJoin = () => {
53:    onJoin();
54:    handleClose();
55:  };
56:
57:  const handleLeave = () => {
58:    onLeave();
59:    handleClose();
60:  };
61:
62:  const handleKnock = onKnock ? () => {
63:    onKnock();
