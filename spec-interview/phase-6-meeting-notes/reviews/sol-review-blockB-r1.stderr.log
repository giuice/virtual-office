61:export async function PATCH(request: NextRequest, { params }: RouteParams): Promise<NextResponse> {
62:  const begun = await beginMeetingNoteRequest(PATH, 'meeting-note:write');
63:  if (!begun.ok) {
64:    await request.body?.cancel().catch(() => undefined);
65:    return begun.response;
66:  }
67:  const ctx = begun.value;
68:
69:  const id = parsePathId((await params).id, 'MEETING_NOTE_NOT_FOUND', ctx);
70:  if (!id.ok) {
71:    await request.body?.cancel().catch(() => undefined);
72:    return id.response;
73:  }
74:
75:  const raw = await readJsonObject(request, ctx);
76:  if (!raw.ok) return raw.response;
77:  const body = parseWith(updateMeetingNoteBodySchema, raw.value, ctx);
78:  if (!body.ok) return body.response;
79:
80:  const content = sanitizeMeetingNoteHtml(body.value.content);
81:  if (codePointLength(content) > MEETING_NOTE_LIMITS.contentMaxChars) {
82:    return meetingNoteError(400, 'MEETING_NOTE_CONTENT_TOO_LONG', ctx);
83:  }
84:
85:  try {
86:    await ctx.repository.updateNote({
87:      noteId: id.value,
88:      expectedRevision: body.value.expectedRevision,
89:      title: body.value.title,
90:      meetingDate: body.value.meetingDate,
91:      content,
92:      participantIds: body.value.participantIds,
93:    });
94:  } catch (error) {
95:    return noteMutationErrorResponse(error, ctx, id.value, 'meetingNotes.update');
96:  }
97:
98:  try {
99:    const note = await loadMeetingNoteDetail(ctx.repository, ctx.dbUser, id.value);
100:    // Deleted by another request right after this change committed.
101:    if (!note) return notFound('MEETING_NOTE_NOT_FOUND', ctx);
102:    return ok({ note }, ctx);
103:  } catch (error) {
104:    return internalError(error, ctx, 'meetingNotes.update.load');
