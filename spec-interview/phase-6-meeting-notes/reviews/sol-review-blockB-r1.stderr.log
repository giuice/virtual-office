4:import { MeetingNotesApiError } from '@/lib/meeting-notes/client-api';
5:import type {
6:  MeetingNoteAiSettingsResponse,
7:  MeetingNoteAiSettingsView,
8:  SaveMeetingNoteAiSettingsInput,
9:} from '@/types/meeting-notes';
10:
11:export const MEETING_NOTE_AI_SETTINGS_PATH = '/api/companies/ai-settings';
12:
13:/** 409: another admin saved first; carries the settings as they are now. */
14:export class MeetingNoteAiSettingsConflictError extends MeetingNotesApiError {
15:  readonly settings: MeetingNoteAiSettingsView;
16:
17:  constructor(message: string, settings: MeetingNoteAiSettingsView) {
18:    super(409, 'MEETING_NOTE_AI_SETTINGS_STALE_REVISION', message);
19:    this.name = 'MeetingNoteAiSettingsConflictError';
20:    this.settings = settings;
21:  }
22:}
23:
24:function asRecord(value: unknown): Record<string, unknown> {
25:  return value && typeof value === 'object' && !Array.isArray(value) ? (value as Record<string, unknown>) : {};
26:}
27:
28:function isSettingsView(value: unknown): value is MeetingNoteAiSettingsView {
29:  const view = asRecord(value);
30:  return typeof view.configured === 'boolean' && typeof view.dailyLimit === 'number';
31:}
32:
33:function invalidResponse(status = 200): MeetingNotesApiError {
34:  return new MeetingNotesApiError(status, 'INVALID_RESPONSE', 'Unexpected response from the server.');
35:}
36:
37:async function request(init: RequestInit & { signal?: AbortSignal }): Promise<Record<string, unknown>> {
38:  let response: Response;
39:  try {
40:    response = await fetch(MEETING_NOTE_AI_SETTINGS_PATH, {
41:      ...init,
42:      credentials: 'same-origin',
43:      cache: 'no-store',
44:      headers: init.body !== undefined ? { 'Content-Type': 'application/json' } : undefined,
45:    });
46:  } catch (error) {
47:    if (init.signal?.aborted) throw error;
48:    throw new MeetingNotesApiError(0, 'NETWORK_ERROR', 'Could not reach the server.');
49:  }
50:  let body: Record<string, unknown> = {};
51:  try {
52:    body = asRecord(await response.json());
53:  } catch {
54:    if (response.ok) throw invalidResponse(response.status);
55:  }
56:  if (!response.ok) {
57:    const code = typeof body.code === 'string' ? body.code : `HTTP_${response.status}`;
58:    const message = typeof body.error === 'string' ? body.error : `Request failed (${response.status})`;
59:    if (response.status === 409 && code === 'MEETING_NOTE_AI_SETTINGS_STALE_REVISION' && 
isSettingsView(body.settings)) {
60:      throw new MeetingNoteAiSettingsConflictError(message, body.settings);
61:    }
62:    throw new MeetingNotesApiError(response.status, code, message);
63:  }
64:  return body;
65:}
