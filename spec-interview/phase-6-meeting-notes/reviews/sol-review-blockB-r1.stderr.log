96:          bulletList: current.isActive('bulletList'),
97:          orderedList: current.isActive('orderedList'),
98:          taskList: current.isActive('taskList'),
99:          link: current.isActive('link'),
100:          linkHref: String(current.getAttributes('link').href ?? ''),
101:          canUndo: current.can().undo(),
102:          canRedo: current.can().redo(),
103:        };
104:      },
105:    }) ?? EMPTY_STATE;
106:
107:  const inactive = disabled || !editor;
108:
109:  const controls = (): HTMLElement[] =>
110:    Array.from(toolbarRef.current?.querySelectorAll<HTMLElement>('[data-toolbar-control]:not(:disabled)') ?? []);
111:
112:  const onKeyDown = (event: KeyboardEvent<HTMLDivElement>) => {
113:    const items = controls();
114:    if (items.length === 0) return;
115:    const current = items.indexOf(document.activeElement as HTMLElement);
116:    let next = -1;
117:    if (event.key === 'ArrowRight') next = (current + 1) % items.length;
118:    else if (event.key === 'ArrowLeft') next = (current - 1 + items.length) % items.length;
119:    else if (event.key === 'Home') next = 0;
120:    else if (event.key === 'End') next = items.length - 1;
121:    if (next < 0) return;
122:    event.preventDefault();
123:    items[next]?.focus();
124:  };
125:
126:  // Roving tab stop: control indexes in DOM order (toggles, link, undo, redo).
127:  const LINK_INDEX = TOGGLES.length;
128:  const UNDO_INDEX = LINK_INDEX + 1;
129:  const REDO_INDEX = LINK_INDEX + 2;
130:  const undoDisabled = inactive || !state.canUndo;
131:  const redoDisabled = inactive || !state.canRedo;
132:  const tabStop =
133:    (focusIndex === UNDO_INDEX && undoDisabled) || (focusIndex === REDO_INDEX && redoDisabled) ? 0 : focusIndex;
134:  const tabIndexFor = (control: number) => (control === tabStop ? 0 : -1);
135:  const indexOf = (control: number) => () => setFocusIndex(control);
136:
137:  return (
138:    <div
139:      ref={toolbarRef}
140:      role="toolbar"
141:      aria-label="Formatting"
142:      aria-controls={editorId}
143:      className="flex flex-wrap items-center gap-0.5 border-b border-input bg-muted/40 px-1.5 py-1"
144:      onKeyDown={onKeyDown}
145:    >
146:      {TOGGLES.map((toggle, own) => {
147:        const Icon = toggle.icon;
148:        return (
149:          <button
150:            key={toggle.key}
151:            type="button"
152:            data-toolbar-control
153:            className={toolbarButtonClass}
154:            aria-label={toggle.label}
155:            title={toggle.label}
156:            aria-pressed={state[toggle.key]}
157:            disabled={inactive}
158:            tabIndex={tabIndexFor(own)}
159:            onFocus={indexOf(own)}
160:            onMouseDown={(event) => event.preventDefault()}
161:            onClick={() => editor && toggle.run(editor)}
162:          >
163:            <Icon className="size-4" aria-hidden="true" />
164:          </button>
165:        );
166:      })}
167:      <MeetingNoteLinkControl
168:        editor={editor}
169:        disabled={inactive}
170:        active={state.link}
171:        currentHref={state.linkHref}
172:        tabIndex={tabIndexFor(LINK_INDEX)}
173:        onFocus={indexOf(LINK_INDEX)}
174:      />
175:      <span className="mx-1 h-5 w-px bg-border" aria-hidden="true" />
176:      <button
177:        type="button"
178:        data-toolbar-control
179:        className={toolbarButtonClass}
180:        aria-label="Undo"
181:        title="Undo"
182:        disabled={undoDisabled}
183:        tabIndex={tabIndexFor(UNDO_INDEX)}
184:        onFocus={indexOf(UNDO_INDEX)}
185:        onMouseDown={(event) => event.preventDefault()}
186:        onClick={() => editor?.chain().focus().undo().run()}
187:      >
188:        <Undo2 className="size-4" aria-hidden="true" />
189:      </button>
190:      <button
191:        type="button"
192:        data-toolbar-control
193:        className={toolbarButtonClass}
194:        aria-label="Redo"
195:        title="Redo"
196:        disabled={redoDisabled}
197:        tabIndex={tabIndexFor(REDO_INDEX)}
198:        onFocus={indexOf(REDO_INDEX)}
199:        onMouseDown={(event) => event.preventDefault()}
200:        onClick={() => editor?.chain().focus().redo().run()}
201:      >
202:        <Redo2 className="size-4" aria-hidden="true" />
203:      </button>
204:    </div>
205:  );
206:}
