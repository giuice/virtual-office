33:const selectClassName =
34:  'flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm ring-offset-background 
focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2';
35:
36:export function MeetingNotesFilters({ values, spaces, periodError, onChange }: MeetingNotesFiltersProps) {
37:  const set = (patch: Partial<MeetingNotesFilterValues>) => onChange({ ...values, ...patch });
38:
39:  return (
40:    <form
41:      role="search"
42:      aria-label="Search meeting notes"
43:      className="grid gap-4 md:grid-cols-[minmax(0,2fr)_minmax(0,1fr)_minmax(0,1fr)_minmax(0,1fr)]"
44:      onSubmit={(event) => event.preventDefault()}
45:    >
46:      <div className="grid gap-1.5">
47:        <Label htmlFor="meeting-notes-query">Search notes</Label>
48:        <div className="relative">
49:          <Search className="pointer-events-none absolute left-3 top-1/2 size-4 -translate-y-1/2 
text-muted-foreground" aria-hidden="true" />
50:          <Input
51:            id="meeting-notes-query"
52:            type="search"
53:            value={values.query}
54:            maxLength={MEETING_NOTE_SEARCH_LIMITS.queryMaxChars}
55:            placeholder="Words in titles, notes, summaries, action items"
56:            className="pl-9"
57:            autoComplete="off"
58:            onChange={(event) => set({ query: event.target.value })}
59:          />
60:        </div>
61:      </div>
62:
63:      <div className="grid gap-1.5">
64:        <Label htmlFor="meeting-notes-space">Space</Label>
65:        <select
66:          id="meeting-notes-space"
67:          className={selectClassName}
68:          value={values.space}
69:          onChange={(event) => set({ space: event.target.value })}
70:        >
71:          <option value={SPACE_FILTER_ALL}>All spaces</option>
72:          {spaces.map((space) => (
73:            <option key={space.id} value={space.id}>
74:              {space.name}
75:            </option>
76:          ))}
77:          <option value={SPACE_FILTER_REMOVED}>Space removed</option>
78:        </select>
79:      </div>
80:
81:      <div className="grid gap-1.5">
82:        <Label htmlFor="meeting-notes-from">Meeting from</Label>
83:        <Input
84:          id="meeting-notes-from"
85:          type="date"
86:          value={values.fromDay}
87:          max={values.toDay || undefined}
88:          aria-invalid={periodError ? true : undefined}
89:          aria-describedby={periodError ? 'meeting-notes-period-error' : undefined}
90:          onChange={(event) => set({ fromDay: event.target.value })}
91:        />
92:      </div>
93:
94:      <div className="grid gap-1.5">
95:        <Label htmlFor="meeting-notes-to">Meeting to</Label>
96:        <Input
97:          id="meeting-notes-to"
