32:  const { companyUsers } = useCompany();
33:  const membersById = useMemo(() => new Map(companyUsers.map((user) => [user.id, user])), [companyUsers]);
34:  const [adding, setAdding] = useState(false);
35:
36:  const viewerId = scope?.userId ?? null;
37:  const canEdit = note.rights.canEdit;
