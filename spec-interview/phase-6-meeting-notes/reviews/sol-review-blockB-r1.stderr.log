4:import { useReducerState } from '@/hooks/useReducerState';
5:import { useEffect, useMemo } from "react";
6:import { createSupabaseBrowserClient } from "@/lib/supabase/browser-client"; // Adjust path if needed
7:import { Session, User } from "@supabase/supabase-js";
8:
9:interface SessionState {
10:  session: Session | null;
11:  user: User | null;
12:  loading: boolean;
13:  error: string | null;
14:  initialized: boolean;
15:}
16:
17:export function useSession() {
18:  // Memoize client creation to avoid recreating it on every render
19:  const supabase = useMemo(() => createSupabaseBrowserClient(), []);
20:  
21:  const [state, updateState] = useReducerState<SessionState>({
22:    session: null,
23:    user: null,
24:    loading: true, // Start in loading state
25:    error: null,
26:    initialized: false,
27:  });
28:
29:  useEffect(() => {
30:    let isMounted = true; // Flag to prevent state updates on unmounted component
31:
32:    // Set loading true when the effect runs
33:    updateState((prev) => ({ ...prev, loading: true, error: null, initialized: prev.initialized }));
34:
35:    // Get initial session state
36:    supabase.auth.getSession().then(({ data, error }) => {
37:      if (!isMounted) return; // Don't update if unmounted
38:
39:      if (error) {
40:        console.error("Error getting initial session:", error);
41:        updateState((prev) => ({
42:          ...prev,
43:          session: null,
44:          user: null,
45:          loading: false,
46:          error: error.message,
47:          initialized: true,
48:        }));
49:      } else {
50:        updateState((prev) => ({
51:          ...prev,
52:          session: data.session,
53:          user: data.session?.user ?? null,
54:          loading: false, // Initial load complete
55:          error: null,
56:          initialized: true,
57:        }));
58:      }
59:    }).catch(err => {
60:        if (!isMounted) return;
61:        console.error("Exception getting initial session:", err);
62:        updateState((prev) => ({
63:            ...prev,
64:            session: null,
65:            user: null,
66:            loading: false,
67:            error: err instanceof Error ? err.message : String(err),
68:            initialized: true,
69:        }));
70:    });
71:
72:    // Set up the listener for auth state changes
73:    const { data: authListener } = supabase.auth.onAuthStateChange(
74:      (event, session) => {
75:        if (!isMounted) return; // Don't update if unmounted
76:
77:        // Update state only if the session has actually changed
78:        updateState((prevState) => {
79:          // Compare access tokens as a reliable way to check for session change
80:          if (prevState.session?.access_token !== session?.access_token) {
81:            return {
82:              session: session,
83:              user: session?.user ?? null,
84:              loading: false, // Auth state change means loading is complete
85:              error: null,
86:              initialized: true,
87:            };
88:          }
89:          // If tokens are the same, no actual session change occurred
90:          return { ...prevState, loading: false, error: null, initialized: true }; // Ensure loading is false even 
if no change
91:        });
92:      }
93:    );
94:
95:    // Cleanup function
96:    return () => {
97:      isMounted = false; // Set flag on unmount
98:      authListener?.subscription.unsubscribe();
99:    };
100:  }, [supabase, updateState]); // Dependency array includes supabase client
101:
102:  // Return the full state object including session, user, loading, and error
103:  return state;
104:}
