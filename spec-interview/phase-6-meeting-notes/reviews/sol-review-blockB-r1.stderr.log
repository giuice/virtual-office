12:import { ElementType, parseDocument } from 'htmlparser2';
13:
14:import { sanitizeMeetingNoteHtml } from './content-sanitizer';
15:import { isSafeMeetingNoteLink } from './link-url';
16:import { escapeMarkdownLinkDestination, escapeMarkdownText } from './markdown-escape';
17:
18:type DomNode = ReturnType<typeof parseDocument>['children'][number];
19:type DomElement = Extract<DomNode, { attribs: Record<string, string> }>;
20:type DomText = Extract<DomNode, { type: typeof ElementType.Text }>;
21:
22:function isElement(node: DomNode): node is DomElement {
23:  return 'attribs' in node;
24:}
25:
26:function isText(node: DomNode): node is DomText {
27:  return node.type === ElementType.Text;
28:}
29:
30:const HEADING = /^h([1-6])$/;
31:const INLINE_TAGS = new Set(['strong', 'b', 'em', 'i', 'a', 'span', 'label', 'br', 'input']);
32:/** Deeper nesting is flattened to text (keeps the walk's recursion bounded). */
33:const MAX_DEPTH = 24;
34:const HARD_BREAK = '\\\n';
35:
36:/** Plain text of a subtree, without recursion. */
37:function textOf(nodes: readonly DomNode[]): string {
38:  const parts: string[] = [];
39:  const stack: DomNode[] = [...nodes].reverse();
40:  while (stack.length > 0) {
41:    const node = stack.pop() as DomNode;
42:    if (isText(node)) {
43:      parts.push(node.data);
44:    } else if (isElement(node)) {
45:      if (node.name === 'br') parts.push(' ');
46:      for (let index = node.children.length - 1; index >= 0; index -= 1) stack.push(node.children[index]);
47:      if (!INLINE_TAGS.has(node.name)) parts.push(' ');
48:    }
49:  }
50:  return parts.join('');
51:}
52:
53:/** true when nothing but spaces follows the last line break of `out`. */
54:function atLineStart(out: string): boolean {
55:  return /(?:^|\n)[ ]*$/.test(out);
56:}
57:
58:/** Wraps inline Markdown in a delimiter, keeping outer spaces outside it. */
59:function wrap(inner: string, delimiter: string): string {
60:  const match = /^(\s*)([\s\S]*?)(\s*)$/.exec(inner);
61:  if (!match || match[2] === '') return inner;
62:  return `${match[1]}${delimiter}${match[2]}${delimiter}${match[3]}`;
63:}
64:
65:function renderInline(nodes: readonly DomNode[], depth: number): string {
66:  if (depth > MAX_DEPTH) return escapeMarkdownText(textOf(nodes).replace(/\s+/g, ' '), true);
67:  let out = '';
68:  for (const node of nodes) {
69:    if (isText(node)) {
70:      out += escapeMarkdownText(node.data.replace(/\s+/g, ' '), atLineStart(out));
71:      continue;
72:    }
73:    if (!isElement(node)) continue;
74:    switch (node.name) {
75:      case 'br':
76:        out += HARD_BREAK;
77:        break;
78:      case 'input':
79:        break;
80:      case 'strong':
81:      case 'b':
82:        out += wrap(renderInline(node.children, depth + 1), '**');
83:        break;
84:      case 'em':
85:      case 'i':
86:        out += wrap(renderInline(node.children, depth + 1), '*');
87:        break;
88:      case 'a': {
89:        const text = renderInline(node.children, depth + 1).trim();
90:        const href = (node.attribs.href ?? '').trim();
91:        if (!isSafeMeetingNoteLink(href)) {
92:          out += text;
93:        } else {
94:          out += `[${text || escapeMarkdownText(href, false)}](${escapeMarkdownLinkDestination(href)})`;
95:        }
96:        break;
97:      }
98:      default:
99:        out += renderInline(node.children, depth + 1);
100:    }
101:  }
102:  return out;
103:}
104:
105:/** A paragraph's inline Markdown without leading/trailing spaces or trailing hard breaks. */
106:function finishParagraph(inline: string): string {
107:  return inline.replace(/(?:\s|\\\n)+$/, '').replace(/^\s+/, '');
108:}
109:
110:function isTaskItem(node: DomNode): boolean {
111:  return isElement(node) && (node.attribs['data-type'] === 'taskItem' || node.attribs['data-checked'] !== 
undefined);
112:}
113:
114:/** Every line after the first gets `indent`. */
115:function indentRest(text: string, indent: string): string {
116:  return text.replace(/\n/g, `\n${indent}`);
117:}
118:
119:function renderList(node: DomNode, depth: number, headingOffset: number): string {
120:  if (!isElement(node)) return '';
121:  const ordered = node.name === 'ol';
122:  const start = Number(node.attribs.start);
123:  let number = ordered && Number.isSafeInteger(start) && start >= 0 ? start : 1;
124:  const lines: string[] = [];
125:  for (const child of node.children) {
126:    if (isText(child) && child.data.trim() === '') continue;
127:    const marker = ordered ? `${number}. ` : '- ';
128:    number += 1;
129:    const task = isTaskItem(child) && isElement(child) ? (child.attribs['data-checked'] === 'true' ? '[x] ' : '[ ] 
') : '';
130:    // A task item's checkbox lives in its <label>; its text in the following block(s).
131:    const children = isElement(child)
132:      ? child.children.filter((grandchild) => !(task && isElement(grandchild) && grandchild.name === 'label'))
133:      : [child];
134:    const body = renderBlocks(children, depth + 1, headingOffset).join('\n');
135:    lines.push(`${marker}${task}${indentRest(body, ' '.repeat(marker.length))}`.trimEnd());
136:  }
137:  return lines.join('\n');
138:}
139:
140:/** Block-level Markdown strings for a list of nodes. */
141:function renderBlocks(nodes: readonly DomNode[], depth: number, headingOffset: number): string[] {
142:  if (depth > MAX_DEPTH) {
143:    const text = finishParagraph(escapeMarkdownText(textOf(nodes).replace(/\s+/g, ' '), true));
144:    return text ? [text] : [];
145:  }
146:  const blocks: string[] = [];
147:  let pendingInline: DomNode[] = [];
148:  const flushInline = () => {
149:    const paragraph = finishParagraph(renderInline(pendingInline, depth));
150:    if (paragraph) blocks.push(paragraph);
151:    pendingInline = [];
152:  };
153:
154:  for (const node of nodes) {
155:    if (isText(node) || (isElement(node) && INLINE_TAGS.has(node.name))) {
156:      pendingInline.push(node);
157:      continue;
158:    }
159:    if (!isElement(node)) continue;
160:    flushInline();
161:    const heading = HEADING.exec(node.name);
162:    if (heading) {
163:      const text = finishParagraph(renderInline(node.children, depth + 1).split(HARD_BREAK).join(' '));
164:      if (text) blocks.push(`${'#'.repeat(Math.min(6, Number(heading[1]) + headingOffset))} ${text}`);
165:    } else if (node.name === 'p') {
166:      const paragraph = finishParagraph(renderInline(node.children, depth + 1));
167:      if (paragraph) blocks.push(paragraph);
168:    } else if (node.name === 'ul' || node.name === 'ol') {
169:      const list = renderList(node, depth + 1, headingOffset);
170:      if (list) blocks.push(list);
171:    } else {
172:      // div, a stray li, or anything outside the schema: its content as blocks.
173:      blocks.push(...renderBlocks(node.children, depth + 1, headingOffset));
174:    }
175:  }
176:  flushInline();
177:  return blocks;
178:}
179:
180:/**
181: * Stored note HTML → Markdown ('' when the note has no text). `headingOffset`
182: * demotes the note's headings (h1 + 2 = ###) so they nest under the export's
183: * own sections; the deepest level is 6.
184: */
185:export function meetingNoteHtmlToMarkdown(html: string, headingOffset = 0): string {
186:  const document = parseDocument(sanitizeMeetingNoteHtml(html));
187:  return renderBlocks(document.children, 0, Math.max(0, headingOffset)).join('\n\n');
188:}
