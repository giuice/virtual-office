__tests__/api/playwright/meeting-notes/note-sanitization.spec.ts
1:import { expect, test } from '../fixtures/meeting-notes';
2:import { MEETING_NOTES_E2E_PREFIX } from '../helpers/meeting-notes-e2e';
3:import { openNote } from '../helpers/meeting-notes-ui';
4:
5:/**
6: * AC-003, render side (FR-002): note content carrying a script tag, an
7: * onerror handler, an inline event handler, and a javascript: link is shown
8: * without anything running. The content is first saved through the real
9: * route (write-side sanitization) and then overwritten RAW in the local
10: * database, so the view itself must neutralize it before it reaches the DOM.
11: */
12:const HOSTILE_HTML = [
13:  '<p>Visible agenda text</p>',
14:  '<script>window.__mnXss = "script"; alert("script")</script>',
15:  '<img src="x" onerror="window.__mnXss = \'onerror\'; alert(\'onerror\')">',
16:  '<p onclick="window.__mnXss = \'onclick\'" onmouseover="window.__mnXss = \'hover\'">Hover me</p>',
17:  '<a href="javascript:window.__mnXss = \'link\'">Unsafe link</a>',
18:  '<a href="https://example.com/safe">Safe link</a>',
19:  '<iframe src="javascript:alert(1)"></iframe>',
20:  '<svg><script>window.__mnXss = "svg"</script></svg>',
21:].join('');
22:
23:test.describe('meeting notes — rendering hostile content (AC-003)', () => {
24:  test('shows stored script, handlers, and javascript: links without executing them', async ({
25:    primaryPage,
26:    secondaryPage,
27:    notesWorld,
28:  }) => {
29:    const space = await notesWorld.createSpace('Sanitize room');
30:    const noteId = await notesWorld.createNote(primaryPage, {
31:      spaceId: space.id,
32:      title: `${MEETING_NOTES_E2E_PREFIX} Hostile ${notesWorld.runTag}`,
33:      meetingDate: new Date(),
34:      content: HOSTILE_HTML,
35:    });
36:
37:    // Write side: the route stored a sanitized copy.
38:    const saved = await notesWorld.readNote(primaryPage, noteId);
39:    expect(saved.note?.content).toContain('Visible agenda text');
40:    expect(saved.note?.content).not.toMatch(/<script|onerror|onclick|javascript:|<iframe|<img/i);
41:
42:    // Render side: the raw markup reaches the database by another path.
43:    await notesWorld.overwriteStoredContentUnsafe(noteId, HOSTILE_HTML);
44:
45:    const page = secondaryPage;
46:    const dialogs: string[] = [];
47:    page.on('dialog', (dialog) => {
48:      dialogs.push(dialog.message());
49:      void dialog.dismiss();
50:    });
51:
52:    await openNote(page, noteId);
53:    const content = page.getByTestId('meeting-note-content');
54:    await expect(content).toContainText('Visible agenda text');
55:    await expect(content).toContainText('Unsafe link');
56:
57:    // Nothing hostile reached the DOM.
58:    await expect(content.locator('script, img, iframe, svg, [onerror], [onclick], [onmouseover]')).toHaveCount(0);
59:    await expect(page.locator('a[href^="javascript:" i]')).toHaveCount(0);
60:    await expect(content.getByRole('link', { name: 'Safe link' })).toHaveAttribute('href', 
'https://example.com/safe');
61:
62:    // Interacting with the neutralized parts runs nothing.
63:    await content.getByText('Hover me').hover();
64:    await content.getByText('Hover me').click();
65:    await content.getByText('Unsafe link').click();
66:    await expect(page).toHaveURL(new RegExp(`/meetings/${noteId}$`));
67:
68:    expect(await page.evaluate(() => (window as unknown as { __mnXss?: string }).__mnXss)).toBeUndefined();
69:    expect(dialogs).toEqual([]);
70:  });
71:});
__tests__/api/playwright/meeting-notes/note-rights.spec.ts
1:import { expect, test } from '../fixtures/meeting-notes';
2:import { MEETING_NOTES_E2E_PREFIX } from '../helpers/meeting-notes-e2e';
3:import { openNote } from '../helpers/meeting-notes-ui';
4:
5:/**
6: * AC-004, UI part (FR-006, BR-003): a member who is neither the author, a
7: * participant, nor an admin reads the note and its history but sees no edit,
8: * restore, or delete control. The author (here the admin) sees all three.
9: * Route and database denials are covered by the DB integration suite.
10: */
11:test.describe('meeting notes — editing rights in the UI (AC-004)', () => {
12:  test('a non-participant member sees no edit, restore, or delete control', async ({
13:    primaryPage,
14:    secondaryPage,
15:    notesWorld,
16:  }) => {
17:    const space = await notesWorld.createSpace('Rights room');
18:    const title = `${MEETING_NOTES_E2E_PREFIX} Rights ${notesWorld.runTag}`;
19:    const noteId = await notesWorld.createNote(primaryPage, {
20:      spaceId: space.id,
21:      title,
22:      meetingDate: new Date(),
23:      content: '<p>First draft</p>',
24:    });
25:    // A second version, so an older version exists to restore.
26:    await notesWorld.updateNote(primaryPage, noteId, {
27:      expectedRevision: 1,
28:      title,
29:      meetingDate: new Date(),
30:      content: '<p>Second draft</p>',
31:      participantIds: [],
32:    });
33:
34:    // The non-participant member (secondary) reads everything...
35:    const viewer = secondaryPage;
36:    await openNote(viewer, noteId);
37:    await expect(viewer.getByTestId('meeting-note-title')).toHaveText(title);
38:    await expect(viewer.getByTestId('meeting-note-content')).toContainText('Second draft');
39:    // ...but has no edit or delete control.
40:    await expect(viewer.getByTestId('meeting-note-edit-button')).toHaveCount(0);
41:    await expect(viewer.getByTestId('meeting-note-delete-button')).toHaveCount(0);
42:    await expect(viewer.getByRole('button', { name: 'Edit' })).toHaveCount(0);
43:    await expect(viewer.getByRole('button', { name: 'Delete' })).toHaveCount(0);
44:
45:    // History opens for any viewer, an old version opens, but no restore control.
46:    await viewer.getByTestId('meeting-note-history-button').click();
47:    const versions = viewer.getByTestId('meeting-note-version-item');
48:    await expect(versions).toHaveCount(2);
49:    await viewer.locator('[data-testid="meeting-note-version-item"][data-revision="1"]').click();
50:    await expect(viewer.getByTestId('meeting-note-version-content')).toContainText('First draft');
51:    await expect(viewer.getByTestId('meeting-note-restore-button')).toHaveCount(0);
52:    await expect(viewer.getByRole('button', { name: 'Restore this version' })).toHaveCount(0);
53:
54:    // The author/admin (primary) sees the controls on the same note.
55:    const author = primaryPage;
56:    await openNote(author, noteId);
57:    await expect(author.getByTestId('meeting-note-edit-button')).toBeVisible();
58:    await expect(author.getByTestId('meeting-note-delete-button')).toBeVisible();
59:    await author.getByTestId('meeting-note-history-button').click();
60:    await author.locator('[data-testid="meeting-note-version-item"][data-revision="1"]').click();
61:    await expect(author.getByTestId('meeting-note-restore-button')).toBeVisible();
62:  });
