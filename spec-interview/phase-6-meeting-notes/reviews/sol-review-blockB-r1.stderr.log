21:/** A failed meeting-note request: HTTP status (0 = network) and the route's error code. */
22:export class MeetingNotesApiError extends Error {
23:  readonly status: number;
24:  readonly code: string;
25:
26:  constructor(status: number, code: string, message: string) {
27:    super(message);
28:    this.name = 'MeetingNotesApiError';
29:    this.status = status;
30:    this.code = code;
31:  }
32:}
33:
34:/**
35: * 409 MEETING_NOTE_STALE_REVISION: another change landed first. Carries the
36: * note's current state as the route read it, so the UI can show it (FR-007).
37: */
38:export class MeetingNoteConflictError extends MeetingNotesApiError {
39:  readonly currentRevision: number;
40:  readonly note: MeetingNoteDetail;
41:
42:  constructor(message: string, currentRevision: number, note: MeetingNoteDetail) {
43:    super(409, 'MEETING_NOTE_STALE_REVISION', message);
44:    this.name = 'MeetingNoteConflictError';
45:    this.currentRevision = currentRevision;
46:    this.note = note;
47:  }
48:}
49:
50:/**
51: * 409 MEETING_NOTE_ITEM_STALE_REVISION: the action item changed first. Carries
52: * the item's current state so the UI can show it and retry on it.
53: */
54:export class MeetingNoteItemConflictError extends MeetingNotesApiError {
55:  readonly currentRevision: number;
56:  readonly item: MeetingNoteActionItemView;
57:
58:  constructor(message: string, currentRevision: number, item: MeetingNoteActionItemView) {
59:    super(409, 'MEETING_NOTE_ITEM_STALE_REVISION', message);
60:    this.name = 'MeetingNoteItemConflictError';
61:    this.currentRevision = currentRevision;
62:    this.item = item;
63:  }
64:}
