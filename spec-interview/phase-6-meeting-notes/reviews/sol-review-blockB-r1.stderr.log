214:/**
215: * A failed note mutation → response. A stale revision → 409 carrying the
216: * note's current state (read with the caller's session) so the UI can show it.
217: */
218:export async function noteMutationErrorResponse(
219:  error: unknown,
220:  ctx: MeetingNoteRouteContext,
221:  noteId: string,
222:  context: string
223:): Promise<NextResponse> {
224:  if (isStale(error, 'MEETING_NOTE_STALE_REVISION')) {
225:    try {
226:      const current = await loadMeetingNoteDetail(ctx.repository, ctx.dbUser, noteId);
227:      if (!current) return notFound('MEETING_NOTE_NOT_FOUND', ctx);
228:      return conflict('MEETING_NOTE_STALE_REVISION', current.revision, { note: current }, ctx);
229:    } catch (loadError) {
230:      return internalError(loadError, ctx, `${context}.loadCurrent`);
231:    }
232:  }
233:  if (error instanceof MeetingNoteDbError) return refusalResponse(error, ctx, context);
234:  return internalError(error, ctx, context);
235:}
236:
237:/** Same for an action-item mutation; the 409 carries the item's current state. */
238:export async function itemMutationErrorResponse(
239:  error: unknown,
240:  ctx: MeetingNoteRouteContext,
241:  itemId: string,
242:  companyId: string | null,
243:  context: string
244:): Promise<NextResponse> {
245:  if (isStale(error, 'MEETING_NOTE_ITEM_STALE_REVISION')) {
246:    try {
247:      const item = await ctx.repository.findActionItemById(itemId);
248:      if (!item) return notFound('MEETING_NOTE_ITEM_NOT_FOUND', ctx);
249:      const [view] = await loadActionItemViews(ctx.repository, companyId, [item]);
250:      return conflict('MEETING_NOTE_ITEM_STALE_REVISION', view.revision, { item: view }, ctx);
251:    } catch (loadError) {
252:      return internalError(loadError, ctx, `${context}.loadCurrent`);
253:    }
254:  }
255:  if (error instanceof MeetingNoteDbError) return refusalResponse(error, ctx, context);
256:  return internalError(error, ctx, context);
257:}
258:
259:function conflict(
260:  code: 'MEETING_NOTE_STALE_REVISION' | 'MEETING_NOTE_ITEM_STALE_REVISION',
261:  currentRevision: number,
262:  current: Record<string, unknown>,
263:  ctx: { correlationId: string }
264:): NextResponse {
265:  return NextResponse.json(
266:    { error: messageFor(code), code, currentRevision, correlationId: ctx.correlationId, ...current },
267:    { status: 409, headers: { 'x-correlation-id': ctx.correlationId } }
268:  );
269:}
270:
271:/**
272: * The item addressed by /api/meeting-notes/[id]/items/[itemId], read with the
273: * caller's session; 404 unless it is visible AND belongs to that note (the
274: * item RPCs take only the item id, and an item's note_id is immutable).
275: */
276:export async function resolveItemInNote(
277:  ctx: MeetingNoteRouteContext,
278:  rawNoteId: string | undefined,
279:  rawItemId: string | undefined
280:): Promise<Result<ActionItem>> {
281:  const noteId = parsePathId(rawNoteId, 'MEETING_NOTE_ITEM_NOT_FOUND', ctx);
282:  if (!noteId.ok) return noteId;
283:  const itemId = parsePathId(rawItemId, 'MEETING_NOTE_ITEM_NOT_FOUND', ctx);
284:  if (!itemId.ok) return itemId;
285:  try {
286:    const item = await ctx.repository.findActionItemById(itemId.value);
287:    if (!item || item.noteId !== noteId.value) {
288:      return { ok: false, response: notFound('MEETING_NOTE_ITEM_NOT_FOUND', ctx) };
289:    }
290:    return { ok: true, value: item };
291:  } catch (error) {
292:    return { ok: false, response: internalError(error, ctx, 'meetingNotes.item.resolve') };
293:  }
294:}
295:
296:/** A success body with the correlation header. */
297:export function ok<T>(body: T, ctx: { correlationId: string }, status = 200): NextResponse<T> {
298:  return NextResponse.json(body, { status, headers: { 'x-correlation-id': ctx.correlationId } });
299:}
