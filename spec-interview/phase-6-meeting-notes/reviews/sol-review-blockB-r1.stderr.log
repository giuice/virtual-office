1:// src/lib/meeting-notes/period.ts
2:// Meeting-date period filter: local calendar days ('YYYY-MM-DD' from a date
3:// input) turned into the search route's bounds — ISO date-times with the
4:// viewer's UTC offset; `from` is the start of the first day (inclusive) and
5:// `to` the start of the day after the last day (exclusive).
6:
7:const DAY_PATTERN = /^(\d{4})-(\d{2})-(\d{2})$/;
8:
9:function pad(value: number, width = 2): string {
10:  return String(Math.abs(value)).padStart(width, '0');
11:}
12:
13:/** Local midnight of a 'YYYY-MM-DD' day plus `addDays`; null when the day is not a real date. */
14:function localMidnight(day: string, addDays: number): Date | null {
15:  const match = DAY_PATTERN.exec(day);
16:  if (!match) return null;
17:  const year = Number(match[1]);
18:  const month = Number(match[2]);
19:  const date = Number(match[3]);
20:  if (year < 1000 || month < 1 || month > 12 || date < 1 || date > 31) return null;
21:  const value = new Date(2000, 0, 1, 0, 0, 0, 0);
22:  // setFullYear avoids the two-digit-year mapping of the Date constructor.
23:  value.setFullYear(year, month - 1, date);
24:  if (value.getFullYear() !== year || value.getMonth() !== month - 1 || value.getDate() !== date) {
25:    return null;
26:  }
27:  if (addDays !== 0) value.setDate(value.getDate() + addDays);
28:  return value;
29:}
30:
31:/** ISO 8601 local date-time with offset, e.g. 2026-10-13T00:00:00.000-03:00. */
32:export function toLocalIsoWithOffset(value: Date): string {
33:  const offsetMinutes = -value.getTimezoneOffset();
34:  const sign = offsetMinutes >= 0 ? '+' : '-';
35:  return (
36:    `${value.getFullYear()}-${pad(value.getMonth() + 1)}-${pad(value.getDate())}` +
37:    `T${pad(value.getHours())}:${pad(value.getMinutes())}:${pad(value.getSeconds())}.${pad(value.getMilliseconds(), 
3)}` +
38:    `${sign}${pad(Math.floor(Math.abs(offsetMinutes) / 60))}:${pad(Math.abs(offsetMinutes) % 60)}`
39:  );
40:}
41:
42:export type MeetingPeriodResult =
43:  | { ok: true; from: string | null; to: string | null }
44:  | { ok: false; reason: 'invalid-day' | 'from-after-to' };
45:
46:/** Resolves the period inputs ('' = open bound) to the route's `from`/`to`. */
47:export function resolveMeetingPeriod(fromDay: string, toDay: string): MeetingPeriodResult {
48:  const fromDate = fromDay ? localMidnight(fromDay, 0) : null;
49:  const toDate = toDay ? localMidnight(toDay, 1) : null;
50:  if ((fromDay && !fromDate) || (toDay && !toDate)) return { ok: false, reason: 'invalid-day' };
51:  if (fromDate && toDate && fromDate.getTime() >= toDate.getTime()) {
52:    return { ok: false, reason: 'from-after-to' };
53:  }
54:  return {
55:    ok: true,
56:    from: fromDate ? toLocalIsoWithOffset(fromDate) : null,
57:    to: toDate ? toLocalIsoWithOffset(toDate) : null,
58:  };
59:}
60:
61:/** The local calendar day 'YYYY-MM-DD' of an instant; '' when unparsable. */
62:export function localDayOf(value: string): string {
63:  const parsed = new Date(value);
64:  if (Number.isNaN(parsed.getTime())) return '';
65:  return `${parsed.getFullYear()}-${pad(parsed.getMonth() + 1)}-${pad(parsed.getDate())}`;
66:}
67:
68:/**
69: * A meeting date picked as a local day → local noon of that day as an ISO
70: * date-time with offset (noon stays inside the same calendar day for viewers
71: * a few hours away); null when the day is not a real date.
72: */
73:export function meetingDateFromLocalDay(day: string): string | null {
74:  const midnight = localMidnight(day, 0);
75:  if (!midnight) return null;
76:  midnight.setHours(12, 0, 0, 0);
77:  return toLocalIsoWithOffset(midnight);
78:}

