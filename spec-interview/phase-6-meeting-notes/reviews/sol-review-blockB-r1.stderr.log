2:// The Markdown export of a note (FR-027, AC-019, AC-003): title, meeting date,
3:// space (or "Space removed"), author, participants (former members marked),
4:// the content converted to Markdown, the summary, the action items (assignee,
5:// due date, status), and — only when asked — the stored transcript. Every
6:// piece of user or AI text goes through markdown-escape.ts, so the file holds
7:// no raw HTML and no Markdown structure that came from that text.
8:import type { MeetingNoteActionItemView, MeetingNoteDetail } from '@/types/meeting-notes';
9:
10:import { meetingNoteHtmlToMarkdown } from './html-to-markdown';
11:import { escapeMarkdownBlock, escapeMarkdownLine } from './markdown-escape';
12:
13:export interface MeetingNoteMarkdownOptions {
14:  /** Include `note.transcript` (the caller loaded it). */
15:  includeTranscript: boolean;
16:  /** IANA time zone the meeting date is written in (the viewer's). */
17:  timeZone: string;
18:}
19:
20:const DATE_ONLY = /^\d{4}-\d{2}-\d{2}$/;
21:
22:/** The calendar day 'YYYY-MM-DD' of an instant in `timeZone`; null when unparsable. */
23:export function calendarDayInZone(value: string, timeZone: string): string | null {
24:  const instant = new Date(value);
25:  if (Number.isNaN(instant.getTime())) return null;
26:  const parts = new Intl.DateTimeFormat('en-US', {
27:    timeZone,
28:    year: 'numeric',
29:    month: '2-digit',
30:    day: '2-digit',
31:  }).formatToParts(instant);
32:  const part = (type: Intl.DateTimeFormatPartTypes) => parts.find((entry) => entry.type === type)?.value ?? '';
33:  const day = `${part('year')}-${part('month')}-${part('day')}`;
34:  return DATE_ONLY.test(day) ? day : null;
35:}
36:
37:function personLabel(name: string, isCurrentMember: boolean): string {
38:  const escaped = escapeMarkdownLine(name);
39:  return isCurrentMember ? escaped : `${escaped} (Former member)`;
40:}
41:
42:function itemLines(item: MeetingNoteActionItemView): string {
43:  const assignee =
44:    item.assigneeId === null
45:      ? 'Unassigned'
46:      : personLabel(item.assigneeName ?? 'Unknown member', item.assigneeIsCurrentMember === true);
47:  // A date-only value is written as stored: no Date conversion, no time zone.
48:  const due = item.dueDate && DATE_ONLY.test(item.dueDate) ? item.dueDate : 'None';
49:  return [
50:    `- [${item.completed ? 'x' : ' '}] ${escapeMarkdownBlock(item.description, '  ')}`,
51:    `  - Assignee: ${assignee}`,
52:    `  - Due date: ${due}`,
53:    `  - Status: ${item.completed ? 'done' : 'open'}`,
54:  ].join('\n');
55:}
56:
57:/** The whole .md document of a note. */
58:export function buildMeetingNoteMarkdown(note: MeetingNoteDetail, options: MeetingNoteMarkdownOptions): string {
59:  const meetingDay = calendarDayInZone(note.meetingDate, options.timeZone) ?? escapeMarkdownLine(note.meetingDate);
60:  const space = note.spaceName === null ? 'Space removed' : escapeMarkdownLine(note.spaceName);
61:  const participants =
62:    note.participants.length === 0
63:      ? 'None'
64:      : note.participants.map((participant) => personLabel(participant.displayName, 
participant.isCurrentMember)).join(', ');
65:
66:  const sections: string[] = [
67:    `# ${escapeMarkdownLine(note.title)}`,
68:    [
69:      `- **Meeting date:** ${meetingDay}`,
70:      `- **Space:** ${space}`,
71:      `- **Author:** ${escapeMarkdownLine(note.authorName)}`,
72:      `- **Participants:** ${participants}`,
73:    ].join('\n'),
74:    '## Notes',
75:    // The note's own headings nest under "## Notes" (h1 becomes ###).
76:    meetingNoteHtmlToMarkdown(note.content, 2) || 'No notes.',
77:    '## Summary',
78:    (note.summary ? escapeMarkdownBlock(note.summary) : '') || 'No summary.',
79:    '## Action items',
80:    note.actionItems.length === 0 ? 'No action items.' : note.actionItems.map(itemLines).join('\n'),
81:  ];
82:
83:  if (options.includeTranscript) {
84:    sections.push('## Transcript', (note.transcript ? escapeMarkdownBlock(note.transcript) : '') || 'No 
transcript.');
85:  }
86:
87:  return `${sections.join('\n\n')}\n`;
88:}
