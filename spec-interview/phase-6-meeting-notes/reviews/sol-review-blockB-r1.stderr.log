5:'use client';
6:
7:import { useMemo, useState } from 'react';
8:import { Loader2 } from 'lucide-react';
9:
10:import { Button } from '@/components/ui/button';
11:import { useCompany } from '@/contexts/CompanyContext';
12:import { useMeetingNoteSearch } from '@/hooks/queries/useMeetingNotes';
13:import { useDebouncedValue } from '@/hooks/ui/use-debounced-value';
14:import { MeetingNotesApiError, type MeetingNoteSearchParams } from '@/lib/meeting-notes/client-api';
15:import { resolveMeetingPeriod } from '@/lib/meeting-notes/period';
16:import { MeetingNoteResultItem } from './MeetingNoteResultItem';
17:import {
18:  MeetingNotesFilters,
19:  SPACE_FILTER_ALL,
20:  SPACE_FILTER_REMOVED,
21:  type MeetingNotesFilterValues,
22:} from './MeetingNotesFilters';
23:
24:/** Typing pause before a search request (the route allows 120 requests/min/user). */
25:const SEARCH_DEBOUNCE_MS = 350;
26:
27:const INITIAL_FILTERS: MeetingNotesFilterValues = {
28:  query: '',
29:  space: SPACE_FILTER_ALL,
30:  fromDay: '',
31:  toDay: '',
32:};
33:
34:const PERIOD_ERRORS = {
35:  'invalid-day': 'Enter valid dates for the period.',
36:  'from-after-to': 'The start date must be on or before the end date.',
37:} as const;
38:
39:function describeError(error: unknown): string {
40:  if (error instanceof MeetingNotesApiError) {
41:    if (error.status === 429) return 'Too many searches in a short time. Wait a moment and try again.';
42:    if (error.status === 400) return 'This search could not be run. Check the search words and filters.';
43:    if (error.status === 401) return 'Your session has ended. Sign in again to see meeting notes.';
44:    if (error.status === 403) return 'You do not have access to meeting notes.';
45:  }
46:  return 'Meeting notes could not be loaded.';
47:}
48:
49:export function MeetingsBrowser() {
50:  const { spaces } = useCompany();
51:  const [filters, setFilters] = useState<MeetingNotesFilterValues>(INITIAL_FILTERS);
52:  const debouncedQuery = useDebouncedValue(filters.query.trim(), SEARCH_DEBOUNCE_MS);
53:
54:  const sortedSpaces = useMemo(
55:    () => [...spaces].map(({ id, name }) => ({ id, name })).sort((a, b) => a.name.localeCompare(b.name)),
56:    [spaces]
57:  );
58:  const spaceNames = useMemo(() => new Map(spaces.map((space) => [space.id, space.name])), [spaces]);
59:
60:  const period = resolveMeetingPeriod(filters.fromDay, filters.toDay);
61:  const params: MeetingNoteSearchParams = {
62:    q: debouncedQuery,
63:    spaceId: filters.space !== SPACE_FILTER_ALL && filters.space !== SPACE_FILTER_REMOVED ? filters.space : null,
64:    spaceRemoved: filters.space === SPACE_FILTER_REMOVED,
65:    from: period.ok ? period.from : null,
66:    to: period.ok ? period.to : null,
67:  };
68:  const results = useMeetingNoteSearch(params, period.ok);
69:
70:  const items = results.data?.pages.flatMap((page) => page.items) ?? [];
71:  const totalCount = results.data?.pages[0]?.totalCount ?? null;
72:  const isSearching = debouncedQuery.length > 0;
73:  const isStale = results.isPlaceholderData || filters.query.trim() !== debouncedQuery;
74:
75:  return (
76:    <div className="space-y-6">
77:      <MeetingNotesFilters
78:        values={filters}
79:        spaces={sortedSpaces}
80:        periodError={period.ok ? null : PERIOD_ERRORS[period.reason]}
81:        onChange={setFilters}
82:      />
83:
84:      <section aria-labelledby="meeting-notes-results-heading" className="space-y-3">
85:        <div className="flex items-center justify-between gap-3">
86:          <h2 id="meeting-notes-results-heading" className="text-lg font-semibold">
87:            {isSearching ? 'Search results' : 'All meeting notes'}
88:          </h2>
89:          <p className="text-sm text-muted-foreground" aria-live="polite" data-testid="meeting-notes-count">
90:            {results.isSuccess && totalCount !== null
91:              ? `${totalCount} ${totalCount === 1 ? 'note' : 'notes'}`
92:              : null}
93:          </p>
94:        </div>
95:
96:        {!period.ok ? null : results.isPending ? (
97:          <p className="flex items-center gap-2 text-sm text-muted-foreground" role="status">
98:            <Loader2 className="size-4 animate-spin" aria-hidden="true" />
99:            Loading meeting notes…
100:          </p>
101:        ) : results.isError && items.length === 0 ? (
102:          <div className="rounded-xl border border-[var(--vo-line-soft)] p-4 text-sm" role="alert">
103:            <p className="text-muted-foreground">{describeError(results.error)}</p>
104:            <Button type="button" variant="ghost" size="sm" className="mt-2" onClick={() => void 
results.refetch()}>
105:              Try again
106:            </Button>
107:          </div>
108:        ) : items.length === 0 ? (
109:          <p className="rounded-xl border border-dashed border-[var(--vo-line-soft)] p-6 text-center text-sm 
text-muted-foreground">
110:            {isSearching ? 'No notes match this search.' : 'No meeting notes yet.'}
111:          </p>
112:        ) : (
113:          <ul
114:            className={`flex flex-col gap-3 transition-opacity ${isStale ? 'opacity-60' : ''}`}
115:            aria-busy={isStale || undefined}
116:            data-testid="meeting-notes-results"
117:          >
118:            {items.map((note) => (
119:              <MeetingNoteResultItem key={note.id} note={note} spaceNames={spaceNames} />
120:            ))}
121:          </ul>
122:        )}
123:
124:        {results.isError && items.length > 0 ? (
125:          <p className="text-sm text-destructive" role="alert">{describeError(results.error)}</p>
126:        ) : null}
127:
128:        {period.ok && results.hasNextPage ? (
129:          <div className="flex justify-center">
130:            <Button
131:              type="button"
132:              variant="outline"
133:              disabled={results.isFetchingNextPage}
134:              onClick={() => void results.fetchNextPage()}
135:            >
136:              {results.isFetchingNextPage ? 'Loading…' : 'Load more'}
137:            </Button>
138:          </div>
139:        ) : null}
140:      </section>
141:    </div>
142:  );
143:}
