108:/**
109: * GET /api/companies/ai-settings → MeetingNoteAiSettingsResponse.
110: * Metadata only; a company that never saved settings reads as not configured
111: * with the default daily limit.
112: */
113:export async function GET(): Promise<NextResponse> {
114:  const begun = await beginMeetingNoteRequest(PATH);
115:  if (!begun.ok) return begun.response;
116:  const ctx = begun.value;
117:  const companyId = ctx.dbUser.companyId;
118:  if (!companyId) return error(403, 'COMPANY_REQUIRED', ctx.correlationId);
119:
120:  try {
121:    const settings = await new SupabaseMeetingNoteAiSettingsRepository(ctx.supabase).findByCompany(companyId);
122:    const body: MeetingNoteAiSettingsResponse = {
123:      settings,
124:      providers: meetingNoteAiProviderOptions(),
125:      canManage: ctx.dbUser.role === 'admin',
126:    };
127:    return ok(body, ctx);
128:  } catch (cause) {
129:    return internalError(cause, ctx.correlationId, 'aiSettings.read');
130:  }
131:}
