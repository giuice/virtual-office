51:function toDbError(error: PostgrestError): MeetingNoteAiSettingsDbError {
52:  return new MeetingNoteAiSettingsDbError(error.code, error.message, error.details);
53:}
54:
55:function invalidShape(what: string): MeetingNoteAiSettingsDbError {
56:  return new MeetingNoteAiSettingsDbError(undefined, undefined, `${what} returned an unexpected shape`);
57:}
58:
59:function isProvider(value: unknown): value is MeetingNoteAiProvider {
60:  return typeof value === 'string' && PROVIDERS.has(value);
61:}
62:
63:function toRevision(value: unknown): number | null {
64:  const n = typeof value === 'string' ? Number(value) : value;
65:  return typeof n === 'number' && Number.isSafeInteger(n) && n >= 1 ? n : null;
66:}
