209:/** 409 with the settings as the caller's session now reads them. */
210:async function staleConflict(
211:  supabase: SupabaseClient,
212:  companyId: string,
213:  correlationId: string
214:): Promise<NextResponse> {
215:  let settings: MeetingNoteAiSettingsView;
216:  try {
217:    settings = await new SupabaseMeetingNoteAiSettingsRepository(supabase).findByCompany(companyId);
218:  } catch (cause) {
219:    return internalError(cause, correlationId, 'aiSettings.save.loadCurrent');
220:  }
221:  const code = 'MEETING_NOTE_AI_SETTINGS_STALE_REVISION';
222:  return NextResponse.json(
223:    { error: MESSAGES[code], code, currentRevision: settings.revision, correlationId, settings },
224:    { status: 409, headers: { 'x-correlation-id': correlationId } }
225:  );
