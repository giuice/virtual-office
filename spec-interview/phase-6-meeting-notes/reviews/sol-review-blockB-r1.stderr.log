94:    getNextPageParam: (lastPage) => (lastPage.hasMore ? lastPage.nextCursor ?? undefined : undefined),
95:    // While new filters load, keep the previous results of the SAME viewer and
96:    // company on screen (shown as stale); never another account's results.
97:    placeholderData: (previous, previousQuery) => {
