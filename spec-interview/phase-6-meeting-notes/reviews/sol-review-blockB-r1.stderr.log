6:import { useMutation, useQueryClient } from '@tanstack/react-query';
7:
8:import { meetingNoteAiSettingsQueryKey } from '@/hooks/queries/useMeetingNoteAiSettings';
9:import { useMeetingNotesScope } from '@/hooks/queries/useMeetingNotes';
10:import { MeetingNotesApiError } from '@/lib/meeting-notes/client-api';
11:import {
12:  MeetingNoteAiSettingsConflictError,
13:  saveMeetingNoteAiSettings,
14:} from '@/lib/meeting-notes/ai/settings-client-api';
15:import type {
16:  MeetingNoteAiSettingsResponse,
17:  MeetingNoteAiSettingsView,
18:  SaveMeetingNoteAiSettingsInput,
19:} from '@/types/meeting-notes';
20:
21:export function useSaveMeetingNoteAiSettings() {
22:  const queryClient = useQueryClient();
23:  const scope = useMeetingNotesScope();
24:
25:  const store = (settings: MeetingNoteAiSettingsView) => {
26:    if (!scope) return;
27:    queryClient.setQueryData<MeetingNoteAiSettingsResponse>(
28:      meetingNoteAiSettingsQueryKey(scope.userId, scope.companyId),
29:      (current) => (current ? { ...current, settings } : current)
30:    );
31:  };
32:
33:  return useMutation({
34:    mutationFn: (input: SaveMeetingNoteAiSettingsInput) => {
35:      if (!scope) {
36:        throw new MeetingNotesApiError(401, 'NO_SESSION', 'Your session is not ready. Reload the page and try 
again.');
37:      }
38:      return saveMeetingNoteAiSettings(input);
39:    },
40:    onSuccess: store,
41:    onError: (error) => {
42:      if (error instanceof MeetingNoteAiSettingsConflictError) store(error.settings);
43:    },
44:  });
45:}
