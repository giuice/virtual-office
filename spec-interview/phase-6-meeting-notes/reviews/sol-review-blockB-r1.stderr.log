97:            {describeMeetingNoteItemError(remove.error)}
98:          </p>
99:        ) : null}
100:        <AlertDialogFooter>
101:          <AlertDialogCancel disabled={remove.isPending}>Cancel</AlertDialogCancel>
102:          <AlertDialogAction
103:            className="bg-destructive text-white hover:bg-destructive/90"
104:            disabled={remove.isPending}
105:            onClick={(event) => {
