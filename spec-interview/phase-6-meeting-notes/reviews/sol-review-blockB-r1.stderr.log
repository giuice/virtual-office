89:/**
90: * Authenticates the caller (auth.getUser + users.supabase_uid) and, for a
91: * mutation, charges `rateLimit` to their users.id.
92: */
93:export async function beginMeetingNoteRequest(
94:  pathname: string,
95:  rateLimit?: RateLimitedAction
96:): Promise<Result<MeetingNoteRouteContext>> {
97:  const correlationId = createCorrelationId();
98:  const auth = await requireAuthUser({ correlationId, pathname });
99:  if ('errorResponse' in auth) {
100:    return { ok: false, response: auth.errorResponse };
101:  }
102:
103:  if (rateLimit) {
104:    let limiter: SupabaseClient | null = null;
105:    try {
106:      limiter = await createSupabaseServerClient('service_role');
107:    } catch {
108:      // Fail-open action: a limiter that cannot be built never blocks notes.
109:      console.error(JSON.stringify({ event: 'meeting_notes_limiter_unavailable', correlationId }));
110:    }
111:    if (limiter) {
112:      const limited = await enforceRateLimit(limiter, auth.dbUser.id, rateLimit);
113:      if (limited) return { ok: false, response: limited };
114:    }
115:  }
116:
117:  return {
118:    ok: true,
119:    value: {
120:      correlationId,
121:      supabase: auth.supabase,
122:      dbUser: auth.dbUser,
123:      repository: new SupabaseMeetingNoteRepository(auth.supabase),
124:    },
125:  };
126:}
