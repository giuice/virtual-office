__tests__/api/playwright/meeting-notes/note-item-due-date-timezones.spec.ts
1:import type { Browser, BrowserContext, Page } from '@playwright/test';
2:
3:import { expect, test } from '../fixtures/meeting-notes';
4:import { closePlacementToasts, guardLocalSupabaseTraffic } from '../fixtures/messaging';
5:import { MEETING_NOTES_E2E_PREFIX } from '../helpers/meeting-notes-e2e';
6:import {
7:  actionItemRow,
8:  exportNoteMarkdown,
9:  fillActionItemForm,
10:  openNote,
11:  saveActionItemForm,
12:} from '../helpers/meeting-notes-ui';
13:
14:/**
15: * AC-009, display side (FR-011): an action item's due date is a calendar
16: * date. Saved as 2026-11-05 from a browser in America/Los_Angeles (UTC-8/-7),
17: * it is stored as 2026-11-05, shown as 2026-11-05 there and in a browser in
18: * Asia/Tokyo (UTC+9), and both browsers' Markdown exports say 2026-11-05.
19: * A Date-based conversion would move the day in at least one of these zones.
20: */
21:type StorageState = Awaited<ReturnType<BrowserContext['storageState']>>;
22:
23:async function pageInZone(
24:  browser: Browser,
25:  storageState: StorageState,
26:  timezoneId: string,
27:): Promise<{ page: Page; close: () => Promise<void> }> {
28:  const context = await browser.newContext({ storageState, timezoneId });
29:  const page = await context.newPage();
30:  const verifyTraffic = guardLocalSupabaseTraffic(page, timezoneId);
31:  await closePlacementToasts(page);
32:  return {
33:    page,
34:    close: async () => {
35:      await context.close();
36:      verifyTraffic();
37:    },
38:  };
39:}
40:
41:test.describe('meeting notes — due dates across time zones (AC-009)', () => {
42:  test('a due date of 2026-11-05 is saved, shown, and exported as 2026-11-05 in Los Angeles and Tokyo', async ({
43:    browser,
44:    primaryPage,
45:    primaryStorageState,
46:    notesWorld,
47:  }) => {
48:    const space = await notesWorld.createSpace('Due date room');
49:    const tag = notesWorld.runTag;
50:    const noteId = await notesWorld.createNote(primaryPage, {
51:      spaceId: space.id,
52:      title: `${MEETING_NOTES_E2E_PREFIX} Due date ${tag}`,
53:      meetingDate: new Date(),
54:      content: '<p>Due date check</p>',
55:    });
56:    const description = `Ship the report ${tag}`;
57:
58:    // Los Angeles: the editor sets the due date through the form.
59:    const losAngeles = await pageInZone(browser, primaryStorageState, 'America/Los_Angeles');
60:    try {
61:      const page = losAngeles.page;
62:      expect(await page.evaluate(() => 
Intl.DateTimeFormat().resolvedOptions().timeZone)).toBe('America/Los_Angeles');
63:      await openNote(page, noteId);
64:      await page.getByTestId('meeting-note-item-add').click();
65:      await fillActionItemForm(page, { description, dueDate: '2026-11-05' });
66:      await saveActionItemForm(page);
67:      const row = actionItemRow(page, description);
68:      await expect(row.getByTestId('meeting-note-item-due')).toHaveText('Due 2026-11-05');
69:      await expect(row.locator('time')).toHaveAttribute('datetime', '2026-11-05');
70:
71:      const stored = await notesWorld.readNote(page, noteId);
72:      expect(stored.note?.actionItems.map((item) => item.dueDate)).toEqual(['2026-11-05']);
73:
74:      // The edit form shows the same calendar date.
75:      await row.getByTestId('meeting-note-item-edit').click();
76:      await expect(page.getByTestId('meeting-note-item-form').getByLabel('Due date')).toHaveValue('2026-11-05');
77:      await page.getByTestId('meeting-note-item-form').getByRole('button', { name: 'Cancel' }).click();
78:
79:      const file = await exportNoteMarkdown(page);
80:      expect(file.text).toContain('  - Due date: 2026-11-05\n');
81:    } finally {
82:      await losAngeles.close();
83:    }
84:
85:    // Tokyo: the same item reads and exports as the same day.
86:    const tokyo = await pageInZone(browser, primaryStorageState, 'Asia/Tokyo');
87:    try {
88:      const page = tokyo.page;
89:      expect(await page.evaluate(() => Intl.DateTimeFormat().resolvedOptions().timeZone)).toBe('Asia/Tokyo');
90:      await openNote(page, noteId);
91:      const row = actionItemRow(page, description);
92:      await expect(row.getByTestId('meeting-note-item-due')).toHaveText('Due 2026-11-05');
93:      await row.getByTestId('meeting-note-item-edit').click();
94:      await expect(page.getByTestId('meeting-note-item-form').getByLabel('Due date')).toHaveValue('2026-11-05');
95:      await page.getByTestId('meeting-note-item-form').getByRole('button', { name: 'Cancel' }).click();
96:
97:      const file = await exportNoteMarkdown(page);
98:      expect(file.text).toContain('  - Due date: 2026-11-05\n');
99:    } finally {
100:      await tokyo.close();
101:    }
102:  });
