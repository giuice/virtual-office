bg-[var(--vo-bg-2)] p-3 transition-colors hover:border-[var(--vo-line)] hover:bg-[var(--vo-hover-bg)] 
focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
72:              >
73:                <FileText className="mt-0.5 size-4 flex-none text-muted-foreground" aria-hidden="true" />
74:                <span className="min-w-0 flex-1">
