31:test.describe('meeting notes — company AI settings (AC-017 UI)', () => {
32:  test('an admin saves the AI settings; the key is write-only and shown as its last four characters; a member sees 
no AI section', async ({
33:    primaryPage,
34:    secondaryPage,
35:    notesWorld,
36:  }) => {
37:    await notesWorld.resetAiSettingsUnsafe();
38:    const canaryKey = `mn-e2e-canary-${notesWorld.runTag}-Q7w3`;
39:    try {
40:      const admin = primaryPage;
41:      await openAiSettings(admin);
42:      const section = admin.getByTestId('ai-settings-section');
43:      await expect(section.getByTestId('ai-settings-status')).toHaveText('AI is not configured yet.');
44:      await expect(admin.getByTestId('ai-daily-limit-input')).toHaveValue('20');
45:
46:      await choose(admin, 'ai-provider-select', 'OpenAI');
47:      await choose(admin, 'ai-model-select', 'GPT-6.1 Sol');
48:      await choose(admin, 'ai-reasoning-select', 'High');
49:      const keyInput = admin.getByTestId('ai-key-input');
50:      await expect(keyInput).toHaveAttribute('type', 'password');
51:      await keyInput.fill(canaryKey);
52:      await admin.getByTestId('ai-daily-limit-input').fill('50');
53:
54:      const saved = admin.waitForResponse(
55:        (response) => response.url().endsWith('/api/companies/ai-settings') && response.request().method() === 'PUT'
56:      );
57:      await admin.getByTestId('ai-save-button').click();
58:      const response = await saved;
59:      expect(response.status()).toBe(200);
60:      expect(await response.text()).not.toContain(canaryKey);
61:
62:      // Write-only: the input is cleared; only the last four characters show.
63:      await expect(keyInput).toHaveValue('');
64:      await expect(admin.getByTestId('ai-key-last-four')).toHaveText(`Key ending in ····${canaryKey.slice(-4)}`);
65:      await expect(section.getByTestId('ai-settings-status')).toContainText('OpenAI');
66:      await expect(section.getByTestId('ai-settings-status')).toContainText('GPT-6.1 Sol');
67:      await expect(admin.getByTestId('ai-updated-by')).toBeVisible();
68:      await expect(keyInput).toHaveAttribute('placeholder', 'Leave blank to keep the current key');
69:
70:      // A reload keeps the metadata; the key never reaches the page.
71:      await admin.reload();
72:      await openAiSettings(admin);
73:      await expect(admin.getByTestId('ai-settings-status')).toContainText('GPT-6.1 Sol');
74:      await expect(admin.getByTestId('ai-reasoning-select')).toContainText('High');
75:      await expect(admin.getByTestId('ai-daily-limit-input')).toHaveValue('50');
76:      await expect(admin.getByTestId('ai-key-last-four')).toHaveText(`Key ending in ····${canaryKey.slice(-4)}`);
77:      await expect(admin.getByTestId('ai-key-input')).toHaveValue('');
78:      expect(await admin.content()).not.toContain(canaryKey);
79:      const adminRead = await admin.request.get('/api/companies/ai-settings');
80:      expect(adminRead.status()).toBe(200);
81:      expect(await adminRead.text()).not.toContain(canaryKey);
82:
83:      // Limit outside 1–200 is refused in the form and nothing is sent.
84:      await admin.getByTestId('ai-daily-limit-input').fill('201');
85:      await admin.getByTestId('ai-save-button').click();
86:      await expect(admin.getByTestId('ai-settings-error')).toContainText('from 1 to 200');
87:
88:      // The member: no Settings tab, no AI section; the route gives metadata only and refuses saves.
89:      const member = secondaryPage;
90:      await member.goto('/company?tab=settings');
91:      await expect(member.getByRole('tab', { name: 'Team Members' })).toBeVisible({ timeout: 30_000 });
92:      await expect(member.getByRole('tab', { name: 'Company Settings' })).toHaveCount(0);
93:      await expect(member.getByTestId('ai-settings-section')).toHaveCount(0);
94:      const memberRead = await member.request.get('/api/companies/ai-settings');
95:      expect(memberRead.status()).toBe(200);
