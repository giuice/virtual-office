29: export interface SeedNoteInput {
30:   readonly companyId: string;
31:   readonly roomId: string | null;
32:   readonly author: MeetingNotesDbUser;
33:   readonly participants?: readonly MeetingNotesDbUser[];
34:   /** One version per editor, in order (revision 1..n). Defaults to [author]. */
35:   readonly versionEditors?: readonly MeetingNotesDbUser[];
36:   readonly itemAssignee?: MeetingNotesDbUser | null;
37:   readonly title?: string;
38: }
39: 
40: export interface SeededNote {
41:   readonly noteId: string;
42:   readonly versionIds: readonly string[];
43:   readonly itemId: string;
44: }
45: 
46: export interface MeetingNotesDbWorld {
47:   readonly ns: string;
48:   readonly companyA: string;
49:   readonly companyB: string;
50:   readonly spaceA: string;
51:   readonly spaceB: string;
52:   readonly adminA: MeetingNotesDbUser;
53:   readonly authorA: MeetingNotesDbUser;
54:   readonly participantA: MeetingNotesDbUser;
55:   readonly memberA: MeetingNotesDbUser;
56:   readonly adminB: MeetingNotesDbUser;
57:   readonly memberB: MeetingNotesDbUser;
58:   /** Anon-key client with no session. */
59:   readonly anon: SupabaseClient;
60:   /** Service-role PostgREST client (server-side trusted role). */
61:   readonly service: SupabaseClient;
62:   createCompany(label: string): Promise<string>;
63:   createSpace(companyId: string, label: string, createdBy: MeetingNotesDbUser): Promise<string>;
64:   createUser(key: string, companyId: string, role: 'admin' | 'member'): Promise<MeetingNotesDbUser>;
65:   /**
66:    * `count` member rows of `companyId` without an auth account (they cannot
67:    * sign in; used only as note participants). Returns their users.id values.
68:    */
69:   createMemberRows(companyId: string, count: number, label: string): Promise<string[]>;
70:   seedNote(input: SeedNoteInput): Promise<SeededNote>;
71:   /**
72:    * Trusted raw SQL on the local database as postgres (fixture setup and
73:    * assertions only; client behavior is exercised through user-scoped clients).
74:    */
75:   query<Row extends Record<string, unknown>>(sql: string, params?: unknown[]): Promise<Row[]>;
76:   cleanup(): Promise<void>;
77: }
78: 
79: /** Local-only fixture password shared by every fixture account. */
80: export const MEETING_NOTES_DB_PASSWORD = 'local-meeting-notes-db-password';
81: const PASSWORD = MEETING_NOTES_DB_PASSWORD;
82: 
83: function newClient(key: string): SupabaseClient {
84:   return createClient(MEETING_NOTES_API_URL, key, {
85:     auth: { persistSession: false, autoRefreshToken: false },
86:   });
87: }
88: 
89: export async function createMeetingNotesWorld(): Promise<MeetingNotesDbWorld> {
90:   const ns = randomUUID().slice(0, 8);
91:   const service = newClient(MEETING_NOTES_SERVICE_ROLE_KEY);
92:   const db = new Client({ connectionString: MEETING_NOTES_DB_URL });
93:   await db.connect();
94:   // Trusted fixture path: classify raw SQL as service_role for the presence
95:   // audit triggers on public.users (same convention as the messaging fixtures).
96:   await db.query(
97:     `select pg_catalog.set_config('request.jwt.claims', '{"role":"service_role"}', false)`,
98:   );
99: 
100:   const authUserIds: string[] = [];
101:   const companyIds: string[] = [];
102:   const appUserIds: string[] = [];
103:   const spaceIds: string[] = [];
104:   const noteIds: string[] = [];
105: 
106:   const cleanup = async (): Promise<void> => {
107:     const errors: string[] = [];
108:     const run = async (label: string, sql: string, ids: string[]) => {
109:       if (ids.length === 0) return;
110:       try {
111:         await db.query(sql, [ids]);
112:       } catch (error) {
113:         errors.push(`${label}: ${(error as Error).message}`);
114:       }
115:     };
116:     await run('notes', 'delete from public.meeting_notes where id = any($1::uuid[])', noteIds);
117:     await run('spaces', 'delete from public.spaces where id = any($1::uuid[])', spaceIds);
118:     await run('users', 'delete from public.users where id = any($1::uuid[])', appUserIds);
119:     await run('companies', 'delete from public.companies where id = any($1::uuid[])', companyIds);
120:     for (const id of authUserIds) {
121:       const { error } = await service.auth.admin.deleteUser(id);
122:       if (error) errors.push(`auth ${id}: ${error.message}`);
123:     }
124:     await db.end();
125:     if (errors.length > 0) {
126:       throw new Error(`Meeting-notes DB fixture cleanup failed: ${errors.join('; ')}`);
127:     }
128:   };
129: 
130:   const createCompany = async (label: string): Promise<string> => {
131:     const { rows } = await db.query<{ id: string }>(
132:       `insert into public.companies (name, admin_ids, settings) values ($1, '{}', '{}') returning id`,
133:       [`MN DB ${label} ${ns}`],
134:     );
135:     companyIds.push(rows[0].id);
136:     return rows[0].id;
137:   };
138: 
139:   const createSpace = async (
140:     companyId: string,
141:     label: string,
142:     createdBy: MeetingNotesDbUser,
143:   ): Promise<string> => {
144:     const { rows } = await db.query<{ id: string }>(
145:       `insert into public.spaces (company_id, name, type, status, created_by)
146:        values ($1, $2, 'workspace', 'active', $3) returning id`,
147:       [companyId, `MN DB ${label} ${ns}`, createdBy.appUserId],
148:     );
149:     spaceIds.push(rows[0].id);
150:     return rows[0].id;
151:   };
152: 
153:   const createUser = async (
154:     key: string,
155:     companyId: string,
156:     role: 'admin' | 'member',
157:   ): Promise<MeetingNotesDbUser> => {
158:     const email = `mndb-${key}-${ns}@local.test`;
159:     const { data, error } = await service.auth.admin.createUser({
160:       email,
161:       password: PASSWORD,
162:       email_confirm: true,
163:     });
164:     if (error || !data.user) {
165:       throw new Error(`Failed to create auth user ${email}: ${error?.message ?? 'no user'}`);
166:     }
167:     authUserIds.push(data.user.id);
168: 
169:     // company_id is set at INSERT: the database rejects later direct
170:     // service-role membership updates (product path is the company RPCs).
171:     const displayName = `MN ${key} ${ns}`;
172:     const { rows } = await db.query<{ id: string }>(
173:       `insert into public.users (supabase_uid, email, display_name, company_id, role)
174:        values ($1, $2, $3, $4, $5::public.user_role) returning id`,
175:       [data.user.id, email, displayName, companyId, role],
176:     );
177:     appUserIds.push(rows[0].id);
178: 
179:     const client = newClient(MEETING_NOTES_ANON_KEY);
180:     const { error: signInError } = await client.auth.signInWithPassword({ email, password: PASSWORD });
181:     if (signInError) {
182:       throw new Error(`Failed to sign in ${email}: ${signInError.message}`);
183:     }
184:     return { appUserId: rows[0].id, supabaseUid: data.user.id, email, displayName, client };
185:   };
186: 
187:   const createMemberRows = async (companyId: string, count: number, label: string): Promise<string[]> => {
188:     const { rows } = await db.query<{ id: string }>(
189:       `insert into public.users (supabase_uid, email, display_name, company_id, role)
190:        select gen_random_uuid()::text,
191:               format('mndb-%s-%s-%s@local.test', $2::text, $3::text, g),
192:               format('MN %s %s %s', $2::text, g, $3::text),
193:               $1::uuid,
194:               'member'::public.user_role
195:        from generate_series(1, $4::int) as g
196:        returning id`,
197:       [companyId, label, ns, count],
198:     );
199:     const ids = rows.map((row) => row.id);
200:     appUserIds.push(...ids);
201:     return ids;
202:   };
203: 
204:   const seedNote = async (input: SeedNoteInput): Promise<SeededNote> => {
205:     const participants = input.participants ?? [];
206:     const editors = input.versionEditors ?? [input.author];
207:     const title = input.title ?? `Note ${randomUUID().slice(0, 6)}`;
208:     const participantJson = JSON.stringify(
209:       participants.map((p) => ({ user_id: p.appUserId, display_name: p.displayName })),
210:     );
211:     const content = '<p>Seeded content</p>';
212:     const lastEditor = editors[editors.length - 1];
213: 
214:     const { rows } = await db.query<{ id: string }>(
215:       `insert into public.meeting_notes
216:          (company_id, room_id, title, meeting_date, content, summary, generated_by,
217:           author_user_id, author_name, created_by, edited_by, revision)
218:        values ($1, $2, $3, now(), $4, null, 'user', $5, $6, $5, $7, $8)
219:        returning id`,
220:       [
221:         input.companyId,
222:         input.roomId,
223:         title,
224:         content,
225:         input.author.appUserId,
226:         input.author.displayName,
227:         lastEditor.appUserId,
228:         editors.length,
229:       ],
230:     );
231:     const noteId = rows[0].id;
232:     noteIds.push(noteId);
233: 
234:     for (const [index, participant] of participants.entries()) {
235:       await db.query(
236:         `insert into public.meeting_note_participants (note_id, user_id, display_name, sort_order)
237:          values ($1, $2, $3, $4)`,
238:         [noteId, participant.appUserId, participant.displayName, index],
239:       );
240:     }
241: 
242:     const versionIds: string[] = [];
243:     for (const [index, editor] of editors.entries()) {
244:       const { rows: versionRows } = await db.query<{ id: string }>(
245:         `insert into public.meeting_note_versions
246:            (note_id, revision, title, meeting_date, participants, content, summary,
247:             editor_user_id, editor_name, edited_by)
248:          values ($1, $2, $3, now(), $4::jsonb, $5, null, $6, $7, $6)
249:          returning id`,
250:         [noteId, index + 1, title, participantJson, content, editor.appUserId, editor.displayName],
251:       );
252:       versionIds.push(versionRows[0].id);
253:     }
254: 
255:     const { rows: itemRows } = await db.query<{ id: string }>(
256:       `insert into public.meeting_note_action_items
257:          (note_id, description, assignee_id, assignee_name, creator_user_id, creator_name)
258:        values ($1, $2, $3, $4, $5, $6) returning id`,
259:       [
260:         noteId,
261:         `Follow up ${ns}`,
262:         input.itemAssignee?.appUserId ?? null,
263:         input.itemAssignee?.displayName ?? null,
264:         input.author.appUserId,
265:         input.author.displayName,
266:       ],
267:     );
268: 
269:     return { noteId, versionIds, itemId: itemRows[0].id };
270:   };
271: 
272:   try {
273:     const companyA = await createCompany('Company A');
274:     const companyB = await createCompany('Company B');
275:     const adminA = await createUser('admin-a', companyA, 'admin');
276:     const authorA = await createUser('author-a', companyA, 'member');
277:     const participantA = await createUser('participant-a', companyA, 'member');
278:     const memberA = await createUser('member-a', companyA, 'member');
279:     const adminB = await createUser('admin-b', companyB, 'admin');
280:     const memberB = await createUser('member-b', companyB, 'member');
281:     const spaceA = await createSpace(companyA, 'Space A', adminA);
282:     const spaceB = await createSpace(companyB, 'Space B', adminB);
283: 
284:     return {
285:       ns,
286:       companyA,
287:       companyB,
288:       spaceA,
289:       spaceB,
290:       adminA,
291:       authorA,
292:       participantA,
293:       memberA,
294:       adminB,
295:       memberB,
296:       anon: newClient(MEETING_NOTES_ANON_KEY),
297:       service,
298:       createCompany,
299:       createSpace,
300:       createUser,
301:       createMemberRows,
302:       seedNote,
303:       query: async <Row extends Record<string, unknown>>(sql: string, params: unknown[] = []) =>
304:         (await db.query<Row>(sql, params)).rows,
305:       cleanup,
306:     };
307:   } catch (error) {
308:     await cleanup().catch(() => undefined);
309:     throw error;
310:   }
311: }
312: 
313: /** The four meeting-note tables a client could reach through PostgREST. */
314: export const MEETING_NOTE_TABLES = [
315:   'meeting_notes',
316:   'meeting_note_participants',
317:   'meeting_note_versions',
318:   'meeting_note_action_items',
319: ] as const;
320: 
321: export type MeetingNoteTable = (typeof MEETING_NOTE_TABLES)[number];
322: 
323: /** Column that links each table's rows to a note. */
324: export function noteKey(table: MeetingNoteTable): 'id' | 'note_id' {
325:   return table === 'meeting_notes' ? 'id' : 'note_id';
326: }
327: 
328: /** Rows of `table` for `noteId` visible to `client` under RLS. */
329: export async function visibleRowCount(
330:   client: SupabaseClient,
331:   table: MeetingNoteTable,
332:   noteId: string,
333: ): Promise<number> {
334:   const { data, error } = await client.from(table).select('*').eq(noteKey(table), noteId);
335:   if (error) {
336:     throw new Error(`select ${table} failed: ${error.code} ${error.message}`);
337:   }
338:   return data.length;
339: }

