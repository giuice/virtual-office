1: // src/lib/meeting-notes/note-detail.ts
2: // Phase 6 FR-005 / BR-003: composes a note view from repository reads made
3: // with the caller's session (RLS: members of the note's company) and derives
4: // the caller's rights on the state that was read. The database re-checks every
5: // right on write; these flags only drive the UI.
6: import type { IMeetingNoteRepository } from '@/repositories/interfaces/IMeetingNoteRepository';
7: import type { ActionItem, MeetingNote, User } from '@/types/database';
8: import type {
9:   MeetingNoteActionItemView,
10:   MeetingNoteDetail,
11:   MeetingNoteRights,
12:   MeetingNoteVersionParticipant,
13: } from '@/types/meeting-notes';
14: 
15: export interface MeetingNoteDetailOptions {
16:   /** Include the stored transcript text (up to 1 MB). */
17:   includeTranscript?: boolean;
18: }
19: 
20: /** BR-003 on a read state: author, current participant, or admin, each while a member. */
21: export function computeMeetingNoteRights(
22:   viewer: Pick<User, 'id' | 'companyId' | 'role'>,
23:   note: Pick<MeetingNote, 'companyId' | 'authorUserId'>,
24:   participantIds: readonly string[]
25: ): MeetingNoteRights {
26:   if (!viewer.companyId || viewer.companyId !== note.companyId) {
27:     return { canEdit: false, canDelete: false };
28:   }
29:   const isAdmin = viewer.role === 'admin';
30:   const isAuthor = note.authorUserId === viewer.id;
31:   return {
32:     canEdit: isAdmin || isAuthor || participantIds.includes(viewer.id),
33:     canDelete: isAdmin || isAuthor,
34:   };
35: }
36: 
37: export function toActionItemViews(
38:   items: readonly ActionItem[],
39:   currentMemberIds: ReadonlySet<string>
40: ): MeetingNoteActionItemView[] {
41:   return items.map((item) => ({
42:     ...item,
43:     assigneeIsCurrentMember: item.assigneeId === null ? null : currentMemberIds.has(item.assigneeId),
44:   }));
45: }
46: 
47: /** Action items with their assignee-membership flag. */
48: export async function loadActionItemViews(
49:   repository: IMeetingNoteRepository,
50:   companyId: string | null,
51:   items: readonly ActionItem[]
52: ): Promise<MeetingNoteActionItemView[]> {
53:   const assigneeIds = items.flatMap((item) => (item.assigneeId ? [item.assigneeId] : []));
54:   const members = companyId ? await repository.findCurrentMemberIds(companyId, assigneeIds) : new Set<string>();
55:   return toActionItemViews(items, members);
56: }
57: 
58: /** The note view, or null when the note is missing or not visible to the caller. */
59: export async function loadMeetingNoteDetail(
60:   repository: IMeetingNoteRepository,
61:   viewer: Pick<User, 'id' | 'companyId' | 'role'>,
62:   noteId: string,
63:   options: MeetingNoteDetailOptions = {}
64: ): Promise<MeetingNoteDetail | null> {
65:   const note = await repository.findById(noteId);
66:   if (!note) return null;
67: 
68:   const [participants, items, spaceName, transcript] = await Promise.all([
69:     repository.findParticipants(note.id),
70:     repository.findActionItems(note.id),
71:     note.roomId ? repository.findSpaceName(note.roomId) : Promise.resolve(null),
72:     options.includeTranscript && note.transcriptId ? repository.findTranscript(note.id) : Promise.resolve(null),
73:   ]);
74: 
75:   const participantIds = participants.map((participant) => participant.userId);
76:   const assigneeIds = items.flatMap((item) => (item.assigneeId ? [item.assigneeId] : []));
77:   const members = await repository.findCurrentMemberIds(note.companyId, [...participantIds, ...assigneeIds]);
78: 
79:   const detail: MeetingNoteDetail = {
80:     ...note,
81:     spaceName,
82:     participants: participants.map((participant: MeetingNoteVersionParticipant) => ({
83:       ...participant,
84:       isCurrentMember: members.has(participant.userId),
85:     })),
86:     actionItems: toActionItemViews(items, members),
87:     hasTranscript: note.transcriptId !== null,
88:     rights: computeMeetingNoteRights(viewer, note, participantIds),
89:   };
90:   if (options.includeTranscript) {
91:     detail.transcript = transcript;
92:   }
93:   return detail;
94: }

