132: -- SPEC §9 legacy-row preflight: refuse rather than invent a company/author.
133: do $$
134: declare
135:   v_unresolvable bigint;
136: begin
137:   select count(*)
138:   into v_unresolvable
139:   from public.meeting_notes as n
140:   left join public.spaces as s on s.id = n.room_id
141:   left join public.users as u on u.id = n.edited_by
142:   where s.company_id is null
143:      or u.id is null;
144: 
145:   if v_unresolvable > 0 then
146:     raise exception 'MEETING_NOTES_LEGACY_ROWS_NEED_BACKFILL: % meeting_notes row(s) have no derivable company or 
author', v_unresolvable
147:       using errcode = 'P0001',
148:             hint = 'Owner backfill decision required before applying (SPEC section 9 preflight).';
149:   end if;
150: end;
151: $$;
