282: 
283: create or replace function private.guard_meeting_note()
284: returns trigger
285: language plpgsql
286: security definer
287: set search_path = ''
288: as $$
289: begin
290:   if tg_op = 'INSERT' then
291:     if new.created_by is null or new.created_by <> new.author_user_id then
292:       raise exception 'MEETING_NOTE_AUTHOR_MISMATCH' using errcode = '23514';
293:     end if;
294:   else
295:     if new.id is distinct from old.id
296:        or new.company_id is distinct from old.company_id
297:        or new.author_user_id is distinct from old.author_user_id
298:        or new.author_name is distinct from old.author_name
299:        or new.created_at is distinct from old.created_at
300:        or new.revision < old.revision then
301:       raise exception 'MEETING_NOTE_IMMUTABLE_FIELD' using errcode = '42501';
302:     end if;
303: 
304:     -- The live author reference only ever becomes NULL, and only after the
305:     -- user row is gone (the ON DELETE SET NULL action of a user deletion).
306:     if new.created_by is distinct from old.created_by
307:        and (new.created_by is not null
308:             or exists (select 1 from public.users as u where u.id = old.created_by)) then
309:       raise exception 'MEETING_NOTE_IMMUTABLE_FIELD' using errcode = '42501';
310:     end if;
311:   end if;
312: 
313:   if new.room_id is not null
314:      and (tg_op = 'INSERT' or new.room_id is distinct from old.room_id)
315:      and not exists (
316:        select 1
317:        from public.spaces as s
318:        where s.id = new.room_id
319:          and s.company_id = new.company_id
320:      ) then
321:     raise exception 'MEETING_NOTE_SPACE_OUTSIDE_COMPANY' using errcode = '23514';
322:   end if;
323: 
324:   return new;
325: end;
326: $$;
327: 
328: create or replace function private.guard_meeting_note_participant()
329: returns trigger
330: language plpgsql
331: security definer
332: set search_path = ''
333: as $$
334: begin
335:   if new.note_id is distinct from old.note_id
336:      or new.user_id is distinct from old.user_id
337:      or new.display_name is distinct from old.display_name
338:      or new.added_at is distinct from old.added_at then
339:     raise exception 'MEETING_NOTE_PARTICIPANT_IMMUTABLE_FIELD' using errcode = '42501';
340:   end if;
341:   return new;
342: end;
343: $$;
344: 
345: create or replace function private.guard_meeting_note_version()
346: returns trigger
347: language plpgsql
348: security definer
349: set search_path = ''
350: as $$
351: begin
352:   if tg_op = 'INSERT' then
353:     if new.edited_by is null or new.edited_by <> new.editor_user_id then
354:       raise exception 'MEETING_NOTE_VERSION_EDITOR_MISMATCH' using errcode = '23514';
355:     end if;
356:     return new;
357:   end if;
358: 
359:   if tg_op = 'DELETE' then
360:     -- Only the cascade of the note's own deletion (note row already gone).
361:     if exists (select 1 from public.meeting_notes as n where n.id = old.note_id) then
362:       raise exception 'MEETING_NOTE_VERSION_IMMUTABLE' using errcode = '42501';
363:     end if;
364:     return old;
365:   end if;
366: 
367:   if new.id is distinct from old.id
368:      or new.note_id is distinct from old.note_id
369:      or new.revision is distinct from old.revision
370:      or new.title is distinct from old.title
371:      or new.meeting_date is distinct from old.meeting_date
372:      or new.participants is distinct from old.participants
373:      or new.content is distinct from old.content
374:      or new.summary is distinct from old.summary
375:      or new.editor_user_id is distinct from old.editor_user_id
376:      or new.editor_name is distinct from old.editor_name
377:      or new.created_at is distinct from old.created_at then
378:     raise exception 'MEETING_NOTE_VERSION_IMMUTABLE' using errcode = '42501';
379:   end if;
380: 
381:   if new.edited_by is distinct from old.edited_by
382:      and (new.edited_by is not null
383:           or exists (select 1 from public.users as u where u.id = old.edited_by)) then
384:     raise exception 'MEETING_NOTE_VERSION_IMMUTABLE' using errcode = '42501';
385:   end if;
386: 
387:   return new;
388: end;
389: $$;
