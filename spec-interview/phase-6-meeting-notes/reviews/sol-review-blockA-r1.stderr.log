391: -- Row triggers do not fire on TRUNCATE; this statement guard keeps history
392: -- (and the notes it belongs to) from being wiped in bulk by any role.
393: create or replace function private.reject_meeting_note_truncate()
394: returns trigger
395: language plpgsql
396: security definer
397: set search_path = ''
398: as $$
399: begin
400:   raise exception 'MEETING_NOTE_TRUNCATE_FORBIDDEN' using errcode = '42501';
401: end;
402: $$;
