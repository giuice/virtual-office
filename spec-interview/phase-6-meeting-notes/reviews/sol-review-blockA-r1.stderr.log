338:                'added_at', coalesce(p.added_at, pg_catalog.now()),
339:                'allowed', (p.user_id is not null or u.id is not null)
340:              )
341:              order by r.ord
342:            ),
343:            '[]'::jsonb
344:          )
345:   into v_resolved
346:   from pg_catalog.unnest(v_ids) with ordinality as r(id, ord)
347:   left join public.meeting_note_participants as p
348:     on p.note_id = p_note_id
349:    and p.user_id = r.id
350:   left join public.users as u
351:     on u.id = r.id
352:    and u.company_id = p_company_id;
353: 
354:   if exists (
355:     select 1
356:     from pg_catalog.jsonb_array_elements(v_resolved) as e(item)
357:     where not (e.item ->> 'allowed')::boolean
358:   ) then
359:     raise exception 'MEETING_NOTE_PARTICIPANT_NOT_MEMBER' using errcode = '22023';
360:   end if;
361: 
362:   perform private.meeting_note_write_participants(p_note_id, v_resolved);
363: end;
364: $$;
365: 
366: -- Inserts the immutable version of the note's current state (its current
367: -- revision) with the editor's id and name snapshots; returns the version id.
368: create or replace function private.meeting_note_insert_version(
369:   p_note_id uuid,
370:   p_editor_id uuid,
371:   p_editor_name text
372: )
373: returns uuid
374: language plpgsql
375: volatile
376: security definer
377: set search_path = ''
378: as $$
379: declare
380:   v_version_id uuid;
381: begin
382:   insert into public.meeting_note_versions
383:     (note_id, revision, title, meeting_date, participants, content, summary,
384:      editor_user_id, editor_name, edited_by)
385:   select n.id,
386:          n.revision,
387:          n.title,
388:          n.meeting_date,
389:          coalesce(
390:            (select pg_catalog.jsonb_agg(
391:                      pg_catalog.jsonb_build_object('user_id', p.user_id, 'display_name', p.display_name)
392:                      order by p.sort_order)
393:             from public.meeting_note_participants as p
394:             where p.note_id = n.id),
395:            '[]'::jsonb
396:          ),
397:          n.content,
398:          n.summary,
399:          p_editor_id,
400:          p_editor_name,
401:          p_editor_id
402:   from public.meeting_notes as n
403:   where n.id = p_note_id
404:   returning id into v_version_id;
405: 
406:   if v_version_id is null then
407:     raise exception 'MEETING_NOTE_NOT_FOUND' using errcode = 'P0002';
408:   end if;
409:   return v_version_id;
410: end;
411: $$;
