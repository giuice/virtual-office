194: -- Locks the caller then the note (lock order rule) and authorizes p_action
195: -- ('edit' | 'delete') on the locked pre-change state, then checks the
196: -- revision. Returns the caller's id and name snapshot and the note company.
197: create or replace function private.meeting_note_authorize(
198:   p_note_id uuid,
199:   p_expected_revision bigint,
200:   p_action text,
201:   out caller_id uuid,
202:   out caller_name text,
203:   out note_company_id uuid
204: )
205: language plpgsql
206: volatile
207: security definer
208: set search_path = ''
209: as $$
210: declare
211:   v_caller record;
212:   v_note record;
213:   v_allowed boolean;
214: begin
215:   if p_action is null or p_action not in ('edit', 'delete') then
216:     raise exception 'meeting_note_authorize: unknown action' using errcode = '22023';
217:   end if;
218:   if p_expected_revision is null then
219:     raise exception 'MEETING_NOTE_REVISION_REQUIRED' using errcode = '22023';
220:   end if;
221: 
222:   select * into v_caller from private.meeting_note_lock_caller();
223:   if p_note_id is null or v_caller.caller_id is null or v_caller.caller_company_id is null then
224:     raise exception 'MEETING_NOTE_NOT_FOUND' using errcode = 'P0002';
225:   end if;
226: 
227:   -- Outsiders never take the note lock: the company check runs on an
228:   -- unlocked read first (company_id is immutable, so it cannot go stale).
229:   if not exists (
230:     select 1
231:     from public.meeting_notes as n
232:     where n.id = p_note_id
233:       and n.company_id = v_caller.caller_company_id
234:   ) then
235:     raise exception 'MEETING_NOTE_NOT_FOUND' using errcode = 'P0002';
236:   end if;
237: 
238:   select n.id, n.company_id, n.author_user_id, n.revision
239:   into v_note
240:   from public.meeting_notes as n
241:   where n.id = p_note_id
242:   for update;
243: 
244:   if not found then
245:     -- Deleted by a transaction that committed while this one waited.
246:     raise exception 'MEETING_NOTE_NOT_FOUND' using errcode = 'P0002';
247:   end if;
248: 
249:   v_allowed := v_note.author_user_id = v_caller.caller_id or v_caller.caller_is_admin;
250:   if not v_allowed and p_action = 'edit' then
251:     v_allowed := exists (
252:       select 1
253:       from public.meeting_note_participants as p
254:       where p.note_id = v_note.id
255:         and p.user_id = v_caller.caller_id
256:     );
257:   end if;
258:   if not v_allowed then
259:     raise exception 'MEETING_NOTE_FORBIDDEN' using errcode = '42501';
260:   end if;
261: 
262:   if v_note.revision <> p_expected_revision then
263:     raise exception 'MEETING_NOTE_STALE_REVISION'
264:       using errcode = 'P0001',
265:             detail = pg_catalog.format('{"current_revision": %s}', v_note.revision);
266:   end if;
267: 
268:   caller_id := v_caller.caller_id;
269:   caller_name := v_caller.caller_name;
270:   note_company_id := v_note.company_id;
271: end;
272: $$;
