2: -- AC-008, AC-009, AC-021, AC-032): the action-item contract.
3: --
4: -- Before this migration (baseline 20260610183000, T1 20261013103447, T17
5: -- 20261013105021): public.meeting_note_action_items has id, note_id (-> notes
6: -- ON DELETE CASCADE), description (non-empty check only), assignee_id (-> users
7: -- ON DELETE SET NULL), due_date timestamptz, completed, created_at; no creator,
8: -- no assignee snapshot, no revision, no immutability; authenticated holds
9: -- SELECT only (RLS: members of the note's company) and there is no client
10: -- write path.
11: --
12: -- After this migration:
13: --   * Columns:
14: --       - due_date is a SQL date (date-only; no timezone ever applies);
15: --       - creator_user_id + creator_name: historical snapshots of the creating
16: --         user's application users.id and display name (no FK: they survive
17: --         the user row); immutable;
18: --       - assignee_id + assignee_name: the assignee's application users.id and
19: --         display-name snapshot, both NULL or both set; the users FK is dropped
20: --         (like meeting_note_participants.user_id) so a departed or deleted
21: --         assignee keeps their place and snapshot ("Former member", FR-030);
22: --         the snapshot changes only together with assignee_id;
23: --       - revision (bigint >= 1): every change of description, assignee, due
24: --         date, or completion must increase it; it never decreases;
25: --       - updated_at.
26: --     id, note_id, creator_user_id, creator_name, and created_at are immutable
27: --     for every role (service_role and postgres included).
28: --   * description must be 1-1,000 chars and not blank (NOT VALID, so a legacy
29: --     row cannot block the migration; it applies to every new or changed row).
30: --   * Capacity: at most 100 items per note, for EVERY insertion path and role.
31: --     A BEFORE INSERT row trigger locks the note row FOR UPDATE and counts the
32: --     note's items (row-level BEFORE triggers see the rows inserted earlier by
33: --     the same statement, so a multi-row INSERT ... SELECT is counted row by
34: --     row). Two concurrent insertions on one note serialize on the note row, so
35: --     the total can never exceed 100. T12's Apply inserts through the same
36: --     trigger; it must take the note row FOR UPDATE itself first (lock order).
37: --     The count relies on READ COMMITTED (the default for PostgREST, RPCs, and
38: --     server clients: each trigger statement takes a fresh snapshot after the
39: --     lock wait); a caller running REPEATABLE READ/SERIALIZABLE must not rely
40: --     on it. A trusted multi-note bulk insert must insert in note_id order.
41: --   * The assignee's current membership is enforced by the RPCs only; the
42: --     table has no client write path, and trusted roles writing it directly
43: --     are responsible for it (as for note participants).
44: --   * Items are current state only (BR-007): item changes neither bump the
45: --     note revision nor create note versions; each item has its own revision.
46: --   * Four RPCs, each SECURITY DEFINER, owner postgres, search_path '',
47: --     EXECUTE to authenticated only (REVOKE ALL from PUBLIC, anon,
48: --     authenticated, service_role first):
49: --       public.create_meeting_note_action_item(p_note_id uuid,
50: --         p_description text, p_assignee_id uuid, p_due_date date) -> jsonb item
51: --       public.update_meeting_note_action_item(p_item_id uuid,
52: --         p_expected_revision bigint, p_description text, p_assignee_id uuid,
53: --         p_due_date date) -> jsonb item
54: --         Full desired state of description, assignee, and due date
55: --         (completion unchanged). An unchanged assignee (same id, even a
56: --         former member) keeps its snapshot; a new assignee must be a current
57: --         member of the note's company (snapshot = current display name).
58: --       public.set_meeting_note_action_item_completed(p_item_id uuid,
59: --         p_expected_revision bigint, p_completed boolean) -> jsonb item
60: --         The completion-only path: changes nothing but completed (and the
61: --         revision/updated_at).
62: --       public.delete_meeting_note_action_item(p_item_id uuid,
63: --         p_expected_revision bigint) -> jsonb {item_id, deleted: true}
64: --     The jsonb item is the row (id, note_id, description, assignee_id,
65: --     assignee_name, due_date as 'YYYY-MM-DD', completed, revision,
66: --     creator_user_id, creator_name, created_at, updated_at).
67: --   * Rights (BR-005), evaluated on the locked pre-change state, through the
68: --     same rules as note edits (private.meeting_note_lock_for_change, which
69: --     T17's private.meeting_note_authorize now also uses, unchanged in
70: --     behavior): create/update/delete = note editors (author, current
71: --     participant, or company admin, each while a member of the note's
72: --     company); completion = note editors or the item's current assignee while
73: --     a member of the note's company.
74: --   * Lock order (PLAN lock order rule): caller's users row FOR KEY SHARE ->
75: --     note row FOR UPDATE -> item row FOR UPDATE. The only reads before the
76: --     caller lock are unlocked (the item's immutable note_id). A newly chosen
77: --     assignee's users row is not locked (it would invert the order); an
78: --     assignee whose removal commits during the call ends up a former member,
79: --     the same state as a removal one moment later (no right is gained).
80: --
81: -- Errors (message token, SQLSTATE):
82: --   MEETING_NOTE_NOT_FOUND (P0002): create on a missing note or a note of a
83: --     company the caller is not a current member of.
84: --   MEETING_NOTE_ITEM_NOT_FOUND (P0002): update/complete/delete of a missing
85: --     item, or of an item whose note's company the caller is not a current
86: --     member of (a former member assignee included; other companies' items
87: --     are indistinguishable from missing ones).
88: --   MEETING_NOTE_ITEM_FORBIDDEN (42501): the caller is a member but lacks the
89: --     right (non-editor create/update/delete; completion by a member who is
90: --     neither an editor nor the item's assignee).
91: --   MEETING_NOTE_ITEM_STALE_REVISION (P0001): p_expected_revision differs from
92: --     the item's current revision; DETAIL is {"current_revision": N}.
93: --   22023: MEETING_NOTE_ITEM_DESCRIPTION_INVALID (NULL, empty or only
94: --     spaces/tabs/line breaks, > 1,000 chars),
95: --     MEETING_NOTE_ITEM_ASSIGNEE_NOT_MEMBER (a newly chosen assignee who is not
96: --     a current member of the note's company), MEETING_NOTE_ITEM_REVISION_REQUIRED,
97: --     MEETING_NOTE_ITEM_COMPLETED_REQUIRED, MEETING_NOTE_ITEM_LIMIT_REACHED
98: --     (the note already has 100 items; DETAIL {"limit": 100}; raised by the
99: --     insert trigger for every role).
100: --   42501 MEETING_NOTE_ITEM_IMMUTABLE_FIELD / 23514 MEETING_NOTE_ITEM_REVISION_NOT_BUMPED
101: --     / 23514 MEETING_NOTE_ITEM_ASSIGNEE_SNAPSHOT_MISMATCH: guard violations by
102: --     a trusted role writing the table directly.
103: --   Any error rolls the whole call back.
104: --
105: -- Legacy rows (SPEC §9 preflight): 0 rows locally. A legacy due_date
106: -- timestamptz becomes the calendar date it falls on in America/Sao_Paulo
107: -- (the product's business timezone, FR-023); creator = the note's author
108: -- snapshot; assignee_name = the assignee's current display name; revision 1;
109: -- updated_at = created_at.
110: --
111: -- Rollback (order: FIRST roll the application back to a build that does not
112: -- call these RPCs, THEN run this SQL). Creator/assignee snapshots and item
113: -- revisions are lost; due dates become midnight America/Sao_Paulo; assignee
114: -- ids whose user row is gone are cleared before the FK is restored:
115: --   begin;
116: --   set local lock_timeout = '5s';
117: --   lock table public.users in share row exclusive mode;
118: --   lock table public.meeting_notes, public.meeting_note_action_items in access exclusive mode;
119: --   drop function if exists public.create_meeting_note_action_item(uuid, text, uuid, date);
120: --   drop function if exists public.update_meeting_note_action_item(uuid, bigint, text, uuid, date);
121: --   drop function if exists public.set_meeting_note_action_item_completed(uuid, bigint, boolean);
122: --   drop function if exists public.delete_meeting_note_action_item(uuid, bigint);
123: --   drop function if exists private.meeting_note_item_lock(uuid, bigint, text);
124: --   drop function if exists private.meeting_note_item_validate_description(text);
125: --   drop function if exists private.meeting_note_item_resolve_assignee(uuid, uuid);
126: --   drop trigger if exists meeting_note_action_items_guard on public.meeting_note_action_items;
127: --   drop trigger if exists meeting_note_action_items_reject_truncate on public.meeting_note_action_items;
128: --   drop function if exists private.guard_meeting_note_action_item();
129: --   -- Restore T17's self-contained authorize helper (verbatim body from
130: --   -- 20261013105021_meeting_notes_mutation_rpcs.sql, "create or replace
131: --   -- function private.meeting_note_authorize" through its "$$;"), re-apply its
132: --   -- owner/revoke lines from that file, then:
133: --   drop function if exists private.meeting_note_lock_for_change(uuid, text);
134: --   alter table public.meeting_note_action_items
135: --     drop constraint if exists meeting_note_action_items_description_length_check,
136: --     drop constraint if exists meeting_note_action_items_assignee_snapshot_check,
137: --     drop constraint if exists meeting_note_action_items_revision_check,
138: --     drop column if exists creator_user_id,
139: --     drop column if exists creator_name,
140: --     drop column if exists assignee_name,
141: --     drop column if exists revision,
142: --     drop column if exists updated_at,
143: --     alter column due_date type timestamptz
144: --       using (due_date::timestamp at time zone 'America/Sao_Paulo');
145: --   update public.meeting_note_action_items as i set assignee_id = null
146: --   where i.assignee_id is not null
147: --     and not exists (select 1 from public.users as u where u.id = i.assignee_id);
148: --   alter table public.meeting_note_action_items
149: --     add constraint meeting_note_action_items_assignee_id_fkey
150: --       foreign key (assignee_id) references public.users (id) on delete set null;
151: --   grant truncate, references, trigger on table public.meeting_note_action_items to service_role;
152: --   commit;
153: 
154: begin;
155: 
156: set local lock_timeout = '5s';
157: 
158: -- Same order as T1: referenced tables first, then the note tables.
159: lock table public.users in share row exclusive mode;
160: lock table public.meeting_notes, public.meeting_note_action_items in access exclusive mode;
161: 
162: -- ---------------------------------------------------------------------------
163: -- Columns and constraints
164: -- ---------------------------------------------------------------------------
165: 
166: alter table public.meeting_note_action_items
167:   add column creator_user_id uuid,
168:   add column creator_name text,
169:   add column assignee_name text,
170:   add column revision bigint not null default 1,
171:   add column updated_at timestamptz not null default pg_catalog.now(),
172:   alter column due_date type date
173:     using ((due_date at time zone 'America/Sao_Paulo')::date);
174: 
175: update public.meeting_note_action_items as i
176: set creator_user_id = n.author_user_id,
177:     creator_name = n.author_name,
178:     updated_at = i.created_at
179: from public.meeting_notes as n
180: where n.id = i.note_id;
181: 
182: update public.meeting_note_action_items as i
183: set assignee_name = u.display_name
184: from public.users as u
185: where u.id = i.assignee_id;
186: 
187: -- The assignee is identified by users.id without a FK (FR-030): deleting the
188: -- user keeps the id and the snapshot, like note participants.
189: alter table public.meeting_note_action_items
190:   drop constraint meeting_note_action_items_assignee_id_fkey;
191: 
192: alter table public.meeting_note_action_items
193:   alter column creator_user_id set not null,
194:   alter column creator_name set not null,
195:   add constraint meeting_note_action_items_revision_check check (revision >= 1),
196:   add constraint meeting_note_action_items_assignee_snapshot_check
197:     check ((assignee_id is null) = (assignee_name is null)),
198:   add constraint meeting_note_action_items_description_length_check
199:     check (pg_catalog.char_length(description) between 1 and 1000
200:            and pg_catalog.btrim(description, E' \t\r\n') <> '')
201:     not valid;
202: 
203: comment on column public.meeting_note_action_items.due_date is
204:   'Date-only due date (no time, no timezone); optional.';
205: comment on column public.meeting_note_action_items.creator_user_id is
206:   'Historical snapshot of the creating user''s application users.id; immutable, no FK.';
207: comment on column public.meeting_note_action_items.creator_name is
208:   'Historical snapshot of the creating user''s display name; immutable.';
209: comment on column public.meeting_note_action_items.assignee_id is
210:   'Assignee application users.id (no FK: a departed or deleted assignee keeps their place); NULL when 
unassigned.';
211: comment on column public.meeting_note_action_items.assignee_name is
212:   'Assignee display-name snapshot taken when the assignee was chosen; set exactly when assignee_id is set.';
213: comment on column public.meeting_note_action_items.revision is
214:   'Item revision; every change requires the current value and increments it. Independent of the note revision.';
215: 
216: -- ---------------------------------------------------------------------------
217: -- Guard (every role): capacity under the note row lock, immutable fields,
218: -- revision discipline, snapshot consistency
219: -- ---------------------------------------------------------------------------
220: 
221: create or replace function private.guard_meeting_note_action_item()
222: returns trigger
223: language plpgsql
224: volatile
225: security definer
226: set search_path = ''
227: as $$
228: declare
229:   v_count bigint;
230: begin
231:   if tg_op = 'INSERT' then
232:     -- The single per-note lock (PLAN lock order rule). A missing note is left
233:     -- to the note_id FK.
234:     perform 1
235:     from public.meeting_notes as n
236:     where n.id = new.note_id
237:     for update;
238: 
239:     select pg_catalog.count(*)
240:     into v_count
241:     from public.meeting_note_action_items as i
242:     where i.note_id = new.note_id;
243: 
244:     if v_count >= 100 then
245:       raise exception 'MEETING_NOTE_ITEM_LIMIT_REACHED'
246:         using errcode = '22023',
247:               detail = '{"limit": 100}';
248:     end if;
249:     return new;
250:   end if;
251: 
252:   if new.id is distinct from old.id
253:      or new.note_id is distinct from old.note_id
254:      or new.creator_user_id is distinct from old.creator_user_id
255:      or new.creator_name is distinct from old.creator_name
256:      or new.created_at is distinct from old.created_at
257:      or new.revision < old.revision then
258:     raise exception 'MEETING_NOTE_ITEM_IMMUTABLE_FIELD' using errcode = '42501';
259:   end if;
260: 
261:   if new.assignee_name is distinct from old.assignee_name
262:      and new.assignee_id is not distinct from old.assignee_id then
263:     raise exception 'MEETING_NOTE_ITEM_ASSIGNEE_SNAPSHOT_MISMATCH' using errcode = '23514';
264:   end if;
265: 
266:   if (new.description is distinct from old.description
267:       or new.assignee_id is distinct from old.assignee_id
268:       or new.assignee_name is distinct from old.assignee_name
269:       or new.due_date is distinct from old.due_date
270:       or new.completed is distinct from old.completed)
271:      and new.revision <= old.revision then
272:     raise exception 'MEETING_NOTE_ITEM_REVISION_NOT_BUMPED' using errcode = '23514';
273:   end if;
274: 
275:   return new;
276: end;
277: $$;
278: 
279: alter function private.guard_meeting_note_action_item() owner to postgres;
280: revoke all on function private.guard_meeting_note_action_item() from public, anon, authenticated, service_role;
281: 
282: create trigger meeting_note_action_items_guard
283:   before insert or update on public.meeting_note_action_items
284:   for each row execute function private.guard_meeting_note_action_item();
285: 
286: create trigger meeting_note_action_items_reject_truncate
287:   before truncate on public.meeting_note_action_items
288:   for each statement execute function private.reject_meeting_note_truncate();
289: 
290: -- No client writes (unchanged); service_role keeps row DML only.
291: revoke all on table public.meeting_note_action_items from public, anon;
292: revoke insert, update, delete, truncate, references, trigger on table public.meeting_note_action_items from 
authenticated;
293: revoke truncate, references, trigger on table public.meeting_note_action_items from service_role;
294: 
295: -- ---------------------------------------------------------------------------
296: -- Shared note authorization (T17 rules, one place)
297: -- ---------------------------------------------------------------------------
298: 
299: -- Locks the caller's users row FOR KEY SHARE, then (for a current member of
300: -- the note's company only) the note row FOR UPDATE, and reports the caller's
301: -- rights on the locked pre-change state. Raises p_not_found (P0002) when the
302: -- note is missing or the caller is not a current member of its company.
303: create or replace function private.meeting_note_lock_for_change(
304:   p_note_id uuid,
305:   p_not_found text,
306:   out caller_id uuid,
307:   out caller_name text,
308:   out note_company_id uuid,
309:   out note_revision bigint,
310:   out can_edit boolean,
311:   out can_delete boolean
312: )
313: language plpgsql
314: volatile
315: security definer
316: set search_path = ''
317: as $$
318: declare
319:   v_caller record;
320:   v_note record;
321: begin
322:   select * into v_caller from private.meeting_note_lock_caller();
323:   if p_note_id is null or v_caller.caller_id is null or v_caller.caller_company_id is null then
324:     raise exception '%', p_not_found using errcode = 'P0002';
325:   end if;
326: 
327:   -- Outsiders never take the note lock: the company check runs on an
328:   -- unlocked read first (company_id is immutable, so it cannot go stale).
329:   if not exists (
330:     select 1
331:     from public.meeting_notes as n
332:     where n.id = p_note_id
333:       and n.company_id = v_caller.caller_company_id
334:   ) then
335:     raise exception '%', p_not_found using errcode = 'P0002';
336:   end if;
337: 
338:   select n.id, n.company_id, n.author_user_id, n.revision
339:   into v_note
340:   from public.meeting_notes as n
341:   where n.id = p_note_id
342:   for update;
343: 
344:   if not found then
345:     -- Deleted by a transaction that committed while this one waited.
346:     raise exception '%', p_not_found using errcode = 'P0002';
347:   end if;
348: 
349:   -- Two-valued by construction (a NULL input never grants a right).
350:   can_delete := coalesce(v_note.author_user_id = v_caller.caller_id, false)
351:                 or coalesce(v_caller.caller_is_admin, false);
352:   can_edit := can_delete or exists (
353:     select 1
354:     from public.meeting_note_participants as p
355:     where p.note_id = v_note.id

 succeeded in 135ms:
356:       and p.user_id = v_caller.caller_id
357:   );
358:   caller_id := v_caller.caller_id;
359:   caller_name := v_caller.caller_name;
360:   note_company_id := v_note.company_id;
361:   note_revision := v_note.revision;
362: end;
363: $$;
364: 
365: -- T17's helper, now built on the shared lock-and-rights helper. Same checks,
366: -- order, tokens, and outputs as in 20261013105021.
367: create or replace function private.meeting_note_authorize(
368:   p_note_id uuid,
369:   p_expected_revision bigint,
370:   p_action text,
371:   out caller_id uuid,
372:   out caller_name text,
373:   out note_company_id uuid
374: )
375: language plpgsql
376: volatile
377: security definer
378: set search_path = ''
379: as $$
380: declare
381:   v_lock record;
382: begin
383:   if p_action is null or p_action not in ('edit', 'delete') then
384:     raise exception 'meeting_note_authorize: unknown action' using errcode = '22023';
385:   end if;
386:   if p_expected_revision is null then
387:     raise exception 'MEETING_NOTE_REVISION_REQUIRED' using errcode = '22023';
388:   end if;
389: 
390:   select * into v_lock from private.meeting_note_lock_for_change(p_note_id, 'MEETING_NOTE_NOT_FOUND');
391: 
392:   if (case p_action when 'edit' then v_lock.can_edit else v_lock.can_delete end) is not true then
393:     raise exception 'MEETING_NOTE_FORBIDDEN' using errcode = '42501';
394:   end if;
395: 
396:   if v_lock.note_revision <> p_expected_revision then
397:     raise exception 'MEETING_NOTE_STALE_REVISION'
398:       using errcode = 'P0001',
399:             detail = pg_catalog.format('{"current_revision": %s}', v_lock.note_revision);
400:   end if;
401: 
402:   caller_id := v_lock.caller_id;
403:   caller_name := v_lock.caller_name;
404:   note_company_id := v_lock.note_company_id;
405: end;
406: $$;
407: 
408: -- ---------------------------------------------------------------------------
409: -- Item helpers (no EXECUTE for any client or server role)
410: -- ---------------------------------------------------------------------------
411: 
412: create or replace function private.meeting_note_item_validate_description(p_description text)
413: returns void
414: language plpgsql
415: stable
416: security definer
417: set search_path = ''
418: as $$
419: begin
420:   if p_description is null
421:      or pg_catalog.btrim(p_description, E' \t\r\n') = ''
422:      or pg_catalog.char_length(p_description) > 1000 then
423:     raise exception 'MEETING_NOTE_ITEM_DESCRIPTION_INVALID' using errcode = '22023';
424:   end if;
425: end;
426: $$;
427: 
428: -- The display-name snapshot of p_assignee_id when it is a current member of
429: -- p_company_id; NULL for NULL; otherwise MEETING_NOTE_ITEM_ASSIGNEE_NOT_MEMBER.
430: create or replace function private.meeting_note_item_resolve_assignee(
431:   p_company_id uuid,
432:   p_assignee_id uuid
433: )
434: returns text
435: language plpgsql
436: stable
437: security definer
438: set search_path = ''
439: as $$
440: declare
441:   v_name text;
442: begin
443:   if p_assignee_id is null then
444:     return null;
445:   end if;
446: 
447:   select u.display_name
448:   into v_name
449:   from public.users as u
450:   where u.id = p_assignee_id
451:     and u.company_id = p_company_id;
452: 
453:   if not found then
454:     raise exception 'MEETING_NOTE_ITEM_ASSIGNEE_NOT_MEMBER' using errcode = '22023';
455:   end if;
456:   return v_name;
457: end;
458: $$;
459: 
460: -- Locks caller -> note -> item (lock order rule), authorizes p_action
461: -- ('edit' | 'complete') on the locked pre-change state, then checks the item
462: -- revision. Returns the caller, the note's company, and the locked item.
463: create or replace function private.meeting_note_item_lock(
464:   p_item_id uuid,
465:   p_expected_revision bigint,
466:   p_action text,
467:   out caller_id uuid,
468:   out note_company_id uuid,
469:   out item_assignee_id uuid,
470:   out item_assignee_name text
471: )
472: language plpgsql
473: volatile
474: security definer
475: set search_path = ''
476: as $$
477: declare
478:   v_note_id uuid;
479:   v_lock record;
480:   v_item record;
481: begin
482:   if p_action is null or p_action not in ('edit', 'complete') then
483:     raise exception 'meeting_note_item_lock: unknown action' using errcode = '22023';
484:   end if;
485:   if p_expected_revision is null then
486:     raise exception 'MEETING_NOTE_ITEM_REVISION_REQUIRED' using errcode = '22023';
487:   end if;
488: 
489:   -- Unlocked read of the immutable note_id (no lock is taken before the
490:   -- caller's users row).
491:   select i.note_id into v_note_id
492:   from public.meeting_note_action_items as i
493:   where i.id = p_item_id;
494:   if p_item_id is null or v_note_id is null then
495:     raise exception 'MEETING_NOTE_ITEM_NOT_FOUND' using errcode = 'P0002';
496:   end if;
497: 
498:   select * into v_lock from private.meeting_note_lock_for_change(v_note_id, 'MEETING_NOTE_ITEM_NOT_FOUND');
499: 
500:   select i.id, i.assignee_id, i.assignee_name, i.revision
501:   into v_item
502:   from public.meeting_note_action_items as i
503:   where i.id = p_item_id
504:     and i.note_id = v_note_id
505:   for update;
506:   if not found then
507:     -- Deleted by a transaction that committed while this one waited.
508:     raise exception 'MEETING_NOTE_ITEM_NOT_FOUND' using errcode = 'P0002';
509:   end if;
510: 
511:   -- Null-safe: an unassigned item (assignee_id NULL) grants nothing.
512:   if (v_lock.can_edit
513:       or (p_action = 'complete'
514:           and v_item.assignee_id is not null
515:           and v_item.assignee_id = v_lock.caller_id)) is not true then
516:     raise exception 'MEETING_NOTE_ITEM_FORBIDDEN' using errcode = '42501';
517:   end if;
518: 
519:   if v_item.revision <> p_expected_revision then
520:     raise exception 'MEETING_NOTE_ITEM_STALE_REVISION'
521:       using errcode = 'P0001',
522:             detail = pg_catalog.format('{"current_revision": %s}', v_item.revision);
523:   end if;
524: 
525:   caller_id := v_lock.caller_id;
526:   note_company_id := v_lock.note_company_id;
527:   item_assignee_id := v_item.assignee_id;
528:   item_assignee_name := v_item.assignee_name;
529: end;
530: $$;
531: 
532: -- ---------------------------------------------------------------------------
533: -- RPCs (authenticated only)
534: -- ---------------------------------------------------------------------------
535: 
536: create or replace function public.create_meeting_note_action_item(
537:   p_note_id uuid,
538:   p_description text,
539:   p_assignee_id uuid,
540:   p_due_date date
541: )
542: returns jsonb
543: language plpgsql
544: volatile
545: security definer
546: set search_path = ''
547: as $$
548: declare
549:   v_lock record;
550:   v_assignee_name text;
551:   v_item public.meeting_note_action_items;
552: begin
553:   perform private.meeting_note_item_validate_description(p_description);
554: 
555:   select * into v_lock from private.meeting_note_lock_for_change(p_note_id, 'MEETING_NOTE_NOT_FOUND');
556:   if v_lock.can_edit is not true then
557:     raise exception 'MEETING_NOTE_ITEM_FORBIDDEN' using errcode = '42501';
558:   end if;
559: 
560:   v_assignee_name := private.meeting_note_item_resolve_assignee(v_lock.note_company_id, p_assignee_id);
561: 
562:   -- Capacity (100) is enforced by the insert trigger under the note row lock
563:   -- this transaction already holds.
