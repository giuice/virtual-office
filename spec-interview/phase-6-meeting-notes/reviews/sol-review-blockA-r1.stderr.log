14: 
15: /**
16:  * GET /api/meeting-notes/search?q=&spaceId=&removed=&from=&to=&limit=&cursor=
17:  * Full-text search over the caller's company's notes (FR-004, FR-026): title,
18:  * content text, summary, and action-item descriptions; accent- and
19:  * case-insensitive, Portuguese and English. Called with the caller's session:
20:  * public.search_meeting_notes resolves the caller from auth.uid()
21:  * (users.supabase_uid) and reads only notes of that user's company_id (the
22:  * RLS read rule, BR-001), so another company's notes never appear.
23:  *
24:  * - `q` (<= 200 chars, websearch syntax). Empty or absent = list mode: every
25:  *   note within the filters, newest meeting first, `relevance`/`excerpt` null.
26:  * - `spaceId` = only that space; `removed=true` = only notes whose space was
27:  *   deleted ("Space removed"); not both (400 MEETING_NOTE_SEARCH_FILTER_INVALID).
28:  * - `from` (inclusive) / `to` (exclusive): ISO date-times with offset on the
29:  *   meeting date (400 MEETING_NOTE_SEARCH_PERIOD_INVALID when malformed or from > to).
30:  * - `limit` 1..50 (default 20); `cursor` = offset 0..10,000 (default 0).
31:  * - Matching is per document: the note's own text (title, content, summary)
32:  *   or ONE action item; all words of `q` (and any `-word` exclusion) apply
33:  *   within that document, so words split between the note text and an item,
34:  *   or across two items, do not combine into one match.
35:  * - Rate limit 'meeting-note:search' (120/min per user, fail-open) -> 429.
36:  *
37:  * 200 { items: MeetingNoteSearchResult[], nextCursor, hasMore, totalCount }:
38:  * relevance desc, meeting date desc, id desc. Each excerpt is plain-text
39:  * segments with `highlighted` matches (render as text). Never returns content,
40:  * summary, or transcript text beyond the excerpt.
41:  */
42: export async function GET(request: NextRequest): Promise<NextResponse> {
43:   const begun = await beginMeetingNoteRequest('/api/meeting-notes/search', 'meeting-note:search');
44:   if (!begun.ok) return begun.response;
45:   const ctx = begun.value;
46: 
47:   const params = request.nextUrl.searchParams;
48:   const query = parseWith(
49:     searchMeetingNotesQuerySchema,
50:     {
51:       q: params.get('q') ?? undefined,
52:       spaceId: params.get('spaceId') ?? undefined,
53:       removed: params.get('removed') ?? undefined,
54:       from: params.get('from') ?? undefined,
55:       to: params.get('to') ?? undefined,
56:       limit: params.get('limit') ?? undefined,
57:       cursor: params.get('cursor') ?? undefined,
58:     },
59:     ctx
60:   );
61:   if (!query.ok) return query.response;
62: 
63:   try {
64:     const page = await ctx.repository.searchNotes({
65:       query: query.value.q,
66:       spaceId: query.value.spaceId ?? null,
67:       spaceRemoved: query.value.removed,
68:       meetingFrom: query.value.from ?? null,
69:       meetingTo: query.value.to ?? null,
70:       limit: query.value.limit,
71:       offset: query.value.cursor,
72:     });
73:     return ok(page, ctx);
74:   } catch (error) {
75:     if (error instanceof MeetingNoteDbError && error.sqlstate === '22023' && error.token === 
