60:   allowProtocolRelative: false,
61:   // Drop the CONTENT of these too, not only the tags.
62:   nonTextTags: ['script', 'style', 'textarea', 'option', 'noscript', 'iframe', 'object', 'embed', 'template', 
'svg', 'math'],
63:   disallowedTagsMode: 'discard',
64:   enforceHtmlBoundary: false,
65:   parseStyleAttributes: false,
66:   transformTags: {
67:     a: (tagName, attribs) => {
68:       const href = (attribs.href ?? '').trim();
69:       const next: sanitizeHtml.Attributes = {};
70:       if (SAFE_HREF.test(href)) {
71:         next.href = href;
72:         next.rel = MEETING_NOTE_LINK_REL;
73:         if (attribs.target === '_blank') next.target = '_blank';
74:       }
75:       return { tagName, attribs: next };
76:     },
77:     ol: (tagName, attribs) => {
78:       const next: sanitizeHtml.Attributes = {};
79:       if (attribs.start !== undefined && /^\d{1,6}$/.test(attribs.start)) next.start = attribs.start;
80:       return { tagName, attribs: next };
81:     },
82:   },
83:   // Only checkbox inputs survive (an input whose type is not exactly
84:   // "checkbox" is removed with its attributes).
85:   exclusiveFilter: (frame) => frame.tag === 'input' && frame.attribs.type !== 'checkbox',
86: };
87: 
88: /** Sanitizes meeting-note rich text with the allow-list above. */
89: export function sanitizeMeetingNoteHtml(html: string): string {
90:   // NUL is invalid in Postgres text and replaced by browsers anyway.
91:   return sanitizeHtml(html.replace(/␀/g, ''), MEETING_NOTE_SANITIZE_OPTIONS);
92: }
src/lib/meeting-notes/validation.ts
1: // src/lib/meeting-notes/validation.ts
2: // Phase 6 request contracts for the meeting-note routes (FR-001, FR-011,
3: // AC-002, AC-009). Limits mirror SPEC §10 and the database checks, which stay
4: // the final authority. Each issue's message is a stable error code; lengths
5: // count Unicode code points, like Postgres char_length.
6: import { z } from 'zod';
7: 
8: export const MEETING_NOTE_LIMITS = {
9:   titleMaxChars: 200,
10:   contentMaxChars: 100_000,
11:   maxParticipants: 50,
12:   itemDescriptionMaxChars: 1_000,
13:   maxItemsPerNote: 100,
14: } as const;
15: 
16: /** Upper bound of a request body (sanitization runs on at most this much). */
17: export const MEETING_NOTE_MAX_BODY_BYTES = 1_048_576;
18: 
19: /** Unicode code points (Postgres char_length), not UTF-16 units. */
20: export function codePointLength(value: string): number {
21:   return Array.from(value).length;
22: }
23: 
24: const ISO_DATE = /^\d{4}-\d{2}-\d{2}$/;
25: 
26: /** A real calendar date 'YYYY-MM-DD'. */
27: function isCalendarDate(value: string): boolean {
28:   if (!ISO_DATE.test(value)) return false;
29:   const parsed = new Date(`${value}T00:00:00Z`);
30:   return !Number.isNaN(parsed.getTime()) && parsed.toISOString().slice(0, 10) === value;
31: }
32: 
33: const revisionSchema = (code: string) =>
34:   z.number({ error: code }).int({ error: code }).min(1, { error: code }).max(Number.MAX_SAFE_INTEGER, { error: 
code });
35: 
36: const titleSchema = z
37:   .string({ error: 'MEETING_NOTE_TITLE_INVALID' })
38:   .trim()
39:   .refine((value) => {
40:     const length = codePointLength(value);
41:     return length >= 1 && length <= MEETING_NOTE_LIMITS.titleMaxChars && !value.includes('␀');
42:   }, { error: 'MEETING_NOTE_TITLE_INVALID' });
43: 
44: const meetingDateSchema = z.iso.datetime({ offset: true, error: 'MEETING_NOTE_DATE_REQUIRED' });
45: 
46: // Raw content; its 100,000-char limit applies AFTER sanitization (route).
47: const contentSchema = z.string({ error: 'MEETING_NOTE_CONTENT_REQUIRED' });
48: 
49: const participantIdsSchema = z
50:   .array(z.guid({ error: 'MEETING_NOTE_PARTICIPANTS_INVALID' }), { error: 'MEETING_NOTE_PARTICIPANTS_INVALID' })
51:   .max(MEETING_NOTE_LIMITS.maxParticipants, { error: 'MEETING_NOTE_TOO_MANY_PARTICIPANTS' })
52:   .refine((ids) => new Set(ids.map((id) => id.toLowerCase())).size === ids.length, {
53:     error: 'MEETING_NOTE_PARTICIPANTS_INVALID',
54:   });
55: 
56: export const createMeetingNoteBodySchema = z.object({
57:   spaceId: z.guid({ error: 'MEETING_NOTE_SPACE_INVALID' }),
58:   title: titleSchema,
59:   meetingDate: meetingDateSchema,
60:   content: contentSchema.default(''),
61:   participantIds: participantIdsSchema.default([]),
62: });
63: 
64: // Full replacement: every field is required so a missing one never wipes data.
65: export const updateMeetingNoteBodySchema = z.object({
66:   expectedRevision: revisionSchema('MEETING_NOTE_REVISION_REQUIRED'),
67:   title: titleSchema,
68:   meetingDate: meetingDateSchema,
69:   content: contentSchema,
70:   participantIds: participantIdsSchema,
71: });
72: 
73: export const restoreMeetingNoteBodySchema = z.object({
74:   expectedRevision: revisionSchema('MEETING_NOTE_REVISION_REQUIRED'),
75:   versionId: z.guid({ error: 'MEETING_NOTE_VERSION_INVALID' }),
76: });
77: 
78: const descriptionSchema = z
79:   .string({ error: 'MEETING_NOTE_ITEM_DESCRIPTION_INVALID' })
80:   .trim()
81:   .refine((value) => {
82:     const length = codePointLength(value);
83:     return length >= 1 && length <= MEETING_NOTE_LIMITS.itemDescriptionMaxChars && !value.includes('␀');
84:   }, { error: 'MEETING_NOTE_ITEM_DESCRIPTION_INVALID' });
85: 
86: const assigneeSchema = z.guid({ error: 'MEETING_NOTE_ITEM_ASSIGNEE_INVALID' }).nullable();
87: 
88: const dueDateSchema = z
89:   .string({ error: 'MEETING_NOTE_ITEM_DUE_DATE_INVALID' })
90:   .refine(isCalendarDate, { error: 'MEETING_NOTE_ITEM_DUE_DATE_INVALID' })
91:   .nullable();
92: 
93: export const createActionItemBodySchema = z.object({
94:   description: descriptionSchema,
95:   assigneeId: assigneeSchema.default(null),
96:   dueDate: dueDateSchema.default(null),
97: });
98: 
99: // Full replacement, like the note update.
100: export const updateActionItemBodySchema = z.object({
101:   expectedRevision: revisionSchema('MEETING_NOTE_ITEM_REVISION_REQUIRED'),
102:   description: descriptionSchema,
103:   assigneeId: assigneeSchema,
104:   dueDate: dueDateSchema,
105: });
106: 
107: export const actionItemCompletionBodySchema = z.object({
108:   expectedRevision: revisionSchema('MEETING_NOTE_ITEM_REVISION_REQUIRED'),
109:   completed: z.boolean({ error: 'MEETING_NOTE_ITEM_COMPLETED_REQUIRED' }),
110: });
111: 
112: /** `?expectedRevision=` of DELETE requests. */
113: export const expectedRevisionParamSchema = (code: string) =>
114:   z
115:     .string({ error: code })
116:     .regex(/^[1-9]\d{0,15}$/, { error: code })
117:     .transform(Number)
118:     .pipe(revisionSchema(code));
119: 
120: export const listMeetingNotesQuerySchema = z.object({
121:   spaceId: z.guid({ error: 'MEETING_NOTE_SPACE_INVALID' }),
122:   limit: z.coerce.number({ error: 'BAD_REQUEST' }).int({ error: 'BAD_REQUEST' }).min(1, { error: 'BAD_REQUEST' 
}).max(100, { error: 'BAD_REQUEST' }).default(20),
123:   cursor: z.coerce.number({ error: 'BAD_REQUEST' }).int({ error: 'BAD_REQUEST' }).min(0, { error: 'BAD_REQUEST' 
}).max(1_000_000, { error: 'BAD_REQUEST' }).default(0),
124: });
125: 
126: export const MEETING_NOTE_SEARCH_LIMITS = {
127:   queryMaxChars: 200,
128:   maxPageSize: 50,
129:   defaultPageSize: 20,
130:   maxOffset: 10_000,
131: } as const;
132: 
133: const searchPeriodBoundSchema = z.iso.datetime({ offset: true, error: 'MEETING_NOTE_SEARCH_PERIOD_INVALID' 
}).optional();
134: 
135: /**
136:  * `GET /api/meeting-notes/search` query (FR-026). `q` empty = list mode;
137:  * `spaceId` and `removed=true` are mutually exclusive; `from` inclusive, `to`
138:  * exclusive (ISO date-time with offset); `cursor` is an offset.
139:  */
140: export const searchMeetingNotesQuerySchema = z
141:   .object({
142:     q: z
143:       .string({ error: 'BAD_REQUEST' })
144:       .trim()
145:       .refine((value) => codePointLength(value) <= MEETING_NOTE_SEARCH_LIMITS.queryMaxChars, {
146:         error: 'MEETING_NOTE_SEARCH_QUERY_TOO_LONG',
147:       })
148:       .default(''),
149:     spaceId: z.guid({ error: 'MEETING_NOTE_SPACE_INVALID' }).optional(),
150:     removed: z
151:       .enum(['true', 'false'], { error: 'BAD_REQUEST' })
152:       .default('false')
153:       .transform((value) => value === 'true'),
154:     from: searchPeriodBoundSchema,
155:     to: searchPeriodBoundSchema,
156:     limit: z.coerce
157:       .number({ error: 'BAD_REQUEST' })
158:       .int({ error: 'BAD_REQUEST' })
159:       .min(1, { error: 'BAD_REQUEST' })
160:       .max(MEETING_NOTE_SEARCH_LIMITS.maxPageSize, { error: 'BAD_REQUEST' })
161:       .default(MEETING_NOTE_SEARCH_LIMITS.defaultPageSize),
162:     cursor: z.coerce
163:       .number({ error: 'BAD_REQUEST' })
164:       .int({ error: 'BAD_REQUEST' })
165:       .min(0, { error: 'BAD_REQUEST' })
166:       .max(MEETING_NOTE_SEARCH_LIMITS.maxOffset, { error: 'BAD_REQUEST' })
167:       .default(0),
168:   })
169:   .superRefine((value, context) => {
170:     if (value.spaceId !== undefined && value.removed) {
171:       context.addIssue({ code: 'custom', message: 'MEETING_NOTE_SEARCH_FILTER_INVALID', path: ['removed'] });
172:     }
173:     if (value.from !== undefined && value.to !== undefined && Date.parse(value.from) > Date.parse(value.to)) {
174:       context.addIssue({ code: 'custom', message: 'MEETING_NOTE_SEARCH_PERIOD_INVALID', path: ['from'] });
175:     }
176:   });
177: 
178: export type SearchMeetingNotesQuery = z.infer<typeof searchMeetingNotesQuerySchema>;
179: 
180: /** Path ids: a malformed id is answered like a missing one. */
181: export const pathIdSchema = z.guid();
182: 
183: export type CreateMeetingNoteBody = z.infer<typeof createMeetingNoteBodySchema>;
184: export type UpdateMeetingNoteBody = z.infer<typeof updateMeetingNoteBodySchema>;
185: export type RestoreMeetingNoteBody = z.infer<typeof restoreMeetingNoteBodySchema>;
186: export type CreateActionItemBody = z.infer<typeof createActionItemBodySchema>;
187: export type UpdateActionItemBody = z.infer<typeof updateActionItemBodySchema>;
188: export type ActionItemCompletionBody = z.infer<typeof actionItemCompletionBodySchema>;
src/lib/meeting-notes/search-excerpt.ts
1: // src/lib/meeting-notes/search-excerpt.ts
2: // Phase 6 T4 (FR-026): turns the excerpt returned by public.search_meeting_notes
3: // (migration 20261013114402) into plain-text segments. The database wraps each
4: // matched word in U+E000 (start) and U+E001 (end) and strips both characters
5: // from the source text beforehand, so they only ever delimit highlights. The
6: // excerpt is plain text (content tags removed, entities decoded); the UI must
7: // render segments as text.
8: import type {
9:   MeetingNoteExcerptSegment,
10:   MeetingNoteSearchExcerpt,
11:   MeetingNoteSearchField,
12: } from '@/types/meeting-notes';
13: 
14: export const MEETING_NOTE_HIGHLIGHT_START = String.fromCharCode(0xe000);
15: export const MEETING_NOTE_HIGHLIGHT_END = String.fromCharCode(0xe001);
16: 
17: /** Upper bound of excerpt text sent to the client (code points). */
18: export const MEETING_NOTE_EXCERPT_MAX_CHARS = 600;
19: 
20: const FIELDS: ReadonlySet<string> = new Set<MeetingNoteSearchField>(['content', 'summary', 'action_item', 
'title']);
21: 
22: function isSearchField(value: string): value is MeetingNoteSearchField {
23:   return FIELDS.has(value);
24: }
25: 
26: /** Splits a marked excerpt into segments, capped at MEETING_NOTE_EXCERPT_MAX_CHARS. */
27: export function parseMeetingNoteExcerpt(
28:   field: string | null,
29:   excerpt: string | null
30: ): MeetingNoteSearchExcerpt | null {
31:   if (field === null || excerpt === null || !isSearchField(field)) return null;
32: 
33:   const segments: MeetingNoteExcerptSegment[] = [];
34:   let budget = MEETING_NOTE_EXCERPT_MAX_CHARS;
35:   let highlighted = false;
36:   let buffer = '';
37: 
38:   const flush = (): void => {
39:     if (buffer === '' || budget <= 0) {
40:       buffer = '';
41:       return;
42:     }
43:     const chars = Array.from(buffer);
44:     const text = chars.length > budget ? `${chars.slice(0, budget).join('')}…` : buffer;
45:     budget -= Math.min(chars.length, budget);
46:     const previous = segments[segments.length - 1];
47:     if (previous && previous.highlighted === highlighted) previous.text += text;
48:     else segments.push({ text, highlighted });
49:     buffer = '';
50:   };
51: 
52:   for (const char of excerpt) {
53:     if (char === MEETING_NOTE_HIGHLIGHT_START) {
54:       flush();
55:       highlighted = true;
56:     } else if (char === MEETING_NOTE_HIGHLIGHT_END) {
57:       flush();
58:       highlighted = false;
59:     } else {
60:       buffer += char;
61:     }
62:   }
63:   flush();
64: 
65:   return { field, segments };
66: }
src/lib/meeting-notes/errors.ts
1: // src/lib/meeting-notes/errors.ts
2: // Errors raised by the meeting-note RPCs (migrations 20261013105021,
3: // 20261013110632, and 20261013114402), carried from the repository to the routes.
4: 
5: /** Message tokens the meeting-note RPCs raise (SQLSTATE in comments). */
6: export const MEETING_NOTE_ERROR_TOKENS = [
7:   // P0001
8:   'MEETING_NOTE_STALE_REVISION',
9:   'MEETING_NOTE_ITEM_STALE_REVISION',
10:   // 42501
11:   'MEETING_NOTE_FORBIDDEN',
12:   'MEETING_NOTE_ITEM_FORBIDDEN',
13:   // P0002
14:   'MEETING_NOTE_NOT_FOUND',
15:   'MEETING_NOTE_SPACE_NOT_FOUND',
16:   'MEETING_NOTE_VERSION_NOT_FOUND',
17:   'MEETING_NOTE_ITEM_NOT_FOUND',
18:   // 22023
19:   'MEETING_NOTE_TITLE_INVALID',
20:   'MEETING_NOTE_DATE_REQUIRED',
21:   'MEETING_NOTE_CONTENT_TOO_LONG',
22:   'MEETING_NOTE_CONTENT_REQUIRED',
23:   'MEETING_NOTE_TOO_MANY_PARTICIPANTS',
24:   'MEETING_NOTE_PARTICIPANTS_INVALID',
25:   'MEETING_NOTE_PARTICIPANT_NOT_MEMBER',
26:   'MEETING_NOTE_REVISION_REQUIRED',
27:   'MEETING_NOTE_ITEM_DESCRIPTION_INVALID',
28:   'MEETING_NOTE_ITEM_ASSIGNEE_NOT_MEMBER',
29:   'MEETING_NOTE_ITEM_REVISION_REQUIRED',
30:   'MEETING_NOTE_ITEM_COMPLETED_REQUIRED',
31:   'MEETING_NOTE_ITEM_LIMIT_REACHED',
32:   // 22023, search (migration 20261013114402)
33:   'MEETING_NOTE_SEARCH_INVALID',
34: ] as const;
35: 
36: export type MeetingNoteErrorToken = (typeof MEETING_NOTE_ERROR_TOKENS)[number];
37: 
38: const KNOWN_TOKENS: ReadonlySet<string> = new Set(MEETING_NOTE_ERROR_TOKENS);
39: 
40: export function isMeetingNoteErrorToken(value: string): value is MeetingNoteErrorToken {
41:   return KNOWN_TOKENS.has(value);
42: }
43: 
44: /**
45:  * A database error from a meeting-note RPC. `token` is set only for the
46:  * documented message tokens; anything else is an unexpected failure whose
47:  * message must not reach the client.
48:  */
49: export class MeetingNoteDbError extends Error {
50:   readonly sqlstate: string | undefined;
51:   readonly token: MeetingNoteErrorToken | null;
52:   /** Parsed DETAIL JSON (e.g. {"current_revision": 3}); null when absent or not JSON. */
53:   readonly detail: Record<string, unknown> | null;
54: 
55:   constructor(sqlstate: string | undefined, message: string, detail: string | null | undefined) {
56:     super(message);
57:     this.name = 'MeetingNoteDbError';
58:     this.sqlstate = sqlstate;
59:     this.token = isMeetingNoteErrorToken(message) ? message : null;
60:     this.detail = parseDetail(detail);
61:   }
62: 
63:   /** The current revision reported by a stale-revision error, if any. */
64:   get currentRevision(): number | null {
65:     const value = this.detail?.current_revision;
66:     return typeof value === 'number' && Number.isSafeInteger(value) ? value : null;
67:   }
68: }
69: 
70: function parseDetail(detail: string | null | undefined): Record<string, unknown> | null {
71:   if (!detail) return null;
72:   try {
73:     const parsed: unknown = JSON.parse(detail);
74:     return typeof parsed === 'object' && parsed !== null && !Array.isArray(parsed)
75:       ? (parsed as Record<string, unknown>)
76:       : null;
77:   } catch {
78:     return null;
79:   }
80: }
src/lib/meeting-notes/route-support.ts
1: // src/lib/meeting-notes/route-support.ts
2: // Shared plumbing of the /api/meeting-notes routes (Phase 6 T3): session,
3: // rate limit, bounded JSON bodies, validation errors, and the mapping of RPC
4: // refusals to HTTP. Note and item reads and writes always use the USER's
5: // server client (RLS and the RPCs authorize from auth.uid()); the service-role
6: // client is built only to charge the per-user rate-limit counter
7: // (check_rate_limit is service-role only).
8: import 'server-only';
9: 
10: import { NextResponse } from 'next/server';
11: import type { SupabaseClient } from '@supabase/supabase-js';
12: import type { z } from 'zod';
13: import { createCorrelationId, jsonError } from '@/lib/api/server-error';
14: import { enforceRateLimit, type RateLimitedAction } from '@/lib/auth/rate-limit';
15: import { requireAuthUser } from '@/lib/auth/session';
16: import { readBoundedBody } from '@/lib/messaging/metrics-log';
17: import { createSupabaseServerClient } from '@/lib/supabase/server-client';
18: import { SupabaseMeetingNoteRepository } from 
'@/repositories/implementations/supabase/SupabaseMeetingNoteRepository';
19: import type { IMeetingNoteRepository } from '@/repositories/interfaces/IMeetingNoteRepository';
20: import type { ActionItem, User } from '@/types/database';
21: import { MeetingNoteDbError, type MeetingNoteErrorToken } from './errors';
22: import { loadActionItemViews, loadMeetingNoteDetail } from './note-detail';
23: import { MEETING_NOTE_MAX_BODY_BYTES, pathIdSchema } from './validation';
24: 
25: export interface MeetingNoteRouteContext {
26:   correlationId: string;
27:   /** The user's server client (JWT from the request cookies). */
28:   supabase: SupabaseClient;
29:   dbUser: User;
30:   repository: IMeetingNoteRepository;
31: }
32: 
33: type Result<T> = { ok: true; value: T } | { ok: false; response: NextResponse };
34: 
35: const MESSAGES: Record<string, string> = {
36:   BAD_REQUEST: 'The request is invalid.',
37:   UNSUPPORTED_MEDIA_TYPE: 'The request body must be application/json.',
38:   PAYLOAD_TOO_LARGE: 'The request body is too large.',
39:   MEETING_NOTE_SPACE_INVALID: 'A valid space is required.',
40:   MEETING_NOTE_VERSION_INVALID: 'A valid version is required.',
41:   MEETING_NOTE_ITEM_ASSIGNEE_INVALID: 'The assignee is invalid.',
42:   MEETING_NOTE_ITEM_DUE_DATE_INVALID: 'The due date must be a date (YYYY-MM-DD).',
43:   MEETING_NOTE_STALE_REVISION: 'This note was changed by someone else. Review the newer version before saving 
again.',
44:   MEETING_NOTE_ITEM_STALE_REVISION: 'This action item was changed by someone else. Review the newer version and 
try again.',
45:   MEETING_NOTE_FORBIDDEN: 'You do not have permission to change this note.',
46:   MEETING_NOTE_ITEM_FORBIDDEN: 'You do not have permission to change this action item.',
47:   MEETING_NOTE_NOT_FOUND: 'Meeting note not found.',
48:   MEETING_NOTE_SPACE_NOT_FOUND: 'Space not found.',
49:   MEETING_NOTE_VERSION_NOT_FOUND: 'Version not found.',
50:   MEETING_NOTE_ITEM_NOT_FOUND: 'Action item not found.',
51:   MEETING_NOTE_TITLE_INVALID: 'The title is required and must be at most 200 characters.',
52:   MEETING_NOTE_DATE_REQUIRED: 'A valid meeting date is required.',
53:   MEETING_NOTE_CONTENT_TOO_LONG: 'The content must be at most 100,000 characters.',
54:   MEETING_NOTE_CONTENT_REQUIRED: 'The content must be text.',
55:   MEETING_NOTE_TOO_MANY_PARTICIPANTS: 'A note can have at most 50 participants.',
56:   MEETING_NOTE_PARTICIPANTS_INVALID: 'The participant list is invalid.',
57:   MEETING_NOTE_PARTICIPANT_NOT_MEMBER: 'Participants must be current members of your company.',
58:   MEETING_NOTE_REVISION_REQUIRED: 'The note revision is required.',
59:   MEETING_NOTE_ITEM_DESCRIPTION_INVALID: 'The description is required and must be at most 1,000 characters.',
60:   MEETING_NOTE_ITEM_ASSIGNEE_NOT_MEMBER: 'The assignee must be a current member of your company.',
61:   MEETING_NOTE_ITEM_REVISION_REQUIRED: 'The action item revision is required.',
62:   MEETING_NOTE_ITEM_COMPLETED_REQUIRED: 'The completion state is required.',
63:   MEETING_NOTE_ITEM_LIMIT_REACHED: 'A note can have at most 100 action items.',
64:   MEETING_NOTE_SEARCH_INVALID: 'The search request is invalid.',
65:   MEETING_NOTE_SEARCH_QUERY_TOO_LONG: 'The search text must be at most 200 characters.',
66:   MEETING_NOTE_SEARCH_FILTER_INVALID: 'Choose either a space or "Space removed", not both.',
67:   MEETING_NOTE_SEARCH_PERIOD_INVALID: 'The period is invalid: use date-times with an offset, start before end.',
68: };
69: 
70: function messageFor(code: string): string {
71:   return MESSAGES[code] ?? MESSAGES.BAD_REQUEST;
72: }
73: 
74: /** An error response with a stable code and the matching user-facing message. */
75: export function meetingNoteError(
76:   status: number,
77:   code: string,
78:   ctx: { correlationId: string },
79:   context?: string
80: ): NextResponse {
81:   return jsonError(status, code, messageFor(code), { correlationId: ctx.correlationId, context });
82: }
83: 
84: /** 404 for a missing, invisible, or malformed id (never reveals which). */
85: export function notFound(token: MeetingNoteErrorToken, ctx: { correlationId: string }): NextResponse {
86:   return meetingNoteError(404, token, ctx);
87: }
88: 
89: /**
90:  * Authenticates the caller (auth.getUser + users.supabase_uid) and, for a
91:  * mutation, charges `rateLimit` to their users.id.
92:  */
93: export async function beginMeetingNoteRequest(
94:   pathname: string,
95:   rateLimit?: RateLimitedAction
96: ): Promise<Result<MeetingNoteRouteContext>> {
97:   const correlationId = createCorrelationId();
98:   const auth = await requireAuthUser({ correlationId, pathname });
99:   if ('errorResponse' in auth) {
100:     return { ok: false, response: auth.errorResponse };
101:   }
102: 
103:   if (rateLimit) {
104:     let limiter: SupabaseClient | null = null;
105:     try {
106:       limiter = await createSupabaseServerClient('service_role');
107:     } catch {
108:       // Fail-open action: a limiter that cannot be built never blocks notes.
109:       console.error(JSON.stringify({ event: 'meeting_notes_limiter_unavailable', correlationId }));
110:     }
111:     if (limiter) {
112:       const limited = await enforceRateLimit(limiter, auth.dbUser.id, rateLimit);
113:       if (limited) return { ok: false, response: limited };
114:     }
115:   }
116: 
117:   return {
118:     ok: true,
119:     value: {
120:       correlationId,
121:       supabase: auth.supabase,
122:       dbUser: auth.dbUser,
123:       repository: new SupabaseMeetingNoteRepository(auth.supabase),
124:     },
125:   };
126: }
127: 
128: /** A path id; anything that is not a UUID is answered as not found. */
129: export function parsePathId(
130:   raw: string | undefined,
131:   token: MeetingNoteErrorToken,
132:   ctx: { correlationId: string }
133: ): Result<string> {
134:   const parsed = pathIdSchema.safeParse(raw);
135:   return parsed.success ? { ok: true, value: parsed.data } : { ok: false, response: notFound(token, ctx) };
136: }
137: 
138: /** Validation failure → 400 with the first issue's stable code. */
139: export function validationError(error: z.ZodError, ctx: { correlationId: string }): NextResponse {
140:   const issue = error.issues[0];
141:   const code = issue && /^[A-Z_]+$/.test(issue.message) ? issue.message : 'BAD_REQUEST';
142:   return meetingNoteError(400, code, ctx);
143: }
144: 
145: export function parseWith<S extends z.ZodType>(
146:   schema: S,
147:   value: unknown,
148:   ctx: { correlationId: string }
149: ): Result<z.infer<S>> {
150:   const parsed = schema.safeParse(value);
151:   return parsed.success
152:     ? { ok: true, value: parsed.data }
153:     : { ok: false, response: validationError(parsed.error, ctx) };
154: }
155: 
156: /** A JSON object body of at most MEETING_NOTE_MAX_BODY_BYTES. */
157: export async function readJsonObject(request: Request, ctx: { correlationId: string }): Promise<Result<unknown>> {
158:   const contentType = request.headers.get('content-type') ?? '';
159:   if (contentType.split(';')[0].trim().toLowerCase() !== 'application/json') {
160:     await request.body?.cancel().catch(() => undefined);
161:     return { ok: false, response: meetingNoteError(415, 'UNSUPPORTED_MEDIA_TYPE', ctx) };
162:   }
163:   const body = await readBoundedBody(request, MEETING_NOTE_MAX_BODY_BYTES);
164:   if (!body.ok) {
165:     return {
166:       ok: false,
167:       response: meetingNoteError(body.reason === 'too_large' ? 413 : 400, body.reason === 'too_large' ? 
'PAYLOAD_TOO_LARGE' : 'BAD_REQUEST', ctx),
168:     };
169:   }
170:   try {
171:     const value: unknown = JSON.parse(new TextDecoder('utf-8', { fatal: true }).decode(body.bytes));
172:     if (typeof value !== 'object' || value === null || Array.isArray(value)) {
173:       return { ok: false, response: meetingNoteError(400, 'BAD_REQUEST', ctx) };
174:     }
175:     return { ok: true, value };
176:   } catch {
177:     return { ok: false, response: meetingNoteError(400, 'BAD_REQUEST', ctx) };
178:   }
179: }
180: 
181: /** 500 without SQL, details, or request data (they could carry note text). */
182: export function internalError(error: unknown, ctx: { correlationId: string }, context: string): NextResponse {
183:   const cause =
184:     error instanceof MeetingNoteDbError
185:       ? { code: error.sqlstate, message: error.token ?? 'unexpected database error' }
186:       : { message: error instanceof Error ? error.name : 'unknown' };
187:   return jsonError(500, 'INTERNAL_ERROR', 'Something went wrong. Please try again.', {
188:     correlationId: ctx.correlationId,
189:     cause,
190:     context,
191:   });
192: }
193: 
194: /** Maps a documented RPC refusal (other than a stale revision) to HTTP. */
195: function refusalResponse(error: MeetingNoteDbError, ctx: { correlationId: string }, context: string): 
NextResponse {
196:   const token = error.token;
197:   if (token === null) return internalError(error, ctx, context);
198:   switch (error.sqlstate) {
199:     case '42501':
200:       return meetingNoteError(403, token, ctx, context);
201:     case 'P0002':
202:       return meetingNoteError(404, token, ctx, context);
203:     case '22023':
204:       return meetingNoteError(400, token, ctx, context);
205:     default:
206:       return internalError(error, ctx, context);
207:   }
208: }
209: 
210: function isStale(error: unknown, token: 'MEETING_NOTE_STALE_REVISION' | 'MEETING_NOTE_ITEM_STALE_REVISION'): 
error is MeetingNoteDbError {
211:   return error instanceof MeetingNoteDbError && error.sqlstate === 'P0001' && error.token === token;
212: }
213: 
214: /**
215:  * A failed note mutation → response. A stale revision → 409 carrying the
216:  * note's current state (read with the caller's session) so the UI can show it.
217:  */
218: export async function noteMutationErrorResponse(
219:   error: unknown,
220:   ctx: MeetingNoteRouteContext,
221:   noteId: string,
222:   context: string
223: ): Promise<NextResponse> {
224:   if (isStale(error, 'MEETING_NOTE_STALE_REVISION')) {
225:     try {
226:       const current = await loadMeetingNoteDetail(ctx.repository, ctx.dbUser, noteId);
227:       if (!current) return notFound('MEETING_NOTE_NOT_FOUND', ctx);
228:       return conflict('MEETING_NOTE_STALE_REVISION', current.revision, { note: current }, ctx);
229:     } catch (loadError) {
230:       return internalError(loadError, ctx, `${context}.loadCurrent`);
231:     }
232:   }
233:   if (error instanceof MeetingNoteDbError) return refusalResponse(error, ctx, context);
234:   return internalError(error, ctx, context);
235: }
236: 
237: /** Same for an action-item mutation; the 409 carries the item's current state. */
238: export async function itemMutationErrorResponse(
239:   error: unknown,
240:   ctx: MeetingNoteRouteContext,
241:   itemId: string,
242:   companyId: string | null,
243:   context: string
244: ): Promise<NextResponse> {
245:   if (isStale(error, 'MEETING_NOTE_ITEM_STALE_REVISION')) {
246:     try {
247:       const item = await ctx.repository.findActionItemById(itemId);
248:       if (!item) return notFound('MEETING_NOTE_ITEM_NOT_FOUND', ctx);
249:       const [view] = await loadActionItemViews(ctx.repository, companyId, [item]);
250:       return conflict('MEETING_NOTE_ITEM_STALE_REVISION', view.revision, { item: view }, ctx);
251:     } catch (loadError) {
252:       return internalError(loadError, ctx, `${context}.loadCurrent`);
253:     }
254:   }
255:   if (error instanceof MeetingNoteDbError) return refusalResponse(error, ctx, context);
256:   return internalError(error, ctx, context);
257: }
258: 
259: function conflict(
260:   code: 'MEETING_NOTE_STALE_REVISION' | 'MEETING_NOTE_ITEM_STALE_REVISION',
261:   currentRevision: number,
262:   current: Record<string, unknown>,
263:   ctx: { correlationId: string }
264: ): NextResponse {
265:   return NextResponse.json(
266:     { error: messageFor(code), code, currentRevision, correlationId: ctx.correlationId, ...current },
267:     { status: 409, headers: { 'x-correlation-id': ctx.correlationId } }
268:   );
269: }
270: 
271: /**
272:  * The item addressed by /api/meeting-notes/[id]/items/[itemId], read with the
273:  * caller's session; 404 unless it is visible AND belongs to that note (the
274:  * item RPCs take only the item id, and an item's note_id is immutable).
275:  */
276: export async function resolveItemInNote(
277:   ctx: MeetingNoteRouteContext,
278:   rawNoteId: string | undefined,
279:   rawItemId: string | undefined
280: ): Promise<Result<ActionItem>> {
281:   const noteId = parsePathId(rawNoteId, 'MEETING_NOTE_ITEM_NOT_FOUND', ctx);
282:   if (!noteId.ok) return noteId;
283:   const itemId = parsePathId(rawItemId, 'MEETING_NOTE_ITEM_NOT_FOUND', ctx);
284:   if (!itemId.ok) return itemId;
285:   try {
286:     const item = await ctx.repository.findActionItemById(itemId.value);
287:     if (!item || item.noteId !== noteId.value) {
288:       return { ok: false, response: notFound('MEETING_NOTE_ITEM_NOT_FOUND', ctx) };
289:     }
290:     return { ok: true, value: item };
291:   } catch (error) {
292:     return { ok: false, response: internalError(error, ctx, 'meetingNotes.item.resolve') };
293:   }
294: }
295: 
296: /** A success body with the correlation header. */
297: export function ok<T>(body: T, ctx: { correlationId: string }, status = 200): NextResponse<T> {
298:   return NextResponse.json(body, { status, headers: { 'x-correlation-id': ctx.correlationId } });
299: }
