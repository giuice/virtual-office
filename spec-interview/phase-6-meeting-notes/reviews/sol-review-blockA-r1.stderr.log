475:   it('AC-005: competing transactions on the same revision — the first wins, the second is stale, the first change 
is intact', async () => {
476:     // Save vs save, save vs restore, restore vs save, delete vs save.
477:     const scenarios = [
478:       { name: 'save then save', first: 'save', second: 'save' },
479:       { name: 'restore then save', first: 'restore', second: 'save' },
480:       { name: 'save then restore', first: 'save', second: 'restore' },
481:       { name: 'delete then save', first: 'delete', second: 'save' },
482:     ] as const;
483: 
484:     for (const scenario of scenarios) {
485:       const created = await createNote(world.authorA, {
486:         p_title: `Race v1 ${scenario.name}`,
487:         p_participant_ids: [world.participantA.appUserId],
488:       });
489:       const v2 = await call(world.authorA, 'update_meeting_note', updateArgs(created.note_id, 1, {
490:         p_title: `Race v2 ${scenario.name}`,
491:         p_participant_ids: [world.participantA.appUserId],
492:       }));
493:       expect(v2.error).toBeNull();
494: 
495:       // First session (participant) holds the note lock in an open transaction.
496:       const tx = await openUserTransaction(world.participantA);
497:       try {
498:         if (scenario.first === 'save') {
499:           await tx.query('select public.update_meeting_note($1, 2, $2, $3, $4, $5::uuid[])', [
500:             created.note_id,
501:             `First ${scenario.name}`,
502:             MEETING_DATE,
503:             '<p>first wins</p>',
504:             [world.participantA.appUserId],
505:           ]);
506:         } else if (scenario.first === 'restore') {
507:           await tx.query('select public.restore_meeting_note_version($1, 2, $2)', [created.note_id, 
created.version_id]);
508:         } else {
509:           // Delete needs author or admin: run it as the author instead.
510:           await tx.query('rollback');
511:           await tx.end();
512:           const authorTx = await openUserTransaction(world.authorA);
513:           await authorTx.query('select public.delete_meeting_note($1, 2)', [created.note_id]);
514:           const pendingSave = call(world.adminA, 'update_meeting_note', updateArgs(created.note_id, 2, {
515:             p_participant_ids: [world.participantA.appUserId],
516:           }));
517:           await waitForLockWaiter();
518:           await authorTx.query('commit');
519:           await authorTx.end();
520:           expectRpcError(await pendingSave, 'P0002', 'MEETING_NOTE_NOT_FOUND');
521:           expect(await noteState(created.note_id)).toBeUndefined();
522:           continue;
523:         }
524: 
525:         // Second session (admin, through PostgREST) loaded the same revision 2.
526:         const pending =
527:           scenario.second === 'save'
528:             ? call(world.adminA, 'update_meeting_note', updateArgs(created.note_id, 2, {
529:                 p_content: '<p>second loses</p>',
530:                 p_participant_ids: [world.participantA.appUserId],
531:               }))
532:             : call(world.adminA, 'restore_meeting_note_version', {
533:                 p_note_id: created.note_id, p_expected_revision: 2, p_version_id: created.version_id,
534:               });
535:         await waitForLockWaiter();
536:         await tx.query('commit');
537: 
538:         const loser = await pending;
539:         expectRpcError(loser, 'P0001', 'MEETING_NOTE_STALE_REVISION');
540:         expect(JSON.parse(loser.error?.details ?? '{}')).toEqual({ current_revision: 3 });
541:       } finally {
542:         await tx.end().catch(() => undefined);
543:       }
544: 
545:       const state = await noteState(created.note_id);
546:       const versions = await versionsOf(created.note_id);
547:       expect(state?.revision).toBe('3');
548:       expect(versions.map((v) => v.revision)).toEqual(['1', '2', '3']);
549:       expect(versions[2].editor_user_id).toBe(world.participantA.appUserId);
550:       if (scenario.first === 'save') {
551:         expect(state).toMatchObject({ title: `First ${scenario.name}`, content: '<p>first wins</p>' });
552:       } else {
553:         expect(state).toMatchObject({ title: `Race v1 ${scenario.name}`, content: '<p>Initial</p>' });
554:       }
555:     }
556:   });
