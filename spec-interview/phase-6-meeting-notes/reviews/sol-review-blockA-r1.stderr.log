223: export class SupabaseMeetingNoteRepository implements IMeetingNoteRepository {
224:   private readonly client: SupabaseClient;
225: 
226:   constructor(client: SupabaseClient) {
227:     this.client = client;
228:   }
229: 
230:   async findById(id: string): Promise<MeetingNote | null> {
231:     const { data, error } = await this.client
232:       .from('meeting_notes')
233:       .select(NOTE_COLUMNS)
234:       .eq('id', id)
235:       .maybeSingle<MeetingNoteRow>();
236:     if (error) throw toDbError(error);
237:     return data ? mapNote(data) : null;
238:   }
239: 
240:   async findByRoom(roomId: string, options?: PaginationOptions): Promise<PaginatedResult<MeetingNoteListItem>> {
241:     const limit = options?.limit ?? DEFAULT_PAGE_SIZE;
242:     const from = typeof options?.cursor === 'number' ? options.cursor : 0;
243:     const to = from + limit - 1;
244: 
245:     const { data, error, count } = await this.client
246:       .from('meeting_notes')
247:       .select(LIST_COLUMNS, { count: 'exact' })
248:       .eq('room_id', roomId)
249:       .order('meeting_date', { ascending: false })
250:       .order('created_at', { ascending: false })
251:       .order('id', { ascending: true })
252:       .range(from, to)
253:       .overrideTypes<MeetingNoteListRow[], { merge: false }>();
254:     if (error) throw toDbError(error);
255: 
256:     const items = (data ?? []).map(mapListItem);
257:     const nextCursor = count !== null ? (to + 1 < count ? to + 1 : null) : items.length === limit ? to + 1 : null;
258:     return { items, nextCursor, hasMore: nextCursor !== null, totalCount: count ?? undefined };
259:   }
260: 
261:   async searchNotes(input: MeetingNoteSearchInput): Promise<PaginatedResult<MeetingNoteSearchResult>> {
262:     const { data, error } = await this.client.rpc('search_meeting_notes', {
263:       p_query: input.query,
264:       p_room_id: input.spaceId,
265:       p_space_removed: input.spaceRemoved,
266:       p_meeting_from: input.meetingFrom,
267:       p_meeting_to: input.meetingTo,
268:       p_limit: input.limit,
269:       p_offset: input.offset,
270:     });
271:     if (error) throw toDbError(error);
272:     if (data !== null && !Array.isArray(data)) {
273:       throw new MeetingNoteDbError(undefined, 'search_meeting_notes returned no rows array', null);
274:     }
275: 
276:     // RETURNS TABLE (SearchRow columns); the client is untyped.
277:     const rows = (data ?? []) as SearchRow[];
278:     const items = rows.map(mapSearchRow);
279:     // total_count is the same on every row; an empty page past the end has none.
