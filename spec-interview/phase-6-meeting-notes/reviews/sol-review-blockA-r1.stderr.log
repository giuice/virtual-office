1: // Invokes the /api/meeting-notes route handlers in-process with a REAL local
2: // Supabase session (same approach as __tests__/messaging-db/route-session.ts).
3: // Only the Next.js request-cookie transport (`next/headers`) is replaced by
4: // this in-memory jar: auth.getUser(), the users.supabase_uid lookup, RLS, the
5: // note/item RPCs, and the rate-limit RPC all run against the local stack.
6: import { createServerClient } from '@supabase/ssr';
7: import { NextRequest, type NextResponse } from 'next/server';
8: import { vi } from 'vitest';
9: 
10: import { MEETING_NOTES_DB_PASSWORD } from './fixtures';
11: import { MEETING_NOTES_ANON_KEY, MEETING_NOTES_API_URL, MEETING_NOTES_SERVICE_ROLE_KEY } from './setup';
12: 
13: export interface SessionCookie {
14:   readonly name: string;
15:   readonly value: string;
16: }
17: 
18: const jar: { current: SessionCookie[] } = { current: [] };
19: 
20: /**
21:  * Replacement for `next/headers`. Register it in the test file:
22:  *   vi.mock('next/headers', async () => (await import('./route-session')).nextHeadersMock);
23:  */
24: export const nextHeadersMock = {
25:   cookies: async () => ({
26:     getAll: () => jar.current.map(({ name, value }) => ({ name, value })),
27:     set: () => undefined,
28:   }),
29: };
30: 
31: /** Points the server Supabase clients at the loopback stack (guarded in setup.ts). */
32: export function useLocalSupabaseEnv(): void {
33:   vi.stubEnv('NEXT_PUBLIC_SUPABASE_URL', MEETING_NOTES_API_URL);
34:   vi.stubEnv('NEXT_PUBLIC_SUPABASE_ANON_KEY', MEETING_NOTES_ANON_KEY);
35:   vi.stubEnv('SUPABASE_SERVICE_ROLE_KEY', MEETING_NOTES_SERVICE_ROLE_KEY);
36: }
37: 
38: /** Signs in through @supabase/ssr and returns the auth cookies it wrote. */
39: export async function signInSessionCookies(email: string): Promise<SessionCookie[]> {
40:   const written = new Map<string, string>();
41:   const client = createServerClient(MEETING_NOTES_API_URL, MEETING_NOTES_ANON_KEY, {
42:     cookies: {
43:       getAll: () => [...written].map(([name, value]) => ({ name, value })),
44:       setAll: (cookiesToSet) => {
45:         for (const { name, value } of cookiesToSet) {
46:           if (value) written.set(name, value);
47:           else written.delete(name);
48:         }
49:       },
50:     },
51:   });
52:   const { error } = await client.auth.signInWithPassword({ email, password: MEETING_NOTES_DB_PASSWORD });
53:   if (error) {
54:     throw new Error(`Failed to create SSR session for ${email}: ${error.message}`);
55:   }
56:   if (written.size === 0) {
57:     throw new Error(`No auth cookies were written for ${email}`);
58:   }
59:   return [...written].map(([name, value]) => ({ name, value }));
60: }
61: 
62: /** Runs `fn` with the given session cookies as the incoming request cookies. */
63: export async function asSession<T>(cookies: readonly SessionCookie[], fn: () => Promise<T>): Promise<T> {
64:   const previous = jar.current;
65:   jar.current = [...cookies];
66:   try {
67:     return await fn();
68:   } finally {
69:     jar.current = previous;
70:   }
71: }
72: 
73: export interface RouteCall<P> {
74:   readonly method: 'GET' | 'POST' | 'PATCH' | 'PUT' | 'DELETE';
75:   /** Path and query, e.g. `/api/meeting-notes?spaceId=...`. */
76:   readonly path: string;
77:   readonly body?: unknown;
78:   readonly params?: P;
79: }
80: 
81: export interface RouteResult {
82:   readonly status: number;
83:   // Response bodies are asserted field by field in the tests.
84:   readonly body: Record<string, unknown>;
85: }
86: 
87: type Handler<P> = (request: NextRequest, context: { params: Promise<P> }) => Promise<NextResponse>;
88: 
89: /** Invokes `handler` as `cookies`' session and returns status + JSON body. */
90: export async function callRoute<P extends Record<string, string>>(
91:   cookies: readonly SessionCookie[],
92:   handler: Handler<P>,
93:   call: RouteCall<P>,
94: ): Promise<RouteResult> {
95:   return asSession(cookies, async () => {
96:     const init: { method: string; headers?: Record<string, string>; body?: string } = { method: call.method };
97:     if (call.body !== undefined) {
98:       init.headers = { 'content-type': 'application/json' };
99:       init.body = JSON.stringify(call.body);
100:     }
101:     const request = new NextRequest(`http://localhost${call.path}`, init);
102:     const response = await handler(request, { params: Promise.resolve(call.params ?? ({} as P)) });
103:     const body = (await response.json()) as Record<string, unknown>;
104:     return { status: response.status, body };
105:   });
106: }
