1: // src/app/api/meeting-notes/[id]/items/[itemId]/route.ts
2: import { NextRequest, NextResponse } from 'next/server';
3: import { loadActionItemViews } from '@/lib/meeting-notes/note-detail';
4: import {
5:   beginMeetingNoteRequest,
6:   internalError,
7:   itemMutationErrorResponse,
8:   ok,
9:   parseWith,
10:   readJsonObject,
11:   resolveItemInNote,
12: } from '@/lib/meeting-notes/route-support';
13: import { expectedRevisionParamSchema, updateActionItemBodySchema } from '@/lib/meeting-notes/validation';
14: import type { ActionItem } from '@/types/database';
15: 
16: export const dynamic = 'force-dynamic';
17: 
18: interface RouteParams {
19:   params: Promise<{ id: string; itemId: string }>;
20: }
21: 
22: const PATH = '/api/meeting-notes/[id]/items/[itemId]';
23: 
24: /**
25:  * PATCH /api/meeting-notes/[id]/items/[itemId] — a note editor edits an item
26:  * (FR-011, BR-005). Body (full replacement): { expectedRevision, description,
27:  * assigneeId (uuid|null), dueDate ('YYYY-MM-DD'|null) }. 200 { item }; 409
28:  * { code: MEETING_NOTE_ITEM_STALE_REVISION, currentRevision, item } when stale.
29:  * An assignee who is not an editor is refused (403); a new assignee who is
30:  * not a current member is rejected (400 MEETING_NOTE_ITEM_ASSIGNEE_NOT_MEMBER).
31:  */
32: export async function PATCH(request: NextRequest, { params }: RouteParams): Promise<NextResponse> {
33:   const begun = await beginMeetingNoteRequest(PATH, 'meeting-note:item-write');
34:   if (!begun.ok) {
35:     await request.body?.cancel().catch(() => undefined);
36:     return begun.response;
37:   }
38:   const ctx = begun.value;
39: 
40:   const raw = await params;
41:   const target = await resolveItemInNote(ctx, raw.id, raw.itemId);
42:   if (!target.ok) {
43:     await request.body?.cancel().catch(() => undefined);
44:     return target.response;
45:   }
46: 
47:   const json = await readJsonObject(request, ctx);
48:   if (!json.ok) return json.response;
49:   const body = parseWith(updateActionItemBodySchema, json.value, ctx);
50:   if (!body.ok) return body.response;
51: 
52:   const companyId = ctx.dbUser.companyId;
53:   let item: ActionItem;
54:   try {
55:     item = await ctx.repository.updateActionItem({
56:       itemId: target.value.id,
57:       expectedRevision: body.value.expectedRevision,
58:       description: body.value.description,
59:       assigneeId: body.value.assigneeId,
60:       dueDate: body.value.dueDate,
61:     });
62:   } catch (error) {
63:     return itemMutationErrorResponse(error, ctx, target.value.id, companyId, 'meetingNotes.items.update');
64:   }
65: 
66:   try {
67:     const [view] = await loadActionItemViews(ctx.repository, companyId, [item]);
68:     return ok({ item: view }, ctx);
69:   } catch (error) {
70:     return internalError(error, ctx, 'meetingNotes.items.update.load');
71:   }
72: }
73: 
74: /**
75:  * DELETE /api/meeting-notes/[id]/items/[itemId]?expectedRevision=N — a note
76:  * editor deletes an item. 200 { itemId, deleted: true }.
77:  */
78: export async function DELETE(request: NextRequest, { params }: RouteParams): Promise<NextResponse> {
79:   const begun = await beginMeetingNoteRequest(PATH, 'meeting-note:item-write');
80:   if (!begun.ok) return begun.response;
81:   const ctx = begun.value;
82: 
83:   const raw = await params;
84:   const target = await resolveItemInNote(ctx, raw.id, raw.itemId);
85:   if (!target.ok) return target.response;
86: 
87:   const revision = parseWith(
88:     expectedRevisionParamSchema('MEETING_NOTE_ITEM_REVISION_REQUIRED'),
89:     request.nextUrl.searchParams.get('expectedRevision') ?? undefined,
90:     ctx
91:   );
92:   if (!revision.ok) return revision.response;
93: 
94:   try {
95:     await ctx.repository.deleteActionItem(target.value.id, revision.value);
96:     return ok({ itemId: target.value.id, deleted: true }, ctx);
97:   } catch (error) {
98:     return itemMutationErrorResponse(error, ctx, target.value.id, ctx.dbUser.companyId, 
'meetingNotes.items.delete');
99:   }
100: }
