122: begin;
123: 
124: set local lock_timeout = '5s';
125: 
126: -- Referenced tables first (the FK additions below need SHARE ROW EXCLUSIVE on
127: -- them), then the note tables, so a concurrent user/space/company deletion
128: -- either finishes before this migration or waits for it (no lock-order cycle).
129: lock table public.companies, public.spaces, public.users in share row exclusive mode;
130: lock table public.meeting_notes, public.meeting_note_action_items in access exclusive mode;
