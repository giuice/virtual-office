29:   findById(id: string): Promise<MeetingNote | null>;
30: 
31:   /** Notes of a space, newest meeting date first (no content, no transcript). */
32:   findByRoom(roomId: string, options?: PaginationOptions): Promise<PaginatedResult<MeetingNoteListItem>>;
33: 
34:   /**
35:    * Full-text search over the caller's company's notes (public.search_meeting_notes,
