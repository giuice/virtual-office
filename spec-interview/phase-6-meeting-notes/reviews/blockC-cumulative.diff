+++ b/__tests__/api/playwright/meeting-notes/note-history.spec.ts
@@ -0,0 +1,99 @@
+import { expect, test } from '../fixtures/meeting-notes';
+import { daysAgo, MEETING_NOTES_E2E_PREFIX } from '../helpers/meeting-notes-e2e';
+import { openNote } from '../helpers/meeting-notes-ui';
+
+/**
+ * AC-006, UI part (FR-008, FR-009, BR-007): a note saved three times shows
+ * three versions with who and when; a viewer who is not an editor opens a
+ * version but cannot restore it; an editor restores version 1, which creates
+ * a fourth version equal to version 1 (title, date, participants, content).
+ */
+test.describe('meeting notes — history and restore (AC-006)', () => {
+  test('lists three versions and restores version 1 as a new version', async ({
+    primaryPage,
+    secondaryPage,
+    messagingData,
+    notesWorld,
+  }) => {
+    const space = await notesWorld.createSpace('History room');
+    const primaryName = await notesWorld.displayNameOf(messagingData.primary.userId);
+    const secondaryName = await notesWorld.displayNameOf(messagingData.secondary.userId);
+    const v1Title = `${MEETING_NOTES_E2E_PREFIX} History v1 ${notesWorld.runTag}`;
+    const v1Date = daysAgo(3);
+    const noteId = await notesWorld.createNote(primaryPage, {
+      spaceId: space.id,
+      title: v1Title,
+      meetingDate: v1Date,
+      content: '<p>Version one text</p>',
+      participantIds: [messagingData.secondary.userId],
+    });
+    // Saves 2 and 3 drop the secondary from the participants (no longer an editor).
+    await notesWorld.updateNote(primaryPage, noteId, {
+      expectedRevision: 1,
+      title: `${MEETING_NOTES_E2E_PREFIX} History v2 ${notesWorld.runTag}`,
+      meetingDate: daysAgo(2),
+      content: '<p>Version two text</p>',
+      participantIds: [],
+    });
+    await notesWorld.updateNote(primaryPage, noteId, {
+      expectedRevision: 2,
+      title: `${MEETING_NOTES_E2E_PREFIX} History v3 ${notesWorld.runTag}`,
+      meetingDate: daysAgo(1),
+      content: '<p>Version three text</p>',
+      participantIds: [],
+    });
+
+    // A viewer who is not an editor: three versions with who/when, no restore.
+    const viewer = secondaryPage;
+    await openNote(viewer, noteId);
+    await viewer.getByTestId('meeting-note-history-button').click();
+    const viewerVersions = viewer.getByTestId('meeting-note-version-item');
+    await expect(viewerVersions).toHaveCount(3);
+    for (const [index, revision] of [3, 2, 1].entries()) {
+      const item = viewerVersions.nth(index);
+      await expect(item).toHaveAttribute('data-revision', String(revision));
+      await expect(item.getByTestId('meeting-note-version-meta')).toContainText(primaryName);
+      await expect(item.getByTestId('meeting-note-version-meta').locator('time')).toHaveAttribute('datetime', /\d{4}-\d{2}-\d{2}T/);
+    }
+    await viewer.locator('[data-testid="meeting-note-version-item"][data-revision="1"]').click();
+    await expect(viewer.getByTestId('meeting-note-version-title')).toHaveText(v1Title);
+    await expect(viewer.getByTestId('meeting-note-version-content')).toContainText('Version one text');
+    await expect(viewer.getByTestId('meeting-note-restore-button')).toHaveCount(0);
+
+    // The editor (author/admin) restores version 1.
+    const editor = primaryPage;
+    await openNote(editor, noteId);
+    await editor.getByTestId('meeting-note-history-button').click();
+    await expect(editor.getByTestId('meeting-note-version-item')).toHaveCount(3);
+    await editor.locator('[data-testid="meeting-note-version-item"][data-revision="1"]').click();
+    await editor.getByTestId('meeting-note-restore-button').click();
+    const confirm = editor.getByRole('alertdialog');
+    await expect(confirm).toContainText('Restore revision 1?');
+    await confirm.getByTestId('meeting-note-restore-confirm').click();
+    await expect(confirm).toBeHidden({ timeout: 30_000 });
+
+    // A fourth version now heads the list; the note shows version 1's fields.
+    const editorVersions = editor.getByTestId('meeting-note-version-item');
+    await expect(editorVersions).toHaveCount(4, { timeout: 15_000 });
+    await expect(editorVersions.nth(0)).toHaveAttribute('data-revision', '4');
+    await editor.keyboard.press('Escape');
+    const view = editor.getByTestId('meeting-note-view');
+    await expect(view).toHaveAttribute('data-revision', '4');
+    await expect(editor.getByTestId('meeting-note-title')).toHaveText(v1Title);
+    await expect(editor.getByTestId('meeting-note-content')).toContainText('Version one text');
+    await expect(editor.getByTestId('meeting-note-participant').filter({ hasText: secondaryName })).toBeVisible();
+
+    // Version 4 equals version 1 on the server.
+    const versions = await notesWorld.readVersions(editor, noteId);
+    const byRevision = new Map(versions.map((version) => [version.revision, version]));
+    const v1 = await notesWorld.readVersion(editor, noteId, byRevision.get(1)?.id ?? '');
+    const v4 = await notesWorld.readVersion(editor, noteId, byRevision.get(4)?.id ?? '');
+    expect(v4.title).toBe(v1.title);
+    expect(new Date(v4.meetingDate).getTime()).toBe(new Date(v1.meetingDate).getTime());
+    expect(v4.content).toBe(v1.content);
+    expect(v4.summary ?? null).toBe(v1.summary ?? null);
+    expect(v4.participants?.map((participant) => participant.userId)).toEqual(
+      v1.participants?.map((participant) => participant.userId),
+    );
+  });
+});
diff --git a/__tests__/api/playwright/meeting-notes/note-item-due-date-timezones.spec.ts b/__tests__/api/playwright/meeting-notes/note-item-due-date-timezones.spec.ts
new file mode 100644
index 0000000..902d7eb
--- /dev/null
+++ b/__tests__/api/playwright/meeting-notes/note-item-due-date-timezones.spec.ts
@@ -0,0 +1,103 @@
+import type { Browser, BrowserContext, Page } from '@playwright/test';
+
+import { expect, test } from '../fixtures/meeting-notes';
+import { closePlacementToasts, guardLocalSupabaseTraffic } from '../fixtures/messaging';
+import { MEETING_NOTES_E2E_PREFIX } from '../helpers/meeting-notes-e2e';
+import {
+  actionItemRow,
+  exportNoteMarkdown,
+  fillActionItemForm,
+  openNote,
+  saveActionItemForm,
+} from '../helpers/meeting-notes-ui';
+
+/**
+ * AC-009, display side (FR-011): an action item's due date is a calendar
+ * date. Saved as 2026-11-05 from a browser in America/Los_Angeles (UTC-8/-7),
+ * it is stored as 2026-11-05, shown as 2026-11-05 there and in a browser in
+ * Asia/Tokyo (UTC+9), and both browsers' Markdown exports say 2026-11-05.
+ * A Date-based conversion would move the day in at least one of these zones.
+ */
+type StorageState = Awaited<ReturnType<BrowserContext['storageState']>>;
+
+async function pageInZone(
+  browser: Browser,
+  storageState: StorageState,
+  timezoneId: string,
+): Promise<{ page: Page; close: () => Promise<void> }> {
+  const context = await browser.newContext({ storageState, timezoneId });
+  const page = await context.newPage();
+  const verifyTraffic = guardLocalSupabaseTraffic(page, timezoneId);
+  await closePlacementToasts(page);
+  return {
+    page,
+    close: async () => {
+      await context.close();
+      verifyTraffic();
+    },
+  };
+}
+
+test.describe('meeting notes — due dates across time zones (AC-009)', () => {
+  test('a due date of 2026-11-05 is saved, shown, and exported as 2026-11-05 in Los Angeles and Tokyo', async ({
+    browser,
+    primaryPage,
+    primaryStorageState,
+    notesWorld,
+  }) => {
+    const space = await notesWorld.createSpace('Due date room');
+    const tag = notesWorld.runTag;
+    const noteId = await notesWorld.createNote(primaryPage, {
+      spaceId: space.id,
+      title: `${MEETING_NOTES_E2E_PREFIX} Due date ${tag}`,
+      meetingDate: new Date(),
+      content: '<p>Due date check</p>',
+    });
+    const description = `Ship the report ${tag}`;
+
+    // Los Angeles: the editor sets the due date through the form.
+    const losAngeles = await pageInZone(browser, primaryStorageState, 'America/Los_Angeles');
+    try {
+      const page = losAngeles.page;
+      expect(await page.evaluate(() => Intl.DateTimeFormat().resolvedOptions().timeZone)).toBe('America/Los_Angeles');
+      await openNote(page, noteId);
+      await page.getByTestId('meeting-note-item-add').click();
+      await fillActionItemForm(page, { description, dueDate: '2026-11-05' });
+      await saveActionItemForm(page);
+      const row = actionItemRow(page, description);
+      await expect(row.getByTestId('meeting-note-item-due')).toHaveText('Due 2026-11-05');
+      await expect(row.locator('time')).toHaveAttribute('datetime', '2026-11-05');
+
+      const stored = await notesWorld.readNote(page, noteId);
+      expect(stored.note?.actionItems.map((item) => item.dueDate)).toEqual(['2026-11-05']);
+
+      // The edit form shows the same calendar date.
+      await row.getByTestId('meeting-note-item-edit').click();
+      await expect(page.getByTestId('meeting-note-item-form').getByLabel('Due date')).toHaveValue('2026-11-05');
+      await page.getByTestId('meeting-note-item-form').getByRole('button', { name: 'Cancel' }).click();
+
+      const file = await exportNoteMarkdown(page);
+      expect(file.text).toContain('  - Due date: 2026-11-05\n');
+    } finally {
+      await losAngeles.close();
+    }
+
+    // Tokyo: the same item reads and exports as the same day.
+    const tokyo = await pageInZone(browser, primaryStorageState, 'Asia/Tokyo');
+    try {
+      const page = tokyo.page;
+      expect(await page.evaluate(() => Intl.DateTimeFormat().resolvedOptions().timeZone)).toBe('Asia/Tokyo');
+      await openNote(page, noteId);
+      const row = actionItemRow(page, description);
+      await expect(row.getByTestId('meeting-note-item-due')).toHaveText('Due 2026-11-05');
+      await row.getByTestId('meeting-note-item-edit').click();
+      await expect(page.getByTestId('meeting-note-item-form').getByLabel('Due date')).toHaveValue('2026-11-05');
+      await page.getByTestId('meeting-note-item-form').getByRole('button', { name: 'Cancel' }).click();
+
+      const file = await exportNoteMarkdown(page);
+      expect(file.text).toContain('  - Due date: 2026-11-05\n');
+    } finally {
+      await tokyo.close();
+    }
+  });
+});
diff --git a/__tests__/api/playwright/meeting-notes/note-offline-save.spec.ts b/__tests__/api/playwright/meeting-notes/note-offline-save.spec.ts
new file mode 100644
index 0000000..9e78f5d
--- /dev/null
+++ b/__tests__/api/playwright/meeting-notes/note-offline-save.spec.ts
@@ -0,0 +1,98 @@
+import { expect, test } from '../fixtures/meeting-notes';
+import { daysAgo, localDay, MEETING_NOTES_E2E_PREFIX } from '../helpers/meeting-notes-e2e';
+import { addParticipant, noteEditor, openNote, replaceEditorText } from '../helpers/meeting-notes-ui';
+
+/**
+ * Block B review B-3 (FR-006, FR-007): a save that cannot reach the server
+ * shows an error and keeps every edited field; a later failed refresh of the
+ * note (network still failing after reconnecting) is shown next to the editor
+ * and never replaces it; once the network works, saving stores the edits.
+ *
+ * Real app, routes, and local database. Network shaping only: the browser is
+ * taken offline (context.setOffline), and after reconnecting the note's
+ * refresh requests are failed in transit (route.abort) — the server is never
+ * replaced.
+ */
+test.describe('meeting notes — save while offline (B-3)', () => {
+  test('an offline save keeps the draft; a failed refresh does not unmount the editor; the retry saves it', async ({
+    primaryPage,
+    messagingData,
+    notesWorld,
+  }) => {
+    const space = await notesWorld.createSpace('Offline room');
+    const title = `${MEETING_NOTES_E2E_PREFIX} Offline ${notesWorld.runTag}`;
+    const noteId = await notesWorld.createNote(primaryPage, {
+      spaceId: space.id,
+      title,
+      meetingDate: daysAgo(5),
+      content: '<p>Original offline text</p>',
+    });
+    const secondaryName = await notesWorld.displayNameOf(messagingData.secondary.userId);
+
+    const page = primaryPage;
+    const context = page.context();
+    const view = await openNote(page, noteId);
+    await expect(view).toHaveAttribute('data-revision', '1');
+    await page.getByTestId('meeting-note-edit-button').click();
+    await noteEditor(page);
+
+    // Edit every field.
+    const newTitle = `${title} edited`;
+    const newText = `Offline decision ${notesWorld.runTag}`;
+    const newDay = localDay(daysAgo(2));
+    const form = page.getByTestId('meeting-note-form');
+    await form.getByLabel('Title').fill(newTitle);
+    await form.getByLabel('Meeting date').fill(newDay);
+    await addParticipant(page, secondaryName);
+    await replaceEditorText(page, newText);
+
+    const expectDraftIntact = async () => {
+      await expect(page.getByTestId('meeting-note-edit-panel')).toBeVisible();
+      await expect(form.getByLabel('Title')).toHaveValue(newTitle);
+      await expect(form.getByLabel('Meeting date')).toHaveValue(newDay);
+      await expect(page.getByTestId('meeting-note-participant-chip').filter({ hasText: secondaryName })).toBeVisible();
+      await expect(await noteEditor(page)).toContainText(newText);
+    };
+
+    // Offline: the save fails at once with a network error; nothing is lost.
+    await context.setOffline(true);
+    await page.getByTestId('meeting-note-submit').click();
+    await expect(form.getByRole('alert').filter({ hasText: 'Could not reach the server' })).toBeVisible({
+      timeout: 15_000,
+    });
+    await expectDraftIntact();
+    expect((await notesWorld.readNote(page, noteId)).note?.revision).toBe(1);
+
+    // Back online with the note's refreshes still failing in transit: once the
+    // cached note is stale (15 s), reconnecting refetches it and every attempt
+    // (with retries) fails. The error shows beside the editor; the draft stays.
+    let failedRefreshes = 0;
+    const isNoteRead = (url: URL) => url.pathname === `/api/meeting-notes/${noteId}`;
+    await page.route(isNoteRead, async (route) => {
+      if (route.request().method() !== 'GET') return route.continue();
+      failedRefreshes += 1;
+      return route.abort('internetdisconnected');
+    });
+    await page.waitForTimeout(16_000);
+    await context.setOffline(false);
+    await expect(page.getByTestId('meeting-note-refresh-error')).toBeVisible({ timeout: 30_000 });
+    expect(failedRefreshes).toBeGreaterThan(0);
+    await expectDraftIntact();
+
+    // The network works again: saving stores every edit.
+    await page.unroute(isNoteRead);
+    await page.getByTestId('meeting-note-submit').click();
+    const saved = page.getByTestId('meeting-note-view');
+    await expect(saved).toBeVisible({ timeout: 30_000 });
+    await expect(saved).toHaveAttribute('data-revision', '2');
+    await expect(page.getByTestId('meeting-note-title')).toHaveText(newTitle);
+    await expect(page.getByTestId('meeting-note-content')).toContainText(newText);
+
+    const stored = await notesWorld.readNote(page, noteId);
+    expect(stored.note?.revision).toBe(2);
+    expect(stored.note?.title).toBe(newTitle);
+    expect(stored.note?.content).toContain(newText);
+    expect(stored.note?.participants.map((participant) => participant.userId)).toEqual([messagingData.secondary.userId]);
+    expect(localDay(new Date(stored.note?.meetingDate ?? ''))).toBe(newDay);
+  });
+});
