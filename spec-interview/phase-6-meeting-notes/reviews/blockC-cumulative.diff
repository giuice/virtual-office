+    {
+      id: 'claude-sonnet-5-5',
+      label: 'Claude Sonnet 5.5',
+      contextWindowTokens: 1_000_000,
+      maxOutputTokens: 128_000,
+      reasoningLevels: ANTHROPIC_EFFORTS,
+      defaultReasoningLevel: 'high',
+      docUrl: ANTHROPIC_MODELS_DOC,
