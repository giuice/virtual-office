+// src/components/meeting-notes/MeetingNoteExcerpt.tsx
+// A search excerpt (FR-026). Segments are plain text from the server; matches
+// are wrapped in <mark> elements created here. Never rendered as HTML.
+import type { MeetingNoteSearchExcerpt, MeetingNoteSearchField } from '@/types/meeting-notes';
+
+const FIELD_LABELS: Record<MeetingNoteSearchField, string> = {
+  title: 'Title',
+  content: 'Notes',
+  summary: 'Summary',
+  action_item: 'Action item',
+};
+
+export function MeetingNoteExcerpt({ excerpt }: { excerpt: MeetingNoteSearchExcerpt }) {
+  return (
+    <p className="mt-2 line-clamp-3 text-sm text-muted-foreground" data-testid="meeting-note-excerpt">
+      <span className="mr-1.5 text-[11px] font-semibold uppercase tracking-wide text-foreground/70">
+        {FIELD_LABELS[excerpt.field] ?? 'Match'}:
+      </span>
+      {excerpt.segments.map((segment, index) =>
+        segment.highlighted ? (
+          <mark key={index} className="rounded-sm bg-[var(--vo-cyan-soft)] px-0.5 text-foreground">
+            {segment.text}
+          </mark>
+        ) : (
+          <span key={index}>{segment.text}</span>
+        )
+      )}
+    </p>
+  );
+}
diff --git a/src/components/meeting-notes/MeetingNoteExportControls.tsx b/src/components/meeting-notes/MeetingNoteExportControls.tsx
new file mode 100644
index 0000000..a18f20e
--- /dev/null
+++ b/src/components/meeting-notes/MeetingNoteExportControls.tsx
@@ -0,0 +1,101 @@
+// src/components/meeting-notes/MeetingNoteExportControls.tsx
+// "Export Markdown" for any viewer (FR-027, AC-019): downloads the note as a
+// .md file built by the server (user and AI text escaped there). "Include
+// transcript" is offered only when the note has one. The meeting date is
+// written as a calendar day in the viewer's time zone, like the view shows it.
+// The download is scope-fenced (useMeetingNotesScopedMutation): leaving the
+// note aborts it, and a response that arrives after sign-out or an account
+// switch is dropped — never saved as a file in another session.
+'use client';
+
+import { Download, Loader2 } from 'lucide-react';
+import { useId, useState } from 'react';
+
+import { Button } from '@/components/ui/button';
+import { useMeetingNotesScopedMutation } from '@/hooks/mutations/useMeetingNotesScopedMutation';
+import { fetchMeetingNoteMarkdown, type MeetingNoteMarkdownFile } from '@/lib/meeting-notes/client-api';
+import { describeMeetingNoteError } from '@/lib/meeting-notes/form-errors';
+import type { MeetingNoteDetail } from '@/types/meeting-notes';
+
+export interface MeetingNoteExportControlsProps {
+  note: Pick<MeetingNoteDetail, 'id' | 'hasTranscript'>;
+}
+
+function viewerTimeZone(): string {
+  try {
+    return Intl.DateTimeFormat().resolvedOptions().timeZone || 'UTC';
+  } catch {
+    return 'UTC';
+  }
+}
+
+/** Hands a downloaded file to the browser. */
+function saveFile(blob: Blob, filename: string): void {
+  const url = URL.createObjectURL(blob);
+  const anchor = document.createElement('a');
+  anchor.href = url;
+  anchor.download = filename;
+  anchor.rel = 'noopener';
+  anchor.style.display = 'none';
+  document.body.appendChild(anchor);
+  anchor.click();
+  anchor.remove();
+  // Give the browser time to start the download before the URL goes away.
+  window.setTimeout(() => URL.revokeObjectURL(url), 30_000);
+}
+
+export function MeetingNoteExportControls({ note }: MeetingNoteExportControlsProps) {
+  const checkboxId = useId();
+  const [includeTranscript, setIncludeTranscript] = useState(false);
+  const exportFile = useMeetingNotesScopedMutation<MeetingNoteMarkdownFile, boolean>({
+    name: 'export-note',
+    abortOnUnmount: true,
+    // The file (which may hold the transcript) leaves the cache once unobserved.
+    gcTime: 0,
+    mutationFn: (withTranscript, { signal }) =>
+      fetchMeetingNoteMarkdown(note.id, { includeTranscript: withTranscript, timeZone: viewerTimeZone() }, signal),
+    onSuccess: (file) => saveFile(file.blob, file.filename),
+  });
+
+  return (
+    <div className="flex flex-col items-end gap-1" data-testid="meeting-note-export">
+      <div className="flex flex-wrap items-center gap-2">
+        {note.hasTranscript ? (
+          <label htmlFor={checkboxId} className="flex cursor-pointer items-center gap-1.5 text-xs text-muted-foreground">
+            <input
+              id={checkboxId}
+              type="checkbox"
+              className="size-3.5 accent-primary"
+              checked={includeTranscript}
+              disabled={exportFile.isPending}
+              onChange={(event) => setIncludeTranscript(event.target.checked)}
+              data-testid="meeting-note-export-include-transcript"
+            />
+            Include transcript
+          </label>
+        ) : null}
+        <Button
+          type="button"
+          size="sm"
+          variant="outline"
+          className="gap-1.5"
+          disabled={exportFile.isPending}
+          onClick={() => exportFile.mutate(note.hasTranscript && includeTranscript)}
+          data-testid="meeting-note-export-button"
+        >
+          {exportFile.isPending ? (
+            <Loader2 className="size-4 animate-spin" aria-hidden="true" />
+          ) : (
+            <Download className="size-4" aria-hidden="true" />
+          )}
+          Export Markdown
+        </Button>
+      </div>
+      {exportFile.isError ? (
+        <p className="text-xs text-destructive" role="alert" data-testid="meeting-note-export-error">
+          The export failed. {describeMeetingNoteError(exportFile.error)}
+        </p>
+      ) : null}
+    </div>
+  );
+}
diff --git a/src/components/meeting-notes/MeetingNoteForm.tsx b/src/components/meeting-notes/MeetingNoteForm.tsx
new file mode 100644
index 0000000..51af5eb
--- /dev/null
+++ b/src/components/meeting-notes/MeetingNoteForm.tsx
@@ -0,0 +1,232 @@
+// src/components/meeting-notes/MeetingNoteForm.tsx
+// Create / edit form of a meeting note (FR-001, FR-002, FR-030): title
+// (1–200), meeting date (a local day), participants (≤ 50, current members;
+// former members already listed may stay), and rich text (≤ 100,000
+// characters after sanitization). Mirrors the route limits and places the
+// route's 400 codes next to their field; the route stays the authority.
+'use client';
+
+import { Loader2 } from 'lucide-react';
+import { useId, useMemo, useRef, useState, type FormEvent, type ReactNode } from 'react';
+
+import { Button } from '@/components/ui/button';
+import { Input } from '@/components/ui/input';
+import { Label } from '@/components/ui/label';
+import { useCompany } from '@/contexts/CompanyContext';
+import type { MeetingNoteFieldsPayload } from '@/lib/meeting-notes/client-api';
+import { sanitizeMeetingNoteHtml } from '@/lib/meeting-notes/content-sanitizer';
+import { describeMeetingNoteError, meetingNoteFieldError, type MeetingNoteFormField } from '@/lib/meeting-notes/form-errors';
+import { localDayOf, meetingDateFromLocalDay } from '@/lib/meeting-notes/period';
+import { codePointLength, MEETING_NOTE_LIMITS } from '@/lib/meeting-notes/validation';
+import type { MeetingNoteParticipant } from '@/types/meeting-notes';
+import { MeetingNoteParticipantPicker } from './MeetingNoteParticipantPicker';
+import { MeetingNoteRichTextEditorLazy } from './MeetingNoteRichTextEditorLazy';
+
+export interface MeetingNoteFormInitialValues {
+  title: string;
+  /** ISO instant; null = today. */
+  meetingDate: string | null;
+  participants: MeetingNoteParticipant[];
+  /** Saved (sanitized) HTML. */
+  content: string;
+}
+
+export interface MeetingNoteFormProps {
+  initial: MeetingNoteFormInitialValues;
+  submitLabel: string;
+  submitting: boolean;
+  /** The last failed save, shown next to its field or above the buttons. */
+  submitError: unknown;
+  onSubmit: (fields: MeetingNoteFieldsPayload) => void;
+  onCancel: () => void;
+  /** Shown above the fields (e.g. the space the note belongs to). */
+  header?: ReactNode;
+}
+
+type FieldErrors = Partial<Record<MeetingNoteFormField, string>>;
+
+function todayLocalDay(): string {
+  return localDayOf(new Date().toISOString());
+}
+
+export function MeetingNoteForm({
+  initial,
+  submitLabel,
+  submitting,
+  submitError,
+  onSubmit,
+  onCancel,
+  header,
+}: MeetingNoteFormProps) {
+  const ids = {
+    title: useId(),
+    titleError: useId(),
+    date: useId(),
+    dateError: useId(),
+    participantsLabel: useId(),
+    participantsError: useId(),
+    contentLabel: useId(),
+    contentError: useId(),
+    editor: useId(),
+  };
+  const { company, companyUsers } = useCompany();
+  const members = useMemo(
+    () => companyUsers.filter((user) => company !== null && user.companyId === company.id),
+    [company, companyUsers]
+  );
+
+  const initialDay = useMemo(() => (initial.meetingDate ? localDayOf(initial.meetingDate) : todayLocalDay()), [initial.meetingDate]);
+  const [title, setTitle] = useState(initial.title);
+  const [day, setDay] = useState(initialDay);
+  const [participants, setParticipants] = useState<MeetingNoteParticipant[]>(initial.participants);
+  const contentRef = useRef(initial.content);
+  const [clientErrors, setClientErrors] = useState<FieldErrors>({});
+  const [lastSubmitError, setLastSubmitError] = useState<unknown>(null);
+
+  // A new server error replaces the client-side ones until the next submit.
+  const serverField = submitError && submitError !== lastSubmitError ? meetingNoteFieldError(submitError) : null;
+  const errors: FieldErrors = serverField ? { ...clientErrors, [serverField.field]: serverField.message } : clientErrors;
+  const formError =
+    submitError && submitError !== lastSubmitError && !serverField ? describeMeetingNoteError(submitError) : null;
+
+  const focusField = (field: MeetingNoteFormField) => {
+    const target =
+      field === 'title' ? ids.title : field === 'date' ? ids.date : field === 'content' ? ids.editor : null;
+    if (target) document.getElementById(target)?.focus();
+  };
+
+  const validate = (): { fields: MeetingNoteFieldsPayload | null; errors: FieldErrors } => {
+    const next: FieldErrors = {};
+    const trimmedTitle = title.trim();
+    const titleLength = codePointLength(trimmedTitle);
+    if (titleLength < 1 || titleLength > MEETING_NOTE_LIMITS.titleMaxChars) {
+      next.title = titleLength < 1 ? 'Enter a title.' : 'The title can have at most 200 characters.';
+    }
+    const meetingDate =
+      day === initialDay && initial.meetingDate ? initial.meetingDate : meetingDateFromLocalDay(day);
+    if (!meetingDate) next.date = 'Choose the meeting date.';
+    if (participants.length > MEETING_NOTE_LIMITS.maxParticipants) {
+      next.participants = 'A note can have at most 50 participants.';
+    }
+    const content = contentRef.current;
+    if (codePointLength(sanitizeMeetingNoteHtml(content)) > MEETING_NOTE_LIMITS.contentMaxChars) {
+      next.content = 'The notes are too long (at most 100,000 characters).';
+    }
+    if (Object.keys(next).length > 0 || !meetingDate) return { fields: null, errors: next };
+    return {
+      fields: {
+        title: trimmedTitle,
+        meetingDate,
+        content,
+        participantIds: participants.map((participant) => participant.userId),
+      },
+      errors: next,
+    };
+  };
+
+  const handleSubmit = (event: FormEvent<HTMLFormElement>) => {
+    event.preventDefault();
+    if (submitting) return;
+    const result = validate();
+    setClientErrors(result.errors);
+    setLastSubmitError(submitError);
+    if (!result.fields) {
+      const first = (['title', 'date', 'participants', 'content'] as const).find((field) => result.errors[field]);
+      if (first) focusField(first);
+      return;
+    }
+    onSubmit(result.fields);
+  };
+
+  const fieldError = (id: string, message: string | undefined) =>
+    message ? (
+      <p id={id} className="text-xs text-destructive" role="alert">
+        {message}
+      </p>
+    ) : null;
+
+  return (
+    <form className="flex flex-col gap-5" noValidate onSubmit={handleSubmit} aria-busy={submitting} data-testid="meeting-note-form">
+      {header}
+
+      <div className="flex flex-col gap-1.5">
+        <Label htmlFor={ids.title}>Title</Label>
+        <Input
+          id={ids.title}
+          value={title}
+          required
+          aria-invalid={errors.title ? 'true' : 'false'}
+          aria-describedby={errors.title ? ids.titleError : undefined}
+          onChange={(event) => setTitle(event.target.value)}
+          disabled={submitting}
+        />
+        {fieldError(ids.titleError, errors.title)}
+      </div>
+
+      <div className="flex flex-col gap-1.5">
+        <Label htmlFor={ids.date}>Meeting date</Label>
+        <Input
+          id={ids.date}
+          type="date"
+          className="w-48"
+          value={day}
+          required
+          aria-invalid={errors.date ? 'true' : 'false'}
+          aria-describedby={errors.date ? ids.dateError : undefined}
+          onChange={(event) => setDay(event.target.value)}
+          disabled={submitting}
+        />
+        {fieldError(ids.dateError, errors.date)}
+      </div>
+
+      <div className="flex flex-col gap-1.5">
+        <span id={ids.participantsLabel} className="text-sm font-medium leading-none">
+          Participants
+        </span>
+        <MeetingNoteParticipantPicker
+          labelId={ids.participantsLabel}
+          describedById={errors.participants ? ids.participantsError : undefined}
+          value={participants}
+          members={members}
+          disabled={submitting}
+          onChange={setParticipants}
+        />
+        {fieldError(ids.participantsError, errors.participants)}
+      </div>
+
+      <div className="flex flex-col gap-1.5">
+        <span id={ids.contentLabel} className="text-sm font-medium leading-none">
+          Notes
+        </span>
+        <MeetingNoteRichTextEditorLazy
+          id={ids.editor}
+          labelId={ids.contentLabel}
+          describedById={errors.content ? ids.contentError : undefined}
+          initialContent={initial.content}
+          invalid={Boolean(errors.content)}
+          disabled={submitting}
+          onChange={(html) => {
+            contentRef.current = html;
+          }}
+        />
+        {fieldError(ids.contentError, errors.content)}
+      </div>
+
+      {formError ? (
+        <p className="rounded-md border border-destructive/40 bg-destructive/10 px-3 py-2 text-sm text-destructive" role="alert">
+          {formError}
+        </p>
+      ) : null}
+
+      <div className="flex items-center justify-end gap-2">
+        <Button type="button" variant="ghost" onClick={onCancel} disabled={submitting}>
+          Cancel
+        </Button>
+        <Button type="submit" disabled={submitting} data-testid="meeting-note-submit">
+          {submitting ? <Loader2 className="mr-2 size-4 animate-spin" aria-hidden="true" /> : null}
+          {submitLabel}
+        </Button>
+      </div>
+    </form>
+  );
+}
diff --git a/src/components/meeting-notes/MeetingNoteHistoryDialog.tsx b/src/components/meeting-notes/MeetingNoteHistoryDialog.tsx
new file mode 100644
index 0000000..b076ac3
--- /dev/null
+++ b/src/components/meeting-notes/MeetingNoteHistoryDialog.tsx
@@ -0,0 +1,269 @@
+// src/components/meeting-notes/MeetingNoteHistoryDialog.tsx
+// Version history (FR-008, FR-009, AC-006, J4): every viewer lists the
+// versions (who and when) and opens one read-only; an editor restores it
+// after confirmation, which the database records as a new version against
+// the note revision captured when "Restore this version" was clicked — never
+// a revision a background refetch brought in meanwhile (block B review B-4);
+// a stale restore gets the conflict warning and must be started again.
+// Historical participants who are no longer members show "Former member"
+// (FR-030; the version route reports current membership).
+'use client';
+
+import { ArrowLeft, History, Loader2, RotateCcw } from 'lucide-react';
+import { useState } from 'react';
+
+import {
+  AlertDialog,
+  AlertDialogAction,
+  AlertDialogCancel,
+  AlertDialogContent,
+  AlertDialogDescription,
+  AlertDialogFooter,
+  AlertDialogHeader,
+  AlertDialogTitle,
+} from '@/components/ui/alert-dialog';
+import { Badge } from '@/components/ui/badge';
+import { Button } from '@/components/ui/button';
+import {
+  Dialog,
+  DialogContent,
+  DialogDescription,
+  DialogHeader,
+  DialogTitle,
+  DialogTrigger,
+} from '@/components/ui/dialog';
+import { useMeetingNoteVersion, useMeetingNoteVersions } from '@/hooks/queries/useMeetingNote';
+import { useRestoreMeetingNoteVersion } from '@/hooks/mutations/useMeetingNoteMutations';
+import { useNotification } from '@/hooks/useNotification';
+import { MeetingNoteConflictError } from '@/lib/meeting-notes/client-api';
+import { formatMeetingDate, formatMeetingNoteTimestamp } from '@/lib/meeting-notes/format';
+import { describeMeetingNoteError } from '@/lib/meeting-notes/form-errors';
+import type { MeetingNoteDetail, MeetingNoteVersionSummary } from '@/types/meeting-notes';
+import { MeetingNoteConflictDialog } from './MeetingNoteConflictDialog';
+import { MeetingNoteContent } from './MeetingNoteContent';
+
+export interface MeetingNoteHistoryDialogProps {
+  /** The note as currently cached; its revision is the restore's base. */
+  note: MeetingNoteDetail;
+}
+
+export function MeetingNoteHistoryDialog({ note }: MeetingNoteHistoryDialogProps) {
+  const [open, setOpen] = useState(false);
+  const [selected, setSelected] = useState<MeetingNoteVersionSummary | null>(null);
+  /** The restore being confirmed: the version and the note revision it applies to. */
+  const [pendingRestore, setPendingRestore] = useState<{ versionId: string; versionRevision: number; expectedRevision: number } | null>(null);
+  const [conflict, setConflict] = useState<MeetingNoteConflictError | null>(null);
+  const versions = useMeetingNoteVersions(note.id, open);
+  const version = useMeetingNoteVersion(note.id, open && selected ? selected.id : null);
+  const restore = useRestoreMeetingNoteVersion();
+  const { showSuccess } = useNotification();
+
+  const onOpenChange = (next: boolean) => {
+    setOpen(next);
+    if (!next) {
+      setSelected(null);
+      restore.reset();
+    }
+  };
+
+  const confirmRestore = () => {
+    if (!pendingRestore) return;
+    const { versionId, versionRevision, expectedRevision } = pendingRestore;
+    restore.mutate(
+      { noteId: note.id, expectedRevision, versionId },
+      {
+        onSuccess: (saved) => {
+          setPendingRestore(null);
+          setSelected(null);
+          showSuccess({ description: `Revision ${versionRevision} restored as revision ${saved.revision}.` });
+        },
+        onError: (error) => {
+          setPendingRestore(null);
+          if (error instanceof MeetingNoteConflictError) setConflict(error);
+        },
+      }
+    );
+  };
+
+  const restoreError =
+    restore.error && !(restore.error instanceof MeetingNoteConflictError) ? describeMeetingNoteError(restore.error) : null;
+  const items = versions.data?.versions ?? [];
+
+  return (
+    <>
+      <Dialog open={open} onOpenChange={onOpenChange}>
+        <DialogTrigger asChild>
+          <Button type="button" variant="outline" size="sm" className="gap-1.5" data-testid="meeting-note-history-button">
+            <History className="size-4" aria-hidden="true" />
+            History
+          </Button>
+        </DialogTrigger>
+        <DialogContent className="max-h-[90vh] overflow-y-auto sm:max-w-3xl" data-testid="meeting-note-history-dialog">
+          <DialogHeader>
+            <DialogTitle>Version history</DialogTitle>
+            <DialogDescription>
+              Every saved change is kept as a version. Versions cannot be changed.
+            </DialogDescription>
+          </DialogHeader>
+
+          {selected ? (
+            <div className="flex flex-col gap-3" data-testid="meeting-note-version-view">
+              <Button type="button" variant="ghost" size="sm" className="-ml-2 h-8 w-fit gap-1.5" onClick={() => setSelected(null)}>
+                <ArrowLeft className="size-4" aria-hidden="true" />
+                All versions
+              </Button>
+              <div className="flex flex-wrap items-center gap-2">
+                <Badge variant="outline">Revision {selected.revision}</Badge>
+                <span className="text-sm text-muted-foreground">
+                  {selected.editorName} · {formatMeetingNoteTimestamp(selected.createdAt)}
+                </span>
+                {selected.revision === note.revision ? <Badge>Current</Badge> : null}
+              </div>
+              {version.isPending ? (
+                <p className="flex items-center gap-2 text-sm text-muted-foreground" role="status">
+                  <Loader2 className="size-4 animate-spin" aria-hidden="true" />
+                  Loading version…
+                </p>
+              ) : version.isError ? (
+                <p className="text-sm text-destructive" role="alert">
+                  {describeMeetingNoteError(version.error)}
+                </p>
+              ) : (
+                <div className="flex flex-col gap-3 rounded-lg border p-4">
+                  <h3 className="break-words text-lg font-semibold" data-testid="meeting-note-version-title">
+                    {version.data.title}
+                  </h3>
+                  <p className="text-xs text-muted-foreground">
+                    <time dateTime={version.data.meetingDate}>{formatMeetingDate(version.data.meetingDate)}</time>
+                    <span aria-hidden="true"> · </span>
+                    {version.data.participants.length === 0
+                      ? 'No participants'
+                      : version.data.participants.map((participant, index) => (
+                          <span
+                            key={participant.userId}
+                            data-testid="meeting-note-version-participant"
+                            data-former-member={participant.isCurrentMember ? undefined : 'true'}
+                          >
+                            {index > 0 ? ', ' : null}
+                            {participant.displayName}
+                            {participant.isCurrentMember ? null : ' (Former member)'}
+                          </span>
+                        ))}
+                  </p>
+                  <MeetingNoteContent html={version.data.content} testId="meeting-note-version-content" />
+                  {version.data.summary ? (
+                    <div>
+                      <h4 className="text-sm font-semibold">Summary</h4>
+                      <p className="whitespace-pre-wrap break-words text-sm">{version.data.summary}</p>
+                    </div>
+                  ) : null}
+                </div>
+              )}
+              {restoreError ? (
+                <p className="text-sm text-destructive" role="alert">
+                  {restoreError}
+                </p>
+              ) : null}
+              {note.rights.canEdit && selected.revision !== note.revision && version.isSuccess ? (
+                <Button
+                  type="button"
+                  className="w-fit gap-1.5"
+                  onClick={() =>
+                    setPendingRestore({ versionId: selected.id, versionRevision: selected.revision, expectedRevision: note.revision })
+                  }
+                  disabled={restore.isPending}
+                  data-testid="meeting-note-restore-button"
+                >
+                  <RotateCcw className="size-4" aria-hidden="true" />
+                  Restore this version
+                </Button>
+              ) : null}
+            </div>
+          ) : versions.isPending ? (
+            <p className="flex items-center gap-2 text-sm text-muted-foreground" role="status">
+              <Loader2 className="size-4 animate-spin" aria-hidden="true" />
+              Loading history…
+            </p>
+          ) : versions.isError ? (
+            <div className="flex flex-col gap-2" role="alert">
+              <p className="text-sm text-destructive">{describeMeetingNoteError(versions.error)}</p>
+              <Button type="button" size="sm" variant="outline" className="w-fit" onClick={() => void versions.refetch()}>
+                Try again
+              </Button>
+            </div>
+          ) : (
+            <ol className="flex flex-col gap-2" aria-label="Versions, newest first" data-testid="meeting-note-version-list">
+              {items.map((item) => (
+                <li key={item.id}>
+                  <button
+                    type="button"
+                    className="flex w-full flex-wrap items-center justify-between gap-2 rounded-lg border border-[var(--vo-line-soft)] p-3 text-left transition-colors hover:bg-[var(--vo-hover-bg)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
+                    onClick={() => {
+                      restore.reset();
+                      setSelected(item);
+                    }}
+                    data-testid="meeting-note-version-item"
+                    data-revision={item.revision}
+                  >
+                    <span className="min-w-0">
+                      <span className="block truncate text-sm font-medium">{item.title}</span>
+                      <span className="block text-xs text-muted-foreground" data-testid="meeting-note-version-meta">
+                        {item.editorName} · <time dateTime={item.createdAt}>{formatMeetingNoteTimestamp(item.createdAt)}</time>
+                      </span>
+                    </span>
+                    <span className="flex items-center gap-2">
+                      {item.revision === note.revision ? <Badge>Current</Badge> : null}
+                      <Badge variant="outline">Revision {item.revision}</Badge>
+                    </span>
+                  </button>
+                </li>
+              ))}
+            </ol>
+          )}
+        </DialogContent>
+      </Dialog>
+
+      <AlertDialog
+        open={pendingRestore !== null}
+        onOpenChange={(next) => {
+          if (!next && !restore.isPending) setPendingRestore(null);
+        }}
+      >
+        <AlertDialogContent>
+          <AlertDialogHeader>
+            <AlertDialogTitle>Restore revision {pendingRestore?.versionRevision}?</AlertDialogTitle>
+            <AlertDialogDescription>
+              The note (now at revision {pendingRestore?.expectedRevision}) gets this version&apos;s title, date,
+              participants, content, and summary as a new version. Action items and the transcript do not change.
+              Earlier versions stay in the history.
+            </AlertDialogDescription>
+          </AlertDialogHeader>
+          <AlertDialogFooter>
+            <AlertDialogCancel disabled={restore.isPending}>Cancel</AlertDialogCancel>
+            <AlertDialogAction
+              disabled={restore.isPending}
+              onClick={(event) => {
+                event.preventDefault();
+                confirmRestore();
+              }}
+              data-testid="meeting-note-restore-confirm"
+            >
+              {restore.isPending ? 'Restoring…' : 'Restore'}
+            </AlertDialogAction>
+          </AlertDialogFooter>
+        </AlertDialogContent>
+      </AlertDialog>
+
+      {conflict ? (
+        <MeetingNoteConflictDialog
+          open
+          onOpenChange={(next) => {
+            if (!next) setConflict(null);
+          }}
+          newer={conflict.note}
+          mine={null}
+        />
+      ) : null}
+    </>
+  );
+}
