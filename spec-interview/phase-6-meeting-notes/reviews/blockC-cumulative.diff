+      () => callRoute([], updateItem, {
+        method: 'PATCH',
+        path: `/api/meeting-notes/${id}/items/${itemId}`,
+        body: {},
+        params: { id, itemId },
+      }),
+      () => callRoute([], deleteItem, {
+        method: 'DELETE',
+        path: `/api/meeting-notes/${id}/items/${itemId}?expectedRevision=1`,
+        params: { id, itemId },
