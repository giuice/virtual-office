+    expect(md).toContain('Plain **bold** and *italic* with [a link](https://example.com/doc)');
+    expect(md).toContain('- First bullet');
+    expect(md).toContain('1. First step');
+    expect(md).toContain('- [x] Done task\n- [ ] Open task');
