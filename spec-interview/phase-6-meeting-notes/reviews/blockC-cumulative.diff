index 0000000..eebe7bc
--- /dev/null
+++ b/src/components/meeting-notes/MeetingNoteConflictDialog.tsx
@@ -0,0 +1,135 @@
+// src/components/meeting-notes/MeetingNoteConflictDialog.tsx
+// Conflict warning (FR-007, AC-005): someone else changed the note first.
+// Shows the newer state the route returned and, for a rejected save, the
+// user's own unsaved text so it can be copied — nothing is overwritten and
+// nothing is dropped silently. The user decides when to load the newer version.
+'use client';
+
+import { Check, Copy } from 'lucide-react';
+import { useMemo, useState } from 'react';
+
+import { Badge } from '@/components/ui/badge';
+import { Button } from '@/components/ui/button';
+import {
+  Dialog,
+  DialogContent,
+  DialogDescription,
+  DialogFooter,
+  DialogHeader,
+  DialogTitle,
+} from '@/components/ui/dialog';
+import type { MeetingNoteFieldsPayload } from '@/lib/meeting-notes/client-api';
+import { formatMeetingDate } from '@/lib/meeting-notes/format';
+import { meetingNoteHtmlToText } from '@/lib/meeting-notes/html-text';
+import type { MeetingNoteDetail } from '@/types/meeting-notes';
+import { MeetingNoteContent } from './MeetingNoteContent';
+
+export interface MeetingNoteConflictDialogProps {
+  open: boolean;
+  onOpenChange: (open: boolean) => void;
+  /** The note as it is now (from the 409 response). */
+  newer: MeetingNoteDetail;
+  /** What the user tried to save; null for a restore or delete. */
+  mine: MeetingNoteFieldsPayload | null;
+  /** Replace the form with the newer version (save conflicts only). */
+  onLoadNewer?: () => void;
+}
+
+export function MeetingNoteConflictDialog({ open, onOpenChange, newer, mine, onLoadNewer }: MeetingNoteConflictDialogProps) {
+  const [copied, setCopied] = useState(false);
+  const mineText = useMemo(
+    () => (mine ? `${mine.title}\n\n${meetingNoteHtmlToText(mine.content)}`.trim() : ''),
+    [mine]
+  );
+
+  const copy = async () => {
+    try {
+      await navigator.clipboard.writeText(mineText);
+      setCopied(true);
+      window.setTimeout(() => setCopied(false), 2000);
+    } catch {
+      setCopied(false);
+    }
+  };
+
+  return (
+    <Dialog open={open} onOpenChange={onOpenChange}>
+      <DialogContent className="max-h-[90vh] overflow-y-auto sm:max-w-2xl" data-testid="meeting-note-conflict-dialog">
+        <DialogHeader>
+          <DialogTitle>This note was changed by someone else</DialogTitle>
+          <DialogDescription>
+            {mine
+              ? 'Your changes were not saved. Review the newer version below; your text is kept here so you can copy it.'
+              : 'Nothing was changed. The newer version is shown below.'}
+          </DialogDescription>
+        </DialogHeader>
+
+        <section aria-labelledby="meeting-note-conflict-newer" className="flex flex-col gap-2 rounded-lg border p-3" data-testid="meeting-note-conflict-newer">
+          <div className="flex flex-wrap items-center justify-between gap-2">
+            <h3 id="meeting-note-conflict-newer" className="text-sm font-semibold">
+              Newer version
+            </h3>
+            <Badge variant="outline">Revision {newer.revision}</Badge>
+          </div>
+          <p className="break-words font-medium" data-testid="meeting-note-conflict-newer-title">
+            {newer.title}
+          </p>
+          <p className="text-xs text-muted-foreground">
+            <time dateTime={newer.meetingDate}>{formatMeetingDate(newer.meetingDate)}</time>
+            {newer.participants.length > 0 ? (
+              <>
+                <span aria-hidden="true"> · </span>
+                {newer.participants
+                  .map((participant) =>
+                    participant.isCurrentMember ? participant.displayName : `${participant.displayName} (Former member)`
+                  )
+                  .join(', ')}
+              </>
+            ) : null}
+          </p>
+          <div className="max-h-48 overflow-y-auto rounded-md bg-muted/40 p-2">
+            <MeetingNoteContent html={newer.content} testId="meeting-note-conflict-newer-content" />
+          </div>
+        </section>
+
+        {mine ? (
+          <section aria-labelledby="meeting-note-conflict-mine" className="flex flex-col gap-2">
+            <div className="flex items-center justify-between gap-2">
+              <h3 id="meeting-note-conflict-mine" className="text-sm font-semibold">
+                Your unsaved changes
+              </h3>
+              <Button type="button" size="sm" variant="outline" className="h-8 gap-1.5" onClick={() => void copy()}>
+                {copied ? <Check className="size-3.5" aria-hidden="true" /> : <Copy className="size-3.5" aria-hidden="true" />}
+                {copied ? 'Copied' : 'Copy my text'}
+              </Button>
+            </div>
+            <textarea
+              readOnly
+              aria-labelledby="meeting-note-conflict-mine"
+              className="min-h-28 w-full resize-y rounded-md border border-input bg-background p-2 text-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
+              value={mineText}
+              data-testid="meeting-note-conflict-mine"
+            />
+          </section>
+        ) : null}
+
+        <DialogFooter className="gap-2">
+          {mine && onLoadNewer ? (
+            <>
+              <Button type="button" variant="ghost" onClick={() => onOpenChange(false)}>
+                Keep editing my copy
+              </Button>
+              <Button type="button" onClick={onLoadNewer}>
+                Load newer version
+              </Button>
+            </>
+          ) : (
+            <Button type="button" onClick={() => onOpenChange(false)}>
+              Close
+            </Button>
+          )}
+        </DialogFooter>
+      </DialogContent>
+    </Dialog>
+  );
+}
diff --git a/src/components/meeting-notes/MeetingNoteContent.tsx b/src/components/meeting-notes/MeetingNoteContent.tsx
new file mode 100644
index 0000000..d5a0964
--- /dev/null
+++ b/src/components/meeting-notes/MeetingNoteContent.tsx
@@ -0,0 +1,45 @@
+// src/components/meeting-notes/MeetingNoteContent.tsx
+// Renders stored meeting-note rich text (FR-002, AC-003). The HTML is passed
+// through the same allow-list sanitizer the routes use on write before it
+// reaches the DOM, so a script, event handler, or unsafe link that reached
+// the database by any path still never runs. Checklist boxes are read-only.
+'use client';
+
+import { useMemo } from 'react';
+
+import { sanitizeMeetingNoteHtmlForDisplay } from '@/lib/meeting-notes/content-sanitizer';
+import { cn } from '@/lib/utils';
+import styles from './meeting-note-content.module.css';
+
+export interface MeetingNoteContentProps {
+  html: string;
+  className?: string;
+  emptyText?: string;
+  testId?: string;
+}
+
+export function MeetingNoteContent({
+  html,
+  className,
+  emptyText = 'No content.',
+  testId = 'meeting-note-content',
+}: MeetingNoteContentProps) {
+  const safeHtml = useMemo(() => sanitizeMeetingNoteHtmlForDisplay(html), [html]);
+
+  if (safeHtml.trim() === '') {
+    return (
+      <p className={cn('text-sm italic text-muted-foreground', className)} data-testid={testId}>
+        {emptyText}
+      </p>
+    );
+  }
+
+  return (
+    <div
+      className={cn(styles.content, className)}
+      data-testid={testId}
+      // Sanitized just above with the meeting-note allow-list.
+      dangerouslySetInnerHTML={{ __html: safeHtml }}
+    />
+  );
+}
diff --git a/src/components/meeting-notes/MeetingNoteCreateView.tsx b/src/components/meeting-notes/MeetingNoteCreateView.tsx
new file mode 100644
index 0000000..4ccd8a2
--- /dev/null
+++ b/src/components/meeting-notes/MeetingNoteCreateView.tsx
@@ -0,0 +1,87 @@
+// src/components/meeting-notes/MeetingNoteCreateView.tsx
+// /meetings/new?spaceId=<id> (FR-001, J1): a new note in a space of the
+// caller's company; after saving, the note's view opens. The route rejects a
+// space of another company (MEETING_NOTE_SPACE_NOT_FOUND).
+'use client';
+
+import Link from 'next/link';
+import { useRouter, useSearchParams } from 'next/navigation';
+import { ArrowLeft, Loader2 } from 'lucide-react';
+
+import { Button } from '@/components/ui/button';
+import { useCompany } from '@/contexts/CompanyContext';
+import { useCreateMeetingNote } from '@/hooks/mutations/useMeetingNoteMutations';
+import { MEETINGS_PATH, meetingNotePath } from '@/lib/meeting-notes/ui-paths';
+import { MeetingNoteForm, type MeetingNoteFormInitialValues } from './MeetingNoteForm';
+
+const UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
+
+const EMPTY_NOTE: MeetingNoteFormInitialValues = { title: '', meetingDate: null, participants: [], content: '' };
+
+export function MeetingNoteCreateView() {
+  const router = useRouter();
+  const searchParams = useSearchParams();
+  const spaceId = searchParams.get('spaceId') ?? '';
+  const { spaces, isLoading } = useCompany();
+  const create = useCreateMeetingNote();
+
+  const space = spaces.find((candidate) => candidate.id === spaceId) ?? null;
+  const back = (
+    <Button asChild variant="ghost" size="sm" className="-ml-2 h-8 w-fit gap-1.5">
+      <Link href={MEETINGS_PATH}>
+        <ArrowLeft className="size-4" aria-hidden="true" />
+        Meetings
+      </Link>
+    </Button>
+  );
+
+  if (!UUID.test(spaceId) || (!isLoading && !space)) {
+    return (
+      <div className="flex max-w-3xl flex-col gap-4">
+        {back}
+        <div className="rounded-xl border border-[var(--vo-line-soft)] bg-card p-6" role="alert">
+          <p className="font-medium">Choose a space first.</p>
+          <p className="mt-1 text-sm text-muted-foreground">
+            A meeting note belongs to a space. Open a space on the floor plan, go to its Notes tab, and choose
+            &quot;New note&quot;.
+          </p>
+        </div>
+      </div>
+    );
+  }
+
+  if (!space) {
+    return (
+      <p className="flex items-center gap-2 text-sm text-muted-foreground" role="status">
+        <Loader2 className="size-4 animate-spin" aria-hidden="true" />
+        Loading…
+      </p>
+    );
+  }
+
+  return (
+    <div className="flex max-w-3xl flex-col gap-4">
+      {back}
+      <div className="rounded-xl border border-[var(--vo-line-soft)] bg-card p-6">
+        <MeetingNoteForm
+          initial={EMPTY_NOTE}
+          submitLabel="Save note"
+          submitting={create.isPending}
+          submitError={create.error}
+          header={
+            <p className="text-sm text-muted-foreground">
+              Space: <span className="font-medium text-foreground" data-testid="meeting-note-form-space">{space.name}</span>
+            </p>
+          }
+          onCancel={() => (window.history.length > 1 ? router.back() : router.push(MEETINGS_PATH))}
+          onSubmit={(fields) =>
+            create.mutate(
+              { spaceId, fields },
+              { onSuccess: (note) => router.replace(meetingNotePath(note.id)) }
+            )
+          }
+        />
+      </div>
+    </div>
+  );
+}
diff --git a/src/components/meeting-notes/MeetingNoteDeleteButton.tsx b/src/components/meeting-notes/MeetingNoteDeleteButton.tsx
new file mode 100644
index 0000000..c2ed9e6
--- /dev/null
+++ b/src/components/meeting-notes/MeetingNoteDeleteButton.tsx
@@ -0,0 +1,138 @@
+// src/components/meeting-notes/MeetingNoteDeleteButton.tsx
+// Delete a note after confirmation (FR-010, AC-007, J10). Offered only when
+// the note view says the viewer may delete (author or admin); the route and
+// the database decide. Deleting removes the note, its versions, participants,
+// action items, and transcript; then the Meetings page opens. The revision
+// is captured when the confirmation opens; a 409 shows the newer state and
+// needs a new, explicit confirmation.
+'use client';
+
+import { Loader2, Trash2 } from 'lucide-react';
+import { useRouter } from 'next/navigation';
+import { useState } from 'react';
+
+import {
+  AlertDialog,
+  AlertDialogAction,
+  AlertDialogCancel,
+  AlertDialogContent,
+  AlertDialogDescription,
+  AlertDialogFooter,
+  AlertDialogHeader,
+  AlertDialogTitle,
+  AlertDialogTrigger,
+} from '@/components/ui/alert-dialog';
+import { Button } from '@/components/ui/button';
+import { useDeleteMeetingNote } from '@/hooks/mutations/useMeetingNoteMutations';
+import { useNotification } from '@/hooks/useNotification';
+import { MeetingNoteConflictError } from '@/lib/meeting-notes/client-api';
+import { formatMeetingNoteTimestamp } from '@/lib/meeting-notes/format';
+import { describeMeetingNoteError } from '@/lib/meeting-notes/form-errors';
+import { MEETINGS_PATH } from '@/lib/meeting-notes/ui-paths';
+import type { MeetingNoteDetail } from '@/types/meeting-notes';
+
+export interface MeetingNoteDeleteButtonProps {
+  /** The note as currently cached; its revision is captured when the confirmation opens. */
+  note: MeetingNoteDetail;
+  /** Called once the note is gone, before the Meetings page opens. */
+  onDeleted: () => void;
+}
+
+/** What the confirmation shows and deletes: fixed when it opens, never the live note. */
+interface DeleteTarget {
+  revision: number;
+  title: string;
+  /** Set after a 409: the newer state the user must confirm again. */
+  changed: boolean;
+}
+
+export function MeetingNoteDeleteButton({ note, onDeleted }: MeetingNoteDeleteButtonProps) {
+  const router = useRouter();
+  const remove = useDeleteMeetingNote();
+  const { showSuccess } = useNotification();
+  const [target, setTarget] = useState<DeleteTarget | null>(null);
+
+  const confirm = () => {
+    if (!target) return;
+    // Only the revision the user saw in this dialog: a background refetch of
+    // the note never changes what "Delete" applies to (block B review B-4).
+    remove.mutate(
+      { noteId: note.id, expectedRevision: target.revision },
+      {
+        onSuccess: () => {
+          setTarget(null);
+          onDeleted();
+          showSuccess({ description: 'Meeting note deleted.' });
+          router.replace(MEETINGS_PATH);
+        },
+        onError: (error) => {
+          if (error instanceof MeetingNoteConflictError) {
+            setTarget({ revision: error.note.revision, title: error.note.title, changed: true });
+          }
+        },
+      }
+    );
+  };
+
+  const conflictError = remove.error instanceof MeetingNoteConflictError ? remove.error : null;
+
+  return (
+    <AlertDialog
+      open={target !== null}
+      onOpenChange={(next) => {
+        if (remove.isPending) return;
+        remove.reset();
+        setTarget(next ? { revision: note.revision, title: note.title, changed: false } : null);
+      }}
+    >
+      <AlertDialogTrigger asChild>
+        <Button type="button" variant="outline" size="sm" className="gap-1.5 text-destructive hover:text-destructive" data-testid="meeting-note-delete-button">
+          <Trash2 className="size-4" aria-hidden="true" />
+          Delete
+        </Button>
+      </AlertDialogTrigger>
+      <AlertDialogContent data-testid="meeting-note-delete-dialog" data-revision={target?.revision}>
+        <AlertDialogHeader>
+          <AlertDialogTitle>Delete this meeting note?</AlertDialogTitle>
+          <AlertDialogDescription>
+            &quot;{target?.title ?? note.title}&quot; (revision {target?.revision ?? note.revision}) will be permanently
+            deleted with its version history, participants, action items, and transcript. This cannot be undone.
+          </AlertDialogDescription>
+        </AlertDialogHeader>
+        {conflictError ? (
+          <div
+            className="flex flex-col gap-1 rounded-md border border-amber-500/40 bg-amber-500/10 p-3 text-sm"
+            role="alert"
+            data-testid="meeting-note-delete-conflict"
+          >
+            <p className="font-medium">This note was changed by someone else, so nothing was deleted.</p>
+            <p>
+              It is now revision {conflictError.note.revision}, &quot;{conflictError.note.title}&quot;, updated{' '}
+              {formatMeetingNoteTimestamp(conflictError.note.updatedAt)}. Review it, then delete this newer version
+              only if you still want to.
+            </p>
+          </div>
+        ) : remove.isError ? (
+          <p className="text-sm text-destructive" role="alert">
+            {describeMeetingNoteError(remove.error)}
+          </p>
+        ) : null}
+        <AlertDialogFooter>
+          <AlertDialogCancel disabled={remove.isPending}>Cancel</AlertDialogCancel>
+          <AlertDialogAction
+            className="bg-destructive text-white hover:bg-destructive/90"
+            disabled={remove.isPending}
+            onClick={(event) => {
+              event.preventDefault();
+              confirm();
+            }}
+            data-testid="meeting-note-delete-confirm"
+          >
+            {remove.isPending ? <Loader2 className="mr-2 size-4 animate-spin" aria-hidden="true" /> : null}
+            {target?.changed ? 'Delete newer version' : 'Delete note'}
+          </AlertDialogAction>
+        </AlertDialogFooter>
+      </AlertDialogContent>
+    </AlertDialog>
+  );
+}
diff --git a/src/components/meeting-notes/MeetingNoteEditPanel.tsx b/src/components/meeting-notes/MeetingNoteEditPanel.tsx
new file mode 100644
index 0000000..90dd6b0
--- /dev/null
+++ b/src/components/meeting-notes/MeetingNoteEditPanel.tsx
@@ -0,0 +1,143 @@
+// src/components/meeting-notes/MeetingNoteEditPanel.tsx
+// Editing an existing note (FR-006, FR-007, J3). The save is a full
+// replacement against the revision the editor started from; when another
+// change landed first, the route answers 409 with the newer note and the
+// conflict dialog shows both — the user's text stays available to copy,
+// also after loading the newer version.
+'use client';
+
+import { useMemo, useState } from 'react';
+import { AlertTriangle } from 'lucide-react';
+
+import { Button } from '@/components/ui/button';
+import { useUpdateMeetingNote } from '@/hooks/mutations/useMeetingNoteMutations';
+import { MeetingNoteConflictError, type MeetingNoteFieldsPayload } from '@/lib/meeting-notes/client-api';
+import { meetingNoteHtmlToText } from '@/lib/meeting-notes/html-text';
+import type { MeetingNoteDetail } from '@/types/meeting-notes';
+import { MeetingNoteConflictDialog } from './MeetingNoteConflictDialog';
+import { MeetingNoteForm, type MeetingNoteFormInitialValues } from './MeetingNoteForm';
+
+export interface MeetingNoteEditPanelProps {
+  /** The note as it was when editing started; its revision is the save's base. */
+  note: MeetingNoteDetail;
+  onSaved: (note: MeetingNoteDetail) => void;
+  onCancel: () => void;
+}
+
+export function MeetingNoteEditPanel({ note, onSaved, onCancel }: MeetingNoteEditPanelProps) {
+  const update = useUpdateMeetingNote();
+  const [base, setBase] = useState(note);
+  const [pending, setPending] = useState<MeetingNoteFieldsPayload | null>(null);
+  const [conflict, setConflict] = useState<MeetingNoteConflictError | null>(null);
+  const [conflictOpen, setConflictOpen] = useState(false);
+  const [backup, setBackup] = useState<MeetingNoteFieldsPayload | null>(null);
+
+  const initial = useMemo<MeetingNoteFormInitialValues>(
+    () => ({
+      title: base.title,
+      meetingDate: base.meetingDate,
+      participants: base.participants,
+      content: base.content,
+    }),
+    [base]
+  );
+  const backupText = useMemo(
+    () => (backup ? `${backup.title}\n\n${meetingNoteHtmlToText(backup.content)}`.trim() : ''),
+    [backup]
+  );
+
+  const submit = (fields: MeetingNoteFieldsPayload) => {
+    setPending(fields);
+    update.mutate(
+      { noteId: base.id, expectedRevision: base.revision, fields },
+      {
+        onSuccess: (saved) => onSaved(saved),
+        onError: (error) => {
+          if (error instanceof MeetingNoteConflictError) {
+            setConflict(error);
+            setConflictOpen(true);
+          }
+        },
+      }
+    );
+  };
+
+  const loadNewer = () => {
+    if (!conflict) return;
+    setBackup(pending);
+    setBase(conflict.note);
+    setConflict(null);
+    setConflictOpen(false);
+    update.reset();
+  };
+
+  // A conflict is answered by the dialog and the banner, not as a form error.
+  const formError = update.error instanceof MeetingNoteConflictError ? null : update.error;
+
+  return (
+    <div className="flex flex-col gap-4" data-testid="meeting-note-edit-panel">
+      {conflict && !conflictOpen ? (
+        <div
+          className="flex flex-wrap items-center gap-3 rounded-md border border-amber-500/40 bg-amber-500/10 px-3 py-2 text-sm"
+          role="alert"
+        >
+          <AlertTriangle className="size-4 flex-none text-amber-600" aria-hidden="true" />
+          <span className="min-w-0 flex-1">
+            This note was changed by someone else while you were editing. Saving again will be refused until you
+            load the newer version.
+          </span>
+          <Button type="button" size="sm" variant="outline" onClick={() => setConflictOpen(true)}>
+            Review newer version
+          </Button>
+        </div>
+      ) : null}
+
+      {backup ? (
+        <section
+          aria-labelledby="meeting-note-backup-heading"
+          className="flex flex-col gap-2 rounded-md border border-[var(--vo-line-soft)] bg-[var(--vo-bg-2)] p-3"
+          data-testid="meeting-note-unsaved-backup"
+        >
+          <div className="flex items-center justify-between gap-2">
+            <h3 id="meeting-note-backup-heading" className="text-sm font-semibold">
+              Your earlier unsaved text
+            </h3>
+            <Button type="button" size="sm" variant="ghost" onClick={() => setBackup(null)}>
+              Dismiss
+            </Button>
+          </div>
+          <p className="text-xs text-muted-foreground">
+            The form now shows the newer version. Copy anything you still need from here.
+          </p>
+          <textarea
+            readOnly
+            aria-labelledby="meeting-note-backup-heading"
+            className="min-h-24 w-full resize-y rounded-md border border-input bg-background p-2 text-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
+            value={backupText}
+          />
+        </section>
+      ) : null}
+
+      <MeetingNoteForm
+        // Remount on a new base so every field shows the newer version.
+        key={`${base.id}:${base.revision}`}
+        initial={initial}
+        submitLabel="Save changes"
+        submitting={update.isPending}
+        submitError={formError}
+        onSubmit={submit}
+        onCancel={onCancel}
+      />
+
+      {conflict ? (
+        <MeetingNoteConflictDialog
+          open={conflictOpen}
+          onOpenChange={setConflictOpen}
+          newer={conflict.note}
+          mine={pending}
+          onLoadNewer={loadNewer}
+        />
+      ) : null}
+    </div>
+  );
+}
