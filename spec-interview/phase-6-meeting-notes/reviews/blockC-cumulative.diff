@@ -0,0 +1,50 @@
+// src/components/meeting-notes/MeetingNoteActionItemConflictNotice.tsx
+// Conflict feedback for one action item (FR-011, §11): someone else changed
+// it first, so nothing was saved. Shows the item as it is now (description as
+// plain text, assignee, due date, status, revision) and the caller's choices.
+'use client';
+
+import type { ReactNode } from 'react';
+
+import { Badge } from '@/components/ui/badge';
+import { formatMeetingNoteDueDate } from '@/lib/meeting-notes/format';
+import type { User } from '@/types/database';
+import type { MeetingNoteActionItemView } from '@/types/meeting-notes';
+import { MeetingNoteActionItemAssignee } from './MeetingNoteActionItemAssignee';
+
+export interface MeetingNoteActionItemConflictNoticeProps {
+  /** The item as the route returned it with the 409. */
+  newer: MeetingNoteActionItemView;
+  membersById: ReadonlyMap<string, User>;
+  message: string;
+  /** Buttons offering what to do next. */
+  children?: ReactNode;
+}
+
+export function MeetingNoteActionItemConflictNotice({ newer, membersById, message, children }: MeetingNoteActionItemConflictNoticeProps) {
+  const due = formatMeetingNoteDueDate(newer.dueDate);
+  return (
+    <div
+      className="flex flex-col gap-2 rounded-md border border-amber-500/40 bg-amber-500/10 p-3 text-sm"
+      role="alert"
+      data-testid="meeting-note-item-conflict"
+      data-revision={newer.revision}
+    >
+      <p className="font-medium">{message}</p>
+      <div className="flex flex-col gap-1 rounded-md bg-background/70 p-2" aria-label="Newer version of the action item">
+        <p className="whitespace-pre-wrap break-words" data-testid="meeting-note-item-conflict-description">
+          {newer.description}
+        </p>
+        <div className="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-muted-foreground">
+          <MeetingNoteActionItemAssignee item={newer} membersById={membersById} />
+          <span>{due ? `Due ${due}` : 'No due date'}</span>
+          <span>{newer.completed ? 'Done' : 'Open'}</span>
+          <Badge variant="outline" className="text-[10px]">
+            Revision {newer.revision}
+          </Badge>
+        </div>
+      </div>
+      {children ? <div className="flex flex-wrap justify-end gap-2">{children}</div> : null}
+    </div>
+  );
+}
diff --git a/src/components/meeting-notes/MeetingNoteActionItemDeleteButton.tsx b/src/components/meeting-notes/MeetingNoteActionItemDeleteButton.tsx
new file mode 100644
index 0000000..33975c6
--- /dev/null
+++ b/src/components/meeting-notes/MeetingNoteActionItemDeleteButton.tsx
@@ -0,0 +1,123 @@
+// src/components/meeting-notes/MeetingNoteActionItemDeleteButton.tsx
+// Delete an action item after confirmation (FR-011; editors only — the route
+// and the database decide). The confirmation shows and deletes the item as
+// it was when the dialog opened (never a version a background refetch brought
+// in meanwhile). If the item changed, nothing is deleted: the newer item is
+// shown and the user may confirm again to delete that one.
+'use client';
+
+import { Loader2, Trash2 } from 'lucide-react';
+import { useState } from 'react';
+
+import {
+  AlertDialog,
+  AlertDialogAction,
+  AlertDialogCancel,
+  AlertDialogContent,
+  AlertDialogDescription,
+  AlertDialogFooter,
+  AlertDialogHeader,
+  AlertDialogTitle,
+  AlertDialogTrigger,
+} from '@/components/ui/alert-dialog';
+import { Button } from '@/components/ui/button';
+import { useDeleteMeetingNoteActionItem } from '@/hooks/mutations/useMeetingNoteActionItemMutations';
+import { MeetingNoteItemConflictError } from '@/lib/meeting-notes/client-api';
+import { describeMeetingNoteItemError } from '@/lib/meeting-notes/item-errors';
+import type { User } from '@/types/database';
+import type { MeetingNoteActionItemView } from '@/types/meeting-notes';
+import { MeetingNoteActionItemConflictNotice } from './MeetingNoteActionItemConflictNotice';
+
+export interface MeetingNoteActionItemDeleteButtonProps {
+  noteId: string;
+  /** The item as currently cached; captured when the confirmation opens. */
+  item: MeetingNoteActionItemView;
+  membersById: ReadonlyMap<string, User>;
+}
+
+export function MeetingNoteActionItemDeleteButton({ noteId, item, membersById }: MeetingNoteActionItemDeleteButtonProps) {
+  const remove = useDeleteMeetingNoteActionItem();
+  /** The item this dialog deletes: fixed when it opens, replaced only by a 409's newer item. */
+  const [target, setTarget] = useState<MeetingNoteActionItemView | null>(null);
+  const [conflict, setConflict] = useState<MeetingNoteActionItemView | null>(null);
+  const open = target !== null;
+
+  const confirm = () => {
+    if (!target) return;
+    remove.mutate(
+      { noteId, itemId: target.id, expectedRevision: target.revision },
+      {
+        onSuccess: () => {
+          setConflict(null);
+          setTarget(null);
+        },
+        onError: (error) => {
+          if (error instanceof MeetingNoteItemConflictError) {
+            // The user confirms again against the newer item they are shown.
+            setConflict(error.item);
+            setTarget(error.item);
+          }
+        },
+      }
+    );
+  };
+
+  return (
+    <AlertDialog
+      open={open}
+      onOpenChange={(next) => {
+        if (remove.isPending) return;
+        remove.reset();
+        setConflict(null);
+        setTarget(next ? item : null);
+      }}
+    >
+      <AlertDialogTrigger asChild>
+        <Button
+          type="button"
+          variant="ghost"
+          size="icon"
+          className="size-8 text-muted-foreground hover:text-destructive"
+          aria-label="Delete action item"
+          data-testid="meeting-note-item-delete"
+        >
+          <Trash2 className="size-4" aria-hidden="true" />
+        </Button>
+      </AlertDialogTrigger>
+      <AlertDialogContent>
+        <AlertDialogHeader>
+          <AlertDialogTitle>Delete this action item?</AlertDialogTitle>
+          <AlertDialogDescription className="whitespace-pre-wrap break-words">
+            {`"${(target ?? item).description}" will be permanently deleted.`}
+          </AlertDialogDescription>
+        </AlertDialogHeader>
+        {conflict ? (
+          <MeetingNoteActionItemConflictNotice
+            newer={conflict}
+            membersById={membersById}
+            message="This action item was changed by someone else, so it was not deleted. This is the newer version; delete it anyway?"
+          />
+        ) : remove.isError ? (
+          <p className="text-sm text-destructive" role="alert">
+            {describeMeetingNoteItemError(remove.error)}
+          </p>
+        ) : null}
+        <AlertDialogFooter>
+          <AlertDialogCancel disabled={remove.isPending}>Cancel</AlertDialogCancel>
+          <AlertDialogAction
+            className="bg-destructive text-white hover:bg-destructive/90"
+            disabled={remove.isPending}
+            onClick={(event) => {
+              event.preventDefault();
+              confirm();
+            }}
+            data-testid="meeting-note-item-delete-confirm"
+          >
+            {remove.isPending ? <Loader2 className="mr-2 size-4 animate-spin" aria-hidden="true" /> : null}
+            {conflict ? 'Delete anyway' : 'Delete item'}
+          </AlertDialogAction>
+        </AlertDialogFooter>
+      </AlertDialogContent>
+    </AlertDialog>
+  );
+}
diff --git a/src/components/meeting-notes/MeetingNoteActionItemForm.tsx b/src/components/meeting-notes/MeetingNoteActionItemForm.tsx
