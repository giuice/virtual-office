--- /dev/null
+++ b/src/components/meeting-notes/MeetingNoteActionItemForm.tsx
@@ -0,0 +1,248 @@
+// src/components/meeting-notes/MeetingNoteActionItemForm.tsx
+// Add or edit an action item (FR-011, AC-008, AC-009): description (plain
+// text, 1–1,000 characters), optional assignee from the current members,
+// optional due date as a calendar date ('YYYY-MM-DD' from the date input,
+// sent and shown as is — never converted through `Date`). An edit that lost
+// a race shows the newer item and lets the user save again on it or load it.
+'use client';
+
+import { Loader2 } from 'lucide-react';
+import { useId, useState, type FormEvent } from 'react';
+
+import { Button } from '@/components/ui/button';
+import { Input } from '@/components/ui/input';
+import { Label } from '@/components/ui/label';
+import { Textarea } from '@/components/ui/textarea';
+import {
+  useCreateMeetingNoteActionItem,
+  useUpdateMeetingNoteActionItem,
+} from '@/hooks/mutations/useMeetingNoteActionItemMutations';
+import { MeetingNoteItemConflictError } from '@/lib/meeting-notes/client-api';
+import {
+  describeMeetingNoteItemError,
+  meetingNoteItemFieldError,
+  type MeetingNoteItemField,
+} from '@/lib/meeting-notes/item-errors';
+import { codePointLength, MEETING_NOTE_LIMITS } from '@/lib/meeting-notes/validation';
+import type { User } from '@/types/database';
+import type { MeetingNoteActionItemFieldsInput, MeetingNoteActionItemView } from '@/types/meeting-notes';
+import { MeetingNoteActionItemAssigneeSelect } from './MeetingNoteActionItemAssigneeSelect';
+import { MeetingNoteActionItemConflictNotice } from './MeetingNoteActionItemConflictNotice';
+
+export interface MeetingNoteActionItemFormProps {
+  noteId: string;
+  /** The item being edited; omitted to add a new one. */
+  item?: MeetingNoteActionItemView;
+  members: readonly User[];
+  membersById: ReadonlyMap<string, User>;
+  onSaved: () => void;
+  onCancel: () => void;
+}
+
+const DATE_ONLY = /^\d{4}-\d{2}-\d{2}$/;
+
+function storedAssigneeOf(item: MeetingNoteActionItemView | undefined) {
+  if (!item || item.assigneeId === null) return null;
+  return {
+    id: item.assigneeId,
+    name: item.assigneeName ?? 'Unknown member',
+    isFormerMember: item.assigneeIsCurrentMember !== true,
+  };
+}
+
+export function MeetingNoteActionItemForm({ noteId, item, members, membersById, onSaved, onCancel }: MeetingNoteActionItemFormProps) {
+  const create = useCreateMeetingNoteActionItem();
+  const update = useUpdateMeetingNoteActionItem();
+  const ids = {
+    description: useId(),
+    descriptionError: useId(),
+    assignee: useId(),
+    assigneeError: useId(),
+    dueDate: useId(),
+    dueDateError: useId(),
+  };
+
+  const [description, setDescription] = useState(item?.description ?? '');
+  const [assigneeId, setAssigneeId] = useState<string | null>(item?.assigneeId ?? null);
+  const [dueDate, setDueDate] = useState(item?.dueDate ?? '');
+  const [storedAssignee, setStoredAssignee] = useState(() => storedAssigneeOf(item));
+  const [baseRevision, setBaseRevision] = useState(item?.revision ?? 0);
+  const [errors, setErrors] = useState<Partial<Record<MeetingNoteItemField, string>>>({});
+  const [formError, setFormError] = useState<string | null>(null);
+  const [conflict, setConflict] = useState<MeetingNoteActionItemView | null>(null);
+
+  const submitting = create.isPending || update.isPending;
+  const length = codePointLength(description.trim());
+
+  const save = (expectedRevision: number) => {
+    const trimmed = description.trim();
+    const nextErrors: Partial<Record<MeetingNoteItemField, string>> = {};
+    if (length < 1 || length > MEETING_NOTE_LIMITS.itemDescriptionMaxChars) {
+      nextErrors.description = `Enter a description of 1 to ${MEETING_NOTE_LIMITS.itemDescriptionMaxChars.toLocaleString('en-US')} characters.`;
+    }
+    if (dueDate !== '' && !DATE_ONLY.test(dueDate)) {
+      nextErrors.dueDate = 'Enter a valid due date or leave it empty.';
+    }
+    setErrors(nextErrors);
+    setFormError(null);
+    if (Object.keys(nextErrors).length > 0) return;
+
+    const fields: MeetingNoteActionItemFieldsInput = {
+      description: trimmed,
+      assigneeId,
+      dueDate: dueDate === '' ? null : dueDate,
+    };
+    const handlers = {
+      onSuccess: () => {
+        setConflict(null);
+        onSaved();
+      },
+      onError: (error: unknown) => {
+        if (error instanceof MeetingNoteItemConflictError) {
+          setConflict(error.item);
+          return;
+        }
+        const field = meetingNoteItemFieldError(error);
+        if (field) {
+          setErrors({ [field.field]: field.message });
+          return;
+        }
+        setFormError(describeMeetingNoteItemError(error));
+      },
+    };
+    if (item) {
+      update.mutate({ noteId, itemId: item.id, expectedRevision, fields }, handlers);
+    } else {
+      create.mutate({ noteId, fields }, handlers);
+    }
+  };
+
+  const handleSubmit = (event: FormEvent<HTMLFormElement>) => {
+    event.preventDefault();
+    if (!submitting) save(baseRevision);
+  };
+
+  const saveOverNewer = () => {
+    if (!conflict) return;
+    setBaseRevision(conflict.revision);
+    save(conflict.revision);
+  };
+
+  const loadNewer = () => {
+    if (!conflict) return;
+    setDescription(conflict.description);
+    setAssigneeId(conflict.assigneeId);
+    setDueDate(conflict.dueDate ?? '');
+    setStoredAssignee(storedAssigneeOf(conflict));
+    setBaseRevision(conflict.revision);
+    setErrors({});
+    setConflict(null);
+  };
+
+  const fieldError = (id: string, message: string | undefined) =>
+    message ? (
+      <p id={id} className="text-xs text-destructive" role="alert">
+        {message}
+      </p>
+    ) : null;
+
+  return (
+    <form
+      className="flex flex-col gap-3 rounded-lg border border-[var(--vo-line-soft)] bg-[var(--vo-bg-2)] p-3"
+      noValidate
+      onSubmit={handleSubmit}
+      aria-busy={submitting}
+      aria-label={item ? 'Edit action item' : 'New action item'}
+      data-testid="meeting-note-item-form"
+    >
+      <div className="flex flex-col gap-1.5">
+        <Label htmlFor={ids.description}>Description</Label>
+        <Textarea
+          id={ids.description}
+          value={description}
+          rows={2}
+          required
+          autoFocus
+          aria-invalid={errors.description ? 'true' : 'false'}
+          aria-describedby={errors.description ? ids.descriptionError : undefined}
+          onChange={(event) => setDescription(event.target.value)}
+          disabled={submitting}
+          data-testid="meeting-note-item-description-input"
+        />
+        <div className="flex justify-between gap-2">
+          {fieldError(ids.descriptionError, errors.description) ?? <span />}
+          <span className="text-xs text-muted-foreground" aria-live="polite">
+            {length}/{MEETING_NOTE_LIMITS.itemDescriptionMaxChars.toLocaleString('en-US')}
+          </span>
+        </div>
+      </div>
+
+      <div className="grid gap-3 sm:grid-cols-2">
+        <div className="flex flex-col gap-1.5">
+          <Label htmlFor={ids.assignee}>Assignee</Label>
+          <MeetingNoteActionItemAssigneeSelect
+            id={ids.assignee}
+            value={assigneeId}
+            members={members}
+            storedAssignee={storedAssignee}
+            disabled={submitting}
+            invalid={Boolean(errors.assignee)}
+            describedById={errors.assignee ? ids.assigneeError : undefined}
+            onChange={setAssigneeId}
+          />
+          {fieldError(ids.assigneeError, errors.assignee)}
+        </div>
+        <div className="flex flex-col gap-1.5">
+          <Label htmlFor={ids.dueDate}>Due date</Label>
+          <Input
+            id={ids.dueDate}
+            type="date"
+            className="h-9"
+            value={dueDate}
+            aria-invalid={errors.dueDate ? 'true' : 'false'}
+            aria-describedby={errors.dueDate ? ids.dueDateError : undefined}
+            onChange={(event) => setDueDate(event.target.value)}
+            disabled={submitting}
+            data-testid="meeting-note-item-due-input"
+          />
+          {fieldError(ids.dueDateError, errors.dueDate)}
+        </div>
+      </div>
+
+      {conflict ? (
+        <MeetingNoteActionItemConflictNotice
+          newer={conflict}
+          membersById={membersById}
+          message="This action item was changed by someone else. Your changes were not saved."
+        >
+          <Button type="button" size="sm" variant="ghost" onClick={loadNewer} disabled={submitting}>
+            Load the newer version
+          </Button>
+          <Button type="button" size="sm" onClick={saveOverNewer} disabled={submitting} data-testid="meeting-note-item-conflict-retry">
+            Save my changes again
+          </Button>
+        </MeetingNoteActionItemConflictNotice>
+      ) : null}
+
+      {formError ? (
+        <p
+          className="rounded-md border border-destructive/40 bg-destructive/10 px-3 py-2 text-sm text-destructive"
+          role="alert"
+          data-testid="meeting-note-item-form-error"
+        >
+          {formError}
+        </p>
+      ) : null}
+
+      <div className="flex items-center justify-end gap-2">
+        <Button type="button" variant="ghost" size="sm" onClick={onCancel} disabled={submitting}>
+          Cancel
+        </Button>
+        <Button type="submit" size="sm" disabled={submitting || conflict !== null} data-testid="meeting-note-item-save">
+          {submitting ? <Loader2 className="mr-2 size-4 animate-spin" aria-hidden="true" /> : null}
+          {item ? 'Save item' : 'Add item'}
+        </Button>
+      </div>
+    </form>
+  );
+}
diff --git a/src/components/meeting-notes/MeetingNoteActionItemRow.tsx b/src/components/meeting-notes/MeetingNoteActionItemRow.tsx
new file mode 100644
index 0000000..7f179f1
--- /dev/null
+++ b/src/components/meeting-notes/MeetingNoteActionItemRow.tsx
@@ -0,0 +1,182 @@
+// src/components/meeting-notes/MeetingNoteActionItemRow.tsx
+// One action item (FR-011, BR-005, AC-008, AC-009): description as plain
+// text, assignee, due date exactly as stored, and status. Editors and the
+// item's current assignee get the completion checkbox; everyone else sees the
+// status only. Editors also edit and delete. A completion that lost a race
+// shows the newer item and offers to try again on it.
+'use client';
+
+import { Pencil } from 'lucide-react';
+import { useState } from 'react';
+
+import { Badge } from '@/components/ui/badge';
+import { Button } from '@/components/ui/button';
+import { useSetMeetingNoteActionItemCompleted } from '@/hooks/mutations/useMeetingNoteActionItemMutations';
+import { MeetingNoteItemConflictError } from '@/lib/meeting-notes/client-api';
+import { formatMeetingNoteDueDate } from '@/lib/meeting-notes/format';
+import { describeMeetingNoteItemError } from '@/lib/meeting-notes/item-errors';
+import { cn } from '@/lib/utils';
+import type { User } from '@/types/database';
+import type { MeetingNoteActionItemView } from '@/types/meeting-notes';
+import { MeetingNoteActionItemAssignee } from './MeetingNoteActionItemAssignee';
+import { MeetingNoteActionItemConflictNotice } from './MeetingNoteActionItemConflictNotice';
+import { MeetingNoteActionItemDeleteButton } from './MeetingNoteActionItemDeleteButton';
+import { MeetingNoteActionItemForm } from './MeetingNoteActionItemForm';
+
+export interface MeetingNoteActionItemRowProps {
+  noteId: string;
+  item: MeetingNoteActionItemView;
+  /** Note editor: edit, delete, and completion. */
+  canEdit: boolean;
+  /** Editor or the item's current assignee. */
+  canToggle: boolean;
+  members: readonly User[];
+  membersById: ReadonlyMap<string, User>;
+}
+
+const LABEL_PREVIEW_CHARS = 80;
+
+function preview(text: string): string {
+  const flat = text.replace(/\s+/g, ' ').trim();
+  return flat.length > LABEL_PREVIEW_CHARS ? `${flat.slice(0, LABEL_PREVIEW_CHARS)}…` : flat;
+}
+
+export function MeetingNoteActionItemRow({ noteId, item, canEdit, canToggle, members, membersById }: MeetingNoteActionItemRowProps) {
+  const toggle = useSetMeetingNoteActionItemCompleted();
+  const [editing, setEditing] = useState(false);
+  const [conflict, setConflict] = useState<{ newer: MeetingNoteActionItemView; wanted: boolean } | null>(null);
+  const due = formatMeetingNoteDueDate(item.dueDate);
+
+  const setCompleted = (completed: boolean, expectedRevision: number) => {
+    setConflict(null);
+    toggle.mutate(
+      { noteId, itemId: item.id, expectedRevision, completed },
+      {
+        onError: (error) => {
+          if (error instanceof MeetingNoteItemConflictError) setConflict({ newer: error.item, wanted: completed });
+        },
+      }
+    );
+  };
+
+  if (editing) {
+    return (
+      <li data-testid="meeting-note-item" data-item-id={item.id} data-editing="true">
+        <MeetingNoteActionItemForm
+          noteId={noteId}
+          item={item}
+          members={members}
+          membersById={membersById}
+          onSaved={() => setEditing(false)}
+          onCancel={() => setEditing(false)}
+        />
+      </li>
+    );
+  }
+
+  return (
+    <li
+      className="flex flex-col gap-2 rounded-lg border border-[var(--vo-line-soft)] p-3"
+      data-testid="meeting-note-item"
+      data-item-id={item.id}
+      data-completed={item.completed ? 'true' : 'false'}
+      data-revision={item.revision}
+    >
+      <div className="flex items-start gap-3">
+        {canToggle ? (
+          <input
+            type="checkbox"
+            className="mt-0.5 size-4 shrink-0 cursor-pointer accent-primary disabled:cursor-not-allowed"
+            checked={item.completed}
+            disabled={toggle.isPending}
+            aria-label={`Done: ${preview(item.description)}`}
+            onChange={(event) => setCompleted(event.target.checked, item.revision)}
+            data-testid="meeting-note-item-toggle"
+          />
+        ) : null}
+        <div className="flex min-w-0 flex-1 flex-col gap-1.5">
+          <p
+            className={cn('whitespace-pre-wrap break-words text-sm', item.completed && 'text-muted-foreground line-through')}
+            data-testid="meeting-note-item-description"
+          >
+            {item.description}
+          </p>
+          <div className="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-muted-foreground">
+            <MeetingNoteActionItemAssignee item={item} membersById={membersById} />
+            {due ? (
+              <span data-testid="meeting-note-item-due">
+                Due <time dateTime={due}>{due}</time>
+              </span>
+            ) : (
+              <span data-testid="meeting-note-item-due" data-empty="true">
+                No due date
+              </span>
+            )}
+            <Badge
+              variant={item.completed ? 'secondary' : 'outline'}
+              className="text-[10px]"
+              data-testid="meeting-note-item-status"
+            >
+              {item.completed ? 'Done' : 'Open'}
+            </Badge>
+          </div>
+        </div>
+        {canEdit ? (
+          <div className="flex shrink-0 items-center gap-1">
+            <Button
+              type="button"
+              variant="ghost"
+              size="icon"
+              className="size-8 text-muted-foreground"
+              aria-label="Edit action item"
+              onClick={() => setEditing(true)}
+              data-testid="meeting-note-item-edit"
+            >
+              <Pencil className="size-4" aria-hidden="true" />
+            </Button>
+            <MeetingNoteActionItemDeleteButton noteId={noteId} item={item} membersById={membersById} />
+          </div>
+        ) : null}
+      </div>
+
+      {conflict ? (
+        <MeetingNoteActionItemConflictNotice
+          newer={conflict.newer}
+          membersById={membersById}
+          message={
+            conflict.newer.completed === conflict.wanted
+              ? `This action item was changed by someone else. It is already ${conflict.wanted ? 'done' : 'open'}.`
+              : 'This action item was changed by someone else, so your change was not saved.'
+          }
+        >
+          <Button
+            type="button"
+            size="sm"
+            variant="ghost"
+            onClick={() => {
+              setConflict(null);
+              toggle.reset();
+            }}
+          >
+            Dismiss
+          </Button>
+          {conflict.newer.completed !== conflict.wanted && canToggle ? (
+            <Button
+              type="button"
+              size="sm"
+              disabled={toggle.isPending}
+              onClick={() => setCompleted(conflict.wanted, conflict.newer.revision)}
+              data-testid="meeting-note-item-conflict-retry"
+            >
+              {conflict.wanted ? 'Mark as done again' : 'Mark as open again'}
+            </Button>
+          ) : null}
+        </MeetingNoteActionItemConflictNotice>
+      ) : toggle.isError ? (
+        <p className="text-xs text-destructive" role="alert" data-testid="meeting-note-item-error">
+          {describeMeetingNoteItemError(toggle.error)}
+        </p>
+      ) : null}
+    </li>
+  );
+}
diff --git a/src/components/meeting-notes/MeetingNoteActionItems.tsx b/src/components/meeting-notes/MeetingNoteActionItems.tsx
new file mode 100644
index 0000000..5a4cc16
--- /dev/null
+++ b/src/components/meeting-notes/MeetingNoteActionItems.tsx
@@ -0,0 +1,97 @@
+// src/components/meeting-notes/MeetingNoteActionItems.tsx
+// The action items of a note (FR-011, BR-005, AC-008, AC-009). Editors add,
+// edit, and delete; editors and an item's current assignee toggle its
+// completion; everyone else reads. At most 100 items per note: the add
+// control says so before the route refuses. The routes and the database stay
+// the authority for every rule.
+'use client';
+
+import { Plus } from 'lucide-react';
+import { useMemo, useState } from 'react';
+
+import { Button } from '@/components/ui/button';
+import { useCompany } from '@/contexts/CompanyContext';
+import { useMeetingNotesScope } from '@/hooks/queries/useMeetingNotes';
+import { MEETING_NOTE_ITEM_LIMIT_MESSAGE } from '@/lib/meeting-notes/item-errors';
+import { MEETING_NOTE_LIMITS } from '@/lib/meeting-notes/validation';
+import type { MeetingNoteActionItemView, MeetingNoteDetail } from '@/types/meeting-notes';
+import { MeetingNoteActionItemForm } from './MeetingNoteActionItemForm';
+import { MeetingNoteActionItemRow } from './MeetingNoteActionItemRow';
+
+export interface MeetingNoteActionItemsProps {
+  note: MeetingNoteDetail;
+}
+
+/** BR-005: editors, and the item's assignee while they are a current member. */
+function canToggleItem(item: MeetingNoteActionItemView, canEdit: boolean, viewerId: string | null): boolean {
+  return canEdit || (viewerId !== null && item.assigneeId === viewerId && item.assigneeIsCurrentMember === true);
+}
+
+export function MeetingNoteActionItems({ note }: MeetingNoteActionItemsProps) {
+  const scope = useMeetingNotesScope();
+  const { companyUsers } = useCompany();
+  const membersById = useMemo(() => new Map(companyUsers.map((user) => [user.id, user])), [companyUsers]);
+  const [adding, setAdding] = useState(false);
+
+  const viewerId = scope?.userId ?? null;
+  const canEdit = note.rights.canEdit;
+  const count = note.actionItems.length;
+  const full = count >= MEETING_NOTE_LIMITS.maxItemsPerNote;
+
+  return (
+    <div className="flex flex-col gap-3" data-testid="meeting-note-action-items" data-count={count}>
+      {count === 0 ? (
+        <p className="text-sm text-muted-foreground">No action items.</p>
+      ) : (
+        <ul className="flex flex-col gap-2" aria-label="Action items">
+          {note.actionItems.map((item) => (
+            <MeetingNoteActionItemRow
+              key={item.id}
+              noteId={note.id}
+              item={item}
+              canEdit={canEdit}
+              canToggle={canToggleItem(item, canEdit, viewerId)}
+              members={companyUsers}
+              membersById={membersById}
+            />
+          ))}
+        </ul>
+      )}
+
+      {canEdit ? (
+        adding && !full ? (
+          <MeetingNoteActionItemForm
+            noteId={note.id}
+            members={companyUsers}
+            membersById={membersById}
+            onSaved={() => setAdding(false)}
+            onCancel={() => setAdding(false)}
+          />
+        ) : (
+          <div className="flex flex-wrap items-center gap-3">
+            <Button
+              type="button"
+              size="sm"
+              variant="outline"
+              className="h-8 gap-1.5"
+              disabled={full}
+              onClick={() => setAdding(true)}
+              data-testid="meeting-note-item-add"
+            >
+              <Plus className="size-3.5" aria-hidden="true" />
+              Add action item
+            </Button>
+            <span className="text-xs text-muted-foreground">
+              {count}/{MEETING_NOTE_LIMITS.maxItemsPerNote}
+            </span>
+            {full ? (
+              <p className="text-sm text-muted-foreground" role="status" data-testid="meeting-note-items-limit">
+                {MEETING_NOTE_ITEM_LIMIT_MESSAGE}
+              </p>
+            ) : null}
+          </div>
+        )
+      ) : null}
+    </div>
+  );
+}
