+// src/components/meeting-notes/SpaceNotesTab.tsx
+// The "Notes" tab of a space's detail surface (FR-003): the space's notes,
+// newest meeting date first, each opening its view, plus "New note".
+// Rendered inside the detail panel / bottom sheet, which are click-stop
+// surfaces (data-avatar-interactive); this root repeats the marker and stops
+// pointer/click propagation so nothing here can trigger room navigation.
+'use client';
+
+import Link from 'next/link';
+import { FileText, Loader2, Plus } from 'lucide-react';
+
+import { Button } from '@/components/ui/button';
+import { useSpaceMeetingNotes } from '@/hooks/queries/useMeetingNotes';
+import { formatMeetingDate } from '@/lib/meeting-notes/format';
+import { meetingNotePath, newMeetingNotePath } from '@/lib/meeting-notes/ui-paths';
+
+export interface SpaceNotesTabProps {
+  spaceId: string;
+  spaceName: string;
+}
+
+export function SpaceNotesTab({ spaceId, spaceName }: SpaceNotesTabProps) {
+  const notes = useSpaceMeetingNotes(spaceId);
+  const items = notes.data?.pages.flatMap((page) => page.items) ?? [];
+  const headingId = `space-notes-${spaceId}`;
+
+  return (
+    <div
+      className="flex min-h-0 flex-col gap-3"
+      data-avatar-interactive="true"
+      data-testid="space-notes-tab"
+      onPointerDown={(event) => event.stopPropagation()}
+      onClick={(event) => event.stopPropagation()}
+    >
+      <div className="flex items-center justify-between gap-2">
+        <h4 id={headingId} className="text-[11px] font-bold uppercase tracking-[0.12em] text-muted-foreground">
+          Meeting notes
+        </h4>
+        <Button asChild size="sm" variant="outline" className="h-8 gap-1.5">
+          <Link href={newMeetingNotePath(spaceId)} data-space-action aria-label={`New note in ${spaceName}`}>
+            <Plus className="size-3.5" aria-hidden="true" />
+            New note
+          </Link>
+        </Button>
+      </div>
+
+      {notes.isPending ? (
+        <p className="flex items-center gap-2 text-sm text-muted-foreground" role="status">
+          <Loader2 className="size-4 animate-spin" aria-hidden="true" />
+          Loading notes…
+        </p>
+      ) : notes.isError && items.length === 0 ? (
+        <div className="rounded-xl border border-[var(--vo-line-soft)] bg-[var(--vo-bg-2)] p-3 text-sm" role="alert">
+          <p className="text-muted-foreground">Notes could not be loaded.</p>
+          <Button type="button" size="sm" variant="ghost" className="mt-2 h-8" onClick={() => void notes.refetch()}>
+            Try again
+          </Button>
+        </div>
+      ) : items.length === 0 ? (
+        <p className="rounded-xl border border-dashed border-[var(--vo-line-soft)] p-4 text-center text-sm text-muted-foreground">
+          No notes for this space yet.
+        </p>
+      ) : (
+        <ul className="flex flex-col gap-2" aria-labelledby={headingId} data-testid="space-notes-list">
+          {items.map((note) => (
+            <li key={note.id}>
+              <Link
+                href={meetingNotePath(note.id)}
+                data-space-action
+                data-testid="space-note-item"
+                className="flex items-start gap-3 rounded-xl border border-[var(--vo-line-soft)] bg-[var(--vo-bg-2)] p-3 transition-colors hover:border-[var(--vo-line)] hover:bg-[var(--vo-hover-bg)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
+              >
+                <FileText className="mt-0.5 size-4 flex-none text-muted-foreground" aria-hidden="true" />
+                <span className="min-w-0 flex-1">
+                  <span className="block truncate text-sm font-semibold text-foreground">{note.title}</span>
+                  <span className="mt-0.5 block text-xs text-muted-foreground">
+                    <time dateTime={note.meetingDate}>{formatMeetingDate(note.meetingDate)}</time>
+                    <span aria-hidden="true"> · </span>
+                    {note.authorName}
+                  </span>
+                </span>
+              </Link>
+            </li>
+          ))}
+        </ul>
+      )}
+
+      {notes.isError && items.length > 0 ? (
+        <p className="text-xs text-destructive" role="alert">More notes could not be loaded.</p>
+      ) : null}
+
+      {notes.hasNextPage ? (
+        <Button
+          type="button"
+          size="sm"
+          variant="ghost"
+          className="h-8 self-center"
+          disabled={notes.isFetchingNextPage}
+          onClick={() => void notes.fetchNextPage()}
+        >
+          {notes.isFetchingNextPage ? 'Loading…' : 'Load more notes'}
+        </Button>
+      ) : null}
+    </div>
+  );
+}
diff --git a/src/components/meeting-notes/editor/MeetingNoteEditorToolbar.tsx b/src/components/meeting-notes/editor/MeetingNoteEditorToolbar.tsx
new file mode 100644
index 0000000..7f68404
--- /dev/null
+++ b/src/components/meeting-notes/editor/MeetingNoteEditorToolbar.tsx
@@ -0,0 +1,206 @@
+// src/components/meeting-notes/editor/MeetingNoteEditorToolbar.tsx
+// Formatting toolbar of the meeting-note editor (§13): every control has an
+// accessible name and a pressed state, Left/Right/Home/End move between
+// controls (roving tab stop), and buttons keep the editor's selection.
+'use client';
+
+import type { Editor } from '@tiptap/core';
+import { useEditorState } from '@tiptap/react';
+import {
+  Bold,
+  Heading1,
+  Heading2,
+  Heading3,
+  Italic,
+  List,
+  ListChecks,
+  ListOrdered,
+  Redo2,
+  Undo2,
+  type LucideIcon,
+} from 'lucide-react';
+import { useRef, useState, type KeyboardEvent } from 'react';
+
+import { MeetingNoteLinkControl } from './MeetingNoteLinkControl';
+import { toolbarButtonClass } from './toolbar-styles';
+
+interface ToolbarState {
+  bold: boolean;
+  italic: boolean;
+  h1: boolean;
+  h2: boolean;
+  h3: boolean;
+  bulletList: boolean;
+  orderedList: boolean;
+  taskList: boolean;
+  link: boolean;
+  linkHref: string;
+  canUndo: boolean;
+  canRedo: boolean;
+}
+
+const EMPTY_STATE: ToolbarState = {
+  bold: false,
+  italic: false,
+  h1: false,
+  h2: false,
+  h3: false,
+  bulletList: false,
+  orderedList: false,
+  taskList: false,
+  link: false,
+  linkHref: '',
+  canUndo: false,
+  canRedo: false,
+};
+
+interface ToggleSpec {
+  key: keyof Pick<ToolbarState, 'bold' | 'italic' | 'h1' | 'h2' | 'h3' | 'bulletList' | 'orderedList' | 'taskList'>;
+  label: string;
+  icon: LucideIcon;
+  run: (editor: Editor) => void;
+}
+
+const TOGGLES: ToggleSpec[] = [
+  { key: 'bold', label: 'Bold', icon: Bold, run: (e) => e.chain().focus().toggleBold().run() },
+  { key: 'italic', label: 'Italic', icon: Italic, run: (e) => e.chain().focus().toggleItalic().run() },
+  { key: 'h1', label: 'Heading 1', icon: Heading1, run: (e) => e.chain().focus().toggleHeading({ level: 1 }).run() },
+  { key: 'h2', label: 'Heading 2', icon: Heading2, run: (e) => e.chain().focus().toggleHeading({ level: 2 }).run() },
+  { key: 'h3', label: 'Heading 3', icon: Heading3, run: (e) => e.chain().focus().toggleHeading({ level: 3 }).run() },
+  { key: 'bulletList', label: 'Bulleted list', icon: List, run: (e) => e.chain().focus().toggleBulletList().run() },
+  { key: 'orderedList', label: 'Numbered list', icon: ListOrdered, run: (e) => e.chain().focus().toggleOrderedList().run() },
+  { key: 'taskList', label: 'Checklist', icon: ListChecks, run: (e) => e.chain().focus().toggleTaskList().run() },
+];
+
+export interface MeetingNoteEditorToolbarProps {
+  editor: Editor | null;
+  editorId: string;
+  disabled: boolean;
+}
+
+export function MeetingNoteEditorToolbar({ editor, editorId, disabled }: MeetingNoteEditorToolbarProps) {
+  const toolbarRef = useRef<HTMLDivElement>(null);
+  const [focusIndex, setFocusIndex] = useState(0);
+
+  const state =
+    useEditorState({
+      editor,
+      selector: ({ editor: current }): ToolbarState => {
+        if (!current) return EMPTY_STATE;
+        return {
+          bold: current.isActive('bold'),
+          italic: current.isActive('italic'),
+          h1: current.isActive('heading', { level: 1 }),
+          h2: current.isActive('heading', { level: 2 }),
+          h3: current.isActive('heading', { level: 3 }),
+          bulletList: current.isActive('bulletList'),
+          orderedList: current.isActive('orderedList'),
+          taskList: current.isActive('taskList'),
+          link: current.isActive('link'),
+          linkHref: String(current.getAttributes('link').href ?? ''),
+          canUndo: current.can().undo(),
+          canRedo: current.can().redo(),
+        };
+      },
+    }) ?? EMPTY_STATE;
+
+  const inactive = disabled || !editor;
+
+  const controls = (): HTMLElement[] =>
+    Array.from(toolbarRef.current?.querySelectorAll<HTMLElement>('[data-toolbar-control]:not(:disabled)') ?? []);
+
+  const onKeyDown = (event: KeyboardEvent<HTMLDivElement>) => {
+    const items = controls();
+    if (items.length === 0) return;
+    const current = items.indexOf(document.activeElement as HTMLElement);
+    let next = -1;
+    if (event.key === 'ArrowRight') next = (current + 1) % items.length;
+    else if (event.key === 'ArrowLeft') next = (current - 1 + items.length) % items.length;
+    else if (event.key === 'Home') next = 0;
+    else if (event.key === 'End') next = items.length - 1;
+    if (next < 0) return;
+    event.preventDefault();
+    items[next]?.focus();
+  };
+
+  // Roving tab stop: control indexes in DOM order (toggles, link, undo, redo).
+  const LINK_INDEX = TOGGLES.length;
+  const UNDO_INDEX = LINK_INDEX + 1;
+  const REDO_INDEX = LINK_INDEX + 2;
+  const undoDisabled = inactive || !state.canUndo;
+  const redoDisabled = inactive || !state.canRedo;
+  const tabStop =
+    (focusIndex === UNDO_INDEX && undoDisabled) || (focusIndex === REDO_INDEX && redoDisabled) ? 0 : focusIndex;
+  const tabIndexFor = (control: number) => (control === tabStop ? 0 : -1);
+  const indexOf = (control: number) => () => setFocusIndex(control);
+
+  return (
+    <div
+      ref={toolbarRef}
+      role="toolbar"
+      aria-label="Formatting"
+      aria-controls={editorId}
+      className="flex flex-wrap items-center gap-0.5 border-b border-input bg-muted/40 px-1.5 py-1"
+      onKeyDown={onKeyDown}
+    >
+      {TOGGLES.map((toggle, own) => {
+        const Icon = toggle.icon;
+        return (
+          <button
+            key={toggle.key}
+            type="button"
+            data-toolbar-control
+            className={toolbarButtonClass}
+            aria-label={toggle.label}
+            title={toggle.label}
+            aria-pressed={state[toggle.key]}
+            disabled={inactive}
+            tabIndex={tabIndexFor(own)}
+            onFocus={indexOf(own)}
+            onMouseDown={(event) => event.preventDefault()}
+            onClick={() => editor && toggle.run(editor)}
+          >
+            <Icon className="size-4" aria-hidden="true" />
+          </button>
+        );
+      })}
+      <MeetingNoteLinkControl
+        editor={editor}
+        disabled={inactive}
+        active={state.link}
+        currentHref={state.linkHref}
+        tabIndex={tabIndexFor(LINK_INDEX)}
+        onFocus={indexOf(LINK_INDEX)}
+      />
+      <span className="mx-1 h-5 w-px bg-border" aria-hidden="true" />
+      <button
+        type="button"
+        data-toolbar-control
+        className={toolbarButtonClass}
+        aria-label="Undo"
+        title="Undo"
+        disabled={undoDisabled}
+        tabIndex={tabIndexFor(UNDO_INDEX)}
+        onFocus={indexOf(UNDO_INDEX)}
+        onMouseDown={(event) => event.preventDefault()}
+        onClick={() => editor?.chain().focus().undo().run()}
+      >
+        <Undo2 className="size-4" aria-hidden="true" />
+      </button>
+      <button
+        type="button"
+        data-toolbar-control
+        className={toolbarButtonClass}
+        aria-label="Redo"
+        title="Redo"
+        disabled={redoDisabled}
+        tabIndex={tabIndexFor(REDO_INDEX)}
+        onFocus={indexOf(REDO_INDEX)}
+        onMouseDown={(event) => event.preventDefault()}
+        onClick={() => editor?.chain().focus().redo().run()}
+      >
+        <Redo2 className="size-4" aria-hidden="true" />
+      </button>
+    </div>
+  );
+}
diff --git a/src/components/meeting-notes/editor/MeetingNoteLinkControl.tsx b/src/components/meeting-notes/editor/MeetingNoteLinkControl.tsx
new file mode 100644
index 0000000..e1bb85f
--- /dev/null
+++ b/src/components/meeting-notes/editor/MeetingNoteLinkControl.tsx
@@ -0,0 +1,140 @@
+// src/components/meeting-notes/editor/MeetingNoteLinkControl.tsx
+// Toolbar control that adds, changes, or removes a link (FR-002): only
+// http, https, and mailto targets are accepted; "example.com" becomes
+// https://example.com and "ana@example.com" becomes mailto:ana@example.com.
+'use client';
+
+import type { Editor } from '@tiptap/core';
+import { Link2 } from 'lucide-react';
+import { useId, useState, type KeyboardEvent } from 'react';
+
+import { Button } from '@/components/ui/button';
+import { Input } from '@/components/ui/input';
+import { Label } from '@/components/ui/label';
+import { Popover, PopoverContent, PopoverTrigger } from '@/components/ui/popover';
+import { normalizeMeetingNoteLinkInput } from '@/lib/meeting-notes/link-url';
+import { toolbarButtonClass } from './toolbar-styles';
+
+export interface MeetingNoteLinkControlProps {
+  editor: Editor | null;
+  disabled: boolean;
+  active: boolean;
+  currentHref: string;
+  tabIndex: number;
+  onFocus: () => void;
+}
+
+export function MeetingNoteLinkControl({
+  editor,
+  disabled,
+  active,
+  currentHref,
+  tabIndex,
+  onFocus,
+}: MeetingNoteLinkControlProps) {
+  const inputId = useId();
+  const errorId = useId();
+  const [open, setOpen] = useState(false);
+  const [value, setValue] = useState('');
+  const [error, setError] = useState<string | null>(null);
+
+  const onOpenChange = (next: boolean) => {
+    if (next) {
+      setValue(currentHref);
+      setError(null);
+    }
+    setOpen(next);
+  };
+
+  const apply = () => {
+    if (!editor) return;
+    const href = normalizeMeetingNoteLinkInput(value);
+    if (!href) {
+      setError('Enter a web address (http or https) or an email address.');
+      return;
+    }
+    const chain = editor.chain().focus().extendMarkRange('link');
+    if (editor.state.selection.empty && !active) {
+      // No selected text: insert the address itself as the link text.
+      chain.insertContent({ type: 'text', text: href, marks: [{ type: 'link', attrs: { href } }] }).run();
+    } else {
+      chain.setLink({ href }).run();
+    }
+    setOpen(false);
+  };
+
+  const remove = () => {
+    editor?.chain().focus().extendMarkRange('link').unsetLink().run();
+    setOpen(false);
+  };
+
+  const onInputKeyDown = (event: KeyboardEvent<HTMLInputElement>) => {
+    if (event.key === 'Enter') {
+      event.preventDefault();
+      apply();
+    }
+  };
+
+  return (
+    <Popover open={open} onOpenChange={onOpenChange}>
+      <PopoverTrigger asChild>
+        <button
+          type="button"
+          data-toolbar-control
+          className={toolbarButtonClass}
+          aria-label="Link"
+          title="Link"
+          aria-pressed={active}
+          disabled={disabled}
+          tabIndex={tabIndex}
+          onFocus={onFocus}
+          onMouseDown={(event) => event.preventDefault()}
+        >
+          <Link2 className="size-4" aria-hidden="true" />
+        </button>
+      </PopoverTrigger>
+      <PopoverContent
+        align="start"
+        className="w-80"
+        onKeyDown={(event) => event.stopPropagation()}
+        onCloseAutoFocus={(event) => {
+          // Return to the text, not to the toolbar button.
+          event.preventDefault();
+          editor?.commands.focus();
+        }}
+      >
+        <div className="flex flex-col gap-2">
+          <Label htmlFor={inputId}>Link address</Label>
+          <Input
+            id={inputId}
+            value={value}
+            placeholder="https://example.com"
+            autoComplete="off"
+            aria-invalid={error ? 'true' : 'false'}
+            aria-describedby={error ? errorId : undefined}
+            onChange={(event) => {
+              setValue(event.target.value);
+              setError(null);
+            }}
+            onKeyDown={onInputKeyDown}
+          />
+          {error ? (
+            <p id={errorId} className="text-xs text-destructive" role="alert">
+              {error}
+            </p>
+          ) : null}
+          <div className="flex justify-end gap-2">
+            {active ? (
+              <Button type="button" size="sm" variant="ghost" onClick={remove}>
+                Remove link
+              </Button>
+            ) : null}
+            <Button type="button" size="sm" onClick={apply}>
+              Apply
+            </Button>
+          </div>
+        </div>
+      </PopoverContent>
+    </Popover>
+  );
+}
diff --git a/src/components/meeting-notes/editor/MeetingNoteRichTextEditor.tsx b/src/components/meeting-notes/editor/MeetingNoteRichTextEditor.tsx
new file mode 100644
index 0000000..461974e
--- /dev/null
+++ b/src/components/meeting-notes/editor/MeetingNoteRichTextEditor.tsx
@@ -0,0 +1,108 @@
+// src/components/meeting-notes/editor/MeetingNoteRichTextEditor.tsx
+// The meeting-note rich-text editor (FR-002): Tiptap limited to the SPEC's
+// formatting set (meeting-note-extensions.ts). Client-only; load it through
+// MeetingNoteRichTextEditorLazy so server rendering never touches Tiptap.
+// Emits '' for an empty document, otherwise the editor HTML; the routes
+// sanitize it again on write and the views sanitize it again on render.
+'use client';
+
+import { EditorContent, useEditor } from '@tiptap/react';
+import { useEffect, useRef } from 'react';
+
+import { cn } from '@/lib/utils';
+import styles from '../meeting-note-content.module.css';
+import { createMeetingNoteExtensions } from './meeting-note-extensions';
+import { MeetingNoteEditorToolbar } from './MeetingNoteEditorToolbar';
+
+export interface MeetingNoteRichTextEditorProps {
+  /** id of the editable surface. */
+  id: string;
+  /** id of the visible label of the field. */
+  labelId: string;
+  /** ids of the help / error texts. */
+  describedById?: string;
+  /** Saved (sanitized) HTML to start from; later changes of this prop are ignored (remount to reset). */
+  initialContent: string;
+  invalid?: boolean;
+  disabled?: boolean;
+  placeholder?: string;
+  onChange: (html: string) => void;
+}
+
+export default function MeetingNoteRichTextEditor({
+  id,
+  labelId,
+  describedById,
+  initialContent,
+  invalid = false,
+  disabled = false,
+  placeholder = 'Write the meeting notes…',
+  onChange,
+}: MeetingNoteRichTextEditorProps) {
+  const onChangeRef = useRef(onChange);
+  useEffect(() => {
+    onChangeRef.current = onChange;
+  }, [onChange]);
+
+  const editor = useEditor({
+    immediatelyRender: false,
+    shouldRerenderOnTransaction: false,
+    editable: !disabled,
+    extensions: createMeetingNoteExtensions(placeholder),
+    content: initialContent,
+    editorProps: {
+      attributes: {
+        id,
+        role: 'textbox',
+        'aria-multiline': 'true',
+        'aria-labelledby': labelId,
+        ...(describedById ? { 'aria-describedby': describedById } : {}),
+        'aria-invalid': invalid ? 'true' : 'false',
+        'data-testid': 'meeting-note-editor',
+        class: cn(styles.content, styles.editor),
+      },
+    },
+    onCreate: ({ editor: created }) => {
+      onChangeRef.current(created.isEmpty ? '' : created.getHTML());
+    },
+    onUpdate: ({ editor: updated }) => {
+      onChangeRef.current(updated.isEmpty ? '' : updated.getHTML());
+    },
+  });
+
+  useEffect(() => {
+    if (!editor) return;
+    editor.setEditable(!disabled);
+  }, [editor, disabled]);
+
+  useEffect(() => {
+    if (!editor) return;
+    editor.setOptions({
+      editorProps: {
+        attributes: {
+          ...((editor.options.editorProps?.attributes as Record<string, string> | undefined) ?? {}),
+          'aria-invalid': invalid ? 'true' : 'false',
+        },
+      },
+    });
+  }, [editor, invalid]);
+
+  return (
+    <div
+      className={cn(
+        'overflow-hidden rounded-md border bg-background focus-within:ring-2 focus-within:ring-ring',
+        invalid ? 'border-destructive' : 'border-input',
+        disabled && 'opacity-70'
+      )}
+    >
+      <MeetingNoteEditorToolbar editor={editor} editorId={id} disabled={disabled} />
+      {editor ? (
+        <EditorContent editor={editor} />
+      ) : (
+        <div className={cn(styles.editor, 'text-sm text-muted-foreground')} aria-hidden="true">
+          Loading editor…
+        </div>
+      )}
+    </div>
+  );
+}
diff --git a/src/components/meeting-notes/editor/meeting-note-extensions.ts b/src/components/meeting-notes/editor/meeting-note-extensions.ts
