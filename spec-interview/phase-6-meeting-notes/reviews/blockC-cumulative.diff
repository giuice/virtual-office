diff --git a/__tests__/api/playwright/meeting-notes/meetings-search.spec.ts b/__tests__/api/playwright/meeting-notes/meetings-search.spec.ts
new file mode 100644
index 0000000..f8c260c
--- /dev/null
+++ b/__tests__/api/playwright/meeting-notes/meetings-search.spec.ts
@@ -0,0 +1,160 @@
+import type { Locator, Page } from '@playwright/test';
+
+import { expect, test } from '../fixtures/meeting-notes';
+import { daysAgo, localDay, MEETING_NOTES_E2E_PREFIX, uniqueSearchWord } from '../helpers/meeting-notes-e2e';
+
+/**
+ * AC-014 UI path (FR-004, FR-026, BR-001): the Meetings page search box,
+ * space and period filters, highlighted text-only excerpts, pagination, and
+ * company isolation. Ranking, languages, and timing at 1,000 notes are proven
+ * by the DB integration suite; this spec drives the same route through the UI.
+ */
+
+function results(page: Page): Locator {
+  return page.getByTestId('meeting-note-result');
+}
+
+function resultFor(page: Page, title: string): Locator {
+  return results(page).filter({ hasText: title });
+}
+
+async function search(page: Page, text: string): Promise<void> {
+  await page.getByLabel('Search notes', { exact: true }).fill(text);
+}
+
+test.describe('meeting notes — Meetings page search (AC-014)', () => {
+  test('finds notes by title, content, and action item with filters, highlights, paging, and isolation', async ({
+    primaryPage,
+    secondaryPage,
+    notesWorld,
+  }) => {
+    test.slow();
+    const word = uniqueSearchWord();
+    const pagingWord = uniqueSearchWord();
+    const spaceOne = await notesWorld.createSpace('Search room one');
+    const spaceTwo = await notesWorld.createSpace('Search room two');
+    const pagingSpace = await notesWorld.createSpace('Search paging room');
+
+    const titleNote = `${MEETING_NOTES_E2E_PREFIX} Orçamento ${word}`;
+    const contentNote = `${MEETING_NOTES_E2E_PREFIX} Kickoff ${notesWorld.runTag}`;
+    const itemNote = `${MEETING_NOTES_E2E_PREFIX} Planning ${notesWorld.runTag}`;
+    const markupNote = `${MEETING_NOTES_E2E_PREFIX} Symbols ${notesWorld.runTag}`;
+    const otherCompanyNote = `${MEETING_NOTES_E2E_PREFIX} Orçamento ${word} company B`;
+
+    await notesWorld.createNote(primaryPage, {
+      spaceId: spaceOne.id,
+      title: titleNote,
+      meetingDate: new Date(),
+      content: '<p>Pauta geral</p>',
+    });
+    await notesWorld.createNote(primaryPage, {
+      spaceId: spaceTwo.id,
+      title: contentNote,
+      meetingDate: daysAgo(40),
+      content: `<p>Revisão do orçamento ${word} trimestral</p>`,
+    });
+    const itemNoteId = await notesWorld.createNote(primaryPage, {
+      spaceId: spaceOne.id,
+      title: itemNote,
+      meetingDate: daysAgo(2),
+      content: '<p>General planning</p>',
+    });
+    await notesWorld.addActionItem(primaryPage, itemNoteId, `Send the budget report ${word}`);
+    // Text that looks like markup must reach the excerpt as text only.
+    await notesWorld.createNote(primaryPage, {
+      spaceId: spaceTwo.id,
+      title: markupNote,
+      meetingDate: daysAgo(3),
+      content: `<p>&lt;img src=x onerror="window.__mnXss=1"&gt; ${word} markup</p>`,
+    });
+    await notesWorld.createOtherCompanyNote({
+      title: otherCompanyNote,
+      content: `<p>Revisão do orçamento ${word} budget</p>`,
+    });
+    for (let index = 1; index <= 21; index += 1) {
+      await notesWorld.createNote(primaryPage, {
+        spaceId: pagingSpace.id,
+        title: `${MEETING_NOTES_E2E_PREFIX} Paging ${index} ${notesWorld.runTag}`,
+        meetingDate: daysAgo(index),
+        content: `<p>Paging ${pagingWord}</p>`,
+      });
+    }
+
+    const page = secondaryPage;
+    await page.goto('/meetings');
+    await expect(page.getByRole('heading', { name: 'Meetings' })).toBeVisible({ timeout: 30_000 });
+    await expect(page.getByRole('search', { name: 'Search meeting notes' })).toBeVisible();
+
+    // Portuguese without the accent matches the title and the content.
+    await search(page, `orcamento ${word}`);
+    await expect(resultFor(page, titleNote)).toHaveCount(1, { timeout: 15_000 });
+    await expect(resultFor(page, contentNote)).toHaveCount(1);
+    await expect(resultFor(page, itemNote)).toHaveCount(0);
+    await expect(results(page).filter({ hasText: 'company B' })).toHaveCount(0);
+    const contentExcerpt = resultFor(page, contentNote).getByTestId('meeting-note-excerpt');
+    await expect(contentExcerpt).toContainText('Notes:');
+    await expect(contentExcerpt.locator('mark').filter({ hasText: /orçamento/i })).toHaveCount(1);
+    await expect(contentExcerpt.locator('mark').filter({ hasText: word })).toHaveCount(1);
+    await expect(resultFor(page, contentNote)).toContainText(spaceTwo.name);
+
+    // English with different case matches the action-item description.
+    await search(page, `BUDGET ${word.toUpperCase()}`);
+    await expect(resultFor(page, itemNote)).toHaveCount(1, { timeout: 15_000 });
+    await expect(resultFor(page, itemNote).getByTestId('meeting-note-excerpt')).toContainText('Action item:');
+    await expect(results(page).filter({ hasText: 'company B' })).toHaveCount(0);
+
+    // Markup-looking text is shown as text; no element is created from it.
+    await search(page, `markup ${word}`);
+    const markupResult = resultFor(page, markupNote);
+    await expect(markupResult).toHaveCount(1, { timeout: 15_000 });
+    await expect(markupResult.getByTestId('meeting-note-excerpt')).toContainText('<img src=x');
+    await expect(page.getByTestId('meeting-notes-results').locator('img')).toHaveCount(0);
+    expect(await page.evaluate(() => (window as unknown as { __mnXss?: number }).__mnXss)).toBeUndefined();
+
+    // Every note of company A with the word; none of company B.
+    await search(page, word);
+    await expect(results(page)).toHaveCount(4, { timeout: 15_000 });
+    await expect(results(page).filter({ hasText: 'company B' })).toHaveCount(0);
+
+    // Space filter.
+    await page.getByLabel('Space', { exact: true }).selectOption({ label: spaceOne.name });
+    await expect(results(page)).toHaveCount(2, { timeout: 15_000 });
+    await expect(resultFor(page, titleNote)).toHaveCount(1);
+    await expect(resultFor(page, itemNote)).toHaveCount(1);
+
+    // "Space removed" filter: none of these notes lost their space.
+    await page.getByLabel('Space', { exact: true }).selectOption({ label: 'Space removed' });
+    await expect(page.getByText('No notes match this search.')).toBeVisible({ timeout: 15_000 });
+
+    // Period filter (local days; the 40-day-old note falls outside).
+    await page.getByLabel('Space', { exact: true }).selectOption({ label: 'All spaces' });
+    await page.getByLabel('Meeting from').fill(localDay(daysAgo(7)));
+    await page.getByLabel('Meeting to').fill(localDay(new Date()));
+    await expect(results(page)).toHaveCount(3, { timeout: 15_000 });
+    await expect(resultFor(page, contentNote)).toHaveCount(0);
+
+    // An inverted period is refused in the page.
+    await page.getByLabel('Meeting from').fill(localDay(new Date()));
+    await page.getByLabel('Meeting to').fill(localDay(daysAgo(7)));
+    await expect(page.getByText('The start date must be on or before the end date.')).toBeVisible();
+    await page.getByLabel('Meeting from').fill('');
+    await page.getByLabel('Meeting to').fill('');
+
+    // List mode (empty search) within a space: newest meeting first.
+    await search(page, '');
+    await page.getByLabel('Space', { exact: true }).selectOption({ label: spaceOne.name });
+    await expect(results(page)).toHaveCount(2, { timeout: 15_000 });
+    await expect(results(page).nth(0)).toContainText(titleNote);
+    await expect(results(page).nth(1)).toContainText(itemNote);
+    await expect(results(page).first().getByTestId('meeting-note-excerpt')).toHaveCount(0);
+
+    // Pagination: 21 matches, 20 per page, then "Load more".
+    await page.getByLabel('Space', { exact: true }).selectOption({ label: 'All spaces' });
+    await search(page, pagingWord);
+    await expect(results(page)).toHaveCount(20, { timeout: 15_000 });
+    await expect(page.getByTestId('meeting-notes-count')).toHaveText('21 notes');
+    await page.getByRole('button', { name: 'Load more' }).click();
+    await expect(results(page)).toHaveCount(21, { timeout: 15_000 });
+    await expect(page.getByRole('button', { name: 'Load more' })).toHaveCount(0);
+  });
+});
diff --git a/__tests__/api/playwright/meeting-notes/note-action-items.spec.ts b/__tests__/api/playwright/meeting-notes/note-action-items.spec.ts
new file mode 100644
index 0000000..1c2ea2d
--- /dev/null
+++ b/__tests__/api/playwright/meeting-notes/note-action-items.spec.ts
@@ -0,0 +1,114 @@
+import { expect, test } from '../fixtures/meeting-notes';
+import { MEETING_NOTES_E2E_PREFIX } from '../helpers/meeting-notes-e2e';
+import { actionItemRow, fillActionItemForm, openNote, saveActionItemForm } from '../helpers/meeting-notes-ui';
+
+/**
+ * AC-008, UI part (FR-011, BR-005): the note's editor (primary, the author)
+ * adds, edits, and deletes action items with description, assignee, and due
+ * date, each change shown at once. The assignee (secondary, a member who is
+ * not an editor) can toggle completion of their own item but sees no edit or
+ * delete control, and sees another person's item read-only (status only).
+ * The route and database denials of the same attempts are covered by the DB
+ * integration suite (T3).
+ */
+test.describe('meeting notes — action items in the UI (AC-008)', () => {
+  test('editor adds, edits, and deletes items; the assignee only toggles completion of their own item', async ({
+    primaryPage,
+    secondaryPage,
+    messagingData,
+    notesWorld,
+  }) => {
+    const space = await notesWorld.createSpace('Items room');
+    const tag = notesWorld.runTag;
+    const noteId = await notesWorld.createNote(primaryPage, {
+      spaceId: space.id,
+      title: `${MEETING_NOTES_E2E_PREFIX} Items ${tag}`,
+      meetingDate: new Date(),
+      content: '<p>Items agenda</p>',
+    });
+    const secondaryName = await notesWorld.displayNameOf(messagingData.secondary.userId);
+    const other = await notesWorld.createCompanyMember('Other assignee');
+
+    // --- Editor (primary) ---
+    const editor = primaryPage;
+    await openNote(editor, noteId);
+    await expect(editor.getByTestId('meeting-note-action-items')).toContainText('No action items.');
+
+    // Add: description, assignee (the secondary member), due date.
+    await editor.getByTestId('meeting-note-item-add').click();
+    await fillActionItemForm(editor, {
+      description: `Send the minutes ${tag}`,
+      assignee: secondaryName,
+      dueDate: '2026-11-05',
+    });
+    await saveActionItemForm(editor);
+    const mine = actionItemRow(editor, `Send the minutes ${tag}`);
+    await expect(mine).toHaveCount(1);
+    await expect(mine.getByTestId('meeting-note-item-assignee')).toContainText(secondaryName);
+    await expect(mine.getByTestId('meeting-note-item-due')).toHaveText('Due 2026-11-05');
+    await expect(mine.getByTestId('meeting-note-item-status')).toHaveText('Open');
+
+    // Edit: description and due date; the assignee is kept.
+    await mine.getByTestId('meeting-note-item-edit').click();
+    await fillActionItemForm(editor, { description: `Send the final minutes ${tag}`, dueDate: '2026-11-06' });
+    await saveActionItemForm(editor);
+    const edited = actionItemRow(editor, `Send the final minutes ${tag}`);
+    await expect(edited).toHaveCount(1);
+    await expect(edited.getByTestId('meeting-note-item-due')).toHaveText('Due 2026-11-06');
+    await expect(edited.getByTestId('meeting-note-item-assignee')).toContainText(secondaryName);
+    await expect(actionItemRow(editor, `Send the minutes ${tag}`)).toHaveCount(0);
+
+    // A second item for someone else, and a third one that is deleted.
+    await editor.getByTestId('meeting-note-item-add').click();
+    await fillActionItemForm(editor, { description: `Book the room ${tag}`, assignee: other.displayName });
+    await saveActionItemForm(editor);
+    await expect(actionItemRow(editor, `Book the room ${tag}`).getByTestId('meeting-note-item-due')).toHaveText('No due date');
+
+    await editor.getByTestId('meeting-note-item-add').click();
+    await fillActionItemForm(editor, { description: `Temporary item ${tag}` });
+    await saveActionItemForm(editor);
+    const temporary = actionItemRow(editor, `Temporary item ${tag}`);
+    await expect(temporary).toHaveCount(1);
+    await temporary.getByTestId('meeting-note-item-delete').click();
+    const confirm = editor.getByRole('alertdialog');
+    await expect(confirm).toContainText(`Temporary item ${tag}`);
+    await confirm.getByTestId('meeting-note-item-delete-confirm').click();
+    await expect(temporary).toHaveCount(0);
+
+    // The stored state matches what was shown.
+    const stored = await notesWorld.readNote(editor, noteId);
+    expect(stored.note?.actionItems.map((item) => [item.description, item.assigneeId, item.dueDate, item.completed])).toEqual([
+      [`Send the final minutes ${tag}`, messagingData.secondary.userId, '2026-11-06', false],
+      [`Book the room ${tag}`, other.id, null, false],
+    ]);
+
+    // --- Assignee (secondary, not an editor) ---
+    const assignee = secondaryPage;
+    await openNote(assignee, noteId);
+    await expect(assignee.getByTestId('meeting-note-edit-button')).toHaveCount(0);
+    await expect(assignee.getByTestId('meeting-note-item-add')).toHaveCount(0);
+    await expect(assignee.getByTestId('meeting-note-item-edit')).toHaveCount(0);
+    await expect(assignee.getByTestId('meeting-note-item-delete')).toHaveCount(0);
+
+    // Their own item: the completion toggle works.
+    const own = actionItemRow(assignee, `Send the final minutes ${tag}`);
+    const toggle = own.getByTestId('meeting-note-item-toggle');
+    await expect(toggle).toBeEnabled();
+    await expect(toggle).not.toBeChecked();
+    await toggle.check();
+    await expect(own.getByTestId('meeting-note-item-status')).toHaveText('Done');
+    await expect(own).toHaveAttribute('data-completed', 'true');
+
+    // Someone else's item: status only.
+    const theirs = actionItemRow(assignee, `Book the room ${tag}`);
+    await expect(theirs.getByTestId('meeting-note-item-status')).toHaveText('Open');
+    await expect(theirs.getByTestId('meeting-note-item-toggle')).toHaveCount(0);
+
+    const afterToggle = await notesWorld.readNote(editor, noteId);
+    expect(afterToggle.note?.actionItems.find((item) => item.description === `Send the final minutes ${tag}`)?.completed).toBe(true);
+
+    // The editor sees the completion after reloading.
+    await openNote(editor, noteId);
+    await expect(actionItemRow(editor, `Send the final minutes ${tag}`).getByTestId('meeting-note-item-status')).toHaveText('Done');
+  });
+});
diff --git a/__tests__/api/playwright/meeting-notes/note-conflict.spec.ts b/__tests__/api/playwright/meeting-notes/note-conflict.spec.ts
new file mode 100644
index 0000000..0c17956
--- /dev/null
+++ b/__tests__/api/playwright/meeting-notes/note-conflict.spec.ts
@@ -0,0 +1,77 @@
+import { expect, test } from '../fixtures/meeting-notes';
+import { MEETING_NOTES_E2E_PREFIX } from '../helpers/meeting-notes-e2e';
+import { noteEditor, openNote, replaceEditorText } from '../helpers/meeting-notes-ui';
+
+/**
+ * AC-005, UI part (FR-007, BR-011): two editors open the same revision; the
+ * first save wins; the second gets the conflict warning showing the newer
+ * state, with its own unsaved text still available, and nothing is
+ * overwritten. Loading the newer version shows it in the form and keeps the
+ * user's earlier text visible. (Restore-vs-save and attach-vs-apply races are
+ * covered at the database level.)
+ */
+test.describe('meeting notes — concurrent edits (AC-005)', () => {
+  test('the second save of the same revision shows the conflict and keeps the first change', async ({
+    primaryPage,
+    secondaryPage,
+    messagingData,
+    notesWorld,
+  }) => {
+    const space = await notesWorld.createSpace('Conflict room');
+    const title = `${MEETING_NOTES_E2E_PREFIX} Conflict ${notesWorld.runTag}`;
+    const noteId = await notesWorld.createNote(primaryPage, {
+      spaceId: space.id,
+      title,
+      meetingDate: new Date(),
+      content: '<p>Original text</p>',
+      participantIds: [messagingData.secondary.userId],
+    });
+
+    const first = primaryPage;
+    const second = secondaryPage;
+    // Both open the editor on revision 1.
+    for (const page of [first, second]) {
+      const view = await openNote(page, noteId);
+      await expect(view).toHaveAttribute('data-revision', '1');
+      await page.getByTestId('meeting-note-edit-button').click();
+      await noteEditor(page);
+    }
+
+    const firstText = `Admin decision ${notesWorld.runTag}`;
+    const secondText = `Member decision ${notesWorld.runTag}`;
+
+    await replaceEditorText(first, firstText);
+    await first.getByTestId('meeting-note-submit').click();
+    const firstView = first.getByTestId('meeting-note-view');
+    await expect(firstView).toBeVisible({ timeout: 30_000 });
+    await expect(firstView).toHaveAttribute('data-revision', '2');
+    await expect(first.getByTestId('meeting-note-content')).toContainText(firstText);
+
+    await replaceEditorText(second, secondText);
+    await second.getByTestId('meeting-note-submit').click();
+
+    const dialog = second.getByTestId('meeting-note-conflict-dialog');
+    await expect(dialog).toBeVisible({ timeout: 30_000 });
+    await expect(dialog.getByRole('heading', { name: 'This note was changed by someone else' })).toBeVisible();
+    await expect(dialog.getByTestId('meeting-note-conflict-newer')).toContainText('Revision 2');
+    await expect(dialog.getByTestId('meeting-note-conflict-newer-title')).toHaveText(title);
+    await expect(dialog.getByTestId('meeting-note-conflict-newer-content')).toContainText(firstText);
+    // The user's own text is not lost.
+    await expect(dialog.getByTestId('meeting-note-conflict-mine')).toHaveValue(new RegExp(secondText));
+
+    // Nothing was overwritten: the first change is intact on the server.
+    const current = await notesWorld.readNote(first, noteId);
+    expect(current.note?.revision).toBe(2);
+    expect(current.note?.content).toContain(firstText);
+    expect(current.note?.content).not.toContain(secondText);
+
+    // Loading the newer version puts it in the form; the earlier text stays visible.
+    await dialog.getByRole('button', { name: 'Load newer version' }).click();
+    await expect(dialog).toBeHidden();
+    await expect(await noteEditor(second)).toContainText(firstText);
+    await expect(second.getByTestId('meeting-note-unsaved-backup')).toContainText('Your earlier unsaved text');
+    await expect(second.getByTestId('meeting-note-unsaved-backup').getByRole('textbox')).toHaveValue(
+      new RegExp(secondText),
+    );
+  });
+});
