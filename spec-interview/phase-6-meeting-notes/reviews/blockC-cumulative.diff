+// src/lib/meeting-notes/ai/settings-limits.ts
+// Limits of the company AI settings (Phase 6 FR-024), shared by the route and
+// the admin form. The database enforces the same bounds
+// (migration 20261013142351_meeting_notes_ai_settings.sql).
+
+/** Daily limit of a company that never saved AI settings. */
+export const MEETING_NOTE_AI_DEFAULT_DAILY_LIMIT = 20;
+export const MEETING_NOTE_AI_MIN_DAILY_LIMIT = 1;
+export const MEETING_NOTE_AI_MAX_DAILY_LIMIT = 200;
+
+export const MEETING_NOTE_AI_KEY_MIN_LENGTH = 8;
+export const MEETING_NOTE_AI_KEY_MAX_LENGTH = 512;
+
+/** Printable ASCII without spaces (what provider API keys consist of). */
+export const MEETING_NOTE_AI_KEY_PATTERN = /^[\x21-\x7E]+$/;
+
+/** Whether `value` has the shape of an API key the database accepts. */
+export function isPlausibleAiApiKey(value: string): boolean {
+  return (
+    value.length >= MEETING_NOTE_AI_KEY_MIN_LENGTH &&
+    value.length <= MEETING_NOTE_AI_KEY_MAX_LENGTH &&
+    MEETING_NOTE_AI_KEY_PATTERN.test(value)
+  );
+}
diff --git a/src/lib/meeting-notes/ai/ticket.ts b/src/lib/meeting-notes/ai/ticket.ts
new file mode 100644
index 0000000..776d111
--- /dev/null
+++ b/src/lib/meeting-notes/ai/ticket.ts
@@ -0,0 +1,225 @@
+// src/lib/meeting-notes/ai/ticket.ts
+// Signed processing tickets for the meeting-note AI flow (Phase 6 T9; FR-015,
+// FR-031). A ticket is issued by the server when the provider notice is shown
+// and is presented by the start request. It carries its issue time, a
+// SERVER-GENERATED idempotency key, and the binding (application user,
+// company, note, source note revision, transcript identity, AI settings
+// revision), signed with HMAC-SHA256. A client can neither choose a key nor
+// move a key to a new ticket: changing any byte invalidates the signature.
+//
+// Format: "mnt1.<base64url(canonical JSON payload)>.<base64url(HMAC-SHA256)>",
+// the MAC computed over "mnt1.<payload segment>".
+//
+// Secrets (server-only environment, never NEXT_PUBLIC_):
+//   MEETING_NOTES_TICKET_SECRET           required, >= 32 bytes with >= 16 distinct
+//                                         bytes (random); signs and verifies.
+//   MEETING_NOTES_TICKET_SECRET_PREVIOUS  optional, >= 32 bytes when set; verifies
+//                                         only, so a rotation keeps outstanding
+//                                         tickets valid for their 24 hours.
+// There is no fallback: a missing or short secret raises
+// MeetingNoteAiTicketConfigError (callers answer with a configuration error).
+// Neither secret is ever logged or included in an error message.
+import 'server-only';
+
+import { createHmac, randomUUID, timingSafeEqual } from 'node:crypto';
+import { z } from 'zod';
+
+const PREFIX = 'mnt1';
+const VERSION = 1;
+/** A ticket and its idempotency key are valid for 24 hours after issuance. */
+export const MEETING_NOTE_AI_TICKET_TTL_SECONDS = 24 * 60 * 60;
+/** Accepted clock skew for an issue time in the future. */
+const MAX_FUTURE_SKEW_SECONDS = 60;
+const MIN_SECRET_BYTES = 32;
+/** A random 32+ byte secret has far more distinct bytes; fewer means a placeholder or a typed word. */
+const MIN_SECRET_DISTINCT_BYTES = 16;
+/** A real ticket is ~450 characters; anything far longer is not a ticket. */
+const MAX_TICKET_LENGTH = 2_048;
+const MAC_BYTES = 32;
+const SEGMENT = /^[A-Za-z0-9_-]+$/;
+
+export const MEETING_NOTES_TICKET_SECRET_ENV = 'MEETING_NOTES_TICKET_SECRET';
+export const MEETING_NOTES_TICKET_SECRET_PREVIOUS_ENV = 'MEETING_NOTES_TICKET_SECRET_PREVIOUS';
+
+/** What a ticket binds: the operation's identity apart from its key and time. */
+export interface MeetingNoteAiTicketBinding {
+  /** Application users.id of the authenticated requester. */
+  userId: string;
+  companyId: string;
+  noteId: string;
+  /** Note revision the notice was shown for (the draft's source revision). */
+  sourceRevision: number;
+  /** Stored-transcript identity the notice was shown for. */
+  transcriptId: string;
+  /** AI settings revision the notice was shown for. */
+  settingsRevision: number;
+}
+
+export interface MeetingNoteAiTicketPayload extends MeetingNoteAiTicketBinding {
+  v: typeof VERSION;
+  /** Issue time, whole seconds since the Unix epoch. */
+  iat: number;
+  /** Server-generated idempotency key (UUID), unique per ticket. */
+  idempotencyKey: string;
+}
+
+export interface IssuedMeetingNoteAiTicket {
+  ticket: string;
+  payload: MeetingNoteAiTicketPayload;
+  /** ISO time after which the ticket and its key are rejected as expired. */
+  expiresAt: string;
+}
+
+export type MeetingNoteAiTicketRejection = 'malformed' | 'invalid_signature' | 'expired' | 'not_yet_valid';
+
+export type MeetingNoteAiTicketVerification =
+  | { ok: true; payload: MeetingNoteAiTicketPayload; expiresAt: string }
+  | { ok: false; reason: MeetingNoteAiTicketRejection };
+
+/** The ticket secret is missing or too short (no fallback exists). */
+export class MeetingNoteAiTicketConfigError extends Error {
+  constructor() {
+    super('The meeting-notes ticket secret is not configured.');
+    this.name = 'MeetingNoteAiTicketConfigError';
+  }
+}
+
+const uuid = z.guid();
+const revision = z.number().int().min(1).max(Number.MAX_SAFE_INTEGER);
+
+const payloadSchema = z
+  .object({
+    v: z.literal(VERSION),
+    iat: z.number().int().min(0).max(Number.MAX_SAFE_INTEGER),
+    idempotencyKey: uuid,
+    userId: uuid,
+    companyId: uuid,
+    noteId: uuid,
+    sourceRevision: revision,
+    transcriptId: uuid,
+    settingsRevision: revision,
+  })
+  .strict();
+
+const bindingSchema = payloadSchema.omit({ v: true, iat: true, idempotencyKey: true });
+
+function secretFrom(name: string, required: boolean): Buffer | null {
+  const value = process.env[name];
+  if (value === undefined || value === '') {
+    if (required) throw new MeetingNoteAiTicketConfigError();
+    return null;
+  }
+  const bytes = Buffer.from(value, 'utf8');
+  if (bytes.length < MIN_SECRET_BYTES || new Set(bytes).size < MIN_SECRET_DISTINCT_BYTES) {
+    throw new MeetingNoteAiTicketConfigError();
+  }
+  return bytes;
+}
+
+function currentSecret(): Buffer {
+  const secret = secretFrom(MEETING_NOTES_TICKET_SECRET_ENV, true);
+  if (!secret) throw new MeetingNoteAiTicketConfigError();
+  return secret;
+}
+
+/** Throws MeetingNoteAiTicketConfigError unless tickets can be issued and verified. */
+export function assertMeetingNoteAiTicketConfigured(): void {
+  currentSecret();
+  secretFrom(MEETING_NOTES_TICKET_SECRET_PREVIOUS_ENV, false);
+}
+
+function mac(secret: Buffer, signedPart: string): Buffer {
+  return createHmac('sha256', secret).update(signedPart, 'utf8').digest();
+}
+
+/** Fixed key order: the payload bytes depend only on the values. */
+function canonicalJson(payload: MeetingNoteAiTicketPayload): string {
+  return JSON.stringify({
+    v: payload.v,
+    iat: payload.iat,
+    idempotencyKey: payload.idempotencyKey,
+    userId: payload.userId,
+    companyId: payload.companyId,
+    noteId: payload.noteId,
+    sourceRevision: payload.sourceRevision,
+    transcriptId: payload.transcriptId,
+    settingsRevision: payload.settingsRevision,
+  });
+}
+
+function expiresAtOf(iat: number): string {
+  return new Date((iat + MEETING_NOTE_AI_TICKET_TTL_SECONDS) * 1000).toISOString();
+}
+
+/** The issue time as the ISO instant the admission RPC binds. */
+export function meetingNoteAiTicketIssuedAt(payload: Pick<MeetingNoteAiTicketPayload, 'iat'>): string {
+  return new Date(payload.iat * 1000).toISOString();
+}
+
+/**
+ * Signs a new ticket with a fresh server-generated idempotency key. Call only
+ * after the route authorized the user (current membership and editor rights).
+ */
+export function issueMeetingNoteAiTicket(
+  binding: MeetingNoteAiTicketBinding,
+  nowMs: number = Date.now()
+): IssuedMeetingNoteAiTicket {
+  const secret = currentSecret();
+  secretFrom(MEETING_NOTES_TICKET_SECRET_PREVIOUS_ENV, false);
+  const checked = bindingSchema.parse(binding);
+  const payload: MeetingNoteAiTicketPayload = {
+    v: VERSION,
+    iat: Math.floor(nowMs / 1000),
+    idempotencyKey: randomUUID(),
+    ...checked,
+  };
+  const encoded = Buffer.from(canonicalJson(payload), 'utf8').toString('base64url');
+  const signedPart = `${PREFIX}.${encoded}`;
+  const ticket = `${signedPart}.${mac(secret, signedPart).toString('base64url')}`;
+  return { ticket, payload, expiresAt: expiresAtOf(payload.iat) };
+}
+
+function macMatches(secret: Buffer, signedPart: string, received: Buffer): boolean {
+  const expected = mac(secret, signedPart);
+  return received.length === expected.length && timingSafeEqual(received, expected);
+}
+
+/**
+ * Verifies a presented ticket: format, signature (current secret, then the
+ * previous one), payload shape, and the 24-hour validity of the ticket and its
+ * key. Throws MeetingNoteAiTicketConfigError when the secret is missing.
+ */
+export function verifyMeetingNoteAiTicket(ticket: unknown, nowMs: number = Date.now()): MeetingNoteAiTicketVerification {
+  const current = currentSecret();
+  const previous = secretFrom(MEETING_NOTES_TICKET_SECRET_PREVIOUS_ENV, false);
+
+  if (typeof ticket !== 'string' || ticket.length > MAX_TICKET_LENGTH) return { ok: false, reason: 'malformed' };
+  const parts = ticket.split('.');
+  if (parts.length !== 3 || parts[0] !== PREFIX || !SEGMENT.test(parts[1]) || !SEGMENT.test(parts[2])) {
+    return { ok: false, reason: 'malformed' };
+  }
+  const received = Buffer.from(parts[2], 'base64url');
+  if (received.length !== MAC_BYTES || received.toString('base64url') !== parts[2]) {
+    return { ok: false, reason: 'malformed' };
+  }
+
+  const signedPart = `${PREFIX}.${parts[1]}`;
+  const signed = macMatches(current, signedPart, received) || (previous !== null && macMatches(previous, signedPart, received));
+  if (!signed) return { ok: false, reason: 'invalid_signature' };
+
+  let decoded: unknown;
+  try {
+    decoded = JSON.parse(new TextDecoder('utf-8', { fatal: true }).decode(Buffer.from(parts[1], 'base64url')));
+  } catch {
+    return { ok: false, reason: 'malformed' };
+  }
+  const parsed = payloadSchema.safeParse(decoded);
+  if (!parsed.success) return { ok: false, reason: 'malformed' };
+  const payload = parsed.data;
+
+  const nowSeconds = Math.floor(nowMs / 1000);
+  if (payload.iat > nowSeconds + MAX_FUTURE_SKEW_SECONDS) return { ok: false, reason: 'not_yet_valid' };
+  if (nowSeconds >= payload.iat + MEETING_NOTE_AI_TICKET_TTL_SECONDS) return { ok: false, reason: 'expired' };
+
+  return { ok: true, payload, expiresAt: expiresAtOf(payload.iat) };
+}
diff --git a/src/lib/meeting-notes/ai/transcript-normalizer.ts b/src/lib/meeting-notes/ai/transcript-normalizer.ts
new file mode 100644
index 0000000..453dff2
--- /dev/null
+++ b/src/lib/meeting-notes/ai/transcript-normalizer.ts
@@ -0,0 +1,107 @@
+// src/lib/meeting-notes/ai/transcript-normalizer.ts
+// Phase 6 T10 (FR-014, AC-012): the ONLY source of the transcript text sent
+// to an AI provider. The stored transcript stays exactly as uploaded (FR-005);
+// the processing flow (T12) applies normalizeTranscriptForProvider to it right
+// before dispatch.
+//
+// WebVTT and SubRip structure is removed: the WEBVTT header block, NOTE /
+// STYLE / REGION blocks, cue identifiers (SRT cue numbers included), and
+// timing lines (`00:00:01.000 --> 00:00:04.000 align:start` and
+// `00:00:01,000 --> 00:00:04,000`, with any cue settings). Spoken text and
+// speaker names stay: a WebVTT voice span `<v Ana>Hello` becomes
+// `Ana: Hello`, and "Ana: Hello" lines are kept as written. Other inline cue
+// markup (<c>, <i>, <b>, <u>, <ruby>, <rt>, <lang>, <font>, <s>, karaoke
+// timestamps, SRT `{\an8}` position tags) is stripped and the WebVTT
+// character references are decoded. Plain text without timing lines is only
+// trimmed, with its line endings normalized.
+//
+// Every regex repetition inside a tag is bounded: an unclosed "<v" or "<c"
+// scans at most a few hundred characters, so a 1 MB single-line transcript
+// such as "<v <v <v ..." stays linear instead of rescanning to the end of the
+// line from every tag start (T10 review: unbounded classes were quadratic).
+import 'server-only';
+
+const BOM = '﻿';
+const TIMESTAMP = String.raw`(?:\d{1,4}:)?\d{1,2}:\d{2}[.,]\d{1,3}`;
+/** A cue timing line, including any cue settings after the end time. */
+const TIMING_LINE = new RegExp(String.raw`^[ \t]*${TIMESTAMP}[ \t]*-->[ \t]*${TIMESTAMP}(?:[ \t].*)?$`);
+const VTT_HEADER = /^WEBVTT(?:[ \t].*)?$/;
+const VTT_METADATA_BLOCK = /^(?:NOTE|STYLE|REGION)(?:[ \t].*)?$/;
+const CUE_NUMBER = /^[ \t]*\d+[ \t]*$/;
+
+// Tag bodies also exclude the next tag opener, so each start scans only up
+// to the following "<" (or "{").
+const VOICE_OPEN = /<v(?:\.[^\s<>]{0,64})?[ \t]([^<>\n]{1,200})>/gi;
+const CUE_MARKUP = /<\/?(?:v|c|i|b|u|s|ruby|rt|lang|font)(?:[.\s][^<>\n]{0,200})?>/gi;
+const KARAOKE_TIMESTAMP = new RegExp(String.raw`<${TIMESTAMP}>`, 'g');
+const SSA_OVERRIDE = /\{\\[^{}\n]{0,200}\}/g;
+
+const ENTITIES: Readonly<Record<string, string>> = {
+  '&amp;': '&',
+  '&lt;': '<',
+  '&gt;': '>',
+  '&quot;': '"',
+  '&apos;': "'",
+  '&nbsp;': ' ',
+  '&lrm;': '',
+  '&rlm;': '',
+};
+const ENTITY = /&(?:amp|lt|gt|quot|apos|nbsp|lrm|rlm);/g;
+
+function cleanCueText(line: string): string {
+  return line
+    .replace(VOICE_OPEN, (_match, speaker: string) => (speaker.trim() ? `${speaker.trim()}: ` : ''))
+    .replace(CUE_MARKUP, '')
+    .replace(KARAOKE_TIMESTAMP, '')
+    .replace(SSA_OVERRIDE, '')
+    .replace(ENTITY, (entity) => ENTITIES[entity] ?? entity)
+    .replace(/[ \t]+/g, ' ')
+    .trim();
+}
+
+/** Cue-structured text (WebVTT or SubRip, by content) → speaker lines and text. */
+function normalizeCues(lines: readonly string[], isVtt: boolean): string {
+  const blocks: string[][] = [];
+  let current: string[] = [];
+  for (const line of lines) {
+    if (line.trim() === '') {
+      if (current.length > 0) blocks.push(current);
+      current = [];
+    } else {
+      current.push(line);
+    }
+  }
+  if (current.length > 0) blocks.push(current);
+
+  const output: string[] = [];
+  blocks.forEach((block, index) => {
+    if (isVtt && index === 0 && VTT_HEADER.test(block[0].trim())) return;
+    if (isVtt && VTT_METADATA_BLOCK.test(block[0])) return;
+
+    const timing = block.findIndex((line) => TIMING_LINE.test(line));
+    // Lines before the timing line are the cue identifier; a block without a
+    // timing line keeps its text unless it is only a cue number.
+    const payload = timing >= 0 ? block.slice(timing + 1) : block.filter((line) => !CUE_NUMBER.test(line));
+    for (const line of payload) {
+      if (TIMING_LINE.test(line)) continue;
+      const text = cleanCueText(line);
+      if (text) output.push(text);
+    }
+  });
+  return output.join('\n');
+}
+
+/**
+ * The transcript text a provider receives (FR-014): cue numbers, timestamps,
+ * and cue settings removed; speaker names and spoken text kept.
+ */
+export function normalizeTranscriptForProvider(stored: string): string {
+  const text = (stored.startsWith(BOM) ? stored.slice(BOM.length) : stored).replace(/\r\n?/g, '\n');
+  const lines = text.split('\n');
+  const firstLine = lines.find((line) => line.trim() !== '') ?? '';
+  const isVtt = VTT_HEADER.test(firstLine.trim());
+  if (!isVtt && !lines.some((line) => TIMING_LINE.test(line))) {
+    return text.trim();
+  }
+  return normalizeCues(lines, isVtt);
+}
diff --git a/src/lib/meeting-notes/client-api.ts b/src/lib/meeting-notes/client-api.ts
new file mode 100644
index 0000000..3244218
--- /dev/null
+++ b/src/lib/meeting-notes/client-api.ts
@@ -0,0 +1,479 @@
+// src/lib/meeting-notes/client-api.ts
+// Browser-side calls to the meeting-note routes (T3 notes, versions, and
+// action items, T4 search, T7 Markdown export, T10 transcript uploads). The session cookie identifies the caller; the routes resolve the
+// company and authorize every change, so nothing here is trusted for that.
+// Every call takes an AbortSignal: reads get TanStack's, writes and the export
+// get the scope fence's (useMeetingNotesScopedMutation), so a retired
+// account's requests are aborted and their responses never applied.
+import type { PaginatedResult } from '@/types/common';
+import type {
+  MeetingNoteActionItemFieldsInput,
+  MeetingNoteActionItemView,
+  MeetingNoteDetail,
+  MeetingNoteListItem,
+  MeetingNoteSearchResult,
+  MeetingNoteVersionSummary,
+  MeetingNoteVersionView,
+} from '@/types/meeting-notes';
+
+/** Notes per page in a space's Notes tab (the route allows 1..100). */
+export const SPACE_NOTES_PAGE_SIZE = 20;
+/** Results per page on the Meetings page (the route allows 1..50). */
+export const MEETING_SEARCH_PAGE_SIZE = 20;
+
+/** A failed meeting-note request: HTTP status (0 = network) and the route's error code. */
+export class MeetingNotesApiError extends Error {
+  readonly status: number;
+  readonly code: string;
+
+  constructor(status: number, code: string, message: string) {
+    super(message);
+    this.name = 'MeetingNotesApiError';
+    this.status = status;
+    this.code = code;
+  }
+}
+
+/**
+ * 409 MEETING_NOTE_STALE_REVISION: another change landed first. Carries the
+ * note's current state as the route read it, so the UI can show it (FR-007).
+ */
+export class MeetingNoteConflictError extends MeetingNotesApiError {
+  readonly currentRevision: number;
+  readonly note: MeetingNoteDetail;
+
+  constructor(message: string, currentRevision: number, note: MeetingNoteDetail) {
+    super(409, 'MEETING_NOTE_STALE_REVISION', message);
+    this.name = 'MeetingNoteConflictError';
+    this.currentRevision = currentRevision;
+    this.note = note;
+  }
+}
+
+/**
+ * 409 MEETING_NOTE_ITEM_STALE_REVISION: the action item changed first. Carries
+ * the item's current state so the UI can show it and retry on it.
+ */
+export class MeetingNoteItemConflictError extends MeetingNotesApiError {
+  readonly currentRevision: number;
+  readonly item: MeetingNoteActionItemView;
+
+  constructor(message: string, currentRevision: number, item: MeetingNoteActionItemView) {
+    super(409, 'MEETING_NOTE_ITEM_STALE_REVISION', message);
+    this.name = 'MeetingNoteItemConflictError';
+    this.currentRevision = currentRevision;
+    this.item = item;
+  }
+}
+
+/** Retry only failures a retry can fix: network errors and 5xx (never 4xx/429). */
+export function shouldRetryMeetingNotesRequest(failureCount: number, error: unknown): boolean {
+  if (failureCount >= 2) return false;
+  if (!(error instanceof MeetingNotesApiError)) return false;
+  return error.status === 0 || error.status >= 500;
+}
+
+export interface MeetingNotesPage<T> {
+  items: T[];
+  /** Offset of the next page; null when there is none. */
+  nextCursor: number | null;
+  hasMore: boolean;
+  totalCount: number | null;
+}
+
+/** The search route's filters, already resolved to the route's parameters. */
+export interface MeetingNoteSearchParams {
+  /** Trimmed query; '' = list mode (newest meeting first). */
+  q: string;
+  /** Only this space; null = every space. Never set together with `spaceRemoved`. */
+  spaceId: string | null;
+  /** Only notes whose space was deleted. */
+  spaceRemoved: boolean;
+  /** ISO date-time with offset, inclusive. */
+  from: string | null;
+  /** ISO date-time with offset, exclusive. */
+  to: string | null;
+}
+
+/** The editable fields of a note (content is sanitized again by the route). */
+export interface MeetingNoteFieldsPayload {
+  title: string;
+  /** ISO 8601 date-time with offset. */
+  meetingDate: string;
+  content: string;
+  participantIds: string[];
+}
+
+function asRecord(value: unknown): Record<string, unknown> {
+  return value && typeof value === 'object' && !Array.isArray(value) ? (value as Record<string, unknown>) : {};
+}
+
+function invalidResponse(status = 200): MeetingNotesApiError {
+  return new MeetingNotesApiError(status, 'INVALID_RESPONSE', 'Unexpected response from the server.');
+}
+
+function isNoteDetail(value: unknown): value is MeetingNoteDetail {
+  const note = asRecord(value);
+  return (
+    typeof note.id === 'string' &&
+    typeof note.revision === 'number' &&
+    typeof note.title === 'string' &&
+    typeof note.content === 'string' &&
+    Array.isArray(note.participants) &&
+    typeof note.rights === 'object' &&
+    note.rights !== null
+  );
+}
+
+function isItemView(value: unknown): value is MeetingNoteActionItemView {
+  const item = asRecord(value);
+  return (
+    typeof item.id === 'string' &&
+    typeof item.noteId === 'string' &&
+    typeof item.description === 'string' &&
+    typeof item.revision === 'number' &&
+    typeof item.completed === 'boolean'
+  );
+}
+
+/** The error a failed response stands for; a stale-revision 409 with its note or item becomes a conflict. */
+async function toApiError(response: Response): Promise<MeetingNotesApiError> {
+  let body: Record<string, unknown> = {};
+  try {
+    body = asRecord(await response.json());
+  } catch {
+    // Non-JSON error body.
+  }
+  const code = typeof body.code === 'string' ? body.code : `HTTP_${response.status}`;
+  const message = typeof body.error === 'string' ? body.error : `Request failed (${response.status})`;
+  if (response.status === 409 && code === 'MEETING_NOTE_STALE_REVISION' && isNoteDetail(body.note)) {
+    const currentRevision = typeof body.currentRevision === 'number' ? body.currentRevision : body.note.revision;
+    return new MeetingNoteConflictError(message, currentRevision, body.note);
+  }
+  if (response.status === 409 && code === 'MEETING_NOTE_ITEM_STALE_REVISION' && isItemView(body.item)) {
+    const currentRevision = typeof body.currentRevision === 'number' ? body.currentRevision : body.item.revision;
+    return new MeetingNoteItemConflictError(message, currentRevision, body.item);
+  }
+  return new MeetingNotesApiError(response.status, code, message);
+}
+
+/** One JSON request to a meeting-note route; any failure becomes a MeetingNotesApiError. */
+async function requestJson(url: string, init: RequestInit = {}): Promise<unknown> {
+  let response: Response;
+  try {
+    response = await fetch(url, {
+      ...init,
+      credentials: 'same-origin',
+      cache: 'no-store',
+      // JSON bodies are strings; a FormData body gets its multipart boundary from fetch.
+      headers: typeof init.body === 'string' ? { 'Content-Type': 'application/json' } : undefined,
+    });
+  } catch (error) {
+    if (init.signal?.aborted) throw error;
+    throw new MeetingNotesApiError(0, 'NETWORK_ERROR', 'Could not reach the server.');
+  }
+  if (!response.ok) throw await toApiError(response);
+  try {
+    return await response.json();
+  } catch {
+    throw invalidResponse(response.status);
+  }
+}
+
+function toPage<T>(body: PaginatedResult<T>): MeetingNotesPage<T> {
+  if (!body || !Array.isArray(body.items)) throw invalidResponse();
+  const cursor = typeof body.nextCursor === 'number' ? body.nextCursor : Number(body.nextCursor);
+  const hasMore = body.hasMore === true && Number.isInteger(cursor) && cursor >= 0;
+  return {
+    items: body.items,
+    nextCursor: hasMore ? cursor : null,
+    hasMore,
+    totalCount: typeof body.totalCount === 'number' ? body.totalCount : null,
+  };
+}
+
+async function getPage<T>(url: string, signal?: AbortSignal): Promise<MeetingNotesPage<T>> {
+  const body = await requestJson(url, { method: 'GET', signal });
+  return toPage(body as PaginatedResult<T>);
+}
+
+function readNote(body: unknown): MeetingNoteDetail {
+  const note = asRecord(body).note;
+  if (!isNoteDetail(note)) throw invalidResponse();
+  return note;
+}
+
+function notePath(noteId: string): string {
+  return `/api/meeting-notes/${encodeURIComponent(noteId)}`;
+}
+
+/** GET /api/meeting-notes — one space's notes, newest meeting date first. */
+export function fetchSpaceMeetingNotes(
+  spaceId: string,
+  cursor: number,
+  signal?: AbortSignal
+): Promise<MeetingNotesPage<MeetingNoteListItem>> {
+  const params = new URLSearchParams({
+    spaceId,
+    limit: String(SPACE_NOTES_PAGE_SIZE),
+    cursor: String(cursor),
+  });
+  return getPage<MeetingNoteListItem>(`/api/meeting-notes?${params.toString()}`, signal);
+}
+
+/** GET /api/meeting-notes/search — company notes, ranked (or by date when `q` is empty). */
+export function fetchMeetingNoteSearch(
+  search: MeetingNoteSearchParams,
+  cursor: number,
+  signal?: AbortSignal
+): Promise<MeetingNotesPage<MeetingNoteSearchResult>> {
+  const params = new URLSearchParams({
+    limit: String(MEETING_SEARCH_PAGE_SIZE),
+    cursor: String(cursor),
+  });
+  if (search.q) params.set('q', search.q);
+  if (search.spaceRemoved) params.set('removed', 'true');
+  else if (search.spaceId) params.set('spaceId', search.spaceId);
+  if (search.from) params.set('from', search.from);
+  if (search.to) params.set('to', search.to);
+  return getPage<MeetingNoteSearchResult>(`/api/meeting-notes/search?${params.toString()}`, signal);
+}
+
+/** GET /api/meeting-notes/[id] — the note view; with `includeTranscript`, also the stored transcript text. */
+export async function fetchMeetingNoteDetail(
+  noteId: string,
+  options: { includeTranscript?: boolean } = {},
+  signal?: AbortSignal
+): Promise<MeetingNoteDetail> {
+  const query = options.includeTranscript ? '?include=transcript' : '';
+  return readNote(await requestJson(`${notePath(noteId)}${query}`, { method: 'GET', signal }));
+}
+
+/** POST /api/meeting-notes — creates a note in a space of the caller's company. */
+export async function createMeetingNote(
+  spaceId: string,
+  fields: MeetingNoteFieldsPayload,
+  signal?: AbortSignal
+): Promise<MeetingNoteDetail> {
+  return readNote(
+    await requestJson('/api/meeting-notes', { method: 'POST', body: JSON.stringify({ spaceId, ...fields }), signal })
+  );
+}
+
+/** PATCH /api/meeting-notes/[id] — full replacement against `expectedRevision` (409 → MeetingNoteConflictError). */
+export async function updateMeetingNote(
+  noteId: string,
+  expectedRevision: number,
+  fields: MeetingNoteFieldsPayload,
+  signal?: AbortSignal
+): Promise<MeetingNoteDetail> {
+  return readNote(
+    await requestJson(notePath(noteId), {
+      method: 'PATCH',
+      body: JSON.stringify({ expectedRevision, ...fields }),
+      signal,
+    })
+  );
+}
+
+/** POST /api/meeting-notes/[id]/restore — restores a version as a new version (409 → MeetingNoteConflictError). */
+export async function restoreMeetingNoteVersion(
+  noteId: string,
+  expectedRevision: number,
+  versionId: string,
+  signal?: AbortSignal
+): Promise<MeetingNoteDetail> {
+  return readNote(
+    await requestJson(`${notePath(noteId)}/restore`, {
+      method: 'POST',
+      body: JSON.stringify({ expectedRevision, versionId }),
+      signal,
+    })
+  );
+}
+
+/** One transcript file (.txt/.vtt/.srt, at most 1 MB) as multipart form data with the given fields. */
+function transcriptForm(file: File, fields: Record<string, string>): FormData {
+  const form = new FormData();
+  for (const [name, value] of Object.entries(fields)) form.set(name, value);
+  form.set('file', file, file.name);
+  return form;
+}
+
+/** POST /api/meeting-notes/transcript — "New note from transcript" in a space of the caller's company. */
+export async function createMeetingNoteFromTranscript(
+  spaceId: string,
+  file: File,
+  signal?: AbortSignal
+): Promise<MeetingNoteDetail> {
+  return readNote(
+    await requestJson('/api/meeting-notes/transcript', {
+      method: 'POST',
+      body: transcriptForm(file, { spaceId }),
+      signal,
+    })
+  );
+}
+
+/** PUT /api/meeting-notes/[id]/transcript — replaces the stored transcript (409 → MeetingNoteConflictError). */
+export async function attachMeetingNoteTranscript(
+  noteId: string,
+  expectedRevision: number,
+  file: File,
+  signal?: AbortSignal
+): Promise<MeetingNoteDetail> {
+  return readNote(
+    await requestJson(`${notePath(noteId)}/transcript`, {
+      method: 'PUT',
+      body: transcriptForm(file, { expectedRevision: String(expectedRevision) }),
+      signal,
+    })
+  );
+}
+
+/** DELETE /api/meeting-notes/[id]?expectedRevision=N (409 → MeetingNoteConflictError). */
+export async function deleteMeetingNote(noteId: string, expectedRevision: number, signal?: AbortSignal): Promise<void> {
+  const params = new URLSearchParams({ expectedRevision: String(expectedRevision) });
+  await requestJson(`${notePath(noteId)}?${params.toString()}`, { method: 'DELETE', signal });
+}
+
+/** GET /api/meeting-notes/[id]/versions — the history, newest first. */
+export async function fetchMeetingNoteVersions(
+  noteId: string,
+  signal?: AbortSignal
+): Promise<{ revision: number; versions: MeetingNoteVersionSummary[] }> {
+  const body = asRecord(await requestJson(`${notePath(noteId)}/versions`, { method: 'GET', signal }));
+  if (!Array.isArray(body.versions) || typeof body.revision !== 'number') throw invalidResponse();
+  return { revision: body.revision, versions: body.versions as MeetingNoteVersionSummary[] };
+}
+
+/** GET /api/meeting-notes/[id]/versions/[versionId] — one immutable version. */
+export async function fetchMeetingNoteVersion(
+  noteId: string,
+  versionId: string,
+  signal?: AbortSignal
+): Promise<MeetingNoteVersionView> {
+  const body = asRecord(
+    await requestJson(`${notePath(noteId)}/versions/${encodeURIComponent(versionId)}`, { method: 'GET', signal })
+  );
+  const version = asRecord(body.version);
+  if (typeof version.id !== 'string' || typeof version.content !== 'string' || !Array.isArray(version.participants)) {
+    throw invalidResponse();
+  }
+  return body.version as MeetingNoteVersionView;
+}
+
+function itemPath(noteId: string, itemId?: string): string {
+  const base = `${notePath(noteId)}/items`;
+  return itemId === undefined ? base : `${base}/${encodeURIComponent(itemId)}`;
+}
+
+function readItem(body: unknown): MeetingNoteActionItemView {
+  const item = asRecord(body).item;
+  if (!isItemView(item)) throw invalidResponse();
+  return item;
+}
+
+/** POST /api/meeting-notes/[id]/items — an editor adds an item (400 MEETING_NOTE_ITEM_LIMIT_REACHED at 100). */
+export async function createMeetingNoteActionItem(
+  noteId: string,
+  fields: MeetingNoteActionItemFieldsInput,
+  signal?: AbortSignal
+): Promise<MeetingNoteActionItemView> {
+  return readItem(await requestJson(itemPath(noteId), { method: 'POST', body: JSON.stringify(fields), signal }));
+}
+
+/** PATCH /api/meeting-notes/[id]/items/[itemId] — full replacement (409 → MeetingNoteItemConflictError). */
+export async function updateMeetingNoteActionItem(
+  noteId: string,
+  itemId: string,
+  expectedRevision: number,
+  fields: MeetingNoteActionItemFieldsInput,
+  signal?: AbortSignal
+): Promise<MeetingNoteActionItemView> {
+  return readItem(
+    await requestJson(itemPath(noteId, itemId), {
+      method: 'PATCH',
+      body: JSON.stringify({ expectedRevision, ...fields }),
+      signal,
+    })
+  );
+}
+
+/** DELETE /api/meeting-notes/[id]/items/[itemId]?expectedRevision=N (409 → MeetingNoteItemConflictError). */
+export async function deleteMeetingNoteActionItem(
+  noteId: string,
+  itemId: string,
+  expectedRevision: number,
+  signal?: AbortSignal
+): Promise<void> {
+  const params = new URLSearchParams({ expectedRevision: String(expectedRevision) });
+  await requestJson(`${itemPath(noteId, itemId)}?${params.toString()}`, { method: 'DELETE', signal });
+}
+
+/** PUT /api/meeting-notes/[id]/items/[itemId]/completion — editors and the current assignee. */
+export async function setMeetingNoteActionItemCompleted(
+  noteId: string,
+  itemId: string,
+  expectedRevision: number,
+  completed: boolean,
+  signal?: AbortSignal
+): Promise<MeetingNoteActionItemView> {
+  return readItem(
+    await requestJson(`${itemPath(noteId, itemId)}/completion`, {
+      method: 'PUT',
+      body: JSON.stringify({ expectedRevision, completed }),
+      signal,
+    })
+  );
+}
+
+export interface MeetingNoteMarkdownFile {
+  blob: Blob;
+  filename: string;
+}
+
+/** The download name the route chose (`filename*` first), or a fallback. */
+function filenameFrom(disposition: string | null): string {
+  const fallback = 'meeting-note.md';
+  if (!disposition) return fallback;
+  const extended = /filename\*=UTF-8''([^;]+)/i.exec(disposition);
+  if (extended) {
+    try {
+      return decodeURIComponent(extended[1].trim()) || fallback;
+    } catch {
+      // Malformed encoding: use the plain name.
+    }
+  }
+  const plain = /filename="([^"]+)"/i.exec(disposition);
+  return plain?.[1] || fallback;
+}
+
+/**
+ * GET /api/meeting-notes/[id]/export — the note as a .md file (FR-027). The
+ * meeting date is written as a calendar day in `timeZone` (the viewer's).
+ */
+export async function fetchMeetingNoteMarkdown(
+  noteId: string,
+  options: { includeTranscript: boolean; timeZone: string },
+  signal?: AbortSignal
+): Promise<MeetingNoteMarkdownFile> {
+  const params = new URLSearchParams({
+    includeTranscript: options.includeTranscript ? 'true' : 'false',
+    timeZone: options.timeZone,
+  });
+  let response: Response;
+  try {
+    response = await fetch(`${notePath(noteId)}/export?${params.toString()}`, {
+      method: 'GET',
+      credentials: 'same-origin',
+      cache: 'no-store',
+      signal,
+    });
+  } catch (error) {
+    if (signal?.aborted) throw error;
+    throw new MeetingNotesApiError(0, 'NETWORK_ERROR', 'Could not reach the server.');
+  }
+  if (!response.ok) throw await toApiError(response);
+  return { blob: await response.blob(), filename: filenameFrom(response.headers.get('content-disposition')) };
+}
