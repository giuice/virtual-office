diff --git a/src/hooks/mutations/useMeetingNoteActionItemMutations.ts b/src/hooks/mutations/useMeetingNoteActionItemMutations.ts
new file mode 100644
index 0000000..45c980c
--- /dev/null
+++ b/src/hooks/mutations/useMeetingNoteActionItemMutations.ts
@@ -0,0 +1,135 @@
+// src/hooks/mutations/useMeetingNoteActionItemMutations.ts
+// Action-item changes (Phase 6 FR-011, BR-005): add, edit, delete (editors)
+// and completion (editors and the item's current assignee). Each change is
+// checked by the route and the database against the item's revision; a stale
+// one fails with MeetingNoteItemConflictError (409) carrying the newer item.
+// Every change the server answered writes the returned item into the cached
+// note and refreshes the viewer's meeting-note scope (search indexes item
+// text); a request that never reached the server (offline, aborted) changes
+// nothing in the cache. Every change runs through
+// useMeetingNotesScopedMutation (scope fence).
+'use client';
+
+import { useQueryClient, type QueryClient } from '@tanstack/react-query';
+
+import { useMeetingNotesScopedMutation } from '@/hooks/mutations/useMeetingNotesScopedMutation';
+import { meetingNoteQueryKeys } from '@/hooks/queries/useMeetingNotes';
+import {
+  createMeetingNoteActionItem,
+  deleteMeetingNoteActionItem,
+  MeetingNoteItemConflictError,
+  MeetingNotesApiError,
+  setMeetingNoteActionItemCompleted,
+  updateMeetingNoteActionItem,
+} from '@/lib/meeting-notes/client-api';
+import type { MeetingNotesScope } from '@/lib/meeting-notes/scope-fence';
+import type {
+  MeetingNoteActionItemFieldsInput,
+  MeetingNoteActionItemView,
+  MeetingNoteDetail,
+} from '@/types/meeting-notes';
+
+type Scope = MeetingNotesScope;
+
+type ItemChange = { kind: 'upsert'; item: MeetingNoteActionItemView } | { kind: 'remove'; itemId: string };
+
+function applyChange(items: MeetingNoteActionItemView[], change: ItemChange): MeetingNoteActionItemView[] {
+  if (change.kind === 'remove') return items.filter((item) => item.id !== change.itemId);
+  const index = items.findIndex((item) => item.id === change.item.id);
+  if (index === -1) return [...items, change.item];
+  // Never replace a newer cached state with an older response.
+  if (items[index].revision > change.item.revision) return items;
+  return items.map((item, position) => (position === index ? change.item : item));
+}
+
+/** Writes the change into the cached note (if any), then refreshes everything of this viewer. */
+function settleItem(queryClient: QueryClient, scope: Scope, noteId: string, change: ItemChange | null): void {
+  if (change) {
+    queryClient.setQueryData<MeetingNoteDetail>(meetingNoteQueryKeys.note(scope.userId, scope.companyId, noteId), (note) =>
+      note ? { ...note, actionItems: applyChange(note.actionItems, change) } : note
+    );
+  }
+  void queryClient.invalidateQueries({ queryKey: meetingNoteQueryKeys.scope(scope.userId, scope.companyId) });
+}
+
+/**
+ * After a failure: a 409 brings the newer item; another answer from the server
+ * refreshes; a request that never got an answer (status 0, aborted) changes nothing.
+ */
+function settleItemError(queryClient: QueryClient, scope: Scope, noteId: string, error: unknown): void {
+  if (!(error instanceof MeetingNotesApiError) || error.status === 0) return;
+  settleItem(
+    queryClient,
+    scope,
+    noteId,
+    error instanceof MeetingNoteItemConflictError ? { kind: 'upsert', item: error.item } : null
+  );
+}
+
+export interface CreateMeetingNoteActionItemVariables {
+  noteId: string;
+  fields: MeetingNoteActionItemFieldsInput;
+}
+
+export function useCreateMeetingNoteActionItem() {
+  const queryClient = useQueryClient();
+  return useMeetingNotesScopedMutation<MeetingNoteActionItemView, CreateMeetingNoteActionItemVariables>({
+    name: 'create-item',
+    mutationFn: ({ noteId, fields }, { signal }) => createMeetingNoteActionItem(noteId, fields, signal),
+    onSuccess: (item, { noteId }, scope) => settleItem(queryClient, scope, noteId, { kind: 'upsert', item }),
+    onError: (error, { noteId }, scope) => settleItemError(queryClient, scope, noteId, error),
+  });
+}
+
+export interface UpdateMeetingNoteActionItemVariables {
+  noteId: string;
+  itemId: string;
+  expectedRevision: number;
+  fields: MeetingNoteActionItemFieldsInput;
+}
+
+export function useUpdateMeetingNoteActionItem() {
+  const queryClient = useQueryClient();
+  return useMeetingNotesScopedMutation<MeetingNoteActionItemView, UpdateMeetingNoteActionItemVariables>({
+    name: 'update-item',
+    mutationFn: ({ noteId, itemId, expectedRevision, fields }, { signal }) =>
+      updateMeetingNoteActionItem(noteId, itemId, expectedRevision, fields, signal),
+    onSuccess: (item, { noteId }, scope) => settleItem(queryClient, scope, noteId, { kind: 'upsert', item }),
+    onError: (error, { noteId }, scope) => settleItemError(queryClient, scope, noteId, error),
+  });
+}
+
+export interface DeleteMeetingNoteActionItemVariables {
+  noteId: string;
+  itemId: string;
+  expectedRevision: number;
+}
+
+export function useDeleteMeetingNoteActionItem() {
+  const queryClient = useQueryClient();
+  return useMeetingNotesScopedMutation<void, DeleteMeetingNoteActionItemVariables>({
+    name: 'delete-item',
+    mutationFn: ({ noteId, itemId, expectedRevision }, { signal }) =>
+      deleteMeetingNoteActionItem(noteId, itemId, expectedRevision, signal),
+    onSuccess: (_result, { noteId, itemId }, scope) => settleItem(queryClient, scope, noteId, { kind: 'remove', itemId }),
+    onError: (error, { noteId }, scope) => settleItemError(queryClient, scope, noteId, error),
+  });
+}
+
+export interface SetMeetingNoteActionItemCompletedVariables {
+  noteId: string;
+  itemId: string;
+  expectedRevision: number;
+  completed: boolean;
+}
+
+export function useSetMeetingNoteActionItemCompleted() {
+  const queryClient = useQueryClient();
+  return useMeetingNotesScopedMutation<MeetingNoteActionItemView, SetMeetingNoteActionItemCompletedVariables>({
+    name: 'complete-item',
+    mutationFn: ({ noteId, itemId, expectedRevision, completed }, { signal }) =>
+      setMeetingNoteActionItemCompleted(noteId, itemId, expectedRevision, completed, signal),
+    onSuccess: (item, { noteId }, scope) => settleItem(queryClient, scope, noteId, { kind: 'upsert', item }),
+    onError: (error, { noteId }, scope) => settleItemError(queryClient, scope, noteId, error),
+  });
+}
diff --git a/src/hooks/mutations/useMeetingNoteAiSettingsMutations.ts b/src/hooks/mutations/useMeetingNoteAiSettingsMutations.ts
new file mode 100644
index 0000000..a6c13f4
--- /dev/null
+++ b/src/hooks/mutations/useMeetingNoteAiSettingsMutations.ts
@@ -0,0 +1,108 @@
+// src/hooks/mutations/useMeetingNoteAiSettingsMutations.ts
+// Admin save of the company AI settings (Phase 6 T8, FR-024). The API key is
+// write-only and never enters TanStack state (block B review B-1): the
+// mutation's variables hold only the non-secret choices plus an opaque
+// one-use token; the key waits in this hook's ref under that token and is
+// taken out (deleted) when the request body is built. The cache keeps only the
+// masked settings the route returned. Runs through
+// useMeetingNotesScopedMutation, so a retired scope's save is aborted and its
+// late result never reaches another account's cache.
+'use client';
+
+import { useQueryClient } from '@tanstack/react-query';
+import { useCallback, useEffect, useRef } from 'react';
+
+import {
+  useMeetingNotesScopedMutation,
+  type MeetingNotesMutateOptions,
+} from '@/hooks/mutations/useMeetingNotesScopedMutation';
+import { meetingNoteAiSettingsQueryKey } from '@/hooks/queries/useMeetingNoteAiSettings';
+import {
+  MeetingNoteAiSettingsConflictError,
+  saveMeetingNoteAiSettings,
+} from '@/lib/meeting-notes/ai/settings-client-api';
+import type { MeetingNotesScope } from '@/lib/meeting-notes/scope-fence';
+import type {
+  MeetingNoteAiSettingsResponse,
+  MeetingNoteAiSettingsView,
+  SaveMeetingNoteAiSettingsInput,
+} from '@/types/meeting-notes';
+
+/** What the mutation keeps: the admin's choices and a token for the key, never the key. */
+export interface SaveMeetingNoteAiSettingsVariables extends Omit<SaveMeetingNoteAiSettingsInput, 'apiKey'> {
+  /** Opaque one-use reference to a key held outside TanStack; null = keep the stored key. */
+  keyToken: number | null;
+}
+
+export type SaveMeetingNoteAiSettingsCallbacks = MeetingNotesMutateOptions<
+  MeetingNoteAiSettingsView,
+  SaveMeetingNoteAiSettingsVariables
+>;
+
+export function useSaveMeetingNoteAiSettings() {
+  const queryClient = useQueryClient();
+  const keys = useRef(new Map<number, string>());
+  const nextToken = useRef(1);
+
+  // Unmount (and with it every identity change that leaves the page) drops held keys.
+  useEffect(() => {
+    const held = keys.current;
+    return () => held.clear();
+  }, []);
+
+  const store = useCallback(
+    (scope: MeetingNotesScope, settings: MeetingNoteAiSettingsView) => {
+      queryClient.setQueryData<MeetingNoteAiSettingsResponse>(
+        meetingNoteAiSettingsQueryKey(scope.userId, scope.companyId),
+        (current) => (current ? { ...current, settings } : current)
+      );
+    },
+    [queryClient]
+  );
+
+  const mutation = useMeetingNotesScopedMutation<MeetingNoteAiSettingsView, SaveMeetingNoteAiSettingsVariables>({
+    name: 'save-ai-settings',
+    // A settled save leaves the MutationCache as soon as nothing observes it.
+    gcTime: 0,
+    mutationFn: ({ keyToken, ...choices }, { signal }) => {
+      let apiKey: string | null = null;
+      if (keyToken !== null) {
+        apiKey = keys.current.get(keyToken) ?? null;
+        keys.current.delete(keyToken);
+        if (apiKey === null) {
+          // The key was dropped (unmount) before the request started: never
+          // save as "keep the current key" by accident.
+          return Promise.reject(new Error('The API key is no longer available. Enter it again.'));
+        }
+      }
+      return saveMeetingNoteAiSettings({ ...choices, apiKey }, signal);
+    },
+    onSuccess: (settings, _variables, scope) => store(scope, settings),
+    onError: (error, _variables, scope) => {
+      if (error instanceof MeetingNoteAiSettingsConflictError) store(scope, error.settings);
+    },
+  });
+
+  const { mutate, reset } = mutation;
+  const save = useCallback(
+    (input: SaveMeetingNoteAiSettingsInput, callbacks?: SaveMeetingNoteAiSettingsCallbacks) => {
+      const { apiKey, ...choices } = input;
+      let keyToken: number | null = null;
+      if (apiKey !== null) {
+        keyToken = nextToken.current;
+        nextToken.current += 1;
+        keys.current.set(keyToken, apiKey);
+      }
+      mutate({ ...choices, keyToken }, callbacks);
+    },
+    [mutate]
+  );
+
+  /** Forgets every key still waiting and the last save's state. */
+  const clear = useCallback(() => {
+    keys.current.clear();
+    reset();
+  }, [reset]);
+
+  return { save, clear, isPending: mutation.isPending };
+}
diff --git a/src/hooks/mutations/useMeetingNoteMutations.ts b/src/hooks/mutations/useMeetingNoteMutations.ts
new file mode 100644
index 0000000..38866c9
--- /dev/null
+++ b/src/hooks/mutations/useMeetingNoteMutations.ts
@@ -0,0 +1,123 @@
+// src/hooks/mutations/useMeetingNoteMutations.ts
+// Meeting-note changes (Phase 6 FR-001, FR-007, FR-009, FR-010). The routes
+// and the database authorize each change against the note's current
+// revision; a stale one fails with MeetingNoteConflictError (409) and never
+// overwrites. A successful change, and a 409 (which carries the newer note),
+// refresh the viewer's meeting-note scope (space Notes tabs, Meetings search,
+// the note and its history). Any other failure leaves the cache alone: a
+// request that never reached the server proves nothing changed, and a refetch
+// that fails offline must not disturb an open editor (block B review B-3).
+// Every change runs through useMeetingNotesScopedMutation (scope fence).
+'use client';
+
+import { hashKey, useQueryClient, type QueryClient } from '@tanstack/react-query';
+
+import { useMeetingNotesScopedMutation } from '@/hooks/mutations/useMeetingNotesScopedMutation';
+import { meetingNoteQueryKeys } from '@/hooks/queries/useMeetingNotes';
+import {
+  createMeetingNote,
+  deleteMeetingNote,
+  MeetingNoteConflictError,
+  restoreMeetingNoteVersion,
+  updateMeetingNote,
+  type MeetingNoteFieldsPayload,
+} from '@/lib/meeting-notes/client-api';
+import type { MeetingNotesScope } from '@/lib/meeting-notes/scope-fence';
+import type { MeetingNoteDetail } from '@/types/meeting-notes';
+
+type Scope = MeetingNotesScope;
+
+/** Stores the note the route returned and marks every list and history of this viewer stale. */
+function settleNote(queryClient: QueryClient, scope: Scope, note: MeetingNoteDetail | null): void {
+  if (note) {
+    queryClient.setQueryData(meetingNoteQueryKeys.note(scope.userId, scope.companyId, note.id), note);
+  }
+  void queryClient.invalidateQueries({
+    queryKey: meetingNoteQueryKeys.scope(scope.userId, scope.companyId),
+    // The view just written above is current; everything else refetches.
+    predicate: (query) =>
+      !note || query.queryHash !== hashKey(meetingNoteQueryKeys.note(scope.userId, scope.companyId, note.id)),
+  });
+}
+
+/** After a 409 the cache takes the newer note the route returned; other failures change nothing. */
+function settleConflict(queryClient: QueryClient, scope: Scope, error: unknown): void {
+  if (error instanceof MeetingNoteConflictError) settleNote(queryClient, scope, error.note);
+}
+
+export interface CreateMeetingNoteVariables {
+  spaceId: string;
+  fields: MeetingNoteFieldsPayload;
+}
+
+export function useCreateMeetingNote() {
+  const queryClient = useQueryClient();
+  return useMeetingNotesScopedMutation<MeetingNoteDetail, CreateMeetingNoteVariables>({
+    name: 'create-note',
+    mutationFn: ({ spaceId, fields }, { signal }) => createMeetingNote(spaceId, fields, signal),
+    onSuccess: (note, _variables, scope) => settleNote(queryClient, scope, note),
+  });
+}
+
+export interface UpdateMeetingNoteVariables {
+  noteId: string;
+  expectedRevision: number;
+  fields: MeetingNoteFieldsPayload;
+}
+
+export function useUpdateMeetingNote() {
+  const queryClient = useQueryClient();
+  return useMeetingNotesScopedMutation<MeetingNoteDetail, UpdateMeetingNoteVariables>({
+    name: 'update-note',
+    mutationFn: ({ noteId, expectedRevision, fields }, { signal }) =>
+      updateMeetingNote(noteId, expectedRevision, fields, signal),
+    onSuccess: (note, _variables, scope) => settleNote(queryClient, scope, note),
+    onError: (error, _variables, scope) => settleConflict(queryClient, scope, error),
+  });
+}
+
+export interface RestoreMeetingNoteVariables {
+  noteId: string;
+  expectedRevision: number;
+  versionId: string;
+}
+
+export function useRestoreMeetingNoteVersion() {
+  const queryClient = useQueryClient();
+  return useMeetingNotesScopedMutation<MeetingNoteDetail, RestoreMeetingNoteVariables>({
+    name: 'restore-note',
+    mutationFn: ({ noteId, expectedRevision, versionId }, { signal }) =>
+      restoreMeetingNoteVersion(noteId, expectedRevision, versionId, signal),
+    onSuccess: (note, _variables, scope) => settleNote(queryClient, scope, note),
+    onError: (error, _variables, scope) => settleConflict(queryClient, scope, error),
+  });
+}
+
+export interface DeleteMeetingNoteVariables {
+  noteId: string;
+  expectedRevision: number;
+}
+
+export function useDeleteMeetingNote() {
+  const queryClient = useQueryClient();
+  return useMeetingNotesScopedMutation<void, DeleteMeetingNoteVariables>({
+    name: 'delete-note',
+    mutationFn: ({ noteId, expectedRevision }, { signal }) => deleteMeetingNote(noteId, expectedRevision, signal),
+    onSuccess: (_result, { noteId }, scope) => {
+      // The deleted note's own queries would only answer 404 now: they are
+      // left alone here and dropped by the view once it stops observing them
+      // (removeMeetingNoteQueries); every list refetches.
+      const root = meetingNoteQueryKeys.noteRoot(scope.userId, scope.companyId, noteId);
+      void queryClient.invalidateQueries({
+        queryKey: meetingNoteQueryKeys.scope(scope.userId, scope.companyId),
+        predicate: (query) => !root.every((part, index) => query.queryKey[index] === part),
+      });
+    },
+    onError: (error, _variables, scope) => settleConflict(queryClient, scope, error),
+  });
+}
+
+/** Drops everything cached for a deleted note (call once nothing observes it any more). */
+export function removeMeetingNoteQueries(queryClient: QueryClient, scope: Scope, noteId: string): void {
+  queryClient.removeQueries({ queryKey: meetingNoteQueryKeys.noteRoot(scope.userId, scope.companyId, noteId) });
+}
diff --git a/src/hooks/mutations/useMeetingNotesScopedMutation.ts b/src/hooks/mutations/useMeetingNotesScopedMutation.ts
new file mode 100644
index 0000000..8d2e140
--- /dev/null
+++ b/src/hooks/mutations/useMeetingNotesScopedMutation.ts
@@ -0,0 +1,146 @@
+// src/hooks/mutations/useMeetingNotesScopedMutation.ts
+// The one mutation shape of the meeting-notes client layer (Phase 6 FR-021
+// browser clause; block B review B-2). Each call records the scope (users.id
+// + company id) it started in as its onMutate result and mutationKey prefix,
+// and runs its request with an AbortSignal registered under that scope. When
+// the scope retires (useMeetingNotesScopeLifecycle) the request is aborted,
+// the mutation leaves the MutationCache, and every callback of the call — the
+// hook's and the caller's — is skipped, so a late response never downloads a
+// file, writes the cache, or shows a toast in another account's session.
+// Mutations always run (networkMode 'always'): offline, the request fails at
+// once with a network error the UI shows, instead of waiting paused.
+'use client';
+
+import { useMutation, type MutateOptions, type UseMutationResult } from '@tanstack/react-query';
+import { useCallback, useEffect, useRef } from 'react';
+
+import { meetingNoteQueryKeys, useMeetingNotesScope } from '@/hooks/queries/useMeetingNotes';
+import { MeetingNotesApiError } from '@/lib/meeting-notes/client-api';
+import {
+  isCurrentMeetingNotesOrigin,
+  isCurrentMeetingNotesScope,
+  openMeetingNotesRequest,
+  releaseMeetingNotesRequest,
+  type MeetingNotesMutationOrigin,
+  type MeetingNotesScope,
+} from '@/lib/meeting-notes/scope-fence';
+
+export interface MeetingNotesRequestContext {
+  scope: MeetingNotesScope;
+  /** Aborted when the scope retires (and on unmount with `abortOnUnmount`). */
+  signal: AbortSignal;
+}
+
+export interface MeetingNotesScopedMutationOptions<TData, TVariables> {
+  /** Names the mutation inside its scope's mutationKey. */
+  name: string;
+  mutationFn: (variables: TVariables, request: MeetingNotesRequestContext) => Promise<TData>;
+  /** Runs only while the call's scope is still the signed-in one. */
+  onSuccess?: (data: TData, variables: TVariables, scope: MeetingNotesScope) => void;
+  /** Runs only while the call's scope is still the signed-in one. */
+  onError?: (error: Error, variables: TVariables, scope: MeetingNotesScope) => void;
+  /** Abort the request when the calling component unmounts (e.g. a download). */
+  abortOnUnmount?: boolean;
+  /** How long a settled call stays in the MutationCache once unobserved. */
+  gcTime?: number;
+}
+
+export type MeetingNotesMutateOptions<TData, TVariables> = MutateOptions<
+  TData,
+  Error,
+  TVariables,
+  MeetingNotesMutationOrigin
+>;
+
+export type MeetingNotesScopedMutationResult<TData, TVariables> = Omit<
+  UseMutationResult<TData, Error, TVariables, MeetingNotesMutationOrigin>,
+  'mutate' | 'mutateAsync'
+> & {
+  mutate: (variables: TVariables, options?: MeetingNotesMutateOptions<TData, TVariables>) => void;
+};
+
+function noSession(): MeetingNotesApiError {
+  return new MeetingNotesApiError(401, 'NO_SESSION', 'Your session is not ready. Reload the page and try again.');
+}
+
+/** The caller's callbacks, each skipped once the call's scope is no longer current. */
+function fenceCallbacks<TData, TVariables>(
+  options: MeetingNotesMutateOptions<TData, TVariables> | undefined
+): MeetingNotesMutateOptions<TData, TVariables> | undefined {
+  if (!options) return undefined;
+  const { onSuccess, onError, onSettled } = options;
+  return {
+    onSuccess: onSuccess
+      ? (data, variables, origin, context) => {
+          if (isCurrentMeetingNotesOrigin(origin)) onSuccess(data, variables, origin, context);
+        }
+      : undefined,
+    onError: onError
+      ? (error, variables, origin, context) => {
+          if (isCurrentMeetingNotesOrigin(origin)) onError(error, variables, origin, context);
+        }
+      : undefined,
+    onSettled: onSettled
+      ? (data, error, variables, origin, context) => {
+          if (isCurrentMeetingNotesOrigin(origin)) onSettled(data, error, variables, origin, context);
+        }
+      : undefined,
+  };
+}
+
+export function useMeetingNotesScopedMutation<TData, TVariables>(
+  options: MeetingNotesScopedMutationOptions<TData, TVariables>
+): MeetingNotesScopedMutationResult<TData, TVariables> {
+  const scope = useMeetingNotesScope();
+  const { abortOnUnmount = false } = options;
+  const owned = useRef(new Set<AbortController>());
+
+  useEffect(() => {
+    const controllers = owned.current;
+    return () => {
+      if (abortOnUnmount) controllers.forEach((controller) => controller.abort());
+      controllers.clear();
+    };
+  }, [abortOnUnmount]);
+
+  const mutation = useMutation<TData, Error, TVariables, MeetingNotesMutationOrigin>({
+    mutationKey: scope
+      ? [...meetingNoteQueryKeys.scope(scope.userId, scope.companyId), 'mutation', options.name]
+      : ['meeting-notes', 'no-scope', 'mutation', options.name],
+    networkMode: 'always',
+    retry: 0,
+    gcTime: options.gcTime,
+    onMutate: () => {
+      if (!scope) throw noSession();
+      return { scope };
+    },
+    mutationFn: async (variables) => {
+      if (!scope || !isCurrentMeetingNotesScope(scope)) throw noSession();
+      const controller = openMeetingNotesRequest(scope);
+      owned.current.add(controller);
+      try {
+        return await options.mutationFn(variables, { scope, signal: controller.signal });
+      } finally {
+        owned.current.delete(controller);
+        releaseMeetingNotesRequest(scope, controller);
+      }
+    },
+    onSuccess: (data, variables, origin) => {
+      if (origin && isCurrentMeetingNotesOrigin(origin)) options.onSuccess?.(data, variables, origin.scope);
+    },
+    onError: (error, variables, origin) => {
+      if (origin && isCurrentMeetingNotesOrigin(origin)) options.onError?.(error, variables, origin.scope);
+    },
+  });
+
+  const { mutate: rawMutate, mutateAsync: _unfenced, ...rest } = mutation;
+  void _unfenced;
+  const mutate = useCallback(
+    (variables: TVariables, callbacks?: MeetingNotesMutateOptions<TData, TVariables>) => {
+      rawMutate(variables, fenceCallbacks(callbacks));
+    },
+    [rawMutate]
+  );
+
+  return { ...rest, mutate };
+}
