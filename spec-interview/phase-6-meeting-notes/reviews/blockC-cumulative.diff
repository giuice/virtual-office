+// src/lib/meeting-notes/ui-paths.ts
+// App URLs of the meeting-notes screens (Phase 6). The note view and the
+// create form are built in T6; every link to them goes through here.
+
+/** The Meetings page: every note of the company, with search and filters. */
+export const MEETINGS_PATH = '/meetings';
+
+/** A note's view. */
+export function meetingNotePath(noteId: string): string {
+  return `${MEETINGS_PATH}/${encodeURIComponent(noteId)}`;
+}
+
+/** The create form, preset to a space. */
+export function newMeetingNotePath(spaceId: string): string {
+  return `${MEETINGS_PATH}/new?${new URLSearchParams({ spaceId }).toString()}`;
+}
+
+/** DOM id of the admin "AI" section on the company page. */
+export const AI_SETTINGS_SECTION_ID = 'ai-settings';
+
+/** The company page's admin settings tab, scrolled to the AI section (FR-025 admin link). */
+export const AI_SETTINGS_PATH = `/company?tab=settings#${AI_SETTINGS_SECTION_ID}`;
diff --git a/src/lib/meeting-notes/validation.ts b/src/lib/meeting-notes/validation.ts
new file mode 100644
index 0000000..0fbf0d0
--- /dev/null
+++ b/src/lib/meeting-notes/validation.ts
@@ -0,0 +1,253 @@
+// src/lib/meeting-notes/validation.ts
+// Phase 6 request contracts for the meeting-note routes (FR-001, FR-011,
+// AC-002, AC-009). Limits mirror SPEC §10 and the database checks, which stay
+// the final authority. Each issue's message is a stable error code; lengths
+// count Unicode code points, like Postgres char_length.
+import { z } from 'zod';
+
+export const MEETING_NOTE_LIMITS = {
+  titleMaxChars: 200,
+  contentMaxChars: 100_000,
+  maxParticipants: 50,
+  itemDescriptionMaxChars: 1_000,
+  maxItemsPerNote: 100,
+} as const;
+
+/** Upper bound of a request body (sanitization runs on at most this much). */
+export const MEETING_NOTE_MAX_BODY_BYTES = 1_048_576;
+
+/**
+ * Transcript files (FR-012, FR-013): .txt, .vtt, or .srt (case-insensitive),
+ * 1..1,048,576 bytes (1 MB) of UTF-8 text. The database checks the stored
+ * text against the same byte limit.
+ */
+export const MEETING_NOTE_TRANSCRIPT_LIMITS = {
+  maxBytes: 1_048_576,
+  extensions: ['.txt', '.vtt', '.srt'],
+  /** Title fallback when the file name has no usable characters. */
+  fallbackTitle: 'Transcript',
+} as const;
+
+/** Unicode code points (Postgres char_length), not UTF-16 units. */
+export function codePointLength(value: string): number {
+  return Array.from(value).length;
+}
+
+/**
+ * Text Postgres can store: no NUL (22P05) and well-formed UTF-16 (a lone
+ * surrogate cannot be encoded as UTF-8; PostgREST rejects the JSON body).
+ */
+export function isStorableText(value: string): boolean {
+  return !value.includes('\u0000') && value.isWellFormed();
+}
+
+const ISO_DATE = /^\d{4}-\d{2}-\d{2}$/;
+
+/** A real calendar date 'YYYY-MM-DD' that Postgres accepts (no year 0000: 22008). */
+function isCalendarDate(value: string): boolean {
+  if (!ISO_DATE.test(value) || value.startsWith('0000')) return false;
+  const parsed = new Date(`${value}T00:00:00Z`);
+  return !Number.isNaN(parsed.getTime()) && parsed.toISOString().slice(0, 10) === value;
+}
+
+const ISO_OFFSET = /([+-])(\d{2}):(\d{2})$/;
+
+/**
+ * An ISO date-time (already accepted by z.iso.datetime) that Postgres
+ * timestamptz accepts too: zod allows year 0000 (Postgres 22008) and offsets
+ * up to ±23:59 (Postgres allows at most ±15:59, else 22009).
+ */
+function isPostgresDateTime(value: string): boolean {
+  if (value.startsWith('0000')) return false;
+  const offset = ISO_OFFSET.exec(value);
+  return offset === null || Number(offset[2]) <= 15;
+}
+
+const revisionSchema = (code: string) =>
+  z.number({ error: code }).int({ error: code }).min(1, { error: code }).max(Number.MAX_SAFE_INTEGER, { error: code });
+
+const titleSchema = z
+  .string({ error: 'MEETING_NOTE_TITLE_INVALID' })
+  .trim()
+  .refine((value) => {
+    const length = codePointLength(value);
+    return length >= 1 && length <= MEETING_NOTE_LIMITS.titleMaxChars && isStorableText(value);
+  }, { error: 'MEETING_NOTE_TITLE_INVALID' });
+
+const meetingDateSchema = z.iso
+  .datetime({ offset: true, error: 'MEETING_NOTE_DATE_REQUIRED' })
+  .refine(isPostgresDateTime, { error: 'MEETING_NOTE_DATE_REQUIRED' });
+
+// Raw content; its 100,000-char limit applies AFTER sanitization (route).
+const contentSchema = z.string({ error: 'MEETING_NOTE_CONTENT_REQUIRED' });
+
+const participantIdsSchema = z
+  .array(z.guid({ error: 'MEETING_NOTE_PARTICIPANTS_INVALID' }), { error: 'MEETING_NOTE_PARTICIPANTS_INVALID' })
+  .max(MEETING_NOTE_LIMITS.maxParticipants, { error: 'MEETING_NOTE_TOO_MANY_PARTICIPANTS' })
+  .refine((ids) => new Set(ids.map((id) => id.toLowerCase())).size === ids.length, {
+    error: 'MEETING_NOTE_PARTICIPANTS_INVALID',
+  });
+
+export const createMeetingNoteBodySchema = z.object({
+  spaceId: z.guid({ error: 'MEETING_NOTE_SPACE_INVALID' }),
+  title: titleSchema,
+  meetingDate: meetingDateSchema,
+  content: contentSchema.default(''),
+  participantIds: participantIdsSchema.default([]),
+});
+
+// Full replacement: every field is required so a missing one never wipes data.
+export const updateMeetingNoteBodySchema = z.object({
+  expectedRevision: revisionSchema('MEETING_NOTE_REVISION_REQUIRED'),
+  title: titleSchema,
+  meetingDate: meetingDateSchema,
+  content: contentSchema,
+  participantIds: participantIdsSchema,
+});
+
+export const restoreMeetingNoteBodySchema = z.object({
+  expectedRevision: revisionSchema('MEETING_NOTE_REVISION_REQUIRED'),
+  versionId: z.guid({ error: 'MEETING_NOTE_VERSION_INVALID' }),
+});
+
+const descriptionSchema = z
+  .string({ error: 'MEETING_NOTE_ITEM_DESCRIPTION_INVALID' })
+  .trim()
+  .refine((value) => {
+    const length = codePointLength(value);
+    return length >= 1 && length <= MEETING_NOTE_LIMITS.itemDescriptionMaxChars && isStorableText(value);
+  }, { error: 'MEETING_NOTE_ITEM_DESCRIPTION_INVALID' });
+
+const assigneeSchema = z.guid({ error: 'MEETING_NOTE_ITEM_ASSIGNEE_INVALID' }).nullable();
+
+const dueDateSchema = z
+  .string({ error: 'MEETING_NOTE_ITEM_DUE_DATE_INVALID' })
+  .refine(isCalendarDate, { error: 'MEETING_NOTE_ITEM_DUE_DATE_INVALID' })
+  .nullable();
+
+export const createActionItemBodySchema = z.object({
+  description: descriptionSchema,
+  assigneeId: assigneeSchema.default(null),
+  dueDate: dueDateSchema.default(null),
+});
+
+// Full replacement, like the note update.
+export const updateActionItemBodySchema = z.object({
+  expectedRevision: revisionSchema('MEETING_NOTE_ITEM_REVISION_REQUIRED'),
+  description: descriptionSchema,
+  assigneeId: assigneeSchema,
+  dueDate: dueDateSchema,
+});
+
+export const actionItemCompletionBodySchema = z.object({
+  expectedRevision: revisionSchema('MEETING_NOTE_ITEM_REVISION_REQUIRED'),
+  completed: z.boolean({ error: 'MEETING_NOTE_ITEM_COMPLETED_REQUIRED' }),
+});
+
+/** `?expectedRevision=` of DELETE requests. */
+export const expectedRevisionParamSchema = (code: string) =>
+  z
+    .string({ error: code })
+    .regex(/^[1-9]\d{0,15}$/, { error: code })
+    .transform(Number)
+    .pipe(revisionSchema(code));
+
+export const listMeetingNotesQuerySchema = z.object({
+  spaceId: z.guid({ error: 'MEETING_NOTE_SPACE_INVALID' }),
+  limit: z.coerce.number({ error: 'BAD_REQUEST' }).int({ error: 'BAD_REQUEST' }).min(1, { error: 'BAD_REQUEST' }).max(100, { error: 'BAD_REQUEST' }).default(20),
+  cursor: z.coerce.number({ error: 'BAD_REQUEST' }).int({ error: 'BAD_REQUEST' }).min(0, { error: 'BAD_REQUEST' }).max(1_000_000, { error: 'BAD_REQUEST' }).default(0),
+});
+
+export const MEETING_NOTE_SEARCH_LIMITS = {
+  queryMaxChars: 200,
+  maxPageSize: 50,
+  defaultPageSize: 20,
+  maxOffset: 10_000,
+} as const;
+
+const searchPeriodBoundSchema = z.iso
+  .datetime({ offset: true, error: 'MEETING_NOTE_SEARCH_PERIOD_INVALID' })
+  .refine(isPostgresDateTime, { error: 'MEETING_NOTE_SEARCH_PERIOD_INVALID' })
+  .optional();
+
+/**
+ * `GET /api/meeting-notes/search` query (FR-026). `q` empty = list mode;
+ * `spaceId` and `removed=true` are mutually exclusive; `from` inclusive, `to`
+ * exclusive (ISO date-time with offset); `cursor` is an offset.
+ */
+export const searchMeetingNotesQuerySchema = z
+  .object({
+    q: z
+      .string({ error: 'BAD_REQUEST' })
+      .trim()
+      .refine((value) => codePointLength(value) <= MEETING_NOTE_SEARCH_LIMITS.queryMaxChars, {
+        error: 'MEETING_NOTE_SEARCH_QUERY_TOO_LONG',
+      })
+      .refine(isStorableText, { error: 'MEETING_NOTE_SEARCH_INVALID' })
+      .default(''),
+    spaceId: z.guid({ error: 'MEETING_NOTE_SPACE_INVALID' }).optional(),
+    removed: z
+      .enum(['true', 'false'], { error: 'BAD_REQUEST' })
+      .default('false')
+      .transform((value) => value === 'true'),
+    from: searchPeriodBoundSchema,
+    to: searchPeriodBoundSchema,
+    limit: z.coerce
+      .number({ error: 'BAD_REQUEST' })
+      .int({ error: 'BAD_REQUEST' })
+      .min(1, { error: 'BAD_REQUEST' })
+      .max(MEETING_NOTE_SEARCH_LIMITS.maxPageSize, { error: 'BAD_REQUEST' })
+      .default(MEETING_NOTE_SEARCH_LIMITS.defaultPageSize),
+    cursor: z.coerce
+      .number({ error: 'BAD_REQUEST' })
+      .int({ error: 'BAD_REQUEST' })
+      .min(0, { error: 'BAD_REQUEST' })
+      .max(MEETING_NOTE_SEARCH_LIMITS.maxOffset, { error: 'BAD_REQUEST' })
+      .default(0),
+  })
+  .superRefine((value, context) => {
+    if (value.spaceId !== undefined && value.removed) {
+      context.addIssue({ code: 'custom', message: 'MEETING_NOTE_SEARCH_FILTER_INVALID', path: ['removed'] });
+    }
+    if (value.from !== undefined && value.to !== undefined && Date.parse(value.from) > Date.parse(value.to)) {
+      context.addIssue({ code: 'custom', message: 'MEETING_NOTE_SEARCH_PERIOD_INVALID', path: ['from'] });
+    }
+  });
+
+export type SearchMeetingNotesQuery = z.infer<typeof searchMeetingNotesQuerySchema>;
+
+const TIME_ZONE_NAME = /^[A-Za-z0-9_+\-/]{1,64}$/;
+
+/** true for an IANA time zone name this runtime's Intl accepts. */
+export function isSupportedTimeZone(timeZone: string): boolean {
+  if (!TIME_ZONE_NAME.test(timeZone)) return false;
+  try {
+    new Intl.DateTimeFormat('en-US', { timeZone });
+    return true;
+  } catch {
+    return false;
+  }
+}
+
+/**
+ * `GET /api/meeting-notes/[id]/export` query (FR-027): `includeTranscript`
+ * 'true' | 'false' (default false); `timeZone` the zone the meeting date is
+ * written in (default UTC).
+ */
+export const exportMeetingNoteQuerySchema = z.object({
+  includeTranscript: z
+    .enum(['true', 'false'], { error: 'BAD_REQUEST' })
+    .default('false')
+    .transform((value) => value === 'true'),
+  timeZone: z.string({ error: 'BAD_REQUEST' }).refine(isSupportedTimeZone, { error: 'BAD_REQUEST' }).default('UTC'),
+});
+
+/** Path ids: a malformed id is answered like a missing one. */
+export const pathIdSchema = z.guid();
+
+export type CreateMeetingNoteBody = z.infer<typeof createMeetingNoteBodySchema>;
+export type UpdateMeetingNoteBody = z.infer<typeof updateMeetingNoteBodySchema>;
+export type RestoreMeetingNoteBody = z.infer<typeof restoreMeetingNoteBodySchema>;
+export type CreateActionItemBody = z.infer<typeof createActionItemBodySchema>;
+export type UpdateActionItemBody = z.infer<typeof updateActionItemBodySchema>;
+export type ActionItemCompletionBody = z.infer<typeof actionItemCompletionBodySchema>;
diff --git a/src/lib/test-utils/e2e-query-cache-probe.ts b/src/lib/test-utils/e2e-query-cache-probe.ts
new file mode 100644
index 0000000..3c18f81
--- /dev/null
+++ b/src/lib/test-utils/e2e-query-cache-probe.ts
@@ -0,0 +1,54 @@
+// src/lib/test-utils/e2e-query-cache-probe.ts
+// E2E-only probe of the TanStack caches (Phase 6 AC-017; block B review B-1):
+// answers whether a given text occurs anywhere in the QueryCache or the
+// MutationCache (keys and whole states: data, variables, onMutate results,
+// errors and failure reasons, as name + message). It
+// returns a boolean only and never exposes cache contents.
+//
+// Installed by QueryProvider only when NEXT_PUBLIC_E2E === 'true', which only
+// the meeting-notes Playwright runner sets (playwright.meeting-notes.config.ts).
+// Next inlines NEXT_PUBLIC_* at build time, so in a production build without
+// that variable the install branch is the constant `undefined === 'true'` and
+// the probe is never reachable.
+import type { QueryClient } from '@tanstack/react-query';
+
+export const E2E_QUERY_CACHE_PROBE = '__voE2eQueryCacheContains';
+
+type ProbeWindow = Window & { [E2E_QUERY_CACHE_PROBE]?: (needle: string) => boolean };
+
+/** JSON of `value` with cycles cut and errors reduced to their name and message. */
+function serialize(value: unknown): string {
+  const seen = new WeakSet<object>();
+  try {
+    return JSON.stringify(value, (_key, entry: unknown) => {
+      if (entry instanceof Error) return { name: entry.name, message: entry.message };
+      if (entry !== null && typeof entry === 'object') {
+        if (seen.has(entry)) return undefined;
+        seen.add(entry);
+      }
+      return entry;
+    }) ?? '';
+  } catch {
+    return '';
+  }
+}
+
+function cacheContains(queryClient: QueryClient, needle: string): boolean {
+  if (needle.length === 0) return false;
+  for (const query of queryClient.getQueryCache().getAll()) {
+    if (serialize({ key: query.queryKey, state: query.state }).includes(needle)) return true;
+  }
+  for (const mutation of queryClient.getMutationCache().getAll()) {
+    if (serialize({ key: mutation.options.mutationKey, state: mutation.state }).includes(needle)) return true;
+  }
+  return false;
+}
+
+/** Installs the probe on `window`; returns the uninstaller. */
+export function installE2EQueryCacheProbe(queryClient: QueryClient): () => void {
+  const target = window as ProbeWindow;
+  target[E2E_QUERY_CACHE_PROBE] = (needle: string) => cacheContains(queryClient, needle);
+  return () => {
+    delete target[E2E_QUERY_CACHE_PROBE];
+  };
+}
diff --git a/src/repositories/implementations/supabase/SupabaseMeetingNoteAiOperationRepository.ts b/src/repositories/implementations/supabase/SupabaseMeetingNoteAiOperationRepository.ts
new file mode 100644
index 0000000..3b5fb7d
--- /dev/null
+++ b/src/repositories/implementations/supabase/SupabaseMeetingNoteAiOperationRepository.ts
@@ -0,0 +1,171 @@
+// src/repositories/implementations/supabase/SupabaseMeetingNoteAiOperationRepository.ts
+// AI usage and processing operations (Phase 6 T9; migration 20261013154823).
+// Construct with the user's server client for getOwnCompanyUsage (RPC granted
+// to authenticated, scoped to the caller's company), and with the
+// service-role client for admit / markDispatched / settle (service_role-only
+// RPCs), only after the route authorized the application user. Server-only:
+// an admission carries a decrypted API key and the transcript text.
+// Deliberately not re-exported from the implementations index, which client
+// code may import.
+import 'server-only';
+
+import type { PostgrestError, SupabaseClient } from '@supabase/supabase-js';
+
+import { MeetingNoteDbError } from '@/lib/meeting-notes/errors';
+import type {
+  AdmitMeetingNoteAiOperationParams,
+  IMeetingNoteAiOperationRepository,
+  MeetingNoteAiAdmission,
+  MeetingNoteAiCompanyUsage,
+  MeetingNoteAiOperationTransition,
+  MeetingNoteAiReplay,
+  MeetingNoteAiSettlement,
+} from '@/repositories/interfaces/IMeetingNoteAiOperationRepository';
+import type {
+  MeetingNoteAiOperationStatus,
+  MeetingNoteAiProvider,
+  MeetingNoteAiSettlementOutcome,
+  MeetingNoteAiUsage,
+} from '@/types/meeting-notes';
+
+const PROVIDERS: ReadonlySet<string> = new Set<MeetingNoteAiProvider>(['anthropic', 'openai', 'kimi', 'glm']);
+const STATUSES: ReadonlySet<string> = new Set<MeetingNoteAiOperationStatus>([
+  'admitted',
+  'dispatched',
+  'succeeded',
+  'failed',
+  'discarded',
+  'refunded',
+  'released',
+]);
+
+type Row = Record<string, unknown>;
+
+function toDbError(error: PostgrestError): MeetingNoteDbError {
+  return new MeetingNoteDbError(error.code, error.message, error.details);
+}
+
+/** A fixed message: never the payload (it could carry the key or transcript). */
+function invalidShape(what: string): MeetingNoteDbError {
+  return new MeetingNoteDbError(undefined, `${what} returned an unexpected shape`, null);
+}
+
+function asRow(data: unknown, what: string): Row {
+  if (!data || typeof data !== 'object' || Array.isArray(data)) throw invalidShape(what);
+  return data as Row;
+}
+
+function str(row: Row, key: string, what: string): string {
+  const value = row[key];
+  if (typeof value !== 'string') throw invalidShape(what);
+  return value;
+}
+
+function int(row: Row, key: string, what: string): number {
+  const raw = row[key];
+  const value = typeof raw === 'string' ? Number(raw) : raw;
+  if (typeof value !== 'number' || !Number.isSafeInteger(value)) throw invalidShape(what);
+  return value;
+}
+
+function bool(row: Row, key: string, what: string): boolean {
+  const value = row[key];
+  if (typeof value !== 'boolean') throw invalidShape(what);
+  return value;
+}
+
+function provider(row: Row, what: string): MeetingNoteAiProvider {
+  const value = row.provider;
+  if (typeof value !== 'string' || !PROVIDERS.has(value)) throw invalidShape(what);
+  return value as MeetingNoteAiProvider;
+}
+
+function status(row: Row, what: string): MeetingNoteAiOperationStatus {
+  const value = row.status;
+  if (typeof value !== 'string' || !STATUSES.has(value)) throw invalidShape(what);
+  return value as MeetingNoteAiOperationStatus;
+}
+
+function usage(row: Row, what: string): MeetingNoteAiUsage {
+  return {
+    limit: int(row, 'limit', what),
+    used: int(row, 'used', what),
+    usageDay: str(row, 'usage_day', what),
+    resetAt: new Date(str(row, 'reset_at', what)).toISOString(),
+  };
+}
+
+export class SupabaseMeetingNoteAiOperationRepository implements IMeetingNoteAiOperationRepository {
+  constructor(private readonly supabase: SupabaseClient) {}
+
+  async getOwnCompanyUsage(): Promise<MeetingNoteAiCompanyUsage> {
+    const what = 'get_meeting_note_ai_usage';
+    const { data, error } = await this.supabase.rpc(what);
+    if (error) throw toDbError(error);
+    const row = asRow(data, what);
+    return {
+      configured: bool(row, 'configured', what),
+      ...usage({ ...row, limit: row.daily_limit }, what),
+    };
+  }
+
+  async admit(params: AdmitMeetingNoteAiOperationParams): Promise<MeetingNoteAiAdmission | MeetingNoteAiReplay> {
+    const what = 'admit_meeting_note_ai_operation';
+    const { data, error } = await this.supabase.rpc(what, {
+      p_actor_user_id: params.actorUserId,
+      p_company_id: params.companyId,
+      p_note_id: params.noteId,
+      p_idempotency_key: params.idempotencyKey,
+      p_ticket_issued_at: params.ticketIssuedAt,
+      p_source_revision: params.sourceRevision,
+      p_transcript_id: params.transcriptId,
+      p_settings_revision: params.settingsRevision,
+    });
+    if (error) throw toDbError(error);
+    const row = asRow(data, what);
+    const base = {
+      operationId: str(row, 'operation_id', what),
+      admissionDay: str(row, 'admission_day', what),
+      provider: provider(row, what),
+      model: str(row, 'model', what),
+      reasoningLevel: str(row, 'reasoning_level', what),
+      settingsRevision: int(row, 'settings_revision', what),
+    };
+    if (bool(row, 'replay', what)) {
+      return { replay: true, status: status(row, what), ...base };
+    }
+    if (status(row, what) !== 'admitted') throw invalidShape(what);
+    return {
+      replay: false,
+      status: 'admitted',
+      ...base,
+      sourceRevision: int(row, 'source_revision', what),
+      transcriptId: str(row, 'transcript_id', what),
+      apiKey: str(row, 'api_key', what),
+      transcript: str(row, 'transcript', what),
+      usage: usage(asRow(row.usage, what), what),
+    };
+  }
+
+  async markDispatched(operationId: string): Promise<MeetingNoteAiOperationTransition> {
+    const what = 'mark_meeting_note_ai_operation_dispatched';
+    const { data, error } = await this.supabase.rpc(what, { p_operation_id: operationId });
+    if (error) throw toDbError(error);
+    const row = asRow(data, what);
+    return { operationId: str(row, 'operation_id', what), status: status(row, what), changed: bool(row, 'changed', what) };
+  }
+
+  async settle(operationId: string, outcome: MeetingNoteAiSettlementOutcome): Promise<MeetingNoteAiSettlement> {
+    const what = 'settle_meeting_note_ai_operation';
+    const { data, error } = await this.supabase.rpc(what, { p_operation_id: operationId, p_outcome: outcome });
+    if (error) throw toDbError(error);
+    const row = asRow(data, what);
+    return {
+      operationId: str(row, 'operation_id', what),
+      status: status(row, what),
+      changed: bool(row, 'changed', what),
+      counted: bool(row, 'counted', what),
+      admissionDay: str(row, 'admission_day', what),
+    };
+  }
+}
diff --git a/src/repositories/implementations/supabase/SupabaseMeetingNoteAiSettingsRepository.ts b/src/repositories/implementations/supabase/SupabaseMeetingNoteAiSettingsRepository.ts
new file mode 100644
