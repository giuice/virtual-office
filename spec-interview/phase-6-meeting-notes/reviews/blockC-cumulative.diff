+}
+
+const OPENAI_EFFORTS_LOW_TO_MAX: readonly MeetingNoteAiReasoningLevel[] = [
+  openAiEffort('low', 'Low'),
+  openAiEffort('medium', 'Medium'),
+  openAiEffort('high', 'High'),
