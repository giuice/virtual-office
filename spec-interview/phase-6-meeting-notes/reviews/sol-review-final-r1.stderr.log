// src/lib/meeting-notes/ai/adapters/openai-compatible.ts
// Chat Completions adapter for OpenAI, Kimi, and GLM (Phase 6 T11) via the
// official `openai` SDK pointed at each provider's OpenAI-compatible base URL.
// Request: model, [system prompt, ONE user message holding only the normalized
// transcript], the matrix's output-budget field (`max_completion_tokens` or
// GLM's `max_tokens`) = the model's maxOutputTokens, `response_format`
// (json_schema strict for OpenAI/Kimi, json_object for GLM â€” validated after
// parsing), the matrix's reasoning fragment (`reasoning_effort` or GLM's
// `thinking`), stream: true, and â€” OpenAI only â€” `stream_options.include_usage`.
// No temperature/top_p (fixed or unsupported on these reasoning models).
// Streaming: as in the Anthropic adapter, the initial response is awaited
// separately from the chunk iteration, so a `data: {"error":â€¦}` chunk after the
// 200 is counted while an initial listed rejection can be refunded (FR-022).
import 'server-only';

import OpenAI from 'openai';
import type { ChatCompletionCreateParamsStreaming } from 'openai/resources/chat/completions';
import type { ResponseFormatJSONObject, ResponseFormatJSONSchema } from 'openai/resources/shared';

import { MEETING_NOTE_AI_CAPABILITIES } from '../capabilities';
import { MEETING_NOTE_AI_DRAFT_JSON_SCHEMA, MEETING_NOTE_AI_DRAFT_SCHEMA_NAME } from '../draft-schema';
import { MEETING_NOTE_AI_SYSTEM_PROMPT } from '../prompt';
import {
  mergeWireFragment,
  type MeetingNoteAiAdapterRequest,
  type MeetingNoteAiStreamOutcome,
} from './transport';

export function buildOpenAiCompatibleDraftRequest(
  request: Pick<MeetingNoteAiAdapterRequest, 'provider' | 'model' | 'level' | 'transcript'>
): ChatCompletionCreateParamsStreaming {
  const capability = MEETING_NOTE_AI_CAPABILITIES[request.provider];
  const responseFormat: ResponseFormatJSONSchema | ResponseFormatJSONObject =
    capability.jsonOutput === 'json_schema'
      ? {
          type: 'json_schema',
          json_schema: { name: MEETING_NOTE_AI_DRAFT_SCHEMA_NAME, strict: true, schema: { 
...MEETING_NOTE_AI_DRAFT_JSON_SCHEMA } },
        }
      : { type: 'json_object' };
  const base: ChatCompletionCreateParamsStreaming = {
    model: request.model.id,
    messages: [
      { role: 'system', content: MEETING_NOTE_AI_SYSTEM_PROMPT },
      { role: 'user', content: request.transcript },
    ],
    response_format: responseFormat,
    stream: true,
    ...(request.provider === 'openai' ? { stream_options: { include_usage: true } } : {}),
  };
  if (capability.outputBudgetParam === 'max_completion_tokens') base.max_completion_tokens = 
request.model.maxOutputTokens;
  else base.max_tokens = request.model.maxOutputTokens;
  return mergeWireFragment(base, request.level.wire);
}

function finishOf(finishReason: string | null, refused: boolean): MeetingNoteAiStreamOutcome['finish'] {
  if (refused) return 'refusal';
  switch (finishReason) {
    case null:
      return 'incomplete';
    case 'stop':
      return 'end';
    case 'length':
      return 'length';
    // OpenAI/Kimi content filter; GLM "sensitive".
    case 'content_filter':
    case 'sensitive':
      return 'refusal';
    default:
      return 'other';
  }
}

export async function runOpenAiCompatibleDraftRequest(
  request: MeetingNoteAiAdapterRequest
): Promise<MeetingNoteAiStreamOutcome> {
  const client = new OpenAI({
    apiKey: request.apiKey,
    // Explicit values stop the SDK reading OPENAI_API_KEY / ADMIN_KEY / ORG_ID /
    // PROJECT_ID / WEBHOOK_SECRET / OPENAI_LOG. The SDK still reads
    // OPENAI_CUSTOM_HEADERS, so the transport (request.fetch) rebuilds the
    // headers from an allowlist and sets only the admitted key â€” nothing
    // ambient reaches OpenAI, Kimi, or GLM.
    adminAPIKey: null,
    organization: null,
    project: null,
    webhookSecret: null,
    baseURL: request.baseUrl,
    maxRetries: 0,
    timeout: request.sdkTimeoutMs,
    fetch: request.fetch,
    logLevel: 'off',
  });

  // Phase 1: initial response (non-2xx and connection failures throw here).
  const stream = await client.chat.completions.create(buildOpenAiCompatibleDraftRequest(request), {
    signal: request.signal,
  });

  // Phase 2: inside an accepted response.
  let text = '';
  let refused = false;
  let finishReason: string | null = null;
  const usage: MeetingNoteAiStreamOutcome['usage'] = {};
  for await (const chunk of stream) {
    if (chunk.usage) {
      usage.inputTokens = chunk.usage.prompt_tokens;
      usage.outputTokens = chunk.usage.completion_tokens;
    }
    const choice = chunk.choices?.[0];
    if (!choice) continue;
    if (typeof choice.delta?.content === 'string') text += choice.delta.content;
    if (choice.delta?.refusal) refused = true;
    if (choice.finish_reason) finishReason = choice.finish_reason;
  }
  return { text, finish: finishOf(finishReason, refused), usage };
}
// src/lib/meeting-notes/ai/adapters/anthropic.ts
// Anthropic Messages adapter (Phase 6 T11) via the official `@anthropic-ai/sdk`.
// Request: model, max_tokens = the model's maxOutputTokens, system prompt, ONE
// user message holding only the normalized transcript, `output_config` =
// { format: json_schema draft schema } merged with the matrix's reasoning
// fragment ({ effort }), stream: true. No `thinking` (adaptive is the default
// and `disabled`/`budget_tokens` are rejected on these models), no sampling
// parameters, no server-side `fallbacks` (FR-016/BR-013: no fallback to a
// model the admin did not choose).
// Streaming: the initial response (status + headers) is awaited separately
// from the event iteration, so an error that arrives after the 200 â€” such as
// an `overloaded_error` SSE event â€” is "inside an accepted response" and
// counted, while an initial 529 can be classified as a rejection (FR-022).
import 'server-only';

import Anthropic from '@anthropic-ai/sdk';

import { MEETING_NOTE_AI_DRAFT_JSON_SCHEMA } from '../draft-schema';
import { MEETING_NOTE_AI_SYSTEM_PROMPT } from '../prompt';
import {
  mergeWireFragment,
  type MeetingNoteAiAdapterRequest,
  type MeetingNoteAiStreamOutcome,
} from './transport';

export function buildAnthropicDraftRequest(
  request: Pick<MeetingNoteAiAdapterRequest, 'model' | 'level' | 'transcript'>
): Anthropic.MessageCreateParamsStreaming {
  const base: Anthropic.MessageCreateParamsStreaming = {
    model: request.model.id,
    max_tokens: request.model.maxOutputTokens,
    system: MEETING_NOTE_AI_SYSTEM_PROMPT,
    messages: [{ role: 'user', content: request.transcript }],
    output_config: { format: { type: 'json_schema', schema: { ...MEETING_NOTE_AI_DRAFT_JSON_SCHEMA } } },
    stream: true,
  };
  return mergeWireFragment(base, request.level.wire);
}

function finishOf(stopReason: string | null, stopped: boolean): MeetingNoteAiStreamOutcome['finish'] {
  if (!stopped || stopReason === null) return 'incomplete';
  switch (stopReason) {
    case 'end_turn':
    case 'stop_sequence':
      return 'end';
    case 'max_tokens':
    case 'model_context_window_exceeded':
      return 'length';
    case 'refusal':
      return 'refusal';
    default:
      return 'other';
  }
}

export async function runAnthropicDraftRequest(request: MeetingNoteAiAdapterRequest): 
Promise<MeetingNoteAiStreamOutcome> {
  const client = new Anthropic({
    apiKey: request.apiKey,
    // An explicit key and a null token stop the SDK's own credential chain and
    // ANTHROPIC_AUTH_TOKEN; the SDK still reads ANTHROPIC_CUSTOM_HEADERS, so
    // the transport (request.fetch) rebuilds the headers from an allowlist and
    // sets only the admitted key. logLevel 'off' ignores ANTHROPIC_LOG.
    authToken: null,
    baseURL: request.baseUrl,
    maxRetries: 0,
    timeout: request.sdkTimeoutMs,
    fetch: request.fetch,
    logLevel: 'off',
  });

  // Phase 1: resolves once a 2xx response's headers arrived; a non-2xx
  // initial response or a connection failure throws here.
  const stream = await client.messages.create(buildAnthropicDraftRequest(request), { signal: request.signal });

  // Phase 2: everything below is inside an accepted response.
  let text = '';
  let stopReason: string | null = null;
  let stopped = false;
  const usage: MeetingNoteAiStreamOutcome['usage'] = {};
  for await (const event of stream) {
    switch (event.type) {
      case 'message_start':
        usage.inputTokens = event.message.usage.input_tokens;
        break;
      case 'content_block_delta':
        if (event.delta.type === 'text_delta') text += event.delta.text;
        break;
      case 'message_delta':
        stopReason = event.delta.stop_reason;
        usage.outputTokens = event.usage.output_tokens;
        break;
      case 'message_stop':
        stopped = true;
        break;
      default:
        break;
    }
  }
  return { text, finish: finishOf(stopReason, stopped), usage };
}
// src/lib/meeting-notes/ai/adapters/index.ts
// Server-only entry point of the meeting-note AI adapters (Phase 6 T11;
// SPEC FR-016, FR-020, FR-021, FR-022, AC-026, AC-029). T12 calls
// generateMeetingNoteDraft with the snapshot taken at admission and the
// transcript ALREADY normalized (normalizeTranscriptForProvider).
//
// Per call, in order: matrix check of provider/model/reasoning level and key
// presence â†’ FR-020 size preflight â†’ base URL (server env override, refused in
// production) â†’ caller-abort check â†’ exactly ONE outbound streaming request
// (SDK retries off, a second request refused and redirects never followed by
// the transport guard, which also sends only allowlisted headers plus the
// admitted key) â†’ deadline/abort check â†’ stop reason check â†’ JSON parse +
// shared draft-schema validation.
// Nothing here logs the key, the transcript, or provider text.
//
// Timeout: 180 s by default (SM-1 expects â‰¤60 s for a one-hour transcript;
// T9's stale job fails dispatched operations after 10 minutes, so the
// deadline must stay well below that). The deadline covers the whole streamed
// response, not only the headers.
import 'server-only';

import type { MeetingNoteAiProvider } from '@/types/meeting-notes';

import { findMeetingNoteAiModel, MEETING_NOTE_AI_CAPABILITIES } from '../capabilities';
import { resolveMeetingNoteAiBaseUrl } from '../base-url';
import { parseMeetingNoteAiDraft } from '../draft-schema';
import { preflightMeetingNoteAiTranscript } from '../preflight';
import {
  meetingNoteAiFailure,
  meetingNoteAiTooLongFailure,
  type MeetingNoteAiDraftResult,
} from '../provider-errors';
import { runAnthropicDraftRequest } from './anthropic';
import { runOpenAiCompatibleDraftRequest } from './openai-compatible';
import {
  createDispatchFetch,
  createDispatchState,
  createRequestControl,
  mapMeetingNoteAiTransportError,
  type MeetingNoteAiStreamOutcome,
} from './transport';

export const MEETING_NOTE_AI_DEFAULT_TIMEOUT_MS = 180_000;
/** Upper bound for a caller-supplied timeout (stale-operation job: 10 min). */
export const MEETING_NOTE_AI_MAX_TIMEOUT_MS = 300_000;
const SDK_TIMEOUT_MARGIN_MS = 5_000;

export interface GenerateMeetingNoteDraftInput {
  provider: MeetingNoteAiProvider;
  model: string;
  reasoningLevel: string;
  /** The company's provider key (from the admission snapshot). Never logged or returned. */
  apiKey: string;
  /** Normalized transcript; the ONLY content sent to the provider. */
  transcript: string;
  /** Aborts the outbound request (client left the page). */
  signal?: AbortSignal;
  /** Deadline for the whole request, 1 ms â€“ 300 s; default 180 s. */
  timeoutMs?: number;
}

function outcomeFailure(provider: MeetingNoteAiProvider, outcome: MeetingNoteAiStreamOutcome) {
  switch (outcome.finish) {
    case 'refusal':
      return meetingNoteAiFailure(provider, 'MEETING_NOTE_AI_REFUSED', true);
    case 'length':
      return meetingNoteAiFailure(provider, 'MEETING_NOTE_AI_OUTPUT_TRUNCATED', true);
    case 'incomplete':
      return meetingNoteAiFailure(provider, 'MEETING_NOTE_AI_STREAM_INTERRUPTED', true);
    case 'other':
      return meetingNoteAiFailure(provider, 'MEETING_NOTE_AI_OUTPUT_INVALID', true);
    case 'end':
      return null;
  }
}

export async function generateMeetingNoteDraft(input: GenerateMeetingNoteDraftInput): 
Promise<MeetingNoteAiDraftResult> {
  const { provider } = input;
  if (!Object.hasOwn(MEETING_NOTE_AI_CAPABILITIES, provider)) {
    // Unknown provider: no label to name; fall back to a neutral one.
    return meetingNoteAiFailure('openai', 'MEETING_NOTE_AI_CONFIGURATION_INVALID', false);
  }
  const model = findMeetingNoteAiModel(provider, input.model);
  const level = model?.reasoningLevels.find((entry) => entry.id === input.reasoningLevel);
  if (!model || !level || typeof input.apiKey !== 'string' || input.apiKey.trim() === '') {
    return meetingNoteAiFailure(provider, 'MEETING_NOTE_AI_CONFIGURATION_INVALID', false);
  }

  const preflight = preflightMeetingNoteAiTranscript({ provider, model: model.id, transcript: input.transcript });
  if (!preflight.ok) {
    return preflight.code === 'MEETING_NOTE_AI_TRANSCRIPT_TOO_LONG_FOR_MODEL'
      ? meetingNoteAiTooLongFailure(provider, preflight)
      : meetingNoteAiFailure(provider, preflight.code, false);
  }

  const baseUrl = resolveMeetingNoteAiBaseUrl(provider);
  if (!baseUrl.ok) return meetingNoteAiFailure(provider, baseUrl.code, false);

  if (input.signal?.aborted) return meetingNoteAiFailure(provider, 'MEETING_NOTE_AI_CANCELLED_BEFORE_SEND', false);

  const timeoutMs = Math.min(
    Math.max(1, Math.floor(input.timeoutMs ?? MEETING_NOTE_AI_DEFAULT_TIMEOUT_MS)),
    MEETING_NOTE_AI_MAX_TIMEOUT_MS
  );
  const state = createDispatchState();
  const control = createRequestControl(input.signal, timeoutMs);
  const protocol = MEETING_NOTE_AI_CAPABILITIES[provider].protocol;
  const request = {
    provider,
    apiKey: input.apiKey,
    baseUrl: baseUrl.baseUrl,
    model,
    level,
    transcript: input.transcript,
    fetch: createDispatchFetch(state, {
      scheme: protocol === 'anthropic-messages' ? 'x-api-key' : 'bearer',
      apiKey: input.apiKey,
    }),
    signal: control.signal,
    sdkTimeoutMs: timeoutMs + SDK_TIMEOUT_MARGIN_MS,
  };

  try {
    const outcome =
      protocol === 'anthropic-messages' ? await runAnthropicDraftRequest(request) : await 
runOpenAiCompatibleDraftRequest(request);

    // The SDKs end an aborted stream silently. Whatever was read before the
    // deadline or the caller's abort â€” even a complete draft and a stop
    // signal followed by a stalled connection â€” the call did not finish in
    // time: a counted timeout/cancellation, and the draft is discarded.
    if (control.reason) {
      return mapMeetingNoteAiTransportError(provider, state, control);
    }
    const stopFailure = outcomeFailure(provider, outcome);
    if (stopFailure) return stopFailure;

    const parsed = parseMeetingNoteAiDraft(outcome.text);
    if (!parsed.ok) {
      const code =
        parsed.reason === 'empty'
          ? 'MEETING_NOTE_AI_OUTPUT_EMPTY'
          : parsed.reason === 'malformed'
            ? 'MEETING_NOTE_AI_OUTPUT_MALFORMED'
            : 'MEETING_NOTE_AI_OUTPUT_INVALID';
      return meetingNoteAiFailure(provider, code, true);
    }
    const hasUsage = outcome.usage.inputTokens !== undefined || outcome.usage.outputTokens !== undefined;
    return { ok: true, draft: parsed.draft, dispatched: true, ...(hasUsage ? { usage: outcome.usage } : {}) };
  } catch {
    // The thrown error is not inspected or logged: SDK errors can carry
    // provider text. The dispatch state decides.
    return mapMeetingNoteAiTransportError(provider, state, control);
  } finally {
    control.dispose();
  }
}

export { preflightMeetingNoteAiTranscript } from '../preflight';
export type {
  MeetingNoteAiDraftFailure,
  MeetingNoteAiDraftResult,
  MeetingNoteAiDraftSuccess,
  MeetingNoteAiFailureCode,
  MeetingNoteAiFailureKind,
} from '../provider-errors';

