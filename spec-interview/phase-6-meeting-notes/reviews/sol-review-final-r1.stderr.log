   2: 'use client';
   3: 
   4: import { useEffect, useState } from 'react';
   5: import { redirect, useRouter } from 'next/navigation';
   6: import { DashboardShell } from '@/components/shell/dashboard-shell';
   7: import { Tabs, TabsContent, TabsList, TabsTrigger } from '@/components/ui/tabs';
   8: import { CompanySettings } from '@/components/dashboard/company-settings';
   9: import { CompanyMembers } from '@/components/dashboard/company-members';
  10: import { MeetingNoteAiSettingsSection } from '@/components/meeting-notes/MeetingNoteAiSettingsSection';
  11: import { useCompany } from '@/contexts/CompanyContext';
  12: import { Card, CardContent, CardDescription, CardHeader, CardTitle } from '@/components/ui/card';
  13: import { Button } from '@/components/ui/button';
  14: 
  15: export default function CompanyPage() {
  16:   const { company, currentUserProfile, isLoading } = useCompany();
  17:   const router = useRouter();
  18:   
  19:   // Get tab from URL or default to members
  20:   const [activeTab, setActiveTab] = useState(() => {
  21:     if (typeof window !== 'undefined') {
  22:       const params = new URLSearchParams(window.location.search);
  23:       return params.get('tab') || 'members';
  24:     }
  25:     return 'members';
  26:   });
  27:   
  28:   // A client-side navigation (e.g. the meeting-note AI settings link) can mount
  29:   // this page before window.location shows the new query, so the initializer
  30:   // above may read the previous URL; re-read it once the navigation committed.
  31:   useEffect(() => {
  32:     const tab = new URLSearchParams(window.location.search).get('tab');
  33:     if (tab) setActiveTab(tab);
  34:   }, []);
  35:   
  36:   // Update URL when tab changes
  37:   const handleTabChange = (tab: string) => {
  38:     setActiveTab(tab);
  39:     router.push(`/company?tab=${tab}`, { scroll: false });
  40:   };
  41:   
  42:   // Check if the user belongs to a company
  43:   const hasCompany = Boolean(currentUserProfile?.companyId);
  44:   
  45:   // Check if the user is an admin (only admins can access settings tab)
  46:   const isAdmin = company?.adminIds?.includes(currentUserProfile?.id || '') || false;
  47: 
  48:   // If still loading, show loading state
  49:   if (isLoading) {
  50:     return (
  51:       <DashboardShell
  52:         heading="Company Management"
  53:         description="Loading company information..."
  54:       >
  55:         <div className="grid gap-8">
  56:           <Card>
  57:             <CardHeader>
  58:               <CardTitle className="animate-pulse bg-muted h-6 w-48 rounded"></CardTitle>
  59:               <CardDescription className="animate-pulse bg-muted h-4 w-72 rounded mt-2"></CardDescription>
  60:             </CardHeader>
  61:             <CardContent>
  62:               <div className="animate-pulse space-y-4">
  63:                 <div className="h-8 bg-muted rounded w-full"></div>
  64:                 <div className="h-24 bg-muted rounded w-full"></div>
  65:               </div>
  66:             </CardContent>
  67:           </Card>
  68:         </div>
  69:       </DashboardShell>
  70:     );
  71:   }
  72: 
  73:   if (!hasCompany) {
  74:     redirect('/create-company');
  75:   }
  76: 
  77:   // If no company, show placeholder (should redirect, but just in case)
  78:   if (!hasCompany) {
  79:     return (
  80:       <DashboardShell
  81:         heading="Company Management"
  82:         description="You need to create or join a company first"
  83:       >
  84:         <div className="grid gap-8">
  85:           <Card>
  86:             <CardHeader>
  87:               <CardTitle>No Company Found</CardTitle>
  88:               <CardDescription>
  89:                 You need to create or join a company to access this page
  90:               </CardDescription>
  91:             </CardHeader>
  92:             <CardContent>
  93:               <Button onClick={() => router.push('/create-company')}>
  94:                 Create Company
  95:               </Button>
  96:             </CardContent>
  97:           </Card>
  98:         </div>
  99:       </DashboardShell>
 100:     );
 101:   }
 102: 
 103:   return (
 104:     <DashboardShell
 105:       heading="Company Management"
 106:       description={`Manage ${company?.name || 'your company'} settings, members and permissions`}
 107:     >
 108:       <div className="grid gap-8">
 109:         <Tabs 
 110:           defaultValue="members" 
 111:           className="w-full"
 112:           value={activeTab}
 113:           onValueChange={handleTabChange}
 114:         >
 115:           <TabsList className="mb-6">
 116:             <TabsTrigger value="members">Team Members</TabsTrigger>
 117:             {isAdmin && <TabsTrigger value="settings">Company Settings</TabsTrigger>}
 118:           </TabsList>
 119:           
 120:           <TabsContent value="members" className="space-y-4">
 121:             <CompanyMembers />
 122:           </TabsContent>
 123:           
 124:           {isAdmin && (
 125:             <TabsContent value="settings" className="space-y-4">
 126:               <CompanySettings />
 127:               <MeetingNoteAiSettingsSection />
 128:             </TabsContent>
 129:           )}
 130:         </Tabs>
 131:       </div>
 132:     </DashboardShell>
 133:   );
 134: }
