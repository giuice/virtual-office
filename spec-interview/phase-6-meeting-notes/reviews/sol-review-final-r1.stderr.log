// src/app/api/meeting-notes/search/route.ts
import { NextRequest, NextResponse } from 'next/server';
import { MeetingNoteDbError } from '@/lib/meeting-notes/errors';
import {
  beginMeetingNoteRequest,
  internalError,
  meetingNoteError,
  ok,
  parseWith,
} from '@/lib/meeting-notes/route-support';
import { searchMeetingNotesQuerySchema } from '@/lib/meeting-notes/validation';

export const dynamic = 'force-dynamic';

/**
 * GET /api/meeting-notes/search?q=&spaceId=&removed=&from=&to=&limit=&cursor=
 * Full-text search over the caller's company's notes (FR-004, FR-026): title,
 * content text, summary, and action-item descriptions; accent- and
 * case-insensitive, Portuguese and English. Called with the caller's session:
 * public.search_meeting_notes resolves the caller from auth.uid()
 * (users.supabase_uid) and reads only notes of that user's company_id (the
 * RLS read rule, BR-001), so another company's notes never appear.
 *
 * - `q` (<= 200 chars, websearch syntax). Empty or absent = list mode: every
 *   note within the filters, newest meeting first, `relevance`/`excerpt` null.
 * - `spaceId` = only that space; `removed=true` = only notes whose space was
 *   deleted ("Space removed"); not both (400 MEETING_NOTE_SEARCH_FILTER_INVALID).
 * - `from` (inclusive) / `to` (exclusive): ISO date-times with offset on the
 *   meeting date (400 MEETING_NOTE_SEARCH_PERIOD_INVALID when malformed or from > to).
 * - `limit` 1..50 (default 20); `cursor` = offset 0..10,000 (default 0).
 * - Matching is per document: the note's own text (title, content, summary)
 *   or ONE action item; all words of `q` (and any `-word` exclusion) apply
 *   within that document, so words split between the note text and an item,
 *   or across two items, do not combine into one match.
 * - Rate limit 'meeting-note:search' (120/min per user, fail-open) -> 429.
 *
 * 200 { items: MeetingNoteSearchResult[], nextCursor, hasMore, totalCount }:
 * relevance desc, meeting date desc, id desc. Each excerpt is plain-text
 * segments with `highlighted` matches (render as text). Never returns content,
 * summary, or transcript text beyond the excerpt.
 */
export async function GET(request: NextRequest): Promise<NextResponse> {
  const begun = await beginMeetingNoteRequest('/api/meeting-notes/search', 'meeting-note:search');
  if (!begun.ok) return begun.response;
  const ctx = begun.value;

  const params = request.nextUrl.searchParams;
  const query = parseWith(
    searchMeetingNotesQuerySchema,
    {
      q: params.get('q') ?? undefined,
      spaceId: params.get('spaceId') ?? undefined,
      removed: params.get('removed') ?? undefined,
      from: params.get('from') ?? undefined,
      to: params.get('to') ?? undefined,
      limit: params.get('limit') ?? undefined,
      cursor: params.get('cursor') ?? undefined,
    },
    ctx
  );
  if (!query.ok) return query.response;

  try {
    const page = await ctx.repository.searchNotes({
      query: query.value.q,
      spaceId: query.value.spaceId ?? null,
      spaceRemoved: query.value.removed,
      meetingFrom: query.value.from ?? null,
      meetingTo: query.value.to ?? null,
      limit: query.value.limit,
      offset: query.value.cursor,
    });
    return ok(page, ctx);
  } catch (error) {
    if (error instanceof MeetingNoteDbError && error.sqlstate === '22023' && error.token === 
'MEETING_NOTE_SEARCH_INVALID') {
      return meetingNoteError(400, error.token, ctx, 'meetingNotes.search');
    }
    return internalError(error, ctx, 'meetingNotes.search');
  }
}
// src/hooks/mutations/useMeetingNoteActionItemMutations.ts
// Action-item changes (Phase 6 FR-011, BR-005): add, edit, delete (editors)
// and completion (editors and the item's current assignee). Each change is
// checked by the route and the database against the item's revision; a stale
// one fails with MeetingNoteItemConflictError (409) carrying the newer item.
// Every change the server answered writes the returned item into the cached
// note and refreshes the viewer's meeting-note scope (search indexes item
// text); a request that never reached the server (offline, aborted) changes
// nothing in the cache. Every change runs through
// useMeetingNotesScopedMutation (scope fence).
'use client';

import { useQueryClient, type QueryClient } from '@tanstack/react-query';

import { useMeetingNotesScopedMutation } from '@/hooks/mutations/useMeetingNotesScopedMutation';
import { meetingNoteQueryKeys } from '@/hooks/queries/useMeetingNotes';
import {
  createMeetingNoteActionItem,
  deleteMeetingNoteActionItem,
  MeetingNoteItemConflictError,
  MeetingNotesApiError,
  setMeetingNoteActionItemCompleted,
  updateMeetingNoteActionItem,
} from '@/lib/meeting-notes/client-api';
import type { MeetingNotesScope } from '@/lib/meeting-notes/scope-fence';
import type {
  MeetingNoteActionItemFieldsInput,
  MeetingNoteActionItemView,
  MeetingNoteDetail,
} from '@/types/meeting-notes';

type Scope = MeetingNotesScope;

type ItemChange = { kind: 'upsert'; item: MeetingNoteActionItemView } | { kind: 'remove'; itemId: string };

function applyChange(items: MeetingNoteActionItemView[], change: ItemChange): MeetingNoteActionItemView[] {
  if (change.kind === 'remove') return items.filter((item) => item.id !== change.itemId);
  const index = items.findIndex((item) => item.id === change.item.id);
  if (index === -1) return [...items, change.item];
  // Never replace a newer cached state with an older response.
  if (items[index].revision > change.item.revision) return items;
  return items.map((item, position) => (position === index ? change.item : item));
}

/** Writes the change into the cached note (if any), then refreshes everything of this viewer. */
function settleItem(queryClient: QueryClient, scope: Scope, noteId: string, change: ItemChange | null): void {
  if (change) {
    queryClient.setQueryData<MeetingNoteDetail>(meetingNoteQueryKeys.note(scope.userId, scope.companyId, noteId), 
(note) =>
      note ? { ...note, actionItems: applyChange(note.actionItems, change) } : note
    );
  }
  void queryClient.invalidateQueries({ queryKey: meetingNoteQueryKeys.scope(scope.userId, scope.companyId) });
}

/**
 * After a failure: a 409 brings the newer item; another answer from the server
 * refreshes; a request that never got an answer (status 0, aborted) changes nothing.
 */
function settleItemError(queryClient: QueryClient, scope: Scope, noteId: string, error: unknown): void {
  if (!(error instanceof MeetingNotesApiError) || error.status === 0) return;
  settleItem(
    queryClient,
    scope,
    noteId,
    error instanceof MeetingNoteItemConflictError ? { kind: 'upsert', item: error.item } : null
  );
}

export interface CreateMeetingNoteActionItemVariables {
  noteId: string;
  fields: MeetingNoteActionItemFieldsInput;
}

export function useCreateMeetingNoteActionItem() {
  const queryClient = useQueryClient();
  return useMeetingNotesScopedMutation<MeetingNoteActionItemView, CreateMeetingNoteActionItemVariables>({
    name: 'create-item',
    mutationFn: ({ noteId, fields }, { signal }) => createMeetingNoteActionItem(noteId, fields, signal),
    onSuccess: (item, { noteId }, scope) => settleItem(queryClient, scope, noteId, { kind: 'upsert', item }),
    onError: (error, { noteId }, scope) => settleItemError(queryClient, scope, noteId, error),
  });
}

export interface UpdateMeetingNoteActionItemVariables {
  noteId: string;
  itemId: string;
  expectedRevision: number;
  fields: MeetingNoteActionItemFieldsInput;
}

export function useUpdateMeetingNoteActionItem() {
  const queryClient = useQueryClient();
  return useMeetingNotesScopedMutation<MeetingNoteActionItemView, UpdateMeetingNoteActionItemVariables>({
    name: 'update-item',
    mutationFn: ({ noteId, itemId, expectedRevision, fields }, { signal }) =>
      updateMeetingNoteActionItem(noteId, itemId, expectedRevision, fields, signal),
    onSuccess: (item, { noteId }, scope) => settleItem(queryClient, scope, noteId, { kind: 'upsert', item }),
    onError: (error, { noteId }, scope) => settleItemError(queryClient, scope, noteId, error),
  });
}

export interface DeleteMeetingNoteActionItemVariables {
  noteId: string;
  itemId: string;
  expectedRevision: number;
}

export function useDeleteMeetingNoteActionItem() {
  const queryClient = useQueryClient();
  return useMeetingNotesScopedMutation<void, DeleteMeetingNoteActionItemVariables>({
    name: 'delete-item',
    mutationFn: ({ noteId, itemId, expectedRevision }, { signal }) =>
      deleteMeetingNoteActionItem(noteId, itemId, expectedRevision, signal),
    onSuccess: (_result, { noteId, itemId }, scope) => settleItem(queryClient, scope, noteId, { kind: 'remove', itemId 
}),
    onError: (error, { noteId }, scope) => settleItemError(queryClient, scope, noteId, error),
  });
}

export interface SetMeetingNoteActionItemCompletedVariables {
  noteId: string;
  itemId: string;
  expectedRevision: number;
  completed: boolean;
}

export function useSetMeetingNoteActionItemCompleted() {
  const queryClient = useQueryClient();
  return useMeetingNotesScopedMutation<MeetingNoteActionItemView, SetMeetingNoteActionItemCompletedVariables>({
    name: 'complete-item',
    mutationFn: ({ noteId, itemId, expectedRevision, completed }, { signal }) =>
      setMeetingNoteActionItemCompleted(noteId, itemId, expectedRevision, completed, signal),
    onSuccess: (item, { noteId }, scope) => settleItem(queryClient, scope, noteId, { kind: 'upsert', item }),
    onError: (error, { noteId }, scope) => settleItemError(queryClient, scope, noteId, error),
  });
}
// src/components/meeting-notes/MeetingNoteActionItemRow.tsx
// One action item (FR-011, BR-005, AC-008, AC-009): description as plain
// text, assignee, due date exactly as stored, and status. Editors and the
// item's current assignee get the completion checkbox; everyone else sees the
// status only. Editors also edit and delete. A completion that lost a race
// shows the newer item and offers to try again on it.
'use client';

import { Pencil } from 'lucide-react';
import { useState } from 'react';

import { Badge } from '@/components/ui/badge';
import { Button } from '@/components/ui/button';
import { useSetMeetingNoteActionItemCompleted } from '@/hooks/mutations/useMeetingNoteActionItemMutations';
import { MeetingNoteItemConflictError } from '@/lib/meeting-notes/client-api';
import { formatMeetingNoteDueDate } from '@/lib/meeting-notes/format';
import { describeMeetingNoteItemError } from '@/lib/meeting-notes/item-errors';
import { cn } from '@/lib/utils';
import type { User } from '@/types/database';
import type { MeetingNoteActionItemView } from '@/types/meeting-notes';
import { MeetingNoteActionItemAssignee } from './MeetingNoteActionItemAssignee';
import { MeetingNoteActionItemConflictNotice } from './MeetingNoteActionItemConflictNotice';
import { MeetingNoteActionItemDeleteButton } from './MeetingNoteActionItemDeleteButton';
import { MeetingNoteActionItemForm } from './MeetingNoteActionItemForm';

export interface MeetingNoteActionItemRowProps {
  noteId: string;
  item: MeetingNoteActionItemView;
  /** Note editor: edit, delete, and completion. */
  canEdit: boolean;
  /** Editor or the item's current assignee. */
  canToggle: boolean;
  members: readonly User[];
  membersById: ReadonlyMap<string, User>;
}

const LABEL_PREVIEW_CHARS = 80;

function preview(text: string): string {
  const flat = text.replace(/\s+/g, ' ').trim();
  return flat.length > LABEL_PREVIEW_CHARS ? `${flat.slice(0, LABEL_PREVIEW_CHARS)}â€¦` : flat;
}

export function MeetingNoteActionItemRow({ noteId, item, canEdit, canToggle, members, membersById }: 
MeetingNoteActionItemRowProps) {
  const toggle = useSetMeetingNoteActionItemCompleted();
  const [editing, setEditing] = useState(false);
  const [conflict, setConflict] = useState<{ newer: MeetingNoteActionItemView; wanted: boolean } | null>(null);
  const due = formatMeetingNoteDueDate(item.dueDate);

  const setCompleted = (completed: boolean, expectedRevision: number) => {
    setConflict(null);
    toggle.mutate(
      { noteId, itemId: item.id, expectedRevision, completed },
      {
        onError: (error) => {
          if (error instanceof MeetingNoteItemConflictError) setConflict({ newer: error.item, wanted: completed });
        },
      }
    );
  };

  if (editing) {
    return (
      <li data-testid="meeting-note-item" data-item-id={item.id} data-editing="true">
        <MeetingNoteActionItemForm
          noteId={noteId}
          item={item}
          members={members}
          membersById={membersById}
          onSaved={() => setEditing(false)}
          onCancel={() => setEditing(false)}
        />
      </li>
    );
  }

  return (
    <li
      className="flex flex-col gap-2 rounded-lg border border-[var(--vo-line-soft)] p-3"
      data-testid="meeting-note-item"
      data-item-id={item.id}
      data-completed={item.completed ? 'true' : 'false'}
      data-revision={item.revision}
    >
      <div className="flex items-start gap-3">
        {canToggle ? (
          <input
            type="checkbox"
            className="mt-0.5 size-4 shrink-0 cursor-pointer accent-primary disabled:cursor-not-allowed"
            checked={item.completed}
            disabled={toggle.isPending}
            aria-label={`Done: ${preview(item.description)}`}
            onChange={(event) => setCompleted(event.target.checked, item.revision)}
            data-testid="meeting-note-item-toggle"
          />
        ) : null}
        <div className="flex min-w-0 flex-1 flex-col gap-1.5">
          <p
            className={cn('whitespace-pre-wrap break-words text-sm', item.completed && 'text-muted-foreground 
line-through')}
            data-testid="meeting-note-item-description"
          >
            {item.description}
          </p>
          <div className="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-muted-foreground">
            <MeetingNoteActionItemAssignee item={item} membersById={membersById} />
            {due ? (
              <span data-testid="meeting-note-item-due">
                Due <time dateTime={due}>{due}</time>
              </span>
            ) : (
              <span data-testid="meeting-note-item-due" data-empty="true">
                No due date
              </span>
            )}
            <Badge
              variant={item.completed ? 'secondary' : 'outline'}
              className="text-[10px]"
              data-testid="meeting-note-item-status"
            >
              {item.completed ? 'Done' : 'Open'}
            </Badge>
          </div>
        </div>
        {canEdit ? (
          <div className="flex shrink-0 items-center gap-1">
            <Button
              type="button"
              variant="ghost"
              size="icon"
              className="size-8 text-muted-foreground"
              aria-label="Edit action item"
              onClick={() => setEditing(true)}
              data-testid="meeting-note-item-edit"
            >
              <Pencil className="size-4" aria-hidden="true" />
            </Button>
            <MeetingNoteActionItemDeleteButton noteId={noteId} item={item} membersById={membersById} />
          </div>
        ) : null}
      </div>

      {conflict ? (
        <MeetingNoteActionItemConflictNotice
          newer={conflict.newer}
          membersById={membersById}
          message={
            conflict.newer.completed === conflict.wanted
              ? `This action item was changed by someone else. It is already ${conflict.wanted ? 'done' : 'open'}.`
              : 'This action item was changed by someone else, so your change was not saved.'
          }
        >
          <Button
            type="button"
            size="sm"
            variant="ghost"
            onClick={() => {
              setConflict(null);
              toggle.reset();
            }}
          >
            Dismiss
          </Button>
          {conflict.newer.completed !== conflict.wanted && canToggle ? (
            <Button
              type="button"
              size="sm"
              disabled={toggle.isPending}
              onClick={() => setCompleted(conflict.wanted, conflict.newer.revision)}
              data-testid="meeting-note-item-conflict-retry"
            >
              {conflict.wanted ? 'Mark as done again' : 'Mark as open again'}
            </Button>
          ) : null}
        </MeetingNoteActionItemConflictNotice>
      ) : toggle.isError ? (
        <p className="text-xs text-destructive" role="alert" data-testid="meeting-note-item-error">
          {describeMeetingNoteItemError(toggle.error)}
        </p>
      ) : null}
    </li>
  );
}

