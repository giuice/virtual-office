// src/app/api/meeting-notes/[id]/ai/process/route.ts
// Start of AI processing (Phase 6 T12; SPEC FR-015â€“FR-017, FR-020â€“FR-022,
// FR-031, BR-013).
//
// POST, body { ticket, idempotencyKey? }. In order:
//   1. origin guard, session (auth.getUser â†’ users.supabase_uid), rate limit
