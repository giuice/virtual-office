  51:       coalesce(p_source, ''),
  52:       pg_catalog.chr(57344) || pg_catalog.chr(57345) || pg_catalog.chr(57346) || pg_catalog.chr(57347),
  53:       ''
  54:     ),
  55:     '<>',
