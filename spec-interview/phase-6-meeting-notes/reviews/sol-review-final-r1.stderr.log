const BLOCK_END = /<\/(?:p|h[1-6]|li)>|<br\s*\/?>/gi;

export function meetingNoteHtmlToText(html: string): string {
  const marked = sanitizeMeetingNoteHtml(html).replace(BLOCK_END, (tag) => `${tag}\n`);
  if (typeof DOMParser === 'undefined') {
    return marked.replace(/<[^>]*>/g, '').trim();
  }
  const doc = new DOMParser().parseFromString(`<!doctype html><body>${marked}</body>`, 'text/html');
  return (doc.body.textContent ?? '').replace(/\n{3,}/g, '\n\n').trim();
}
// src/lib/meeting-notes/html-to-markdown.ts
// Meeting-note rich text â†’ Markdown for the export (FR-027). The stored HTML
// is sanitized again with the note allow-list (content-sanitizer.ts), so the
// converter only meets the SPEC schema: paragraphs, hard breaks, bold, italic,
// headings, bulleted/numbered lists, task lists with their checked state, and
// http/https/mailto links. It walks the tree htmlparser2 builds (the parser
// sanitize-html already uses; pinned as a direct dependency) instead of a
// general HTML-to-Markdown package, because every text node must go through
// the export escaping (markdown-escape.ts) â€” a general converter passes `<`
// and `&` through as raw HTML. Anything outside the schema is reduced to its
// escaped text.
import { ElementType, parseDocument } from 'htmlparser2';

import { sanitizeMeetingNoteHtml } from './content-sanitizer';
import { isSafeMeetingNoteLink } from './link-url';
import {
  escapeAssembledLineStarts,
  escapeAtxHeadingText,
  escapeMarkdownLinkDestination,
  escapeMarkdownText,
} from './markdown-escape';

type DomNode = ReturnType<typeof parseDocument>['children'][number];
type DomElement = Extract<DomNode, { attribs: Record<string, string> }>;
type DomText = Extract<DomNode, { type: typeof ElementType.Text }>;

function isElement(node: DomNode): node is DomElement {
  return 'attribs' in node;
}

function isText(node: DomNode): node is DomText {
  return node.type === ElementType.Text;
}

const HEADING = /^h([1-6])$/;
const INLINE_TAGS = new Set(['strong', 'b', 'em', 'i', 'a', 'span', 'label', 'br', 'input']);
/** Deeper nesting is flattened to text (keeps the walk's recursion bounded). */
const MAX_DEPTH = 24;
const HARD_BREAK = '\\\n';

/** Plain text of a subtree, without recursion. */
function textOf(nodes: readonly DomNode[]): string {
  const parts: string[] = [];
  const stack: DomNode[] = [...nodes].reverse();
  while (stack.length > 0) {
    const node = stack.pop() as DomNode;
    if (isText(node)) {
      parts.push(node.data);
    } else if (isElement(node)) {
      if (node.name === 'br') parts.push(' ');
      for (let index = node.children.length - 1; index >= 0; index -= 1) stack.push(node.children[index]);
      if (!INLINE_TAGS.has(node.name)) parts.push(' ');
    }
  }
  return parts.join('');
}

/** true when nothing but spaces follows the last line break of `out`. */
function atLineStart(out: string): boolean {
  return /(?:^|\n)[ ]*$/.test(out);
}

/** Wraps inline Markdown in a delimiter, keeping outer spaces outside it. */
function wrap(inner: string, delimiter: string): string {
  const match = /^(\s*)([\s\S]*?)(\s*)$/.exec(inner);
  if (!match || match[2] === '') return inner;
  return `${match[1]}${delimiter}${match[2]}${delimiter}${match[3]}`;
}

function renderInline(nodes: readonly DomNode[], depth: number): string {
  if (depth > MAX_DEPTH) return escapeMarkdownText(textOf(nodes).replace(/\s+/g, ' '), true);
  let out = '';
  for (const node of nodes) {
    if (isText(node)) {
      out += escapeMarkdownText(node.data.replace(/\s+/g, ' '), atLineStart(out));
      continue;
    }
    if (!isElement(node)) continue;
    switch (node.name) {
      case 'br':
        out += HARD_BREAK;
        break;
      case 'input':
        break;
      case 'strong':
      case 'b':
        out += wrap(renderInline(node.children, depth + 1), '**');
        break;
      case 'em':
      case 'i':
        out += wrap(renderInline(node.children, depth + 1), '*');
        break;
      case 'a': {
        const text = renderInline(node.children, depth + 1).trim();
        const href = (node.attribs.href ?? '').trim();
        if (!isSafeMeetingNoteLink(href)) {
          out += text;
        } else {
          out += `[${text || escapeMarkdownText(href, false)}](${escapeMarkdownLinkDestination(href)})`;
        }
        break;
      }
      default:
        out += renderInline(node.children, depth + 1);
    }
  }
  return out;
}

/**
 * A paragraph's inline Markdown without leading/trailing spaces or trailing
 * hard breaks, with every line's start checked again: inline runs are escaped
 * fragment by fragment, so a marker split across fragments is caught here.
 */
function finishParagraph(inline: string): string {
  return escapeAssembledLineStarts(inline.replace(/(?:\s|\\\n)+$/, '').replace(/^\s+/, ''));
}

function isTaskItem(node: DomNode): boolean {
  return isElement(node) && (node.attribs['data-type'] === 'taskItem' || node.attribs['data-checked'] !== undefined);
}

/** Every line after the first gets `indent`. */
function indentRest(text: string, indent: string): string {
  return text.replace(/\n/g, `\n${indent}`);
}

function renderList(node: DomNode, depth: number, headingOffset: number): string {
  if (!isElement(node)) return '';
  const ordered = node.name === 'ol';
  const start = Number(node.attribs.start);
  let number = ordered && Number.isSafeInteger(start) && start >= 0 ? start : 1;
  const lines: string[] = [];
  for (const child of node.children) {
    if (isText(child) && child.data.trim() === '') continue;
    const marker = ordered ? `${number}. ` : '- ';
    number += 1;
    const task = isTaskItem(child) && isElement(child) ? (child.attribs['data-checked'] === 'true' ? '[x] ' : '[ ] ') 
: '';
    // A task item's checkbox lives in its <label>; its text in the following block(s).
    const children = isElement(child)
      ? child.children.filter((grandchild) => !(task && isElement(grandchild) && grandchild.name === 'label'))
      : [child];
    const body = renderBlocks(children, depth + 1, headingOffset).join('\n');
    lines.push(`${marker}${task}${indentRest(body, ' '.repeat(marker.length))}`.trimEnd());
  }
  return lines.join('\n');
}

/** Block-level Markdown strings for a list of nodes. */
function renderBlocks(nodes: readonly DomNode[], depth: number, headingOffset: number): string[] {
  if (depth > MAX_DEPTH) {
    const text = finishParagraph(escapeMarkdownText(textOf(nodes).replace(/\s+/g, ' '), true));
    return text ? [text] : [];
  }
  const blocks: string[] = [];
  let pendingInline: DomNode[] = [];
  const flushInline = () => {
    const paragraph = finishParagraph(renderInline(pendingInline, depth));
    if (paragraph) blocks.push(paragraph);
    pendingInline = [];
  };

  for (const node of nodes) {
    if (isText(node) || (isElement(node) && INLINE_TAGS.has(node.name))) {
      pendingInline.push(node);
      continue;
    }
    if (!isElement(node)) continue;
    flushInline();
    const heading = HEADING.exec(node.name);
    if (heading) {
      const text = finishParagraph(renderInline(node.children, depth + 1).split(HARD_BREAK).join(' '));
      if (text) blocks.push(`${'#'.repeat(Math.min(6, Number(heading[1]) + headingOffset))} 
${escapeAtxHeadingText(text)}`);
    } else if (node.name === 'p') {
      const paragraph = finishParagraph(renderInline(node.children, depth + 1));
      if (paragraph) blocks.push(paragraph);
    } else if (node.name === 'ul' || node.name === 'ol') {
      const list = renderList(node, depth + 1, headingOffset);
      if (list) blocks.push(list);
    } else {
      // div, a stray li, or anything outside the schema: its content as blocks.
      blocks.push(...renderBlocks(node.children, depth + 1, headingOffset));
    }
  }
  flushInline();
  return blocks;
}

/**
 * Stored note HTML â†’ Markdown ('' when the note has no text). `headingOffset`
 * demotes the note's headings (h1 + 2 = ###) so they nest under the export's
 * own sections; the deepest level is 6.
 */
export function meetingNoteHtmlToMarkdown(html: string, headingOffset = 0): string {
  const document = parseDocument(sanitizeMeetingNoteHtml(html));
  return renderBlocks(document.children, 0, Math.max(0, headingOffset)).join('\n\n');
}
// src/lib/meeting-notes/markdown-escape.ts
// Escaping of user and AI text written into a Markdown export (FR-027,
// AC-003, SPEC Â§12). Every character that could start raw HTML becomes an
// entity (`<` `>` `&`), so the .md never contains a `<` from user text; the
// inline Markdown syntax characters are backslash-escaped, so text can never
// form a link, image, emphasis, code span, table cell, or strikethrough; and
// the block markers a line may start with (headings, list items, setext
// underlines, ordered-list numbers) are escaped at the start of every line â€”
// also when a line is assembled from several fragments â€” and a trailing `#`
// run of a heading is escaped so it is not taken as a closing sequence.
// Escaping more than strictly needed is always safe; escaping less is not.

const ENTITIES: Readonly<Record<string, string>> = { '<': '&lt;', '>': '&gt;', '&': '&amp;' };

/** Characters escaped wherever they appear. */
const ALWAYS_ESCAPED = /[\\`*_[\]~|<>&]/g;

/** Block markers that only matter at the start of a line (after optional spaces). */
const LINE_START_MARKER = /^(\s*)([#+\-=])/;
const LINE_START_ORDERED = /^(\s*\d+)([.)])/;

function escapeAlways(text: string): string {
  return text.replace(ALWAYS_ESCAPED, (char) => ENTITIES[char] ?? `\\${char}`);
}

function escapeLineStart(line: string): string {
  return line.replace(LINE_START_MARKER, '$1\\$2').replace(LINE_START_ORDERED, '$1\\$2');
}

/**
 * Re-checks the start of every line of already-escaped inline Markdown: a
 * block marker can be assembled from several text fragments (`<span>1</span>`
 * then `. text` forms `1. text`), which fragment-local escaping cannot see.
 * Idempotent: an escaped marker starts with `\` and is left alone. The
 * exporter's own inline syntax never starts a line with `#`, `+`, `-`, `=`, or
 * a digit, so only user text is affected.
 */
export function escapeAssembledLineStarts(markdown: string): string {
  return markdown
    .split('\n')
    .map((line) => escapeLineStart(line))
    .join('\n');
}

/**
 * Text that follows an ATX heading marker (`# `): a trailing run of `#`
 * preceded by a space would be read as the optional closing sequence and
 * dropped (`# Topic #` shows "Topic"), so its first `#` is escaped.
 */
export function escapeAtxHeadingText(text: string): string {
  return text.replace(/(^|[ \t])(#+)([ \t]*)$/, '$1\\$2$3');
}

/**
 * Escapes a run of text that sits inside a line. `atLineStart` says whether
 * the run may begin a line (it then also escapes the block markers).
 */
export function escapeMarkdownText(text: string, atLineStart: boolean): string {
  const escaped = escapeAlways(text);
  return atLineStart ? escapeLineStart(escaped) : escaped;
}

/** One-line plain text (a title or a name): whitespace runs collapse to one space. */
export function escapeMarkdownLine(text: string): string {
  return escapeMarkdownText(text.replace(/\s+/g, ' ').trim(), true);
}

/**
 * Multi-line plain text (a summary, an item description, a transcript): blank
 * lines separate paragraphs, other line breaks are kept as hard breaks, and
 * every line is escaped as a possible line start. Lines after the first get
 * `indent` (to continue a list item).
 */
export function escapeMarkdownBlock(text: string, indent = ''): string {
  const paragraphs: string[][] = [[]];
  for (const raw of text.replace(/\r\n?/g, '\n').split('\n')) {
    const line = raw.replace(/[\t\f\v]/g, ' ').trim();
    if (line === '') {
      if (paragraphs[paragraphs.length - 1].length > 0) paragraphs.push([]);
      continue;
    }
    paragraphs[paragraphs.length - 1].push(escapeLineStart(escapeAlways(line)));
  }
  return paragraphs
    .filter((lines) => lines.length > 0)
    .map((lines) => lines.join(`\\\n${indent}`))
    .join(`\n\n${indent}`);
}

/** Characters percent-encoded in a link destination (`&` is backslash-escaped instead). */
const UNSAFE_IN_DESTINATION = /[\s<>()\\`"'[\]{}|^\u0000-\u001f\u007f]/g;

/**
 * A safe href (already restricted to http, https, or mailto) as a Markdown
 * link destination: characters that could end or reshape the destination are
 * percent-encoded, and `&` is escaped so no entity is decoded inside it.
 */
export function escapeMarkdownLinkDestination(href: string): string {
  return href
    .replace(UNSAFE_IN_DESTINATION, (char) =>
      Array.from(new TextEncoder().encode(char), (byte) => `%${byte.toString(16).toUpperCase().padStart(2, 
'0')}`).join('')
    )
    .replace(/&/g, '\\&');
}
// src/lib/meeting-notes/markdown-export.ts
// The Markdown export of a note (FR-027, AC-019, AC-003): title, meeting date,
// space (or "Space removed"), author, participants (former members marked),
// the content converted to Markdown, the summary, the action items (assignee,
// due date, status), and â€” only when asked â€” the stored transcript. Every
// piece of user or AI text goes through markdown-escape.ts, so the file holds
// no raw HTML and no Markdown structure that came from that text.
import type { MeetingNoteActionItemView, MeetingNoteDetail } from '@/types/meeting-notes';

import { meetingNoteHtmlToMarkdown } from './html-to-markdown';
import { escapeAtxHeadingText, escapeMarkdownBlock, escapeMarkdownLine } from './markdown-escape';

export interface MeetingNoteMarkdownOptions {
  /** Include `note.transcript` (the caller loaded it). */
  includeTranscript: boolean;
  /** IANA time zone the meeting date is written in (the viewer's). */
  timeZone: string;
}

const DATE_ONLY = /^\d{4}-\d{2}-\d{2}$/;

/** The calendar day 'YYYY-MM-DD' of an instant in `timeZone`; null when unparsable. */
export function calendarDayInZone(value: string, timeZone: string): string | null {
  const instant = new Date(value);
  if (Number.isNaN(instant.getTime())) return null;
  const parts = new Intl.DateTimeFormat('en-US', {
    timeZone,
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
  }).formatToParts(instant);
  const part = (type: Intl.DateTimeFormatPartTypes) => parts.find((entry) => entry.type === type)?.value ?? '';
  const day = `${part('year')}-${part('month')}-${part('day')}`;
  return DATE_ONLY.test(day) ? day : null;
}

function personLabel(name: string, isCurrentMember: boolean): string {
  const escaped = escapeMarkdownLine(name);
  return isCurrentMember ? escaped : `${escaped} (Former member)`;
}

function itemLines(item: MeetingNoteActionItemView): string {
  const assignee =
    item.assigneeId === null
      ? 'Unassigned'
      : personLabel(item.assigneeName ?? 'Unknown member', item.assigneeIsCurrentMember === true);
  // A date-only value is written as stored: no Date conversion, no time zone.
  const due = item.dueDate && DATE_ONLY.test(item.dueDate) ? item.dueDate : 'None';
  return [
    `- [${item.completed ? 'x' : ' '}] ${escapeMarkdownBlock(item.description, '  ')}`,
    `  - Assignee: ${assignee}`,
    `  - Due date: ${due}`,
    `  - Status: ${item.completed ? 'done' : 'open'}`,
  ].join('\n');
}

/** The whole .md document of a note. */
export function buildMeetingNoteMarkdown(note: MeetingNoteDetail, options: MeetingNoteMarkdownOptions): string {
  const meetingDay = calendarDayInZone(note.meetingDate, options.timeZone) ?? escapeMarkdownLine(note.meetingDate);
  const space = note.spaceName === null ? 'Space removed' : escapeMarkdownLine(note.spaceName);
  const participants =
    note.participants.length === 0
      ? 'None'
      : note.participants.map((participant) => personLabel(participant.displayName, 
participant.isCurrentMember)).join(', ');

  const sections: string[] = [
    `# ${escapeAtxHeadingText(escapeMarkdownLine(note.title))}`,
    [
      `- **Meeting date:** ${meetingDay}`,
      `- **Space:** ${space}`,
      `- **Author:** ${escapeMarkdownLine(note.authorName)}`,
      `- **Participants:** ${participants}`,
    ].join('\n'),
    '## Notes',
    // The note's own headings nest under "## Notes" (h1 becomes ###).
    meetingNoteHtmlToMarkdown(note.content, 2) || 'No notes.',
    '## Summary',
    (note.summary ? escapeMarkdownBlock(note.summary) : '') || 'No summary.',
    '## Action items',
    note.actionItems.length === 0 ? 'No action items.' : note.actionItems.map(itemLines).join('\n'),
  ];

  if (options.includeTranscript) {
    sections.push('## Transcript', (note.transcript ? escapeMarkdownBlock(note.transcript) : '') || 'No transcript.');
  }

  return `${sections.join('\n\n')}\n`;
}

const RFC5987_UNSAFE = /['()*!]/g;

/**
 * Download names for a note's export: an ASCII slug for `filename` and the
 * readable UTF-8 title for `filename*`; both end with the meeting day.
 */
export function meetingNoteExportFilenames(title: string, day: string | null): { ascii: string; utf8: string } {
  const suffix = day && DATE_ONLY.test(day) ? `-${day}` : '';
  const slug =
    title
      .normalize('NFKD')
      .replace(/[Ì€-Í¯]/g, '')
      .toLowerCase()
      .replace(/[^a-z0-9]+/g, '-')
      .replace(/^-+|-+$/g, '')
      .slice(0, 80)
      .replace(/-+$/, '') || 'meeting-note';
  const readable =
    Array.from(
      title
        .toWellFormed()
        .replace(/[\u0000-\u001f\u007f-\u009f"\\/:*?<>|]/g, ' ')
        .replace(/\s+/g, ' ')
        .trim()
    )
      .slice(0, 120)
      .join('')
      .trim()
      .replace(/^\.+/, '') || 'Meeting note';
  return { ascii: `${slug}${suffix}.md`, utf8: `${readable}${day && DATE_ONLY.test(day) ? ` ${day}` : ''}.md` };
}

/** `Content-Disposition` for the export download. */
export function meetingNoteExportContentDisposition(names: { ascii: string; utf8: string }): string {
  const encoded = encodeURIComponent(names.utf8).replace(
    RFC5987_UNSAFE,
    (char) => `%${char.charCodeAt(0).toString(16).toUpperCase()}`
  );
  return `attachment; filename="${names.ascii}"; filename*=UTF-8''${encoded}`;
}

