export function MeetingNoteAiPanel({ note, flow }: MeetingNoteAiPanelProps) {
  const settings = useMeetingNoteAiSettings();
  const { companyUsers } = useCompany();
  const { state } = flow;
  const providers = settings.data?.providers ?? [];

  if (!note.rights.canEdit) return null;

  // FR-025: unconfigured (as last read, or as a route just answered).
  // A route's answer counts until the refreshed settings say AI is configured again.
  const notConfiguredByRoute =
    state.phase === 'error' && state.error.kind === 'not_configured' && settings.data?.settings.configured !== true
      ? state.error
      : null;
  // A draft under review stays reviewable: Apply needs no provider.
  if ((state.phase === 'idle' && settings.data?.settings.configured === false) || notConfiguredByRoute) {
    return (
      <NotConfigured canConfigure={settings.data?.canManage === true || notConfiguredByRoute?.canConfigure === true} />
    );
  }

  if (state.phase === 'preparing') return <MeetingNoteAiNoticeLoading />;

  if (state.phase === 'notice') {
    const labels = labelsFor(state.ticket, providers);
    return (
      <MeetingNoteAiNotice
        ticket={state.ticket}
        providerLabel={labels.providerLabel}
        modelLabel={labels.modelLabel}
        banner={state.banner}
        onProcess={flow.confirm}
        onCancel={flow.close}
      />
    );
  }

  if (state.phase === 'processing') {
    return <Processing providerLabel={labelsFor(state.ticket, providers).providerLabel} onCancel={flow.cancel} />;
  }

  if (state.phase === 'error') {
    return (
      <FlowError
        message={describeMeetingNoteAiFlowError(state.error)}
        canRetry={state.error.kind !== 'limit_reached' && state.error.kind !== 'access_lost' && note.hasTranscript}
        onRetry={flow.start}
        onClose={flow.close}
      />
    );
  }

  if (state.phase === 'review') {
    return (
      <MeetingNoteAiReview
        draft={state.draft}
        noteRevision={note.revision}
        existingItemCount={note.actionItems.length}
        members={companyUsers}
        applying={state.applying}
        applyError={state.applyError}
        conflict={state.conflict}
        onChange={flow.updateDraft}
        onApply={flow.apply}
        onDiscard={flow.discard}
        onReprocess={flow.start}
      />
    );
  }

  // Idle.
  const hasSummary = note.summary !== null && note.summary.trim() !== '';
  return (
    <div className="flex flex-col gap-2" data-testid="meeting-note-ai-idle">
      <div>
        <Button
          type="button"
          size="sm"
          className="gap-1.5"
          disabled={!note.hasTranscript || settings.isPending}
          onClick={flow.start}
          data-testid="meeting-note-ai-start"
        >
          <Sparkles className="size-4" aria-hidden="true" />
          {hasSummary ? 'Reprocess transcript' : 'Generate summary'}
        </Button>
      </div>
      {!note.hasTranscript ? (
        <p className="text-sm text-muted-foreground">Attach a transcript to generate a summary and action items.</p>
// src/lib/meeting-notes/ai/draft-review.ts
// Turns a provider draft into the reviewable draft of the start route and an
// edited summary into the stored text of Apply (Phase 6 T12; SPEC FR-016,
// FR-017, FR-018, BR-006). Pure functions: no I/O, nothing logged.
//
// Name resolution (FR-017) is LOCAL: the provider never receives the member
// roster (FR-016); it returns names as written in the transcript, and they are
// matched here against the company's CURRENT members only:
//   1. exact full display name (case- and accent-insensitive, trimmed, inner
//      whitespace collapsed) â€” exactly one member â†’ that member; two or more
//      members with that same name â†’ unassigned;
//   2. otherwise the whole suggested name equal to the FIRST name (first
//      token of the display name) of exactly one current member â†’ that member;
//   3. otherwise (several first-name matches, none, a former member) â†’
//      unassigned.
// "Already exists" (FR-018): a suggestion whose normalized description equals
// an existing item's is marked with that item's id (the UI shows it
// unchecked). Same key as SQL private.meeting_note_ai_normalize_description
// (trim, collapse whitespace, strip accents, lower case); characters that
// unaccent and Unicode decomposition treat differently (e.g. ÃŸ, Ã¦) can differ
// between the two, which only affects the informational mark.
import 'server-only';

import type {
  MeetingNoteAiDraft,
  MeetingNoteAiDraftSummary,
  MeetingNoteAiReviewDraft,
} from '@/types/meeting-notes';

export interface MeetingNoteAiMember {
  userId: string;
  displayName: string;
}

/** Comparison key: NFD, combining marks removed, lower case, trimmed, single spaces. */
export function meetingNoteAiComparisonKey(value: string): string {
  return value
    .normalize('NFD')
    .replace(/\p{M}+/gu, '')
    .toLowerCase()
    .trim()
    .replace(/\s+/gu, ' ');
}

function firstName(key: string): string {
  const space = key.indexOf(' ');
  return space === -1 ? key : key.slice(0, space);
}

/** The single current member a suggested name designates, else null (FR-017). */
export function resolveMeetingNoteAiAssignee(
  suggestedName: string | null,
  members: readonly MeetingNoteAiMember[]
): MeetingNoteAiMember | null {
  if (suggestedName === null) return null;
  const wanted = meetingNoteAiComparisonKey(suggestedName);
  if (wanted === '') return null;

  const keyed = members
    .map((member) => ({ member, key: meetingNoteAiComparisonKey(member.displayName) }))
    .filter((entry) => entry.key !== '');

  const exact = keyed.filter((entry) => entry.key === wanted);
  if (exact.length === 1) return exact[0].member;
  if (exact.length > 1) return null;

  const byFirstName = keyed.filter((entry) => firstName(entry.key) === wanted);
  return byFirstName.length === 1 ? byFirstName[0].member : null;
}

/** The reviewable draft: assignees resolved locally, duplicates of existing items marked. */
export function buildMeetingNoteAiReviewDraft(
  draft: MeetingNoteAiDraft,
  members: readonly MeetingNoteAiMember[],
  existingItems: ReadonlyArray<{ id: string; description: string }>
): MeetingNoteAiReviewDraft {
  const existing = new Map<string, string>();
  for (const item of existingItems) {
    const key = meetingNoteAiComparisonKey(item.description);
    if (!existing.has(key)) existing.set(key, item.id);
  }
  return {
    summary: {
      keyPoints: [...draft.summary.keyPoints],
      decisions: [...draft.summary.decisions],
      nextSteps: [...draft.summary.nextSteps],
    },
    items: draft.actionItems.map((item) => {
      const resolved = resolveMeetingNoteAiAssignee(item.assigneeName, members);
      return {
        description: item.description,
        suggestedAssigneeName: item.assigneeName,
        resolvedAssignee: resolved ? { userId: resolved.userId, displayName: resolved.displayName } : null,
        duplicateOfItemId: existing.get(meetingNoteAiComparisonKey(item.description)) ?? null,
      };
    }),
  };
}

const SECTION_TITLES: ReadonlyArray<[keyof MeetingNoteAiDraftSummary, string]> = [
  ['keyPoints', 'Key points'],
  ['decisions', 'Decisions'],
  ['nextSteps', 'Next steps'],
];

/**
 * Stored summary format (plain text; the note view renders it as text with
 * pre-wrapped lines, the export escapes it). Each non-empty section is a
 * heading line followed by one "- " line per entry; sections are separated by
 * a blank line; line breaks inside an entry become spaces. All sections empty
 * â†’ null (Apply then keeps the note's current summary). Example:
 *   Key points
 *   - Launch stays on Friday.
 *
 *   Next steps
 *   - Bruno updates the changelog.
 */
export function formatMeetingNoteAiSummary(summary: MeetingNoteAiDraftSummary): string | null {
  const blocks: string[] = [];
  for (const [key, title] of SECTION_TITLES) {
    const entries = summary[key].map((entry) => entry.replace(/\s+/gu, ' ').trim()).filter((entry) => entry !== '');
    if (entries.length > 0) blocks.push([title, ...entries.map((entry) => `- ${entry}`)].join('\n'));
  }
  return blocks.length > 0 ? blocks.join('\n\n') : null;
}
// src/lib/meeting-notes/ai/capabilities.ts
// Curated AI capability matrix for meeting-note processing (Phase 6 T8;
// SPEC FR-016, FR-020, FR-022, FR-024). DATA ONLY: no provider call, no SDK.
// T11's adapters consume it; the settings route validates admin choices
// against it; the model/reasoning lists (never keys) are exposed to the admin
// form through GET /api/companies/ai-settings.
//
// Sources (official documentation, read 2026-10-13):
//   Anthropic models   https://platform.claude.com/docs/en/about-claude/models/overview.md
//   Anthropic effort   https://platform.claude.com/docs/en/build-with-claude/effort.md
//   Anthropic errors   https://platform.claude.com/docs/en/api/errors.md
//   Anthropic stream   https://platform.claude.com/docs/en/build-with-claude/streaming.md
//   OpenAI models      https://developers.openai.com/api/docs/models (+ /models/<id>)
//   OpenAI reasoning   https://developers.openai.com/api/docs/guides/reasoning
//   OpenAI chat        
https://developers.openai.com/api/reference/python/resources/chat/subresources/completions/methods/create
//   OpenAI errors      https://developers.openai.com/api/docs/guides/error-codes
//   Kimi API overview  https://platform.kimi.ai/docs/api/overview.md
//   Kimi models        https://platform.kimi.ai/docs/models , https://platform.kimi.ai/docs/api/models-overview
//   Kimi chat          https://platform.kimi.ai/docs/api/chat
//   Kimi errors        https://platform.kimi.ai/docs/api/errors.md
//   GLM quick start    https://docs.z.ai/guides/overview/quick-start.md
//   GLM models         https://docs.z.ai/guides/overview/overview.md
//   GLM chat           https://docs.z.ai/api-reference/llm/chat-completion.md
//   GLM errors         https://docs.z.ai/api-reference/api-code.md
//
// Pre-processing rejections (FR-022): a dispatch is refunded only when the
// provider's INITIAL HTTP response is a non-2xx rejection with the provider's
// normal error body whose status AND documented type/code are listed below for
// that provider, in one of the SPEC's categories (authentication/permission,
// rate limit, overload, unavailable). None of the providers documents billing
// for error responses; the list holds only the documented status + type/code
// combinations of those categories. Every entry names an exact `error.type`,
// an exact `error.code`, or both; there is no wildcard. A status the
// documentation lists WITHOUT a type or code (e.g. OpenAI's 401/403 and its
// plain "Rate limit reached" 429) cannot be told apart from an unknown error
// and stays counted. Everything else stays counted too: other statuses (400,
// 402, 404, 413, 500, 504, ...), unlisted types/codes, a body that is not the
// provider's normal error envelope, errors inside an accepted (2xx/streaming)
// response (e.g. Anthropic's mid-stream `overloaded_error` event), and
// connection loss. classifyMeetingNoteAiPreProcessingRejection applies this.
import 'server-only';

import type {
  MeetingNoteAiModelOption,
  MeetingNoteAiProvider,
  MeetingNoteAiProviderOption,
} from '@/types/meeting-notes';

/** Wire protocol an adapter speaks (Kimi and GLM are OpenAI-compatible). */
export type MeetingNoteAiWireProtocol = 'anthropic-messages' | 'openai-chat-completions';

export type MeetingNoteAiRejectionCategory = 'authentication' | 'permission' | 'rate_limit' | 'overloaded' | 
'unavailable';

/**
 * What the provider's error body must carry, exactly as documented:
 * `type`: `error.type` equals; `code`: `error.code` equals, whatever the type
 * (used where the documentation names only the code, e.g. OpenAI billing
 * errors whose type may vary, and GLM business codes); `type+code`: both equal.
 */
export type MeetingNoteAiRejectionMatch =
  | { by: 'type'; errorType: string }
  | { by: 'code'; errorCode: string }
  | { by: 'type+code'; errorType: string; errorCode: string };

export interface MeetingNoteAiRejection {
  /** Initial HTTP status of the provider response. */
  status: number;
  match: MeetingNoteAiRejectionMatch;
  category: MeetingNoteAiRejectionCategory;
  docUrl: string;
}

function byType(
  status: number,
  errorType: string,
  category: MeetingNoteAiRejectionCategory,
  docUrl: string
): MeetingNoteAiRejection {
  return { status, match: { by: 'type', errorType }, category, docUrl };
}

function byCode(
  status: number,
  errorCode: string,
  category: MeetingNoteAiRejectionCategory,
  docUrl: string
): MeetingNoteAiRejection {
  return { status, match: { by: 'code', errorCode }, category, docUrl };
}

export interface MeetingNoteAiReasoningLevel {
  /** Stored settings value (database: ^[a-z][a-z_]{0,31}$). */
  id: string;
  label: string;
  /**
   * Exact JSON fragment merged into the request body for this level; the
   * adapter sends nothing else reasoning-related.
   */
  wire: Readonly<Record<string, unknown>>;
}

export interface MeetingNoteAiModelCapability {
  id: string;
  label: string;
  /** Tokens the model accepts as input (context window, or the documented input cap). */
  contextWindowTokens: number;
  /** Largest output budget the adapter may request. */
  maxOutputTokens: number;
  reasoningLevels: readonly MeetingNoteAiReasoningLevel[];
  defaultReasoningLevel: string;
  docUrl: string;
}

export interface MeetingNoteAiProviderCapability {
  id: MeetingNoteAiProvider;
  label: string;
  protocol: MeetingNoteAiWireProtocol;
  /** API base URL (international endpoint for Kimi and GLM). */
  baseUrl: string;
  /** Request-body field that carries the output budget. */
  outputBudgetParam: 'max_tokens' | 'max_completion_tokens';
  /** Structured output the provider documents (T11 chooses the request shape). */
  jsonOutput: 'json_schema' | 'json_object';
  models: readonly MeetingNoteAiModelCapability[];
  preProcessingRejections: readonly MeetingNoteAiRejection[];
}

// ---------------------------------------------------------------------------
// Anthropic â€” Messages API. Adaptive thinking is the default on these models
// (sending {type:"disabled"} or budget_tokens is a 400 on Opus 5.5), so the
// adapter omits `thinking` and sets only `output_config.effort`.
// ---------------------------------------------------------------------------

