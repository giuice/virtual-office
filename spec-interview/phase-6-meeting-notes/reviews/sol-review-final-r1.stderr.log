begin;

set local lock_timeout = '5s';

-- Same order as T1: referenced tables first, then the note tables.
lock table public.users in share row exclusive mode;
lock table public.meeting_notes, public.meeting_note_action_items in access exclusive mode;

-- ---------------------------------------------------------------------------
-- Columns and constraints
-- ---------------------------------------------------------------------------

alter table public.meeting_note_action_items
  add column creator_user_id uuid,
  add column creator_name text,
  add column assignee_name text,
  add column revision bigint not null default 1,
-- Phase 6 block A review fixes (spec-interview/phase-6-meeting-notes;
-- reviews/sol-review-blockA-r1.md findings A-1, A-2, A-3, A-4). Forward
-- migration on top of T1 20261013103447, T17 20261013105021, T2
-- 20261013110632, and T4 20261013114402; it redefines the affected objects
-- only.
--
-- Before this migration:
--   * public.create_meeting_note locked the caller's users row, then the space
--     FOR KEY SHARE, and only then (through the meeting_notes.company_id FK
--     check of its INSERT) the company row FOR KEY SHARE. The member-removal,
--     role-change, and invitation-acceptance RPCs lock users -> company FOR
--     UPDATE -> the target's occupied space FOR UPDATE, so a creation in a
--     space occupied by someone an admin was removing could deadlock (40P01).
--   * Titles: private.meeting_note_validate_fields and the
--     meeting_notes/meeting_note_versions title CHECKs used btrim(title),
--     which strips spaces only: a title of tabs/line breaks passed a direct
--     authenticated RPC call.
--   * Search documents concatenated the Portuguese and English tsvectors
--     (positions of the second shifted after the first), and queries OR-ed a
--     Portuguese and an English websearch tsquery. A phrase could match across
--     the two copies ('"review budget"' matched "Budget review"), and an
--     exclusion applied in one language only ('budget -meeting' matched
--     "budget meetings" through the Portuguese reading, where "meetings" does
--     not stem to "meeting").
--   * Excerpts always used the Portuguese configuration in ts_headline; a
--     match found only through English stemming ("meeting" ~ "meetings")
--     returned the document's opening words without a highlight.
--
-- After this migration:
--   * create_meeting_note lock order: caller users FOR KEY SHARE -> company
--     row FOR KEY SHARE -> space FOR KEY SHARE -> note insert (whose company
--     FK check then finds the lock already held). Company before space is the
--     order of every product RPC that locks both (users -> company -> space),
--     so no cycle remains. Other meeting-note functions were rechecked: the
--     update/restore/delete and item RPCs lock users -> note FOR UPDATE ->
--     items and never lock a company or space (their FK checks only touch the
--     caller's users row and the note, already locked); the capacity trigger
--     locks the note only; search takes no row locks. Unchanged.
--   * Blank title = empty after removing spaces, tabs, carriage returns, and
--     line feeds (btrim(title, E' \t\r\n'), the predicate T2 uses for item
--     descriptions) in private.meeting_note_validate_fields and in both
--     title CHECKs (meeting_notes: NOT VALID, as before; versions: validated).
--   * Search documents keep original token positions: a new pure helper
--     private.meeting_note_search_tsvector(texts text[], weights text[])
--     parses each text with both configurations and merges the two lexeme
--     sets AT THE SAME POSITIONS (both use the default parser, so position N
--     is the same word in both); consecutive texts are separated by a gap of
--     128 positions, so a phrase never spans two fields. The note document
--     is title (A), summary (B), content text (C); an item document is its
--     description (D). The note's generated search_vector is re-created
--     (same name, type, and GIN index) and the item expression index is
--     rebuilt, so every stored entry uses the new layout.
--   * Queries: private.meeting_note_search_query parses the text with each
--     configuration's websearch_to_tsquery (each keeps its own phrase
--     distances and stop words) and replaces every lexeme with the
--     alternation of all variants of the words that produced it (the
--     Portuguese and English lexemes at the same query positions), then ORs
--     the two readings (one copy when both are equal). A word, phrase word, or -exclusion therefore matches
--     any language variant at one position: '"review budget"' needs "review"
--     immediately followed by "budget"; 'budget -meeting' rejects a document
--     with "meetings" because the exclusion includes the English variant.
--     Known limit: a word that is a stop word in only one language is
--     dropped from that language's reading (as before).
--   * Excerpts: private.meeting_note_search_headline(source, query) (it
--     owns the T4 headline options: U+E000/U+E001 markers, <= 2 fragments of
--     <= 30 words joined by " â€¦ ") returns the Portuguese ts_headline when it highlights a match,
--     otherwise the English one, otherwise (words matched under different
--     languages) a headline of any positive query word in Portuguese, then
--     English; only when none highlights does it return the Portuguese
--     headline without a highlight. Private-use markers are removed from the
--     source first (unchanged contract: U+E000/U+E001 delimit highlights).
--   * public.search_meeting_notes: same signature, result, filters, order,
--     and privileges; excerpts come from the helper above, and each matching
--     item's rank is computed once.
--   * Privileges (function privilege rule): every redefined or new function
--     is owned by postgres with search_path ''. EXECUTE is revoked from
--     PUBLIC, anon, authenticated, and service_role, then granted:
--     private.meeting_note_search_tsvector -> service_role (Postgres checks
--     EXECUTE for the writing role on generated-column and index-expression
--     functions, like the other T4 document helpers);
--     private.meeting_note_search_headline -> nobody (only the definer RPC
--     calls it); create_meeting_note and search_meeting_notes -> authenticated
--     (unchanged). CREATE OR REPLACE keeps the existing ACLs of
--     validate_fields, the document helpers, and the query helper; they are
--     re-stated below.
--   * No revision bump or version comes from search upkeep: search_vector is
--     still a generated column (recomputed in the row's own write) and items
--     still never write the note. The T1/T2 guards are untouched.
--
-- Rollback (order: FIRST roll the application back to a build that does not
-- call /api/meeting-notes/search, THEN run this SQL; no note or item data is
-- lost):
--   begin;
--   set local lock_timeout = '5s';
--   lock table public.meeting_notes, public.meeting_note_versions, public.meeting_note_action_items in access 
exclusive mode;
--   drop index if exists public.idx_meeting_note_action_items_search;
--   alter table public.meeting_notes drop column if exists search_vector;
--   -- Re-run, verbatim from 20261013114402_meeting_notes_search.sql: the
--   -- "create or replace function" statements of
--   -- private.meeting_note_search_document, private.meeting_note_item_search_document,
--   -- private.meeting_note_search_query, and public.search_meeting_notes;
--   -- then its "alter table public.meeting_notes add column search_vector ...",
--   -- its comment on that column, and both "create index" statements.
--   drop function if exists private.meeting_note_search_headline(text, tsquery);
--   drop function if exists private.meeting_note_search_tsvector(text[], text[]);
--   -- Re-run, verbatim from 20261013105021_meeting_notes_mutation_rpcs.sql:
--   -- the two "alter table ... title_length_check" statements and the
--   -- "create or replace function" statements of
--   -- private.meeting_note_validate_fields and public.create_meeting_note.
--   commit;

begin;

set local lock_timeout = '5s';

lock table public.meeting_notes, public.meeting_note_versions, public.meeting_note_action_items
  in access exclusive mode;

-- ---------------------------------------------------------------------------
-- A-4: blank titles (spaces, tabs, line breaks) for every role
-- ---------------------------------------------------------------------------

alter table public.meeting_notes
  drop constraint if exists meeting_notes_title_length_check,
-- Phase 6 T17 (spec-interview/phase-6-meeting-notes; FR-001, FR-006..FR-010,
-- FR-030, BR-002, BR-003, BR-004, BR-011; AC-002, AC-004..AC-007, AC-021):
-- the only client write path for meeting notes, their participants, and their
-- versions.
--
-- Before this migration (T1, 20261013103447): authenticated holds SELECT only
-- on the note tables; nothing lets a client create, change, restore, or delete
-- a note.
--
-- After this migration, four RPCs, each SECURITY DEFINER, owner postgres,
-- search_path '', EXECUTE granted to authenticated only (REVOKE ALL from
-- PUBLIC, anon, authenticated, service_role first):
--   * public.create_meeting_note(p_room_id uuid, p_title text,
--       p_meeting_date timestamptz, p_content text, p_participant_ids uuid[])
--       -> jsonb {note_id, revision: 1, version_id}
--     Any member of the space's company (private spaces included). The note's
--     company is the space's company; author id/name snapshots, created_by,
--     and edited_by come from the caller's users row. Participants must be
--     current members of that company. Creates version 1.
--   * public.update_meeting_note(p_note_id uuid, p_expected_revision bigint,
--       p_title text, p_meeting_date timestamptz, p_content text,
--       p_participant_ids uuid[]) -> jsonb {note_id, revision, version_id}
--     Full desired state of title, meeting date, content, and the ordered
--     participant list (summary, transcript, space, and items are unchanged).
--     A listed person must be a current company member or already a
--     participant of the note (a former member may be retained, never added).
--   * public.restore_meeting_note_version(p_note_id uuid,
--       p_expected_revision bigint, p_version_id uuid)
--       -> jsonb {note_id, revision, version_id}
--     Applies the version's title, meeting date, participants (with their
--     snapshot names), content, and summary; action items and the transcript
--     are untouched.
--   * public.delete_meeting_note(p_note_id uuid, p_expected_revision bigint)
--       -> jsonb {note_id, deleted: true}
--     Deletes the note; versions, participants, and action items go by the
--     ON DELETE CASCADE of their note_id FKs; the transcript is a note column.
--
-- Caller: users.supabase_uid = auth.uid()::text -> users.id. Membership:
-- users.company_id = note.company_id. Rights (BR-003) are evaluated on the
-- locked pre-change state: edit/restore = author (author_user_id) or current
-- participant or company admin (users.role = 'admin'), each while a member;
-- delete = author or company admin, while a member. Every update, restore,
-- and delete requires p_expected_revision = the note's current revision and
-- bumps it by one (except delete); create/update/restore insert exactly one
-- version for the new revision, in the same transaction.
--
-- Lock order (PLAN lock order rule): the caller's users row FOR KEY SHARE
-- (the lock a version/note FK check takes anyway), then (create) the space row
-- FOR KEY SHARE or (update/restore/delete) the note row FOR UPDATE, then
-- participants and versions. The users lock comes first so the product
-- member-removal and role-change RPCs, which lock users FOR UPDATE before
-- companies and spaces, can never interleave into a cycle, and it makes those
-- RPCs wait for the note change (or the note change wait for them), so the
-- rights read under the lock hold for the whole call against them. KEY SHARE,
-- not SHARE, on purpose: it does not conflict with the NO KEY UPDATE of
-- presence writes to the caller's row (last_active, current_space_id), which
-- may hold space locks; a SHARE lock here could close a cycle with them. A raw
-- UPDATE of users.company_id/role (not a product path; service-role
-- membership updates are rejected by presence_block_service_role_membership_update)
-- is not blocked by it. A caller outside the note's company is rejected
-- before any note lock.
--
-- Accepted races (no rights are gained): a person newly listed as a
-- participant whose removal from the company commits during the call ends up
-- listed as a former member, the same state as a removal one moment later.
-- Restore reproduces the version's participants exactly (FR-009, AC-006),
-- including people who have since left the company; they stay former members
-- with no access, because every right requires current membership.
--
-- Errors (message token, SQLSTATE):
--   MEETING_NOTE_NOT_FOUND (P0002): no such note, or the caller is not a
--     current member of its company (other companies' notes are
--     indistinguishable from missing ones; cross-company admins included).
--   MEETING_NOTE_FORBIDDEN (42501): the caller is a member but lacks the edit
--     (update/restore) or delete right, or (create) has no users row/company.
--   MEETING_NOTE_STALE_REVISION (P0001): p_expected_revision differs from the
--     current revision; DETAIL is {"current_revision": N}. Nothing changes.
--   MEETING_NOTE_SPACE_NOT_FOUND (P0002): create with a space that does not
--     exist or is not in the caller's company.
--   MEETING_NOTE_VERSION_NOT_FOUND (P0002): restore of a version that is not
--     a version of that note.
--   22023 limit/shape violations: MEETING_NOTE_TITLE_INVALID (blank or > 200
--     chars), MEETING_NOTE_DATE_REQUIRED, MEETING_NOTE_CONTENT_TOO_LONG
--     (> 100,000 chars), MEETING_NOTE_CONTENT_REQUIRED (NULL; '' is an
--     empty note), MEETING_NOTE_TOO_MANY_PARTICIPANTS (> 50),
--     MEETING_NOTE_PARTICIPANTS_INVALID (NULL list, NULL or duplicate entries),
--     MEETING_NOTE_PARTICIPANT_NOT_MEMBER (a newly listed person who is not a
--     current member of the note's company), MEETING_NOTE_REVISION_REQUIRED.
--   Any error rolls the whole call back: nothing is stored.
--
-- Defense in depth for every role (service_role and postgres included):
-- meeting_notes.title and meeting_note_versions.title must be 1-200 chars and
-- not blank. The meeting_notes check is NOT VALID so a legacy row (SPEC Â§9)
-- does not block the migration; it applies to every new or changed row.
--
-- Rollback (order: FIRST roll the application back to a build that does not
-- call these RPCs, THEN run this SQL; no data is lost â€” notes, participants,
-- and versions written through the RPCs stay):
--   begin;
--   drop function if exists public.create_meeting_note(uuid, text, timestamptz, text, uuid[]);
--   drop function if exists public.update_meeting_note(uuid, bigint, text, timestamptz, text, uuid[]);
--   drop function if exists public.restore_meeting_note_version(uuid, bigint, uuid);
--   drop function if exists public.delete_meeting_note(uuid, bigint);
--   drop function if exists private.meeting_note_lock_caller();
--   drop function if exists private.meeting_note_authorize(uuid, bigint, text);

