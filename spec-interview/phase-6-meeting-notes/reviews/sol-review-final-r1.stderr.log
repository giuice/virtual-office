// src/components/meeting-notes/editor/MeetingNoteRichTextEditor.tsx
// The meeting-note rich-text editor (FR-002): Tiptap limited to the SPEC's
// formatting set (meeting-note-extensions.ts). Client-only; load it through
// MeetingNoteRichTextEditorLazy so server rendering never touches Tiptap.
// Emits '' for an empty document, otherwise the editor HTML; the routes
// sanitize it again on write and the views sanitize it again on render.
'use client';

import { EditorContent, useEditor } from '@tiptap/react';
import { useEffect, useRef } from 'react';

import { cn } from '@/lib/utils';
import styles from '../meeting-note-content.module.css';
import { createMeetingNoteExtensions } from './meeting-note-extensions';
import { MeetingNoteEditorToolbar } from './MeetingNoteEditorToolbar';

export interface MeetingNoteRichTextEditorProps {
  /** id of the editable surface. */
  id: string;
  /** id of the visible label of the field. */
  labelId: string;
  /** ids of the help / error texts. */
  describedById?: string;
  /** Saved (sanitized) HTML to start from; later changes of this prop are ignored (remount to reset). */
  initialContent: string;
  invalid?: boolean;
  disabled?: boolean;
  placeholder?: string;
  onChange: (html: string) => void;
}

export default function MeetingNoteRichTextEditor({
  id,
  labelId,
  describedById,
  initialContent,
  invalid = false,
  disabled = false,
  placeholder = 'Write the meeting notesâ€¦',
  onChange,
}: MeetingNoteRichTextEditorProps) {
  const onChangeRef = useRef(onChange);
  useEffect(() => {
    onChangeRef.current = onChange;
  }, [onChange]);

  const editor = useEditor({
    immediatelyRender: false,
    shouldRerenderOnTransaction: false,
    editable: !disabled,
    extensions: createMeetingNoteExtensions(placeholder),
    content: initialContent,
    editorProps: {
      attributes: {
        id,
        role: 'textbox',
        'aria-multiline': 'true',
        'aria-labelledby': labelId,
        ...(describedById ? { 'aria-describedby': describedById } : {}),
        'aria-invalid': invalid ? 'true' : 'false',
        'data-testid': 'meeting-note-editor',
        class: cn(styles.content, styles.editor),
      },
    },
    onCreate: ({ editor: created }) => {
      onChangeRef.current(created.isEmpty ? '' : created.getHTML());
    },
    onUpdate: ({ editor: updated }) => {
      onChangeRef.current(updated.isEmpty ? '' : updated.getHTML());
    },
  });

  useEffect(() => {
    if (!editor) return;
    editor.setEditable(!disabled);
  }, [editor, disabled]);

  useEffect(() => {
    if (!editor) return;
    editor.setOptions({
      editorProps: {
        attributes: {
          ...((editor.options.editorProps?.attributes as Record<string, string> | undefined) ?? {}),
          'aria-invalid': invalid ? 'true' : 'false',
        },
      },
    });
  }, [editor, invalid]);

  return (
    <div
      className={cn(
        'overflow-hidden rounded-md border bg-background focus-within:ring-2 focus-within:ring-ring',
        invalid ? 'border-destructive' : 'border-input',
        disabled && 'opacity-70'
      )}
    >
      <MeetingNoteEditorToolbar editor={editor} editorId={id} disabled={disabled} />
      {editor ? (
        <EditorContent editor={editor} />
      ) : (
        <div className={cn(styles.editor, 'text-sm text-muted-foreground')} aria-hidden="true">
          Loading editorâ€¦
        </div>
      )}
    </div>
  );
}
// src/components/meeting-notes/editor/meeting-note-extensions.ts
// The Tiptap schema of a meeting note (FR-002): paragraphs, line breaks,
// bold, italic, headings 1â€“3, bulleted and numbered lists, checklists, and
// http/https/mailto links. Nothing else exists in the schema, so pasted code
// blocks, images, tables, quotes, strike, or rules are reduced to plain text.
// The HTML it emits is a subset of src/lib/meeting-notes/content-sanitizer.ts.
import type { Extensions } from '@tiptap/core';
import Bold from '@tiptap/extension-bold';
import Document from '@tiptap/extension-document';
import HardBreak from '@tiptap/extension-hard-break';
import Heading from '@tiptap/extension-heading';
import Italic from '@tiptap/extension-italic';
import Link from '@tiptap/extension-link';
import { BulletList, ListItem, ListKeymap, OrderedList, TaskItem, TaskList } from '@tiptap/extension-list';
import Paragraph from '@tiptap/extension-paragraph';
import Text from '@tiptap/extension-text';
import { Placeholder, UndoRedo } from '@tiptap/extensions';

import { isSafeMeetingNoteLink } from '@/lib/meeting-notes/link-url';
import { MEETING_NOTE_LINK_REL } from '@/lib/meeting-notes/content-sanitizer';

export const MEETING_NOTE_HEADING_LEVELS = [1, 2, 3] as const;

export function createMeetingNoteExtensions(placeholder: string): Extensions {
  return [
    Document,
    Paragraph,
    Text,
    HardBreak,
    Bold,
    Italic,
    Heading.configure({ levels: [...MEETING_NOTE_HEADING_LEVELS] }),
    BulletList,
    OrderedList,
    ListItem,
    TaskList,
    TaskItem.configure({ nested: true }),
    ListKeymap,
    Link.configure({
      openOnClick: false,
      autolink: true,
      linkOnPaste: true,
      defaultProtocol: 'https',
      protocols: ['mailto'],
      isAllowedUri: (url) => isSafeMeetingNoteLink(url),
      shouldAutoLink: (url) => isSafeMeetingNoteLink(url),
      HTMLAttributes: { rel: MEETING_NOTE_LINK_REL, target: '_blank' },
    }),
    UndoRedo,
    Placeholder.configure({ placeholder }),
  ];
}
// src/components/meeting-notes/MeetingNoteEditPanel.tsx
// Editing an existing note (FR-006, FR-007, J3). The save is a full
// replacement against the revision the editor started from; when another
// change landed first, the route answers 409 with the newer note and the
// conflict dialog shows both â€” the user's text stays available to copy,
// also after loading the newer version.
'use client';

import { useMemo, useState } from 'react';
import { AlertTriangle } from 'lucide-react';

import { Button } from '@/components/ui/button';
import { useUpdateMeetingNote } from '@/hooks/mutations/useMeetingNoteMutations';
import { MeetingNoteConflictError, type MeetingNoteFieldsPayload } from '@/lib/meeting-notes/client-api';
import { meetingNoteHtmlToText } from '@/lib/meeting-notes/html-text';
import type { MeetingNoteDetail } from '@/types/meeting-notes';
import { MeetingNoteConflictDialog } from './MeetingNoteConflictDialog';
import { MeetingNoteForm, type MeetingNoteFormInitialValues } from './MeetingNoteForm';

export interface MeetingNoteEditPanelProps {
  /** The note as it was when editing started; its revision is the save's base. */
  note: MeetingNoteDetail;
  onSaved: (note: MeetingNoteDetail) => void;
  onCancel: () => void;
}

export function MeetingNoteEditPanel({ note, onSaved, onCancel }: MeetingNoteEditPanelProps) {
  const update = useUpdateMeetingNote();
  const [base, setBase] = useState(note);
  const [pending, setPending] = useState<MeetingNoteFieldsPayload | null>(null);
  const [conflict, setConflict] = useState<MeetingNoteConflictError | null>(null);
  const [conflictOpen, setConflictOpen] = useState(false);
  const [backup, setBackup] = useState<MeetingNoteFieldsPayload | null>(null);

  const initial = useMemo<MeetingNoteFormInitialValues>(
    () => ({
      title: base.title,
      meetingDate: base.meetingDate,
      participants: base.participants,
      content: base.content,
    }),
    [base]
  );
  const backupText = useMemo(
    () => (backup ? `${backup.title}\n\n${meetingNoteHtmlToText(backup.content)}`.trim() : ''),
    [backup]
  );

  const submit = (fields: MeetingNoteFieldsPayload) => {
    setPending(fields);
    update.mutate(
      { noteId: base.id, expectedRevision: base.revision, fields },
      {
        onSuccess: (saved) => onSaved(saved),
        onError: (error) => {
          if (error instanceof MeetingNoteConflictError) {
            setConflict(error);
            setConflictOpen(true);
          }
        },
      }
    );
  };

  const loadNewer = () => {
    if (!conflict) return;
    setBackup(pending);
    setBase(conflict.note);
    setConflict(null);
    setConflictOpen(false);
    update.reset();
  };

  // A conflict is answered by the dialog and the banner, not as a form error.
  const formError = update.error instanceof MeetingNoteConflictError ? null : update.error;

  return (
    <div className="flex flex-col gap-4" data-testid="meeting-note-edit-panel">
      {conflict && !conflictOpen ? (
        <div
          className="flex flex-wrap items-center gap-3 rounded-md border border-amber-500/40 bg-amber-500/10 px-3 py-2 
text-sm"
          role="alert"
        >
          <AlertTriangle className="size-4 flex-none text-amber-600" aria-hidden="true" />
          <span className="min-w-0 flex-1">
            This note was changed by someone else while you were editing. Saving again will be refused until you
            load the newer version.
          </span>
          <Button type="button" size="sm" variant="outline" onClick={() => setConflictOpen(true)}>
            Review newer version
          </Button>
        </div>
      ) : null}

      {backup ? (
        <section
          aria-labelledby="meeting-note-backup-heading"
          className="flex flex-col gap-2 rounded-md border border-[var(--vo-line-soft)] bg-[var(--vo-bg-2)] p-3"
          data-testid="meeting-note-unsaved-backup"
        >
          <div className="flex items-center justify-between gap-2">
            <h3 id="meeting-note-backup-heading" className="text-sm font-semibold">
              Your earlier unsaved text
            </h3>
            <Button type="button" size="sm" variant="ghost" onClick={() => setBackup(null)}>
              Dismiss
            </Button>
          </div>
          <p className="text-xs text-muted-foreground">
            The form now shows the newer version. Copy anything you still need from here.
          </p>
          <textarea
            readOnly
            aria-labelledby="meeting-note-backup-heading"
            className="min-h-24 w-full resize-y rounded-md border border-input bg-background p-2 text-sm 
focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
            value={backupText}
          />
        </section>
      ) : null}

      <MeetingNoteForm
        // Remount on a new base so every field shows the newer version.
        key={`${base.id}:${base.revision}`}
        initial={initial}
        submitLabel="Save changes"
        submitting={update.isPending}
        submitError={formError}
        onSubmit={submit}
        onCancel={onCancel}
      />

      {conflict ? (
        <MeetingNoteConflictDialog
          open={conflictOpen}
          onOpenChange={setConflictOpen}
          newer={conflict.note}
          mine={pending}
          onLoadNewer={loadNewer}
        />
      ) : null}
    </div>
  );
}
