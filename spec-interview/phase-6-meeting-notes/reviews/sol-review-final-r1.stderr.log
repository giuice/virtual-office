   1: // src/components/meeting-notes/MeetingNoteParticipantPicker.tsx
   2: // Participants of a note (FR-001, FR-030): up to 50, new ones chosen from
   3: // the company's current members only. A participant who is no longer a
   4: // member stays listed as "Former member" with the name snapshot; it can be
   5: // removed, or kept when the note is saved. The database re-checks both rules.
   6: 'use client';
   7: 
   8: import { Plus, Search, X } from 'lucide-react';
   9: import { useMemo, useState } from 'react';
  10: 
  11: import { Badge } from '@/components/ui/badge';
  12: import { Button } from '@/components/ui/button';
  13: import { EnhancedAvatarV2 } from '@/components/ui/enhanced-avatar-v2';
  14: import { Input } from '@/components/ui/input';
  15: import { Popover, PopoverContent, PopoverTrigger } from '@/components/ui/popover';
  16: import { MEETING_NOTE_LIMITS } from '@/lib/meeting-notes/validation';
  17: import type { User } from '@/types/database';
  18: import type { MeetingNoteParticipant } from '@/types/meeting-notes';
  19: 
  20: export interface MeetingNoteParticipantPickerProps {
  21:   /** id of the field's visible label. */
  22:   labelId: string;
  23:   describedById?: string;
  24:   value: MeetingNoteParticipant[];
  25:   /** The company's current members. */
  26:   members: readonly User[];
  27:   disabled?: boolean;
  28:   onChange: (next: MeetingNoteParticipant[]) => void;
  29: }
  30: 
  31: const MAX_RESULTS = 50;
  32: 
  33: export function MeetingNoteParticipantPicker({
  34:   labelId,
  35:   describedById,
  36:   value,
  37:   members,
  38:   disabled = false,
  39:   onChange,
  40: }: MeetingNoteParticipantPickerProps) {
  41:   const [open, setOpen] = useState(false);
  42:   const [query, setQuery] = useState('');
  43: 
  44:   const membersById = useMemo(() => new Map(members.map((member) => [member.id, member])), [members]);
  45:   const selectedIds = useMemo(() => new Set(value.map((participant) => participant.userId)), [value]);
  46:   const full = value.length >= MEETING_NOTE_LIMITS.maxParticipants;
  47: 
  48:   const candidates = useMemo(() => {
  49:     const needle = query.trim().toLocaleLowerCase();
  50:     return members
  51:       .filter((member) => !selectedIds.has(member.id))
  52:       .filter(
  53:         (member) =>
  54:           needle === '' ||
  55:           member.displayName.toLocaleLowerCase().includes(needle) ||
  56:           member.email.toLocaleLowerCase().includes(needle)
  57:       )
  58:       .sort((a, b) => a.displayName.localeCompare(b.displayName))
  59:       .slice(0, MAX_RESULTS);
  60:   }, [members, query, selectedIds]);
  61: 
  62:   const add = (member: User) => {
  63:     if (full || selectedIds.has(member.id)) return;
  64:     onChange([...value, { userId: member.id, displayName: member.displayName, isCurrentMember: true }]);
  65:   };
  66: 
  67:   const remove = (userId: string) => {
  68:     onChange(value.filter((participant) => participant.userId !== userId));
  69:   };
  70: 
  71:   return (
  72:     <div className="flex flex-col gap-2" role="group" aria-labelledby={labelId} aria-describedby={describedById}>
  73:       {value.length === 0 ? (
  74:         <p className="text-sm text-muted-foreground">No participants yet.</p>
  75:       ) : (
  76:         <ul className="flex flex-wrap gap-2" data-testid="meeting-note-participant-picker-list">
  77:           {value.map((participant) => {
  78:             const member = participant.isCurrentMember ? membersById.get(participant.userId) : undefined;
  79:             return (
  80:               <li
  81:                 key={participant.userId}
  82:                 className="flex items-center gap-2 rounded-full border border-[var(--vo-line-soft)] 
bg-[var(--vo-bg-2)] py-1 pl-1 pr-1.5 text-sm"
  83:                 data-testid="meeting-note-participant-chip"
  84:                 data-former-member={participant.isCurrentMember ? undefined : 'true'}
  85:               >
  86:                 <EnhancedAvatarV2 user={member ?? null} fallbackName={participant.displayName} size="sm" 
className="size-6" />
  87:                 <span className="max-w-[12rem] truncate">{participant.displayName}</span>
  88:                 {participant.isCurrentMember ? null : (
  89:                   <Badge variant="outline" className="text-[10px]">
  90:                     Former member
  91:                   </Badge>
  92:                 )}
  93:                 <button
  94:                   type="button"
  95:                   className="inline-flex size-6 items-center justify-center rounded-full text-muted-foreground 
hover:bg-[var(--vo-hover-bg)] hover:text-foreground focus-visible:outline-none focus-visible:ring-2 
focus-visible:ring-ring disabled:opacity-40"
  96:                   aria-label={`Remove ${participant.displayName}`}
  97:                   disabled={disabled}
  98:                   onClick={() => remove(participant.userId)}
  99:                 >
 100:                   <X className="size-3.5" aria-hidden="true" />
 101:                 </button>
 102:               </li>
 103:             );
 104:           })}
 105:         </ul>
 106:       )}
 107: 
 108:       <div className="flex items-center gap-3">
 109:         <Popover
 110:           open={open}
 111:           onOpenChange={(next) => {
 112:             setOpen(next);
 113:             if (!next) setQuery('');
 114:           }}
 115:         >
 116:           <PopoverTrigger asChild>
 117:             <Button type="button" size="sm" variant="outline" className="h-8 gap-1.5" disabled={disabled || 
full}>
 118:               <Plus className="size-3.5" aria-hidden="true" />
 119:               Add participants
 120:             </Button>
 121:           </PopoverTrigger>
 122:           <PopoverContent
 123:             align="start"
 124:             className="w-80 p-2"
 125:             aria-label="Add participants"
 126:             onKeyDown={(event) => event.stopPropagation()}
 127:           >
 128:             <div className="relative">
 129:               <Search
 130:                 className="pointer-events-none absolute left-2.5 top-1/2 size-4 -translate-y-1/2 
text-muted-foreground"
 131:                 aria-hidden="true"
 132:               />
 133:               <Input
 134:                 value={query}
 135:                 onChange={(event) => setQuery(event.target.value)}
 136:                 placeholder="Search members"
 137:                 aria-label="Search members"
 138:                 className="h-9 pl-8"
 139:                 autoComplete="off"
 140:               />
 141:             </div>
 142:             {candidates.length === 0 ? (
 143:               <p className="px-2 py-3 text-sm text-muted-foreground">
 144:                 {members.length === 0 ? 'Members are still loading.' : 'No other members match.'}
 145:               </p>
 146:             ) : (
 147:               <ul className="mt-2 max-h-64 overflow-y-auto" aria-label="Company members">
 148:                 {candidates.map((member) => (
 149:                   <li key={member.id}>
 150:                     <button
 151:                       type="button"
 152:                       className="flex w-full items-center gap-2 rounded-md px-2 py-1.5 text-left text-sm 
hover:bg-[var(--vo-hover-bg)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring 
disabled:opacity-40"
 153:                       aria-label={`Add ${member.displayName}`}
 154:                       disabled={full}
 155:                       onClick={() => add(member)}
 156:                       data-testid="meeting-note-participant-option"
 157:                     >
 158:                       <EnhancedAvatarV2 user={member} size="sm" className="size-6" />
 159:                       <span className="min-w-0 flex-1 truncate">{member.displayName}</span>
 160:                     </button>
 161:                   </li>
 162:                 ))}
 163:               </ul>
 164:             )}
 165:           </PopoverContent>
 166:         </Popover>
 167:         <span className="text-xs text-muted-foreground" aria-live="polite">
 168:           {value.length}/{MEETING_NOTE_LIMITS.maxParticipants}
 169:           {full ? ' â€” limit reached' : ''}
 170:         </span>
 171:       </div>
 172:     </div>
 173:   );
 174: }

