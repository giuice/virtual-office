function messageFor(code: string): string {
  return MESSAGES[code] ?? MESSAGES.BAD_REQUEST;
}

/** An error response with a stable code and the matching user-facing message. */
export function meetingNoteError(
  status: number,
  code: string,
  ctx: { correlationId: string },
  context?: string
): NextResponse {
  return jsonError(status, code, messageFor(code), { correlationId: ctx.correlationId, context });
}

/** An error response carrying extra non-sensitive fields (UI hints) next to code and message. */
export function meetingNoteErrorWithData(
  status: number,
  code: string,
  ctx: { correlationId: string },
  data: Record<string, unknown>
): NextResponse {
  return NextResponse.json(
    { error: messageFor(code), code, correlationId: ctx.correlationId, ...data },
    { status, headers: { 'x-correlation-id': ctx.correlationId } }
  );
}

/** 404 for a missing, invisible, or malformed id (never reveals which). */
export function notFound(token: MeetingNoteErrorToken, ctx: { correlationId: string }): NextResponse {
  return meetingNoteError(404, token, ctx);
}

/**
 * Authenticates the caller (auth.getUser + users.supabase_uid) and, for a
 * mutation, charges `rateLimit` to their users.id.
 */
export async function beginMeetingNoteRequest(
  pathname: string,
  rateLimit?: RateLimitedAction
): Promise<Result<MeetingNoteRouteContext>> {
  const correlationId = createCorrelationId();
  const auth = await requireAuthUser({ correlationId, pathname });
  if ('errorResponse' in auth) {
    return { ok: false, response: auth.errorResponse };
  }

  if (rateLimit) {
    let limiter: SupabaseClient | null = null;
    try {
      limiter = await createSupabaseServerClient('service_role');
    } catch {
      // Fail-open action: a limiter that cannot be built never blocks notes.
      console.error(JSON.stringify({ event: 'meeting_notes_limiter_unavailable', correlationId }));
    }
    if (limiter) {
      const limited = await enforceRateLimit(limiter, auth.dbUser.id, rateLimit);
      if (limited) return { ok: false, response: limited };
    }
  }

  return {
    ok: true,
    value: {
      correlationId,
      supabase: auth.supabase,
      dbUser: auth.dbUser,
      repository: new SupabaseMeetingNoteRepository(auth.supabase),
    },
  };
}

/**
 * Entry point of EVERY mutating meeting-notes route (POST/PUT/PATCH/DELETE
 * under /api/meeting-notes and /api/companies/ai-settings): refuses a
 * cross-origin browser request (403 MEETING_NOTE_ORIGIN_FORBIDDEN, see
 * request-origin.ts) before any session lookup, rate-limit charge, or body
 * read, then authenticates and charges `rateLimit` like beginMeetingNoteRequest.
 */
export async function beginMeetingNoteMutation(
  request: Request,
  pathname: string,
  rateLimit: RateLimitedAction
): Promise<Result<MeetingNoteRouteContext>> {
  if (isCrossOriginMeetingNoteRequest(request)) {
    await request.body?.cancel().catch(() => undefined);
    return { ok: false, response: meetingNoteError(403, 'MEETING_NOTE_ORIGIN_FORBIDDEN', { correlationId: 
createCorrelationId() }) };
  }
  return beginMeetingNoteRequest(pathname, rateLimit);
}

/** A path id; anything that is not a UUID is answered as not found. */
export function parsePathId(
  raw: string | undefined,
  token: MeetingNoteErrorToken,
  ctx: { correlationId: string }
): Result<string> {
  const parsed = pathIdSchema.safeParse(raw);
  return parsed.success ? { ok: true, value: parsed.data } : { ok: false, response: notFound(token, ctx) };
}

/** Validation failure â†’ 400 with the first issue's stable code. */
export function validationError(error: z.ZodError, ctx: { correlationId: string }): NextResponse {
  const issue = error.issues[0];
  const code = issue && /^[A-Z_]+$/.test(issue.message) ? issue.message : 'BAD_REQUEST';
  return meetingNoteError(400, code, ctx);
}

export function parseWith<S extends z.ZodType>(
  schema: S,
  value: unknown,
  ctx: { correlationId: string }
): Result<z.infer<S>> {
  const parsed = schema.safeParse(value);
  return parsed.success
    ? { ok: true, value: parsed.data }
    : { ok: false, response: validationError(parsed.error, ctx) };
}

/** A JSON object body of at most MEETING_NOTE_MAX_BODY_BYTES. */
export async function readJsonObject(request: Request, ctx: { correlationId: string }): Promise<Result<unknown>> {
  const contentType = request.headers.get('content-type') ?? '';
  if (contentType.split(';')[0].trim().toLowerCase() !== 'application/json') {
    await request.body?.cancel().catch(() => undefined);
    return { ok: false, response: meetingNoteError(415, 'UNSUPPORTED_MEDIA_TYPE', ctx) };
  }
  const body = await readBoundedBody(request, MEETING_NOTE_MAX_BODY_BYTES);
  if (!body.ok) {
    return {
      ok: false,
      response: meetingNoteError(body.reason === 'too_large' ? 413 : 400, body.reason === 'too_large' ? 
'PAYLOAD_TOO_LARGE' : 'BAD_REQUEST', ctx),
    };
  }
  try {
    const value: unknown = JSON.parse(new TextDecoder('utf-8', { fatal: true }).decode(body.bytes));
    if (typeof value !== 'object' || value === null || Array.isArray(value)) {
      return { ok: false, response: meetingNoteError(400, 'BAD_REQUEST', ctx) };
    }
    return { ok: true, value };
  } catch {
    return { ok: false, response: meetingNoteError(400, 'BAD_REQUEST', ctx) };
  }
}

/** 500 without SQL, details, or request data (they could carry note text). */
export function internalError(error: unknown, ctx: { correlationId: string }, context: string): NextResponse {
  const cause =
    error instanceof MeetingNoteDbError
      ? { code: error.sqlstate, message: error.token ?? 'unexpected database error' }
      : { message: error instanceof Error ? error.name : 'unknown' };
  return jsonError(500, 'INTERNAL_ERROR', 'Something went wrong. Please try again.', {
    correlationId: ctx.correlationId,
    cause,
    context,
  });
}

/** Maps a documented RPC refusal (other than a stale revision) to HTTP. */
function refusalResponse(error: MeetingNoteDbError, ctx: { correlationId: string }, context: string): NextResponse {
  const token = error.token;
  if (token === null) return internalError(error, ctx, context);
  switch (error.sqlstate) {
    case '42501':
      return meetingNoteError(403, token, ctx, context);
    case 'P0002':
      return meetingNoteError(404, token, ctx, context);
    case '22023':
      return meetingNoteError(token === 'MEETING_NOTE_TRANSCRIPT_TOO_LARGE' ? 413 : 400, token, ctx, context);
    default:
      return internalError(error, ctx, context);
  }
}

function isStale(error: unknown, token: 'MEETING_NOTE_STALE_REVISION' | 'MEETING_NOTE_ITEM_STALE_REVISION'): error is 
MeetingNoteDbError {
  return error instanceof MeetingNoteDbError && error.sqlstate === 'P0001' && error.token === token;
}

/**
 * A failed note mutation â†’ response. A stale revision â†’ 409 carrying the
 * note's current state (read with the caller's session) so the UI can show it.
 */
export async function noteMutationErrorResponse(
  error: unknown,
  ctx: MeetingNoteRouteContext,
  noteId: string,
  context: string
): Promise<NextResponse> {
  if (isStale(error, 'MEETING_NOTE_STALE_REVISION')) {
    try {
      const current = await loadMeetingNoteDetail(ctx.repository, ctx.dbUser, noteId);
      if (!current) return notFound('MEETING_NOTE_NOT_FOUND', ctx);
      return conflict('MEETING_NOTE_STALE_REVISION', current.revision, { note: current }, ctx);
    } catch (loadError) {
      return internalError(loadError, ctx, `${context}.loadCurrent`);
    }
  }
  if (error instanceof MeetingNoteDbError) return refusalResponse(error, ctx, context);
  return internalError(error, ctx, context);
}

/** Same for an action-item mutation; the 409 carries the item's current state. */
export async function itemMutationErrorResponse(
  error: unknown,
  ctx: MeetingNoteRouteContext,
  itemId: string,
  companyId: string | null,
  context: string
): Promise<NextResponse> {
  if (isStale(error, 'MEETING_NOTE_ITEM_STALE_REVISION')) {
    try {
      const item = await ctx.repository.findActionItemById(itemId);
      if (!item) return notFound('MEETING_NOTE_ITEM_NOT_FOUND', ctx);
      const [view] = await loadActionItemViews(ctx.repository, companyId, [item]);
      return conflict('MEETING_NOTE_ITEM_STALE_REVISION', view.revision, { item: view }, ctx);
    } catch (loadError) {
      return internalError(loadError, ctx, `${context}.loadCurrent`);
    }
  }
  if (error instanceof MeetingNoteDbError) return refusalResponse(error, ctx, context);
  return internalError(error, ctx, context);
}

function conflict(
  code: 'MEETING_NOTE_STALE_REVISION' | 'MEETING_NOTE_ITEM_STALE_REVISION',
  currentRevision: number,
  current: Record<string, unknown>,
  ctx: { correlationId: string }
): NextResponse {
  return NextResponse.json(
    { error: messageFor(code), code, currentRevision, correlationId: ctx.correlationId, ...current },
    { status: 409, headers: { 'x-correlation-id': ctx.correlationId } }
  );
}

/**
 * The item addressed by /api/meeting-notes/[id]/items/[itemId], read with the
 * caller's session; 404 unless it is visible AND belongs to that note (the
 * item RPCs take only the item id, and an item's note_id is immutable).
 */
export async function resolveItemInNote(
  ctx: MeetingNoteRouteContext,
  rawNoteId: string | undefined,
  rawItemId: string | undefined
): Promise<Result<ActionItem>> {
  const noteId = parsePathId(rawNoteId, 'MEETING_NOTE_ITEM_NOT_FOUND', ctx);
  if (!noteId.ok) return noteId;
  const itemId = parsePathId(rawItemId, 'MEETING_NOTE_ITEM_NOT_FOUND', ctx);
  if (!itemId.ok) return itemId;
  try {
    const item = await ctx.repository.findActionItemById(itemId.value);
    if (!item || item.noteId !== noteId.value) {
      return { ok: false, response: notFound('MEETING_NOTE_ITEM_NOT_FOUND', ctx) };
    }
    return { ok: true, value: item };
  } catch (error) {
    return { ok: false, response: internalError(error, ctx, 'meetingNotes.item.resolve') };
  }
}

/** A success body with the correlation header. */
export function ok<T>(body: T, ctx: { correlationId: string }, status = 200): NextResponse<T> {
  return NextResponse.json(body, { status, headers: { 'x-correlation-id': ctx.correlationId } });
}
// src/lib/meeting-notes/request-origin.ts
// Cross-origin request guard of the mutating meeting-notes routes (Phase 6,
// block C review C-3). SameSite=Lax session cookies are still sent by a
// sibling origin of the same site (another subdomain), which can submit a
// credentialed form or multipart POST without any preflight. Every mutating
// meeting-notes route therefore refuses a request that a browser marks as
// coming from another origin:
//   * Sec-Fetch-Site `cross-site` or `same-site` â†’ refused (browser-set; a page
//     cannot forge it). `same-origin` and `none` (user-initiated) continue.
//   * Origin present â†’ it must be the app's own origin: the request's Host
//     (or X-Forwarded-Host, which Next.js fills from Host), the request URL's
//     origin, or NEXT_PUBLIC_APP_URL. `null` or an unparsable Origin is refused.
//   * Neither header â†’ allowed. Browsers send Origin on every POST/PUT/PATCH/
//     DELETE fetch and form submission, so a cross-origin browser request
//     always carries one; a request without both comes from a non-browser
//     client (server-to-server, tests), which holds no victim's cookies.
// Host/X-Forwarded-Host are trusted because Next.js builds request.url from
// its own listen address, not the public host. A forged value cannot help an
// attacking PAGE (a non-safelisted header triggers a CORS preflight these
// routes never approve); a non-browser client can forge it, but such a client
// holds no victim's cookies and is not what this guard defends against.
import 'server-only';

const REFUSED_FETCH_SITES: ReadonlySet<string> = new Set(['cross-site', 'same-site']);

function originOf(value: string | undefined | null): string | null {
  if (!value) return null;
  try {
    const url = new URL(value.trim());
    return url.protocol === 'http:' || url.protocol === 'https:' ? url.origin : null;
  } catch {
    return null;
  }
}

/** First value of a possibly comma-separated forwarding header, lower-cased. */
function firstHost(value: string | null): string | null {
  const first = value?.split(',')[0]?.trim().toLowerCase();
  return first ? first : null;
}

function isOwnOrigin(request: Request, origin: string): boolean {
  const parsed = originOf(origin);
  if (!parsed) return false;
  if (parsed === originOf(request.url)) return true;
  if (parsed === originOf(process.env.NEXT_PUBLIC_APP_URL)) return true;
  const host = new URL(parsed).host.toLowerCase();
  return host === firstHost(request.headers.get('host')) || host === 
firstHost(request.headers.get('x-forwarded-host'));
}

/** True when a browser marked the request as coming from another origin. */
export function isCrossOriginMeetingNoteRequest(request: Request): boolean {
  const fetchSite = request.headers.get('sec-fetch-site')?.trim().toLowerCase();
  if (fetchSite && REFUSED_FETCH_SITES.has(fetchSite)) return true;
  const origin = request.headers.get('origin');
  if (origin === null) return false;
  return !isOwnOrigin(request, origin);
}
// src/lib/meeting-notes/ai/ticket.ts
// Signed processing tickets for the meeting-note AI flow (Phase 6 T9; FR-015,
// FR-031). A ticket is issued by the server when the provider notice is shown
// and is presented by the start request. It carries its issue time, a
// SERVER-GENERATED idempotency key, and the binding (application user,
// company, note, source note revision, transcript identity, AI settings
// revision), signed with HMAC-SHA256. A client can neither choose a key nor
// move a key to a new ticket: changing any byte invalidates the signature.
//
// Format: "mnt1.<base64url(canonical JSON payload)>.<base64url(HMAC-SHA256)>",
// the MAC computed over "mnt1.<payload segment>".
//
// Secrets (server-only environment, never NEXT_PUBLIC_):
//   MEETING_NOTES_TICKET_SECRET           required, >= 32 bytes with >= 16 distinct
//                                         bytes (random); signs and verifies.
//   MEETING_NOTES_TICKET_SECRET_PREVIOUS  optional, >= 32 bytes when set; verifies
//                                         only, so a rotation keeps outstanding
//                                         tickets valid for their 24 hours.
// There is no fallback: a missing or short secret raises
// MeetingNoteAiTicketConfigError (callers answer with a configuration error).
// Neither secret is ever logged or included in an error message.
import 'server-only';

import { createHmac, randomUUID, timingSafeEqual } from 'node:crypto';
import { z } from 'zod';

const PREFIX = 'mnt1';
const VERSION = 1;
/** A ticket and its idempotency key are valid for 24 hours after issuance. */
export const MEETING_NOTE_AI_TICKET_TTL_SECONDS = 24 * 60 * 60;
/** Accepted clock skew for an issue time in the future. */
const MAX_FUTURE_SKEW_SECONDS = 60;
const MIN_SECRET_BYTES = 32;
/** A random 32+ byte secret has far more distinct bytes; fewer means a placeholder or a typed word. */
const MIN_SECRET_DISTINCT_BYTES = 16;
/** A real ticket is ~450 characters; anything far longer is not a ticket. */
const MAX_TICKET_LENGTH = 2_048;
const MAC_BYTES = 32;
const SEGMENT = /^[A-Za-z0-9_-]+$/;

export const MEETING_NOTES_TICKET_SECRET_ENV = 'MEETING_NOTES_TICKET_SECRET';
export const MEETING_NOTES_TICKET_SECRET_PREVIOUS_ENV = 'MEETING_NOTES_TICKET_SECRET_PREVIOUS';

/** What a ticket binds: the operation's identity apart from its key and time. */
export interface MeetingNoteAiTicketBinding {
  /** Application users.id of the authenticated requester. */
  userId: string;
  companyId: string;
  noteId: string;
  /** Note revision the notice was shown for (the draft's source revision). */
  sourceRevision: number;
  /** Stored-transcript identity the notice was shown for. */
  transcriptId: string;
  /** AI settings revision the notice was shown for. */
  settingsRevision: number;
}

export interface MeetingNoteAiTicketPayload extends MeetingNoteAiTicketBinding {
  v: typeof VERSION;
  /** Issue time, whole seconds since the Unix epoch. */
  iat: number;
  /** Server-generated idempotency key (UUID), unique per ticket. */
  idempotencyKey: string;
}

export interface IssuedMeetingNoteAiTicket {
  ticket: string;
  payload: MeetingNoteAiTicketPayload;
  /** ISO time after which the ticket and its key are rejected as expired. */
  expiresAt: string;
}

export type MeetingNoteAiTicketRejection = 'malformed' | 'invalid_signature' | 'expired' | 'not_yet_valid';

export type MeetingNoteAiTicketVerification =
  | { ok: true; payload: MeetingNoteAiTicketPayload; expiresAt: string }
  | { ok: false; reason: MeetingNoteAiTicketRejection };

/** The ticket secret is missing or too short (no fallback exists). */
export class MeetingNoteAiTicketConfigError extends Error {
  constructor() {
    super('The meeting-notes ticket secret is not configured.');
    this.name = 'MeetingNoteAiTicketConfigError';
  }
}

const uuid = z.guid();
const revision = z.number().int().min(1).max(Number.MAX_SAFE_INTEGER);

const payloadSchema = z
  .object({
    v: z.literal(VERSION),
    iat: z.number().int().min(0).max(Number.MAX_SAFE_INTEGER),
    idempotencyKey: uuid,
    userId: uuid,
    companyId: uuid,
    noteId: uuid,
    sourceRevision: revision,
    transcriptId: uuid,
    settingsRevision: revision,
  })
  .strict();

const bindingSchema = payloadSchema.omit({ v: true, iat: true, idempotencyKey: true });

function secretFrom(name: string, required: boolean): Buffer | null {
  const value = process.env[name];
  if (value === undefined || value === '') {
    if (required) throw new MeetingNoteAiTicketConfigError();
    return null;
  }
  const bytes = Buffer.from(value, 'utf8');
  if (bytes.length < MIN_SECRET_BYTES || new Set(bytes).size < MIN_SECRET_DISTINCT_BYTES) {
    throw new MeetingNoteAiTicketConfigError();
  }
  return bytes;
}

function currentSecret(): Buffer {
  const secret = secretFrom(MEETING_NOTES_TICKET_SECRET_ENV, true);
  if (!secret) throw new MeetingNoteAiTicketConfigError();
  return secret;
}

/** Throws MeetingNoteAiTicketConfigError unless tickets can be issued and verified. */
export function assertMeetingNoteAiTicketConfigured(): void {
  currentSecret();
  secretFrom(MEETING_NOTES_TICKET_SECRET_PREVIOUS_ENV, false);
}

function mac(secret: Buffer, signedPart: string): Buffer {
  return createHmac('sha256', secret).update(signedPart, 'utf8').digest();
}

/** Fixed key order: the payload bytes depend only on the values. */
function canonicalJson(payload: MeetingNoteAiTicketPayload): string {
  return JSON.stringify({
    v: payload.v,
    iat: payload.iat,
    idempotencyKey: payload.idempotencyKey,
    userId: payload.userId,
    companyId: payload.companyId,
    noteId: payload.noteId,
    sourceRevision: payload.sourceRevision,
    transcriptId: payload.transcriptId,
    settingsRevision: payload.settingsRevision,
  });
}

function expiresAtOf(iat: number): string {
  return new Date((iat + MEETING_NOTE_AI_TICKET_TTL_SECONDS) * 1000).toISOString();
}

/** The issue time as the ISO instant the admission RPC binds. */
export function meetingNoteAiTicketIssuedAt(payload: Pick<MeetingNoteAiTicketPayload, 'iat'>): string {
  return new Date(payload.iat * 1000).toISOString();
}

/**
 * Signs a new ticket with a fresh server-generated idempotency key. Call only
 * after the route authorized the user (current membership and editor rights).
 */
export function issueMeetingNoteAiTicket(
  binding: MeetingNoteAiTicketBinding,
  nowMs: number = Date.now()
): IssuedMeetingNoteAiTicket {
  const secret = currentSecret();
  secretFrom(MEETING_NOTES_TICKET_SECRET_PREVIOUS_ENV, false);
  const checked = bindingSchema.parse(binding);
  const payload: MeetingNoteAiTicketPayload = {
    v: VERSION,
    iat: Math.floor(nowMs / 1000),
    idempotencyKey: randomUUID(),
    ...checked,
  };
  const encoded = Buffer.from(canonicalJson(payload), 'utf8').toString('base64url');
  const signedPart = `${PREFIX}.${encoded}`;
  const ticket = `${signedPart}.${mac(secret, signedPart).toString('base64url')}`;
  return { ticket, payload, expiresAt: expiresAtOf(payload.iat) };
}

function macMatches(secret: Buffer, signedPart: string, received: Buffer): boolean {
  const expected = mac(secret, signedPart);
  return received.length === expected.length && timingSafeEqual(received, expected);
}

/**
 * Verifies a presented ticket: format, signature (current secret, then the
 * previous one), payload shape, and the 24-hour validity of the ticket and its
 * key. Throws MeetingNoteAiTicketConfigError when the secret is missing.
 */
export function verifyMeetingNoteAiTicket(ticket: unknown, nowMs: number = Date.now()): 
MeetingNoteAiTicketVerification {
  const current = currentSecret();
  const previous = secretFrom(MEETING_NOTES_TICKET_SECRET_PREVIOUS_ENV, false);

  if (typeof ticket !== 'string' || ticket.length > MAX_TICKET_LENGTH) return { ok: false, reason: 'malformed' };
  const parts = ticket.split('.');
  if (parts.length !== 3 || parts[0] !== PREFIX || !SEGMENT.test(parts[1]) || !SEGMENT.test(parts[2])) {
    return { ok: false, reason: 'malformed' };
  }
  const received = Buffer.from(parts[2], 'base64url');
  if (received.length !== MAC_BYTES || received.toString('base64url') !== parts[2]) {
    return { ok: false, reason: 'malformed' };
  }

  const signedPart = `${PREFIX}.${parts[1]}`;
  const signed = macMatches(current, signedPart, received) || (previous !== null && macMatches(previous, signedPart, 
received));
  if (!signed) return { ok: false, reason: 'invalid_signature' };

  let decoded: unknown;
  try {
    decoded = JSON.parse(new TextDecoder('utf-8', { fatal: true }).decode(Buffer.from(parts[1], 'base64url')));
  } catch {
    return { ok: false, reason: 'malformed' };
  }
  const parsed = payloadSchema.safeParse(decoded);
  if (!parsed.success) return { ok: false, reason: 'malformed' };
  const payload = parsed.data;

  const nowSeconds = Math.floor(nowMs / 1000);
  if (payload.iat > nowSeconds + MAX_FUTURE_SKEW_SECONDS) return { ok: false, reason: 'not_yet_valid' };
  if (nowSeconds >= payload.iat + MEETING_NOTE_AI_TICKET_TTL_SECONDS) return { ok: false, reason: 'expired' };

  return { ok: true, payload, expiresAt: expiresAtOf(payload.iat) };
}
// src/lib/meeting-notes/ai/base-url.ts
// Provider base URL for the meeting-note adapters (Phase 6 T11). The real URL
// comes from the capability matrix. A server-only environment variable,
// MEETING_NOTES_AI_BASE_URL_OVERRIDE, points every provider at the local fake
// AI server in tests (T16):
//   `${override}/${provider}${new URL(capability.baseUrl).pathname}`
// It is read from the server's environment only â€” no request input can set
// it â€” and it is IGNORED when NODE_ENV is "production", with one refusal line
// logged per resolution (the variable's value is never logged). An override
// that is not a plain http(s) origin/path fails closed instead of falling back
// to the real provider.
import 'server-only';

import type { MeetingNoteAiProvider } from '@/types/meeting-notes';

import { MEETING_NOTE_AI_CAPABILITIES } from './capabilities';

export const MEETING_NOTES_AI_BASE_URL_OVERRIDE_ENV = 'MEETING_NOTES_AI_BASE_URL_OVERRIDE';

export type MeetingNoteAiBaseUrlResolution =
  | { ok: true; baseUrl: string; overridden: boolean }
  | { ok: false; code: 'MEETING_NOTE_AI_CONFIGURATION_INVALID' };

function withoutTrailingSlash(value: string): string {
  return value.replace(/\/+$/, '');
}

export function resolveMeetingNoteAiBaseUrl(provider: MeetingNoteAiProvider): MeetingNoteAiBaseUrlResolution {
  const realBaseUrl = withoutTrailingSlash(MEETING_NOTE_AI_CAPABILITIES[provider].baseUrl);
  const override = process.env[MEETING_NOTES_AI_BASE_URL_OVERRIDE_ENV]?.trim();
  if (!override) return { ok: true, baseUrl: realBaseUrl, overridden: false };

  if (process.env.NODE_ENV === 'production') {
    console.warn(
      `[meeting-notes ai] ${MEETING_NOTES_AI_BASE_URL_OVERRIDE_ENV} is set but refused in production; using the 
provider's real API URL.`
    );
    return { ok: true, baseUrl: realBaseUrl, overridden: false };
  }

  let parsed: URL;
  try {
    parsed = new URL(override);
  } catch {
    return { ok: false, code: 'MEETING_NOTE_AI_CONFIGURATION_INVALID' };
  }
  if (
    (parsed.protocol !== 'http:' && parsed.protocol !== 'https:') ||
    parsed.username ||
    parsed.password ||
    parsed.search ||
    parsed.hash
  ) {
    return { ok: false, code: 'MEETING_NOTE_AI_CONFIGURATION_INVALID' };
  }
  const realPath = withoutTrailingSlash(new URL(realBaseUrl).pathname);
  return {
    ok: true,
    baseUrl: `${withoutTrailingSlash(parsed.origin + parsed.pathname)}/${provider}${realPath}`,
    overridden: true,
  };
}
// src/lib/meeting-notes/ai/adapters/transport.ts
// Shared transport guard of the meeting-note provider adapters (Phase 6 T11).
// Every SDK client gets `fetch: createDispatchFetch(state, credential)` and
// `maxRetries: 0`; the wrapper:
//   * refuses a second outbound request on the same call (exactly one request
//     per call, even if an SDK tried to retry);
//   * refuses to send when the signal is already aborted (never sent);
//   * never follows a redirect (`redirect: 'manual'`): a 3xx from the provider
//     or a gateway IS the initial response and is classified like any other
//     non-2xx (not a listed rejection â†’ counted), so no second request is
//     made and no credential is forwarded to another origin;
//   * rebuilds the outgoing headers from an allowlist and sets ONLY the
//     admitted credential: whatever the SDKs pick up from the server
//     environment (ANTHROPIC_CUSTOM_HEADERS / OPENAI_CUSTOM_HEADERS, ambient
//     keys or tokens, organization/project ids) never leaves the server;
//   * records whether the request was handed to the network (`dispatched`),
//     whether the connection was refused / the host did not resolve (no byte
//     can have reached the provider), and the INITIAL response status plus a
//     bounded copy of a non-2xx body for FR-022 classification â€” so counting
//     never depends on SDK error parsing or on provider text.
// createRequestControl joins the caller's AbortSignal with the adapter's own
// deadline (the SDK's timeout stops at response headers; the deadline also
// covers the streamed body).
import 'server-only';

import type { MeetingNoteAiProvider } from '@/types/meeting-notes';

import {
  classifyMeetingNoteAiPreProcessingRejection,
  type MeetingNoteAiModelCapability,
  type MeetingNoteAiReasoningLevel,
} from '../capabilities';
import {
  meetingNoteAiFailure,
  meetingNoteAiRejectionFailure,
  type MeetingNoteAiDraftFailure,
  type MeetingNoteAiUsageReport,
} from '../provider-errors';

type FetchInput = string | URL | Request;

export interface MeetingNoteAiDispatchState {
  dispatched: boolean;
  /** Connection refused or DNS failure before any request byte could leave. */
  unreachable: boolean;
  /** Status of the provider's initial response, once headers arrived. */
  initialStatus: number | null;
  /** Parsed JSON of a non-2xx initial body (â‰¤64 KB), else null. */
  initialErrorBody: unknown;
}

export function createDispatchState(): MeetingNoteAiDispatchState {
  return { dispatched: false, unreachable: false, initialStatus: null, initialErrorBody: null };
}

const MAX_ERROR_BODY_BYTES = 64 * 1024;
/** Error codes that prove the TCP connection was never established. */
const UNREACHABLE_CODES: ReadonlySet<string> = new Set(['ECONNREFUSED', 'ENOTFOUND', 'EAI_AGAIN']);

function abortError(): Error {
  const error = new Error('The meeting-note AI request was aborted before it was sent.');
  error.name = 'AbortError';
  return error;
}

/** Walks `cause` links (undici wraps socket errors as `TypeError: fetch failed`). */
function isUnreachableError(err: unknown): boolean {
  let current: unknown = err;
  for (let depth = 0; depth < 5 && current !== null && typeof current === 'object'; depth += 1) {
    const code = (current as { code?: unknown }).code;
    if (typeof code === 'string' && UNREACHABLE_CODES.has(code)) return true;
    current = (current as { cause?: unknown }).cause;
  }
  return false;
}

async function readBoundedJson(response: Response): Promise<unknown> {
  const reader = response.body?.getReader();
  if (!reader) return null;
  const chunks: Uint8Array[] = [];
  let size = 0;
  try {
    for (;;) {
      const { done, value } = await reader.read();
      if (done) break;
      size += value.byteLength;
      if (size > MAX_ERROR_BODY_BYTES) {
        await reader.cancel();
        return null;
      }
      chunks.push(value);
    }
  } catch {
    return null;
  }
  const bytes = new Uint8Array(size);
  let offset = 0;
  for (const chunk of chunks) {
    bytes.set(chunk, offset);
    offset += chunk.byteLength;
  }
  try {
    return JSON.parse(new TextDecoder().decode(bytes)) as unknown;
  } catch {
    return null;
  }
}

/** The credential admitted with the operation, and how the provider expects it. */
export interface MeetingNoteAiAdmittedCredential {
  scheme: 'x-api-key' | 'bearer';
  apiKey: string;
}

/**
 * Request headers the SDKs legitimately send besides the credential. Every
 * other header â€” including any credential-bearing one â€” is dropped.
 */
const ALLOWED_REQUEST_HEADERS: ReadonlySet<string> = new Set([
  'accept',
  'content-type',
  'user-agent',
  'anthropic-version',
  'x-stainless-arch',
  'x-stainless-helper-method',
  'x-stainless-lang',
  'x-stainless-os',
  'x-stainless-package-version',
  'x-stainless-retry-count',
  'x-stainless-runtime',
  'x-stainless-runtime-version',
  'x-stainless-timeout',
]);

function outgoingHeaders(source: HeadersInit | undefined, credential: MeetingNoteAiAdmittedCredential): Headers {
  const headers = new Headers();
  for (const [name, value] of new Headers(source)) {
    if (ALLOWED_REQUEST_HEADERS.has(name)) headers.set(name, value);
  }
  if (credential.scheme === 'x-api-key') headers.set('x-api-key', credential.apiKey);
  else headers.set('authorization', `Bearer ${credential.apiKey}`);
  return headers;
}

export function createDispatchFetch(
  state: MeetingNoteAiDispatchState,
  credential: MeetingNoteAiAdmittedCredential
): (input: FetchInput, init?: RequestInit) => Promise<Response> {
  return async (input, init) => {
    if (state.dispatched) throw new Error('Only one outbound request is allowed per meeting-note AI call.');
    // The SDKs pass a URL plus an init; a Request object would carry its own
    // headers past the allowlist, so it is refused before anything is sent.
    if (input instanceof Request) throw new Error('The meeting-note AI transport only accepts a URL.');
    if (init?.signal?.aborted) throw abortError();
    const guarded: RequestInit = { ...init, headers: outgoingHeaders(init?.headers, credential), redirect: 'manual' };
    state.dispatched = true;
    let response: Response;
    try {
      response = await fetch(input, guarded);
    } catch (err) {
      if (isUnreachableError(err)) state.unreachable = true;
      throw err;
    }
    state.initialStatus = response.status;
    if (!response.ok) state.initialErrorBody = await readBoundedJson(response.clone());
    return response;
  };
}

export interface MeetingNoteAiRequestControl {
  signal: AbortSignal;
  /** Why the request was aborted, if it was. */
  readonly reason: 'timeout' | 'cancelled' | null;
  dispose(): void;
}

export function createRequestControl(callerSignal: AbortSignal | undefined, timeoutMs: number): 
MeetingNoteAiRequestControl {
  const controller = new AbortController();
  let reason: 'timeout' | 'cancelled' | null = null;
  const onCallerAbort = () => {
    reason ??= 'cancelled';
    controller.abort();
  };
  if (callerSignal?.aborted) onCallerAbort();
  else callerSignal?.addEventListener('abort', onCallerAbort, { once: true });
  const timer = setTimeout(() => {
    reason ??= 'timeout';
    controller.abort();
  }, timeoutMs);
  return {
    signal: controller.signal,
    get reason() {
      return reason;
    },
    dispose() {
      clearTimeout(timer);
      callerSignal?.removeEventListener('abort', onCallerAbort);
    },
  };
}

/**
 * Maps anything thrown while sending or reading the response to a failure.
 * The decision uses only the dispatch state and the abort reason:
 *   not dispatched           â†’ never sent (cancelled before send / invalid configuration)
 *   connection refused / DNS â†’ never sent (provider unreachable)
 *   deadline / caller abort  â†’ counted timeout / cancellation
 *   initial non-2xx          â†’ matrix classification (listed â†’ refunded, else counted;
 *                              a 3xx redirect is never followed and is counted)
 *   initial 2xx              â†’ counted: the stream had begun (mid-stream error or drop)
 *   no response yet          â†’ counted: connection lost after the request was sent
 */
export function mapMeetingNoteAiTransportError(
  provider: MeetingNoteAiProvider,
  state: MeetingNoteAiDispatchState,
  control: MeetingNoteAiRequestControl
): MeetingNoteAiDraftFailure {
  if (!state.dispatched) {
    return control.reason
      ? meetingNoteAiFailure(provider, 'MEETING_NOTE_AI_CANCELLED_BEFORE_SEND', false)
      : meetingNoteAiFailure(provider, 'MEETING_NOTE_AI_CONFIGURATION_INVALID', false);
  }
  if (state.unreachable) return meetingNoteAiFailure(provider, 'MEETING_NOTE_AI_PROVIDER_UNREACHABLE', true);
  const status = state.initialStatus;
  if (status !== null && (status < 200 || status >= 300)) {
    const category = classifyMeetingNoteAiPreProcessingRejection(provider, status, state.initialErrorBody);
    return category
      ? meetingNoteAiRejectionFailure(provider, category, status)
      : meetingNoteAiFailure(provider, 'MEETING_NOTE_AI_PROVIDER_ERROR', true, { providerStatus: status });
  }
  if (control.reason === 'timeout') return meetingNoteAiFailure(provider, 'MEETING_NOTE_AI_TIMEOUT', true);
  if (control.reason === 'cancelled') return meetingNoteAiFailure(provider, 'MEETING_NOTE_AI_CANCELLED', true);
  if (status !== null) return meetingNoteAiFailure(provider, 'MEETING_NOTE_AI_STREAM_INTERRUPTED', true);
  return meetingNoteAiFailure(provider, 'MEETING_NOTE_AI_CONNECTION_LOST', true);
}

/**
 * Merges a capability-matrix wire fragment into a request body: plain-object
 * values are merged one level deep (Anthropic `output_config.effort` beside
 * `output_config.format`), anything else is set. The fragment holds only
 * documented provider fields, so the merged body keeps the base's type.
 */
export function mergeWireFragment<T extends object>(base: T, wire: Readonly<Record<string, unknown>>): T {
  const merged: Record<string, unknown> = { ...(base as Record<string, unknown>) };
  for (const [key, value] of Object.entries(wire)) {
    const current = merged[key];
    const isPlain = (v: unknown): v is Record<string, unknown> => v !== null && typeof v === 'object' && 
!Array.isArray(v);
    merged[key] = isPlain(current) && isPlain(value) ? { ...current, ...value } : value;
  }
  return merged as T;
}

/** What an adapter read from a stream that ended without throwing. */
export interface MeetingNoteAiStreamOutcome {
  /** Concatenated model text (thinking/reasoning content excluded). */
  text: string;
  /**
   * end: normal stop; length: output budget reached (truncated); refusal: the
   * model or a provider filter declined; incomplete: the stream ended without
   * its stop signal; other: any other stop reason.
   */
  finish: 'end' | 'length' | 'refusal' | 'incomplete' | 'other';
  usage: MeetingNoteAiUsageReport;
}

export interface MeetingNoteAiAdapterRequest {
  provider: MeetingNoteAiProvider;
  apiKey: string;
  baseUrl: string;
  model: MeetingNoteAiModelCapability;
  level: MeetingNoteAiReasoningLevel;
  transcript: string;
  fetch: (input: FetchInput, init?: RequestInit) => Promise<Response>;
  signal: AbortSignal;
  /** SDK header timeout; kept above the adapter deadline so the deadline decides. */
  sdkTimeoutMs: number;
}

