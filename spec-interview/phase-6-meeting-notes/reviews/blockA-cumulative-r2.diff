@@ -0,0 +1,156 @@
+// src/types/meeting-notes.ts
+// Phase 6 meeting notes: view and input shapes built on MeetingNote/ActionItem
+// (src/types/database.ts). Every user id is an application users.id.
+import type { ActionItem, MeetingNote, TimeStampType } from '@/types/database';
+
+/** A participant of a note: name snapshot plus whether they are still a member. */
+export interface MeetingNoteParticipant {
+  userId: string;
+  displayName: string;
+  /** false = "Former member" (left the company or was deleted). */
+  isCurrentMember: boolean;
+}
+
+/** An action item as shown in a note view. */
+export interface MeetingNoteActionItemView extends ActionItem {
+  /** null when unassigned; false = "Former member". */
+  assigneeIsCurrentMember: boolean | null;
+}
+
+/** The caller's rights on a note, evaluated on the state that was read. */
+export interface MeetingNoteRights {
+  canEdit: boolean;
+  canDelete: boolean;
+}
+
+/** Everything a note view needs (FR-005). */
+export interface MeetingNoteDetail extends MeetingNote {
+  /** Name of the note's space; null when the space was deleted ("Space removed"). */
+  spaceName: string | null;
+  participants: MeetingNoteParticipant[];
+  actionItems: MeetingNoteActionItemView[];
+  hasTranscript: boolean;
+  /** Stored transcript text; present only when the caller asked for it. */
+  transcript?: string | null;
+  rights: MeetingNoteRights;
+}
+
+/** A row of a note listing (no content, no transcript text). */
+export interface MeetingNoteListItem {
+  id: string;
+  roomId: string | null;
+  title: string;
+  meetingDate: TimeStampType;
+  authorUserId: string;
+  authorName: string;
+  hasSummary: boolean;
+  hasTranscript: boolean;
+  revision: number;
+  createdAt: TimeStampType;
+  updatedAt: TimeStampType;
+}
+
+/** The note field a search excerpt was taken from (FR-026). */
+export type MeetingNoteSearchField = 'content' | 'summary' | 'action_item' | 'title';
+
+/** A piece of excerpt text; `highlighted` marks a matched word. Render as text, never as HTML. */
+export interface MeetingNoteExcerptSegment {
+  text: string;
+  highlighted: boolean;
+}
+
+export interface MeetingNoteSearchExcerpt {
+  field: MeetingNoteSearchField;
+  segments: MeetingNoteExcerptSegment[];
+}
+
+/** A search hit: the listing row plus relevance and excerpt (both null in list mode, i.e. an empty query). */
+export interface MeetingNoteSearchResult extends MeetingNoteListItem {
+  relevance: number | null;
+  excerpt: MeetingNoteSearchExcerpt | null;
+}
+
+/** Search request (company of the caller is implied by the session). */
+export interface MeetingNoteSearchInput {
+  /** Websearch syntax; '' lists every note within the filters, newest meeting first. */
+  query: string;
+  /** Only notes of this space. Mutually exclusive with `spaceRemoved`. */
+  spaceId: string | null;
+  /** Only notes whose space was deleted ("Space removed"). */
+  spaceRemoved: boolean;
+  /** ISO 8601 date-time with offset; inclusive lower bound of the meeting date. */
+  meetingFrom: string | null;
+  /** ISO 8601 date-time with offset; exclusive upper bound of the meeting date. */
+  meetingTo: string | null;
+  /** 1..50. */
+  limit: number;
+  /** 0..10,000. */
+  offset: number;
+}
+
+/** A version in the history list (who and when). */
+export interface MeetingNoteVersionSummary {
+  id: string;
+  noteId: string;
+  revision: number;
+  title: string;
+  meetingDate: TimeStampType;
+  editorUserId: string;
+  editorName: string;
+  createdAt: TimeStampType;
+}
+
+/** A participant as recorded in a version (snapshot). */
+export interface MeetingNoteVersionParticipant {
+  userId: string;
+  displayName: string;
+}
+
+/** A full immutable version. */
+export interface MeetingNoteVersion extends MeetingNoteVersionSummary {
+  participants: MeetingNoteVersionParticipant[];
+  content: string;
+  summary: string | null;
+}
+
+/** Result of a note create/update/restore. */
+export interface MeetingNoteMutationResult {
+  noteId: string;
+  revision: number;
+  versionId: string;
+}
+
+/** The note fields an editor sets (content already sanitized). */
+export interface MeetingNoteFieldsInput {
+  title: string;
+  /** ISO 8601 date-time with offset. */
+  meetingDate: string;
+  content: string;
+  participantIds: string[];
+}
+
+export interface CreateMeetingNoteInput extends MeetingNoteFieldsInput {
+  roomId: string;
+}
+
+export interface UpdateMeetingNoteInput extends MeetingNoteFieldsInput {
+  noteId: string;
+  expectedRevision: number;
+}
+
+/** The action-item fields an editor sets. */
+export interface MeetingNoteActionItemFieldsInput {
+  description: string;
+  assigneeId: string | null;
+  /** 'YYYY-MM-DD' or null. */
+  dueDate: string | null;
+}
+
+export interface CreateMeetingNoteActionItemInput extends MeetingNoteActionItemFieldsInput {
+  noteId: string;
+}
+
+export interface UpdateMeetingNoteActionItemInput extends MeetingNoteActionItemFieldsInput {
+  itemId: string;
+  expectedRevision: number;
+}
diff --git a/supabase/migrations/20261013103447_meeting_notes_company_scope_and_history.sql b/supabase/migrations/20261013103447_meeting_notes_company_scope_and_history.sql
new file mode 100644
index 0000000..b124f5f
--- /dev/null
+++ b/supabase/migrations/20261013103447_meeting_notes_company_scope_and_history.sql
@@ -0,0 +1,512 @@
+-- Phase 6 T1 (spec-interview/phase-6-meeting-notes; FR-028, FR-029, FR-030,
+-- BR-001, BR-007; AC-020, AC-021, AC-023, AC-031): meeting-note schema, read
+-- isolation, and lifecycle contract.
+--
+-- Before this migration (baseline 20260610183000 / 20260610183139):
+--   * public.meeting_notes had no company, author, revision, content,
+--     participants, or versions; room_id was NOT NULL -> spaces ON DELETE
+--     CASCADE (deleting a space deleted its notes); summary was NOT NULL.
+--   * Both meeting-note SELECT policies joined through public.spaces, so a
+--     note without a space would become invisible to everyone.
+--
+-- After this migration:
+--   * public.meeting_notes carries
+--       - company_id (NOT NULL -> companies ON DELETE CASCADE): deleting a
+--         company deletes its notes; immutable for every role;
+--       - author_user_id + author_name: historical snapshots of the creating
+--         user's application users.id and display name; immutable, no FK, so
+--         they survive the user row;
+--       - created_by: the live reference to the author (-> users ON DELETE SET
+--         NULL); at INSERT it must equal author_user_id; afterwards it can
+--         only become NULL, and only once that user row no longer exists (the
+--         FK action of a user deletion), never by a client or process;
+--       - revision (bigint >= 1, never decreases), content (text, <= 100,000 chars, '' by
+--         default), transcript_id (identity of the stored transcript; present
+--         exactly when a transcript is stored);
+--       - room_id nullable -> spaces ON DELETE SET NULL: deleting a space keeps
+--         its notes (FR-028); a non-NULL room_id must be a space of the note's
+--         company;
+--       - summary optional (NULL = no summary; the non-empty check stays).
+--   * public.meeting_note_participants (note_id, user_id, display_name,
+--     sort_order 0..49): participants by application users.id (no FK, so a
+--     deleted user keeps their place) with a display-name snapshot; at most 50
+--     per note by construction (unique sort_order 0..49); identity and snapshot
+--     immutable, sort_order mutable.
+--   * public.meeting_note_versions: immutable snapshots (revision, title,
+--     meeting_date, participants as a JSON array of {user_id, display_name}
+--     with <= 50 entries, content, summary, editor_user_id + editor_name
+--     snapshots, created_at). The live editor reference edited_by (-> users ON
+--     DELETE SET NULL) is the only column that may change, and only to NULL
+--     after that user row is gone. A version can be deleted only by the
+--     cascade of its note's deletion (the note row is already gone).
+--   * RLS: every read of notes, participants, versions, and action items is
+--     scoped to the note's own company_id through
+--     private.is_company_member(company_id) (users.supabase_uid =
+--     auth.uid()::text and users.company_id = note.company_id); never through
+--     public.spaces. A user removed from the company (users.company_id
+--     cleared) loses read; the same users.id rejoining regains it.
+--   * Grants: anon holds nothing and authenticated holds SELECT only on the
+--     four tables; there is no client write path (write RPCs come in T17/T2).
+--     service_role keeps SELECT/INSERT/UPDATE/DELETE (no TRUNCATE, REFERENCES,
+--     TRIGGER on notes, participants, versions), and the guards below apply to
+--     every role, including service_role and postgres; a statement guard
+--     rejects TRUNCATE of notes, participants, and versions for every role
+--     (row triggers do not fire on TRUNCATE).
+--   * Trigger functions are owned by postgres, SECURITY DEFINER with
+--     search_path '', and EXECUTE is revoked from PUBLIC, anon, authenticated,
+--     and service_role (trigger functions need no EXECUTE grant to fire).
+--
+-- Legacy rows (SPEC §9 preflight): the migration REFUSES to run
+-- (MEETING_NOTES_LEGACY_ROWS_NEED_BACKFILL) when any existing meeting_notes row
+-- has no derivable company (room_id -> spaces.company_id) or no derivable
+-- author (edited_by -> an existing users row). Rows for which both are
+-- derivable are backfilled with company_id = the space's company, author =
+-- edited_by's users.id and display name (created_by = edited_by), revision 1,
+-- content '', and a fresh transcript_id when a transcript is stored; no version
+-- is created for them. The online preflight (T8/T15) decides whether any row
+-- exists; if so, the owner decides the backfill before this file is applied.
+-- The ACCESS EXCLUSIVE lock below is taken before the preflight count, so no
+-- row can be added between the count and the backfill.
+--
+-- Rollback (order: FIRST roll the application back to a build that does not
+-- use meeting notes — today no runtime caller exists — THEN run this SQL).
+-- It DROPS versions, participants, and the company/author/revision/content/
+-- transcript identity columns (their data is lost) and restores the original
+-- SELECT policies. It deliberately does NOT restore room_id NOT NULL or the
+-- spaces ON DELETE CASCADE (that would delete notes with their space; SPEC
+-- §9), nor summary NOT NULL (fails once a note has no summary):
+--   begin;
+--   set local lock_timeout = '5s';
+--   lock table public.meeting_notes, public.meeting_note_action_items in access exclusive mode;
+--   drop trigger if exists meeting_notes_guard on public.meeting_notes;
+--   drop trigger if exists meeting_note_participants_guard on public.meeting_note_participants;
+--   drop trigger if exists meeting_note_versions_guard on public.meeting_note_versions;
+--   drop trigger if exists meeting_notes_reject_truncate on public.meeting_notes;
+--   drop table if exists public.meeting_note_versions;
+--   drop table if exists public.meeting_note_participants;
+--   drop function if exists private.guard_meeting_note();
+--   drop function if exists private.guard_meeting_note_participant();
+--   drop function if exists private.guard_meeting_note_version();
+--   drop function if exists private.reject_meeting_note_truncate();
+--   grant truncate, references, trigger on table public.meeting_notes to service_role;
+--   drop policy if exists "meeting_notes_select_same_company" on public.meeting_notes;
+--   create policy "meeting_notes_select_same_company"
+--     on public.meeting_notes for select to authenticated
+--     using (exists (select 1 from public.spaces as s
+--                    where s.id = meeting_notes.room_id
+--                      and private.is_company_member(s.company_id)));
+--   drop policy if exists "meeting_note_action_items_select_same_company" on public.meeting_note_action_items;
+--   create policy "meeting_note_action_items_select_same_company"
+--     on public.meeting_note_action_items for select to authenticated
+--     using (exists (select 1 from public.meeting_notes as mn
+--                    join public.spaces as s on s.id = mn.room_id
+--                    where mn.id = meeting_note_action_items.note_id
+--                      and private.is_company_member(s.company_id)));
+--   drop index if exists public.idx_meeting_notes_company_meeting_date;
+--   drop index if exists public.idx_meeting_notes_created_by;
+--   drop index if exists public.idx_meeting_notes_edited_by;
+--   alter table public.meeting_notes
+--     drop constraint if exists meeting_notes_content_length_check,
+--     drop constraint if exists meeting_notes_transcript_identity_check,
+--     drop constraint if exists meeting_notes_revision_check,
+--     drop column if exists company_id,
+--     drop column if exists author_user_id,
+--     drop column if exists author_name,
+--     drop column if exists created_by,
+--     drop column if exists revision,
+--     drop column if exists content,
+--     drop column if exists transcript_id,
+--     alter column generated_by drop default;
+--   commit;
+
+begin;
+
+set local lock_timeout = '5s';
+
+-- Referenced tables first (the FK additions below need SHARE ROW EXCLUSIVE on
+-- them), then the note tables, so a concurrent user/space/company deletion
+-- either finishes before this migration or waits for it (no lock-order cycle).
+lock table public.companies, public.spaces, public.users in share row exclusive mode;
+lock table public.meeting_notes, public.meeting_note_action_items in access exclusive mode;
+
+-- SPEC §9 legacy-row preflight: refuse rather than invent a company/author.
+do $$
+declare
+  v_unresolvable bigint;
+begin
+  select count(*)
+  into v_unresolvable
+  from public.meeting_notes as n
+  left join public.spaces as s on s.id = n.room_id
+  left join public.users as u on u.id = n.edited_by
+  where s.company_id is null
+     or u.id is null;
+
+  if v_unresolvable > 0 then
+    raise exception 'MEETING_NOTES_LEGACY_ROWS_NEED_BACKFILL: % meeting_notes row(s) have no derivable company or author', v_unresolvable
+      using errcode = 'P0001',
+            hint = 'Owner backfill decision required before applying (SPEC section 9 preflight).';
+  end if;
+end;
+$$;
+
+-- ---------------------------------------------------------------------------
+-- meeting_notes: company, author, revision, content, transcript identity
+-- ---------------------------------------------------------------------------
+
+alter table public.meeting_notes
+  add column company_id uuid,
+  add column author_user_id uuid,
+  add column author_name text,
+  add column created_by uuid,
+  add column revision bigint not null default 1,
+  add column content text not null default '',
+  add column transcript_id uuid;
+
+update public.meeting_notes as n
+set company_id = s.company_id,
+    author_user_id = u.id,
+    author_name = u.display_name,
+    created_by = u.id,
+    transcript_id = case when n.transcript is not null then pg_catalog.gen_random_uuid() end
+from public.spaces as s, public.users as u
+where s.id = n.room_id
+  and u.id = n.edited_by;
+
+alter table public.meeting_notes
+  alter column company_id set not null,
+  alter column author_user_id set not null,
+  alter column author_name set not null,
+  alter column generated_by set default 'user'::public.note_generator,
+  alter column summary drop not null,
+  alter column room_id drop not null,
+  add constraint meeting_notes_company_id_fkey
+    foreign key (company_id) references public.companies (id) on delete cascade,
+  add constraint meeting_notes_created_by_fkey
+    foreign key (created_by) references public.users (id) on delete set null,
+  add constraint meeting_notes_revision_check check (revision >= 1),
+  add constraint meeting_notes_content_length_check
+    check (pg_catalog.char_length(content) <= 100000),
+  add constraint meeting_notes_transcript_identity_check
+    check ((transcript is null) = (transcript_id is null));
+
+-- Deleting a space keeps its notes (FR-028).
+alter table public.meeting_notes
+  drop constraint meeting_notes_room_id_fkey,
+  add constraint meeting_notes_room_id_fkey
+    foreign key (room_id) references public.spaces (id) on delete set null;
+
+comment on column public.meeting_notes.company_id is
+  'Owning company; immutable. Read access = users.company_id equal to this value.';
+comment on column public.meeting_notes.author_user_id is
+  'Historical snapshot of the author''s application users.id; immutable, survives the user row.';
+comment on column public.meeting_notes.author_name is
+  'Historical snapshot of the author''s display name at creation; immutable.';
+comment on column public.meeting_notes.created_by is
+  'Live reference to the author (users.id); equals author_user_id at creation; becomes NULL only when that user row is deleted.';
+comment on column public.meeting_notes.revision is
+  'Note revision; every accepted change requires the current value and increments it.';
+comment on column public.meeting_notes.transcript_id is
+  'Identity of the stored transcript; changes whenever the transcript is replaced; NULL when none is stored.';
+
+create index idx_meeting_notes_company_meeting_date
+  on public.meeting_notes (company_id, meeting_date desc, id);
+create index idx_meeting_notes_created_by
+  on public.meeting_notes (created_by) where created_by is not null;
+create index idx_meeting_notes_edited_by
+  on public.meeting_notes (edited_by) where edited_by is not null;
+
+-- ---------------------------------------------------------------------------
+-- Participants (current state; versioned through meeting_note_versions)
+-- ---------------------------------------------------------------------------
+
+create table public.meeting_note_participants (
+  note_id uuid not null references public.meeting_notes (id) on delete cascade,
+  user_id uuid not null,
+  display_name text not null,
+  sort_order smallint not null,
+  added_at timestamptz not null default pg_catalog.now(),
+  constraint meeting_note_participants_pkey primary key (note_id, user_id),
+  constraint meeting_note_participants_sort_order_key unique (note_id, sort_order),
+  constraint meeting_note_participants_sort_order_check check (sort_order between 0 and 49)
+);
+
+comment on table public.meeting_note_participants is
+  'Note participants by application users.id (no FK: a deleted or departed user keeps their place) with a display-name snapshot; at most 50 per note (sort_order 0..49).';
+
+create index idx_meeting_note_participants_user_id
+  on public.meeting_note_participants (user_id);
+
+-- ---------------------------------------------------------------------------
+-- Versions (insert-only history)
+-- ---------------------------------------------------------------------------
+
+create table public.meeting_note_versions (
+  id uuid not null default pg_catalog.gen_random_uuid(),
+  note_id uuid not null references public.meeting_notes (id) on delete cascade,
+  revision bigint not null,
+  title text not null,
+  meeting_date timestamptz not null,
+  participants jsonb not null default '[]'::jsonb,
+  content text not null default '',
+  summary text,
+  editor_user_id uuid not null,
+  editor_name text not null,
+  edited_by uuid references public.users (id) on delete set null,
+  created_at timestamptz not null default pg_catalog.now(),
+  constraint meeting_note_versions_pkey primary key (id),
+  constraint meeting_note_versions_note_revision_key unique (note_id, revision),
+  constraint meeting_note_versions_revision_check check (revision >= 1),
+  constraint meeting_note_versions_participants_check
+    check (pg_catalog.jsonb_typeof(participants) = 'array'
+           and pg_catalog.jsonb_array_length(participants) <= 50),
+  constraint meeting_note_versions_content_length_check
+    check (pg_catalog.char_length(content) <= 100000),
+  constraint meeting_note_versions_summary_not_empty_check
+    check (summary is null or summary <> '')
+);
+
+comment on table public.meeting_note_versions is
+  'Immutable note versions. Only edited_by (live editor reference) may change, to NULL, when that user row is deleted.';
+comment on column public.meeting_note_versions.editor_user_id is
+  'Historical snapshot of the editor''s application users.id; immutable.';
+comment on column public.meeting_note_versions.editor_name is
+  'Historical snapshot of the editor''s display name; immutable.';
+
+create index idx_meeting_note_versions_edited_by
+  on public.meeting_note_versions (edited_by) where edited_by is not null;
+
+-- ---------------------------------------------------------------------------
+-- Guards (every role, including service_role and postgres)
+-- ---------------------------------------------------------------------------
+
+create or replace function private.guard_meeting_note()
+returns trigger
+language plpgsql
+security definer
+set search_path = ''
+as $$
+begin
+  if tg_op = 'INSERT' then
+    if new.created_by is null or new.created_by <> new.author_user_id then
+      raise exception 'MEETING_NOTE_AUTHOR_MISMATCH' using errcode = '23514';
+    end if;
+  else
+    if new.id is distinct from old.id
+       or new.company_id is distinct from old.company_id
+       or new.author_user_id is distinct from old.author_user_id
+       or new.author_name is distinct from old.author_name
+       or new.created_at is distinct from old.created_at
+       or new.revision < old.revision then
+      raise exception 'MEETING_NOTE_IMMUTABLE_FIELD' using errcode = '42501';
+    end if;
+
+    -- The live author reference only ever becomes NULL, and only after the
+    -- user row is gone (the ON DELETE SET NULL action of a user deletion).
+    if new.created_by is distinct from old.created_by
+       and (new.created_by is not null
+            or exists (select 1 from public.users as u where u.id = old.created_by)) then
+      raise exception 'MEETING_NOTE_IMMUTABLE_FIELD' using errcode = '42501';
+    end if;
+  end if;
+
+  if new.room_id is not null
+     and (tg_op = 'INSERT' or new.room_id is distinct from old.room_id)
+     and not exists (
+       select 1
+       from public.spaces as s
+       where s.id = new.room_id
+         and s.company_id = new.company_id
+     ) then
+    raise exception 'MEETING_NOTE_SPACE_OUTSIDE_COMPANY' using errcode = '23514';
+  end if;
+
+  return new;
+end;
+$$;
+
+create or replace function private.guard_meeting_note_participant()
+returns trigger
+language plpgsql
+security definer
+set search_path = ''
+as $$
+begin
+  if new.note_id is distinct from old.note_id
+     or new.user_id is distinct from old.user_id
+     or new.display_name is distinct from old.display_name
+     or new.added_at is distinct from old.added_at then
+    raise exception 'MEETING_NOTE_PARTICIPANT_IMMUTABLE_FIELD' using errcode = '42501';
+  end if;
+  return new;
+end;
+$$;
+
+create or replace function private.guard_meeting_note_version()
+returns trigger
+language plpgsql
+security definer
+set search_path = ''
+as $$
+begin
+  if tg_op = 'INSERT' then
+    if new.edited_by is null or new.edited_by <> new.editor_user_id then
+      raise exception 'MEETING_NOTE_VERSION_EDITOR_MISMATCH' using errcode = '23514';
+    end if;
+    return new;
+  end if;
+
+  if tg_op = 'DELETE' then
+    -- Only the cascade of the note's own deletion (note row already gone).
+    if exists (select 1 from public.meeting_notes as n where n.id = old.note_id) then
+      raise exception 'MEETING_NOTE_VERSION_IMMUTABLE' using errcode = '42501';
+    end if;
+    return old;
+  end if;
+
+  if new.id is distinct from old.id
+     or new.note_id is distinct from old.note_id
+     or new.revision is distinct from old.revision
+     or new.title is distinct from old.title
+     or new.meeting_date is distinct from old.meeting_date
+     or new.participants is distinct from old.participants
+     or new.content is distinct from old.content
+     or new.summary is distinct from old.summary
+     or new.editor_user_id is distinct from old.editor_user_id
+     or new.editor_name is distinct from old.editor_name
+     or new.created_at is distinct from old.created_at then
+    raise exception 'MEETING_NOTE_VERSION_IMMUTABLE' using errcode = '42501';
+  end if;
+
+  if new.edited_by is distinct from old.edited_by
+     and (new.edited_by is not null
+          or exists (select 1 from public.users as u where u.id = old.edited_by)) then
+    raise exception 'MEETING_NOTE_VERSION_IMMUTABLE' using errcode = '42501';
+  end if;
+
+  return new;
+end;
+$$;
+
+-- Row triggers do not fire on TRUNCATE; this statement guard keeps history
+-- (and the notes it belongs to) from being wiped in bulk by any role.
+create or replace function private.reject_meeting_note_truncate()
+returns trigger
+language plpgsql
+security definer
+set search_path = ''
+as $$
+begin
+  raise exception 'MEETING_NOTE_TRUNCATE_FORBIDDEN' using errcode = '42501';
+end;
+$$;
+
+alter function private.guard_meeting_note() owner to postgres;
+alter function private.reject_meeting_note_truncate() owner to postgres;
+alter function private.guard_meeting_note_participant() owner to postgres;
+alter function private.guard_meeting_note_version() owner to postgres;
+
+revoke all on function private.guard_meeting_note() from public, anon, authenticated, service_role;
+revoke all on function private.guard_meeting_note_participant() from public, anon, authenticated, service_role;
+revoke all on function private.guard_meeting_note_version() from public, anon, authenticated, service_role;
+revoke all on function private.reject_meeting_note_truncate() from public, anon, authenticated, service_role;
+
+create trigger meeting_notes_guard
+  before insert or update on public.meeting_notes
+  for each row execute function private.guard_meeting_note();
+
+create trigger meeting_note_participants_guard
+  before update on public.meeting_note_participants
+  for each row execute function private.guard_meeting_note_participant();
+
+create trigger meeting_note_versions_guard
+  before insert or update or delete on public.meeting_note_versions
+  for each row execute function private.guard_meeting_note_version();
+
+create trigger meeting_notes_reject_truncate
+  before truncate on public.meeting_notes
+  for each statement execute function private.reject_meeting_note_truncate();
+
+create trigger meeting_note_participants_reject_truncate
+  before truncate on public.meeting_note_participants
+  for each statement execute function private.reject_meeting_note_truncate();
+
+create trigger meeting_note_versions_reject_truncate
+  before truncate on public.meeting_note_versions
+  for each statement execute function private.reject_meeting_note_truncate();
+
+-- ---------------------------------------------------------------------------
+-- Grants: no client writes; authenticated reads under RLS
+-- ---------------------------------------------------------------------------
+
+alter table public.meeting_note_participants enable row level security;
+alter table public.meeting_note_versions enable row level security;
+
+revoke all on table public.meeting_notes from public, anon, authenticated;
+revoke all on table public.meeting_note_action_items from public, anon, authenticated;
+revoke all on table public.meeting_note_participants from public, anon, authenticated;
+revoke all on table public.meeting_note_versions from public, anon, authenticated;
+
+grant select on table public.meeting_notes to authenticated;
+grant select on table public.meeting_note_action_items to authenticated;
+grant select on table public.meeting_note_participants to authenticated;
+grant select on table public.meeting_note_versions to authenticated;
+
+grant select, insert, update, delete on table public.meeting_note_participants to service_role;
+grant select, insert, update, delete on table public.meeting_note_versions to service_role;
+revoke truncate, references, trigger on table public.meeting_notes from service_role;
+revoke truncate, references, trigger on table public.meeting_note_participants from service_role;
+revoke truncate, references, trigger on table public.meeting_note_versions from service_role;
+
+-- ---------------------------------------------------------------------------
+-- RLS: company scope from the note's own company_id (never through spaces)
+-- ---------------------------------------------------------------------------
+
+drop policy if exists "meeting_notes_select_same_company" on public.meeting_notes;
+create policy "meeting_notes_select_same_company"
+  on public.meeting_notes
+  for select
+  to authenticated
+  using (private.is_company_member(company_id));
+
+drop policy if exists "meeting_note_action_items_select_same_company" on public.meeting_note_action_items;
+create policy "meeting_note_action_items_select_same_company"
+  on public.meeting_note_action_items
+  for select
+  to authenticated
+  using (
+    exists (
+      select 1
+      from public.meeting_notes as mn
+      where mn.id = meeting_note_action_items.note_id
+        and private.is_company_member(mn.company_id)
+    )
+  );
+
+create policy "meeting_note_participants_select_same_company"
+  on public.meeting_note_participants
+  for select
+  to authenticated
+  using (
+    exists (
+      select 1
+      from public.meeting_notes as mn
+      where mn.id = meeting_note_participants.note_id
+        and private.is_company_member(mn.company_id)
+    )
+  );
+
+create policy "meeting_note_versions_select_same_company"
+  on public.meeting_note_versions
+  for select
+  to authenticated
+  using (
+    exists (
+      select 1
+      from public.meeting_notes as mn
+      where mn.id = meeting_note_versions.note_id
+        and private.is_company_member(mn.company_id)
+    )
+  );
+
+commit;
diff --git a/supabase/migrations/20261013105021_meeting_notes_mutation_rpcs.sql b/supabase/migrations/20261013105021_meeting_notes_mutation_rpcs.sql
new file mode 100644
index 0000000..61c4649
--- /dev/null
+++ b/supabase/migrations/20261013105021_meeting_notes_mutation_rpcs.sql
@@ -0,0 +1,640 @@
+-- Phase 6 T17 (spec-interview/phase-6-meeting-notes; FR-001, FR-006..FR-010,
+-- FR-030, BR-002, BR-003, BR-004, BR-011; AC-002, AC-004..AC-007, AC-021):
+-- the only client write path for meeting notes, their participants, and their
+-- versions.
+--
+-- Before this migration (T1, 20261013103447): authenticated holds SELECT only
+-- on the note tables; nothing lets a client create, change, restore, or delete
+-- a note.
+--
+-- After this migration, four RPCs, each SECURITY DEFINER, owner postgres,
+-- search_path '', EXECUTE granted to authenticated only (REVOKE ALL from
+-- PUBLIC, anon, authenticated, service_role first):
+--   * public.create_meeting_note(p_room_id uuid, p_title text,
+--       p_meeting_date timestamptz, p_content text, p_participant_ids uuid[])
+--       -> jsonb {note_id, revision: 1, version_id}
+--     Any member of the space's company (private spaces included). The note's
+--     company is the space's company; author id/name snapshots, created_by,
+--     and edited_by come from the caller's users row. Participants must be
+--     current members of that company. Creates version 1.
+--   * public.update_meeting_note(p_note_id uuid, p_expected_revision bigint,
+--       p_title text, p_meeting_date timestamptz, p_content text,
+--       p_participant_ids uuid[]) -> jsonb {note_id, revision, version_id}
+--     Full desired state of title, meeting date, content, and the ordered
+--     participant list (summary, transcript, space, and items are unchanged).
+--     A listed person must be a current company member or already a
+--     participant of the note (a former member may be retained, never added).
+--   * public.restore_meeting_note_version(p_note_id uuid,
+--       p_expected_revision bigint, p_version_id uuid)
+--       -> jsonb {note_id, revision, version_id}
+--     Applies the version's title, meeting date, participants (with their
+--     snapshot names), content, and summary; action items and the transcript
+--     are untouched.
+--   * public.delete_meeting_note(p_note_id uuid, p_expected_revision bigint)
+--       -> jsonb {note_id, deleted: true}
+--     Deletes the note; versions, participants, and action items go by the
+--     ON DELETE CASCADE of their note_id FKs; the transcript is a note column.
+--
+-- Caller: users.supabase_uid = auth.uid()::text -> users.id. Membership:
+-- users.company_id = note.company_id. Rights (BR-003) are evaluated on the
+-- locked pre-change state: edit/restore = author (author_user_id) or current
+-- participant or company admin (users.role = 'admin'), each while a member;
+-- delete = author or company admin, while a member. Every update, restore,
+-- and delete requires p_expected_revision = the note's current revision and
+-- bumps it by one (except delete); create/update/restore insert exactly one
+-- version for the new revision, in the same transaction.
+--
+-- Lock order (PLAN lock order rule): the caller's users row FOR KEY SHARE
+-- (the lock a version/note FK check takes anyway), then (create) the space row
+-- FOR KEY SHARE or (update/restore/delete) the note row FOR UPDATE, then
+-- participants and versions. The users lock comes first so the product
+-- member-removal and role-change RPCs, which lock users FOR UPDATE before
+-- companies and spaces, can never interleave into a cycle, and it makes those
+-- RPCs wait for the note change (or the note change wait for them), so the
+-- rights read under the lock hold for the whole call against them. KEY SHARE,
+-- not SHARE, on purpose: it does not conflict with the NO KEY UPDATE of
+-- presence writes to the caller's row (last_active, current_space_id), which
+-- may hold space locks; a SHARE lock here could close a cycle with them. A raw
+-- UPDATE of users.company_id/role (not a product path; service-role
+-- membership updates are rejected by presence_block_service_role_membership_update)
+-- is not blocked by it. A caller outside the note's company is rejected
+-- before any note lock.
+--
+-- Accepted races (no rights are gained): a person newly listed as a
+-- participant whose removal from the company commits during the call ends up
+-- listed as a former member, the same state as a removal one moment later.
+-- Restore reproduces the version's participants exactly (FR-009, AC-006),
+-- including people who have since left the company; they stay former members
+-- with no access, because every right requires current membership.
+--
+-- Errors (message token, SQLSTATE):
+--   MEETING_NOTE_NOT_FOUND (P0002): no such note, or the caller is not a
+--     current member of its company (other companies' notes are
+--     indistinguishable from missing ones; cross-company admins included).
+--   MEETING_NOTE_FORBIDDEN (42501): the caller is a member but lacks the edit
+--     (update/restore) or delete right, or (create) has no users row/company.
+--   MEETING_NOTE_STALE_REVISION (P0001): p_expected_revision differs from the
+--     current revision; DETAIL is {"current_revision": N}. Nothing changes.
+--   MEETING_NOTE_SPACE_NOT_FOUND (P0002): create with a space that does not
+--     exist or is not in the caller's company.
+--   MEETING_NOTE_VERSION_NOT_FOUND (P0002): restore of a version that is not
+--     a version of that note.
+--   22023 limit/shape violations: MEETING_NOTE_TITLE_INVALID (blank or > 200
+--     chars), MEETING_NOTE_DATE_REQUIRED, MEETING_NOTE_CONTENT_TOO_LONG
+--     (> 100,000 chars), MEETING_NOTE_CONTENT_REQUIRED (NULL; '' is an
+--     empty note), MEETING_NOTE_TOO_MANY_PARTICIPANTS (> 50),
+--     MEETING_NOTE_PARTICIPANTS_INVALID (NULL list, NULL or duplicate entries),
+--     MEETING_NOTE_PARTICIPANT_NOT_MEMBER (a newly listed person who is not a
+--     current member of the note's company), MEETING_NOTE_REVISION_REQUIRED.
+--   Any error rolls the whole call back: nothing is stored.
+--
+-- Defense in depth for every role (service_role and postgres included):
+-- meeting_notes.title and meeting_note_versions.title must be 1-200 chars and
+-- not blank. The meeting_notes check is NOT VALID so a legacy row (SPEC §9)
+-- does not block the migration; it applies to every new or changed row.
+--
+-- Rollback (order: FIRST roll the application back to a build that does not
+-- call these RPCs, THEN run this SQL; no data is lost — notes, participants,
+-- and versions written through the RPCs stay):
+--   begin;
+--   drop function if exists public.create_meeting_note(uuid, text, timestamptz, text, uuid[]);
+--   drop function if exists public.update_meeting_note(uuid, bigint, text, timestamptz, text, uuid[]);
+--   drop function if exists public.restore_meeting_note_version(uuid, bigint, uuid);
+--   drop function if exists public.delete_meeting_note(uuid, bigint);
+--   drop function if exists private.meeting_note_lock_caller();
+--   drop function if exists private.meeting_note_authorize(uuid, bigint, text);
+--   drop function if exists private.meeting_note_validate_fields(text, timestamptz, text);
+--   drop function if exists private.meeting_note_replace_participants(uuid, uuid, uuid[]);
+--   drop function if exists private.meeting_note_write_participants(uuid, jsonb);
+--   drop function if exists private.meeting_note_insert_version(uuid, uuid, text);
+--   alter table public.meeting_notes drop constraint if exists meeting_notes_title_length_check;
+--   alter table public.meeting_note_versions drop constraint if exists meeting_note_versions_title_length_check;
+--   commit;
+
+begin;
+
+set local lock_timeout = '5s';
+
+-- ---------------------------------------------------------------------------
+-- Title limits for every role
+-- ---------------------------------------------------------------------------
+
+alter table public.meeting_notes
+  drop constraint if exists meeting_notes_title_length_check,
+  add constraint meeting_notes_title_length_check
+    check (pg_catalog.char_length(title) between 1 and 200 and pg_catalog.btrim(title) <> '')
+    not valid;
+
+alter table public.meeting_note_versions
+  drop constraint if exists meeting_note_versions_title_length_check,
+  add constraint meeting_note_versions_title_length_check
+    check (pg_catalog.char_length(title) between 1 and 200 and pg_catalog.btrim(title) <> '');
+
+-- ---------------------------------------------------------------------------
+-- Internal helpers (no EXECUTE for any client or server role)
+-- ---------------------------------------------------------------------------
+
+-- The caller's users row, locked FOR KEY SHARE (first lock of every note
+-- mutation). All OUT values are NULL when auth.uid() has no users row.
+create or replace function private.meeting_note_lock_caller(
+  out caller_id uuid,
+  out caller_company_id uuid,
+  out caller_is_admin boolean,
+  out caller_name text
+)
+language plpgsql
+volatile
+security definer
+set search_path = ''
+as $$
+declare
+  v_uid text := (select auth.uid())::text;
+begin
+  if v_uid is null then
+    return;
+  end if;
+
+  select u.id, u.company_id, (u.role = 'admin'::public.user_role), u.display_name
+  into caller_id, caller_company_id, caller_is_admin, caller_name
+  from public.users as u
+  where u.supabase_uid = v_uid
+  for key share;
+end;
+$$;
+
+create or replace function private.meeting_note_validate_fields(
+  p_title text,
+  p_meeting_date timestamptz,
+  p_content text
+)
+returns void
+language plpgsql
+stable
+security definer
+set search_path = ''
+as $$
+begin
+  if p_title is null
+     or pg_catalog.btrim(p_title) = ''
+     or pg_catalog.char_length(p_title) > 200 then
+    raise exception 'MEETING_NOTE_TITLE_INVALID' using errcode = '22023';
+  end if;
+  if p_meeting_date is null then
+    raise exception 'MEETING_NOTE_DATE_REQUIRED' using errcode = '22023';
+  end if;
+  if p_content is null then
+    raise exception 'MEETING_NOTE_CONTENT_REQUIRED' using errcode = '22023';
+  end if;
+  if pg_catalog.char_length(p_content) > 100000 then
+    raise exception 'MEETING_NOTE_CONTENT_TOO_LONG' using errcode = '22023';
+  end if;
+end;
+$$;
+
+-- Locks the caller then the note (lock order rule) and authorizes p_action
+-- ('edit' | 'delete') on the locked pre-change state, then checks the
+-- revision. Returns the caller's id and name snapshot and the note company.
+create or replace function private.meeting_note_authorize(
+  p_note_id uuid,
+  p_expected_revision bigint,
+  p_action text,
+  out caller_id uuid,
+  out caller_name text,
+  out note_company_id uuid
+)
+language plpgsql
+volatile
+security definer
+set search_path = ''
+as $$
+declare
+  v_caller record;
+  v_note record;
+  v_allowed boolean;
+begin
+  if p_action is null or p_action not in ('edit', 'delete') then
+    raise exception 'meeting_note_authorize: unknown action' using errcode = '22023';
+  end if;
+  if p_expected_revision is null then
+    raise exception 'MEETING_NOTE_REVISION_REQUIRED' using errcode = '22023';
+  end if;
+
+  select * into v_caller from private.meeting_note_lock_caller();
+  if p_note_id is null or v_caller.caller_id is null or v_caller.caller_company_id is null then
+    raise exception 'MEETING_NOTE_NOT_FOUND' using errcode = 'P0002';
+  end if;
+
+  -- Outsiders never take the note lock: the company check runs on an
+  -- unlocked read first (company_id is immutable, so it cannot go stale).
+  if not exists (
+    select 1
+    from public.meeting_notes as n
+    where n.id = p_note_id
+      and n.company_id = v_caller.caller_company_id
+  ) then
+    raise exception 'MEETING_NOTE_NOT_FOUND' using errcode = 'P0002';
+  end if;
+
+  select n.id, n.company_id, n.author_user_id, n.revision
+  into v_note
+  from public.meeting_notes as n
+  where n.id = p_note_id
+  for update;
+
+  if not found then
+    -- Deleted by a transaction that committed while this one waited.
+    raise exception 'MEETING_NOTE_NOT_FOUND' using errcode = 'P0002';
+  end if;
+
+  v_allowed := v_note.author_user_id = v_caller.caller_id or v_caller.caller_is_admin;
+  if not v_allowed and p_action = 'edit' then
+    v_allowed := exists (
+      select 1
+      from public.meeting_note_participants as p
+      where p.note_id = v_note.id
+        and p.user_id = v_caller.caller_id
+    );
+  end if;
+  if not v_allowed then
+    raise exception 'MEETING_NOTE_FORBIDDEN' using errcode = '42501';
+  end if;
+
+  if v_note.revision <> p_expected_revision then
+    raise exception 'MEETING_NOTE_STALE_REVISION'
+      using errcode = 'P0001',
+            detail = pg_catalog.format('{"current_revision": %s}', v_note.revision);
+  end if;
+
+  caller_id := v_caller.caller_id;
+  caller_name := v_caller.caller_name;
+  note_company_id := v_note.company_id;
+end;
+$$;
+
+-- Rewrites the note's participant rows from p_rows, a JSON array of
+-- {user_id, display_name, added_at} in order. sort_order is unique per note
+-- and not deferrable, and identity/snapshot columns are immutable, so the
+-- list is rewritten by delete + insert (sort_order = array position).
+create or replace function private.meeting_note_write_participants(
+  p_note_id uuid,
+  p_rows jsonb
+)
+returns void
+language plpgsql
+volatile
+security definer
+set search_path = ''
+as $$
+begin
+  delete from public.meeting_note_participants as p
+  where p.note_id = p_note_id;
+
+  insert into public.meeting_note_participants (note_id, user_id, display_name, sort_order, added_at)
+  select p_note_id,
+         (e.item ->> 'user_id')::uuid,
+         e.item ->> 'display_name',
+         (e.ord - 1)::smallint,
+         (e.item ->> 'added_at')::timestamptz
+  from pg_catalog.jsonb_array_elements(p_rows) with ordinality as e(item, ord);
+end;
+$$;
+
+-- Replaces the note's participant list with p_user_ids in order. A listed
+-- person must already be a participant of the note (kept with their
+-- snapshot, even as a former member) or be a current member of p_company_id
+-- (snapshot = current display name, added_at = now).
+create or replace function private.meeting_note_replace_participants(
+  p_note_id uuid,
+  p_company_id uuid,
+  p_user_ids uuid[]
+)
+returns void
+language plpgsql
+volatile
+security definer
+set search_path = ''
+as $$
+declare
+  v_ids uuid[] := p_user_ids;
+  v_resolved jsonb;
+begin
+  if v_ids is null then
+    raise exception 'MEETING_NOTE_PARTICIPANTS_INVALID' using errcode = '22023';
+  end if;
+  if pg_catalog.cardinality(v_ids) > 50 then
+    raise exception 'MEETING_NOTE_TOO_MANY_PARTICIPANTS' using errcode = '22023';
+  end if;
+  if pg_catalog.array_position(v_ids, null) is not null
+     or (select pg_catalog.count(distinct t.id) from pg_catalog.unnest(v_ids) as t(id))
+        <> pg_catalog.cardinality(v_ids) then
+    raise exception 'MEETING_NOTE_PARTICIPANTS_INVALID' using errcode = '22023';
+  end if;
+
+  select coalesce(
+           pg_catalog.jsonb_agg(
+             pg_catalog.jsonb_build_object(
+               'user_id', r.id,
+               'display_name', coalesce(p.display_name, u.display_name),
+               'added_at', coalesce(p.added_at, pg_catalog.now()),
+               'allowed', (p.user_id is not null or u.id is not null)
+             )
+             order by r.ord
+           ),
+           '[]'::jsonb
+         )
+  into v_resolved
+  from pg_catalog.unnest(v_ids) with ordinality as r(id, ord)
+  left join public.meeting_note_participants as p
+    on p.note_id = p_note_id
+   and p.user_id = r.id
+  left join public.users as u
+    on u.id = r.id
+   and u.company_id = p_company_id;
+
+  if exists (
+    select 1
+    from pg_catalog.jsonb_array_elements(v_resolved) as e(item)
+    where not (e.item ->> 'allowed')::boolean
+  ) then
+    raise exception 'MEETING_NOTE_PARTICIPANT_NOT_MEMBER' using errcode = '22023';
+  end if;
+
+  perform private.meeting_note_write_participants(p_note_id, v_resolved);
+end;
+$$;
+
+-- Inserts the immutable version of the note's current state (its current
+-- revision) with the editor's id and name snapshots; returns the version id.
+create or replace function private.meeting_note_insert_version(
+  p_note_id uuid,
+  p_editor_id uuid,
+  p_editor_name text
+)
+returns uuid
+language plpgsql
+volatile
+security definer
+set search_path = ''
+as $$
+declare
+  v_version_id uuid;
+begin
+  insert into public.meeting_note_versions
+    (note_id, revision, title, meeting_date, participants, content, summary,
+     editor_user_id, editor_name, edited_by)
+  select n.id,
+         n.revision,
+         n.title,
+         n.meeting_date,
+         coalesce(
+           (select pg_catalog.jsonb_agg(
+                     pg_catalog.jsonb_build_object('user_id', p.user_id, 'display_name', p.display_name)
+                     order by p.sort_order)
+            from public.meeting_note_participants as p
+            where p.note_id = n.id),
+           '[]'::jsonb
+         ),
+         n.content,
+         n.summary,
+         p_editor_id,
+         p_editor_name,
+         p_editor_id
+  from public.meeting_notes as n
+  where n.id = p_note_id
+  returning id into v_version_id;
+
+  if v_version_id is null then
+    raise exception 'MEETING_NOTE_NOT_FOUND' using errcode = 'P0002';
+  end if;
+  return v_version_id;
+end;
+$$;
+
+-- ---------------------------------------------------------------------------
+-- RPCs (authenticated only)
+-- ---------------------------------------------------------------------------
+
+create or replace function public.create_meeting_note(
+  p_room_id uuid,
+  p_title text,
+  p_meeting_date timestamptz,
+  p_content text,
+  p_participant_ids uuid[]
+)
+returns jsonb
+language plpgsql
+volatile
+security definer
+set search_path = ''
+as $$
+declare
+  v_caller record;
+  v_note_id uuid;
+  v_version_id uuid;
+begin
+  perform private.meeting_note_validate_fields(p_title, p_meeting_date, p_content);
+
+  select * into v_caller from private.meeting_note_lock_caller();
+  if v_caller.caller_id is null or v_caller.caller_company_id is null then
+    raise exception 'MEETING_NOTE_FORBIDDEN' using errcode = '42501';
+  end if;
+
+  -- FOR KEY SHARE: a concurrent space deletion waits for this note instead of
+  -- turning the insert into a raw FK error.
+  perform 1
+  from public.spaces as s
+  where s.id = p_room_id
+    and s.company_id = v_caller.caller_company_id
+  for key share;
+  if p_room_id is null or not found then
+    raise exception 'MEETING_NOTE_SPACE_NOT_FOUND' using errcode = 'P0002';
+  end if;
+
+  insert into public.meeting_notes
+    (company_id, room_id, title, meeting_date, content, summary, generated_by,
+     author_user_id, author_name, created_by, edited_by, revision)
+  values
+    (v_caller.caller_company_id, p_room_id, p_title, p_meeting_date,
+     p_content, null, 'user'::public.note_generator,
+     v_caller.caller_id, v_caller.caller_name, v_caller.caller_id, v_caller.caller_id, 1)
+  returning id into v_note_id;
+
+  perform private.meeting_note_replace_participants(v_note_id, v_caller.caller_company_id, p_participant_ids);
+  v_version_id := private.meeting_note_insert_version(v_note_id, v_caller.caller_id, v_caller.caller_name);
+
+  return pg_catalog.jsonb_build_object('note_id', v_note_id, 'revision', 1, 'version_id', v_version_id);
+end;
+$$;
+
+create or replace function public.update_meeting_note(
+  p_note_id uuid,
+  p_expected_revision bigint,
+  p_title text,
+  p_meeting_date timestamptz,
+  p_content text,
+  p_participant_ids uuid[]
+)
+returns jsonb
+language plpgsql
+volatile
+security definer
+set search_path = ''
+as $$
+declare
+  v_auth record;
+  v_revision bigint;
+  v_version_id uuid;
+begin
+  perform private.meeting_note_validate_fields(p_title, p_meeting_date, p_content);
+  select * into v_auth from private.meeting_note_authorize(p_note_id, p_expected_revision, 'edit');
+
+  perform private.meeting_note_replace_participants(p_note_id, v_auth.note_company_id, p_participant_ids);
+
+  update public.meeting_notes as n
+  set title = p_title,
+      meeting_date = p_meeting_date,
+      content = p_content,
+      revision = n.revision + 1,
+      edited_by = v_auth.caller_id,
+      updated_at = pg_catalog.now()
+  where n.id = p_note_id
+  returning n.revision into v_revision;
+
+  v_version_id := private.meeting_note_insert_version(p_note_id, v_auth.caller_id, v_auth.caller_name);
+  return pg_catalog.jsonb_build_object('note_id', p_note_id, 'revision', v_revision, 'version_id', v_version_id);
+end;
+$$;
+
+create or replace function public.restore_meeting_note_version(
+  p_note_id uuid,
+  p_expected_revision bigint,
+  p_version_id uuid
+)
+returns jsonb
+language plpgsql
+volatile
+security definer
+set search_path = ''
+as $$
+declare
+  v_auth record;
+  v_version record;
+  v_rows jsonb;
+  v_revision bigint;
+  v_version_id uuid;
+begin
+  select * into v_auth from private.meeting_note_authorize(p_note_id, p_expected_revision, 'edit');
+
+  select v.title, v.meeting_date, v.participants, v.content, v.summary
+  into v_version
+  from public.meeting_note_versions as v
+  where v.id = p_version_id
+    and v.note_id = p_note_id;
+
+  if not found then
+    raise exception 'MEETING_NOTE_VERSION_NOT_FOUND' using errcode = 'P0002';
+  end if;
+
+  -- The version's participant list in its order, with the version's snapshot
+  -- names (former members included: they were already on the note); a person
+  -- still on the note keeps their original added_at.
+  select coalesce(
+           pg_catalog.jsonb_agg(
+             pg_catalog.jsonb_build_object(
+               'user_id', e.item ->> 'user_id',
+               'display_name', e.item ->> 'display_name',
+               'added_at', coalesce(p.added_at, pg_catalog.now())
+             )
+             order by e.ord
+           ),
+           '[]'::jsonb
+         )
+  into v_rows
+  from pg_catalog.jsonb_array_elements(v_version.participants) with ordinality as e(item, ord)
+  left join public.meeting_note_participants as p
+    on p.note_id = p_note_id
+   and p.user_id = (e.item ->> 'user_id')::uuid;
+
+  perform private.meeting_note_write_participants(p_note_id, v_rows);
+
+  update public.meeting_notes as n
+  set title = v_version.title,
+      meeting_date = v_version.meeting_date,
+      content = v_version.content,
+      summary = v_version.summary,
+      revision = n.revision + 1,
+      edited_by = v_auth.caller_id,
+      updated_at = pg_catalog.now()
+  where n.id = p_note_id
+  returning n.revision into v_revision;
+
+  v_version_id := private.meeting_note_insert_version(p_note_id, v_auth.caller_id, v_auth.caller_name);
+  return pg_catalog.jsonb_build_object('note_id', p_note_id, 'revision', v_revision, 'version_id', v_version_id);
+end;
+$$;
+
+create or replace function public.delete_meeting_note(
+  p_note_id uuid,
+  p_expected_revision bigint
+)
+returns jsonb
+language plpgsql
+volatile
+security definer
+set search_path = ''
+as $$
+declare
+  v_auth record;
+begin
+  select * into v_auth from private.meeting_note_authorize(p_note_id, p_expected_revision, 'delete');
+
+  -- Versions, participants, and action items go by their ON DELETE CASCADE
+  -- note_id FKs; the transcript is a column of the note row.
+  delete from public.meeting_notes as n
+  where n.id = p_note_id;
+
+  return pg_catalog.jsonb_build_object('note_id', p_note_id, 'deleted', true);
+end;
+$$;
+
+-- ---------------------------------------------------------------------------
+-- Ownership, comments, and EXECUTE privileges
+-- ---------------------------------------------------------------------------
+
+alter function private.meeting_note_lock_caller() owner to postgres;
+alter function private.meeting_note_validate_fields(text, timestamptz, text) owner to postgres;
+alter function private.meeting_note_authorize(uuid, bigint, text) owner to postgres;
+alter function private.meeting_note_replace_participants(uuid, uuid, uuid[]) owner to postgres;
+alter function private.meeting_note_write_participants(uuid, jsonb) owner to postgres;
+alter function private.meeting_note_insert_version(uuid, uuid, text) owner to postgres;
+alter function public.create_meeting_note(uuid, text, timestamptz, text, uuid[]) owner to postgres;
+alter function public.update_meeting_note(uuid, bigint, text, timestamptz, text, uuid[]) owner to postgres;
+alter function public.restore_meeting_note_version(uuid, bigint, uuid) owner to postgres;
+alter function public.delete_meeting_note(uuid, bigint) owner to postgres;
+
+revoke all on function private.meeting_note_lock_caller() from public, anon, authenticated, service_role;
+revoke all on function private.meeting_note_validate_fields(text, timestamptz, text) from public, anon, authenticated, service_role;
+revoke all on function private.meeting_note_authorize(uuid, bigint, text) from public, anon, authenticated, service_role;
+revoke all on function private.meeting_note_replace_participants(uuid, uuid, uuid[]) from public, anon, authenticated, service_role;
+revoke all on function private.meeting_note_write_participants(uuid, jsonb) from public, anon, authenticated, service_role;
+revoke all on function private.meeting_note_insert_version(uuid, uuid, text) from public, anon, authenticated, service_role;
+revoke all on function public.create_meeting_note(uuid, text, timestamptz, text, uuid[]) from public, anon, authenticated, service_role;
+revoke all on function public.update_meeting_note(uuid, bigint, text, timestamptz, text, uuid[]) from public, anon, authenticated, service_role;
+revoke all on function public.restore_meeting_note_version(uuid, bigint, uuid) from public, anon, authenticated, service_role;
+revoke all on function public.delete_meeting_note(uuid, bigint) from public, anon, authenticated, service_role;
+
+grant execute on function public.create_meeting_note(uuid, text, timestamptz, text, uuid[]) to authenticated;
+grant execute on function public.update_meeting_note(uuid, bigint, text, timestamptz, text, uuid[]) to authenticated;
+grant execute on function public.restore_meeting_note_version(uuid, bigint, uuid) to authenticated;
+grant execute on function public.delete_meeting_note(uuid, bigint) to authenticated;
+
+comment on function public.create_meeting_note(uuid, text, timestamptz, text, uuid[]) is
+  'Phase 6 T17 (FR-001, BR-002): a member of the space''s company creates a note (title 1-200, date required, content <= 100,000, <= 50 current-member participants) with version 1; company and author snapshots come from the space and the caller''s users row. Authenticated only.';
+comment on function public.update_meeting_note(uuid, bigint, text, timestamptz, text, uuid[]) is
+  'Phase 6 T17 (FR-006..FR-008, FR-030, BR-003, BR-004, BR-011): an editor (author, current participant, or company admin, each while a member, evaluated before the change) saves title, date, content, and participants at the current revision; bumps the revision and inserts one version. Former members already listed may be retained, never added. Authenticated only.';
+comment on function public.restore_meeting_note_version(uuid, bigint, uuid) is
+  'Phase 6 T17 (FR-009, BR-004): an editor restores a version''s title, date, participants, content, and summary at the current revision; bumps the revision and inserts one version; action items and transcript unchanged. Authenticated only.';
+comment on function public.delete_meeting_note(uuid, bigint) is
+  'Phase 6 T17 (FR-010, BR-003): the author (while a member) or a company admin deletes a note at the current revision, with its versions, participants, action items, and transcript. Authenticated only.';
+
+commit;
