+// src/app/api/meeting-notes/search/route.ts
+import { NextRequest, NextResponse } from 'next/server';
+import { MeetingNoteDbError } from '@/lib/meeting-notes/errors';
+import {
+  beginMeetingNoteRequest,
+  internalError,
+  meetingNoteError,
+  ok,
+  parseWith,
+} from '@/lib/meeting-notes/route-support';
+import { searchMeetingNotesQuerySchema } from '@/lib/meeting-notes/validation';
+
+export const dynamic = 'force-dynamic';
+
+/**
+ * GET /api/meeting-notes/search?q=&spaceId=&removed=&from=&to=&limit=&cursor=
+ * Full-text search over the caller's company's notes (FR-004, FR-026): title,
+ * content text, summary, and action-item descriptions; accent- and
+ * case-insensitive, Portuguese and English. Called with the caller's session:
+ * public.search_meeting_notes resolves the caller from auth.uid()
+ * (users.supabase_uid) and reads only notes of that user's company_id (the
+ * RLS read rule, BR-001), so another company's notes never appear.
+ *
+ * - `q` (<= 200 chars, websearch syntax). Empty or absent = list mode: every
+ *   note within the filters, newest meeting first, `relevance`/`excerpt` null.
+ * - `spaceId` = only that space; `removed=true` = only notes whose space was
+ *   deleted ("Space removed"); not both (400 MEETING_NOTE_SEARCH_FILTER_INVALID).
+ * - `from` (inclusive) / `to` (exclusive): ISO date-times with offset on the
+ *   meeting date (400 MEETING_NOTE_SEARCH_PERIOD_INVALID when malformed or from > to).
+ * - `limit` 1..50 (default 20); `cursor` = offset 0..10,000 (default 0).
+ * - Matching is per document: the note's own text (title, content, summary)
+ *   or ONE action item; all words of `q` (and any `-word` exclusion) apply
+ *   within that document, so words split between the note text and an item,
+ *   or across two items, do not combine into one match.
+ * - Rate limit 'meeting-note:search' (120/min per user, fail-open) -> 429.
+ *
+ * 200 { items: MeetingNoteSearchResult[], nextCursor, hasMore, totalCount }:
+ * relevance desc, meeting date desc, id desc. Each excerpt is plain-text
+ * segments with `highlighted` matches (render as text). Never returns content,
+ * summary, or transcript text beyond the excerpt.
+ */
+export async function GET(request: NextRequest): Promise<NextResponse> {
+  const begun = await beginMeetingNoteRequest('/api/meeting-notes/search', 'meeting-note:search');
+  if (!begun.ok) return begun.response;
+  const ctx = begun.value;
+
+  const params = request.nextUrl.searchParams;
+  const query = parseWith(
+    searchMeetingNotesQuerySchema,
+    {
+      q: params.get('q') ?? undefined,
+      spaceId: params.get('spaceId') ?? undefined,
+      removed: params.get('removed') ?? undefined,
+      from: params.get('from') ?? undefined,
+      to: params.get('to') ?? undefined,
+      limit: params.get('limit') ?? undefined,
+      cursor: params.get('cursor') ?? undefined,
+    },
+    ctx
+  );
+  if (!query.ok) return query.response;
+
+  try {
+    const page = await ctx.repository.searchNotes({
+      query: query.value.q,
+      spaceId: query.value.spaceId ?? null,
+      spaceRemoved: query.value.removed,
+      meetingFrom: query.value.from ?? null,
+      meetingTo: query.value.to ?? null,
+      limit: query.value.limit,
+      offset: query.value.cursor,
+    });
+    return ok(page, ctx);
+  } catch (error) {
+    if (error instanceof MeetingNoteDbError && error.sqlstate === '22023' && error.token === 'MEETING_NOTE_SEARCH_INVALID') {
+      return meetingNoteError(400, error.token, ctx, 'meetingNotes.search');
+    }
+    return internalError(error, ctx, 'meetingNotes.search');
+  }
+}
diff --git a/src/lib/meeting-notes/content-sanitizer.ts b/src/lib/meeting-notes/content-sanitizer.ts
new file mode 100644
index 0000000..e59196d
--- /dev/null
+++ b/src/lib/meeting-notes/content-sanitizer.ts
@@ -0,0 +1,94 @@
+// src/lib/meeting-notes/content-sanitizer.ts
+// Phase 6 FR-002 / AC-003: the single allow-list for meeting-note rich text.
+// Used on write by the API routes and meant for reuse on render (T6), so it
+// must stay isomorphic (no server-only imports).
+//
+// Allowed: paragraphs, line breaks, headings, bold/strong, italic/em, bulleted
+// and numbered lists, list items, the task-list markup Tiptap's TaskList /
+// TaskItem emit (ul[data-type="taskList"], li[data-type="taskItem"][data-checked],
+// label > input[type=checkbox] + span, div), and links whose href is
+// http, https, or mailto. Everything else is removed: scripts, styles, event
+// handlers, iframes, images, forms, classes, inline styles, and any other
+// URL scheme (javascript:, data:, vbscript:, relative or protocol-relative).
+import sanitizeHtml from 'sanitize-html';
+
+const SAFE_HREF = /^(?:https?:\/\/|mailto:)/i;
+
+/** Rel set on every surviving link. */
+export const MEETING_NOTE_LINK_REL = 'noopener noreferrer nofollow';
+
+export const MEETING_NOTE_SANITIZE_OPTIONS: sanitizeHtml.IOptions = {
+  allowedTags: [
+    'p',
+    'br',
+    'h1',
+    'h2',
+    'h3',
+    'h4',
+    'h5',
+    'h6',
+    'strong',
+    'b',
+    'em',
+    'i',
+    'ul',
+    'ol',
+    'li',
+    'a',
+    'label',
+    'input',
+    'span',
+    'div',
+  ],
+  allowedAttributes: {
+    a: ['href', 'rel', { name: 'target', multiple: false, values: ['_blank'] }],
+    ol: ['start'],
+    ul: [{ name: 'data-type', multiple: false, values: ['taskList'] }],
+    li: [
+      { name: 'data-type', multiple: false, values: ['taskItem'] },
+      { name: 'data-checked', multiple: false, values: ['true', 'false'] },
+    ],
+    input: [
+      { name: 'type', multiple: false, values: ['checkbox'] },
+      'checked',
+      'disabled',
+    ],
+  },
+  allowedSchemes: ['http', 'https', 'mailto'],
+  allowedSchemesByTag: {},
+  allowedSchemesAppliedToAttributes: ['href'],
+  allowProtocolRelative: false,
+  // Drop the CONTENT of these too, not only the tags.
+  nonTextTags: ['script', 'style', 'textarea', 'option', 'noscript', 'iframe', 'object', 'embed', 'template', 'svg', 'math'],
+  disallowedTagsMode: 'discard',
+  enforceHtmlBoundary: false,
+  parseStyleAttributes: false,
+  transformTags: {
+    a: (tagName, attribs) => {
+      const href = (attribs.href ?? '').trim();
+      const next: sanitizeHtml.Attributes = {};
+      if (SAFE_HREF.test(href)) {
+        next.href = href;
+        next.rel = MEETING_NOTE_LINK_REL;
+        if (attribs.target === '_blank') next.target = '_blank';
+      }
+      return { tagName, attribs: next };
+    },
+    ol: (tagName, attribs) => {
+      const next: sanitizeHtml.Attributes = {};
+      if (attribs.start !== undefined && /^\d{1,6}$/.test(attribs.start)) next.start = attribs.start;
+      return { tagName, attribs: next };
+    },
+  },
+  // Only checkbox inputs survive (an input whose type is not exactly
+  // "checkbox" is removed with its attributes).
+  exclusiveFilter: (frame) => frame.tag === 'input' && frame.attribs.type !== 'checkbox',
+};
+
+/** Sanitizes meeting-note rich text with the allow-list above. */
+export function sanitizeMeetingNoteHtml(html: string): string {
+  // NUL is invalid in Postgres text and replaced by browsers anyway. A lone
+  // surrogate cannot be stored either and becomes U+FFFD, as the parser
+  // already does for a surrogate character reference such as &#xD800;.
+  return sanitizeHtml(html.replace(/\u0000/g, '').toWellFormed(), MEETING_NOTE_SANITIZE_OPTIONS);
+}
diff --git a/src/lib/meeting-notes/errors.ts b/src/lib/meeting-notes/errors.ts
new file mode 100644
index 0000000..70f5463
--- /dev/null
+++ b/src/lib/meeting-notes/errors.ts
@@ -0,0 +1,80 @@
+// src/lib/meeting-notes/errors.ts
+// Errors raised by the meeting-note RPCs (migrations 20261013105021,
+// 20261013110632, and 20261013114402), carried from the repository to the routes.
+
+/** Message tokens the meeting-note RPCs raise (SQLSTATE in comments). */
+export const MEETING_NOTE_ERROR_TOKENS = [
+  // P0001
+  'MEETING_NOTE_STALE_REVISION',
+  'MEETING_NOTE_ITEM_STALE_REVISION',
+  // 42501
+  'MEETING_NOTE_FORBIDDEN',
+  'MEETING_NOTE_ITEM_FORBIDDEN',
+  // P0002
+  'MEETING_NOTE_NOT_FOUND',
+  'MEETING_NOTE_SPACE_NOT_FOUND',
+  'MEETING_NOTE_VERSION_NOT_FOUND',
+  'MEETING_NOTE_ITEM_NOT_FOUND',
+  // 22023
+  'MEETING_NOTE_TITLE_INVALID',
+  'MEETING_NOTE_DATE_REQUIRED',
+  'MEETING_NOTE_CONTENT_TOO_LONG',
+  'MEETING_NOTE_CONTENT_REQUIRED',
+  'MEETING_NOTE_TOO_MANY_PARTICIPANTS',
+  'MEETING_NOTE_PARTICIPANTS_INVALID',
+  'MEETING_NOTE_PARTICIPANT_NOT_MEMBER',
+  'MEETING_NOTE_REVISION_REQUIRED',
+  'MEETING_NOTE_ITEM_DESCRIPTION_INVALID',
+  'MEETING_NOTE_ITEM_ASSIGNEE_NOT_MEMBER',
+  'MEETING_NOTE_ITEM_REVISION_REQUIRED',
+  'MEETING_NOTE_ITEM_COMPLETED_REQUIRED',
+  'MEETING_NOTE_ITEM_LIMIT_REACHED',
+  // 22023, search (migration 20261013114402)
+  'MEETING_NOTE_SEARCH_INVALID',
+] as const;
+
+export type MeetingNoteErrorToken = (typeof MEETING_NOTE_ERROR_TOKENS)[number];
+
+const KNOWN_TOKENS: ReadonlySet<string> = new Set(MEETING_NOTE_ERROR_TOKENS);
+
+export function isMeetingNoteErrorToken(value: string): value is MeetingNoteErrorToken {
+  return KNOWN_TOKENS.has(value);
+}
+
+/**
+ * A database error from a meeting-note RPC. `token` is set only for the
+ * documented message tokens; anything else is an unexpected failure whose
+ * message must not reach the client.
+ */
+export class MeetingNoteDbError extends Error {
+  readonly sqlstate: string | undefined;
+  readonly token: MeetingNoteErrorToken | null;
+  /** Parsed DETAIL JSON (e.g. {"current_revision": 3}); null when absent or not JSON. */
+  readonly detail: Record<string, unknown> | null;
+
+  constructor(sqlstate: string | undefined, message: string, detail: string | null | undefined) {
+    super(message);
+    this.name = 'MeetingNoteDbError';
+    this.sqlstate = sqlstate;
+    this.token = isMeetingNoteErrorToken(message) ? message : null;
+    this.detail = parseDetail(detail);
+  }
+
+  /** The current revision reported by a stale-revision error, if any. */
+  get currentRevision(): number | null {
+    const value = this.detail?.current_revision;
+    return typeof value === 'number' && Number.isSafeInteger(value) ? value : null;
+  }
+}
+
+function parseDetail(detail: string | null | undefined): Record<string, unknown> | null {
+  if (!detail) return null;
+  try {
+    const parsed: unknown = JSON.parse(detail);
+    return typeof parsed === 'object' && parsed !== null && !Array.isArray(parsed)
+      ? (parsed as Record<string, unknown>)
+      : null;
+  } catch {
+    return null;
+  }
+}
diff --git a/src/lib/meeting-notes/note-detail.ts b/src/lib/meeting-notes/note-detail.ts
new file mode 100644
index 0000000..266fde9
--- /dev/null
+++ b/src/lib/meeting-notes/note-detail.ts
@@ -0,0 +1,94 @@
+// src/lib/meeting-notes/note-detail.ts
+// Phase 6 FR-005 / BR-003: composes a note view from repository reads made
+// with the caller's session (RLS: members of the note's company) and derives
+// the caller's rights on the state that was read. The database re-checks every
+// right on write; these flags only drive the UI.
+import type { IMeetingNoteRepository } from '@/repositories/interfaces/IMeetingNoteRepository';
+import type { ActionItem, MeetingNote, User } from '@/types/database';
+import type {
+  MeetingNoteActionItemView,
+  MeetingNoteDetail,
+  MeetingNoteRights,
+  MeetingNoteVersionParticipant,
+} from '@/types/meeting-notes';
+
+export interface MeetingNoteDetailOptions {
+  /** Include the stored transcript text (up to 1 MB). */
+  includeTranscript?: boolean;
+}
+
+/** BR-003 on a read state: author, current participant, or admin, each while a member. */
+export function computeMeetingNoteRights(
+  viewer: Pick<User, 'id' | 'companyId' | 'role'>,
+  note: Pick<MeetingNote, 'companyId' | 'authorUserId'>,
+  participantIds: readonly string[]
+): MeetingNoteRights {
+  if (!viewer.companyId || viewer.companyId !== note.companyId) {
+    return { canEdit: false, canDelete: false };
+  }
+  const isAdmin = viewer.role === 'admin';
+  const isAuthor = note.authorUserId === viewer.id;
+  return {
+    canEdit: isAdmin || isAuthor || participantIds.includes(viewer.id),
+    canDelete: isAdmin || isAuthor,
+  };
+}
+
+export function toActionItemViews(
+  items: readonly ActionItem[],
+  currentMemberIds: ReadonlySet<string>
+): MeetingNoteActionItemView[] {
+  return items.map((item) => ({
+    ...item,
+    assigneeIsCurrentMember: item.assigneeId === null ? null : currentMemberIds.has(item.assigneeId),
+  }));
+}
+
+/** Action items with their assignee-membership flag. */
+export async function loadActionItemViews(
+  repository: IMeetingNoteRepository,
+  companyId: string | null,
+  items: readonly ActionItem[]
+): Promise<MeetingNoteActionItemView[]> {
+  const assigneeIds = items.flatMap((item) => (item.assigneeId ? [item.assigneeId] : []));
+  const members = companyId ? await repository.findCurrentMemberIds(companyId, assigneeIds) : new Set<string>();
+  return toActionItemViews(items, members);
+}
+
+/** The note view, or null when the note is missing or not visible to the caller. */
+export async function loadMeetingNoteDetail(
+  repository: IMeetingNoteRepository,
+  viewer: Pick<User, 'id' | 'companyId' | 'role'>,
+  noteId: string,
+  options: MeetingNoteDetailOptions = {}
+): Promise<MeetingNoteDetail | null> {
+  const note = await repository.findById(noteId);
+  if (!note) return null;
+
+  const [participants, items, spaceName, transcript] = await Promise.all([
+    repository.findParticipants(note.id),
+    repository.findActionItems(note.id),
+    note.roomId ? repository.findSpaceName(note.roomId) : Promise.resolve(null),
+    options.includeTranscript && note.transcriptId ? repository.findTranscript(note.id) : Promise.resolve(null),
+  ]);
+
+  const participantIds = participants.map((participant) => participant.userId);
+  const assigneeIds = items.flatMap((item) => (item.assigneeId ? [item.assigneeId] : []));
+  const members = await repository.findCurrentMemberIds(note.companyId, [...participantIds, ...assigneeIds]);
+
+  const detail: MeetingNoteDetail = {
+    ...note,
+    spaceName,
+    participants: participants.map((participant: MeetingNoteVersionParticipant) => ({
+      ...participant,
+      isCurrentMember: members.has(participant.userId),
+    })),
+    actionItems: toActionItemViews(items, members),
+    hasTranscript: note.transcriptId !== null,
+    rights: computeMeetingNoteRights(viewer, note, participantIds),
+  };
+  if (options.includeTranscript) {
+    detail.transcript = transcript;
+  }
+  return detail;
+}
diff --git a/src/lib/meeting-notes/route-support.ts b/src/lib/meeting-notes/route-support.ts
new file mode 100644
index 0000000..a3d536e
--- /dev/null
+++ b/src/lib/meeting-notes/route-support.ts
@@ -0,0 +1,299 @@
+// src/lib/meeting-notes/route-support.ts
+// Shared plumbing of the /api/meeting-notes routes (Phase 6 T3): session,
+// rate limit, bounded JSON bodies, validation errors, and the mapping of RPC
+// refusals to HTTP. Note and item reads and writes always use the USER's
+// server client (RLS and the RPCs authorize from auth.uid()); the service-role
+// client is built only to charge the per-user rate-limit counter
+// (check_rate_limit is service-role only).
+import 'server-only';
+
+import { NextResponse } from 'next/server';
+import type { SupabaseClient } from '@supabase/supabase-js';
+import type { z } from 'zod';
+import { createCorrelationId, jsonError } from '@/lib/api/server-error';
+import { enforceRateLimit, type RateLimitedAction } from '@/lib/auth/rate-limit';
+import { requireAuthUser } from '@/lib/auth/session';
+import { readBoundedBody } from '@/lib/messaging/metrics-log';
+import { createSupabaseServerClient } from '@/lib/supabase/server-client';
+import { SupabaseMeetingNoteRepository } from '@/repositories/implementations/supabase/SupabaseMeetingNoteRepository';
+import type { IMeetingNoteRepository } from '@/repositories/interfaces/IMeetingNoteRepository';
+import type { ActionItem, User } from '@/types/database';
+import { MeetingNoteDbError, type MeetingNoteErrorToken } from './errors';
+import { loadActionItemViews, loadMeetingNoteDetail } from './note-detail';
+import { MEETING_NOTE_MAX_BODY_BYTES, pathIdSchema } from './validation';
+
+export interface MeetingNoteRouteContext {
+  correlationId: string;
+  /** The user's server client (JWT from the request cookies). */
+  supabase: SupabaseClient;
+  dbUser: User;
+  repository: IMeetingNoteRepository;
+}
+
+type Result<T> = { ok: true; value: T } | { ok: false; response: NextResponse };
+
+const MESSAGES: Record<string, string> = {
+  BAD_REQUEST: 'The request is invalid.',
+  UNSUPPORTED_MEDIA_TYPE: 'The request body must be application/json.',
+  PAYLOAD_TOO_LARGE: 'The request body is too large.',
+  MEETING_NOTE_SPACE_INVALID: 'A valid space is required.',
+  MEETING_NOTE_VERSION_INVALID: 'A valid version is required.',
+  MEETING_NOTE_ITEM_ASSIGNEE_INVALID: 'The assignee is invalid.',
+  MEETING_NOTE_ITEM_DUE_DATE_INVALID: 'The due date must be a date (YYYY-MM-DD).',
+  MEETING_NOTE_STALE_REVISION: 'This note was changed by someone else. Review the newer version before saving again.',
+  MEETING_NOTE_ITEM_STALE_REVISION: 'This action item was changed by someone else. Review the newer version and try again.',
+  MEETING_NOTE_FORBIDDEN: 'You do not have permission to change this note.',
+  MEETING_NOTE_ITEM_FORBIDDEN: 'You do not have permission to change this action item.',
+  MEETING_NOTE_NOT_FOUND: 'Meeting note not found.',
+  MEETING_NOTE_SPACE_NOT_FOUND: 'Space not found.',
+  MEETING_NOTE_VERSION_NOT_FOUND: 'Version not found.',
+  MEETING_NOTE_ITEM_NOT_FOUND: 'Action item not found.',
+  MEETING_NOTE_TITLE_INVALID: 'The title is required and must be at most 200 characters.',
+  MEETING_NOTE_DATE_REQUIRED: 'A valid meeting date is required.',
+  MEETING_NOTE_CONTENT_TOO_LONG: 'The content must be at most 100,000 characters.',
+  MEETING_NOTE_CONTENT_REQUIRED: 'The content must be text.',
+  MEETING_NOTE_TOO_MANY_PARTICIPANTS: 'A note can have at most 50 participants.',
+  MEETING_NOTE_PARTICIPANTS_INVALID: 'The participant list is invalid.',
+  MEETING_NOTE_PARTICIPANT_NOT_MEMBER: 'Participants must be current members of your company.',
+  MEETING_NOTE_REVISION_REQUIRED: 'The note revision is required.',
+  MEETING_NOTE_ITEM_DESCRIPTION_INVALID: 'The description is required and must be at most 1,000 characters.',
+  MEETING_NOTE_ITEM_ASSIGNEE_NOT_MEMBER: 'The assignee must be a current member of your company.',
+  MEETING_NOTE_ITEM_REVISION_REQUIRED: 'The action item revision is required.',
+  MEETING_NOTE_ITEM_COMPLETED_REQUIRED: 'The completion state is required.',
+  MEETING_NOTE_ITEM_LIMIT_REACHED: 'A note can have at most 100 action items.',
+  MEETING_NOTE_SEARCH_INVALID: 'The search request is invalid.',
+  MEETING_NOTE_SEARCH_QUERY_TOO_LONG: 'The search text must be at most 200 characters.',
+  MEETING_NOTE_SEARCH_FILTER_INVALID: 'Choose either a space or "Space removed", not both.',
+  MEETING_NOTE_SEARCH_PERIOD_INVALID: 'The period is invalid: use date-times with an offset, start before end.',
+};
+
+function messageFor(code: string): string {
+  return MESSAGES[code] ?? MESSAGES.BAD_REQUEST;
+}
+
+/** An error response with a stable code and the matching user-facing message. */
+export function meetingNoteError(
+  status: number,
+  code: string,
+  ctx: { correlationId: string },
+  context?: string
+): NextResponse {
+  return jsonError(status, code, messageFor(code), { correlationId: ctx.correlationId, context });
+}
+
+/** 404 for a missing, invisible, or malformed id (never reveals which). */
+export function notFound(token: MeetingNoteErrorToken, ctx: { correlationId: string }): NextResponse {
+  return meetingNoteError(404, token, ctx);
+}
+
+/**
+ * Authenticates the caller (auth.getUser + users.supabase_uid) and, for a
+ * mutation, charges `rateLimit` to their users.id.
+ */
+export async function beginMeetingNoteRequest(
+  pathname: string,
+  rateLimit?: RateLimitedAction
+): Promise<Result<MeetingNoteRouteContext>> {
+  const correlationId = createCorrelationId();
+  const auth = await requireAuthUser({ correlationId, pathname });
+  if ('errorResponse' in auth) {
+    return { ok: false, response: auth.errorResponse };
+  }
+
+  if (rateLimit) {
+    let limiter: SupabaseClient | null = null;
+    try {
+      limiter = await createSupabaseServerClient('service_role');
+    } catch {
+      // Fail-open action: a limiter that cannot be built never blocks notes.
+      console.error(JSON.stringify({ event: 'meeting_notes_limiter_unavailable', correlationId }));
+    }
+    if (limiter) {
+      const limited = await enforceRateLimit(limiter, auth.dbUser.id, rateLimit);
+      if (limited) return { ok: false, response: limited };
+    }
+  }
+
+  return {
+    ok: true,
+    value: {
+      correlationId,
+      supabase: auth.supabase,
+      dbUser: auth.dbUser,
+      repository: new SupabaseMeetingNoteRepository(auth.supabase),
+    },
+  };
+}
+
+/** A path id; anything that is not a UUID is answered as not found. */
+export function parsePathId(
+  raw: string | undefined,
+  token: MeetingNoteErrorToken,
+  ctx: { correlationId: string }
+): Result<string> {
+  const parsed = pathIdSchema.safeParse(raw);
+  return parsed.success ? { ok: true, value: parsed.data } : { ok: false, response: notFound(token, ctx) };
+}
+
+/** Validation failure → 400 with the first issue's stable code. */
+export function validationError(error: z.ZodError, ctx: { correlationId: string }): NextResponse {
+  const issue = error.issues[0];
+  const code = issue && /^[A-Z_]+$/.test(issue.message) ? issue.message : 'BAD_REQUEST';
+  return meetingNoteError(400, code, ctx);
+}
+
+export function parseWith<S extends z.ZodType>(
+  schema: S,
+  value: unknown,
+  ctx: { correlationId: string }
+): Result<z.infer<S>> {
+  const parsed = schema.safeParse(value);
+  return parsed.success
+    ? { ok: true, value: parsed.data }
+    : { ok: false, response: validationError(parsed.error, ctx) };
+}
+
+/** A JSON object body of at most MEETING_NOTE_MAX_BODY_BYTES. */
+export async function readJsonObject(request: Request, ctx: { correlationId: string }): Promise<Result<unknown>> {
+  const contentType = request.headers.get('content-type') ?? '';
+  if (contentType.split(';')[0].trim().toLowerCase() !== 'application/json') {
+    await request.body?.cancel().catch(() => undefined);
+    return { ok: false, response: meetingNoteError(415, 'UNSUPPORTED_MEDIA_TYPE', ctx) };
+  }
+  const body = await readBoundedBody(request, MEETING_NOTE_MAX_BODY_BYTES);
+  if (!body.ok) {
+    return {
+      ok: false,
+      response: meetingNoteError(body.reason === 'too_large' ? 413 : 400, body.reason === 'too_large' ? 'PAYLOAD_TOO_LARGE' : 'BAD_REQUEST', ctx),
+    };
+  }
+  try {
+    const value: unknown = JSON.parse(new TextDecoder('utf-8', { fatal: true }).decode(body.bytes));
+    if (typeof value !== 'object' || value === null || Array.isArray(value)) {
+      return { ok: false, response: meetingNoteError(400, 'BAD_REQUEST', ctx) };
+    }
+    return { ok: true, value };
+  } catch {
+    return { ok: false, response: meetingNoteError(400, 'BAD_REQUEST', ctx) };
+  }
+}
+
+/** 500 without SQL, details, or request data (they could carry note text). */
+export function internalError(error: unknown, ctx: { correlationId: string }, context: string): NextResponse {
+  const cause =
+    error instanceof MeetingNoteDbError
+      ? { code: error.sqlstate, message: error.token ?? 'unexpected database error' }
+      : { message: error instanceof Error ? error.name : 'unknown' };
+  return jsonError(500, 'INTERNAL_ERROR', 'Something went wrong. Please try again.', {
+    correlationId: ctx.correlationId,
+    cause,
+    context,
+  });
+}
+
+/** Maps a documented RPC refusal (other than a stale revision) to HTTP. */
+function refusalResponse(error: MeetingNoteDbError, ctx: { correlationId: string }, context: string): NextResponse {
+  const token = error.token;
+  if (token === null) return internalError(error, ctx, context);
+  switch (error.sqlstate) {
+    case '42501':
+      return meetingNoteError(403, token, ctx, context);
+    case 'P0002':
+      return meetingNoteError(404, token, ctx, context);
+    case '22023':
+      return meetingNoteError(400, token, ctx, context);
+    default:
+      return internalError(error, ctx, context);
+  }
+}
+
+function isStale(error: unknown, token: 'MEETING_NOTE_STALE_REVISION' | 'MEETING_NOTE_ITEM_STALE_REVISION'): error is MeetingNoteDbError {
+  return error instanceof MeetingNoteDbError && error.sqlstate === 'P0001' && error.token === token;
+}
+
+/**
+ * A failed note mutation → response. A stale revision → 409 carrying the
+ * note's current state (read with the caller's session) so the UI can show it.
+ */
+export async function noteMutationErrorResponse(
+  error: unknown,
+  ctx: MeetingNoteRouteContext,
+  noteId: string,
+  context: string
+): Promise<NextResponse> {
+  if (isStale(error, 'MEETING_NOTE_STALE_REVISION')) {
+    try {
+      const current = await loadMeetingNoteDetail(ctx.repository, ctx.dbUser, noteId);
+      if (!current) return notFound('MEETING_NOTE_NOT_FOUND', ctx);
+      return conflict('MEETING_NOTE_STALE_REVISION', current.revision, { note: current }, ctx);
+    } catch (loadError) {
+      return internalError(loadError, ctx, `${context}.loadCurrent`);
+    }
+  }
+  if (error instanceof MeetingNoteDbError) return refusalResponse(error, ctx, context);
+  return internalError(error, ctx, context);
+}
+
+/** Same for an action-item mutation; the 409 carries the item's current state. */
+export async function itemMutationErrorResponse(
+  error: unknown,
+  ctx: MeetingNoteRouteContext,
+  itemId: string,
+  companyId: string | null,
+  context: string
+): Promise<NextResponse> {
+  if (isStale(error, 'MEETING_NOTE_ITEM_STALE_REVISION')) {
+    try {
+      const item = await ctx.repository.findActionItemById(itemId);
+      if (!item) return notFound('MEETING_NOTE_ITEM_NOT_FOUND', ctx);
+      const [view] = await loadActionItemViews(ctx.repository, companyId, [item]);
+      return conflict('MEETING_NOTE_ITEM_STALE_REVISION', view.revision, { item: view }, ctx);
+    } catch (loadError) {
+      return internalError(loadError, ctx, `${context}.loadCurrent`);
+    }
+  }
+  if (error instanceof MeetingNoteDbError) return refusalResponse(error, ctx, context);
+  return internalError(error, ctx, context);
+}
+
+function conflict(
+  code: 'MEETING_NOTE_STALE_REVISION' | 'MEETING_NOTE_ITEM_STALE_REVISION',
+  currentRevision: number,
+  current: Record<string, unknown>,
+  ctx: { correlationId: string }
+): NextResponse {
+  return NextResponse.json(
+    { error: messageFor(code), code, currentRevision, correlationId: ctx.correlationId, ...current },
+    { status: 409, headers: { 'x-correlation-id': ctx.correlationId } }
+  );
+}
+
+/**
+ * The item addressed by /api/meeting-notes/[id]/items/[itemId], read with the
+ * caller's session; 404 unless it is visible AND belongs to that note (the
+ * item RPCs take only the item id, and an item's note_id is immutable).
+ */
+export async function resolveItemInNote(
+  ctx: MeetingNoteRouteContext,
+  rawNoteId: string | undefined,
+  rawItemId: string | undefined
+): Promise<Result<ActionItem>> {
+  const noteId = parsePathId(rawNoteId, 'MEETING_NOTE_ITEM_NOT_FOUND', ctx);
+  if (!noteId.ok) return noteId;
+  const itemId = parsePathId(rawItemId, 'MEETING_NOTE_ITEM_NOT_FOUND', ctx);
+  if (!itemId.ok) return itemId;
+  try {
+    const item = await ctx.repository.findActionItemById(itemId.value);
+    if (!item || item.noteId !== noteId.value) {
+      return { ok: false, response: notFound('MEETING_NOTE_ITEM_NOT_FOUND', ctx) };
+    }
+    return { ok: true, value: item };
+  } catch (error) {
+    return { ok: false, response: internalError(error, ctx, 'meetingNotes.item.resolve') };
+  }
+}
+
+/** A success body with the correlation header. */
+export function ok<T>(body: T, ctx: { correlationId: string }, status = 200): NextResponse<T> {
+  return NextResponse.json(body, { status, headers: { 'x-correlation-id': ctx.correlationId } });
+}
