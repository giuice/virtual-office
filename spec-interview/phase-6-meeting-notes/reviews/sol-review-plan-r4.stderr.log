612: create or replace function public.remove_company_member_and_presence(
613:     p_actor_user_id uuid,
614:     p_target_user_id uuid,
615:     p_company_id uuid
616: )
617: returns jsonb
618: language plpgsql
619: security definer
620: set search_path = pg_catalog
621: as $$
622: declare
623:     v_actor record;
624:     v_target record;
625:     v_company_admin_ids uuid[];
626:     v_operation_time timestamptz;
627:     v_retired_session_count integer;
628:     v_closed_log_count integer;
629:     v_removed_admin_reference boolean;
630:     v_invalidated_invitation_count integer;
631:     v_new_location_version integer;
632:     v_new_access_revision bigint;
633: begin
634:     if p_actor_user_id is null
635:        or p_target_user_id is null
636:        or p_company_id is null then
637:         raise exception 'COMPANY_REMOVAL_INVALID_ARGUMENT'
638:             using errcode = 'P0001';
639:     end if;
640: 
641:     -- Global order: both user rows by UUID, company, target space, sessions,
642:     -- then logs. Every overlapping membership writer must use this order or be
643:     -- proven not to overlap before production rollout.
644:     perform member.id
645:     from public.users as member
646:     where member.id = any (array[p_actor_user_id, p_target_user_id])
647:     order by member.id
648:     for update;
649: 
650:     select actor.id, actor.company_id, actor.role
651:     into v_actor
652:     from public.users as actor
653:     where actor.id = p_actor_user_id;
654: 
655:     if not found then
656:         raise exception 'COMPANY_REMOVAL_ACTOR_NOT_FOUND'
657:             using errcode = 'P0001';
658:     end if;
659: 
660:     select target.id, target.company_id, target.role, target.email, target.current_space_id
661:     into v_target
662:     from public.users as target
663:     where target.id = p_target_user_id;
664: 
665:     if not found then
666:         raise exception 'COMPANY_REMOVAL_TARGET_NOT_FOUND'
667:             using errcode = 'P0001';
668:     end if;
669: 
670:     select company.admin_ids
671:     into v_company_admin_ids
672:     from public.companies as company
673:     where company.id = p_company_id
674:     for update;
675: 
676:     if not found then
677:         raise exception 'COMPANY_REMOVAL_COMPANY_NOT_FOUND'
678:             using errcode = 'P0001';
679:     end if;
680: 
681:     perform invitation.id
682:     from public.invitations as invitation
683:     where invitation.company_id = p_company_id
684:       and pg_catalog.lower(invitation.email) = pg_catalog.lower(v_target.email)
685:       and invitation.status = 'pending'::public.invitation_status
686:     order by invitation.id
687:     for update;
688: 
689:     if v_target.current_space_id is not null then
690:         perform space.id
691:         from public.spaces as space
692:         where space.id = v_target.current_space_id
693:         for update;
694: 
695:         if not found then
696:             raise exception 'COMPANY_REMOVAL_SPACE_NOT_FOUND'
697:                 using errcode = 'P0001';
698:         end if;
699:     end if;
700: 
701:     perform session.id
702:     from public.user_presence_sessions as session
703:     where session.user_id = p_target_user_id
704:     order by session.id
705:     for update;
706: 
707:     perform log_row.id
708:     from public.space_presence_log as log_row
709:     where log_row.user_id = p_target_user_id
710:     order by log_row.id
711:     for update;
712: 
713:     -- Re-authorize against the locked rows, never against route-time state.
714:     if v_actor.company_id is distinct from p_company_id
715:        or v_actor.role is distinct from 'admin'::public.user_role then
716:         raise exception 'COMPANY_REMOVAL_FORBIDDEN'
717:             using errcode = 'P0001';
718:     end if;
719: 
720:     if p_actor_user_id = p_target_user_id then
721:         raise exception 'COMPANY_REMOVAL_SELF_FORBIDDEN'
722:             using errcode = 'P0001';
723:     end if;
724: 
725:     if v_target.company_id is distinct from p_company_id then
726:         raise exception 'COMPANY_REMOVAL_TARGET_OUTSIDE_COMPANY'
727:             using errcode = 'P0001';
728:     end if;
729: 
730:     v_operation_time := pg_catalog.clock_timestamp();
731:     if private.presence_runtime_mode() = 'atomic' then
732:         perform pg_catalog.set_config(
733:             'app.presence_internal_writer',
734:             'atomic-reconciliation',
735:             true
736:         );
737:     end if;
738:     v_removed_admin_reference := p_target_user_id = any (
739:         coalesce(v_company_admin_ids, array[]::uuid[])
740:     );
741: 
742:     update public.invitations as invitation
743:     set status = 'expired'::public.invitation_status
744:     where invitation.company_id = p_company_id
745:       and pg_catalog.lower(invitation.email) = pg_catalog.lower(v_target.email)
746:       and invitation.status = 'pending'::public.invitation_status;
747:     get diagnostics v_invalidated_invitation_count = row_count;
748: 
749:     update public.user_presence_sessions as session
750:     set retired_at = v_operation_time,
751:         expires_at = v_operation_time,
752:         retirement_reason = 'company-removal',
753:         space_id = null,
754:         placement_version = null,
755:         user_access_revision = null,
756:         space_access_revision = null
757:     where session.user_id = p_target_user_id;
758:     get diagnostics v_retired_session_count = row_count;
759: 
760:     update public.space_presence_log as log_row
761:     set exited_at = v_operation_time
762:     where log_row.user_id = p_target_user_id
763:       and log_row.exited_at is null;
764:     get diagnostics v_closed_log_count = row_count;
765: 
766:     update public.companies as company
767:     set admin_ids = pg_catalog.array_remove(company.admin_ids, p_target_user_id)
768:     where company.id = p_company_id;
769: 
770:     update public.users as target
771:     set company_id = null,
772:         role = 'member'::public.user_role,
773:         current_space_id = null,
774:         location_version = target.location_version + 1
775:     where target.id = p_target_user_id
776:     returning target.location_version, target.presence_access_revision
777:     into v_new_location_version, v_new_access_revision;
778: 
779:     return pg_catalog.jsonb_build_object(
780:         'ok', true,
781:         'code', 'COMPANY_MEMBER_REMOVED',
782:         'actorUserId', p_actor_user_id,
783:         'targetUserId', p_target_user_id,
784:         'companyId', p_company_id,
785:         'previousSpaceId', v_target.current_space_id,
786:         'locationVersion', v_new_location_version,
787:         'presenceAccessRevision', v_new_access_revision,
788:         'retiredSessionCount', v_retired_session_count,
789:         'closedLogCount', v_closed_log_count,
790:         'invalidatedInvitationCount', v_invalidated_invitation_count,
791:         'removedAdminReference', v_removed_admin_reference,
792:         'operationTime', v_operation_time
793:     );
794: end;
795: $$;
796: 
797: alter function public.remove_company_member_and_presence(uuid, uuid, uuid)
798:     owner to presence_maintenance_owner;
799: revoke all on function public.remove_company_member_and_presence(uuid, uuid, uuid)
800:     from public, anon, authenticated, service_role, presence_maintenance_owner;
801: grant execute on function public.remove_company_member_and_presence(uuid, uuid, uuid)
802:     to service_role;
803: 
804: create or replace function public.update_company_member_role(
805:     p_actor_user_id uuid,
806:     p_target_user_id uuid,
807:     p_company_id uuid,
808:     p_role public.user_role
809: )
810: returns jsonb

