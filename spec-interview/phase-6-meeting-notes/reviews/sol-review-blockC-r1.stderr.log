475: function asObject(value: unknown): Record<string, unknown> | null {
476:   return value !== null && typeof value === 'object' && !Array.isArray(value) ? (value as Record<string, 
unknown>) : null;
477: }
478: 
479: /**
480:  * The `error` object of a provider's NORMAL error body, or null for any other
481:  * body. Anthropic: {"type":"error","error":{"type","message"}}; the
482:  * OpenAI-compatible providers (OpenAI, Kimi, GLM): {"error":{"message",
483:  * "type"?, "code"?}}.
484:  */
485: function normalErrorObject(protocol: MeetingNoteAiWireProtocol, body: unknown): Record<string, unknown> | null {
486:   const root = asObject(body);
487:   const error = asObject(root?.error);
488:   if (!root || !error || typeof error.message !== 'string') return null;
489:   if (protocol === 'anthropic-messages' && (root.type !== 'error' || typeof error.type !== 'string')) return null;
490:   return error;
491: }
492: 
493: function matchesRejection(match: MeetingNoteAiRejectionMatch, error: Record<string, unknown>): boolean {
494:   // GLM documents its business codes as text; a numeric code compares as text.
495:   const code = typeof error.code === 'number' ? String(error.code) : error.code;
496:   switch (match.by) {
497:     case 'type':
498:       return error.type === match.errorType;
499:     case 'code':
500:       return code === match.errorCode;
501:     case 'type+code':
502:       return error.type === match.errorType && code === match.errorCode;
503:   }
504: }
505: 
506: /**
507:  * FR-022: the refund category of a provider's INITIAL non-2xx response, or
508:  * null when the dispatch stays counted. Only the provider's normal error body
509:  * whose status and documented type/code are listed for it qualifies.
510:  */
511: export function classifyMeetingNoteAiPreProcessingRejection(
512:   provider: MeetingNoteAiProvider,
513:   status: number,
514:   body: unknown
515: ): MeetingNoteAiRejectionCategory | null {
516:   if (status >= 200 && status < 300) return null;
517:   const capability = MEETING_NOTE_AI_CAPABILITIES[provider];
518:   const error = normalErrorObject(capability.protocol, body);
519:   if (!error) return null;
520:   const rejection = capability.preProcessingRejections.find(
521:     (entry) => entry.status === status && matchesRejection(entry.match, error)
522:   );
523:   return rejection?.category ?? null;
524: }
