794: -- ---------------------------------------------------------------------------
795: -- Maintenance jobs (service_role; scheduled with pg_cron as postgres)
796: -- ---------------------------------------------------------------------------
797: 
798: -- An operation with no recorded outcome 10 minutes after dispatch (or after
799: -- admission when no dispatch was recorded) becomes terminal "failed" and stays
800: -- counted (FR-022, FR-031). Rows being settled right now are skipped and
801: -- picked up by the next run.
802: create or replace function public.fail_stale_meeting_note_ai_operations()
803: returns integer
804: language plpgsql
805: volatile
806: security definer
807: set search_path = ''
808: as $$
809: declare
810:   v_at timestamptz := pg_catalog.clock_timestamp();
811:   v_count integer := 0;
812: begin
813:   with stale as materialized (
814:     select o.id
815:     from public.meeting_note_ai_operations as o
816:     where (o.status = 'dispatched' and o.dispatched_at <= v_at - interval '10 minutes')
817:        or (o.status = 'admitted' and o.admitted_at <= v_at - interval '10 minutes')
818:     order by o.admitted_at, o.id
819:     for update skip locked
820:     limit 1000
821:   )
822:   update public.meeting_note_ai_operations as o
823:   set status = 'failed',
824:       settled_at = v_at
825:   from stale
826:   where o.id = stale.id;
827: 
828:   get diagnostics v_count = row_count;
829:   return v_count;
830: end;
831: $$;
832: 
833: -- Operation records are kept 30 days after admission (a ticket is valid for
834: -- 24 h, so no replay can need an older record).
835: create or replace function public.purge_meeting_note_ai_operations()
836: returns integer
837: language plpgsql
838: volatile
839: security definer
840: set search_path = ''
841: as $$
842: declare
843:   v_at timestamptz := pg_catalog.clock_timestamp();
844:   v_count integer := 0;
845: begin
846:   with purgeable as materialized (
847:     select o.id
848:     from public.meeting_note_ai_operations as o
849:     where o.admitted_at <= v_at - interval '30 days'
850:     order by o.admitted_at, o.id
851:     for update skip locked
852:     limit 10000
853:   )
854:   delete from public.meeting_note_ai_operations as o
855:   using purgeable
856:   where o.id = purgeable.id;
857: 
858:   get diagnostics v_count = row_count;
859:   return v_count;
860: end;
861: $$;
862: 
863: alter function public.fail_stale_meeting_note_ai_operations() owner to postgres;
864: alter function public.purge_meeting_note_ai_operations() owner to postgres;
865: revoke all on function public.fail_stale_meeting_note_ai_operations() from public, anon, authenticated, 
service_role;
866: revoke all on function public.purge_meeting_note_ai_operations() from public, anon, authenticated, service_role;
867: grant execute on function public.fail_stale_meeting_note_ai_operations() to service_role;
868: grant execute on function public.purge_meeting_note_ai_operations() to service_role;
869: 
870: -- Idempotent scheduling: drop any job with the same name first.
871: do $$
872: declare
873:   v_job record;
874: begin
875:   for v_job in
876:     select jobid
877:     from cron.job
878:     where jobname in ('meeting-notes-ai-fail-stale-v1', 'meeting-notes-ai-purge-operations-v1')
879:   loop
880:     perform cron.unschedule(v_job.jobid);
881:   end loop;
882: end;
883: $$;
884: 
885: select cron.schedule(
886:   'meeting-notes-ai-fail-stale-v1',
887:   '* * * * *',
888:   'select public.fail_stale_meeting_note_ai_operations();'
889: );
890: 
891: select cron.schedule(
892:   'meeting-notes-ai-purge-operations-v1',
893:   '40 3 * * *',
894:   'select public.purge_meeting_note_ai_operations();'
895: );

