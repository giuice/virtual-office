1: // Shared constants and wire types of the meeting-notes fake AI server (T16).
2: //
3: // TEST-ONLY. The fake replaces ONLY the external AI provider (SPEC §15): the
4: // database, RLS, routes, and UI stay real. Both runners start it in-process:
5: //   * Vitest DB suite: vitest.meeting-notes-db.config.mts → globalSetup
6: //     __tests__/meeting-notes-ai-fake/vitest-global-setup.ts
7: //   * Playwright E2E:  playwright.meeting-notes.config.ts → globalSetup
8: //     __tests__/meeting-notes-ai-fake/playwright-global-setup.ts
9: //
10: // App contract for T11 (server-only adapters): when
11: // MEETING_NOTES_AI_BASE_URL_OVERRIDE is set (and NODE_ENV is NOT
12: // "production" — in production the app must ignore it and log the refusal; no
13: // client input may set it), each provider's base URL becomes
14: //   `${override}/${provider}${new URL(capability.baseUrl).pathname}` (no trailing slash)
15: // i.e. the provider id prefixes the real API path:
16: //   anthropic → {override}/anthropic            (SDK appends /v1/messages)
17: //   openai    → {override}/openai/v1            (SDK appends /chat/completions)
18: //   kimi      → {override}/kimi/v1              (SDK appends /chat/completions)
19: //   glm       → {override}/glm/api/paas/v4      (SDK appends /chat/completions)
20: // OpenAI is spoken through Chat Completions only (capabilities.ts protocol
21: // 'openai-chat-completions'); the Responses API is not served (a request to
22: // /openai/v1/responses is recorded and answered 404 in the OpenAI envelope).
23: 
24: /** Fixed loopback port; override with MEETING_NOTES_FAKE_AI_PORT. Not used by Supabase (5432x) or Next (32xx). */
25: export const MEETING_NOTES_FAKE_AI_DEFAULT_PORT = 54399;
26: export const MEETING_NOTES_FAKE_AI_PORT_ENV = 'MEETING_NOTES_FAKE_AI_PORT';
27: /** Read by the app (T11) in non-production runtimes only. */
28: export const MEETING_NOTES_AI_BASE_URL_OVERRIDE_ENV = 'MEETING_NOTES_AI_BASE_URL_OVERRIDE';
29: export const MEETING_NOTES_FAKE_AI_HOST = '127.0.0.1';
30: 
31: export function meetingNotesFakeAiPort(env: NodeJS.ProcessEnv = process.env): number {
32:   const raw = env[MEETING_NOTES_FAKE_AI_PORT_ENV];
33:   if (raw === undefined || raw === '') return MEETING_NOTES_FAKE_AI_DEFAULT_PORT;
34:   const port = Number(raw);
35:   if (!Number.isInteger(port) || port < 1024 || port > 65535) {
36:     throw new Error(`${MEETING_NOTES_FAKE_AI_PORT_ENV} must be an integer port in 1024–65535 (got "${raw}").`);
37:   }
38:   return port;
39: }
40: 
41: export function meetingNotesFakeAiBaseUrl(env: NodeJS.ProcessEnv = process.env): string {
42:   return `http://${MEETING_NOTES_FAKE_AI_HOST}:${meetingNotesFakeAiPort(env)}`;
43: }
44: 
45: export type FakeAiProvider = 'anthropic' | 'openai' | 'kimi' | 'glm';
46: export const FAKE_AI_PROVIDERS: readonly FakeAiProvider[] = ['anthropic', 'openai', 'kimi', 'glm'];
47: 
48: /** Request paths served per provider (relative to the fake's base URL). */
49: export const FAKE_AI_PROVIDER_PATHS: Readonly<Record<FakeAiProvider, string>> = {
50:   anthropic: '/anthropic/v1/messages',
51:   openai: '/openai/v1/chat/completions',
52:   kimi: '/kimi/v1/chat/completions',
53:   glm: '/glm/api/paas/v4/chat/completions',
54: };
55: 
56: export interface FakeAiUsage {
57:   inputTokens?: number;
58:   outputTokens?: number;
59: }
60: 
61: /** Fields every outcome accepts. */
62: interface FakeAiOutcomeBase {
63:   /** Wait this long after reading the request body before answering ("processing"). */
64:   delayMs?: number;
65: }
66: 
67: /**
68:  * Scripted outcome of ONE provider request. Requests with `"stream": true`
69:  * get SSE (Anthropic events / OpenAI `data:` chunks + `[DONE]`); others JSON.
70:  */
71: export type FakeAiOutcome =
72:   /** 200 with `draft` (JSON-serialized, or used as-is when a string) as the model's text output. */
73:   | (FakeAiOutcomeBase & {
74:       kind: 'success';
75:       draft: unknown;
76:       usage?: FakeAiUsage;
77:       /** Anthropic only: prepend an empty adaptive-thinking block (default true, as Opus 5.5 always thinks). */
78:       includeThinking?: boolean;
79:     })
80:   /** Non-2xx (default 500) with the provider's normal error envelope, after reading the body. Unlisted → counted. 
*/
81:   | (FakeAiOutcomeBase & {
82:       kind: 'error_after_processing';
83:       status?: number;
84:       errorType?: string;
85:       errorCode?: string;
86:       message?: string;
87:     })
88:   /** Read the body, never answer until /__control/reset or server close (then the socket is destroyed). */
89:   | { kind: 'timeout' }
90:   /**
91:    * 200 refusal. Anthropic: `stop_reason: "refusal"` + `stop_details`. OpenAI: `message.refusal`
92:    * with finish_reason "stop"; Kimi: finish_reason "content_filter"; GLM: finish_reason "sensitive".
93:    */
94:   | (FakeAiOutcomeBase & { kind: 'refusal'; message?: string; finishReason?: string })
95:   /**
96:    * 200 whose model text is not valid JSON. `truncated: true` → Anthropic `stop_reason: "max_tokens"`,
97:    * OpenAI-compatible `finish_reason: "length"`.
98:    */
99:   | (FakeAiOutcomeBase & { kind: 'malformed_json'; text?: string; truncated?: boolean })
100:   /** Initial non-2xx rejection with the provider's normal envelope carrying `errorType` and/or `errorCode`. */
101:   | (FakeAiOutcomeBase & {
102:       kind: 'rejection';
103:       status: number;
104:       errorType?: string;
105:       errorCode?: string;
106:       message?: string;
107:     })
108:   /** Arbitrary status and body (object → JSON, string → raw text) for unlisted statuses or non-envelope bodies. 
*/
109:   | (FakeAiOutcomeBase & {
110:       kind: 'status';
111:       status: number;
112:       body: unknown;
113:       contentType?: string;
114:       headers?: Record<string, string>;
115:     })
116:   /**
117:    * 200 + some streamed output, then an error (Anthropic `event: error` with `errorType`, default
118:    * overloaded_error; OpenAI-compatible `data: {"error":{...}}`), or an abrupt socket close when
119:    * `abrupt: true`. A non-streaming request gets 200 headers + a partial JSON body, then a socket close.
120:    */
121:   | (FakeAiOutcomeBase & {
122:       kind: 'stream_error_after_start';
123:       errorType?: string;
124:       errorCode?: string;
125:       message?: string;
126:       abrupt?: boolean;
127:     })
128:   /** Read the whole body, record it, then destroy the socket without any response bytes. */
129:   | (FakeAiOutcomeBase & { kind: 'drop_after_accept' })
130:   /**
131:    * Hold the request until POST /__control/release, then deliver `then`, or (when absent) the next
132:    * scripted outcome for that provider (its queue, else its default).
133:    */
134:   | { kind: 'pause'; then?: FakeAiOutcome };
135: 
136: export type FakeAiOutcomeKind = FakeAiOutcome['kind'];
137: 
138: /** One request the fake received (control requests are not recorded). */
139: export interface FakeAiRecordedRequest {
140:   /** 1-based arrival order across the whole server since the last reset. */
141:   seq: number;
142:   receivedAt: string;
143:   method: string;
144:   /** Path without query string. */
145:   path: string;
146:   /** Path + query string as received. */
147:   url: string;
148:   /** null for an unknown path (answered 404). */
149:   provider: FakeAiProvider | null;
150:   /**
151:    * All request headers (lower-case names). Credential headers (authorization, x-api-key,
152:    * api-key, proxy-authorization, cookie, …) are replaced by `[redacted …<last 4 chars>]`; the
153:    * full value is never stored.
154:    */
155:   headers: Record<string, string>;
156:   /** Last 4 characters of the credential the request carried, and its header; null when none. */
157:   credential: { header: string; last4: string } | null;
158:   /** Parsed JSON body, or null when absent/unparseable (then `bodyParseError` is set). */
159:   body: unknown;
160:   bodyParseError?: string;
161:   bodyBytes: number;
162:   stream: boolean;
163:   /** Outcome applied (pause records 'pause'; the released outcome is appended as `releasedAs`). */
164:   outcome: FakeAiOutcomeKind | 'unscripted' | 'not_found';
165:   releasedAs?: FakeAiOutcomeKind | 'unscripted';
166: }
167: 
168: export interface FakeAiRequestsResponse {
169:   requests: FakeAiRecordedRequest[];
170:   /** Requests received per provider since the last reset ("exactly one outbound request"). */
171:   received: Record<FakeAiProvider, number>;
172: }
173: 
174: export interface FakeAiStateResponse {
175:   received: Record<FakeAiProvider, number>;
176:   queued: Record<FakeAiProvider, number>;
177:   defaults: Record<FakeAiProvider, FakeAiOutcomeKind | null>;
178:   /** Requests currently held open: paused (until release) and timeout (until reset/close). */
179:   held: { paused: Record<FakeAiProvider, number>; timeout: Record<FakeAiProvider, number> };
180: }
__tests__/meeting-notes-ai-fake/vitest-global-setup.ts
1: // Vitest globalSetup of the meeting-notes DB suite (T16): starts the fake AI
2: // server once per run on its fixed loopback port, runs the self-check (fails
3: // the run loudly on any mismatch), and stops it at the end. Test workers reach
4: // it over HTTP; MEETING_NOTES_AI_BASE_URL_OVERRIDE is set for them in
5: // vitest.meeting-notes-db.config.mts (test.env).
6: import { runMeetingNotesFakeAiSelfCheck } from './self-check';
7: import { startMeetingNotesFakeAiServer } from './server';
8: 
9: export default async function setup(): Promise<() => Promise<void>> {
10:   const server = await startMeetingNotesFakeAiServer();
11:   try {
12:     const lines = await runMeetingNotesFakeAiSelfCheck(server.baseUrl);
13:     console.log(`[meeting-notes fake AI] listening on ${server.baseUrl}; self-check passed:\n  ${lines.join('\n  
')}`);
14:   } catch (err) {
15:     await server.close();
16:     throw err;
17:   }
18:   return async () => {
19:     await server.close();
20:     console.log('[meeting-notes fake AI] stopped');
21:   };
22: }
__tests__/meeting-notes-ai-fake/playwright-global-setup.ts
1: // Playwright globalSetup of the meeting-notes E2E runner (T16): starts the fake
2: // AI server in the runner process on its fixed loopback port, runs the
3: // self-check, and returns the teardown that stops it. The Next dev server gets
4: // MEETING_NOTES_AI_BASE_URL_OVERRIDE from playwright.meeting-notes.config.ts
5: // (its URL is fixed, so the server can start before this setup runs).
6: import { runMeetingNotesFakeAiSelfCheck } from './self-check';
7: import { startMeetingNotesFakeAiServer } from './server';
8: 
9: export default async function meetingNotesFakeAiGlobalSetup(): Promise<() => Promise<void>> {
10:   const server = await startMeetingNotesFakeAiServer();
11:   try {
12:     const lines = await runMeetingNotesFakeAiSelfCheck(server.baseUrl);
13:     console.log(`[meeting-notes fake AI] listening on ${server.baseUrl}; self-check passed (${lines.length} 
protocols)`);
14:   } catch (err) {
15:     await server.close();
16:     throw err;
17:   }
18:   return async () => {
19:     await server.close();
20:   };
21: }

