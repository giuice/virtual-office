1: // Meeting-notes fake AI server (T16, TEST-ONLY): a plain node:http server on
2: // 127.0.0.1 that speaks each provider's API (protocols.ts), records every
3: // provider request (credential headers reduced to their last 4 characters),
4: // and answers with outcomes scripted per test through `/__control/*`
5: // (control-client.ts). It replaces ONLY the external provider; started
6: // in-process by the Vitest DB suite and the Playwright E2E runner.
7: //
8: // Control API (JSON):
9: //   GET  /__control/health                      → {ok:true}
10: //   POST /__control/script   {provider, outcomes[]} → append to the provider's FIFO queue
11: //   POST /__control/default  {provider, outcome|null} → outcome used when the queue is empty
12: //   POST /__control/release  {provider?}         → deliver held `pause` requests ({released})
13: //   GET  /__control/requests[?provider=]        → {requests, received}
14: //   GET  /__control/state                       → {received, queued, defaults, held}
15: //   POST /__control/reset                       → clear queues, defaults, records; destroy held sockets
16: // A request with nothing scripted (empty queue, no default) is answered 500 in
17: // the provider envelope with a "no scripted outcome" message, recorded as 'unscripted'.
18: import { createServer, type IncomingMessage, type Server, type ServerResponse } from 'node:http';
