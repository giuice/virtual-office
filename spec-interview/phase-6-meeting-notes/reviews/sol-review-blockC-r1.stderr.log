245: -- ---------------------------------------------------------------------------
246: -- Shared note lock + rights (one rule for mutations and admission)
247: -- ---------------------------------------------------------------------------
248: 
249: -- The actor's users row by application id, FOR KEY SHARE (first lock of the
250: -- service_role transactions that act for a server-authorized user). All OUT
251: -- values are NULL when the row does not exist.
252: create or replace function private.meeting_note_lock_actor(
253:   p_user_id uuid,
254:   out caller_id uuid,
255:   out caller_company_id uuid,
256:   out caller_is_admin boolean,
257:   out caller_name text
258: )
259: language plpgsql
260: volatile
261: security definer
262: set search_path = ''
263: as $$
264: begin
265:   if p_user_id is null then
266:     return;
267:   end if;
268: 
269:   select u.id, u.company_id, (u.role = 'admin'::public.user_role), u.display_name
270:   into caller_id, caller_company_id, caller_is_admin, caller_name
271:   from public.users as u
272:   where u.id = p_user_id
273:   for key share;
274: end;
275: $$;
276: 
277: -- For an actor whose users row the caller has ALREADY locked FOR KEY SHARE:
278: -- locks the note FOR UPDATE (only for a member of the note's company) and
279: -- reports the actor's rights on the locked pre-change state. Raises
280: -- p_not_found (P0002) when the note is missing or the actor is not a current
281: -- member of its company. Body moved unchanged from
282: -- private.meeting_note_lock_for_change (20261013110632).
283: create or replace function private.meeting_note_lock_note_for_actor(
284:   p_note_id uuid,
285:   p_not_found text,
286:   p_actor_id uuid,
287:   p_actor_company_id uuid,
288:   p_actor_is_admin boolean,
289:   out note_company_id uuid,
290:   out note_revision bigint,
291:   out can_edit boolean,
292:   out can_delete boolean
293: )
294: language plpgsql
295: volatile
296: security definer
297: set search_path = ''
298: as $$
299: declare
300:   v_note record;
301: begin
302:   if p_note_id is null or p_actor_id is null or p_actor_company_id is null then
303:     raise exception '%', p_not_found using errcode = 'P0002';
304:   end if;
305: 
306:   -- Outsiders never take the note lock: the company check runs on an
307:   -- unlocked read first (company_id is immutable, so it cannot go stale).
308:   if not exists (
309:     select 1
310:     from public.meeting_notes as n
311:     where n.id = p_note_id
312:       and n.company_id = p_actor_company_id
313:   ) then
314:     raise exception '%', p_not_found using errcode = 'P0002';
315:   end if;
316: 
317:   select n.id, n.company_id, n.author_user_id, n.revision
318:   into v_note
319:   from public.meeting_notes as n
320:   where n.id = p_note_id
321:   for update;
322: 
323:   if not found then
324:     -- Deleted by a transaction that committed while this one waited.
325:     raise exception '%', p_not_found using errcode = 'P0002';
326:   end if;
327: 
328:   -- Two-valued by construction (a NULL input never grants a right).
