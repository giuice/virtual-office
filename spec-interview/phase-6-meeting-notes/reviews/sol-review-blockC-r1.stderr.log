139: function sendControlJson(res: ServerResponse, status: number, body: unknown): void {
140:   const payload = JSON.stringify(body);
141:   res.writeHead(status, { 'content-type': 'application/json', 'content-length': 
Buffer.byteLength(payload).toString() });
142:   res.end(payload);
143: }
