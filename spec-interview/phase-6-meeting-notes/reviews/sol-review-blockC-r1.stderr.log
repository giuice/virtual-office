465:           reasoningLevels: model.reasoningLevels.map(({ id: levelId, label }) => ({ id: levelId, label })),
466:           defaultReasoningLevel: model.defaultReasoningLevel,
467:           contextWindowTokens: model.contextWindowTokens,
468:           maxOutputTokens: model.maxOutputTokens,
469:         })
470:       ),
