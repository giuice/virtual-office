1: // src/lib/meeting-notes/ai/adapters/transport.ts
2: // Shared transport guard of the meeting-note provider adapters (Phase 6 T11).
3: // Every SDK client gets `fetch: createDispatchFetch(state)` and
4: // `maxRetries: 0`; the wrapper:
5: //   * refuses a second outbound request on the same call (exactly one request
6: //     per call, even if an SDK tried to retry);
7: //   * refuses to send when the signal is already aborted (never sent);
8: //   * records whether the request was handed to the network (`dispatched`),
9: //     whether the connection was refused / the host did not resolve (no byte
10: //     can have reached the provider), and the INITIAL response status plus a
11: //     bounded copy of a non-2xx body for FR-022 classification — so counting
12: //     never depends on SDK error parsing or on provider text.
13: // createRequestControl joins the caller's AbortSignal with the adapter's own
14: // deadline (the SDK's timeout stops at response headers; the deadline also
15: // covers the streamed body).
16: import 'server-only';
17: 
18: import type { MeetingNoteAiProvider } from '@/types/meeting-notes';
19: 
20: import {
21:   classifyMeetingNoteAiPreProcessingRejection,
22:   type MeetingNoteAiModelCapability,
23:   type MeetingNoteAiReasoningLevel,
24: } from '../capabilities';
25: import {
26:   meetingNoteAiFailure,
27:   meetingNoteAiRejectionFailure,
28:   type MeetingNoteAiDraftFailure,
29:   type MeetingNoteAiUsageReport,
30: } from '../provider-errors';
31: 
32: type FetchInput = string | URL | Request;
33: 
34: export interface MeetingNoteAiDispatchState {
35:   dispatched: boolean;
36:   /** Connection refused or DNS failure before any request byte could leave. */
37:   unreachable: boolean;
38:   /** Status of the provider's initial response, once headers arrived. */
39:   initialStatus: number | null;
40:   /** Parsed JSON of a non-2xx initial body (≤64 KB), else null. */
41:   initialErrorBody: unknown;
42: }
43: 
44: export function createDispatchState(): MeetingNoteAiDispatchState {
45:   return { dispatched: false, unreachable: false, initialStatus: null, initialErrorBody: null };
46: }
47: 
48: const MAX_ERROR_BODY_BYTES = 64 * 1024;
49: /** Error codes that prove the TCP connection was never established. */
50: const UNREACHABLE_CODES: ReadonlySet<string> = new Set(['ECONNREFUSED', 'ENOTFOUND', 'EAI_AGAIN']);
51: 
52: function abortError(): Error {
53:   const error = new Error('The meeting-note AI request was aborted before it was sent.');
54:   error.name = 'AbortError';
55:   return error;
56: }
57: 
58: /** Walks `cause` links (undici wraps socket errors as `TypeError: fetch failed`). */
59: function isUnreachableError(err: unknown): boolean {
60:   let current: unknown = err;
61:   for (let depth = 0; depth < 5 && current !== null && typeof current === 'object'; depth += 1) {
62:     const code = (current as { code?: unknown }).code;
63:     if (typeof code === 'string' && UNREACHABLE_CODES.has(code)) return true;
64:     current = (current as { cause?: unknown }).cause;
65:   }
66:   return false;
67: }
68: 
69: async function readBoundedJson(response: Response): Promise<unknown> {
70:   const reader = response.body?.getReader();
71:   if (!reader) return null;
72:   const chunks: Uint8Array[] = [];
73:   let size = 0;
74:   try {
75:     for (;;) {
76:       const { done, value } = await reader.read();
77:       if (done) break;
78:       size += value.byteLength;
79:       if (size > MAX_ERROR_BODY_BYTES) {
80:         await reader.cancel();
81:         return null;
82:       }
83:       chunks.push(value);
84:     }
85:   } catch {
86:     return null;
87:   }
88:   const bytes = new Uint8Array(size);
89:   let offset = 0;
90:   for (const chunk of chunks) {
91:     bytes.set(chunk, offset);
92:     offset += chunk.byteLength;
93:   }
94:   try {
95:     return JSON.parse(new TextDecoder().decode(bytes)) as unknown;
96:   } catch {
97:     return null;
98:   }
99: }
100: 
101: export function createDispatchFetch(
102:   state: MeetingNoteAiDispatchState
103: ): (input: FetchInput, init?: RequestInit) => Promise<Response> {
104:   return async (input, init) => {
105:     if (state.dispatched) throw new Error('Only one outbound request is allowed per meeting-note AI call.');
106:     if (init?.signal?.aborted) throw abortError();
107:     state.dispatched = true;
108:     let response: Response;
109:     try {
110:       response = await fetch(input, init);
111:     } catch (err) {
112:       if (isUnreachableError(err)) state.unreachable = true;
113:       throw err;
114:     }
115:     state.initialStatus = response.status;
116:     if (!response.ok) state.initialErrorBody = await readBoundedJson(response.clone());
117:     return response;
118:   };
119: }
120: 
121: export interface MeetingNoteAiRequestControl {
122:   signal: AbortSignal;
123:   /** Why the request was aborted, if it was. */
124:   readonly reason: 'timeout' | 'cancelled' | null;
125:   dispose(): void;
126: }
127: 
128: export function createRequestControl(callerSignal: AbortSignal | undefined, timeoutMs: number): 
MeetingNoteAiRequestControl {
129:   const controller = new AbortController();
130:   let reason: 'timeout' | 'cancelled' | null = null;
131:   const onCallerAbort = () => {
132:     reason ??= 'cancelled';
133:     controller.abort();
134:   };
135:   if (callerSignal?.aborted) onCallerAbort();
136:   else callerSignal?.addEventListener('abort', onCallerAbort, { once: true });
137:   const timer = setTimeout(() => {
138:     reason ??= 'timeout';
139:     controller.abort();
140:   }, timeoutMs);
141:   return {
142:     signal: controller.signal,
143:     get reason() {
144:       return reason;
145:     },
146:     dispose() {
147:       clearTimeout(timer);
148:       callerSignal?.removeEventListener('abort', onCallerAbort);
149:     },
150:   };
151: }
152: 
153: /**
154:  * Maps anything thrown while sending or reading the response to a failure.
155:  * The decision uses only the dispatch state and the abort reason:
156:  *   not dispatched           → never sent (cancelled before send / invalid configuration)
157:  *   connection refused / DNS → never sent (provider unreachable)
158:  *   deadline / caller abort  → counted timeout / cancellation
159:  *   initial non-2xx          → matrix classification (listed → refunded, else counted)
160:  *   initial 2xx              → counted: the stream had begun (mid-stream error or drop)
161:  *   no response yet          → counted: connection lost after the request was sent
162:  */
163: export function mapMeetingNoteAiTransportError(
164:   provider: MeetingNoteAiProvider,
165:   state: MeetingNoteAiDispatchState,
166:   control: MeetingNoteAiRequestControl
167: ): MeetingNoteAiDraftFailure {
168:   if (!state.dispatched) {
169:     return control.reason
170:       ? meetingNoteAiFailure(provider, 'MEETING_NOTE_AI_CANCELLED_BEFORE_SEND', false)
171:       : meetingNoteAiFailure(provider, 'MEETING_NOTE_AI_CONFIGURATION_INVALID', false);
172:   }
173:   if (state.unreachable) return meetingNoteAiFailure(provider, 'MEETING_NOTE_AI_PROVIDER_UNREACHABLE', true);
174:   const status = state.initialStatus;
175:   if (status !== null && (status < 200 || status >= 300)) {
176:     const category = classifyMeetingNoteAiPreProcessingRejection(provider, status, state.initialErrorBody);
177:     return category
178:       ? meetingNoteAiRejectionFailure(provider, category, status)
179:       : meetingNoteAiFailure(provider, 'MEETING_NOTE_AI_PROVIDER_ERROR', true, { providerStatus: status });
180:   }
181:   if (control.reason === 'timeout') return meetingNoteAiFailure(provider, 'MEETING_NOTE_AI_TIMEOUT', true);
182:   if (control.reason === 'cancelled') return meetingNoteAiFailure(provider, 'MEETING_NOTE_AI_CANCELLED', true);
183:   if (status !== null) return meetingNoteAiFailure(provider, 'MEETING_NOTE_AI_STREAM_INTERRUPTED', true);
184:   return meetingNoteAiFailure(provider, 'MEETING_NOTE_AI_CONNECTION_LOST', true);
185: }
186: 
187: /**
188:  * Merges a capability-matrix wire fragment into a request body: plain-object
189:  * values are merged one level deep (Anthropic `output_config.effort` beside
190:  * `output_config.format`), anything else is set. The fragment holds only
191:  * documented provider fields, so the merged body keeps the base's type.
192:  */
193: export function mergeWireFragment<T extends object>(base: T, wire: Readonly<Record<string, unknown>>): T {
194:   const merged: Record<string, unknown> = { ...(base as Record<string, unknown>) };
195:   for (const [key, value] of Object.entries(wire)) {
196:     const current = merged[key];
197:     const isPlain = (v: unknown): v is Record<string, unknown> => v !== null && typeof v === 'object' && 
!Array.isArray(v);
198:     merged[key] = isPlain(current) && isPlain(value) ? { ...current, ...value } : value;
199:   }
200:   return merged as T;
201: }
202: 
203: /** What an adapter read from a stream that ended without throwing. */
204: export interface MeetingNoteAiStreamOutcome {
205:   /** Concatenated model text (thinking/reasoning content excluded). */
206:   text: string;
207:   /**
208:    * end: normal stop; length: output budget reached (truncated); refusal: the
209:    * model or a provider filter declined; incomplete: the stream ended without
210:    * its stop signal; other: any other stop reason.
211:    */
212:   finish: 'end' | 'length' | 'refusal' | 'incomplete' | 'other';
213:   usage: MeetingNoteAiUsageReport;
214: }
215: 
216: export interface MeetingNoteAiAdapterRequest {
217:   provider: MeetingNoteAiProvider;
218:   apiKey: string;
219:   baseUrl: string;
220:   model: MeetingNoteAiModelCapability;
221:   level: MeetingNoteAiReasoningLevel;
222:   transcript: string;
223:   fetch: (input: FetchInput, init?: RequestInit) => Promise<Response>;
224:   signal: AbortSignal;
225:   /** SDK header timeout; kept above the adapter deadline so the deadline decides. */
226:   sdkTimeoutMs: number;
227: }
src/lib/meeting-notes/ai/adapters/index.ts
1: // src/lib/meeting-notes/ai/adapters/index.ts
2: // Server-only entry point of the meeting-note AI adapters (Phase 6 T11;
3: // SPEC FR-016, FR-020, FR-021, FR-022, AC-026, AC-029). T12 calls
4: // generateMeetingNoteDraft with the snapshot taken at admission and the
5: // transcript ALREADY normalized (normalizeTranscriptForProvider).
6: //
7: // Per call, in order: matrix check of provider/model/reasoning level and key
8: // presence → FR-020 size preflight → base URL (server env override, refused in
9: // production) → caller-abort check → exactly ONE outbound streaming request
10: // (SDK retries off, a second request refused by the transport guard) → stop
11: // reason check → JSON parse + shared draft-schema validation.
12: // Nothing here logs the key, the transcript, or provider text.
13: //
14: // Timeout: 180 s by default (SM-1 expects ≤60 s for a one-hour transcript;
15: // T9's stale job fails dispatched operations after 10 minutes, so the
16: // deadline must stay well below that). The deadline covers the whole streamed
17: // response, not only the headers.
18: import 'server-only';
19: 
20: import type { MeetingNoteAiProvider } from '@/types/meeting-notes';
21: 
22: import { findMeetingNoteAiModel, MEETING_NOTE_AI_CAPABILITIES } from '../capabilities';
23: import { resolveMeetingNoteAiBaseUrl } from '../base-url';
24: import { parseMeetingNoteAiDraft } from '../draft-schema';
25: import { preflightMeetingNoteAiTranscript } from '../preflight';
26: import {
27:   meetingNoteAiFailure,
28:   meetingNoteAiTooLongFailure,
29:   type MeetingNoteAiDraftResult,
30: } from '../provider-errors';
31: import { runAnthropicDraftRequest } from './anthropic';
32: import { runOpenAiCompatibleDraftRequest } from './openai-compatible';
33: import {
34:   createDispatchFetch,
35:   createDispatchState,
36:   createRequestControl,
37:   mapMeetingNoteAiTransportError,
38:   type MeetingNoteAiStreamOutcome,
39: } from './transport';
40: 
41: export const MEETING_NOTE_AI_DEFAULT_TIMEOUT_MS = 180_000;
42: /** Upper bound for a caller-supplied timeout (stale-operation job: 10 min). */
43: export const MEETING_NOTE_AI_MAX_TIMEOUT_MS = 300_000;
44: const SDK_TIMEOUT_MARGIN_MS = 5_000;
45: 
46: export interface GenerateMeetingNoteDraftInput {
47:   provider: MeetingNoteAiProvider;
48:   model: string;
49:   reasoningLevel: string;
50:   /** The company's provider key (from the admission snapshot). Never logged or returned. */
51:   apiKey: string;
52:   /** Normalized transcript; the ONLY content sent to the provider. */
53:   transcript: string;
54:   /** Aborts the outbound request (client left the page). */
55:   signal?: AbortSignal;
56:   /** Deadline for the whole request, 1 ms – 300 s; default 180 s. */
57:   timeoutMs?: number;
58: }
59: 
60: function outcomeFailure(provider: MeetingNoteAiProvider, outcome: MeetingNoteAiStreamOutcome) {
61:   switch (outcome.finish) {
62:     case 'refusal':
63:       return meetingNoteAiFailure(provider, 'MEETING_NOTE_AI_REFUSED', true);
64:     case 'length':
65:       return meetingNoteAiFailure(provider, 'MEETING_NOTE_AI_OUTPUT_TRUNCATED', true);
66:     case 'incomplete':
67:       return meetingNoteAiFailure(provider, 'MEETING_NOTE_AI_STREAM_INTERRUPTED', true);
68:     case 'other':
69:       return meetingNoteAiFailure(provider, 'MEETING_NOTE_AI_OUTPUT_INVALID', true);
70:     case 'end':
71:       return null;
72:   }
73: }
74: 
75: export async function generateMeetingNoteDraft(input: GenerateMeetingNoteDraftInput): 
Promise<MeetingNoteAiDraftResult> {
76:   const { provider } = input;
77:   if (!Object.hasOwn(MEETING_NOTE_AI_CAPABILITIES, provider)) {
78:     // Unknown provider: no label to name; fall back to a neutral one.
79:     return meetingNoteAiFailure('openai', 'MEETING_NOTE_AI_CONFIGURATION_INVALID', false);
80:   }
81:   const model = findMeetingNoteAiModel(provider, input.model);
82:   const level = model?.reasoningLevels.find((entry) => entry.id === input.reasoningLevel);
83:   if (!model || !level || typeof input.apiKey !== 'string' || input.apiKey.trim() === '') {
84:     return meetingNoteAiFailure(provider, 'MEETING_NOTE_AI_CONFIGURATION_INVALID', false);
85:   }
86: 
87:   const preflight = preflightMeetingNoteAiTranscript({ provider, model: model.id, transcript: input.transcript });
88:   if (!preflight.ok) {
89:     return preflight.code === 'MEETING_NOTE_AI_TRANSCRIPT_TOO_LONG_FOR_MODEL'
90:       ? meetingNoteAiTooLongFailure(provider, preflight)
91:       : meetingNoteAiFailure(provider, preflight.code, false);
92:   }
93: 
94:   const baseUrl = resolveMeetingNoteAiBaseUrl(provider);
95:   if (!baseUrl.ok) return meetingNoteAiFailure(provider, baseUrl.code, false);
96: 
97:   if (input.signal?.aborted) return meetingNoteAiFailure(provider, 'MEETING_NOTE_AI_CANCELLED_BEFORE_SEND', false);
98: 
99:   const timeoutMs = Math.min(
100:     Math.max(1, Math.floor(input.timeoutMs ?? MEETING_NOTE_AI_DEFAULT_TIMEOUT_MS)),
101:     MEETING_NOTE_AI_MAX_TIMEOUT_MS
102:   );
103:   const state = createDispatchState();
104:   const control = createRequestControl(input.signal, timeoutMs);
105:   const request = {
106:     provider,
107:     apiKey: input.apiKey,
108:     baseUrl: baseUrl.baseUrl,
109:     model,
110:     level,
111:     transcript: input.transcript,
112:     fetch: createDispatchFetch(state),
113:     signal: control.signal,
114:     sdkTimeoutMs: timeoutMs + SDK_TIMEOUT_MARGIN_MS,
115:   };
116: 
117:   try {
118:     const outcome =
119:       MEETING_NOTE_AI_CAPABILITIES[provider].protocol === 'anthropic-messages'
120:         ? await runAnthropicDraftRequest(request)
121:         : await runOpenAiCompatibleDraftRequest(request);
122: 
123:     // The SDKs end an aborted stream silently: an abort before the stop
124:     // signal is a timeout/cancellation, not a provider failure.
125:     if (outcome.finish === 'incomplete' && control.reason) {
126:       return mapMeetingNoteAiTransportError(provider, state, control);
127:     }
128:     const stopFailure = outcomeFailure(provider, outcome);
129:     if (stopFailure) return stopFailure;
130: 
131:     const parsed = parseMeetingNoteAiDraft(outcome.text);
132:     if (!parsed.ok) {
133:       const code =
134:         parsed.reason === 'empty'
135:           ? 'MEETING_NOTE_AI_OUTPUT_EMPTY'
136:           : parsed.reason === 'malformed'
137:             ? 'MEETING_NOTE_AI_OUTPUT_MALFORMED'
138:             : 'MEETING_NOTE_AI_OUTPUT_INVALID';
139:       return meetingNoteAiFailure(provider, code, true);
140:     }
141:     const hasUsage = outcome.usage.inputTokens !== undefined || outcome.usage.outputTokens !== undefined;
142:     return { ok: true, draft: parsed.draft, dispatched: true, ...(hasUsage ? { usage: outcome.usage } : {}) };
143:   } catch {
144:     // The thrown error is not inspected or logged: SDK errors can carry
145:     // provider text. The dispatch state decides.
146:     return mapMeetingNoteAiTransportError(provider, state, control);
147:   } finally {
148:     control.dispose();
149:   }
150: }
151: 
152: export { preflightMeetingNoteAiTranscript } from '../preflight';
153: export type {
154:   MeetingNoteAiDraftFailure,
155:   MeetingNoteAiDraftResult,
156:   MeetingNoteAiDraftSuccess,
157:   MeetingNoteAiFailureCode,
158:   MeetingNoteAiFailureKind,
159: } from '../provider-errors';
src/lib/meeting-notes/ai/adapters/anthropic.ts
1: // src/lib/meeting-notes/ai/adapters/anthropic.ts
2: // Anthropic Messages adapter (Phase 6 T11) via the official `@anthropic-ai/sdk`.
3: // Request: model, max_tokens = the model's maxOutputTokens, system prompt, ONE
4: // user message holding only the normalized transcript, `output_config` =
5: // { format: json_schema draft schema } merged with the matrix's reasoning
6: // fragment ({ effort }), stream: true. No `thinking` (adaptive is the default
7: // and `disabled`/`budget_tokens` are rejected on these models), no sampling
8: // parameters, no server-side `fallbacks` (FR-016/BR-013: no fallback to a
9: // model the admin did not choose).
10: // Streaming: the initial response (status + headers) is awaited separately
11: // from the event iteration, so an error that arrives after the 200 — such as
12: // an `overloaded_error` SSE event — is "inside an accepted response" and
13: // counted, while an initial 529 can be classified as a rejection (FR-022).
14: import 'server-only';
15: 
16: import Anthropic from '@anthropic-ai/sdk';
17: 
18: import { MEETING_NOTE_AI_DRAFT_JSON_SCHEMA } from '../draft-schema';
19: import { MEETING_NOTE_AI_SYSTEM_PROMPT } from '../prompt';
20: import {
21:   mergeWireFragment,
22:   type MeetingNoteAiAdapterRequest,
23:   type MeetingNoteAiStreamOutcome,
24: } from './transport';
25: 
26: export function buildAnthropicDraftRequest(
27:   request: Pick<MeetingNoteAiAdapterRequest, 'model' | 'level' | 'transcript'>
28: ): Anthropic.MessageCreateParamsStreaming {
29:   const base: Anthropic.MessageCreateParamsStreaming = {
30:     model: request.model.id,
31:     max_tokens: request.model.maxOutputTokens,
32:     system: MEETING_NOTE_AI_SYSTEM_PROMPT,
33:     messages: [{ role: 'user', content: request.transcript }],
34:     output_config: { format: { type: 'json_schema', schema: { ...MEETING_NOTE_AI_DRAFT_JSON_SCHEMA } } },
35:     stream: true,
36:   };
37:   return mergeWireFragment(base, request.level.wire);
38: }
39: 
40: function finishOf(stopReason: string | null, stopped: boolean): MeetingNoteAiStreamOutcome['finish'] {
41:   if (!stopped || stopReason === null) return 'incomplete';
42:   switch (stopReason) {
43:     case 'end_turn':
44:     case 'stop_sequence':
45:       return 'end';
46:     case 'max_tokens':
47:     case 'model_context_window_exceeded':
48:       return 'length';
49:     case 'refusal':
50:       return 'refusal';
51:     default:
52:       return 'other';
53:   }
54: }
55: 
56: export async function runAnthropicDraftRequest(request: MeetingNoteAiAdapterRequest): 
Promise<MeetingNoteAiStreamOutcome> {
57:   const client = new Anthropic({
58:     apiKey: request.apiKey,
59:     // Never pick up ambient credentials or logging from the server environment.
60:     authToken: null,
61:     baseURL: request.baseUrl,
62:     maxRetries: 0,
63:     timeout: request.sdkTimeoutMs,
64:     fetch: request.fetch,
65:     logLevel: 'off',
66:   });
67: 
68:   // Phase 1: resolves once a 2xx response's headers arrived; a non-2xx
69:   // initial response or a connection failure throws here.
70:   const stream = await client.messages.create(buildAnthropicDraftRequest(request), { signal: request.signal });
71: 
72:   // Phase 2: everything below is inside an accepted response.
73:   let text = '';
74:   let stopReason: string | null = null;
75:   let stopped = false;
76:   const usage: MeetingNoteAiStreamOutcome['usage'] = {};
77:   for await (const event of stream) {
78:     switch (event.type) {
79:       case 'message_start':
80:         usage.inputTokens = event.message.usage.input_tokens;
81:         break;
82:       case 'content_block_delta':
83:         if (event.delta.type === 'text_delta') text += event.delta.text;
84:         break;
85:       case 'message_delta':
86:         stopReason = event.delta.stop_reason;
87:         usage.outputTokens = event.usage.output_tokens;
88:         break;
89:       case 'message_stop':
90:         stopped = true;
91:         break;
92:       default:
93:         break;
94:     }
95:   }
96:   return { text, finish: finishOf(stopReason, stopped), usage };
97: }
src/lib/meeting-notes/ai/adapters/openai-compatible.ts
1: // src/lib/meeting-notes/ai/adapters/openai-compatible.ts
2: // Chat Completions adapter for OpenAI, Kimi, and GLM (Phase 6 T11) via the
3: // official `openai` SDK pointed at each provider's OpenAI-compatible base URL.
4: // Request: model, [system prompt, ONE user message holding only the normalized
5: // transcript], the matrix's output-budget field (`max_completion_tokens` or
6: // GLM's `max_tokens`) = the model's maxOutputTokens, `response_format`
7: // (json_schema strict for OpenAI/Kimi, json_object for GLM — validated after
8: // parsing), the matrix's reasoning fragment (`reasoning_effort` or GLM's
9: // `thinking`), stream: true, and — OpenAI only — `stream_options.include_usage`.
10: // No temperature/top_p (fixed or unsupported on these reasoning models).
11: // Streaming: as in the Anthropic adapter, the initial response is awaited
12: // separately from the chunk iteration, so a `data: {"error":…}` chunk after the
13: // 200 is counted while an initial listed rejection can be refunded (FR-022).
14: import 'server-only';
15: 
16: import OpenAI from 'openai';
17: import type { ChatCompletionCreateParamsStreaming } from 'openai/resources/chat/completions';
18: import type { ResponseFormatJSONObject, ResponseFormatJSONSchema } from 'openai/resources/shared';
19: 
20: import { MEETING_NOTE_AI_CAPABILITIES } from '../capabilities';
21: import { MEETING_NOTE_AI_DRAFT_JSON_SCHEMA, MEETING_NOTE_AI_DRAFT_SCHEMA_NAME } from '../draft-schema';
22: import { MEETING_NOTE_AI_SYSTEM_PROMPT } from '../prompt';
23: import {
24:   mergeWireFragment,
25:   type MeetingNoteAiAdapterRequest,
26:   type MeetingNoteAiStreamOutcome,
27: } from './transport';
28: 
29: export function buildOpenAiCompatibleDraftRequest(
30:   request: Pick<MeetingNoteAiAdapterRequest, 'provider' | 'model' | 'level' | 'transcript'>
31: ): ChatCompletionCreateParamsStreaming {
32:   const capability = MEETING_NOTE_AI_CAPABILITIES[request.provider];
33:   const responseFormat: ResponseFormatJSONSchema | ResponseFormatJSONObject =
34:     capability.jsonOutput === 'json_schema'
35:       ? {
36:           type: 'json_schema',
37:           json_schema: { name: MEETING_NOTE_AI_DRAFT_SCHEMA_NAME, strict: true, schema: { 
...MEETING_NOTE_AI_DRAFT_JSON_SCHEMA } },
38:         }
39:       : { type: 'json_object' };
40:   const base: ChatCompletionCreateParamsStreaming = {
41:     model: request.model.id,
42:     messages: [
43:       { role: 'system', content: MEETING_NOTE_AI_SYSTEM_PROMPT },
44:       { role: 'user', content: request.transcript },
45:     ],
46:     response_format: responseFormat,
47:     stream: true,
48:     ...(request.provider === 'openai' ? { stream_options: { include_usage: true } } : {}),
49:   };
50:   if (capability.outputBudgetParam === 'max_completion_tokens') base.max_completion_tokens = 
request.model.maxOutputTokens;
51:   else base.max_tokens = request.model.maxOutputTokens;
52:   return mergeWireFragment(base, request.level.wire);
53: }
54: 
55: function finishOf(finishReason: string | null, refused: boolean): MeetingNoteAiStreamOutcome['finish'] {
56:   if (refused) return 'refusal';
57:   switch (finishReason) {
58:     case null:
59:       return 'incomplete';
60:     case 'stop':
61:       return 'end';
62:     case 'length':
63:       return 'length';
64:     // OpenAI/Kimi content filter; GLM "sensitive".
65:     case 'content_filter':
66:     case 'sensitive':
67:       return 'refusal';
68:     default:
69:       return 'other';
70:   }
71: }
72: 
73: export async function runOpenAiCompatibleDraftRequest(
74:   request: MeetingNoteAiAdapterRequest
75: ): Promise<MeetingNoteAiStreamOutcome> {
76:   const client = new OpenAI({
77:     apiKey: request.apiKey,
78:     // Never pick up ambient credentials, organization/project ids, or logging
79:     // from the server environment (they would also leak to Kimi/GLM).
80:     adminAPIKey: null,
81:     organization: null,
82:     project: null,
83:     webhookSecret: null,
84:     baseURL: request.baseUrl,
85:     maxRetries: 0,
86:     timeout: request.sdkTimeoutMs,
87:     fetch: request.fetch,
88:     logLevel: 'off',
89:   });
90: 
91:   // Phase 1: initial response (non-2xx and connection failures throw here).
92:   const stream = await client.chat.completions.create(buildOpenAiCompatibleDraftRequest(request), {
93:     signal: request.signal,
94:   });
95: 
96:   // Phase 2: inside an accepted response.
97:   let text = '';
98:   let refused = false;
99:   let finishReason: string | null = null;
100:   const usage: MeetingNoteAiStreamOutcome['usage'] = {};
101:   for await (const chunk of stream) {
102:     if (chunk.usage) {
103:       usage.inputTokens = chunk.usage.prompt_tokens;
104:       usage.outputTokens = chunk.usage.completion_tokens;
105:     }
106:     const choice = chunk.choices?.[0];
107:     if (!choice) continue;
108:     if (typeof choice.delta?.content === 'string') text += choice.delta.content;
109:     if (choice.delta?.refusal) refused = true;
110:     if (choice.finish_reason) finishReason = choice.finish_reason;
111:   }
112:   return { text, finish: finishOf(finishReason, refused), usage };
113: }

