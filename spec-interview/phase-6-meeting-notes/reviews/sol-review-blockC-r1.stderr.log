1: // src/app/api/meeting-notes/[id]/transcript/route.ts
2: import { NextRequest, NextResponse } from 'next/server';
3: import { loadMeetingNoteDetail } from '@/lib/meeting-notes/note-detail';
4: import {
5:   beginMeetingNoteRequest,
6:   internalError,
7:   noteMutationErrorResponse,
8:   notFound,
9:   ok,
10:   parsePathId,
11:   parseWith,
12: } from '@/lib/meeting-notes/route-support';
13: import { readTranscriptUpload } from '@/lib/meeting-notes/transcript-upload';
14: import { expectedRevisionParamSchema } from '@/lib/meeting-notes/validation';
15: 
16: export const dynamic = 'force-dynamic';
17: 
18: interface RouteParams {
19:   params: Promise<{ id: string }>;
20: }
21: 
22: /**
23:  * PUT /api/meeting-notes/[id]/transcript — "Attach transcript" (FR-012,
24:  * BR-010): an editor (author, participant, or admin, while a member)
25:  * replaces the stored transcript. Body: multipart/form-data with
26:  * `expectedRevision` (the note revision the editor saw) and one `file`
27:  * (.txt/.vtt/.srt, 1 byte..1 MB, UTF-8 text; FR-013), validated before
28:  * anything is written. The transcript gets a new identity, the revision is
29:  * bumped, and one version (unchanged fields) records who replaced it; title,
30:  * date, participants, content, summary, and items are untouched.
31:  * 200 { note }; 409 { code: MEETING_NOTE_STALE_REVISION, currentRevision,
32:  * note } when another change landed first (FR-007); 403 for a non-editor;
33:  * 404 for a note outside the caller's company.
34:  */
35: export async function PUT(request: NextRequest, { params }: RouteParams): Promise<NextResponse> {
36:   const begun = await beginMeetingNoteRequest('/api/meeting-notes/[id]/transcript', 'meeting-note:transcript');
37:   if (!begun.ok) {
38:     await request.body?.cancel().catch(() => undefined);
39:     return begun.response;
40:   }
41:   const ctx = begun.value;
42: 
43:   const id = parsePathId((await params).id, 'MEETING_NOTE_NOT_FOUND', ctx);
44:   if (!id.ok) {
45:     await request.body?.cancel().catch(() => undefined);
46:     return id.response;
47:   }
48: 
49:   const upload = await readTranscriptUpload(request, ['expectedRevision'], ctx);
50:   if (!upload.ok) return upload.response;
51: 
52:   const revision = parseWith(
53:     expectedRevisionParamSchema('MEETING_NOTE_REVISION_REQUIRED'),
54:     upload.value.fields.get('expectedRevision'),
55:     ctx
56:   );
57:   if (!revision.ok) return revision.response;
58: 
59:   try {
60:     await ctx.repository.attachTranscript({
61:       noteId: id.value,
62:       expectedRevision: revision.value,
63:       transcript: upload.value.text,
64:     });
65:   } catch (error) {
66:     return noteMutationErrorResponse(error, ctx, id.value, 'meetingNotes.transcript.attach');
67:   }
68: 
69:   try {
70:     const note = await loadMeetingNoteDetail(ctx.repository, ctx.dbUser, id.value);
71:     // Deleted by another request right after this change committed.
72:     if (!note) return notFound('MEETING_NOTE_NOT_FOUND', ctx);
73:     return ok({ note }, ctx);
74:   } catch (error) {
75:     return internalError(error, ctx, 'meetingNotes.transcript.attach.load');
76:   }
77: }
src/lib/messaging/metrics-log.ts
1: import 'server-only';
2: 
3: import packageJson from '../../../package.json';
4: import {
5:   MESSAGING_METRIC_CONVERSATION_TYPES,
6:   MESSAGING_METRIC_TYPES,
7:   MESSAGING_METRIC_TYPE_RULES,
8:   MESSAGING_METRICS_EARLIEST_EVENT_TIME_MS,
9:   MESSAGING_METRICS_MAX_CLOCK_SKEW_MS,
10:   MESSAGING_METRICS_MAX_COUNT,
11:   messagingMetricsMaxDurationMs,
12:   type MessagingMetricConversationType,
13:   type MessagingMetricReason,
14:   type MessagingMetricType,
15: } from '@/lib/messaging/metrics-contract';
16: 
17: /**
18:  * One metric log line (BR-013): closed-enum event type and reason, bounded
19:  * duration/count, conversation type, timestamps, and the server-derived app
20:  * version — and nothing else (no tag field). Built only from validated
21:  * values, never from client strings.
22:  */
23: export interface MessagingMetricLogLine {
24:   /** Server receive time (ISO 8601). */
25:   ts: string;
26:   appVersion: string;
27:   type: MessagingMetricType;
28:   reason?: MessagingMetricReason;
29:   conversationType?: MessagingMetricConversationType;
30:   durationMs?: number;
31:   count?: number;
32:   /** Client event time (ISO 8601), only when within the accepted window. */
33:   occurredAt?: string;
34: }
35: 
36: const VERSION_PATTERN = /^[0-9A-Za-z.-]{1,32}$/;
37: const COMMIT_SHA_PATTERN = /^[0-9a-f]{7,40}$/i;
38: 
39: /**
40:  * App version derived on the server only: the package version plus the
41:  * deployment's git commit (Vercel system variable VERCEL_GIT_COMMIT_SHA,
42:  * first 12 hex chars) or `local` when the server runs outside a deployment.
43:  * Any client-supplied version is ignored.
44:  */
45: export function serverAppVersion(): string {
46:   const version = typeof packageJson.version === 'string' && VERSION_PATTERN.test(packageJson.version)
47:     ? packageJson.version
48:     : 'unknown';
49:   const sha = process.env.VERCEL_GIT_COMMIT_SHA;
50:   const build = typeof sha === 'string' && COMMIT_SHA_PATTERN.test(sha) ? sha.slice(0, 12).toLowerCase() : 'local';
51:   return `${version}+${build}`;
52: }
53: 
54: function isRecord(value: unknown): value is Record<string, unknown> {
55:   return typeof value === 'object' && value !== null && !Array.isArray(value);
56: }
57: 
58: function isOneOf<T extends string>(values: readonly T[], value: unknown): value is T {
59:   return typeof value === 'string' && (values as readonly string[]).includes(value);
60: }
61: 
62: function isBoundedInteger(value: unknown, max: number): value is number {
63:   return typeof value === 'number' && Number.isSafeInteger(value) && value >= 0 && value <= max;
64: }
65: 
66: /**
67:  * Validates one client event against the closed contract and returns its log
68:  * line, or null when the event must be dropped: not an object, unknown type,
69:  * a missing required field, or ANY known field present with an invalid value
70:  * (wrong enum, wrong type, out of range, or not allowed for its type).
71:  * Unknown fields are ignored and never copied.
72:  */
73: export function toMessagingMetricLogLine(
74:   input: unknown,
75:   context: { now: number; appVersion: string },
76: ): MessagingMetricLogLine | null {
77:   if (!isRecord(input) || !isOneOf(MESSAGING_METRIC_TYPES, input.type)) {
78:     return null;
79:   }
80:   const type = input.type;
81:   const rule = MESSAGING_METRIC_TYPE_RULES[type];
82:   const line: MessagingMetricLogLine = {
83:     ts: new Date(context.now).toISOString(),
84:     appVersion: context.appVersion,
85:     type,
86:   };
87: 
88:   if (input.reason !== undefined) {
89:     if (!rule.reasons || !isOneOf(rule.reasons, input.reason)) return null;
90:     line.reason = input.reason;
91:   } else if (rule.reasonRequired) {
92:     return null;
93:   }
94: 
95:   if (input.conversationType !== undefined) {
96:     if (!rule.allowsConversationType || !isOneOf(MESSAGING_METRIC_CONVERSATION_TYPES, input.conversationType)) {
97:       return null;
98:     }
99:     line.conversationType = input.conversationType;
100:   }
101: 
102:   if (input.durationMs !== undefined) {
103:     if (!rule.allowsDuration || !isBoundedInteger(input.durationMs, messagingMetricsMaxDurationMs(context.now))) 
return null;
104:     line.durationMs = input.durationMs;
105:   } else if (rule.durationRequired) {
106:     return null;
107:   }
108: 
109:   if (input.count !== undefined) {
110:     if (!rule.allowsCount || !isBoundedInteger(input.count, MESSAGING_METRICS_MAX_COUNT)) return null;
111:     line.count = input.count;
112:   }
113: 
114:   if (input.occurredAt !== undefined) {
115:     const occurredAt = input.occurredAt;
116:     if (
117:       typeof occurredAt !== 'number' ||
118:       !Number.isSafeInteger(occurredAt) ||
119:       occurredAt < MESSAGING_METRICS_EARLIEST_EVENT_TIME_MS ||
120:       occurredAt > context.now + MESSAGING_METRICS_MAX_CLOCK_SKEW_MS
121:     ) {
122:       return null;
123:     }
124:     line.occurredAt = new Date(occurredAt).toISOString();
125:   }
126: 
127:   return line;
128: }
129: 
130: /** Writes one structured line per accepted event; logging never fails the request. */
131: export function writeMessagingMetricLines(lines: readonly MessagingMetricLogLine[]): void {
132:   for (const line of lines) {
133:     try {
134:       console.info(JSON.stringify(line));
135:     } catch {
136:       // Observability is never part of the response path.
137:     }
138:   }
139: }
140: 
141: export type BoundedBodyResult =
142:   | { ok: true; bytes: Uint8Array }
143:   | { ok: false; reason: 'too_large' | 'unreadable' };
144: 
145: /**
146:  * Reads the raw request body, refusing it as soon as more than `maxBytes`
147:  * arrive. A declared Content-Length over the limit is refused without
148:  * reading, but the limit is always enforced on the bytes actually received,
149:  * so a missing (chunked) or understated Content-Length cannot bypass it.
150:  */
151: export async function readBoundedBody(request: Request, maxBytes: number): Promise<BoundedBodyResult> {
152:   const declared = request.headers.get('content-length');
153:   if (declared !== null && /^\d+$/.test(declared.trim()) && Number(declared.trim()) > maxBytes) {
154:     await request.body?.cancel().catch(() => undefined);
155:     return { ok: false, reason: 'too_large' };
156:   }
157:   if (!request.body) {
158:     return { ok: true, bytes: new Uint8Array(0) };
159:   }
160: 
161:   const reader = request.body.getReader();
162:   const chunks: Uint8Array[] = [];
163:   let total = 0;
164:   try {
165:     for (;;) {
166:       const { done, value } = await reader.read();
167:       if (done) break;
168:       total += value.byteLength;
169:       if (total > maxBytes) {
170:         await reader.cancel().catch(() => undefined);
171:         return { ok: false, reason: 'too_large' };
172:       }
173:       chunks.push(value);
174:     }
175:   } catch {
176:     return { ok: false, reason: 'unreadable' };
177:   }
178: 
179:   const bytes = new Uint8Array(total);
180:   let offset = 0;
181:   for (const chunk of chunks) {
182:     bytes.set(chunk, offset);
183:     offset += chunk.byteLength;
184:   }
185:   return { ok: true, bytes };
186: }

