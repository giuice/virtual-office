1: // src/app/api/meeting-notes/transcript/route.ts
2: import { NextRequest, NextResponse } from 'next/server';
3: import { loadMeetingNoteDetail } from '@/lib/meeting-notes/note-detail';
4: import {
5:   beginMeetingNoteRequest,
6:   internalError,
7:   meetingNoteError,
8:   noteMutationErrorResponse,
9:   notFound,
10:   ok,
11: } from '@/lib/meeting-notes/route-support';
12: import { readTranscriptUpload, transcriptTitleFromFileName } from '@/lib/meeting-notes/transcript-upload';
13: import { pathIdSchema } from '@/lib/meeting-notes/validation';
14: 
15: export const dynamic = 'force-dynamic';
16: 
17: /**
18:  * POST /api/meeting-notes/transcript — "New note from transcript" (FR-012).
19:  * Body: multipart/form-data with `spaceId` (a space of the caller's company)
20:  * and one `file` (.txt/.vtt/.srt, 1 byte..1 MB, UTF-8 text; FR-013). The file
21:  * is validated before anything is written; then one transaction creates the
22:  * note (title = file name without extension, <= 200 chars; meeting date =
23:  * now; empty content; no participants), stores the transcript, and creates
24:  * version 1. 201 { note } (the transcript text is never echoed; read it with
25:  * GET /api/meeting-notes/[id]?include=transcript).
26:  */
27: export async function POST(request: NextRequest): Promise<NextResponse> {
28:   const begun = await beginMeetingNoteRequest('/api/meeting-notes/transcript', 'meeting-note:transcript');
29:   if (!begun.ok) {
30:     await request.body?.cancel().catch(() => undefined);
31:     return begun.response;
32:   }
33:   const ctx = begun.value;
34: 
35:   const upload = await readTranscriptUpload(request, ['spaceId'], ctx);
36:   if (!upload.ok) return upload.response;
37: 
38:   const spaceId = pathIdSchema.safeParse(upload.value.fields.get('spaceId'));
39:   if (!spaceId.success) return meetingNoteError(400, 'MEETING_NOTE_SPACE_INVALID', ctx);
40: 
41:   let noteId: string;
42:   try {
43:     const created = await ctx.repository.createNoteFromTranscript({
44:       roomId: spaceId.data,
45:       title: transcriptTitleFromFileName(upload.value.fileName),
46:       transcript: upload.value.text,
47:     });
48:     noteId = created.noteId;
49:   } catch (error) {
50:     return noteMutationErrorResponse(error, ctx, '', 'meetingNotes.transcript.create');
51:   }
52: 
53:   try {
54:     const note = await loadMeetingNoteDetail(ctx.repository, ctx.dbUser, noteId);
55:     // Deleted by another request right after this change committed.
56:     if (!note) return notFound('MEETING_NOTE_NOT_FOUND', ctx);
57:     return ok({ note }, ctx, 201);
58:   } catch (error) {
59:     return internalError(error, ctx, 'meetingNotes.transcript.create.load');
60:   }
61: }
