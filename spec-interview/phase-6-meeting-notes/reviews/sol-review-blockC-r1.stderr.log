98: /** Request body the matrix prescribes, built independently of the adapters. */
99: function expectedBody(provider: MeetingNoteAiProvider, modelId: string, levelId: string): Record<string, unknown> {
100:   const capability = MEETING_NOTE_AI_CAPABILITIES[provider];
101:   const model = findMeetingNoteAiModel(provider, modelId);
102:   const level = model?.reasoningLevels.find((entry) => entry.id === levelId);
103:   if (!model || !level) throw new Error(`not in the matrix: ${provider}/${modelId}/${levelId}`);
104:   if (provider === 'anthropic') {
105:     const effort = (level.wire.output_config as { effort: string }).effort;
106:     expect(Object.keys(level.wire)).toEqual(['output_config']);
107:     return {
108:       model: modelId,
109:       max_tokens: model.maxOutputTokens,
110:       system: MEETING_NOTE_AI_SYSTEM_PROMPT,
111:       messages: [{ role: 'user', content: TRANSCRIPT }],
112:       output_config: { format: { type: 'json_schema', schema: MEETING_NOTE_AI_DRAFT_JSON_SCHEMA }, effort },
113:       stream: true,
114:     };
115:   }
116:   return {
117:     model: modelId,
118:     messages: [
119:       { role: 'system', content: MEETING_NOTE_AI_SYSTEM_PROMPT },
120:       { role: 'user', content: TRANSCRIPT },
121:     ],
122:     response_format:
123:       capability.jsonOutput === 'json_schema'
124:         ? { type: 'json_schema', json_schema: { name: 'meeting_note_draft', strict: true, schema: 
MEETING_NOTE_AI_DRAFT_JSON_SCHEMA } }
125:         : { type: 'json_object' },
126:     stream: true,
127:     ...(provider === 'openai' ? { stream_options: { include_usage: true } } : {}),
128:     [capability.outputBudgetParam]: model.maxOutputTokens,
129:     ...level.wire,
130:   };
131: }
132: 
133: function generate(
134:   provider: MeetingNoteAiProvider,
135:   overrides: Partial<{ model: string; level: string; transcript: string; signal: AbortSignal; timeoutMs: number; 
apiKey: string }> = {}
136: ): Promise<MeetingNoteAiDraftResult> {
137:   const selection = DEFAULT_SELECTION[provider];
138:   return generateMeetingNoteDraft({
139:     provider,
140:     model: overrides.model ?? selection.model,
141:     reasoningLevel: overrides.level ?? selection.level,
142:     apiKey: overrides.apiKey ?? CANARY_KEYS[provider],
143:     transcript: overrides.transcript ?? TRANSCRIPT,
144:     signal: overrides.signal,
145:     timeoutMs: overrides.timeoutMs,
146:   });
147: }
