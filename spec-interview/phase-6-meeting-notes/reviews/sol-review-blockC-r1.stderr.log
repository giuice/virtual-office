54: const OUTCOME_KINDS: ReadonlySet<string> = new Set<FakeAiOutcomeKind>([
55:   'success',
56:   'error_after_processing',
57:   'timeout',
58:   'refusal',
59:   'malformed_json',
60:   'rejection',
61:   'status',
62:   'stream_error_after_start',
63:   'drop_after_accept',
64:   'pause',
65: ]);
