10:   anthropic: 'fake-self-check-anthropic-canary-a001',
11:   openai: 'fake-self-check-openai-canary-o002',
12:   kimi: 'fake-self-check-kimi-canary-k003',
13:   glm: 'fake-self-check-glm-canary-g004',
14: };
