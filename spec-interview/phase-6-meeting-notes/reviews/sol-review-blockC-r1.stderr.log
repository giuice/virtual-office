153: class FakeAiServerState {
154:   private queues = providerRecord<FakeAiOutcome[]>(() => []);
155:   private defaults = providerRecord<FakeAiOutcome | null>(() => null);
156:   private records: FakeAiRecordedRequest[] = [];
157:   private held = new Set<HeldRequest>();
158:   private timers = new Set<NodeJS.Timeout>();
159:   private seq = 0;
160:   closing = false;
161: 
162:   // ------------------------------------------------------------------ control
163: 
164:   handleControl(method: string, path: string, query: URLSearchParams, body: unknown, res: ServerResponse): void {
165:     const route = `${method} ${path}`;
166:     const input = (body ?? {}) as Record<string, unknown>;
167:     switch (route) {
168:       case 'GET /__control/health':
169:         return sendControlJson(res, 200, { ok: true });
170:       case 'POST /__control/script': {
171:         const provider = this.requireProvider(input.provider);
172:         if (!Array.isArray(input.outcomes) || input.outcomes.length === 0) {
173:           throw new ControlError('outcomes must be a non-empty array');
174:         }
175:         const outcomes = input.outcomes.map((value, i) => assertOutcome(value, `outcomes[${i}]`));
176:         this.queues[provider].push(...outcomes);
177:         return sendControlJson(res, 200, { queued: this.queues[provider].length });
178:       }
179:       case 'POST /__control/default': {
180:         const provider = this.requireProvider(input.provider);
181:         this.defaults[provider] = input.outcome == null ? null : assertOutcome(input.outcome, 'outcome');
182:         return sendControlJson(res, 200, { ok: true });
183:       }
184:       case 'POST /__control/release': {
185:         const provider = input.provider === undefined ? null : this.requireProvider(input.provider);
186:         return sendControlJson(res, 200, { released: this.release(provider) });
187:       }
188:       case 'GET /__control/requests': {
189:         const filter = query.get('provider');
190:         const requests = filter ? this.records.filter((record) => record.provider === filter) : this.records;
191:         const response: FakeAiRequestsResponse = { requests, received: this.receivedCounts() };
192:         return sendControlJson(res, 200, response);
193:       }
194:       case 'GET /__control/state':
195:         return sendControlJson(res, 200, this.snapshot());
196:       case 'POST /__control/reset': {
197:         const dropped = this.reset();
198:         return sendControlJson(res, 200, { ok: true, dropped });
199:       }
200:       default:
201:         return sendControlJson(res, 404, { error: `unknown control route ${route}` });
202:     }
203:   }
204: 
205:   private requireProvider(value: unknown): FakeAiProvider {
206:     if (!isProvider(value)) throw new ControlError(`provider must be one of ${FAKE_AI_PROVIDERS.join(', ')}`);
207:     return value;
208:   }
209: 
210:   private receivedCounts(): Record<FakeAiProvider, number> {
211:     const counts = providerRecord(() => 0);
212:     for (const record of this.records) if (record.provider) counts[record.provider] += 1;
213:     return counts;
214:   }
