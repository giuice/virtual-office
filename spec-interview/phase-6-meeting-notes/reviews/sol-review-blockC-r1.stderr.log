src/lib/meeting-notes/transcript-upload.ts
1: // src/lib/meeting-notes/transcript-upload.ts
2: // Phase 6 T10 (FR-012, FR-013, AC-011): reads a multipart/form-data transcript
3: // upload with a bounded body and validates the file BEFORE any database write:
4: // extension .txt/.vtt/.srt (case-insensitive), non-empty, at most 1 MB,
5: // UTF-8 text (fatal decoding; known binary signatures, NUL bytes, and other
6: // control characters are refused). The text is returned as uploaded, minus a
7: // UTF-8 BOM and with nothing else changed (FR-005: viewers see what was
8: // uploaded); src/lib/meeting-notes/ai/transcript-normalizer.ts prepares it
9: // for a provider. No transcript text is ever logged or echoed in errors.
10: import 'server-only';
11: 
12: import type { NextResponse } from 'next/server';
13: import { readBoundedBody } from '@/lib/messaging/metrics-log';
14: import { meetingNoteError } from './route-support';
15: import { codePointLength, MEETING_NOTE_LIMITS, MEETING_NOTE_TRANSCRIPT_LIMITS } from './validation';
16: 
17: type Result<T> = { ok: true; value: T } | { ok: false; response: NextResponse };
18: 
19: export interface TranscriptUpload {
20:   /** The uploaded file's name (base name only). */
21:   fileName: string;
22:   /** The decoded text (UTF-8 BOM removed; otherwise exactly as uploaded). */
23:   text: string;
24:   /** The single-valued text fields sent next to the file. */
25:   fields: Map<string, string>;
26: }
27: 
28: /** Room for the multipart framing, the file name, and the small text fields. */
29: const MULTIPART_OVERHEAD_BYTES = 64 * 1024;
30: const MAX_REQUEST_BYTES = MEETING_NOTE_TRANSCRIPT_LIMITS.maxBytes + MULTIPART_OVERHEAD_BYTES;
31: const MAX_FIELD_CHARS = 256;
32: 
33: /**
34:  * Leading bytes of common binary formats someone could rename to .txt. Most
35:  * binaries also fail the NUL / UTF-8 / control-character checks below; the
36:  * signatures catch the ones that can start with plain ASCII (PDF, RTF) and
37:  * make the refusal independent of the rest of the file. Purely textual
38:  * prefixes that a real transcript could start with (e.g. "RIFF") are not
39:  * listed.
40:  */
41: const BINARY_SIGNATURES: readonly (readonly number[])[] = [
42:   [0x25, 0x50, 0x44, 0x46, 0x2d], // %PDF-
43:   [0x7b, 0x5c, 0x72, 0x74, 0x66], // RTF ("{\rtf")
44:   [0x50, 0x4b, 0x03, 0x04], // ZIP (.docx, .xlsx, .odt, ...)
45:   [0x50, 0x4b, 0x05, 0x06], // empty ZIP
46:   [0xd0, 0xcf, 0x11, 0xe0], // OLE compound file (.doc, .xls)
47:   [0x89, 0x50, 0x4e, 0x47], // PNG
48:   [0xff, 0xd8, 0xff], // JPEG
49:   [0x1f, 0x8b], // gzip
50:   [0x37, 0x7a, 0xbc, 0xaf], // 7z
51:   [0x1a, 0x45, 0xdf, 0xa3], // Matroska / WebM
52: ];
53: 
54: // C0 controls other than tab, line feed, form feed, and carriage return, and
55: // DEL: never part of a text transcript, typical of binary data.
56: const BINARY_CONTROL = /[\u0000-\u0008\u000B\u000E-\u001F\u007F]/;
57: const NAME_CONTROL = /[\u0000-\u001F\u007F-\u009F]/g;
58: 
59: function hasBinarySignature(bytes: Uint8Array): boolean {
60:   return BINARY_SIGNATURES.some(
61:     (signature) => bytes.length >= signature.length && signature.every((byte, index) => bytes[index] === byte)
62:   );
63: }
64: 
65: function extensionOf(fileName: string): string {
66:   const dot = fileName.lastIndexOf('.');
67:   return dot < 0 ? '' : fileName.slice(dot).toLowerCase();
68: }
69: 
70: function baseNameOf(fileName: string): string {
71:   return fileName.slice(Math.max(fileName.lastIndexOf('/'), fileName.lastIndexOf('\\')) + 1);
72: }
73: 
74: /**
75:  * The note title for "New note from transcript" (FR-012): the file name
76:  * without its extension, control characters replaced by spaces, trimmed, and
77:  * cut to 200 code points; "Transcript" when nothing usable remains.
78:  */
79: export function transcriptTitleFromFileName(fileName: string): string {
80:   const base = baseNameOf(fileName);
81:   const dot = base.lastIndexOf('.');
82:   const stem = (dot < 0 ? base : base.slice(0, dot)).replace(NAME_CONTROL, ' ').trim();
83:   const title = Array.from(stem).slice(0, MEETING_NOTE_LIMITS.titleMaxChars).join('').trim();
84:   return title && title.isWellFormed() && codePointLength(title) <= MEETING_NOTE_LIMITS.titleMaxChars
85:     ? title
86:     : MEETING_NOTE_TRANSCRIPT_LIMITS.fallbackTitle;
87: }
88: 
89: function reject(
90:   status: number,
91:   code: string,
92:   ctx: { correlationId: string }
93: ): { ok: false; response: NextResponse } {
94:   return { ok: false, response: meetingNoteError(status, code, ctx) };
95: }
96: 
97: /** Validates the file's bytes and decodes them (FR-013). */
98: function decodeTranscript(bytes: Uint8Array, ctx: { correlationId: string }): Result<string> {
99:   if (bytes.byteLength === 0) return reject(400, 'MEETING_NOTE_TRANSCRIPT_EMPTY', ctx);
100:   if (bytes.byteLength > MEETING_NOTE_TRANSCRIPT_LIMITS.maxBytes) {
101:     return reject(413, 'MEETING_NOTE_TRANSCRIPT_TOO_LARGE', ctx);
102:   }
103:   if (hasBinarySignature(bytes) || bytes.includes(0)) {
104:     return reject(400, 'MEETING_NOTE_TRANSCRIPT_NOT_TEXT', ctx);
105:   }
106:   let text: string;
107:   try {
108:     // ignoreBOM: false (default) drops a leading UTF-8 BOM.
109:     text = new TextDecoder('utf-8', { fatal: true }).decode(bytes);
110:   } catch {
111:     return reject(400, 'MEETING_NOTE_TRANSCRIPT_NOT_TEXT', ctx);
112:   }
113:   if (BINARY_CONTROL.test(text)) return reject(400, 'MEETING_NOTE_TRANSCRIPT_NOT_TEXT', ctx);
114:   if (text.trim() === '') return reject(400, 'MEETING_NOTE_TRANSCRIPT_EMPTY', ctx);
115:   return { ok: true, value: text };
116: }
117: 
118: /**
119:  * Reads a multipart/form-data body holding exactly one `file` part and the
120:  * text fields named in `fieldNames` (each at most once), with the whole body
121:  * bounded (Content-Length checked first, then the stream counted). Every
122:  * refusal is a 4xx response with a stable code; nothing has been written.
123:  */
124: export async function readTranscriptUpload(
125:   request: Request,
126:   fieldNames: readonly string[],
127:   ctx: { correlationId: string }
128: ): Promise<Result<TranscriptUpload>> {
129:   const contentType = request.headers.get('content-type') ?? '';
130:   if (contentType.split(';')[0].trim().toLowerCase() !== 'multipart/form-data') {
131:     await request.body?.cancel().catch(() => undefined);
132:     return reject(415, 'MEETING_NOTE_TRANSCRIPT_UPLOAD_INVALID', ctx);
133:   }
134: 
135:   const body = await readBoundedBody(request, MAX_REQUEST_BYTES);
136:   if (!body.ok) {
137:     return body.reason === 'too_large'
138:       ? reject(413, 'MEETING_NOTE_TRANSCRIPT_TOO_LARGE', ctx)
139:       : reject(400, 'MEETING_NOTE_TRANSCRIPT_UPLOAD_INVALID', ctx);
140:   }
141: 
142:   let form: FormData;
143:   try {
144:     form = await new Response(new Blob([new Uint8Array(body.bytes)]), { headers: { 'content-type': contentType } 
}).formData();
145:   } catch {
146:     return reject(400, 'MEETING_NOTE_TRANSCRIPT_UPLOAD_INVALID', ctx);
147:   }
148: 
149:   const allowed = new Set(['file', ...fieldNames]);
150:   const fields = new Map<string, string>();
151:   for (const name of new Set(form.keys())) {
152:     const values = form.getAll(name);
153:     if (!allowed.has(name) || values.length !== 1) {
154:       return reject(400, 'MEETING_NOTE_TRANSCRIPT_UPLOAD_INVALID', ctx);
155:     }
156:     const [value] = values;
157:     if (name === 'file') continue;
158:     if (typeof value !== 'string' || value.length > MAX_FIELD_CHARS) {
159:       return reject(400, 'MEETING_NOTE_TRANSCRIPT_UPLOAD_INVALID', ctx);
160:     }
161:     fields.set(name, value);
162:   }
163: 
164:   const file = form.get('file');
165:   if (file === null || typeof file === 'string') {
166:     return reject(400, 'MEETING_NOTE_TRANSCRIPT_UPLOAD_INVALID', ctx);
167:   }
168: 
169:   const fileName = baseNameOf(file.name ?? '');
170:   if (!(MEETING_NOTE_TRANSCRIPT_LIMITS.extensions as readonly string[]).includes(extensionOf(fileName))) {
171:     return reject(400, 'MEETING_NOTE_TRANSCRIPT_INVALID_TYPE', ctx);
172:   }
173: 
174:   const text = decodeTranscript(new Uint8Array(await file.arrayBuffer()), ctx);
175:   if (!text.ok) return text;
176:   return { ok: true, value: { fileName, text: text.value, fields } };
177: }
src/lib/meeting-notes/ai/transcript-normalizer.ts
1: // src/lib/meeting-notes/ai/transcript-normalizer.ts
2: // Phase 6 T10 (FR-014, AC-012): the ONLY source of the transcript text sent
3: // to an AI provider. The stored transcript stays exactly as uploaded (FR-005);
4: // the processing flow (T12) applies normalizeTranscriptForProvider to it right
5: // before dispatch.
6: //
7: // WebVTT and SubRip structure is removed: the WEBVTT header block, NOTE /
8: // STYLE / REGION blocks, cue identifiers (SRT cue numbers included), and
9: // timing lines (`00:00:01.000 --> 00:00:04.000 align:start` and
10: // `00:00:01,000 --> 00:00:04,000`, with any cue settings). Spoken text and
11: // speaker names stay: a WebVTT voice span `<v Ana>Hello` becomes
12: // `Ana: Hello`, and "Ana: Hello" lines are kept as written. Other inline cue
13: // markup (<c>, <i>, <b>, <u>, <ruby>, <rt>, <lang>, <font>, <s>, karaoke
14: // timestamps, SRT `{\an8}` position tags) is stripped and the WebVTT
15: // character references are decoded. Plain text without timing lines is only
16: // trimmed, with its line endings normalized.
17: //
18: // Every regex repetition inside a tag is bounded: an unclosed "<v" or "<c"
19: // scans at most a few hundred characters, so a 1 MB single-line transcript
20: // such as "<v <v <v ..." stays linear instead of rescanning to the end of the
21: // line from every tag start (T10 review: unbounded classes were quadratic).
22: import 'server-only';
23: 
24: const BOM = '﻿';
25: const TIMESTAMP = String.raw`(?:\d{1,4}:)?\d{1,2}:\d{2}[.,]\d{1,3}`;
26: /** A cue timing line, including any cue settings after the end time. */
27: const TIMING_LINE = new RegExp(String.raw`^[ \t]*${TIMESTAMP}[ \t]*-->[ \t]*${TIMESTAMP}(?:[ \t].*)?$`);
28: const VTT_HEADER = /^WEBVTT(?:[ \t].*)?$/;
29: const VTT_METADATA_BLOCK = /^(?:NOTE|STYLE|REGION)(?:[ \t].*)?$/;
30: const CUE_NUMBER = /^[ \t]*\d+[ \t]*$/;
31: 
32: // Tag bodies also exclude the next tag opener, so each start scans only up
33: // to the following "<" (or "{").
34: const VOICE_OPEN = /<v(?:\.[^\s<>]{0,64})?[ \t]([^<>\n]{1,200})>/gi;
35: const CUE_MARKUP = /<\/?(?:v|c|i|b|u|s|ruby|rt|lang|font)(?:[.\s][^<>\n]{0,200})?>/gi;
36: const KARAOKE_TIMESTAMP = new RegExp(String.raw`<${TIMESTAMP}>`, 'g');
37: const SSA_OVERRIDE = /\{\\[^{}\n]{0,200}\}/g;
38: 
39: const ENTITIES: Readonly<Record<string, string>> = {
40:   '&amp;': '&',
41:   '&lt;': '<',
42:   '&gt;': '>',
43:   '&quot;': '"',
44:   '&apos;': "'",
45:   '&nbsp;': ' ',
46:   '&lrm;': '',
47:   '&rlm;': '',
48: };
49: const ENTITY = /&(?:amp|lt|gt|quot|apos|nbsp|lrm|rlm);/g;
50: 
51: function cleanCueText(line: string): string {
52:   return line
53:     .replace(VOICE_OPEN, (_match, speaker: string) => (speaker.trim() ? `${speaker.trim()}: ` : ''))
54:     .replace(CUE_MARKUP, '')
55:     .replace(KARAOKE_TIMESTAMP, '')
56:     .replace(SSA_OVERRIDE, '')
57:     .replace(ENTITY, (entity) => ENTITIES[entity] ?? entity)
58:     .replace(/[ \t]+/g, ' ')
59:     .trim();
60: }
61: 
62: /** Cue-structured text (WebVTT or SubRip, by content) → speaker lines and text. */
63: function normalizeCues(lines: readonly string[], isVtt: boolean): string {
64:   const blocks: string[][] = [];
65:   let current: string[] = [];
66:   for (const line of lines) {
67:     if (line.trim() === '') {
68:       if (current.length > 0) blocks.push(current);
69:       current = [];
70:     } else {
71:       current.push(line);
72:     }
73:   }
74:   if (current.length > 0) blocks.push(current);
75: 
76:   const output: string[] = [];
77:   blocks.forEach((block, index) => {
78:     if (isVtt && index === 0 && VTT_HEADER.test(block[0].trim())) return;
79:     if (isVtt && VTT_METADATA_BLOCK.test(block[0])) return;
80: 
81:     const timing = block.findIndex((line) => TIMING_LINE.test(line));
82:     // Lines before the timing line are the cue identifier; a block without a
83:     // timing line keeps its text unless it is only a cue number.
84:     const payload = timing >= 0 ? block.slice(timing + 1) : block.filter((line) => !CUE_NUMBER.test(line));
85:     for (const line of payload) {
86:       if (TIMING_LINE.test(line)) continue;
87:       const text = cleanCueText(line);
88:       if (text) output.push(text);
89:     }
90:   });
91:   return output.join('\n');
92: }
93: 
94: /**
95:  * The transcript text a provider receives (FR-014): cue numbers, timestamps,
96:  * and cue settings removed; speaker names and spoken text kept.
97:  */
98: export function normalizeTranscriptForProvider(stored: string): string {
99:   const text = (stored.startsWith(BOM) ? stored.slice(BOM.length) : stored).replace(/\r\n?/g, '\n');
100:   const lines = text.split('\n');
101:   const firstLine = lines.find((line) => line.trim() !== '') ?? '';
102:   const isVtt = VTT_HEADER.test(firstLine.trim());
103:   if (!isVtt && !lines.some((line) => TIMING_LINE.test(line))) {
104:     return text.trim();
105:   }
106:   return normalizeCues(lines, isVtt);
107: }

