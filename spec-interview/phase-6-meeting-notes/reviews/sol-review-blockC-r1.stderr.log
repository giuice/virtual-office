1: // src/lib/meeting-notes/route-support.ts
2: // Shared plumbing of the /api/meeting-notes routes (Phase 6 T3): session,
3: // rate limit, bounded JSON bodies, validation errors, and the mapping of RPC
4: // refusals to HTTP. Note and item reads and writes always use the USER's
5: // server client (RLS and the RPCs authorize from auth.uid()); the service-role
6: // client is built only to charge the per-user rate-limit counter
7: // (check_rate_limit is service-role only).
8: import 'server-only';
9: 
10: import { NextResponse } from 'next/server';
11: import type { SupabaseClient } from '@supabase/supabase-js';
12: import type { z } from 'zod';
13: import { createCorrelationId, jsonError } from '@/lib/api/server-error';
14: import { enforceRateLimit, type RateLimitedAction } from '@/lib/auth/rate-limit';
15: import { requireAuthUser } from '@/lib/auth/session';
16: import { readBoundedBody } from '@/lib/messaging/metrics-log';
17: import { createSupabaseServerClient } from '@/lib/supabase/server-client';
18: import { SupabaseMeetingNoteRepository } from 
'@/repositories/implementations/supabase/SupabaseMeetingNoteRepository';
19: import type { IMeetingNoteRepository } from '@/repositories/interfaces/IMeetingNoteRepository';
20: import type { ActionItem, User } from '@/types/database';
21: import { MeetingNoteDbError, type MeetingNoteErrorToken } from './errors';
22: import { loadActionItemViews, loadMeetingNoteDetail } from './note-detail';
23: import { MEETING_NOTE_MAX_BODY_BYTES, pathIdSchema } from './validation';
24: 
25: export interface MeetingNoteRouteContext {
26:   correlationId: string;
27:   /** The user's server client (JWT from the request cookies). */
28:   supabase: SupabaseClient;
29:   dbUser: User;
30:   repository: IMeetingNoteRepository;
31: }
32: 
33: type Result<T> = { ok: true; value: T } | { ok: false; response: NextResponse };
34: 
35: const MESSAGES: Record<string, string> = {
36:   BAD_REQUEST: 'The request is invalid.',
