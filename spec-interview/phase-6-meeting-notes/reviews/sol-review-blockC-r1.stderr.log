216:   private snapshot(): FakeAiStateResponse {
217:     const paused = providerRecord(() => 0);
218:     const timeout = providerRecord(() => 0);
219:     for (const entry of this.held) (entry.kind === 'paused' ? paused : timeout)[entry.ctx.provider] += 1;
220:     return {
221:       received: this.receivedCounts(),
222:       queued: {
223:         anthropic: this.queues.anthropic.length,
224:         openai: this.queues.openai.length,
225:         kimi: this.queues.kimi.length,
226:         glm: this.queues.glm.length,
227:       },
228:       defaults: {
229:         anthropic: this.defaults.anthropic?.kind ?? null,
230:         openai: this.defaults.openai?.kind ?? null,
231:         kimi: this.defaults.kimi?.kind ?? null,
232:         glm: this.defaults.glm?.kind ?? null,
233:       },
234:       held: { paused, timeout },
235:     };
236:   }
237: 
238:   /** Clears scripts and records; destroys every held socket. Returns how many were dropped. */
239:   reset(): number {
240:     const dropped = this.dropHeld();
241:     this.queues = providerRecord<FakeAiOutcome[]>(() => []);
242:     this.defaults = providerRecord<FakeAiOutcome | null>(() => null);
243:     this.records = [];
244:     this.seq = 0;
245:     return dropped;
246:   }
247: 
248:   dropHeld(): number {
249:     const count = this.held.size;
250:     for (const entry of this.held) entry.ctx.res.socket?.destroy();
251:     this.held.clear();
252:     return count;
253:   }
254: 
255:   clearTimers(): void {
256:     for (const timer of this.timers) clearTimeout(timer);
257:     this.timers.clear();
258:   }
259: 
260:   private sleep(ms: number | undefined): Promise<void> {
261:     if (!ms || ms <= 0) return Promise.resolve();
262:     return new Promise((resolve) => {
263:       const timer = setTimeout(() => {
264:         this.timers.delete(timer);
265:         resolve();
266:       }, ms);
267:       this.timers.add(timer);
268:     });
269:   }
270: 
271:   private release(provider: FakeAiProvider | null): number {
272:     const entries = [...this.held].filter((entry) => entry.kind === 'paused' && (!provider || entry.ctx.provider 
=== provider));
273:     for (const entry of entries) {
274:       this.held.delete(entry);
275:       const next = entry.then ?? this.nextOutcome(entry.ctx.provider);
276:       entry.record.releasedAs = next?.kind ?? 'unscripted';
277:       void this.execute(entry.ctx, entry.record, next);
278:     }
279:     return entries.length;
280:   }
281: 
282:   // ---------------------------------------------------------------- provider
283: 
284:   private nextOutcome(provider: FakeAiProvider): FakeAiOutcome | null {
285:     return this.queues[provider].shift() ?? this.defaults[provider];
286:   }
287: 
288:   async handleProvider(req: IncomingMessage, res: ServerResponse, path: string, raw: Buffer): Promise<void> {
289:     const provider = req.method === 'POST' ? providerForPath(path) : null;
290:     let body: unknown = null;
291:     let bodyParseError: string | undefined;
292:     if (raw.length > 0) {
293:       try {
294:         body = JSON.parse(raw.toString('utf8'));
295:       } catch (err) {
296:         bodyParseError = (err as Error).message;
297:       }
298:     }
299:     const bodyObject = (body !== null && typeof body === 'object' ? body : {}) as Record<string, unknown>;
300:     const stream = bodyObject.stream === true;
301:     const record: FakeAiRecordedRequest = {
302:       seq: ++this.seq,
303:       receivedAt: new Date().toISOString(),
304:       method: req.method ?? '',
305:       path,
306:       url: req.url ?? path,
307:       provider,
308:       ...recordHeaders(req),
309:       body,
310:       ...(bodyParseError !== undefined ? { bodyParseError } : {}),
311:       bodyBytes: raw.length,
312:       stream,
313:       outcome: 'not_found',
314:     };
315:     this.records.push(record);
316: 
317:     const envelopeProvider = provider ?? providerForPrefix(path);
318:     const ctx: FakeAiReplyContext = {
319:       provider: envelopeProvider ?? 'openai',
320:       res,
321:       model: typeof bodyObject.model === 'string' ? bodyObject.model : 'unknown-model',
322:       stream,
323:       includeUsage: (bodyObject.stream_options as { include_usage?: unknown } | undefined)?.include_usage === 
true,
324:       seq: record.seq,
325:       bodyBytes: raw.length,
326:     };
327: 
328:     if (!provider) {
329:       const message = `Fake AI server: no route for ${req.method} ${path}`;
330:       if (envelopeProvider) sendErrorEnvelope(ctx, 404, { message });
331:       else sendControlJson(res, 404, { error: { message } });
332:       return;
333:     }
334: 
335:     const outcome = this.nextOutcome(provider);
336:     record.outcome = outcome?.kind ?? 'unscripted';
337:     await this.execute(ctx, record, outcome);
338:   }
339: 
340:   private hold(entry: HeldRequest): void {
341:     this.held.add(entry);
342:     entry.ctx.res.on('close', () => this.held.delete(entry));
343:   }
344: 
345:   private async execute(ctx: FakeAiReplyContext, record: FakeAiRecordedRequest, outcome: FakeAiOutcome | null): 
Promise<void> {
346:     const { res } = ctx;
347:     if (!outcome) {
348:       sendErrorEnvelope(ctx, 500, { message: `Fake AI server: no scripted outcome for ${ctx.provider} (request 
${record.seq})` });
349:       return;
350:     }
351:     if (outcome.kind === 'timeout') {
352:       this.hold({ kind: 'timeout', ctx, record });
353:       return;
354:     }
355:     if (outcome.kind === 'pause') {
356:       this.hold({ kind: 'paused', ctx, record, then: outcome.then });
357:       return;
358:     }
359: 
360:     await this.sleep(outcome.delayMs);
361:     if (this.closing || res.destroyed || res.writableEnded) return;
362: 
363:     switch (outcome.kind) {
364:       case 'success':
365:         return sendModelOutput(ctx, {
366:           text: typeof outcome.draft === 'string' ? outcome.draft : JSON.stringify(outcome.draft),
367:           finish: 'end',
368:           usage: outcome.usage,
369:           includeThinking: outcome.includeThinking,
370:         });
371:       case 'error_after_processing':
372:         return sendErrorEnvelope(ctx, outcome.status ?? 500, outcome);
373:       case 'refusal':
374:         return sendModelOutput(ctx, {
375:           text: '',
376:           finish: 'refusal',
377:           refusalMessage: outcome.message,
378:           finishReason: outcome.finishReason,
379:         });
380:       case 'malformed_json':
381:         return sendModelOutput(ctx, {
382:           text: outcome.text ?? DEFAULT_MALFORMED_TEXT,
383:           finish: outcome.truncated ? 'length' : 'end',
384:         });
385:       case 'rejection':
386:         return sendErrorEnvelope(ctx, outcome.status, outcome);
387:       case 'status':
388:         return sendRaw(res, outcome.status, outcome.body, outcome.contentType, outcome.headers);
389:       case 'stream_error_after_start':
390:         return sendStreamErrorAfterStart(ctx, outcome, outcome.abrupt === true);
391:       case 'drop_after_accept':
392:         res.socket?.destroy();
393:         return;
394:     }
395:   }
396: }
397: 
398: /**
399:  * Starts the fake on 127.0.0.1 (port: option, else MEETING_NOTES_FAKE_AI_PORT,
400:  * else 54399). Fails loudly when the port is taken.
401:  */
402: export async function startMeetingNotesFakeAiServer(options: { port?: number } = {}): 
Promise<MeetingNotesFakeAiServer> {
403:   const port = options.port ?? meetingNotesFakeAiPort();
404:   const state = new FakeAiServerState();
405: 
406:   const server: Server = createServer((req, res) => {
407:     void (async () => {
408:       const url = new URL(req.url ?? '/', `http://${MEETING_NOTES_FAKE_AI_HOST}`);
409:       let raw: Buffer;
410:       try {
411:         raw = await readBody(req);
412:       } catch {
413:         res.socket?.destroy();
414:         return;
415:       }
416:       if (url.pathname.startsWith('/__control/')) {
417:         try {
418:           const body = raw.length > 0 ? (JSON.parse(raw.toString('utf8')) as unknown) : null;
419:           state.handleControl(req.method ?? 'GET', url.pathname, url.searchParams, body, res);
420:         } catch (err) {
421:           const status = err instanceof ControlError || err instanceof SyntaxError ? 400 : 500;
422:           sendControlJson(res, status, { error: (err as Error).message });
423:         }
424:         return;
425:       }
426:       try {
427:         await state.handleProvider(req, res, url.pathname, raw);
428:       } catch (err) {
429:         if (!res.headersSent) sendControlJson(res, 500, { error: { message: `Fake AI server failure: ${(err as 
Error).message}` } });
430:         else res.socket?.destroy();
431:       }
432:     })();
433:   });
434: 
435:   await new Promise<void>((resolve, reject) => {
436:     const onError = (err: NodeJS.ErrnoException) => {
437:       reject(
438:         new Error(
439:           err.code === 'EADDRINUSE'
440:             ? `Meeting-notes fake AI server: ${MEETING_NOTES_FAKE_AI_HOST}:${port} is already in use ` +
441:                 '(another test run or an orphaned process?). Free it or set MEETING_NOTES_FAKE_AI_PORT.'
442:             : `Meeting-notes fake AI server failed to listen on ${MEETING_NOTES_FAKE_AI_HOST}:${port}: 
${err.message}`
443:         )
444:       );
445:     };
446:     server.once('error', onError);
447:     server.listen(port, MEETING_NOTES_FAKE_AI_HOST, () => {
448:       server.off('error', onError);
449:       resolve();
450:     });
451:   });
452: 
453:   let closed: Promise<void> | null = null;
454:   return {
455:     baseUrl: `http://${MEETING_NOTES_FAKE_AI_HOST}:${port}`,
456:     port,
457:     close() {
458:       closed ??= new Promise<void>((resolve, reject) => {
459:         state.closing = true;
460:         state.dropHeld();
461:         state.clearTimers();
462:         server.close((err) => (err ? reject(err) : resolve()));
463:         server.closeAllConnections();
464:       });
465:       return closed;
466:     },
467:   };
468: }
__tests__/meeting-notes-ai-fake/protocols.ts
1: // Provider wire shapes of the meeting-notes fake AI server (T16, test-only).
2: // Anthropic Messages (JSON + SSE events) and OpenAI-compatible Chat
3: // Completions (JSON + `data:` chunks + `[DONE]`) for openai, kimi, and glm,
4: // with each provider's normal error envelope as capabilities.ts expects it:
5: //   anthropic: {"type":"error","error":{"type","message"},"request_id"}
6: //   openai:    {"error":{"message","type","param","code"}}
7: //   kimi:      {"error":{"message","type"}}            (+ code when scripted)
8: //   glm:       {"error":{"code","message"}}            (business code as text; + type when scripted)
9: import type { ServerResponse } from 'node:http';
10: 
11: import type { FakeAiProvider, FakeAiUsage } from './config';
12: 
13: export interface FakeAiReplyContext {
14:   provider: FakeAiProvider;
15:   res: ServerResponse;
16:   /** Echoed `model` of the request body. */
17:   model: string;
18:   stream: boolean;
19:   /** OpenAI-compatible `stream_options.include_usage`. */
20:   includeUsage: boolean;
21:   seq: number;
22:   /** Request body size, for a default input-token estimate. */
23:   bodyBytes: number;
24: }
25: 
26: /** What the "model" produced. */
27: export interface FakeAiModelOutput {
28:   text: string;
29:   finish: 'end' | 'length' | 'refusal';
30:   refusalMessage?: string;
31:   /** OpenAI-compatible finish_reason override. */
32:   finishReason?: string;
33:   usage?: FakeAiUsage;
34:   includeThinking?: boolean;
35: }
36: 
37: export interface FakeAiErrorFields {
38:   errorType?: string;
39:   errorCode?: string;
40:   message?: string;
41: }
42: 
43: const ANTHROPIC_DEFAULT_ERROR_TYPES: Readonly<Record<number, string>> = {
44:   400: 'invalid_request_error',
45:   401: 'authentication_error',
46:   403: 'permission_error',
47:   404: 'not_found_error',
48:   413: 'request_too_large',
49:   429: 'rate_limit_error',
50:   500: 'api_error',
51:   504: 'timeout_error',
52:   529: 'overloaded_error',
53: };
54: 
55: function messageId(ctx: FakeAiReplyContext): string {
56:   return ctx.provider === 'anthropic' ? `msg_fake_${ctx.seq}` : `chatcmpl-fake-${ctx.seq}`;
57: }
58: 
59: function usageOf(ctx: FakeAiReplyContext, output: FakeAiModelOutput): { input: number; output: number } {
60:   return {
61:     input: output.usage?.inputTokens ?? Math.max(1, Math.ceil(ctx.bodyBytes / 4)),
62:     output: output.usage?.outputTokens ?? Math.max(1, Math.ceil((output.text.length + 
(output.refusalMessage?.length ?? 0)) / 4)),
63:   };
64: }
65: 
66: function writeJson(res: ServerResponse, status: number, body: unknown, headers: Record<string, string> = {}): void 
{
67:   const payload = JSON.stringify(body);
68:   res.writeHead(status, {
69:     'content-type': 'application/json',
70:     'content-length': Buffer.byteLength(payload).toString(),
71:     ...headers,
72:   });
73:   res.end(payload);
74: }
75: 
76: function startSse(ctx: FakeAiReplyContext): void {
77:   ctx.res.writeHead(200, {
78:     'content-type': 'text/event-stream; charset=utf-8',
79:     'cache-control': 'no-cache',
80:     connection: 'keep-alive',
81:     ...requestIdHeader(ctx),
82:   });
83: }
84: 
85: function requestIdHeader(ctx: FakeAiReplyContext): Record<string, string> {
86:   return ctx.provider === 'anthropic' ? { 'request-id': `req_fake_${ctx.seq}` } : { 'x-request-id': 
`req_fake_${ctx.seq}` };
87: }
88: 
89: function sseEvent(event: string | null, data: unknown): string {
90:   const line = `data: ${typeof data === 'string' ? data : JSON.stringify(data)}\n\n`;
91:   return event ? `event: ${event}\n${line}` : line;
92: }
93: 
94: /** Write then destroy the socket once the bytes are flushed (abrupt close). */
95: function writeThenDestroy(res: ServerResponse, chunk: string): void {
96:   res.write(chunk, () => res.socket?.destroy());
97: }
98: 
99: /** Split text into a few deltas so clients exercise their accumulation. */
100: function chunksOf(text: string, parts = 3): string[] {
101:   if (text.length === 0) return [];
102:   const size = Math.max(1, Math.ceil(text.length / parts));
103:   const out: string[] = [];
104:   for (let i = 0; i < text.length; i += size) out.push(text.slice(i, i + size));
105:   return out;
106: }
107: 
108: // ---------------------------------------------------------------------------
109: // Errors
110: // ---------------------------------------------------------------------------
111: 
112: export function errorEnvelope(provider: FakeAiProvider, status: number, fields: FakeAiErrorFields, seq: number): 
unknown {
113:   const message = fields.message ?? `Fake ${provider} error (${status})`;
114:   switch (provider) {
115:     case 'anthropic':
116:       return {
117:         type: 'error',
118:         error: { type: fields.errorType ?? ANTHROPIC_DEFAULT_ERROR_TYPES[status] ?? 'api_error', message },
119:         request_id: `req_fake_${seq}`,
120:       };
121:     case 'openai':
122:       return {
123:         error: {
124:           message,
125:           type: fields.errorType ?? (status >= 500 ? 'server_error' : 'invalid_request_error'),
126:           param: null,
127:           code: fields.errorCode ?? null,
128:         },
129:       };
130:     case 'kimi':
131:       return {
132:         error: {
133:           message,
134:           type: fields.errorType ?? (status >= 500 ? 'server_error' : 'invalid_request_error'),
135:           ...(fields.errorCode !== undefined ? { code: fields.errorCode } : {}),
136:         },
137:       };
138:     case 'glm':
139:       return {
140:         error: {
141:           code: fields.errorCode ?? String(status),
142:           message,
143:           ...(fields.errorType !== undefined ? { type: fields.errorType } : {}),
144:         },
145:       };
146:   }
147: }
148: 
149: export function sendErrorEnvelope(ctx: FakeAiReplyContext, status: number, fields: FakeAiErrorFields): void {
150:   writeJson(ctx.res, status, errorEnvelope(ctx.provider, status, fields, ctx.seq), requestIdHeader(ctx));
151: }
152: 
153: export function sendRaw(
154:   res: ServerResponse,
155:   status: number,
156:   body: unknown,
157:   contentType: string | undefined,
158:   headers: Record<string, string> = {}
159: ): void {
160:   if (typeof body === 'string') {
161:     res.writeHead(status, { 'content-type': contentType ?? 'text/plain; charset=utf-8', ...headers });
162:     res.end(body);
163:     return;
164:   }
165:   writeJson(res, status, body, { ...(contentType ? { 'content-type': contentType } : {}), ...headers });
166: }
167: 
168: // ---------------------------------------------------------------------------
169: // Model output (success, refusal, malformed/truncated)
170: // ---------------------------------------------------------------------------
171: 
172: export function sendModelOutput(ctx: FakeAiReplyContext, output: FakeAiModelOutput): void {
173:   if (ctx.provider === 'anthropic') {
174:     if (ctx.stream) streamAnthropic(ctx, output);
175:     else writeJson(ctx.res, 200, anthropicMessage(ctx, output), requestIdHeader(ctx));
176:     return;
177:   }
178:   if (ctx.stream) streamChatCompletion(ctx, output);
179:   else writeJson(ctx.res, 200, chatCompletion(ctx, output), requestIdHeader(ctx));
180: }
181: 
182: function anthropicStopReason(output: FakeAiModelOutput): string {
183:   return output.finish === 'end' ? 'end_turn' : output.finish === 'length' ? 'max_tokens' : 'refusal';
184: }
185: 
186: function anthropicStopDetails(output: FakeAiModelOutput): unknown {
187:   return output.finish === 'refusal'
188:     ? { type: 'refusal', category: null, explanation: output.refusalMessage ?? 'The request was declined.' }
189:     : null;
190: }
191: 
192: const FAKE_THINKING_SIGNATURE = 'fake-thinking-signature';
193: 
194: function anthropicMessage(ctx: FakeAiReplyContext, output: FakeAiModelOutput): unknown {
195:   const usage = usageOf(ctx, output);
196:   const content: unknown[] = [];
197:   if (output.includeThinking !== false) content.push({ type: 'thinking', thinking: '', signature: 
FAKE_THINKING_SIGNATURE });
198:   if (output.text.length > 0) content.push({ type: 'text', text: output.text });
199:   return {
200:     id: messageId(ctx),
201:     type: 'message',
202:     role: 'assistant',
203:     model: ctx.model,
204:     content,
205:     stop_reason: anthropicStopReason(output),
206:     stop_sequence: null,
207:     stop_details: anthropicStopDetails(output),
208:     usage: {
209:       input_tokens: usage.input,
210:       output_tokens: usage.output,
211:       cache_creation_input_tokens: 0,
212:       cache_read_input_tokens: 0,
213:     },
214:   };
215: }
216: 
217: function anthropicPrelude(ctx: FakeAiReplyContext, inputTokens: number): string {
218:   return sseEvent('message_start', {
219:     type: 'message_start',
220:     message: {
221:       id: messageId(ctx),
222:       type: 'message',
223:       role: 'assistant',
224:       model: ctx.model,
225:       content: [],
226:       stop_reason: null,
227:       stop_sequence: null,
228:       usage: { input_tokens: inputTokens, output_tokens: 1, cache_creation_input_tokens: 0, 
cache_read_input_tokens: 0 },
229:     },
230:   });
231: }
232: 
233: function anthropicThinkingBlock(index: number): string {
234:   return (
235:     sseEvent('content_block_start', {
236:       type: 'content_block_start',
237:       index,
238:       content_block: { type: 'thinking', thinking: '', signature: '' },
239:     }) +
240:     sseEvent('content_block_delta', {
241:       type: 'content_block_delta',
242:       index,
243:       delta: { type: 'signature_delta', signature: FAKE_THINKING_SIGNATURE },
244:     }) +
245:     sseEvent('content_block_stop', { type: 'content_block_stop', index })
246:   );
247: }
248: 
249: function anthropicTextStart(index: number): string {
250:   return sseEvent('content_block_start', { type: 'content_block_start', index, content_block: { type: 'text', 
text: '' } });
251: }
252: 
253: function anthropicTextDelta(index: number, text: string): string {
254:   return sseEvent('content_block_delta', { type: 'content_block_delta', index, delta: { type: 'text_delta', text 
} });
255: }
256: 
257: function streamAnthropic(ctx: FakeAiReplyContext, output: FakeAiModelOutput): void {
258:   const usage = usageOf(ctx, output);
259:   let body = anthropicPrelude(ctx, usage.input);
260:   let index = 0;
261:   if (output.includeThinking !== false) body += anthropicThinkingBlock(index++);
262:   if (output.text.length > 0) {
263:     body += anthropicTextStart(index);
264:     for (const piece of chunksOf(output.text)) body += anthropicTextDelta(index, piece);
265:     body += sseEvent('content_block_stop', { type: 'content_block_stop', index });
266:   }
267:   body += sseEvent('message_delta', {
268:     type: 'message_delta',
269:     delta: { stop_reason: anthropicStopReason(output), stop_sequence: null, stop_details: 
anthropicStopDetails(output) },
270:     usage: { output_tokens: usage.output },
271:   });
272:   body += sseEvent('message_stop', { type: 'message_stop' });
273:   startSse(ctx);
274:   ctx.res.end(body);
275: }
276: 
277: function chatFinishReason(ctx: FakeAiReplyContext, output: FakeAiModelOutput): string {
278:   if (output.finishReason) return output.finishReason;
279:   if (output.finish === 'end') return 'stop';
280:   if (output.finish === 'length') return 'length';
281:   // Refusal defaults: OpenAI reports it in `message.refusal` with "stop".
282:   return ctx.provider === 'openai' ? 'stop' : ctx.provider === 'glm' ? 'sensitive' : 'content_filter';
283: }
284: 
285: function chatBase(ctx: FakeAiReplyContext, object: 'chat.completion' | 'chat.completion.chunk'): Record<string, 
unknown> {
286:   return {
287:     id: messageId(ctx),
288:     object,
289:     created: Math.floor(Date.now() / 1000),
290:     model: ctx.model,
291:     ...(ctx.provider === 'glm' ? { request_id: `req_fake_${ctx.seq}` } : {}),
292:   };
293: }
294: 
295: function chatUsage(ctx: FakeAiReplyContext, output: FakeAiModelOutput): Record<string, number> {
296:   const usage = usageOf(ctx, output);
297:   return { prompt_tokens: usage.input, completion_tokens: usage.output, total_tokens: usage.input + usage.output 
};
298: }
299: 
300: function openAiRefusal(ctx: FakeAiReplyContext, output: FakeAiModelOutput): string | null {
301:   return output.finish === 'refusal' && ctx.provider === 'openai'
302:     ? output.refusalMessage ?? "I'm sorry, I can't help with that."
303:     : null;
304: }
305: 
306: function chatCompletion(ctx: FakeAiReplyContext, output: FakeAiModelOutput): unknown {
307:   const refusal = openAiRefusal(ctx, output);
308:   return {
309:     ...chatBase(ctx, 'chat.completion'),
310:     choices: [
311:       {
312:         index: 0,
313:         message: { role: 'assistant', content: refusal !== null ? null : output.text, refusal },
314:         logprobs: null,
315:         finish_reason: chatFinishReason(ctx, output),
316:       },
317:     ],
318:     usage: chatUsage(ctx, output),
319:   };
320: }
321: 
322: function chatChunk(ctx: FakeAiReplyContext, delta: Record<string, unknown>, finishReason: string | null): unknown 
{
323:   return { ...chatBase(ctx, 'chat.completion.chunk'), choices: [{ index: 0, delta, logprobs: null, finish_reason: 
finishReason }] };
324: }
325: 
326: function streamChatCompletion(ctx: FakeAiReplyContext, output: FakeAiModelOutput): void {
327:   const refusal = openAiRefusal(ctx, output);
328:   let body = sseEvent(null, chatChunk(ctx, { role: 'assistant', content: '' }, null));
329:   if (refusal !== null) {
330:     for (const piece of chunksOf(refusal)) body += sseEvent(null, chatChunk(ctx, { refusal: piece }, null));
331:   } else {
332:     for (const piece of chunksOf(output.text)) body += sseEvent(null, chatChunk(ctx, { content: piece }, null));
333:   }
334:   body += sseEvent(null, chatChunk(ctx, {}, chatFinishReason(ctx, output)));
335:   if (ctx.includeUsage) body += sseEvent(null, { ...chatBase(ctx, 'chat.completion.chunk'), choices: [], usage: 
chatUsage(ctx, output) });
336:   body += sseEvent(null, '[DONE]');
337:   startSse(ctx);
338:   ctx.res.end(body);
339: }
