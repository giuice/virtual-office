40:           ? { 'content-type': 'application/json', 'x-api-key': key, 'anthropic-version': '2023-06-01' }
41:           : { 'content-type': 'application/json', authorization: `Bearer ${key}` };
42:       const model = `self-check-${provider}-model`;
43:       const response = await fetch(`${baseUrl}${FAKE_AI_PROVIDER_PATHS[provider]}`, {
44:         method: 'POST',
45:         headers,
46:         body: JSON.stringify({ model, max_tokens: 64, messages: [{ role: 'user', content: 'self-check transcript' 
}] }),
47:       });
48:       if (response.status !== 200) fail(provider, `expected 200, got ${response.status}: ${await 
response.text()}`);
49:       const text = modelText(provider, await response.json());
50:       if (JSON.stringify(JSON.parse(text)) !== JSON.stringify(draft)) fail(provider, `draft mismatch: ${text}`);
51: 
52:       const { requests, received } = await control.requests(provider);
53:       if (received[provider] !== 1 || requests.length !== 1) {
54:         fail(provider, `expected exactly 1 recorded request, got ${received[provider]}`);
55:       }
56:       const [recorded] = requests;
