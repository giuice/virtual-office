2: # Never commit real values. Only NEXT_PUBLIC_* variables reach the browser.
3: 
4: # --- Phase 6 meeting notes: AI processing tickets (server-only) ---
5: # HMAC-SHA256 secret that signs AI processing tickets. Required for AI
6: # processing: without it (or with fewer than 32 bytes) the ticket and start
7: # routes refuse with a configuration error; there is no fallback.
8: # Generate one, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
9: # Leave no placeholder here: an empty value is refused, never used.
10: MEETING_NOTES_TICKET_SECRET=
11: # Optional, verification only: set it to the PREVIOUS secret during a
12: # rotation so tickets issued before the rotation stay valid for their 24 hours.
13: # Leave empty otherwise.
14: MEETING_NOTES_TICKET_SECRET_PREVIOUS=

