1: // src/app/api/meeting-notes/[id]/transcript/route.ts
2: import { NextRequest, NextResponse } from 'next/server';
3: import { loadMeetingNoteDetail } from '@/lib/meeting-notes/note-detail';
4: import {
5:   beginMeetingNoteRequest,
6:   internalError,
7:   noteMutationErrorResponse,
8:   notFound,
9:   ok,
10:   parsePathId,
11:   parseWith,
12: } from '@/lib/meeting-notes/route-support';
13: import { readTranscriptUpload } from '@/lib/meeting-notes/transcript-upload';
14: import { expectedRevisionParamSchema } from '@/lib/meeting-notes/validation';
15: 
16: export const dynamic = 'force-dynamic';
17: 
18: interface RouteParams {
19:   params: Promise<{ id: string }>;
20: }
21: 
22: /**
23:  * PUT /api/meeting-notes/[id]/transcript — "Attach transcript" (FR-012,
24:  * BR-010): an editor (author, participant, or admin, while a member)
25:  * replaces the stored transcript. Body: multipart/form-data with
26:  * `expectedRevision` (the note revision the editor saw) and one `file`
27:  * (.txt/.vtt/.srt, 1 byte..1 MB, UTF-8 text; FR-013), validated before
28:  * anything is written. The transcript gets a new identity, the revision is
29:  * bumped, and one version (unchanged fields) records who replaced it; title,
30:  * date, participants, content, summary, and items are untouched.
31:  * 200 { note }; 409 { code: MEETING_NOTE_STALE_REVISION, currentRevision,
32:  * note } when another change landed first (FR-007); 403 for a non-editor;
33:  * 404 for a note outside the caller's company.
34:  */
35: export async function PUT(request: NextRequest, { params }: RouteParams): Promise<NextResponse> {
36:   const begun = await beginMeetingNoteRequest('/api/meeting-notes/[id]/transcript', 'meeting-note:transcript');
37:   if (!begun.ok) {
38:     await request.body?.cancel().catch(() => undefined);
39:     return begun.response;
40:   }
41:   const ctx = begun.value;
42: 
43:   const id = parsePathId((await params).id, 'MEETING_NOTE_NOT_FOUND', ctx);
44:   if (!id.ok) {
45:     await request.body?.cancel().catch(() => undefined);
46:     return id.response;
47:   }
48: 
49:   const upload = await readTranscriptUpload(request, ['expectedRevision'], ctx);
50:   if (!upload.ok) return upload.response;
51: 
52:   const revision = parseWith(
53:     expectedRevisionParamSchema('MEETING_NOTE_REVISION_REQUIRED'),
54:     upload.value.fields.get('expectedRevision'),
55:     ctx
56:   );
57:   if (!revision.ok) return revision.response;
58: 
59:   try {
60:     await ctx.repository.attachTranscript({
61:       noteId: id.value,
62:       expectedRevision: revision.value,
63:       transcript: upload.value.text,
64:     });
65:   } catch (error) {
66:     return noteMutationErrorResponse(error, ctx, id.value, 'meetingNotes.transcript.attach');
67:   }
68: 
69:   try {
70:     const note = await loadMeetingNoteDetail(ctx.repository, ctx.dbUser, id.value);
71:     // Deleted by another request right after this change committed.
72:     if (!note) return notFound('MEETING_NOTE_NOT_FOUND', ctx);
73:     return ok({ note }, ctx);
74:   } catch (error) {
75:     return internalError(error, ctx, 'meetingNotes.transcript.attach.load');
76:   }
77: }
