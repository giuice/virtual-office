60:   MEETING_NOTE_ITEM_ASSIGNEE_NOT_MEMBER: 'The assignee must be a current member of your company.',
61:   MEETING_NOTE_ITEM_REVISION_REQUIRED: 'The action item revision is required.',
62:   MEETING_NOTE_ITEM_COMPLETED_REQUIRED: 'The completion state is required.',
63:   MEETING_NOTE_ITEM_LIMIT_REACHED: 'A note can have at most 100 action items.',
64:   MEETING_NOTE_TRANSCRIPT_UPLOAD_INVALID: 'Upload one transcript file (.txt, .vtt, or .srt).',
65:   MEETING_NOTE_TRANSCRIPT_INVALID_TYPE: 'The transcript must be a .txt, .vtt, or .srt file.',
66:   MEETING_NOTE_TRANSCRIPT_EMPTY: 'The transcript file is empty.',
67:   MEETING_NOTE_TRANSCRIPT_TOO_LARGE: 'The transcript file must be at most 1 MB.',
68:   MEETING_NOTE_TRANSCRIPT_NOT_TEXT: 'The transcript must be a UTF-8 text file.',
69:   MEETING_NOTE_SEARCH_INVALID: 'The search request is invalid.',
70:   MEETING_NOTE_SEARCH_QUERY_TOO_LONG: 'The search text must be at most 200 characters.',
71:   MEETING_NOTE_SEARCH_FILTER_INVALID: 'Choose either a space or "Space removed", not both.',
72:   MEETING_NOTE_SEARCH_PERIOD_INVALID: 'The period is invalid: use date-times with an offset, start before end.',
73:   MEETING_NOTE_AI_NOT_CONFIGURED: 'An admin needs to configure AI.',
74:   MEETING_NOTE_AI_TRANSCRIPT_REQUIRED: 'Attach a transcript to this note before processing it.',
75:   MEETING_NOTE_AI_UNAVAILABLE: 'AI processing is not available right now. Please contact your administrator.',
76: };
77: 
78: function messageFor(code: string): string {
79:   return MESSAGES[code] ?? MESSAGES.BAD_REQUEST;
80: }
81: 
82: /** An error response with a stable code and the matching user-facing message. */
83: export function meetingNoteError(
84:   status: number,
85:   code: string,
86:   ctx: { correlationId: string },
87:   context?: string
88: ): NextResponse {
89:   return jsonError(status, code, messageFor(code), { correlationId: ctx.correlationId, context });
90: }
91: 
92: /** An error response carrying extra non-sensitive fields (UI hints) next to code and message. */
93: export function meetingNoteErrorWithData(
94:   status: number,
95:   code: string,
96:   ctx: { correlationId: string },
97:   data: Record<string, unknown>
98: ): NextResponse {
99:   return NextResponse.json(
100:     { error: messageFor(code), code, correlationId: ctx.correlationId, ...data },
101:     { status, headers: { 'x-correlation-id': ctx.correlationId } }
102:   );
103: }
104: 
105: /** 404 for a missing, invisible, or malformed id (never reveals which). */
106: export function notFound(token: MeetingNoteErrorToken, ctx: { correlationId: string }): NextResponse {
107:   return meetingNoteError(404, token, ctx);
108: }
109: 
110: /**
111:  * Authenticates the caller (auth.getUser + users.supabase_uid) and, for a
112:  * mutation, charges `rateLimit` to their users.id.
113:  */
114: export async function beginMeetingNoteRequest(
115:   pathname: string,
116:   rateLimit?: RateLimitedAction
117: ): Promise<Result<MeetingNoteRouteContext>> {
118:   const correlationId = createCorrelationId();
119:   const auth = await requireAuthUser({ correlationId, pathname });
120:   if ('errorResponse' in auth) {
121:     return { ok: false, response: auth.errorResponse };
122:   }
123: 
124:   if (rateLimit) {
125:     let limiter: SupabaseClient | null = null;
126:     try {
127:       limiter = await createSupabaseServerClient('service_role');
128:     } catch {
129:       // Fail-open action: a limiter that cannot be built never blocks notes.
130:       console.error(JSON.stringify({ event: 'meeting_notes_limiter_unavailable', correlationId }));
131:     }
132:     if (limiter) {
133:       const limited = await enforceRateLimit(limiter, auth.dbUser.id, rateLimit);
134:       if (limited) return { ok: false, response: limited };
135:     }
136:   }
137: 
138:   return {
139:     ok: true,
140:     value: {
141:       correlationId,
142:       supabase: auth.supabase,
143:       dbUser: auth.dbUser,
144:       repository: new SupabaseMeetingNoteRepository(auth.supabase),
145:     },
146:   };
147: }
148: 
149: /** A path id; anything that is not a UUID is answered as not found. */
150: export function parsePathId(
151:   raw: string | undefined,
152:   token: MeetingNoteErrorToken,
153:   ctx: { correlationId: string }
154: ): Result<string> {
155:   const parsed = pathIdSchema.safeParse(raw);
156:   return parsed.success ? { ok: true, value: parsed.data } : { ok: false, response: notFound(token, ctx) };
157: }
158: 
159: /** Validation failure → 400 with the first issue's stable code. */
160: export function validationError(error: z.ZodError, ctx: { correlationId: string }): NextResponse {
161:   const issue = error.issues[0];
162:   const code = issue && /^[A-Z_]+$/.test(issue.message) ? issue.message : 'BAD_REQUEST';
163:   return meetingNoteError(400, code, ctx);
164: }
165: 
166: export function parseWith<S extends z.ZodType>(
167:   schema: S,
168:   value: unknown,
169:   ctx: { correlationId: string }
170: ): Result<z.infer<S>> {
171:   const parsed = schema.safeParse(value);
172:   return parsed.success
173:     ? { ok: true, value: parsed.data }
174:     : { ok: false, response: validationError(parsed.error, ctx) };
175: }
176: 
177: /** A JSON object body of at most MEETING_NOTE_MAX_BODY_BYTES. */
178: export async function readJsonObject(request: Request, ctx: { correlationId: string }): Promise<Result<unknown>> {
179:   const contentType = request.headers.get('content-type') ?? '';
180:   if (contentType.split(';')[0].trim().toLowerCase() !== 'application/json') {
181:     await request.body?.cancel().catch(() => undefined);
182:     return { ok: false, response: meetingNoteError(415, 'UNSUPPORTED_MEDIA_TYPE', ctx) };
183:   }
184:   const body = await readBoundedBody(request, MEETING_NOTE_MAX_BODY_BYTES);
185:   if (!body.ok) {
186:     return {
187:       ok: false,
188:       response: meetingNoteError(body.reason === 'too_large' ? 413 : 400, body.reason === 'too_large' ? 
'PAYLOAD_TOO_LARGE' : 'BAD_REQUEST', ctx),
189:     };
190:   }
191:   try {
192:     const value: unknown = JSON.parse(new TextDecoder('utf-8', { fatal: true }).decode(body.bytes));
193:     if (typeof value !== 'object' || value === null || Array.isArray(value)) {
194:       return { ok: false, response: meetingNoteError(400, 'BAD_REQUEST', ctx) };
195:     }
196:     return { ok: true, value };
197:   } catch {
198:     return { ok: false, response: meetingNoteError(400, 'BAD_REQUEST', ctx) };
199:   }
200: }
201: 
202: /** 500 without SQL, details, or request data (they could carry note text). */
203: export function internalError(error: unknown, ctx: { correlationId: string }, context: string): NextResponse {
204:   const cause =
205:     error instanceof MeetingNoteDbError
206:       ? { code: error.sqlstate, message: error.token ?? 'unexpected database error' }
207:       : { message: error instanceof Error ? error.name : 'unknown' };
208:   return jsonError(500, 'INTERNAL_ERROR', 'Something went wrong. Please try again.', {
209:     correlationId: ctx.correlationId,
210:     cause,
211:     context,
212:   });
213: }
214: 
215: /** Maps a documented RPC refusal (other than a stale revision) to HTTP. */
216: function refusalResponse(error: MeetingNoteDbError, ctx: { correlationId: string }, context: string): 
NextResponse {
217:   const token = error.token;
218:   if (token === null) return internalError(error, ctx, context);
219:   switch (error.sqlstate) {
220:     case '42501':
221:       return meetingNoteError(403, token, ctx, context);
222:     case 'P0002':
223:       return meetingNoteError(404, token, ctx, context);
224:     case '22023':
225:       return meetingNoteError(token === 'MEETING_NOTE_TRANSCRIPT_TOO_LARGE' ? 413 : 400, token, ctx, context);
226:     default:
227:       return internalError(error, ctx, context);
228:   }
229: }
230: 
231: function isStale(error: unknown, token: 'MEETING_NOTE_STALE_REVISION' | 'MEETING_NOTE_ITEM_STALE_REVISION'): 
error is MeetingNoteDbError {
232:   return error instanceof MeetingNoteDbError && error.sqlstate === 'P0001' && error.token === token;
233: }
234: 
235: /**
236:  * A failed note mutation → response. A stale revision → 409 carrying the
237:  * note's current state (read with the caller's session) so the UI can show it.
238:  */
239: export async function noteMutationErrorResponse(
240:   error: unknown,
241:   ctx: MeetingNoteRouteContext,
242:   noteId: string,
243:   context: string
244: ): Promise<NextResponse> {
245:   if (isStale(error, 'MEETING_NOTE_STALE_REVISION')) {
246:     try {
247:       const current = await loadMeetingNoteDetail(ctx.repository, ctx.dbUser, noteId);
248:       if (!current) return notFound('MEETING_NOTE_NOT_FOUND', ctx);
249:       return conflict('MEETING_NOTE_STALE_REVISION', current.revision, { note: current }, ctx);
250:     } catch (loadError) {
251:       return internalError(loadError, ctx, `${context}.loadCurrent`);
252:     }
253:   }
254:   if (error instanceof MeetingNoteDbError) return refusalResponse(error, ctx, context);
255:   return internalError(error, ctx, context);
256: }
257: 
258: /** Same for an action-item mutation; the 409 carries the item's current state. */
259: export async function itemMutationErrorResponse(
260:   error: unknown,
261:   ctx: MeetingNoteRouteContext,
262:   itemId: string,
263:   companyId: string | null,
264:   context: string
265: ): Promise<NextResponse> {
266:   if (isStale(error, 'MEETING_NOTE_ITEM_STALE_REVISION')) {
267:     try {
268:       const item = await ctx.repository.findActionItemById(itemId);
269:       if (!item) return notFound('MEETING_NOTE_ITEM_NOT_FOUND', ctx);
270:       const [view] = await loadActionItemViews(ctx.repository, companyId, [item]);
271:       return conflict('MEETING_NOTE_ITEM_STALE_REVISION', view.revision, { item: view }, ctx);
272:     } catch (loadError) {
273:       return internalError(loadError, ctx, `${context}.loadCurrent`);
274:     }
275:   }
276:   if (error instanceof MeetingNoteDbError) return refusalResponse(error, ctx, context);
277:   return internalError(error, ctx, context);
278: }
279: 
280: function conflict(
281:   code: 'MEETING_NOTE_STALE_REVISION' | 'MEETING_NOTE_ITEM_STALE_REVISION',
282:   currentRevision: number,
283:   current: Record<string, unknown>,
284:   ctx: { correlationId: string }
285: ): NextResponse {
286:   return NextResponse.json(
287:     { error: messageFor(code), code, currentRevision, correlationId: ctx.correlationId, ...current },
288:     { status: 409, headers: { 'x-correlation-id': ctx.correlationId } }
289:   );
290: }
291: 
292: /**
293:  * The item addressed by /api/meeting-notes/[id]/items/[itemId], read with the
294:  * caller's session; 404 unless it is visible AND belongs to that note (the
295:  * item RPCs take only the item id, and an item's note_id is immutable).
296:  */
297: export async function resolveItemInNote(
298:   ctx: MeetingNoteRouteContext,
299:   rawNoteId: string | undefined,
300:   rawItemId: string | undefined
301: ): Promise<Result<ActionItem>> {
302:   const noteId = parsePathId(rawNoteId, 'MEETING_NOTE_ITEM_NOT_FOUND', ctx);
303:   if (!noteId.ok) return noteId;
304:   const itemId = parsePathId(rawItemId, 'MEETING_NOTE_ITEM_NOT_FOUND', ctx);
305:   if (!itemId.ok) return itemId;
306:   try {
307:     const item = await ctx.repository.findActionItemById(itemId.value);
308:     if (!item || item.noteId !== noteId.value) {
309:       return { ok: false, response: notFound('MEETING_NOTE_ITEM_NOT_FOUND', ctx) };
310:     }
311:     return { ok: true, value: item };
312:   } catch (error) {
313:     return { ok: false, response: internalError(error, ctx, 'meetingNotes.item.resolve') };
314:   }
315: }
316: 
317: /** A success body with the correlation header. */
318: export function ok<T>(body: T, ctx: { correlationId: string }, status = 200): NextResponse<T> {
319:   return NextResponse.json(body, { status, headers: { 'x-correlation-id': ctx.correlationId } });
320: }
