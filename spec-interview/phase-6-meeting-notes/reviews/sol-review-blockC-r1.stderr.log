src/lib/meeting-notes/ai/ticket.ts
1: // src/lib/meeting-notes/ai/ticket.ts
2: // Signed processing tickets for the meeting-note AI flow (Phase 6 T9; FR-015,
3: // FR-031). A ticket is issued by the server when the provider notice is shown
4: // and is presented by the start request. It carries its issue time, a
5: // SERVER-GENERATED idempotency key, and the binding (application user,
6: // company, note, source note revision, transcript identity, AI settings
7: // revision), signed with HMAC-SHA256. A client can neither choose a key nor
8: // move a key to a new ticket: changing any byte invalidates the signature.
9: //
10: // Format: "mnt1.<base64url(canonical JSON payload)>.<base64url(HMAC-SHA256)>",
11: // the MAC computed over "mnt1.<payload segment>".
12: //
13: // Secrets (server-only environment, never NEXT_PUBLIC_):
14: //   MEETING_NOTES_TICKET_SECRET           required, >= 32 bytes with >= 16 distinct
15: //                                         bytes (random); signs and verifies.
16: //   MEETING_NOTES_TICKET_SECRET_PREVIOUS  optional, >= 32 bytes when set; verifies
17: //                                         only, so a rotation keeps outstanding
18: //                                         tickets valid for their 24 hours.
19: // There is no fallback: a missing or short secret raises
20: // MeetingNoteAiTicketConfigError (callers answer with a configuration error).
21: // Neither secret is ever logged or included in an error message.
22: import 'server-only';
23: 
24: import { createHmac, randomUUID, timingSafeEqual } from 'node:crypto';
25: import { z } from 'zod';
26: 
27: const PREFIX = 'mnt1';
28: const VERSION = 1;
29: /** A ticket and its idempotency key are valid for 24 hours after issuance. */
30: export const MEETING_NOTE_AI_TICKET_TTL_SECONDS = 24 * 60 * 60;
31: /** Accepted clock skew for an issue time in the future. */
32: const MAX_FUTURE_SKEW_SECONDS = 60;
33: const MIN_SECRET_BYTES = 32;
34: /** A random 32+ byte secret has far more distinct bytes; fewer means a placeholder or a typed word. */
35: const MIN_SECRET_DISTINCT_BYTES = 16;
36: /** A real ticket is ~450 characters; anything far longer is not a ticket. */
37: const MAX_TICKET_LENGTH = 2_048;
38: const MAC_BYTES = 32;
39: const SEGMENT = /^[A-Za-z0-9_-]+$/;
40: 
41: export const MEETING_NOTES_TICKET_SECRET_ENV = 'MEETING_NOTES_TICKET_SECRET';
42: export const MEETING_NOTES_TICKET_SECRET_PREVIOUS_ENV = 'MEETING_NOTES_TICKET_SECRET_PREVIOUS';
43: 
44: /** What a ticket binds: the operation's identity apart from its key and time. */
45: export interface MeetingNoteAiTicketBinding {
46:   /** Application users.id of the authenticated requester. */
47:   userId: string;
48:   companyId: string;
49:   noteId: string;
50:   /** Note revision the notice was shown for (the draft's source revision). */
51:   sourceRevision: number;
52:   /** Stored-transcript identity the notice was shown for. */
53:   transcriptId: string;
54:   /** AI settings revision the notice was shown for. */
55:   settingsRevision: number;
56: }
57: 
58: export interface MeetingNoteAiTicketPayload extends MeetingNoteAiTicketBinding {
59:   v: typeof VERSION;
60:   /** Issue time, whole seconds since the Unix epoch. */
61:   iat: number;
62:   /** Server-generated idempotency key (UUID), unique per ticket. */
63:   idempotencyKey: string;
64: }
65: 
66: export interface IssuedMeetingNoteAiTicket {
67:   ticket: string;
68:   payload: MeetingNoteAiTicketPayload;
69:   /** ISO time after which the ticket and its key are rejected as expired. */
70:   expiresAt: string;
71: }
72: 
73: export type MeetingNoteAiTicketRejection = 'malformed' | 'invalid_signature' | 'expired' | 'not_yet_valid';
74: 
75: export type MeetingNoteAiTicketVerification =
76:   | { ok: true; payload: MeetingNoteAiTicketPayload; expiresAt: string }
77:   | { ok: false; reason: MeetingNoteAiTicketRejection };
78: 
79: /** The ticket secret is missing or too short (no fallback exists). */
80: export class MeetingNoteAiTicketConfigError extends Error {
81:   constructor() {
82:     super('The meeting-notes ticket secret is not configured.');
83:     this.name = 'MeetingNoteAiTicketConfigError';
84:   }
85: }
86: 
87: const uuid = z.guid();
88: const revision = z.number().int().min(1).max(Number.MAX_SAFE_INTEGER);
89: 
90: const payloadSchema = z
91:   .object({
92:     v: z.literal(VERSION),
93:     iat: z.number().int().min(0).max(Number.MAX_SAFE_INTEGER),
94:     idempotencyKey: uuid,
95:     userId: uuid,
96:     companyId: uuid,
97:     noteId: uuid,
98:     sourceRevision: revision,
99:     transcriptId: uuid,
100:     settingsRevision: revision,
101:   })
102:   .strict();
103: 
104: const bindingSchema = payloadSchema.omit({ v: true, iat: true, idempotencyKey: true });
105: 
106: function secretFrom(name: string, required: boolean): Buffer | null {
107:   const value = process.env[name];
108:   if (value === undefined || value === '') {
109:     if (required) throw new MeetingNoteAiTicketConfigError();
110:     return null;
111:   }
112:   const bytes = Buffer.from(value, 'utf8');
113:   if (bytes.length < MIN_SECRET_BYTES || new Set(bytes).size < MIN_SECRET_DISTINCT_BYTES) {
114:     throw new MeetingNoteAiTicketConfigError();
115:   }
116:   return bytes;
117: }
118: 
119: function currentSecret(): Buffer {
120:   const secret = secretFrom(MEETING_NOTES_TICKET_SECRET_ENV, true);
121:   if (!secret) throw new MeetingNoteAiTicketConfigError();
122:   return secret;
123: }
124: 
125: /** Throws MeetingNoteAiTicketConfigError unless tickets can be issued and verified. */
126: export function assertMeetingNoteAiTicketConfigured(): void {
127:   currentSecret();
128:   secretFrom(MEETING_NOTES_TICKET_SECRET_PREVIOUS_ENV, false);
129: }
130: 
131: function mac(secret: Buffer, signedPart: string): Buffer {
132:   return createHmac('sha256', secret).update(signedPart, 'utf8').digest();
133: }
134: 
135: /** Fixed key order: the payload bytes depend only on the values. */
136: function canonicalJson(payload: MeetingNoteAiTicketPayload): string {
137:   return JSON.stringify({
138:     v: payload.v,
139:     iat: payload.iat,
140:     idempotencyKey: payload.idempotencyKey,
141:     userId: payload.userId,
142:     companyId: payload.companyId,
143:     noteId: payload.noteId,
144:     sourceRevision: payload.sourceRevision,
145:     transcriptId: payload.transcriptId,
146:     settingsRevision: payload.settingsRevision,
147:   });
148: }
149: 
150: function expiresAtOf(iat: number): string {
151:   return new Date((iat + MEETING_NOTE_AI_TICKET_TTL_SECONDS) * 1000).toISOString();
152: }
153: 
154: /** The issue time as the ISO instant the admission RPC binds. */
155: export function meetingNoteAiTicketIssuedAt(payload: Pick<MeetingNoteAiTicketPayload, 'iat'>): string {
156:   return new Date(payload.iat * 1000).toISOString();
157: }
158: 
159: /**
160:  * Signs a new ticket with a fresh server-generated idempotency key. Call only
161:  * after the route authorized the user (current membership and editor rights).
162:  */
163: export function issueMeetingNoteAiTicket(
164:   binding: MeetingNoteAiTicketBinding,
165:   nowMs: number = Date.now()
166: ): IssuedMeetingNoteAiTicket {
167:   const secret = currentSecret();
168:   secretFrom(MEETING_NOTES_TICKET_SECRET_PREVIOUS_ENV, false);
169:   const checked = bindingSchema.parse(binding);
170:   const payload: MeetingNoteAiTicketPayload = {
171:     v: VERSION,
172:     iat: Math.floor(nowMs / 1000),
173:     idempotencyKey: randomUUID(),
174:     ...checked,
175:   };
176:   const encoded = Buffer.from(canonicalJson(payload), 'utf8').toString('base64url');
177:   const signedPart = `${PREFIX}.${encoded}`;
178:   const ticket = `${signedPart}.${mac(secret, signedPart).toString('base64url')}`;
179:   return { ticket, payload, expiresAt: expiresAtOf(payload.iat) };
180: }
181: 
182: function macMatches(secret: Buffer, signedPart: string, received: Buffer): boolean {
183:   const expected = mac(secret, signedPart);
184:   return received.length === expected.length && timingSafeEqual(received, expected);
185: }
186: 
187: /**
188:  * Verifies a presented ticket: format, signature (current secret, then the
189:  * previous one), payload shape, and the 24-hour validity of the ticket and its
190:  * key. Throws MeetingNoteAiTicketConfigError when the secret is missing.
191:  */
192: export function verifyMeetingNoteAiTicket(ticket: unknown, nowMs: number = Date.now()): 
MeetingNoteAiTicketVerification {
193:   const current = currentSecret();
194:   const previous = secretFrom(MEETING_NOTES_TICKET_SECRET_PREVIOUS_ENV, false);
195: 
196:   if (typeof ticket !== 'string' || ticket.length > MAX_TICKET_LENGTH) return { ok: false, reason: 'malformed' };
197:   const parts = ticket.split('.');
198:   if (parts.length !== 3 || parts[0] !== PREFIX || !SEGMENT.test(parts[1]) || !SEGMENT.test(parts[2])) {
199:     return { ok: false, reason: 'malformed' };
200:   }
201:   const received = Buffer.from(parts[2], 'base64url');
202:   if (received.length !== MAC_BYTES || received.toString('base64url') !== parts[2]) {
203:     return { ok: false, reason: 'malformed' };
204:   }
205: 
206:   const signedPart = `${PREFIX}.${parts[1]}`;
207:   const signed = macMatches(current, signedPart, received) || (previous !== null && macMatches(previous, 
signedPart, received));
208:   if (!signed) return { ok: false, reason: 'invalid_signature' };
209: 
210:   let decoded: unknown;
211:   try {
212:     decoded = JSON.parse(new TextDecoder('utf-8', { fatal: true }).decode(Buffer.from(parts[1], 'base64url')));
213:   } catch {
214:     return { ok: false, reason: 'malformed' };
215:   }
216:   const parsed = payloadSchema.safeParse(decoded);
217:   if (!parsed.success) return { ok: false, reason: 'malformed' };
218:   const payload = parsed.data;
219: 
220:   const nowSeconds = Math.floor(nowMs / 1000);
221:   if (payload.iat > nowSeconds + MAX_FUTURE_SKEW_SECONDS) return { ok: false, reason: 'not_yet_valid' };
222:   if (nowSeconds >= payload.iat + MEETING_NOTE_AI_TICKET_TTL_SECONDS) return { ok: false, reason: 'expired' };
223: 
224:   return { ok: true, payload, expiresAt: expiresAtOf(payload.iat) };
225: }
src/app/api/meeting-notes/[id]/ai/ticket/route.ts
1: // src/app/api/meeting-notes/[id]/ai/ticket/route.ts
2: // Processing ticket for the meeting-note AI flow (Phase 6 T9; FR-015, FR-031).
3: //
4: // POST issues the provider notice data and a signed processing ticket. It is
5: // called when the notice is shown. The route authorizes the session user
6: // first (auth.getUser → users.supabase_uid → current users row), reads the
7: // note under RLS (members of the note's company only), and requires editor
8: // rights (author while a member, current participant, or company admin —
9: // BR-003, the same rule the database applies) and a stored transcript. Only
10: // then does it read the AI settings metadata and today's usage (both through
11: // the user's session, own company only) and sign a ticket bound to the user,
12: // company, note, note revision, transcript identity, and settings revision,
13: // with a fresh SERVER-GENERATED idempotency key. Nothing is reserved here:
14: // the admission RPC re-checks membership, rights, settings revision, source,
15: // and the limit when processing starts. The API key is never read here.
16: import { NextRequest, NextResponse } from 'next/server';
17: 
18: import {
19:   issueMeetingNoteAiTicket,
20:   MeetingNoteAiTicketConfigError,
21: } from '@/lib/meeting-notes/ai/ticket';
22: import { computeMeetingNoteRights } from '@/lib/meeting-notes/note-detail';
23: import {
24:   beginMeetingNoteRequest,
25:   internalError,
26:   meetingNoteError,
27:   meetingNoteErrorWithData,
28:   notFound,
29:   ok,
30:   parsePathId,
31: } from '@/lib/meeting-notes/route-support';
32: import { SupabaseMeetingNoteAiOperationRepository } from 
'@/repositories/implementations/supabase/SupabaseMeetingNoteAiOperationRepository';
33: import { SupabaseMeetingNoteAiSettingsRepository } from 
'@/repositories/implementations/supabase/SupabaseMeetingNoteAiSettingsRepository';
34: import type { MeetingNoteAiTicketResponse } from '@/types/meeting-notes';
35: 
36: export const dynamic = 'force-dynamic';
37: 
38: interface RouteParams {
39:   params: Promise<{ id: string }>;
40: }
41: 
42: const PATH = '/api/meeting-notes/[id]/ai/ticket';
43: 
44: /**
45:  * POST /api/meeting-notes/[id]/ai/ticket (no body) → 200 MeetingNoteAiTicketResponse.
46:  * 404 MEETING_NOTE_NOT_FOUND (missing, other company, or caller removed);
47:  * 403 MEETING_NOTE_FORBIDDEN (member without edit rights);
48:  * 409 MEETING_NOTE_AI_TRANSCRIPT_REQUIRED (no stored transcript);
49:  * 409 MEETING_NOTE_AI_NOT_CONFIGURED { canConfigure } (no provider; admins get the settings hint);
50:  * 503 MEETING_NOTE_AI_UNAVAILABLE (server ticket secret missing — configuration error).
51:  */
52: export async function POST(request: NextRequest, { params }: RouteParams): Promise<NextResponse> {
53:   // No body is read; release it whatever happens.
54:   await request.body?.cancel().catch(() => undefined);
55: 
56:   const begun = await beginMeetingNoteRequest(PATH, 'meeting-note:ai-ticket');
57:   if (!begun.ok) return begun.response;
58:   const ctx = begun.value;
59: 
60:   const id = parsePathId((await params).id, 'MEETING_NOTE_NOT_FOUND', ctx);
61:   if (!id.ok) return id.response;
62: 
63:   try {
64:     const note = await ctx.repository.findById(id.value);
65:     if (!note || !ctx.dbUser.companyId || note.companyId !== ctx.dbUser.companyId) {
66:       return notFound('MEETING_NOTE_NOT_FOUND', ctx);
67:     }
68:     const participants = await ctx.repository.findParticipants(note.id);
69:     const rights = computeMeetingNoteRights(
70:       ctx.dbUser,
71:       note,
72:       participants.map((participant) => participant.userId)
73:     );
74:     if (!rights.canEdit) {
75:       return meetingNoteError(403, 'MEETING_NOTE_FORBIDDEN', ctx, 'meetingNotes.aiTicket.authorize');
76:     }
77:     if (!note.transcriptId) {
78:       return meetingNoteError(409, 'MEETING_NOTE_AI_TRANSCRIPT_REQUIRED', ctx, 'meetingNotes.aiTicket');
79:     }
80: 
81:     const settings = await new SupabaseMeetingNoteAiSettingsRepository(ctx.supabase).findByCompany(note.companyId);
82:     if (!settings.configured || !settings.provider || !settings.model || !settings.reasoningLevel || 
!settings.revision) {
83:       return meetingNoteErrorWithData(409, 'MEETING_NOTE_AI_NOT_CONFIGURED', ctx, {
84:         canConfigure: ctx.dbUser.role === 'admin',
85:       });
86:     }
87: 
88:     const usage = await new SupabaseMeetingNoteAiOperationRepository(ctx.supabase).getOwnCompanyUsage();
89: 
90:     let issued;
91:     try {
92:       issued = issueMeetingNoteAiTicket({
93:         userId: ctx.dbUser.id,
94:         companyId: note.companyId,
95:         noteId: note.id,
96:         sourceRevision: note.revision,
97:         transcriptId: note.transcriptId,
98:         settingsRevision: settings.revision,
99:       });
100:     } catch (error) {
101:       if (error instanceof MeetingNoteAiTicketConfigError) {
102:         // The event names the condition only; never the variable's value.
103:         console.error(
104:           JSON.stringify({ event: 'meeting_notes_ticket_secret_unconfigured', correlationId: ctx.correlationId })
105:         );
106:         return meetingNoteError(503, 'MEETING_NOTE_AI_UNAVAILABLE', ctx, 'meetingNotes.aiTicket.config');
107:       }
108:       throw error;
109:     }
110: 
111:     const body: MeetingNoteAiTicketResponse = {
112:       ticket: issued.ticket,
113:       expiresAt: issued.expiresAt,
114:       provider: settings.provider,
115:       model: settings.model,
116:       reasoningLevel: settings.reasoningLevel,
117:       settingsRevision: settings.revision,
118:       noteRevision: note.revision,
119:       transcriptId: note.transcriptId,
120:       usage: {
121:         limit: usage.limit,
122:         used: usage.used,
123:         usageDay: usage.usageDay,
124:         resetAt: usage.resetAt,
125:         limitReached: usage.used >= usage.limit,
126:       },
127:     };
128:     return ok(body, ctx);
129:   } catch (error) {
130:     return internalError(error, ctx, 'meetingNotes.aiTicket');
131:   }
132: }
src/repositories/implementations/supabase/SupabaseMeetingNoteAiOperationRepository.ts
1: // src/repositories/implementations/supabase/SupabaseMeetingNoteAiOperationRepository.ts
2: // AI usage and processing operations (Phase 6 T9; migration 20261013154823).
3: // Construct with the user's server client for getOwnCompanyUsage (RPC granted
4: // to authenticated, scoped to the caller's company), and with the
5: // service-role client for admit / markDispatched / settle (service_role-only
6: // RPCs), only after the route authorized the application user. Server-only:
7: // an admission carries a decrypted API key and the transcript text.
8: // Deliberately not re-exported from the implementations index, which client
9: // code may import.
10: import 'server-only';
11: 
12: import type { PostgrestError, SupabaseClient } from '@supabase/supabase-js';
13: 
14: import { MeetingNoteDbError } from '@/lib/meeting-notes/errors';
15: import type {
16:   AdmitMeetingNoteAiOperationParams,
17:   IMeetingNoteAiOperationRepository,
18:   MeetingNoteAiAdmission,
19:   MeetingNoteAiCompanyUsage,
20:   MeetingNoteAiOperationTransition,
21:   MeetingNoteAiReplay,
22:   MeetingNoteAiSettlement,
23: } from '@/repositories/interfaces/IMeetingNoteAiOperationRepository';
24: import type {
25:   MeetingNoteAiOperationStatus,
26:   MeetingNoteAiProvider,
27:   MeetingNoteAiSettlementOutcome,
28:   MeetingNoteAiUsage,
29: } from '@/types/meeting-notes';
30: 
31: const PROVIDERS: ReadonlySet<string> = new Set<MeetingNoteAiProvider>(['anthropic', 'openai', 'kimi', 'glm']);
32: const STATUSES: ReadonlySet<string> = new Set<MeetingNoteAiOperationStatus>([
33:   'admitted',
34:   'dispatched',
35:   'succeeded',
36:   'failed',
37:   'discarded',
38:   'refunded',
39:   'released',
40: ]);
41: 
42: type Row = Record<string, unknown>;
43: 
44: function toDbError(error: PostgrestError): MeetingNoteDbError {
45:   return new MeetingNoteDbError(error.code, error.message, error.details);
46: }
47: 
48: /** A fixed message: never the payload (it could carry the key or transcript). */
49: function invalidShape(what: string): MeetingNoteDbError {
50:   return new MeetingNoteDbError(undefined, `${what} returned an unexpected shape`, null);
51: }
52: 
53: function asRow(data: unknown, what: string): Row {
54:   if (!data || typeof data !== 'object' || Array.isArray(data)) throw invalidShape(what);
55:   return data as Row;
56: }
57: 
58: function str(row: Row, key: string, what: string): string {
59:   const value = row[key];
60:   if (typeof value !== 'string') throw invalidShape(what);
61:   return value;
62: }
63: 
64: function int(row: Row, key: string, what: string): number {
65:   const raw = row[key];
66:   const value = typeof raw === 'string' ? Number(raw) : raw;
67:   if (typeof value !== 'number' || !Number.isSafeInteger(value)) throw invalidShape(what);
68:   return value;
69: }
70: 
71: function bool(row: Row, key: string, what: string): boolean {
72:   const value = row[key];
73:   if (typeof value !== 'boolean') throw invalidShape(what);
74:   return value;
75: }
76: 
77: function provider(row: Row, what: string): MeetingNoteAiProvider {
78:   const value = row.provider;
79:   if (typeof value !== 'string' || !PROVIDERS.has(value)) throw invalidShape(what);
80:   return value as MeetingNoteAiProvider;
81: }
82: 
83: function status(row: Row, what: string): MeetingNoteAiOperationStatus {
84:   const value = row.status;
85:   if (typeof value !== 'string' || !STATUSES.has(value)) throw invalidShape(what);
86:   return value as MeetingNoteAiOperationStatus;
87: }
88: 
89: function usage(row: Row, what: string): MeetingNoteAiUsage {
90:   return {
91:     limit: int(row, 'limit', what),
92:     used: int(row, 'used', what),
93:     usageDay: str(row, 'usage_day', what),
94:     resetAt: new Date(str(row, 'reset_at', what)).toISOString(),
95:   };
96: }
97: 
98: export class SupabaseMeetingNoteAiOperationRepository implements IMeetingNoteAiOperationRepository {
99:   constructor(private readonly supabase: SupabaseClient) {}
100: 
101:   async getOwnCompanyUsage(): Promise<MeetingNoteAiCompanyUsage> {
102:     const what = 'get_meeting_note_ai_usage';
103:     const { data, error } = await this.supabase.rpc(what);
104:     if (error) throw toDbError(error);
105:     const row = asRow(data, what);
106:     return {
107:       configured: bool(row, 'configured', what),
108:       ...usage({ ...row, limit: row.daily_limit }, what),
109:     };
110:   }
111: 
112:   async admit(params: AdmitMeetingNoteAiOperationParams): Promise<MeetingNoteAiAdmission | MeetingNoteAiReplay> {
113:     const what = 'admit_meeting_note_ai_operation';
114:     const { data, error } = await this.supabase.rpc(what, {
115:       p_actor_user_id: params.actorUserId,
116:       p_company_id: params.companyId,
117:       p_note_id: params.noteId,
118:       p_idempotency_key: params.idempotencyKey,
119:       p_ticket_issued_at: params.ticketIssuedAt,
120:       p_source_revision: params.sourceRevision,
121:       p_transcript_id: params.transcriptId,
122:       p_settings_revision: params.settingsRevision,
123:     });
124:     if (error) throw toDbError(error);
125:     const row = asRow(data, what);
126:     const base = {
127:       operationId: str(row, 'operation_id', what),
128:       admissionDay: str(row, 'admission_day', what),
129:       provider: provider(row, what),
130:       model: str(row, 'model', what),
131:       reasoningLevel: str(row, 'reasoning_level', what),
132:       settingsRevision: int(row, 'settings_revision', what),
133:     };
134:     if (bool(row, 'replay', what)) {
135:       return { replay: true, status: status(row, what), ...base };
136:     }
137:     if (status(row, what) !== 'admitted') throw invalidShape(what);
138:     return {
139:       replay: false,
140:       status: 'admitted',
141:       ...base,
142:       sourceRevision: int(row, 'source_revision', what),
143:       transcriptId: str(row, 'transcript_id', what),
144:       apiKey: str(row, 'api_key', what),
145:       transcript: str(row, 'transcript', what),
146:       usage: usage(asRow(row.usage, what), what),
147:     };
148:   }
149: 
150:   async markDispatched(operationId: string): Promise<MeetingNoteAiOperationTransition> {
151:     const what = 'mark_meeting_note_ai_operation_dispatched';
152:     const { data, error } = await this.supabase.rpc(what, { p_operation_id: operationId });
153:     if (error) throw toDbError(error);
154:     const row = asRow(data, what);
155:     return { operationId: str(row, 'operation_id', what), status: status(row, what), changed: bool(row, 
'changed', what) };
156:   }
157: 
158:   async settle(operationId: string, outcome: MeetingNoteAiSettlementOutcome): Promise<MeetingNoteAiSettlement> {
159:     const what = 'settle_meeting_note_ai_operation';
160:     const { data, error } = await this.supabase.rpc(what, { p_operation_id: operationId, p_outcome: outcome });
161:     if (error) throw toDbError(error);
162:     const row = asRow(data, what);
163:     return {
164:       operationId: str(row, 'operation_id', what),
165:       status: status(row, what),
166:       changed: bool(row, 'changed', what),
167:       counted: bool(row, 'counted', what),
168:       admissionDay: str(row, 'admission_day', what),
169:     };
170:   }
171: }
src/repositories/interfaces/IMeetingNoteAiOperationRepository.ts
1: // src/repositories/interfaces/IMeetingNoteAiOperationRepository.ts
2: // AI usage and processing operations (Phase 6 T9; migration 20261013154823).
3: // The usage read runs under the caller's session (own company only); admit,
4: // markDispatched, and settle are service_role-only RPCs called by server code
5: // AFTER the route authorized the application user and verified the ticket.
6: import type {
7:   MeetingNoteAiOperationStatus,
8:   MeetingNoteAiProvider,
9:   MeetingNoteAiSettlementOutcome,
10:   MeetingNoteAiUsage,
11: } from '@/types/meeting-notes';
12: 
13: export interface AdmitMeetingNoteAiOperationParams {
14:   /** Server-derived application users.id of the authenticated requester. */
15:   actorUserId: string;
16:   companyId: string;
17:   noteId: string;
18:   /** The server-generated key embedded in the verified ticket. */
19:   idempotencyKey: string;
20:   /** The ticket's issue time (ISO). */
21:   ticketIssuedAt: string;
22:   sourceRevision: number;
23:   transcriptId: string;
24:   settingsRevision: number;
25: }
26: 
27: /** A new admission: the snapshot, key, and transcript from ONE transaction (server code only). */
28: export interface MeetingNoteAiAdmission {
29:   replay: false;
30:   operationId: string;
31:   status: 'admitted';
32:   admissionDay: string;
33:   provider: MeetingNoteAiProvider;
34:   model: string;
35:   reasoningLevel: string;
36:   settingsRevision: number;
37:   sourceRevision: number;
38:   transcriptId: string;
39:   /** Decrypted provider key; never returned to a client or logged. */
40:   apiKey: string;
41:   /** The bound transcript text; never logged. */
42:   transcript: string;
43:   usage: MeetingNoteAiUsage;
44: }
45: 
46: /** A replay of an existing operation: its stored status only (no key, no transcript, nothing reserved). */
47: export interface MeetingNoteAiReplay {
48:   replay: true;
49:   operationId: string;
50:   status: MeetingNoteAiOperationStatus;
51:   admissionDay: string;
52:   provider: MeetingNoteAiProvider;
53:   model: string;
54:   reasoningLevel: string;
55:   settingsRevision: number;
56: }
57: 
58: export interface MeetingNoteAiOperationTransition {
59:   operationId: string;
60:   status: MeetingNoteAiOperationStatus;
61:   /** false when the call found the operation already in that (or a terminal) state. */
62:   changed: boolean;
63: }
64: 
65: export interface MeetingNoteAiSettlement extends MeetingNoteAiOperationTransition {
66:   /** Whether the operation counts toward its admission day's limit. */
67:   counted: boolean;
68:   admissionDay: string;
69: }
70: 
71: export interface MeetingNoteAiCompanyUsage extends MeetingNoteAiUsage {
72:   configured: boolean;
73: }
74: 
75: export interface IMeetingNoteAiOperationRepository {
76:   /** The caller's own company usage for today (user session client). */
77:   getOwnCompanyUsage(): Promise<MeetingNoteAiCompanyUsage>;
78:   /** Admission or replay (service-role client). Refusals throw MeetingNoteDbError with a token. */
79:   admit(params: AdmitMeetingNoteAiOperationParams): Promise<MeetingNoteAiAdmission | MeetingNoteAiReplay>;
80:   /** Records that the one provider request is being sent (service-role client). */
81:   markDispatched(operationId: string): Promise<MeetingNoteAiOperationTransition>;
82:   /** Settles the operation once (service-role client); a terminal operation is returned unchanged. */
83:   settle(operationId: string, outcome: MeetingNoteAiSettlementOutcome): Promise<MeetingNoteAiSettlement>;
84: }
