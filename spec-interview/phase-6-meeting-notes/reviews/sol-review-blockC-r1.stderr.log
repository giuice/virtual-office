341: // ---------------------------------------------------------------------------
342: // Error after the response was accepted (stream already begun)
343: // ---------------------------------------------------------------------------
344: 
345: const MID_STREAM_DEFAULTS: Readonly<Record<FakeAiProvider, Required<Pick<FakeAiErrorFields, 'message'>> & 
FakeAiErrorFields>> = {
346:   anthropic: { errorType: 'overloaded_error', message: 'Overloaded' },
347:   openai: { errorType: 'service_unavailable_error', errorCode: 'server_is_overloaded', message: 'The server is 
overloaded.' },
348:   kimi: { errorType: 'engine_overloaded_error', message: 'The engine is currently overloaded.' },
349:   glm: { errorCode: '1305', message: 'The service may be temporarily overloaded, please try again later.' },
350: };
351: 
352: export function sendStreamErrorAfterStart(ctx: FakeAiReplyContext, fields: FakeAiErrorFields, abrupt: boolean): 
void {
353:   const defaults = MID_STREAM_DEFAULTS[ctx.provider];
354:   const merged: FakeAiErrorFields = {
355:     errorType: fields.errorType ?? defaults.errorType,
356:     errorCode: fields.errorCode ?? defaults.errorCode,
357:     message: fields.message ?? defaults.message,
358:   };
359:   const partialText = '{"summary": {"keyPoints": ["';
360: 
361:   if (!ctx.stream) {
362:     // A JSON request: 200 headers and a partial body, then the connection closes.
363:     ctx.res.writeHead(200, { 'content-type': 'application/json', ...requestIdHeader(ctx) });
364:     writeThenDestroy(ctx.res, `{"id":"${messageId(ctx)}","content":[{"type":"text","text":`);
365:     return;
366:   }
367: 
368:   startSse(ctx);
369:   if (ctx.provider === 'anthropic') {
370:     const started = anthropicPrelude(ctx, Math.max(1, Math.ceil(ctx.bodyBytes / 4))) + anthropicTextStart(0) + 
anthropicTextDelta(0, partialText);
371:     if (abrupt) {
372:       writeThenDestroy(ctx.res, started);
373:       return;
374:     }
375:     const error = errorEnvelope('anthropic', 529, merged, ctx.seq) as Record<string, unknown>;
376:     ctx.res.end(started + sseEvent('error', { type: 'error', error: error.error }));
377:     return;
378:   }
379: 
380:   const started =
381:     sseEvent(null, chatChunk(ctx, { role: 'assistant', content: '' }, null)) + sseEvent(null, chatChunk(ctx, { 
content: partialText }, null));
382:   if (abrupt) {
383:     writeThenDestroy(ctx.res, started);
384:     return;
385:   }
386:   const envelope = errorEnvelope(ctx.provider, 503, merged, ctx.seq) as { error: Record<string, unknown> };
387:   ctx.res.end(started + sseEvent(null, { error: envelope.error }));
388: }

