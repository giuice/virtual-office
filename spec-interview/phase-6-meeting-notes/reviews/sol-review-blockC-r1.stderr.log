20: function modelText(provider: FakeAiProvider, payload: unknown): string {
21:   if (provider === 'anthropic') {
22:     const content = (payload as { content?: Array<{ type: string; text?: string }> }).content ?? [];
23:     return content.find((block) => block.type === 'text')?.text ?? fail(provider, 'response has no text block');
24:   }
25:   const choice = (payload as { choices?: Array<{ message?: { content?: string | null } }> }).choices?.[0];
26:   return choice?.message?.content ?? fail(provider, 'response has no choices[0].message.content');
