184: /** A loopback port with no listener (connection refused). */
185: async function closedLoopbackPort(): Promise<number> {
186:   const server = createServer();
187:   await new Promise<void>((resolve) => server.listen(0, '127.0.0.1', resolve));
188:   const address = server.address();
189:   const port = typeof address === 'object' && address ? address.port : 0;
190:   await new Promise<void>((resolve) => server.close(() => resolve()));
191:   return port;
192: }
