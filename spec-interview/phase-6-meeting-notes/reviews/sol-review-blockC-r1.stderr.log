433: /** Provider order shown to admins. */
434: const PROVIDER_ORDER: readonly MeetingNoteAiProvider[] = ['anthropic', 'openai', 'kimi', 'glm'];
435: 
436: export function findMeetingNoteAiModel(
437:   provider: MeetingNoteAiProvider,
438:   modelId: string
439: ): MeetingNoteAiModelCapability | null {
440:   return MEETING_NOTE_AI_CAPABILITIES[provider].models.find((model) => model.id === modelId) ?? null;
441: }
442: 
443: /** Whether an admin's provider/model/reasoning choice is in the matrix. */
444: export function checkMeetingNoteAiSelection(
445:   provider: MeetingNoteAiProvider,
446:   modelId: string,
447:   reasoningLevel: string
448: ): 'ok' | 'MEETING_NOTE_AI_MODEL_INVALID' | 'MEETING_NOTE_AI_REASONING_INVALID' {
449:   const model = findMeetingNoteAiModel(provider, modelId);
450:   if (!model) return 'MEETING_NOTE_AI_MODEL_INVALID';
451:   return model.reasoningLevels.some((level) => level.id === reasoningLevel) ? 'ok' : 
'MEETING_NOTE_AI_REASONING_INVALID';
452: }
453: 
454: /** The non-secret part of the matrix the admin form needs (no wire data, URLs, or rejections). */
455: export function meetingNoteAiProviderOptions(): MeetingNoteAiProviderOption[] {
456:   return PROVIDER_ORDER.map((id) => {
457:     const provider = MEETING_NOTE_AI_CAPABILITIES[id];
458:     return {
459:       id,
460:       label: provider.label,
461:       models: provider.models.map(
462:         (model): MeetingNoteAiModelOption => ({
463:           id: model.id,
464:           label: model.label,
465:           reasoningLevels: model.reasoningLevels.map(({ id: levelId, label }) => ({ id: levelId, label })),
466:           defaultReasoningLevel: model.defaultReasoningLevel,
467:           contextWindowTokens: model.contextWindowTokens,
468:           maxOutputTokens: model.maxOutputTokens,
469:         })
470:       ),
471:     };
472:   });
473: }
