91: /** Invokes `handler` as `cookies`' session and returns status + JSON body. */
92: export async function callRoute<P extends Record<string, string>>(
93:   cookies: readonly SessionCookie[],
94:   handler: Handler<P>,
95:   call: RouteCall<P>,
96: ): Promise<RouteResult> {
97:   return asSession(cookies, async () => {
98:     const init: { method: string; headers?: Record<string, string>; body?: string | Uint8Array<ArrayBuffer> } = {
99:       method: call.method,
100:     };
101:     if (call.form !== undefined) {
102:       // Serialized up front, like bytes arriving from the network (a request
103:       // streaming a live FormData cannot be cancelled cleanly in undici).
104:       const encoded = new Response(call.form);
105:       init.headers = { 'content-type': encoded.headers.get('content-type') ?? '' };
106:       init.body = new Uint8Array(await encoded.arrayBuffer());
107:     } else if (call.body !== undefined) {
108:       init.headers = { 'content-type': 'application/json' };
109:       init.body = JSON.stringify(call.body);
110:     }
111:     const request = new NextRequest(`http://localhost${call.path}`, init);
112:     const response = await handler(request, { params: Promise.resolve(call.params ?? ({} as P)) });
113:     const body = (await response.json()) as Record<string, unknown>;
114:     return { status: response.status, body };
115:   });
116: }

