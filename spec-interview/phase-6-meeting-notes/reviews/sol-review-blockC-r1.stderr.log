172: -- ---------------------------------------------------------------------------
173: -- Operations table
174: -- ---------------------------------------------------------------------------
175: 
176: create table public.meeting_note_ai_operations (
177:   id uuid not null default pg_catalog.gen_random_uuid(),
178:   idempotency_key uuid not null,
179:   kind text not null default 'transcript_draft'
180:     constraint meeting_note_ai_operations_kind_check
181:       check (kind = 'transcript_draft'),
182:   company_id uuid not null
183:     references public.companies (id) on delete cascade,
184:   user_id uuid not null,
185:   note_id uuid not null,
186:   source_revision bigint not null
187:     constraint meeting_note_ai_operations_source_revision_check
188:       check (source_revision >= 1),
189:   transcript_id uuid not null,
190:   settings_revision bigint not null
191:     constraint meeting_note_ai_operations_settings_revision_check
192:       check (settings_revision >= 1),
193:   ticket_issued_at timestamptz not null,
194:   provider text not null
195:     constraint meeting_note_ai_operations_provider_check
196:       check (provider in ('anthropic', 'openai', 'kimi', 'glm')),
197:   model text not null,
198:   reasoning_level text not null,
199:   admission_day date not null,
200:   status text not null default 'admitted'
201:     constraint meeting_note_ai_operations_status_check
202:       check (status in ('admitted', 'dispatched', 'succeeded', 'failed', 'discarded', 'refunded', 'released')),
203:   admitted_at timestamptz not null default pg_catalog.now(),
204:   dispatched_at timestamptz,
205:   settled_at timestamptz,
206:   constraint meeting_note_ai_operations_pkey primary key (id),
207:   constraint meeting_note_ai_operations_idempotency_key_key unique (idempotency_key),
208:   constraint meeting_note_ai_operations_settled_check
209:     check ((settled_at is null) = (status in ('admitted', 'dispatched'))),
210:   constraint meeting_note_ai_operations_dispatched_check
211:     check (
212:       (status in ('admitted', 'released') and dispatched_at is null)
213:       or (status in ('dispatched', 'succeeded', 'discarded', 'refunded') and dispatched_at is not null)
214:       or status = 'failed'
215:     )
216: );
217: 
218: comment on table public.meeting_note_ai_operations is
219:   'Phase 6: AI processing operations (idempotency + usage), no transcript or draft content. Counted statuses: 
admitted, dispatched, succeeded, failed, discarded. Written only by the service_role meeting-note AI RPCs; kept 30 
days.';
220: comment on column public.meeting_note_ai_operations.user_id is
221:   'Application users.id of the requester (no FK: deleting the user never changes usage).';
222: comment on column public.meeting_note_ai_operations.note_id is
223:   'The note the operation was admitted for (no FK: deleting the note never changes usage).';
224: comment on column public.meeting_note_ai_operations.admission_day is
225:   'Calendar date in America/Sao_Paulo at admission; usage and settlement always count against this day.';
226: 
227: -- Today's count per company (admission and the usage read).
228: create index meeting_note_ai_operations_company_day_idx
229:   on public.meeting_note_ai_operations (company_id, admission_day, status);
230: -- Stale-operation job.
231: create index meeting_note_ai_operations_dispatched_open_idx
232:   on public.meeting_note_ai_operations (dispatched_at)
233:   where status = 'dispatched';
234: -- Stale admitted operations and the 30-day purge.
235: create index meeting_note_ai_operations_admitted_at_idx
236:   on public.meeting_note_ai_operations (admitted_at);
237: 
238: alter table public.meeting_note_ai_operations enable row level security;
239: 
240: -- Baseline default privileges grant ALL on new public tables to anon,
241: -- authenticated, and service_role; reset, then let service_role read only.
242: revoke all on table public.meeting_note_ai_operations from public, anon, authenticated, service_role;
243: grant select on table public.meeting_note_ai_operations to service_role;
