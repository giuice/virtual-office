67: /** Header names whose value is a credential: only presence + last 4 characters are recorded. */
68: const CREDENTIAL_HEADER = 
/^(authorization|proxy-authorization|x-api-key|api-key|cookie|x-goog-api-key)$|token|secret|api-key/i;
69: const CREDENTIAL_PRIORITY = ['x-api-key', 'authorization', 'api-key'];
70: const MAX_BODY_BYTES = 50 * 1024 * 1024;
71: const DEFAULT_MALFORMED_TEXT = '{"summary": {"keyPoints": ["The team agreed to ship on Friday"], "decisions": [';
72: 
73: class ControlError extends Error {}
74: 
75: function providerRecord<T>(make: () => T): Record<FakeAiProvider, T> {
76:   return { anthropic: make(), openai: make(), kimi: make(), glm: make() };
77: }
78: 
79: function isProvider(value: unknown): value is FakeAiProvider {
80:   return typeof value === 'string' && (FAKE_AI_PROVIDERS as readonly string[]).includes(value);
81: }
82: 
83: function assertOutcome(value: unknown, label: string): FakeAiOutcome {
84:   const kind = (value as { kind?: unknown } | null)?.kind;
85:   if (typeof value !== 'object' || value === null || typeof kind !== 'string' || !OUTCOME_KINDS.has(kind)) {
86:     throw new ControlError(`${label}: not a fake AI outcome (kind must be one of ${[...OUTCOME_KINDS].join(', 
')})`);
87:   }
88:   const outcome = value as FakeAiOutcome;
89:   if ((outcome.kind === 'rejection' || outcome.kind === 'status') && !Number.isInteger(outcome.status)) {
90:     throw new ControlError(`${label}: '${outcome.kind}' needs an integer status`);
91:   }
92:   if (outcome.kind === 'pause' && outcome.then !== undefined) assertOutcome(outcome.then, `${label}.then`);
93:   return outcome;
94: }
95: 
96: function redactCredential(value: string): { redacted: string; last4: string } {
97:   const secret = value.trim().replace(/^(bearer|basic)\s+/i, '');
98:   // Never store a whole secret: short values keep no characters at all.
99:   const last4 = secret.length > 8 ? secret.slice(-4) : '';
100:   return { redacted: `[redacted …${last4}]`, last4 };
101: }
102: 
103: function recordHeaders(req: IncomingMessage): Pick<FakeAiRecordedRequest, 'headers' | 'credential'> {
104:   const headers: Record<string, string> = {};
105:   const credentials = new Map<string, string>();
106:   for (const [name, raw] of Object.entries(req.headers)) {
107:     if (raw === undefined) continue;
108:     const value = Array.isArray(raw) ? raw.join(', ') : raw;
109:     if (CREDENTIAL_HEADER.test(name)) {
110:       const { redacted, last4 } = redactCredential(value);
111:       headers[name] = redacted;
112:       credentials.set(name, last4);
113:     } else {
114:       headers[name] = value;
115:     }
116:   }
117:   const header = CREDENTIAL_PRIORITY.find((name) => credentials.has(name));
118:   return { headers, credential: header ? { header, last4: credentials.get(header) ?? '' } : null };
119: }
120: 
121: function readBody(req: IncomingMessage): Promise<Buffer> {
122:   return new Promise((resolve, reject) => {
123:     const chunks: Buffer[] = [];
124:     let size = 0;
125:     req.on('data', (chunk: Buffer) => {
126:       size += chunk.length;
127:       if (size > MAX_BODY_BYTES) {
128:         reject(new Error('body too large'));
129:         req.destroy();
130:         return;
131:       }
132:       chunks.push(chunk);
133:     });
134:     req.on('end', () => resolve(Buffer.concat(chunks)));
135:     req.on('error', reject);
136:   });
137: }
