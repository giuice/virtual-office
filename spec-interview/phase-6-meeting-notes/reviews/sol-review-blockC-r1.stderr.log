61:       if (JSON.stringify(recorded).includes(key)) fail(provider, 'the full credential was stored');
62:       lines.push(`${provider}: POST ${recorded.path} → 200 draft ok; recorded #${recorded.seq} 
(${recorded.credential.header} …${recorded.credential.last4})`);
