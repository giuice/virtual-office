145: function providerForPath(path: string): FakeAiProvider | null {
146:   return FAKE_AI_PROVIDERS.find((provider) => FAKE_AI_PROVIDER_PATHS[provider] === path) ?? null;
147: }
148: 
149: function providerForPrefix(path: string): FakeAiProvider | null {
150:   return FAKE_AI_PROVIDERS.find((provider) => path.startsWith(`/${provider}/`)) ?? null;
151: }
