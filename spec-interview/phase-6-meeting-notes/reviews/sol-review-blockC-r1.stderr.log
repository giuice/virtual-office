src/lib/meeting-notes/ai/base-url.ts
1: // src/lib/meeting-notes/ai/base-url.ts
2: // Provider base URL for the meeting-note adapters (Phase 6 T11). The real URL
3: // comes from the capability matrix. A server-only environment variable,
4: // MEETING_NOTES_AI_BASE_URL_OVERRIDE, points every provider at the local fake
5: // AI server in tests (T16):
6: //   `${override}/${provider}${new URL(capability.baseUrl).pathname}`
7: // It is read from the server's environment only — no request input can set
8: // it — and it is IGNORED when NODE_ENV is "production", with one refusal line
9: // logged per resolution (the variable's value is never logged). An override
10: // that is not a plain http(s) origin/path fails closed instead of falling back
11: // to the real provider.
12: import 'server-only';
13: 
14: import type { MeetingNoteAiProvider } from '@/types/meeting-notes';
15: 
16: import { MEETING_NOTE_AI_CAPABILITIES } from './capabilities';
17: 
18: export const MEETING_NOTES_AI_BASE_URL_OVERRIDE_ENV = 'MEETING_NOTES_AI_BASE_URL_OVERRIDE';
19: 
20: export type MeetingNoteAiBaseUrlResolution =
21:   | { ok: true; baseUrl: string; overridden: boolean }
22:   | { ok: false; code: 'MEETING_NOTE_AI_CONFIGURATION_INVALID' };
23: 
24: function withoutTrailingSlash(value: string): string {
25:   return value.replace(/\/+$/, '');
26: }
27: 
28: export function resolveMeetingNoteAiBaseUrl(provider: MeetingNoteAiProvider): MeetingNoteAiBaseUrlResolution {
29:   const realBaseUrl = withoutTrailingSlash(MEETING_NOTE_AI_CAPABILITIES[provider].baseUrl);
30:   const override = process.env[MEETING_NOTES_AI_BASE_URL_OVERRIDE_ENV]?.trim();
31:   if (!override) return { ok: true, baseUrl: realBaseUrl, overridden: false };
32: 
33:   if (process.env.NODE_ENV === 'production') {
34:     console.warn(
35:       `[meeting-notes ai] ${MEETING_NOTES_AI_BASE_URL_OVERRIDE_ENV} is set but refused in production; using the 
provider's real API URL.`
36:     );
37:     return { ok: true, baseUrl: realBaseUrl, overridden: false };
38:   }
39: 
40:   let parsed: URL;
41:   try {
42:     parsed = new URL(override);
43:   } catch {
44:     return { ok: false, code: 'MEETING_NOTE_AI_CONFIGURATION_INVALID' };
45:   }
46:   if (
47:     (parsed.protocol !== 'http:' && parsed.protocol !== 'https:') ||
48:     parsed.username ||
49:     parsed.password ||
50:     parsed.search ||
51:     parsed.hash
52:   ) {
53:     return { ok: false, code: 'MEETING_NOTE_AI_CONFIGURATION_INVALID' };
54:   }
55:   const realPath = withoutTrailingSlash(new URL(realBaseUrl).pathname);
56:   return {
57:     ok: true,
58:     baseUrl: `${withoutTrailingSlash(parsed.origin + parsed.pathname)}/${provider}${realPath}`,
59:     overridden: true,
60:   };
61: }
src/lib/meeting-notes/ai/preflight.ts
1: // src/lib/meeting-notes/ai/preflight.ts
2: // Input-size preflight (Phase 6 T11; SPEC FR-020, AC-026): before any request
3: // leaves the server, the normalized transcript plus the fixed request text
4: // (system prompt and draft JSON schema) is estimated in tokens and compared
5: // with the configured model's budget from the capability matrix. A transcript
6: // that does not fit is refused — nothing is sent, nothing is counted.
7: //
8: // Estimate (deliberately conservative, no tokenizer dependency):
9: //   ceil(ASCII UTF-16 units / 2) + 2 × non-ASCII UTF-16 units + overhead.
10: // Real tokenizers average ~3–4 ASCII characters per token for prose, and one
11: // to two tokens per CJK/accented character; 2 characters per token and 2
12: // tokens per non-ASCII unit (an astral character counts as two units) stay at
13: // or above those rates, so the estimate over-counts rather than letting an
14: // oversize request through. Budget: input estimate + the output budget the
15: // adapter requests (the model's maxOutputTokens) must not exceed the model's
16: // contextWindowTokens. For OpenAI models, contextWindowTokens already holds the
17: // documented input cap, so the check is stricter than the provider's own.
18: import 'server-only';
19: 
20: import type { MeetingNoteAiProvider } from '@/types/meeting-notes';
21: 
22: import { findMeetingNoteAiModel, MEETING_NOTE_AI_CAPABILITIES } from './capabilities';
23: import { MEETING_NOTE_AI_DRAFT_JSON_SCHEMA } from './draft-schema';
24: import { MEETING_NOTE_AI_SYSTEM_PROMPT } from './prompt';
25: 
26: /** Role framing, message wrappers, and request parameters the estimate does not see as text. */
27: const REQUEST_OVERHEAD_TOKENS = 512;
28: 
29: export function estimateMeetingNoteAiTokens(text: string): number {
30:   let ascii = 0;
31:   let other = 0;
32:   for (let i = 0; i < text.length; i += 1) {
33:     if (text.charCodeAt(i) < 0x80) ascii += 1;
34:     else other += 1;
35:   }
36:   return Math.ceil(ascii / 2) + other * 2;
37: }
38: 
39: const FIXED_REQUEST_TOKENS =
40:   estimateMeetingNoteAiTokens(MEETING_NOTE_AI_SYSTEM_PROMPT) +
41:   estimateMeetingNoteAiTokens(JSON.stringify(MEETING_NOTE_AI_DRAFT_JSON_SCHEMA)) +
42:   REQUEST_OVERHEAD_TOKENS;
43: 
44: export type MeetingNoteAiPreflightResult =
45:   | {
46:       ok: true;
47:       estimatedInputTokens: number;
48:       /** Output budget the adapter will request (the model's maxOutputTokens). */
49:       outputBudgetTokens: number;
50:       /** Largest input estimate the model accepts with that output budget. */
51:       maxInputTokens: number;
52:     }
53:   | {
54:       ok: false;
55:       code: 'MEETING_NOTE_AI_TRANSCRIPT_TOO_LONG_FOR_MODEL';
56:       estimatedInputTokens: number;
57:       outputBudgetTokens: number;
58:       maxInputTokens: number;
59:       modelLabel: string;
60:     }
61:   | { ok: false; code: 'MEETING_NOTE_AI_CONFIGURATION_INVALID' };
62: 
63: /** FR-020: whether the normalized transcript fits the configured model. Pure; sends nothing. */
64: export function preflightMeetingNoteAiTranscript(input: {
65:   provider: MeetingNoteAiProvider;
66:   model: string;
67:   transcript: string;
68: }): MeetingNoteAiPreflightResult {
69:   if (!Object.hasOwn(MEETING_NOTE_AI_CAPABILITIES, input.provider)) {
70:     return { ok: false, code: 'MEETING_NOTE_AI_CONFIGURATION_INVALID' };
71:   }
72:   const model = findMeetingNoteAiModel(input.provider, input.model);
73:   if (!model) return { ok: false, code: 'MEETING_NOTE_AI_CONFIGURATION_INVALID' };
74: 
75:   const estimatedInputTokens = FIXED_REQUEST_TOKENS + estimateMeetingNoteAiTokens(input.transcript);
76:   const outputBudgetTokens = model.maxOutputTokens;
77:   const maxInputTokens = Math.max(0, model.contextWindowTokens - outputBudgetTokens);
78:   if (estimatedInputTokens > maxInputTokens) {
79:     return {
80:       ok: false,
81:       code: 'MEETING_NOTE_AI_TRANSCRIPT_TOO_LONG_FOR_MODEL',
82:       estimatedInputTokens,
83:       outputBudgetTokens,
84:       maxInputTokens,
85:       modelLabel: model.label,
86:     };
87:   }
88:   return { ok: true, estimatedInputTokens, outputBudgetTokens, maxInputTokens };
89: }
src/lib/meeting-notes/ai/provider-errors.ts
1: // src/lib/meeting-notes/ai/provider-errors.ts
2: // Outcome codes, sanitized messages, and counting classes of a meeting-note
3: // draft request (Phase 6 T11; SPEC FR-020, FR-021, FR-022, §11).
4: //
5: // Counting classes (`kind`) for T12's settlement:
6: //   never_sent             — the provider cannot have received the transcript:
7: //                            preflight refusal, invalid configuration, abort
8: //                            before the request was handed to the network, or a
9: //                            connection that was refused / a host that did not
10: //                            resolve (no request byte can have left). Not counted.
11: //   preprocessing_rejected — the provider's INITIAL response was a non-2xx
12: //                            rejection whose status + type/code is listed in the
13: //                            capability matrix (classifyMeetingNoteAiPreProcessingRejection).
14: //                            Refunded.
15: //   processed_failure      — everything else after the request was sent:
16: //                            unlisted statuses/codes, non-envelope bodies, errors
17: //                            after the stream began, connection loss, timeout,
18: //                            cancellation after send, refusal, malformed /
19: //                            truncated / empty / invalid output. Counted.
20: // Messages are fixed per code: they never contain the API key, an
21: // Authorization header, the transcript, or provider text (which can echo input).
22: import 'server-only';
23: 
24: import type { MeetingNoteAiDraft, MeetingNoteAiProvider } from '@/types/meeting-notes';
25: 
26: import { MEETING_NOTE_AI_CAPABILITIES, type MeetingNoteAiRejectionCategory } from './capabilities';
27: 
28: export type MeetingNoteAiFailureKind = 'never_sent' | 'preprocessing_rejected' | 'processed_failure';
29: 
30: export type MeetingNoteAiFailureCode =
31:   // never_sent
32:   | 'MEETING_NOTE_AI_TRANSCRIPT_TOO_LONG_FOR_MODEL'
33:   | 'MEETING_NOTE_AI_CONFIGURATION_INVALID'
34:   | 'MEETING_NOTE_AI_CANCELLED_BEFORE_SEND'
35:   | 'MEETING_NOTE_AI_PROVIDER_UNREACHABLE'
36:   // preprocessing_rejected (by matrix category)
37:   | 'MEETING_NOTE_AI_PROVIDER_AUTH_FAILED'
38:   | 'MEETING_NOTE_AI_PROVIDER_RATE_LIMITED'
39:   | 'MEETING_NOTE_AI_PROVIDER_OVERLOADED'
40:   | 'MEETING_NOTE_AI_PROVIDER_UNAVAILABLE'
41:   // processed_failure
42:   | 'MEETING_NOTE_AI_PROVIDER_ERROR'
43:   | 'MEETING_NOTE_AI_STREAM_INTERRUPTED'
44:   | 'MEETING_NOTE_AI_CONNECTION_LOST'
45:   | 'MEETING_NOTE_AI_TIMEOUT'
46:   | 'MEETING_NOTE_AI_CANCELLED'
47:   | 'MEETING_NOTE_AI_REFUSED'
48:   | 'MEETING_NOTE_AI_OUTPUT_TRUNCATED'
49:   | 'MEETING_NOTE_AI_OUTPUT_MALFORMED'
50:   | 'MEETING_NOTE_AI_OUTPUT_INVALID'
51:   | 'MEETING_NOTE_AI_OUTPUT_EMPTY';
52: 
53: export interface MeetingNoteAiUsageReport {
54:   inputTokens?: number;
55:   outputTokens?: number;
56: }
57: 
58: export interface MeetingNoteAiDraftSuccess {
59:   ok: true;
60:   draft: MeetingNoteAiDraft;
61:   usage?: MeetingNoteAiUsageReport;
62:   /** Always true: a draft needs exactly one outbound request. */
63:   dispatched: true;
64: }
65: 
66: export interface MeetingNoteAiDraftFailure {
67:   ok: false;
68:   kind: MeetingNoteAiFailureKind;
69:   code: MeetingNoteAiFailureCode;
70:   /** Sanitized, user-presentable text (no key, transcript, or provider text). */
71:   message: string;
72:   /** Whether "Try again" can reasonably succeed without a settings change. */
73:   retryable: boolean;
74:   /**
75:    * Whether the outbound HTTP request was handed to the network (fetch was
76:    * called). False for preflight/config refusals and aborts before send; true
77:    * for everything the provider may have seen — and for a refused connection,
78:    * which is `never_sent` although fetch was attempted.
79:    */
80:   dispatched: boolean;
81:   /** Matrix category of a listed pre-processing rejection. */
82:   rejectionCategory?: MeetingNoteAiRejectionCategory;
83:   /** HTTP status of the provider's initial non-2xx response (no body is kept). */
84:   providerStatus?: number;
85:   /** FR-020 refusal details (the message names the limit). */
86:   estimatedInputTokens?: number;
87:   maxInputTokens?: number;
88: }
89: 
90: export type MeetingNoteAiDraftResult = MeetingNoteAiDraftSuccess | MeetingNoteAiDraftFailure;
91: 
92: function providerLabel(provider: MeetingNoteAiProvider): string {
93:   return MEETING_NOTE_AI_CAPABILITIES[provider].label;
94: }
95: 
96: const NOT_RETRYABLE: ReadonlySet<MeetingNoteAiFailureCode> = new Set<MeetingNoteAiFailureCode>([
97:   'MEETING_NOTE_AI_TRANSCRIPT_TOO_LONG_FOR_MODEL',
98:   'MEETING_NOTE_AI_CONFIGURATION_INVALID',
99:   'MEETING_NOTE_AI_PROVIDER_AUTH_FAILED',
100:   'MEETING_NOTE_AI_REFUSED',
101: ]);
102: 
103: const KIND_BY_CODE: Readonly<Record<MeetingNoteAiFailureCode, MeetingNoteAiFailureKind>> = {
104:   MEETING_NOTE_AI_TRANSCRIPT_TOO_LONG_FOR_MODEL: 'never_sent',
105:   MEETING_NOTE_AI_CONFIGURATION_INVALID: 'never_sent',
106:   MEETING_NOTE_AI_CANCELLED_BEFORE_SEND: 'never_sent',
107:   MEETING_NOTE_AI_PROVIDER_UNREACHABLE: 'never_sent',
108:   MEETING_NOTE_AI_PROVIDER_AUTH_FAILED: 'preprocessing_rejected',
109:   MEETING_NOTE_AI_PROVIDER_RATE_LIMITED: 'preprocessing_rejected',
110:   MEETING_NOTE_AI_PROVIDER_OVERLOADED: 'preprocessing_rejected',
111:   MEETING_NOTE_AI_PROVIDER_UNAVAILABLE: 'preprocessing_rejected',
112:   MEETING_NOTE_AI_PROVIDER_ERROR: 'processed_failure',
113:   MEETING_NOTE_AI_STREAM_INTERRUPTED: 'processed_failure',
114:   MEETING_NOTE_AI_CONNECTION_LOST: 'processed_failure',
115:   MEETING_NOTE_AI_TIMEOUT: 'processed_failure',
116:   MEETING_NOTE_AI_CANCELLED: 'processed_failure',
117:   MEETING_NOTE_AI_REFUSED: 'processed_failure',
118:   MEETING_NOTE_AI_OUTPUT_TRUNCATED: 'processed_failure',
119:   MEETING_NOTE_AI_OUTPUT_MALFORMED: 'processed_failure',
120:   MEETING_NOTE_AI_OUTPUT_INVALID: 'processed_failure',
121:   MEETING_NOTE_AI_OUTPUT_EMPTY: 'processed_failure',
122: };
123: 
124: function messageFor(code: MeetingNoteAiFailureCode, provider: MeetingNoteAiProvider): string {
125:   const label = providerLabel(provider);
126:   switch (code) {
127:     case 'MEETING_NOTE_AI_TRANSCRIPT_TOO_LONG_FOR_MODEL':
128:       return 'The transcript is too long for the configured AI model.';
129:     case 'MEETING_NOTE_AI_CONFIGURATION_INVALID':
130:       return 'The AI settings are not valid. Ask an admin to review them.';
131:     case 'MEETING_NOTE_AI_CANCELLED_BEFORE_SEND':
132:       return 'Processing was cancelled before the transcript was sent.';
133:     case 'MEETING_NOTE_AI_PROVIDER_UNREACHABLE':
134:       return `${label} could not be reached. Try again later.`;
135:     case 'MEETING_NOTE_AI_PROVIDER_AUTH_FAILED':
136:       return `${label} rejected the API key or its permissions. Ask an admin to check the AI settings.`;
137:     case 'MEETING_NOTE_AI_PROVIDER_RATE_LIMITED':
138:       return `${label} refused the request because of a rate or usage limit on the company's account. Try again 
later.`;
139:     case 'MEETING_NOTE_AI_PROVIDER_OVERLOADED':
140:       return `${label} is overloaded right now. Try again in a few minutes.`;
141:     case 'MEETING_NOTE_AI_PROVIDER_UNAVAILABLE':
142:       return `${label} is unavailable right now. Try again later.`;
143:     case 'MEETING_NOTE_AI_PROVIDER_ERROR':
144:       return `${label} returned an error while processing the transcript.`;
145:     case 'MEETING_NOTE_AI_STREAM_INTERRUPTED':
146:       return `${label} stopped with an error while writing the draft.`;
147:     case 'MEETING_NOTE_AI_CONNECTION_LOST':
148:       return `The connection to ${label} was lost before the draft arrived.`;
149:     case 'MEETING_NOTE_AI_TIMEOUT':
150:       return `${label} did not finish the draft in time.`;
151:     case 'MEETING_NOTE_AI_CANCELLED':
152:       return 'Processing was cancelled after the transcript was sent.';
153:     case 'MEETING_NOTE_AI_REFUSED':
154:       return `${label} declined to process this transcript.`;
155:     case 'MEETING_NOTE_AI_OUTPUT_TRUNCATED':
156:       return `${label} stopped before the draft was complete.`;
157:     case 'MEETING_NOTE_AI_OUTPUT_MALFORMED':
158:       return `${label} returned a draft that could not be read.`;
159:     case 'MEETING_NOTE_AI_OUTPUT_INVALID':
160:       return `${label} returned a draft in an unexpected format.`;
161:     case 'MEETING_NOTE_AI_OUTPUT_EMPTY':
162:       return `${label} returned an empty draft.`;
163:   }
164: }
165: 
166: export function meetingNoteAiFailure(
167:   provider: MeetingNoteAiProvider,
168:   code: MeetingNoteAiFailureCode,
169:   dispatched: boolean,
170:   extra: Pick<
171:     MeetingNoteAiDraftFailure,
172:     'rejectionCategory' | 'providerStatus' | 'estimatedInputTokens' | 'maxInputTokens'
173:   > = {}
174: ): MeetingNoteAiDraftFailure {
175:   return {
176:     ok: false,
177:     kind: KIND_BY_CODE[code],
178:     code,
179:     message: messageFor(code, provider),
180:     retryable: !NOT_RETRYABLE.has(code),
181:     dispatched,
182:     ...extra,
183:   };
184: }
185: 
186: /** FR-020 refusal; the message names the limit and the two ways out. */
187: export function meetingNoteAiTooLongFailure(
188:   provider: MeetingNoteAiProvider,
189:   details: { estimatedInputTokens: number; maxInputTokens: number; modelLabel: string }
190: ): MeetingNoteAiDraftFailure {
191:   const failure = meetingNoteAiFailure(provider, 'MEETING_NOTE_AI_TRANSCRIPT_TOO_LONG_FOR_MODEL', false, {
192:     estimatedInputTokens: details.estimatedInputTokens,
193:     maxInputTokens: details.maxInputTokens,
194:   });
195:   const fmt = (n: number) => n.toLocaleString('en-US');
196:   return {
197:     ...failure,
198:     message:
199:       `The transcript is too long for ${details.modelLabel}: about ${fmt(details.estimatedInputTokens)} tokens, ` 
+
200:       `limit ${fmt(details.maxInputTokens)}. Use a smaller file or ask an admin to choose a model with a larger 
context.`,
201:   };
202: }
203: 
204: const CODE_BY_CATEGORY: Readonly<Record<MeetingNoteAiRejectionCategory, MeetingNoteAiFailureCode>> = {
205:   authentication: 'MEETING_NOTE_AI_PROVIDER_AUTH_FAILED',
206:   permission: 'MEETING_NOTE_AI_PROVIDER_AUTH_FAILED',
207:   rate_limit: 'MEETING_NOTE_AI_PROVIDER_RATE_LIMITED',
208:   overloaded: 'MEETING_NOTE_AI_PROVIDER_OVERLOADED',
209:   unavailable: 'MEETING_NOTE_AI_PROVIDER_UNAVAILABLE',
210: };
211: 
212: export function meetingNoteAiRejectionFailure(
213:   provider: MeetingNoteAiProvider,
214:   category: MeetingNoteAiRejectionCategory,
215:   status: number
216: ): MeetingNoteAiDraftFailure {
217:   return meetingNoteAiFailure(provider, CODE_BY_CATEGORY[category], true, {
218:     rejectionCategory: category,
219:     providerStatus: status,
220:   });
221: }
src/lib/meeting-notes/ai/draft-schema.ts
1: // src/lib/meeting-notes/ai/draft-schema.ts
2: // The ONE draft schema every provider adapter validates against (Phase 6 T11;
3: // SPEC FR-016, FR-017, FR-021). Two views of the same shape:
4: //   * MEETING_NOTE_AI_DRAFT_JSON_SCHEMA — sent to providers that take a JSON
5: //     schema (Anthropic `output_config.format`, OpenAI/Kimi `response_format`
6: //     json_schema strict). It deliberately carries no length/count keywords:
7: //     Anthropic structured outputs reject numeric/string/array constraints,
8: //     so the limits live in the zod schema and the prompt.
9: //   * meetingNoteAiDraftSchema — zod validation of the model's text after
10: //     JSON.parse, for every provider (GLM only has json_object mode, so this is
11: //     its only structural check).
12: // Output that is not JSON, does not match, exceeds a limit (e.g. more than 100
13: // action items — the SPEC caps drafts at 100 and is silent on truncation, so
14: // it is a failure), or is empty is an unusable draft (counted, FR-021/FR-022).
15: import 'server-only';
16: 
17: import { z } from 'zod';
18: 
19: import type { MeetingNoteAiDraft } from '@/types/meeting-notes';
20: 
21: export const MEETING_NOTE_AI_DRAFT_MAX_ITEMS = 100;
22: export const MEETING_NOTE_AI_DRAFT_MAX_DESCRIPTION = 1_000;
23: export const MEETING_NOTE_AI_DRAFT_MAX_ASSIGNEE_NAME = 200;
24: /** Per summary section. */
25: export const MEETING_NOTE_AI_DRAFT_MAX_SUMMARY_ENTRIES = 100;
26: export const MEETING_NOTE_AI_DRAFT_MAX_SUMMARY_ENTRY = 2_000;
27: 
28: const STRING_OR_NULL = { anyOf: [{ type: 'string' }, { type: 'null' }] } as const;
29: 
30: /** JSON Schema of the draft (every object closed, every property required). */
31: export const MEETING_NOTE_AI_DRAFT_JSON_SCHEMA: Readonly<Record<string, unknown>> = {
32:   type: 'object',
33:   properties: {
34:     summary: {
35:       type: 'object',
36:       properties: {
37:         keyPoints: { type: 'array', items: { type: 'string' } },
38:         decisions: { type: 'array', items: { type: 'string' } },
39:         nextSteps: { type: 'array', items: { type: 'string' } },
40:       },
41:       required: ['keyPoints', 'decisions', 'nextSteps'],
42:       additionalProperties: false,
43:     },
44:     actionItems: {
45:       type: 'array',
46:       items: {
47:         type: 'object',
48:         properties: {
49:           description: { type: 'string' },
50:           assigneeName: STRING_OR_NULL,
51:         },
52:         required: ['description', 'assigneeName'],
53:         additionalProperties: false,
54:       },
55:     },
56:   },
57:   required: ['summary', 'actionItems'],
58:   additionalProperties: false,
59: };
60: 
61: /** Name used for the OpenAI-compatible `response_format.json_schema.name`. */
62: export const MEETING_NOTE_AI_DRAFT_SCHEMA_NAME = 'meeting_note_draft';
63: 
64: const summarySection = z
65:   .array(z.string().trim().max(MEETING_NOTE_AI_DRAFT_MAX_SUMMARY_ENTRY))
66:   .max(MEETING_NOTE_AI_DRAFT_MAX_SUMMARY_ENTRIES)
67:   // Blank bullets carry nothing; drop them rather than failing the draft.
68:   .transform((entries) => entries.filter((entry) => entry.length > 0));
69: 
70: const actionItem = z
71:   .object({
72:     description: z.string().trim().min(1).max(MEETING_NOTE_AI_DRAFT_MAX_DESCRIPTION),
73:     assigneeName: z
74:       .string()
75:       .trim()
76:       .max(MEETING_NOTE_AI_DRAFT_MAX_ASSIGNEE_NAME)
77:       .nullable()
78:       .transform((name) => (name ? name : null)),
79:   })
80:   .strict();
81: 
82: export const meetingNoteAiDraftSchema = z
83:   .object({
84:     summary: z
85:       .object({ keyPoints: summarySection, decisions: summarySection, nextSteps: summarySection })
86:       .strict(),
87:     actionItems: z.array(actionItem).max(MEETING_NOTE_AI_DRAFT_MAX_ITEMS),
88:   })
89:   .strict();
90: 
91: export type MeetingNoteAiDraftParseResult =
92:   | { ok: true; draft: MeetingNoteAiDraft }
93:   | { ok: false; reason: 'empty' | 'malformed' | 'invalid' };
94: 
95: /**
96:  * Parses and validates the model's complete text output. Only the reason is
97:  * returned — never the text or zod's issue messages, which can echo input.
98:  */
99: export function parseMeetingNoteAiDraft(text: string): MeetingNoteAiDraftParseResult {
100:   if (text.trim().length === 0) return { ok: false, reason: 'empty' };
101:   let json: unknown;
102:   try {
103:     json = JSON.parse(text);
104:   } catch {
105:     return { ok: false, reason: 'malformed' };
106:   }
107:   const parsed = meetingNoteAiDraftSchema.safeParse(json);
108:   if (!parsed.success) return { ok: false, reason: 'invalid' };
109:   const { summary, actionItems } = parsed.data;
110:   const hasContent =
111:     summary.keyPoints.length + summary.decisions.length + summary.nextSteps.length + actionItems.length > 0;
112:   if (!hasContent) return { ok: false, reason: 'empty' };
113:   return { ok: true, draft: { summary, actionItems } };
114: }
