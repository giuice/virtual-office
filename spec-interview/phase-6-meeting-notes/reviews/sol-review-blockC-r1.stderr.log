2: // Curated AI capability matrix for meeting-note processing (Phase 6 T8;
3: // SPEC FR-016, FR-020, FR-022, FR-024). DATA ONLY: no provider call, no SDK.
4: // T11's adapters consume it; the settings route validates admin choices
5: // against it; the model/reasoning lists (never keys) are exposed to the admin
6: // form through GET /api/companies/ai-settings.
7: //
8: // Sources (official documentation, read 2026-10-13):
9: //   Anthropic models   https://platform.claude.com/docs/en/about-claude/models/overview.md
10: //   Anthropic effort   https://platform.claude.com/docs/en/build-with-claude/effort.md
11: //   Anthropic errors   https://platform.claude.com/docs/en/api/errors.md
12: //   Anthropic stream   https://platform.claude.com/docs/en/build-with-claude/streaming.md
13: //   OpenAI models      https://developers.openai.com/api/docs/models (+ /models/<id>)
14: //   OpenAI reasoning   https://developers.openai.com/api/docs/guides/reasoning
15: //   OpenAI chat        
https://developers.openai.com/api/reference/python/resources/chat/subresources/completions/methods/create
16: //   OpenAI errors      https://developers.openai.com/api/docs/guides/error-codes
17: //   Kimi API overview  https://platform.kimi.ai/docs/api/overview.md
18: //   Kimi models        https://platform.kimi.ai/docs/models , https://platform.kimi.ai/docs/api/models-overview
19: //   Kimi chat          https://platform.kimi.ai/docs/api/chat
20: //   Kimi errors        https://platform.kimi.ai/docs/api/errors.md
21: //   GLM quick start    https://docs.z.ai/guides/overview/quick-start.md
22: //   GLM models         https://docs.z.ai/guides/overview/overview.md
23: //   GLM chat           https://docs.z.ai/api-reference/llm/chat-completion.md
24: //   GLM errors         https://docs.z.ai/api-reference/api-code.md
25: //
26: // Pre-processing rejections (FR-022): a dispatch is refunded only when the
27: // provider's INITIAL HTTP response is a non-2xx rejection with the provider's
28: // normal error body whose status AND documented type/code are listed below for
29: // that provider, in one of the SPEC's categories (authentication/permission,
30: // rate limit, overload, unavailable). None of the providers documents billing
31: // for error responses; the list holds only the documented status + type/code
32: // combinations of those categories. Every entry names an exact `error.type`,
33: // an exact `error.code`, or both; there is no wildcard. A status the
34: // documentation lists WITHOUT a type or code (e.g. OpenAI's 401/403 and its
35: // plain "Rate limit reached" 429) cannot be told apart from an unknown error
36: // and stays counted. Everything else stays counted too: other statuses (400,
37: // 402, 404, 413, 500, 504, ...), unlisted types/codes, a body that is not the
38: // provider's normal error envelope, errors inside an accepted (2xx/streaming)
39: // response (e.g. Anthropic's mid-stream `overloaded_error` event), and
40: // connection loss. classifyMeetingNoteAiPreProcessingRejection applies this.
41: import 'server-only';
42: 
43: import type {
44:   MeetingNoteAiModelOption,
45:   MeetingNoteAiProvider,
46:   MeetingNoteAiProviderOption,
47: } from '@/types/meeting-notes';
48: 
49: /** Wire protocol an adapter speaks (Kimi and GLM are OpenAI-compatible). */
50: export type MeetingNoteAiWireProtocol = 'anthropic-messages' | 'openai-chat-completions';
51: 
52: export type MeetingNoteAiRejectionCategory = 'authentication' | 'permission' | 'rate_limit' | 'overloaded' | 
'unavailable';
53: 
54: /**
55:  * What the provider's error body must carry, exactly as documented:
56:  * `type`: `error.type` equals; `code`: `error.code` equals, whatever the type
57:  * (used where the documentation names only the code, e.g. OpenAI billing
58:  * errors whose type may vary, and GLM business codes); `type+code`: both equal.
59:  */
60: export type MeetingNoteAiRejectionMatch =
61:   | { by: 'type'; errorType: string }
62:   | { by: 'code'; errorCode: string }
63:   | { by: 'type+code'; errorType: string; errorCode: string };
