149: async function runScripted(provider: MeetingNoteAiProvider, outcome: FakeAiOutcome): 
Promise<MeetingNoteAiDraftResult> {
150:   await control.script(provider, outcome);
151:   return generate(provider);
152: }
153: 
154: function expectFailure(
155:   result: MeetingNoteAiDraftResult,
156:   kind: 'never_sent' | 'preprocessing_rejected' | 'processed_failure',
157:   code: string | null,
158:   dispatched: boolean
159: ): void {
160:   expect(result.ok).toBe(false);
161:   if (result.ok) return;
162:   expect({ kind: result.kind, dispatched: result.dispatched }).toEqual({ kind, dispatched });
163:   if (code !== null) expect(result.code).toBe(code);
164:   expect(result.message.length).toBeGreaterThan(0);
165: }
166: 
167: function expectNoSecretOrTranscript(provider: MeetingNoteAiProvider, result: MeetingNoteAiDraftResult): void {
168:   const serialized = JSON.stringify(result);
169:   expect(serialized).not.toContain(CANARY_KEYS[provider]);
170:   expect(serialized).not.toContain('Bom dia a todos');
171:   expect(serialized).not.toContain('Fake ');
172: }
173: 
174: function rejectionOutcome(rejection: MeetingNoteAiRejection): FakeAiOutcome {
175:   const { match } = rejection;
176:   return {
177:     kind: 'rejection',
178:     status: rejection.status,
179:     ...(match.by === 'type' || match.by === 'type+code' ? { errorType: match.errorType } : {}),
180:     ...(match.by === 'code' || match.by === 'type+code' ? { errorCode: match.errorCode } : {}),
181:   };
182: }
