49: export async function POST(request: Request) {
50:   const correlationId = createCorrelationId();
51:   let refreshed = false;
52: 
53:   try {
54:     // Get Supabase client using the server helper
55:     const supabase = await createSupabaseServerClient(undefined, {
56:       onAuthCookiesSet: () => {
57:         refreshed = true;
58:       },
59:     });
60: 
61:     // First verify the user is authenticated
62:     let authResult: Awaited<ReturnType<typeof supabase.auth.getUser>>;
63:     try {
64:       authResult = await supabase.auth.getUser();
65:     } catch (authValidationError) {
66:       recordAuthValidation({
67:         correlationId,
68:         boundary: 'route',
69:         pathname: '/api/users/sync-profile',
70:         authMethod: 'getUser',
71:         authStatus: 'error',
72:         authErrorCode: getAuthErrorCode(authValidationError),
73:         refreshed,
74:       });
75:       throw authValidationError;
76:     }
77:     const { data: { user }, error: authError } = authResult;
78:     recordAuthValidation({
79:       correlationId,
80:       boundary: 'route',
81:       pathname: '/api/users/sync-profile',
82:       authMethod: 'getUser',
83:       authStatus: authError ? 'error' : user ? 'authenticated' : 'unauthenticated',
84:       authErrorCode: getAuthErrorCode(authError),
85:       refreshed,
86:     });
87:     
88:     if (authError || !user) {
89:       const isRateLimited = authError?.status === 429;
90:       return jsonError(
91:         isRateLimited ? 429 : 401,
92:         isRateLimited ? API_ERROR_CODES.RATE_LIMITED : API_ERROR_CODES.UNAUTHORIZED,
93:         isRateLimited ? 'Authentication service rate limit reached' : 'Authentication required',
94:         { correlationId, cause: authError, context: 'users.syncProfile.getUser' }
95:       );
96:     }
97: 
98:     const supabaseAdmin = await createSupabaseServerClient('service_role');
99:     const userRepository: IUserRepository = new SupabaseUserRepository(supabaseAdmin);
100: 
101:     const rawBody: unknown = await request.json();
102:     if (
103:       typeof rawBody === 'object' &&
104:       rawBody !== null &&
105:       'status' in rawBody &&
106:       rawBody.status === 'offline'
107:     ) {
108:       await recordLegacyPresenceRouteCall('users-offline-status');
109:     }
110: 
