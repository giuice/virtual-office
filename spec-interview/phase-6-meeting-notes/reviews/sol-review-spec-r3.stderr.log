692:         where space.id = v_target.current_space_id
693:         for update;
694: 
695:         if not found then
696:             raise exception 'COMPANY_REMOVAL_SPACE_NOT_FOUND'
697:                 using errcode = 'P0001';
698:         end if;
699:     end if;
700: 
701:     perform session.id
702:     from public.user_presence_sessions as session
