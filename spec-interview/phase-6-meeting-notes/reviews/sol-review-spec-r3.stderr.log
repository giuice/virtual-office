17: // Helper function to validate Google avatar URLs
18: function isValidGoogleAvatarUrl(url: string): boolean {
19:   try {
20:     const parsedUrl = new URL(url);
21:     
22:     // Check for Google domains
23:     const googleDomains = ['googleapis.com', 'googleusercontent.com', 'google.com'];
24:     
25:     const hostname = parsedUrl.hostname.toLowerCase();
26:     const isGoogleDomain = googleDomains.some(
27:       domain => hostname === domain || hostname.endsWith(`.${domain}`)
28:     );
29:     
30:     if (!isGoogleDomain) {
31:       return false;
32:     }
33:     
34:     // Check for HTTPS protocol
35:     if (parsedUrl.protocol !== 'https:') {
36:       return false;
37:     }
38:     
39:     return true;
40:   } catch {
41:     return false;
42:   }
43: }
