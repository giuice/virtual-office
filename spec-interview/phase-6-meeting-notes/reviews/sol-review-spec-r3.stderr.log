1: // src/repositories/implementations/supabase/SupabaseMeetingNoteRepository.ts
2: import { IMeetingNoteRepository } from '@/repositories/interfaces/IMeetingNoteRepository';
3: import { MeetingNote } from '@/types/database'; // Removed ActionItem import here
4: import { PaginationOptions, PaginatedResult } from '@/types/common';
5: import type { SupabaseClient } from '@supabase/supabase-js';
6: 
7: // Helper function to map DB snake_case to TS camelCase for MeetingNote
8: // Note: This does NOT include actionItems, as they are in a separate table.
9: function mapToCamelCase(data: any): MeetingNote {
10:   if (!data) return data;
11:   return {
12:     id: data.id,
13:     roomId: data.room_id,
14:     title: data.title,
15:     meetingDate: data.meeting_date,
16:     transcript: data.transcript,
17:     summary: data.summary,
18:     // actionItems: undefined, // Explicitly undefined or omitted
19:     generatedBy: data.generated_by,
20:     editedBy: data.edited_by,
21:     createdAt: data.created_at,
22:     updatedAt: data.updated_at
23:   };
24: }
25: 
26: // Helper function to map an array
27: function mapArrayToCamelCase(dataArray: any[]): MeetingNote[] {
28:   if (!dataArray) return [];
29:   return dataArray.map(item => mapToCamelCase(item));
30: }
31: 
32: 
33: export class SupabaseMeetingNoteRepository implements IMeetingNoteRepository {
34:   private TABLE_NAME = 'meeting_notes'; // Ensure this matches your Supabase table name
35:   private client: SupabaseClient;
36: 
37:   constructor(client: SupabaseClient) {
38:     this.client = client;
39:   }
40: 
41:   async findById(id: string): Promise<MeetingNote | null> {
42:     const { data, error } = await this.client
43:       .from(this.TABLE_NAME)
44:       .select('*') // Select only columns from meeting_notes table
45:       .eq('id', id)
46:       .single();
47: 
48:     if (error && error.code !== 'PGRST116') {
49:       console.error('Error fetching meeting note by ID:', error);
50:       throw error;
51:     }
52:     // Map DB response (snake_case) to MeetingNote type (camelCase)
53:     // Action items must be fetched separately using IMeetingNoteActionItemRepository if needed.
54:     return data ? mapToCamelCase(data) : null;
55:   }
56: 
57:   async findByRoom(roomId: string, options?: PaginationOptions): Promise<PaginatedResult<MeetingNote>> {
58:     const limit = options?.limit ?? 10;
59:     const from = typeof options?.cursor === 'number' ? options.cursor : 0;
60:     const to = from + limit - 1;
61: 
62:     // Query meeting notes for the room, ordered by meeting date descending
63:     const { data, error, count } = await this.client
64:       .from(this.TABLE_NAME)
65:       .select('*', { count: 'exact' })
66:       .eq('room_id', roomId) // Assuming snake_case
67:       .order('meeting_date', { ascending: false }) // Assuming snake_case
68:       .range(from, to);
69: 
70:     if (error) {
71:       console.error('Error fetching meeting notes by room:', error);
72:       throw error;
73:     }
74: 
75:     // Map DB response array
76:     const items = mapArrayToCamelCase(data || []);
77:     const nextCursor = items.length === limit ? to + 1 : null;
78: 
79:     // Action items must be fetched separately for each note if needed.
80: 
81:     return {
82:       items: items,
83:       nextCursor: nextCursor,
84:       hasMore: nextCursor !== null,
85:       totalCount: count ?? undefined,
86:     };
87:   }
88: 
89:   // Note: actionItems are handled by the separate repository
90:   async create(noteData: Omit<MeetingNote, 'id' | 'createdAt' | 'updatedAt' | 'actionItems'>): 
Promise<MeetingNote> {
91:     // Map MeetingNote type (camelCase) to DB schema (snake_case)
92:     const dbData = {
93:         room_id: noteData.roomId,
94:         title: noteData.title,
95:         meeting_date: noteData.meetingDate,
96:         transcript: noteData.transcript,
97:         summary: noteData.summary,
98:         // action_items are NOT stored here
99:         generated_by: noteData.generatedBy,
100:         edited_by: noteData.editedBy,
101:         // createdAt/updatedAt handled by Supabase defaults/triggers
102:     };
103: 
104:     const { data, error } = await this.client
105:       .from(this.TABLE_NAME)
106:       .insert(dbData)
107:       .select()
108:       .single();
109: 
110:     if (error || !data) {
111:       console.error('Error creating meeting note:', error);
112:       throw error || new Error('Failed to create meeting note or retrieve created data.');
113:     }
114:     // Map DB response back to MeetingNote type
115:     // Note: Created action items must be handled separately using the other repository.
116:     return mapToCamelCase(data);
117:   }
118: 
119:   // Note: actionItems updates must be handled by the separate repository
120:   async update(id: string, updates: Partial<Omit<MeetingNote, 'id' | 'createdAt' | 'updatedAt' | 
'actionItems'>>): Promise<MeetingNote | null> {
121:     // Map updates from camelCase to snake_case
122:     const { roomId, meetingDate, generatedBy, editedBy, ...restUpdates } = updates;
123:     const dbUpdates: Record<string, any> = { ...restUpdates }; // title, transcript, summary
124:     if (roomId !== undefined) dbUpdates.room_id = roomId;
125:     if (meetingDate !== undefined) dbUpdates.meeting_date = meetingDate;
126:     // actionItems are NOT updated here
127:     if (generatedBy !== undefined) dbUpdates.generated_by = generatedBy;
128:     if (editedBy !== undefined) dbUpdates.edited_by = editedBy;
129:     // updatedAt handled by Supabase trigger ideally
130: 
131:     const { data, error } = await this.client
132:       .from(this.TABLE_NAME)
133:       .update(dbUpdates)
134:       .eq('id', id)
135:       .select()
136:       .single();
137: 
138:     if (error) {
139:       console.error('Error updating meeting note:', error);
140:       if (error.code === 'PGRST116') return null;
141:       throw error;
142:     }
143:     // Map DB response back to MeetingNote type
144:     // Note: Updated action items must be handled separately.
145:     return data ? mapToCamelCase(data) : null;
146:   }
147: 
148:   async deleteById(id: string): Promise<boolean> {
149:     // Note: Deleting a note should ideally cascade delete related action items
150:     // in the DB schema (ON DELETE CASCADE). If not, they need to be deleted manually
151:     // using the IMeetingNoteActionItemRepository before or after this call.
152:     const { error, count } = await this.client
153:       .from(this.TABLE_NAME)
154:       .delete()
155:       .eq('id', id);
156: 
157:     if (error) {
158:       console.error('Error deleting meeting note:', error);
159:       return false;
160:     }
161:     return (count ?? 0) > 0;
162:   }
163: 
164: }
