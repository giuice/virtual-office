   1: // src/app/api/spaces/[id]/details/route.ts
   2: // Story 3.11: API endpoint for fetching detailed space information
   3: import { NextRequest, NextResponse } from 'next/server';
   4: import { createSupabaseServerClient } from '@/lib/supabase/server-client';
   5: import { SupabaseSpaceRepository } from '@/repositories/implementations/supabase/SupabaseSpaceRepository';
   6: import { requireAuthUser } from '@/lib/auth/session';
   7: import { createCorrelationId, jsonSuccess } from '@/lib/api/server-error';
   8: // For now, return empty activity log (table may not exist yet)
   9: const activityLog: Array<{
  10:   id: string;
  11:   timestamp: string;
  12:   author: string;
  13:   authorId: string;
  14:   summary: string;
  15:   type: string;
  16: }> = [];
  17: 
  18: // Try to fetch latest message for transcript snippet
  19: // Messages are linked to spaces via conversations.room_id
  20: export const dynamic = 'force-dynamic';
  21: interface RouteParams {
  22:   params: Promise<{
  23:     id: string;
  24:   }>;
  25: }
  26: 
  27: /**
  28:  * GET /api/spaces/[id]/details
  29:  * 
  30:  * Fetches additional details for a space:
  31:  * - agenda: Current phase information from space metadata
  32:  * - activityLog: Recent activity in the space
  33:  * - transcript: Latest message/transcript snippet
  34:  */
  35: export async function GET(request: NextRequest, {
  36:   params
  37: }: RouteParams): Promise<NextResponse> {
  38:   const correlationId = createCorrelationId();
  39:   try {
  40:     const authContext = await requireAuthUser({
  41:       correlationId,
  42:       pathname: '/api/spaces/details',
  43:     });
  44:     if ('errorResponse' in authContext) {
  45:       return authContext.errorResponse;
  46:     }
  47: 
  48:     const {
  49:       id: spaceId
  50:     } = await params;
  51:     if (!spaceId) {
  52:       return NextResponse.json({
  53:         error: 'Space ID is required'
  54:       }, {
  55:         status: 400
  56:       });
  57:     }
  58:     const supabase = await createSupabaseServerClient();
  59:     const spaceRepository = new SupabaseSpaceRepository(supabase);
  60: 
  61:     // Fetch space using repository
  62:     const space = await spaceRepository.findById(spaceId);
  63:     if (!space) {
  64:       return NextResponse.json({
  65:         error: 'Space not found'
  66:       }, {
  67:         status: 404
  68:       });
  69:     }
  70: 
  71:     if (space.companyId !== authContext.dbUser.companyId) {
  72:       return NextResponse.json({
  73:         error: 'Cannot access spaces outside your company'
  74:       }, {
  75:         status: 403
  76:       });
  77:     }
  78: 
  79:     // Fetch agenda from space_agendas table (AC3)
  80:     let agenda = null;
  81:     try {
  82:       const {
  83:         data: agendaData
  84:       } = await supabase.from('space_agendas').select('current_phase, total_phases, phase_name, 
phase_description').eq('space_id', spaceId).order('created_at', {
  85:         ascending: false
  86:       }).limit(1).maybeSingle();
  87:       if (agendaData) {
  88:         agenda = {
  89:           current: agendaData.current_phase,
  90:           total: agendaData.total_phases,
  91:           name: agendaData.phase_name,
  92:           description: agendaData.phase_description
  93:         };
  94:       }
  95:     } catch {
  96:       // Table may not exist yet - gracefully continue
  97:       console.log('space_agendas table not available yet');
  98:     }
  99: 
 100:     // For now, return empty activity log (table may not exist yet)
 101: 
 102:     // Try to fetch latest message for transcript snippet
 103:     // Messages are linked to spaces via conversations.room_id
 104:     let transcript = null;
 105:     try {
 106:       // First find the conversation for this space
 107:       const {
 108:         data: conversation
 109:       } = await supabase.from('conversations').select('id').eq('room_id', spaceId).limit(1).maybeSingle();
 110:       if (conversation) {
 111:         // Get the latest message from this conversation
 112:         const {
 113:           data: messages
 114:         } = await supabase.from('messages').select('id, content, sender_id, timestamp').eq('conversation_id', 
conversation.id).order('timestamp', {
 115:           ascending: false
 116:         }).limit(1);
 117:         if (messages && messages.length > 0) {
 118:           const msg = messages[0];
 119:           // Get sender info from users table
 120:           const {
 121:             data: sender
 122:           } = await supabase.from('users').select('display_name').eq('id', msg.sender_id).single();
 123:           transcript = {
 124:             text: msg.content || '',
 125:             speaker: sender?.display_name || 'Unknown',
 126:             timestamp: msg.timestamp
 127:           };
 128:         }
 129:       }
 130:     } catch {
 131:       // Gracefully continue without transcript if query fails
 132:     }
 133:     return jsonSuccess({
 134:       agenda,
 135:       activityLog,
 136:       transcript
 137:     }, correlationId);
 138:   } catch (error) {
 139:     console.error('Error fetching space details:', error);
 140:     return NextResponse.json({
 141:       error: 'Internal server error'
 142:     }, {
 143:       status: 500
 144:     });
 145:   }
 146: }
