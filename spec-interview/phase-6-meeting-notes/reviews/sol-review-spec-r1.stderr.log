  21:       const params = new URLSearchParams(window.location.search);
  22:       return params.get('tab') || 'members';
  23:     }
  24:     return 'members';
  25:   });
  26:   
  27:   // Update URL when tab changes
  28:   const handleTabChange = (tab: string) => {
  29:     setActiveTab(tab);
  30:     router.push(`/company?tab=${tab}`, { scroll: false });
  31:   };
  32:   
  33:   // Check if the user belongs to a company
  34:   const hasCompany = Boolean(currentUserProfile?.companyId);
  35:   
  36:   // Check if the user is an admin (only admins can access settings tab)
  37:   const isAdmin = company?.adminIds?.includes(currentUserProfile?.id || '') || false;
  38: 
  39:   // If still loading, show loading state
  40:   if (isLoading) {
  41:     return (
  42:       <DashboardShell
  43:         heading="Company Management"
  44:         description="Loading company information..."
  45:       >
  46:         <div className="grid gap-8">
  47:           <Card>
  48:             <CardHeader>
  49:               <CardTitle className="animate-pulse bg-muted h-6 w-48 rounded"></CardTitle>
  50:               <CardDescription className="animate-pulse bg-muted h-4 w-72 rounded mt-2"></CardDescription>
  51:             </CardHeader>
  52:             <CardContent>
  53:               <div className="animate-pulse space-y-4">
  54:                 <div className="h-8 bg-muted rounded w-full"></div>
  55:                 <div className="h-24 bg-muted rounded w-full"></div>
  56:               </div>
  57:             </CardContent>
  58:           </Card>
  59:         </div>
  60:       </DashboardShell>
  61:     );
  62:   }
  63: 
  64:   if (!hasCompany) {
  65:     redirect('/create-company');
  66:   }
  67: 
  68:   // If no company, show placeholder (should redirect, but just in case)
  69:   if (!hasCompany) {
  70:     return (
  71:       <DashboardShell
  72:         heading="Company Management"
  73:         description="You need to create or join a company first"
  74:       >
  75:         <div className="grid gap-8">
  76:           <Card>
  77:             <CardHeader>
  78:               <CardTitle>No Company Found</CardTitle>
  79:               <CardDescription>
  80:                 You need to create or join a company to access this page
  81:               </CardDescription>
  82:             </CardHeader>
  83:             <CardContent>
  84:               <Button onClick={() => router.push('/create-company')}>
  85:                 Create Company
  86:               </Button>
  87:             </CardContent>
  88:           </Card>
  89:         </div>
  90:       </DashboardShell>
  91:     );
  92:   }
  93: 
  94:   return (
  95:     <DashboardShell
  96:       heading="Company Management"
  97:       description={`Manage ${company?.name || 'your company'} settings, members and permissions`}
  98:     >
  99:       <div className="grid gap-8">
 100:         <Tabs 
 101:           defaultValue="members" 
 102:           className="w-full"
 103:           value={activeTab}
 104:           onValueChange={handleTabChange}
 105:         >
 106:           <TabsList className="mb-6">
 107:             <TabsTrigger value="members">Team Members</TabsTrigger>
 108:             {isAdmin && <TabsTrigger value="settings">Company Settings</TabsTrigger>}
 109:           </TabsList>
 110:           
 111:           <TabsContent value="members" className="space-y-4">
 112:             <CompanyMembers />
 113:           </TabsContent>
 114:           
 115:           {isAdmin && (
 116:             <TabsContent value="settings" className="space-y-4">
 117:               <CompanySettings />
 118:             </TabsContent>
 119:           )}
 120:         </Tabs>
 121:       </div>
 122:     </DashboardShell>
 123:   );
 124: }
