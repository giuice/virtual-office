  46:  * Hook to fetch detailed space information
  47:  * 
  48:  * @param spaceId - The ID of the space to fetch details for (null = don't fetch)
  49:  * @returns Space details including agenda, activity log, and transcript
  50:  */
  51: export function useSpaceDetails(spaceId: string | null): UseSpaceDetailsReturn {
  52:   const [details, setDetails] = useReducerState<Pick<UseSpaceDetailsReturn, 'agenda' | 'activityLog' | 
'transcript' | 'isLoading' | 'error'>>({
  53:     agenda: null,
  54:     activityLog: [],
  55:     transcript: null,
  56:     isLoading: false,
  57:     error: null,
  58:   });
  59: 
  60:   const fetchDetails = useCallback(async () => {
  61:     if (!spaceId) {
  62:       setDetails((prev) => ({
  63:         ...prev,
  64:         agenda: null,
  65:         activityLog: [],
  66:         transcript: null,
  67:         error: null,
  68:       }));
  69:       return;
  70:     }
  71: 
  72:     setDetails((prev) => ({ ...prev, isLoading: true, error: null }));
  73: 
  74:     try {
  75:       // Fetch space details from API
  76:       // Note: This API endpoint may need to be created
  77:       const response = await fetch(`/api/spaces/${spaceId}/details`);
  78:       
  79:       if (!response.ok) {
  80:         // If endpoint doesn't exist yet, use mock/fallback data
  81:         if (response.status === 404) {
  82:           // Return empty data - graceful degradation
  83:           setDetails({
  84:             agenda: null,
  85:             activityLog: [],
  86:             transcript: null,
  87:             isLoading: false,
  88:             error: null,
  89:           });
  90:           return;
  91:         }
  92:         throw new Error(`Failed to fetch space details: ${response.statusText}`);
  93:       }
  94: 
  95:       const data = await response.json();
  96: 
  97:       const nextAgenda = data.agenda
  98:         ? {
  99:           current: data.agenda.current ?? 1,
 100:           total: data.agenda.total ?? 1,
 101:           name: data.agenda.name ?? 'Current Phase',
 102:           description: data.agenda.description,
 103:         }
 104:         : null;
 105: 
 106:       const nextActivityLog = data.activityLog && Array.isArray(data.activityLog)
 107:         ? data.activityLog.map((entry: Record<string, unknown>) => ({
 108:             id: entry.id as string,
 109:             timestamp: new Date(entry.timestamp as string),
 110:             author: entry.author as string,
 111:             authorId: entry.authorId as string,
 112:             summary: entry.summary as string,
 113:             type: (entry.type as ActivityLogEntry['type']) ?? 'note',
 114:           }))
 115:         : [];
 116: 
 117:       const nextTranscript = data.transcript
 118:         ? {
 119:           text: data.transcript.text ?? '',
 120:           speaker: data.transcript.speaker ?? 'Unknown',
 121:           timestamp: new Date(data.transcript.timestamp as string),
 122:         }
 123:         : null;
 124: 
 125:       setDetails({
 126:         agenda: nextAgenda,
 127:         activityLog: nextActivityLog,
 128:         transcript: nextTranscript,
 129:         isLoading: false,
 130:         error: null,
 131:       });
 132: 
 133:     } catch (err) {
 134:       // Handle errors gracefully - don't break the UI
 135:       console.warn('Failed to fetch space details:', err);
 136:       setDetails({
 137:         agenda: null,
 138:         activityLog: [],
 139:         transcript: null,
 140:         isLoading: false,
 141:         error: err instanceof Error ? err : new Error('Unknown error'),
 142:       });
 143:     } finally {
 144:       setDetails((prev) => ({ ...prev, isLoading: false }));
 145:     }
 146:   }, [spaceId, setDetails]);
 147: 
 148:   // Fetch on mount and when spaceId changes
 149:   useEffect(() => {
 150:     fetchDetails();
 151:   }, [fetchDetails]);
 152: 
 153:   return {
 154:     agenda: details.agenda,
 155:     activityLog: details.activityLog,
 156:     transcript: details.transcript,
 157:     isLoading: details.isLoading,
 158:     error: details.error,
 159:     refetch: fetchDetails,
 160:   };
 161: }
 162: 
 163: export default useSpaceDetails;
