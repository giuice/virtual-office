   8: export const dynamic = 'force-dynamic';
   9: 
  10: const companyUpdateSchema = z
  11:   .object({
  12:     name: z.string().trim().min(1).max(160).optional(),
  13:     settings: z
  14:       .object({
  15:         allowGuestAccess: z.boolean().optional(),
  16:         maxRooms: z.number().int().nonnegative().optional(),
  17:         theme: z.string().max(64).optional(),
  18:         defaultSpaceId: z.string().uuid().optional(),
  19:         homeSpaces: z.record(z.string(), z.string().uuid()).optional(),
  20:       })
  21:       .strict()
  22:       .optional(),
  23:   })
  24:   .strict()
  25:   .refine((value) => Object.keys(value).length > 0);
  26: 
  27: export async function PATCH(request: Request) {
  28:   try {
  29:     const authContext = await requireAuthUser();
  30:     if ('errorResponse' in authContext) {
  31:       return authContext.errorResponse;
  32:     }
  33: 
  34:     const url = new URL(request.url);
  35:     const id = url.searchParams.get('id');
  36:     if (!id) {
  37:       return NextResponse.json({ error: 'Missing id parameter' }, { status: 400 });
  38:     }
  39: 
  40:     if (id !== authContext.dbUser.companyId || authContext.dbUser.role !== 'admin') {
  41:       return NextResponse.json({ error: 'Only company admins can update this company' }, { status: 403 });
  42:     }
  43: 
  44:     const parsedCompanyData = companyUpdateSchema.safeParse(await request.json());
  45:     if (!parsedCompanyData.success) {
  46:       return NextResponse.json(
  47:         { error: 'Invalid company update', code: 'INVALID_COMPANY_UPDATE' },
  48:         { status: 400 },
  49:       );
  50:     }
  51:     const companyData: Partial<Omit<Company, 'id' | 'createdAt'>> = parsedCompanyData.data;
  52: 
  53:     const companyRepository: ICompanyRepository = new SupabaseCompanyRepository(authContext.supabase);
  54:     const updatedCompany = await companyRepository.update(id, companyData);
  55: 
  56:     if (!updatedCompany) {
  57:       return NextResponse.json({ success: false, message: 'Company not found or update failed' }, { status: 404 
});
  58:     }
  59: 
  60:     return NextResponse.json({
  61:       success: true,
  62:       company: updatedCompany,
  63:       message: 'Company updated successfully',
  64:     });
  65:   } catch (error) {
  66:     console.error('Error updating company:', error);
  67:     return NextResponse.json({
  68:       success: false,
  69:       error: error instanceof Error ? error.message : 'Failed to update company',
  70:     }, { status: 500 });
  71:   }
  72: }
