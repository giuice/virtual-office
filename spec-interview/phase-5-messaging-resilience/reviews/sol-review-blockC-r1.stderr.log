20: const deliveryStateOf = (item: OutboxItem): MessageDeliveryState => {
21:   switch (item.state) {
22:     case 'waiting':
23:       return 'pending';
24:     case 'failed':
25:       return 'failed';
26:     case 'expired':
27:       return 'expired';
28:     default:
29:       // claimed / unknown: an attempt is (or may still be) in progress (FR-005).
30:       return 'sending';
31:   }
32: };
33: 
34: export function outboxItemToPendingMessage(item: OutboxItem): Message {
35:   const deliveryState = deliveryStateOf(item);
36:   return {
37:     id: `${PENDING_MESSAGE_ID_PREFIX}${item.clientMessageId}`,
38:     conversationId: item.conversationId,
39:     senderId: item.ownerId,
40:     content: item.content,
41:     timestamp: new Date(item.pressedSendAt),
42:     type: MessageType.TEXT,
43:     status: deliveryState === 'failed' || deliveryState === 'expired' ? MessageStatus.FAILED : 
MessageStatus.SENDING,
44:     replyToId: item.replyToId ?? undefined,
45:     reactions: [],
46:     isEdited: false,
47:     clientMessageId: item.clientMessageId,
48:     // Phase 5 T17: the requested mentions render on the sender's pending copy.
49:     ...(item.mentionIds.length > 0 ? { mentionedUserIds: [...item.mentionIds] } : {}),
50:     deliveryState,
51:     cancellable: item.state === 'waiting' && item.attemptGeneration === 0,
52:   };
53: }
