1: // Messaging health metrics wire contract (Phase 5 FR-027, BR-013, AC-028).
2: //
3: // Shared by the client recorder and POST /api/messages/metrics. Everything a
4: // metric can carry is a closed enum or a bounded integer: the route copies
5: // only these fields, drops any event with an unknown type or an invalid known
6: // field, ignores every other field, and adds the server time and the
7: // server-derived app version itself. A log line carries exactly the BR-013
8: // fields: ts, appVersion, type, and the optional reason, conversationType,
9: // durationMs, count, occurredAt (no tag field; a metric line is the JSON
10: // object with an `appVersion` and a `type` from MESSAGING_METRIC_TYPES).
11: // No identifier, name, text, or other free-form value can reach a log line.
12: 
13: /** Route path of the metrics sink. */
14: export const MESSAGING_METRICS_PATH = '/api/messages/metrics';
15: 
16: /** At most this many events per request (larger batches are rejected, 413). */
17: export const MESSAGING_METRICS_MAX_EVENTS = 50;
18: 
19: /** At most this many bytes of raw request body (larger bodies are rejected, 413). */
20: export const MESSAGING_METRICS_MAX_BYTES = 16 * 1024;
21: 
22: /**
23:  * Earliest accepted client time (2026-01-01T00:00:00Z) — a chosen accepted-
24:  * clock policy, not a guarantee about browsers: the Phase 5 client ships
25:  * after it, so a correct clock never reports an earlier send or episode. A
26:  * backward-dated event (e.g. from a client clock set back before this date:
27:  * an `occurredAt` earlier than it, or a duration longer than the time since
28:  * it plus the tolerated skew) is dropped whole.
29:  */
30: export const MESSAGING_METRICS_EARLIEST_EVENT_TIME_MS = Date.UTC(2026, 0, 1);
31: 
32: /** Tolerated lead of the client clock over the server clock. */
33: export const MESSAGING_METRICS_MAX_CLOCK_SKEW_MS = 24 * 60 * 60 * 1000;
34: 
35: /**
36:  * Upper bound of `durationMs` at server time `now` (epoch ms): the longest
37:  * interval that can start at or after the earliest supported time and end by
38:  * `now` plus the tolerated clock skew. There is deliberately no fixed ceiling
39:  * such as 30 days: an expired item retried manually keeps its original send
40:  * time (FR-009), so its send latency grows with however long the user waited.
41:  * A safe integer for any real clock.
42:  */
43: export function messagingMetricsMaxDurationMs(now: number): number {
44:   return Math.max(0, now + MESSAGING_METRICS_MAX_CLOCK_SKEW_MS - MESSAGING_METRICS_EARLIEST_EVENT_TIME_MS);
45: }
46: 
47: /** Upper bound of `count`. */
48: export const MESSAGING_METRICS_MAX_COUNT = 10_000;
49: 
50: export const MESSAGING_METRIC_TYPES = [
51:   // Press → server confirmed (from the original press, also after a manual retry).
52:   'send_latency',
53:   // Time an item waited in the outbox before its successful dispatch.
54:   'outbox_wait',
55:   // Outcome of a send, by reason.
56:   'send_outcome',
57:   // Realtime stream health; the stream is part of the event type.
58:   'messages_stream_drop',
59:   'messages_stream_recovery',
60:   'list_stream_drop',
61:   'list_stream_recovery',
62:   'typing_stream_drop',
63:   'typing_stream_recovery',
64:   // Polling fallback episodes.
65:   'polling_start',
66:   'polling_stop',
67: ] as const;
68: 
69: export type MessagingMetricType = (typeof MESSAGING_METRIC_TYPES)[number];
70: 
71: export const MESSAGING_SEND_OUTCOME_REASONS = [
72:   'delivered',
73:   'offline',
74:   'network_error',
75:   'timeout',
76:   'rate_limited',
77:   'server_error',
78:   'lost_access',
79:   'expired',
80:   'invalid_request',
81:   'content_too_large',
82:   'key_reused',
83:   'sender_mismatch',
84:   'session_ended',
85:   'cancelled',
86: ] as const;
87: 
88: export type MessagingSendOutcomeReason = (typeof MESSAGING_SEND_OUTCOME_REASONS)[number];
89: 
90: export const MESSAGING_STREAM_DROP_REASONS = ['error', 'timeout', 'closed', 'offline'] as const;
91: 
92: export type MessagingStreamDropReason = (typeof MESSAGING_STREAM_DROP_REASONS)[number];
93: 
94: export const MESSAGING_METRIC_CONVERSATION_TYPES = ['direct', 'group', 'room'] as const;
95: 
96: export type MessagingMetricConversationType = (typeof MESSAGING_METRIC_CONVERSATION_TYPES)[number];
97: 
