270: /**
271:  * Claims a message so it is announced (or knowingly left unannounced) once:
272:  * once per tab, and once across this browser's tabs of the app. The
273:  * cross-tab check-and-set runs under a Web Lock, which makes it atomic
274:  * between tabs; without Web Locks it is best effort.
275:  */
276: export async function claimMessageNotification(messageId: string): Promise<boolean> {
277:   if (!rememberTabClaim(messageId)) return false;
278:   const locks = typeof navigator !== 'undefined' ? navigator.locks : undefined;
279:   if (locks?.request) {
280:     try {
281:       return await locks.request(NOTIFIED_LOCK_NAME, () => claimAcrossTabs(messageId));
282:     } catch {
283:       return claimAcrossTabs(messageId);
284:     }
285:   }
286:   return claimAcrossTabs(messageId);
287: }
