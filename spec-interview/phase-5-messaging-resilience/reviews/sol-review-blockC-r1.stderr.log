3: import packageJson from '../../../package.json';
4: import {
5:   MESSAGING_METRIC_CONVERSATION_TYPES,
6:   MESSAGING_METRIC_TYPES,
7:   MESSAGING_METRIC_TYPE_RULES,
8:   MESSAGING_METRICS_EARLIEST_EVENT_TIME_MS,
9:   MESSAGING_METRICS_MAX_CLOCK_SKEW_MS,
10:   MESSAGING_METRICS_MAX_COUNT,
11:   messagingMetricsMaxDurationMs,
12:   type MessagingMetricConversationType,
13:   type MessagingMetricReason,
14:   type MessagingMetricType,
15: } from '@/lib/messaging/metrics-contract';
16: 
17: /**
18:  * One metric log line (BR-013): closed-enum event type and reason, bounded
19:  * duration/count, conversation type, timestamps, and the server-derived app
20:  * version — and nothing else (no tag field). Built only from validated
21:  * values, never from client strings.
22:  */
23: export interface MessagingMetricLogLine {
24:   /** Server receive time (ISO 8601). */
25:   ts: string;
26:   appVersion: string;
27:   type: MessagingMetricType;
28:   reason?: MessagingMetricReason;
29:   conversationType?: MessagingMetricConversationType;
30:   durationMs?: number;
31:   count?: number;
32:   /** Client event time (ISO 8601), only when within the accepted window. */
33:   occurredAt?: string;
34: }
35: 
36: const VERSION_PATTERN = /^[0-9A-Za-z.-]{1,32}$/;
37: const COMMIT_SHA_PATTERN = /^[0-9a-f]{7,40}$/i;
38: 
39: /**
40:  * App version derived on the server only: the package version plus the
41:  * deployment's git commit (Vercel system variable VERCEL_GIT_COMMIT_SHA,
42:  * first 12 hex chars) or `local` when the server runs outside a deployment.
43:  * Any client-supplied version is ignored.
44:  */
45: export function serverAppVersion(): string {
46:   const version = typeof packageJson.version === 'string' && VERSION_PATTERN.test(packageJson.version)
47:     ? packageJson.version
48:     : 'unknown';
49:   const sha = process.env.VERCEL_GIT_COMMIT_SHA;
50:   const build = typeof sha === 'string' && COMMIT_SHA_PATTERN.test(sha) ? sha.slice(0, 12).toLowerCase() : 'local';
51:   return `${version}+${build}`;
52: }
53: 
54: function isRecord(value: unknown): value is Record<string, unknown> {
55:   return typeof value === 'object' && value !== null && !Array.isArray(value);
56: }
57: 
58: function isOneOf<T extends string>(values: readonly T[], value: unknown): value is T {
59:   return typeof value === 'string' && (values as readonly string[]).includes(value);
60: }
61: 
62: function isBoundedInteger(value: unknown, max: number): value is number {
63:   return typeof value === 'number' && Number.isSafeInteger(value) && value >= 0 && value <= max;
64: }
65: 
66: /**
67:  * Validates one client event against the closed contract and returns its log
68:  * line, or null when the event must be dropped: not an object, unknown type,
69:  * a missing required field, or ANY known field present with an invalid value
70:  * (wrong enum, wrong type, out of range, or not allowed for its type).
71:  * Unknown fields are ignored and never copied.
72:  */
73: export function toMessagingMetricLogLine(
74:   input: unknown,
75:   context: { now: number; appVersion: string },
76: ): MessagingMetricLogLine | null {
77:   if (!isRecord(input) || !isOneOf(MESSAGING_METRIC_TYPES, input.type)) {
78:     return null;
79:   }
80:   const type = input.type;
81:   const rule = MESSAGING_METRIC_TYPE_RULES[type];
82:   const line: MessagingMetricLogLine = {
83:     ts: new Date(context.now).toISOString(),
84:     appVersion: context.appVersion,
85:     type,
86:   };
87: 
88:   if (input.reason !== undefined) {
89:     if (!rule.reasons || !isOneOf(rule.reasons, input.reason)) return null;
90:     line.reason = input.reason;
91:   } else if (rule.reasonRequired) {
92:     return null;
93:   }
94: 
95:   if (input.conversationType !== undefined) {
96:     if (!rule.allowsConversationType || !isOneOf(MESSAGING_METRIC_CONVERSATION_TYPES, input.conversationType)) {
97:       return null;
98:     }
99:     line.conversationType = input.conversationType;
100:   }
101: 
102:   if (input.durationMs !== undefined) {
103:     if (!rule.allowsDuration || !isBoundedInteger(input.durationMs, messagingMetricsMaxDurationMs(context.now))) 
return null;
104:     line.durationMs = input.durationMs;
105:   } else if (rule.durationRequired) {
106:     return null;
107:   }
108: 
109:   if (input.count !== undefined) {
110:     if (!rule.allowsCount || !isBoundedInteger(input.count, MESSAGING_METRICS_MAX_COUNT)) return null;
111:     line.count = input.count;
112:   }
113: 
114:   if (input.occurredAt !== undefined) {
115:     const occurredAt = input.occurredAt;
116:     if (
117:       typeof occurredAt !== 'number' ||
118:       !Number.isSafeInteger(occurredAt) ||
119:       occurredAt < MESSAGING_METRICS_EARLIEST_EVENT_TIME_MS ||
120:       occurredAt > context.now + MESSAGING_METRICS_MAX_CLOCK_SKEW_MS
121:     ) {
122:       return null;
123:     }
124:     line.occurredAt = new Date(occurredAt).toISOString();
125:   }
126: 
127:   return line;
128: }
129: 
130: /** Writes one structured line per accepted event; logging never fails the request. */
131: export function writeMessagingMetricLines(lines: readonly MessagingMetricLogLine[]): void {
132:   for (const line of lines) {
133:     try {
134:       console.info(JSON.stringify(line));
135:     } catch {
136:       // Observability is never part of the response path.
137:     }
138:   }
139: }
