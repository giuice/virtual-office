56: export function writeDesktopNotificationPreference(userId: string, enabled: boolean): void {
57:   try {
58:     window.localStorage.setItem(preferenceKey(userId), enabled ? PREFERENCE_ON : PREFERENCE_OFF);
59:   } catch {
60:     // Storage unavailable: the choice cannot be kept; nothing else depends on it.
61:   }
