1: import type { SupabaseClient } from '@supabase/supabase-js';
2: import { NextRequest, NextResponse } from 'next/server';
3: import { jsonError } from '@/lib/auth/authorize';
4: import { enforceRateLimit, rateLimitUnavailableResponse } from '@/lib/auth/rate-limit';
5: import { requireAuthUser } from '@/lib/auth/session';
6: import {
7:   MESSAGING_METRICS_MAX_BYTES,
8:   MESSAGING_METRICS_MAX_EVENTS,
9:   type MessagingMetricsResponse,
10: } from '@/lib/messaging/metrics-contract';
11: import {
12:   readBoundedBody,
13:   serverAppVersion,
14:   toMessagingMetricLogLine,
15:   writeMessagingMetricLines,
16:   type MessagingMetricLogLine,
17: } from '@/lib/messaging/metrics-log';
18: import { createSupabaseServerClient } from '@/lib/supabase/server-client';
19: 
20: /**
21:  * POST /api/messages/metrics — Phase 5 T6 (FR-027, BR-013, AC-028): sink of
22:  * the client's messaging health metrics, written as redacted structured log
23:  * lines (one JSON line per accepted event).
24:  *
25:  * Body (application/json): { events: MessagingMetricEventInput[] } — see
26:  * src/lib/messaging/metrics-contract.ts for the closed enums and bounds.
27:  *
28:  * Order: authenticate (401, nothing charged, no metric line; the normal
29:  * api_error / auth diagnostics of requireAuthUser are still written) → charge the per-user
30:  * 'messaging:metrics' budget, fail-closed (429) → 415 unless JSON → raw body
31:  * at most 16 KB counted on the received bytes (413
32:  * METRICS_PAYLOAD_TOO_LARGE) → valid JSON object with an `events` array
33:  * (400) → at most 50 events (413 METRICS_BATCH_TOO_LARGE) → each event
34:  * validated; invalid ones dropped, unknown fields ignored → 202
35:  * { accepted, dropped }. A rejected request writes no metric line; it may
36:  * write the normal api_error diagnostic of its error response (no metric
37:  * fields, no request data).
38:  *
39:  * Lines carry only the event type, reason, conversation type, duration,
40:  * count, the client event time (bounded), the server receive time, and the
41:  * server-derived app version — never user, conversation, or message data.
42:  */
43: export async function POST(request: NextRequest) {
44:   try {
45:     const auth = await requireAuthUser();
46:     if ('errorResponse' in auth) {
47:       await request.body?.cancel().catch(() => undefined);
48:       return auth.errorResponse;
49:     }
50: 
51:     // The budget fails closed: a limiter client that cannot even be built
52:     // (e.g. missing service-role key) is a budget that cannot be checked.
53:     // Diagnostics, no metric line: the fixed limiter-unavailable event below
54:     // (never the error or the key) plus the api_error line written by
55:     // rateLimitUnavailableResponse().
56:     let serviceClient: SupabaseClient;
57:     try {
58:       serviceClient = await createSupabaseServerClient('service_role');
59:     } catch {
60:       console.error(JSON.stringify({ event: 'messaging_metrics_limiter_unavailable' }));
61:       await request.body?.cancel().catch(() => undefined);
62:       return rateLimitUnavailableResponse();
63:     }
64:     const overBudget = await enforceRateLimit(serviceClient, auth.dbUser.id, 'messaging:metrics');
65:     if (overBudget) {
66:       await request.body?.cancel().catch(() => undefined);
67:       return overBudget;
68:     }
69: 
70:     const contentType = request.headers.get('content-type') ?? '';
71:     if (contentType.split(';')[0].trim().toLowerCase() !== 'application/json') {
72:       await request.body?.cancel().catch(() => undefined);
73:       return jsonError(415, 'UNSUPPORTED_MEDIA_TYPE', 'Metrics must be sent as application/json');
74:     }
75: 
76:     const body = await readBoundedBody(request, MESSAGING_METRICS_MAX_BYTES);
77:     if (!body.ok) {
78:       return body.reason === 'too_large'
79:         ? jsonError(413, 'METRICS_PAYLOAD_TOO_LARGE', 'Metrics payload exceeds 16 KB')
80:         : jsonError(400, 'BAD_REQUEST', 'Metrics payload could not be read');
81:     }
82: 
83:     let payload: unknown;
84:     try {
85:       payload = JSON.parse(new TextDecoder('utf-8', { fatal: true }).decode(body.bytes));
86:     } catch {
87:       return jsonError(400, 'BAD_REQUEST', 'Invalid JSON payload');
88:     }
89:     if (typeof payload !== 'object' || payload === null || Array.isArray(payload)) {
90:       return jsonError(400, 'BAD_REQUEST', 'Invalid JSON payload');
91:     }
92:     const events = (payload as { events?: unknown }).events;
93:     if (!Array.isArray(events)) {
94:       return jsonError(400, 'BAD_REQUEST', 'events must be an array');
95:     }
96:     if (events.length > MESSAGING_METRICS_MAX_EVENTS) {
97:       return jsonError(413, 'METRICS_BATCH_TOO_LARGE', 'At most 50 metric events per request');
98:     }
99: 
100:     const context = { now: Date.now(), appVersion: serverAppVersion() };
101:     const lines: MessagingMetricLogLine[] = [];
102:     for (const event of events) {
103:       const line = toMessagingMetricLogLine(event, context);
104:       if (line) lines.push(line);
105:     }
106:     writeMessagingMetricLines(lines);
107: 
108:     const result: MessagingMetricsResponse = { accepted: lines.length, dropped: events.length - lines.length };
109:     return NextResponse.json(result, { status: 202 });
110:   } catch (error) {
111:     // Never log the error object: it could carry request data.
112:     console.error(JSON.stringify({ event: 'messaging_metrics_failed', errorName: error instanceof Error ? 
error.name : 'unknown' }));
113:     return NextResponse.json({ error: 'Failed to record metrics', code: 'INTERNAL_ERROR' }, { status: 500 });
114:   }
115: }
