261: /** State and actions of the drawer's desktop-notification control. */
262: export function useDesktopNotificationSetting(currentUserId: string | undefined) {
263:   const getStatus = useCallback(() => readDesktopNotificationStatus(currentUserId), [currentUserId]);
264:   const status = useSyncExternalStore(subscribeDesktopNotificationStatus, getStatus, serverStatus);
265: 
266:   /** User action only: asks for permission when needed, then turns them on. */
267:   const enable = useCallback(async (): Promise<DesktopNotificationStatus> => {
268:     if (!currentUserId) return readDesktopNotificationStatus(currentUserId);
269:     const permission = await requestDesktopNotificationPermission();
270:     // Also written when refused, so the control re-reads the new permission.
271:     writeDesktopNotificationPreference(currentUserId, permission === 'granted');
272:     return readDesktopNotificationStatus(currentUserId);
273:   }, [currentUserId]);
274: 
275:   const disable = useCallback(() => {
276:     if (currentUserId) writeDesktopNotificationPreference(currentUserId, false);
277:   }, [currentUserId]);
278: 
279:   return { status, enable, disable };
280: }

