126: /**
127:  * - notify: a direct/group message from someone else (every new one);
128:  * - mention-only: a room message that may mention the user — announced only
129:  *   if the server lists the user among its mentions (Phase 5 FR-025);
130:  * - viewing: this tab shows that conversation right now;
131:  * - skip: never announced.
132:  */
133: export type IncomingMessageDecision = 'notify' | 'mention-only' | 'viewing' | 'skip';
134: 
135: /**
136:  * A mention is written "@<name>" by the composer (Phase 5 T17), so a room
137:  * message without "@" mentions nobody and needs no server read. Live INSERTs
138:  * carry no mentions (TRACK T4); the server's list decides for the others.
139:  */
140: const mayMention = (message: Message): boolean => message.content.includes('@');
141: 
142: /**
143:  * Phase 4 BR-010 / Phase 5 BR-011: others' messages in direct/group
144:  * conversations, and room messages that mention the user, notify when the
145:  * tab is hidden or the drawer is not open on that conversation. "Tab hidden"
146:  * is the foreground-tab definition used by read receipts (TRACK T6):
147:  * `document.visibilityState`, not window focus.
148:  */
149: export function decideIncomingMessage(input: {
150:   message: Message;
151:   conversation: Conversation;
152:   currentUserId: string;
153:   viewedConversationId: string | null;
154:   tabVisible: boolean;
155: }): IncomingMessageDecision {
156:   const { message, conversation, currentUserId, viewedConversationId, tabVisible } = input;
157:   // users.id comparison (the realtime row's sender_id is the application id).
158:   if (message.senderId === currentUserId) return 'skip';
159:   if (message.type === MessageType.SYSTEM) return 'skip';
160:   const directOrGroup = conversation.type === ConversationType.DIRECT || conversation.type === 
ConversationType.GROUP;
161:   if (!directOrGroup && !(conversation.type === ConversationType.ROOM && mayMention(message))) return 'skip';
162:   if (tabVisible && viewedConversationId === conversation.id) return 'viewing';
163:   return directOrGroup ? 'notify' : 'mention-only';
164: }
