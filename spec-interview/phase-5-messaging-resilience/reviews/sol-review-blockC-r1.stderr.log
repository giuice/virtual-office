338:   test('AC-048 (mention clause): a stale poll released after a mention arrived live keeps the mention, its 
highlight and one bubble', async ({
339:     phase5World,
340:     openDevice,
341:     realtimeFaults,
342:   }, testInfo) => {
343:     const { groupId } = phase5World.conversations;
344:     const { A } = phase5World.users;
345:     const b = await openDevice('B');
346:     const a = await openDevice('A');
347:     const harness = await realtimeFaults.attach(a);
348:     await openConversation(a.page, groupId);
349:     await harness.waitForReady('messages');
350:     await harness.waitForReady('list');
351: 
352:     // The first feed poll reads the server at once and is held in transit.
353:     let feedPolls = 0;
354:     let heldBody: { messages: Array<{ id: string }> } | null = null;
355:     let heldAt = 0;
356:     let release: () => void = () => undefined;
357:     const releaseGate = new Promise<void>((resolve) => {
358:       release = resolve;
359:     });
360:     let heldFinished = false;
361:     await a.page.route(
362:       (url) => url.pathname === '/api/messages/get' && url.searchParams.get('source') === 'poll',
363:       async (route: Route) => {
364:         feedPolls += 1;
365:         if (feedPolls !== 1) {
366:           await route.continue();
367:           return;
368:         }
369:         heldAt = Date.now();
370:         const response = await route.fetch();
371:         const body = await response.text();
372:         heldBody = JSON.parse(body);
373:         await releaseGate;
374:         await route.fulfill({ response, body });
375:         heldFinished = true;
376:       },
377:     );
378: 
379:     // ---- Only the list stream goes dark; the messages stream stays live.
380:     const fault = await harness.fail('list', 'close');
381:     await harness.waitForStatus('list', 'CLOSED', { since: fault.mark, timeout: 10_000 });
382:     await expect.poll(() => heldBody !== null, { timeout: POLL_AFTER_UNHEALTHY_MS + 10_000 }).toBe(true);
383:     expect(harness.status('messages'), 'the messages stream stays up').toBe('SUBSCRIBED');
384: 
385:     // ---- B mentions A after the held poll read the server; it arrives live.
386:     const text = `@${A.displayName} t17 stale poll ${randomUUID()}`;
387:     const messageId = await createViaApi(b.page, {
388:       conversationId: groupId,
389:       content: text,
390:       clientMessageId: randomUUID(),
391:       mentionIds: [A.userId],
392:     });
393:     await expect(mentionedYouCue(a.page, messageId)).toHaveText(MENTIONED_YOU, { timeout: LIVE_WITHIN_MS });
394:     await expect(mentionSpans(a.page, messageId)).toHaveText([`@${A.displayName}`]);
395:     const stale = heldBody as unknown as { messages: Array<{ id: string }> };
396:     expect(stale.messages.some((message) => message.id === messageId), 'the held poll predates the 
mention').toBe(false);
397: 
398:     // ---- Released: the mention, its highlight and one bubble stay (watched continuously).
399:     await a.page.evaluate((id) => {
400:       const violations: Array<{ at: number; bubbles: number; cues: number; mentions: number }> = [];
401:       const check = () => {
402:         const bubbles = document.querySelectorAll(`[data-testid="message-${id}"]`).length;
403:         const cues = document.querySelectorAll(`[data-testid="message-mentions-you-${id}"]`).length;
404:         const mentions = document.querySelectorAll(`[data-testid="message-${id}"] 
[data-testid="message-mention"]`).length;
405:         if (bubbles !== 1 || cues !== 1 || mentions !== 1) violations.push({ at: Date.now(), bubbles, cues, 
mentions });
406:       };
407:       (window as unknown as { __t17Violations?: typeof violations }).__t17Violations = violations;
408:       check();
409:       new MutationObserver(check).observe(document.body, { subtree: true, childList: true, characterData: true, 
attributes: true });
410:     }, messageId);
411:     const heldToReleaseMs = Date.now() - heldAt;
412:     expect(heldToReleaseMs, 'released before the round deadline').toBeLessThan(POLL_ROUND_DEADLINE_MS - 500);
413:     release();
414:     await expect.poll(() => heldFinished, { timeout: STEP_TIMEOUT_MS }).toBe(true);
415:     await a.page.waitForTimeout(2_000);
416:     expect(
417:       await a.page.evaluate(() => (window as unknown as { __t17Violations: unknown[] }).__t17Violations),
418:       'mention, highlight and single bubble kept',
419:     ).toEqual([]);
420:     await expect(mentionedYouCue(a.page, messageId)).toHaveText(MENTIONED_YOU);
421:     expect(await storedMentions(messageId)).toEqual([A.userId]);
422:     testInfo.annotations.push({ type: 't17-stale-poll', description: JSON.stringify({ heldToReleaseMs, feedPolls 
}) });
423:   });
424: });

