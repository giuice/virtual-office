198: /** Records (or, with null, removes) the conversation this visible tab shows. */
199: export function publishConversationView(userId: string, tabId: string, conversationId: string | null): void {
200:   try {
201:     const key = `${viewKeyPrefix(userId)}${tabId}`;
202:     if (conversationId) {
203:       window.localStorage.setItem(key, JSON.stringify({ conversationId, at: Date.now() }));
204:     } else {
205:       window.localStorage.removeItem(key);
206:     }
207:   } catch {
208:     // Storage unavailable: other tabs cannot see this one (best effort).
209:   }
210: }
