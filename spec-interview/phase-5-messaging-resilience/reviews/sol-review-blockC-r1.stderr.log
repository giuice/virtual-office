47: /** Every POST /api/messages/create the page sends, with its body and (once answered) status. */
48: function trackCreates(page: Page): CreateRequest[] {
49:   const creates: CreateRequest[] = [];
50:   const byRequest = new Map<Request, CreateRequest>();
51:   page.on('request', (request) => {
52:     if (request.method() !== 'POST' || new URL(request.url()).pathname !== '/api/messages/create') return;
53:     const entry: CreateRequest = { body: (request.postDataJSON() ?? {}) as Record<string, unknown> };
54:     creates.push(entry);
55:     byRequest.set(request, entry);
56:   });
57:   page.on('response', (response) => {
58:     const entry = byRequest.get(response.request());
59:     if (entry) entry.status = response.status();
60:   });
61:   return creates;
62: }
