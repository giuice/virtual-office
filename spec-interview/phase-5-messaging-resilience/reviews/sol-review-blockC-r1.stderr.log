1115:   /**
1116:    * Runs one create or fence request of `item`'s claim, aborted at its
1117:    * deadline (30 s, and never past the claim's lease) or when connectivity
1118:    * returns (handleOnline); an aborted request rejects like a network error.
1119:    */
1120:   private async withDeadline<T>(
1121:     item: OutboxItem,
1122:     send: (signal: AbortSignal) => Promise<T>,
1150:             attemptGeneration: item.attemptGeneration,
1151:             expectedSenderId: this.ownerId,
1152:             mentionIds: item.mentionIds,
1153:           },
1154:           signal
1155:         ),
1156:         deadline
1157:       );
1158:       this.observeResponse();
1159:       return classifyAttemptResponse(response, {
1160:         senderId: this.ownerId,
1161:         conversationId: item.conversationId,
1162:         clientMessageId: item.clientMessageId,
1163:       });
1164:     } catch (error) {
1165:       // No response (network error, the browser went offline mid-request, deadline).
1166:       this.observeRequestFailure(error);
1167:       return { kind: 'unknown', status: null, failure: requestFailure(error, deadline) };
1168:     }
1169:   }
