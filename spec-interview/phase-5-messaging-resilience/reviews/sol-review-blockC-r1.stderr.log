289: /** Notification body: the text preview, or what kind of content was sent. */
290: export function notificationBody(message: Message, attachmentKind: 'voice' | 'file' | null): string {
291:   const text = message.content.replace(/\s+/g, ' ').trim();
292:   if (text) {
293:     return text.length > PREVIEW_MAX_LENGTH ? `${text.slice(0, PREVIEW_MAX_LENGTH - 1)}…` : text;
294:   }
295:   if (attachmentKind === 'voice') return 'Nota de voz';
296:   if (message.type === MessageType.IMAGE) return 'Imagem';
297:   return 'Anexo';
298: }
299: 
300: export function notificationTitle(conversation: Conversation, senderName: string): string {
301:   if (conversation.type === ConversationType.GROUP) {
302:     return `${senderName} em ${conversation.name?.trim() || 'grupo'}`;
303:   }
304:   return senderName;
305: }
306: 
307: function mentionPlace(conversation: Conversation): string {
308:   const name = conversation.name?.trim();
309:   if (conversation.type === ConversationType.ROOM) return name || 'uma sala';
310:   if (conversation.type === ConversationType.GROUP) return name || 'um grupo';
311:   return 'uma conversa direta';
312: }
313: 
314: /** Phase 5 FR-025: "<Autor> mencionou você em <conversa>". */
315: export function mentionNotificationTitle(conversation: Conversation, senderName: string): string {
316:   return `${senderName} mencionou você em ${mentionPlace(conversation)}`;
317: }
318: 
319: /** Phase 5 FR-025: a mention shows the message's full text (no preview cut). */
320: export function mentionNotificationBody(message: Message, attachmentKind: 'voice' | 'file' | null): string {
321:   return message.content.trim() || notificationBody(message, attachmentKind);
322: }
323: 
324: /** One notification per conversation on screen: a newer one replaces it. */
325: export const notificationTag = (conversationId: string) => `vo-messaging-conversation-${conversationId}`;
326: 
327: /** Shows the notification; returns null when the browser refuses to construct it. */
328: export function showDesktopNotification(
329:   title: string,
330:   options: { body: string; tag: string },
331:   onClick: () => void,
332: ): Notification | null {
333:   if (readPermission() !== 'granted') return null;
334:   try {
335:     const notification = new window.Notification(title, options);
336:     notification.onclick = () => {
337:       try {
338:         window.focus();
339:       } catch {
340:         // Focusing is best effort.
341:       }
342:       onClick();
343:       notification.close();
344:     };
345:     return notification;
346:   } catch {
347:     // e.g. browsers that only allow notifications from a service worker.
348:     return null;
349:   }
350: }

