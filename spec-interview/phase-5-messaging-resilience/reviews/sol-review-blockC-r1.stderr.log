3: /**
4:  * Phase 5 T24 — the messaging app's browser-side storage, and how tests clear it.
5:  *
6:  * Every Phase 5 device is a fresh, non-persistent Playwright browser context:
7:  * its localStorage, sessionStorage, IndexedDB, Cache Storage and cookies start
8:  * empty and are discarded when the context closes, so nothing a test (or an
9:  * interrupted run) leaves in a browser reaches a later test. Within one test,
10:  * clearMessagingBrowserState() empties the messaging state of one origin
11:  * without closing the context (e.g. to simulate a cleared browser).
12:  *
13:  * Keep this list in sync with the app (T8+ add the outbox here):
14:  *   localStorage
15:  *   - every key starting with `vo:messaging:` — desktop-notification
16:  *     preference `vo:messaging:desktop-notifications:<userId>`, cross-tab claims
17:  *     `vo:messaging:notified-messages`, per-tab conversation views
18:  *     `vo:messaging:notification-view:<users.id>:<tabId>` (T18; 30 s expiry, a
19:  *     viewing tab rewrites its key every 10 s); RESERVED prefix for new
20:  *     Phase 5 localStorage keys.
21:  *   - legacy Phase 4 drawer keys `messaging_drawer_minimized`,
22:  *     `messaging_drawer_active_view`, `messaging_active_conversation_id`:
23:  *     global to the browser; since T20 the app removes them on load and never
24:  *     reads them (still cleared here for state an older build left).
25:  *   IndexedDB
26:  *   - every database whose name starts with `vo-messaging` — RESERVED prefix
27:  *     for Phase 5. The app must close its connection on `versionchange`, or
28:  *     deletion stays blocked while a tab holds it open.
29:  *   - `vo-messaging-outbox` (T8, `src/lib/messaging/outbox/outbox-db.ts`):
30:  *     stores `items` (outbox items, key [ownerId, clientMessageId]) and `meta`
31:  *     (per-owner creation-order counter); closes on `versionchange`.
32:  *   Web Locks (not storage; released when the tab closes)
33:  *   - `vo-messaging-outbox:<users.id>:<conversationId>` — T8 drain lock.
34:  *   sessionStorage (per tab)
35:  *   - every key starting with `vo:messaging:` (reserved prefix) — drawer
36:  *     restore `vo:messaging:drawer:<users.id>` (T20,
37:  *     `src/lib/messaging/drawer-restore.ts`): present while that user's drawer
38:  *     is open in the tab; read once after a reload of that tab.
39:  *   BroadcastChannel (not storage): outbox coordination messages (T10, T11, T12).
40:  */
41: /** Legacy Phase 4 drawer keys (removed by the app since T20). */
42: export const MESSAGING_LOCAL_STORAGE_KEYS = [
43:   'messaging_drawer_minimized',
44:   'messaging_drawer_active_view',
45:   'messaging_active_conversation_id',
46: ] as const;
47: export const MESSAGING_STORAGE_KEY_PREFIX = 'vo:messaging:';
48: export const MESSAGING_INDEXED_DB_PREFIX = 'vo-messaging';
49: /** The Phase 5 outbox database (T8); covered by MESSAGING_INDEXED_DB_PREFIX. */
50: export const MESSAGING_OUTBOX_DB_NAME = 'vo-messaging-outbox';
51: 
52: export interface MessagingBrowserStateSnapshot {
53:   localStorageKeys: string[];
54:   sessionStorageKeys: string[];
55:   indexedDbNames: string[];
56: }
57: 
58: interface StorageSpec {
59:   keys: readonly string[];
60:   keyPrefix: string;
61:   dbPrefix: string;
62: }
63: 
64: const SPEC: StorageSpec = {
65:   keys: MESSAGING_LOCAL_STORAGE_KEYS,
66:   keyPrefix: MESSAGING_STORAGE_KEY_PREFIX,
67:   dbPrefix: MESSAGING_INDEXED_DB_PREFIX,
68: };
69: 
70: /**
71:  * The messaging keys and databases present on the page's origin (localStorage
72:  * and IndexedDB are shared by the context's tabs; sessionStorage is this tab's).
73:  */
74: export async function readMessagingBrowserState(page: Page): Promise<MessagingBrowserStateSnapshot> {
75:   return page.evaluate(async (spec: StorageSpec) => {
76:     const isMessagingKey = (key: string) => spec.keys.includes(key) || key.startsWith(spec.keyPrefix);
77:     const keysOf = (storage: Storage) =>
78:       Array.from({ length: storage.length }, (_, index) => storage.key(index)).filter(
79:         (key): key is string => key !== null && isMessagingKey(key),
80:       );
81:     const databases = typeof indexedDB.databases === 'function' ? await indexedDB.databases() : [];
82:     return {
83:       localStorageKeys: keysOf(window.localStorage).sort(),
84:       sessionStorageKeys: keysOf(window.sessionStorage)
85:         .filter((key) => key.startsWith(spec.keyPrefix))
86:         .sort(),
87:       indexedDbNames: databases
88:         .map((database) => database.name ?? '')
89:         .filter((name) => name.startsWith(spec.dbPrefix))
90:         .sort(),
91:     };
92:   }, SPEC);
93: }
