65: /**
66:  * Opt-in rule: notifications are on only when the user enabled them in the
67:  * drawer on this browser AND the browser permission is "granted". A granted
68:  * permission alone (e.g. given to another account or before turning them off
69:  * in-app) does not enable them; a denied/revoked permission disables them.
70:  */
71: export function readDesktopNotificationStatus(userId: string | null | undefined): DesktopNotificationStatus {
72:   const permission = readPermission();
73:   if (permission === null) return 'unsupported';
74:   if (permission === 'denied') return 'blocked';
75:   if (permission === 'granted' && userId && readPreference(userId)) return 'enabled';
76:   return 'available';
77: }
