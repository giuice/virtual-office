79: /**
80:  * Asks the browser for permission. Call only from a user action (the drawer
81:  * control); never on load. Resolves to the permission after the request.
82:  */
83: export async function requestDesktopNotificationPermission(): Promise<NotificationPermission | null> {
84:   if (!notificationsSupported()) return null;
85:   const current = readPermission();
86:   if (current !== 'default') return current;
87:   try {
88:     return await window.Notification.requestPermission();
89:   } catch {
90:     return readPermission();
91:   }
92: }
