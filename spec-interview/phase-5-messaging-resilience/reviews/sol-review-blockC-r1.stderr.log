91: export function publishOutboxItem(queryClient: QueryClient, item: OutboxItem): void {
92:   const copy = outboxItemToPendingMessage(item);
93:   queryClient.setQueryData<Message[]>(pendingMessagesQueryKey(item.ownerId, item.conversationId), (current) =>
94:     [
