274: /** Feed order: oldest first by timestamp, then id (the server's keyset order). */
275: const compareFeedOrder = (a: Message, b: Message): number => {
276:   const byTime = new Date(a.timestamp).getTime() - new Date(b.timestamp).getTime();
277:   if (byTime !== 0) return byTime;
278:   return a.id < b.id ? -1 : a.id > b.id ? 1 : 0;
279: };
