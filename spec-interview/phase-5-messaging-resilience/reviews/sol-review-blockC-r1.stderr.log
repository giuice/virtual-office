147:   for (const request of requests) {
148:     expect(Buffer.byteLength(request.body, 'utf8')).toBeLessThanOrEqual(MAX_BATCH_BYTES);
149:     const { events } = JSON.parse(request.body) as { events: Array<Record<string, unknown>> };
150:     expect(events.length).toBeGreaterThan(0);
151:     expect(events.length).toBeLessThanOrEqual(MAX_BATCH_EVENTS);
152:     for (const event of events) {
153:       expect(Object.keys(event).filter((key) => !METRIC_EVENT_KEYS.has(key))).toEqual([]);
154:       expect(METRIC_TYPES.has(String(event.type))).toBe(true);
155:     }
156:   }
157: }
