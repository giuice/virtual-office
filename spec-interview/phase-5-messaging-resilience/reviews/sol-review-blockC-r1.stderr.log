212: /** Whether another visible tab of the user shows `conversationId` now. Removes expired records. */
213: export function isConversationViewedElsewhere(userId: string, tabId: string, conversationId: string): boolean {
214:   try {
215:     const prefix = viewKeyPrefix(userId);
216:     const own = `${prefix}${tabId}`;
217:     const now = Date.now();
218:     const expired: string[] = [];
219:     let viewed = false;
220:     for (let index = 0; index < window.localStorage.length; index += 1) {
221:       const key = window.localStorage.key(index);
222:       if (!key || !key.startsWith(prefix) || key === own) continue;
223:       const record = parseViewRecord(window.localStorage.getItem(key));
224:       if (!record || now - record.at >= VIEW_TTL_MS) {
225:         expired.push(key);
226:       } else if (record.conversationId === conversationId) {
227:         viewed = true;
228:       }
229:     }
230:     expired.forEach((key) => window.localStorage.removeItem(key));
231:     return viewed;
232:   } catch {
233:     return false;
234:   }
235: }
