1: // src/lib/messaging/mentions.ts
2: // Phase 5 T17 (FR-023, FR-026): @mentions in message text. The stored text is
3: // plain ("Oi @Bruno Silva"); which "@name" spans are mentions comes from the
4: // ids chosen in the composer (sent as `mentionIds`) or stored with the message
5: // (`mentionedUserIds`). A mention is a token "@<label>" that starts the text
6: // or follows whitespace and is not followed by a letter, digit or "_". Pure
7: // helpers, no React or I/O.
8: 
9: /** A member that can be (or is) mentioned: users.id and the label shown after "@". */
10: export interface MentionCandidate {
11:   userId: string;
12:   label: string;
13: }
14: 
15: /** A piece of message text: plain, or one mention token ("@" + label). */
16: export interface MentionSegment {
17:   text: string;
18:   mention?: MentionCandidate;
19: }
20: 
21: /** The "@" query being typed: the "@" is at `start`, `query` runs up to the caret. */
22: export interface MentionQuery {
23:   start: number;
24:   query: string;
25: }
26: 
27: const FALLBACK_LABEL = 'Usuário';
28: const MAX_QUERY_LENGTH = 64;
29: const WORD_CHAR = /[\p{L}\p{N}_]/u;
30: const WHITESPACE = /\s/;
31: 
32: /** The label of a member's mention: their display name, or a fixed fallback when they have none. */
33: export function mentionLabel(displayName: string | null | undefined): string {
34:   const label = displayName?.trim();
35:   return label ? label : FALLBACK_LABEL;
36: }
37: 
38: /** Case- and accent-insensitive form used to filter the list. */
39: const searchForm = (value: string): string =>
40:   value.normalize('NFD').replace(/\p{M}+/gu, '').toLowerCase();
41: 
42: /**
43:  * The "@" query ending at `caret`, or null when the caret is not inside one:
44:  * an "@" at the start of the text or after whitespace, followed (up to the
45:  * caret) by no line break and no other "@".
46:  */
47: export function findMentionQuery(text: string, caret: number): MentionQuery | null {
48:   const end = Math.min(Math.max(caret, 0), text.length);
49:   for (let index = end - 1; index >= 0 && end - index <= MAX_QUERY_LENGTH + 1; index -= 1) {
50:     const char = text[index];
51:     if (char === '\n' || char === '\r') return null;
52:     if (char !== '@') continue;
53:     if (index > 0 && !WHITESPACE.test(text[index - 1])) return null;
54:     return { start: index, query: text.slice(index + 1, end) };
55:   }
56:   return null;
57: }
58: 
59: /**
60:  * Candidates matching the typed query, in their given order: the label (or
61:  * one of its words) starts with the query, ignoring case and accents. An
62:  * empty query matches everyone.
63:  */
64: export function filterMentionCandidates(
65:   candidates: readonly MentionCandidate[],
66:   query: string
67: ): MentionCandidate[] {
68:   const wanted = searchForm(query);
69:   if (!wanted) return [...candidates];
70:   return candidates.filter((candidate) => {
71:     const label = searchForm(candidate.label);
72:     return label.startsWith(wanted) || label.split(/\s+/).some((word) => word.startsWith(wanted));
73:   });
74: }
75: 
76: /**
77:  * Replaces the typed "@query" (from `start` to `end`) with "@<label>" and a
78:  * space (unless whitespace already follows); returns the new text and the
79:  * caret position after the mention.
80:  */
81: export function insertMention(
82:   text: string,
83:   start: number,
84:   end: number,
85:   label: string
86: ): { text: string; caret: number } {
87:   const after = text.slice(end);
88:   const token = `@${label}`;
89:   const separator = after.length > 0 && WHITESPACE.test(after[0]) ? '' : ' ';
90:   const next = `${text.slice(0, start)}${token}${separator}${after}`;
91:   return { text: next, caret: start + token.length + 1 };
92: }
93: 
94: /** Whether a mention token of `label` starts at `index` (which holds an "@"). */
95: const tokenAt = (text: string, index: number, label: string): boolean => {
96:   if (text[index] !== '@' || (index > 0 && !WHITESPACE.test(text[index - 1]))) return false;
97:   if (!text.startsWith(label, index + 1)) return false;
98:   const next = text[index + 1 + label.length];
99:   return next === undefined || !WORD_CHAR.test(next);
100: };
101: 
102: /**
103:  * Splits `text` into plain pieces and mention tokens of `mentions` (the
104:  * longest label wins where labels overlap, e.g. "Ana" and "Ana Paula").
105:  */
106: export function segmentMentions(text: string, mentions: readonly MentionCandidate[]): MentionSegment[] {
107:   if (mentions.length === 0 || !text.includes('@')) return text ? [{ text }] : [];
108:   const byLength = [...mentions].sort((a, b) => b.label.length - a.label.length);
109:   const segments: MentionSegment[] = [];
110:   let plainStart = 0;
111:   let index = 0;
112:   while (index < text.length) {
113:     const mention = text[index] === '@' ? byLength.find((candidate) => tokenAt(text, index, candidate.label)) : 
undefined;
114:     if (!mention) {
115:       index += 1;
116:       continue;
117:     }
118:     if (index > plainStart) segments.push({ text: text.slice(plainStart, index) });
119:     const tokenEnd = index + 1 + mention.label.length;
120:     segments.push({ text: text.slice(index, tokenEnd), mention });
121:     index = tokenEnd;
122:     plainStart = tokenEnd;
123:   }
124:   if (plainStart < text.length) segments.push({ text: text.slice(plainStart) });
125:   return segments;
126: }
127: 
128: /** Whether `text` still holds a mention token of `label`. */
129: export function hasMentionToken(text: string, label: string): boolean {
130:   for (let index = text.indexOf('@'); index !== -1; index = text.indexOf('@', index + 1)) {
131:     if (tokenAt(text, index, label)) return true;
132:   }
133:   return false;
134: }
135: 
136: /**
137:  * The users.id of every chosen mention whose token is still in `text`
138:  * (lowercase, distinct, sorted — the server's canonical form, so a retry of
139:  * the same composition sends the same set).
140:  */
141: export function mentionIdsInText(text: string, mentions: readonly MentionCandidate[]): string[] {
142:   const ids = new Set<string>();
143:   for (const segment of segmentMentions(text, mentions)) {
144:     if (segment.mention) ids.add(segment.mention.userId.toLowerCase());
145:   }
146:   return [...ids].sort();
147: }
