100: /** The redaction scan: no identifier, name, email or text of the test anywhere in `texts`. */
101: function expectRedacted(texts: readonly string[], forbidden: readonly string[], what: string): void {
102:   for (const text of texts) {
103:     expect(UUID.test(text), `${what} carries no UUID: ${text}`).toBe(false);
104:     expect(text.includes('@'), `${what} carries no email: ${text}`).toBe(false);
105:     for (const value of forbidden) {
106:       expect(text.toLowerCase().includes(value.toLowerCase()), `${what} does not carry "${value}"`).toBe(false);
107:     }
