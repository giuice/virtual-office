94: /** Calls `listener` whenever the status may have changed (preference or permission). */
95: export function subscribeDesktopNotificationStatus(listener: () => void): () => void {
96:   if (typeof window === 'undefined') return () => {};
97:   const onStorage = (event: StorageEvent) => {
98:     if (event.key === null || event.key.startsWith(PREFERENCE_KEY_PREFIX)) listener();
99:   };
100:   window.addEventListener(PREFERENCE_EVENT, listener);
101:   window.addEventListener('storage', onStorage);
102:   // A permission changed in the browser's site settings is picked up when the
103:   // user comes back to the tab, and live where the Permissions API reports it.
104:   window.addEventListener('focus', listener);
105:   document.addEventListener('visibilitychange', listener);
106:   let permissionStatus: PermissionStatus | null = null;
107:   let unsubscribed = false;
108:   navigator.permissions
109:     ?.query({ name: 'notifications' })
110:     .then((status) => {
111:       if (unsubscribed) return;
112:       permissionStatus = status;
113:       status.addEventListener('change', listener);
114:     })
115:     .catch(() => {});
116:   return () => {
117:     unsubscribed = true;
118:     window.removeEventListener(PREFERENCE_EVENT, listener);
119:     window.removeEventListener('storage', onStorage);
120:     window.removeEventListener('focus', listener);
121:     document.removeEventListener('visibilitychange', listener);
122:     permissionStatus?.removeEventListener('change', listener);
123:   };
124: }
