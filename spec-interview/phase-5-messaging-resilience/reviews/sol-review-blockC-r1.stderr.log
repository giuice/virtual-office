237: const tabClaims = new Set<string>();
238: 
239: function rememberTabClaim(messageId: string): boolean {
240:   if (tabClaims.has(messageId)) return false;
241:   tabClaims.add(messageId);
242:   if (tabClaims.size > MAX_TAB_CLAIMS) {
243:     const oldest = tabClaims.values().next().value;
244:     if (oldest !== undefined) tabClaims.delete(oldest);
245:   }
246:   return true;
247: }
248: 
249: function claimAcrossTabs(messageId: string): boolean {
250:   try {
251:     const now = Date.now();
252:     const raw = window.localStorage.getItem(NOTIFIED_STORAGE_KEY);
253:     const parsed: unknown = raw ? JSON.parse(raw) : {};
254:     const claims: Record<string, number> = {};
255:     if (parsed && typeof parsed === 'object' && !Array.isArray(parsed)) {
256:       for (const [id, at] of Object.entries(parsed as Record<string, unknown>)) {
257:         if (typeof at === 'number' && now - at < NOTIFIED_TTL_MS) claims[id] = at;
258:       }
259:     }
260:     if (claims[messageId] !== undefined) return false;
261:     claims[messageId] = now;
262:     window.localStorage.setItem(NOTIFIED_STORAGE_KEY, JSON.stringify(claims));
263:     return true;
264:   } catch {
265:     // No shared storage: this tab alone decides.
266:     return true;
267:   }
268: }
