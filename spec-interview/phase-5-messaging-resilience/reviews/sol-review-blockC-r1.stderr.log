105: export function beginOutboxSignOut(ownerId: string, queryClient: QueryClient, isOwner: OutboxOwnerCheck): 
OutboxSignOut {
106:   const local = MessageOutbox.liveFor(ownerId);
107:   local.forEach((outbox) => outbox.stopForSignOut());
108:   const channel = typeof BroadcastChannel !== 'undefined' ? new BroadcastChannel(outboxChannelName(ownerId)) : 
null;
109:   const post = (message: { signOutStop: true } | { signOutDone: true }) => {
110:     try {
111:       channel?.postMessage(message);
112:     } catch {
113:       // The other tabs then stop on the auth change (signed out) or their stop expires.
114:     }
115:   };
116:   post({ signOutStop: true });
117:   clearOutboxViews(queryClient, ownerId);
118:   let released = false;
119:   return {
120:     async discard() {
121:       // Past the wait the delete goes ahead anyway (a frozen tab cannot hold the sign-out).
122:       await within(waitForDrainsToStop(ownerId, DRAIN_STOP_WAIT_MS), DRAIN_STOP_WAIT_MS + 500, 'drain 
stop').catch(
123:         () => undefined
124:       );
125:       // F2: deleted only if the browser is still signed in as the owner when "Sair mesmo" runs.
126:       const owner = await within(isOwner(), STORAGE_WAIT_MS, 'identity check').catch(() => false);
127:       if (!owner) {
128:         if (debugLogger.messaging.enabled()) debugLogger.messaging.event(SCOPE, 'outbox-kept-not-owner', {});
129:         return;
130:       }
131:       const removed = await within(deleteAllOutboxItems(ownerId), STORAGE_WAIT_MS, 'delete');
132:       clearOutboxViews(queryClient, ownerId);
133:       // T19: the unsent items the user chose to drop (delivered only if the session still allows).
134:       recordCancelledMetrics(removed);
135:       if (debugLogger.messaging.enabled()) {
136:         debugLogger.messaging.event(SCOPE, 'outbox-deleted', { removed });
137:       }
138:     },
139:     release() {
140:       if (released) return;
141:       released = true;
142:       post({ signOutDone: true });
143:       channel?.close();
144:       local.forEach((outbox) => outbox.endSignOutStop());
145:     },
146:   };
147: }

