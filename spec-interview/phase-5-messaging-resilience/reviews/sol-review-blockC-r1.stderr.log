81: /**
82:  * Every metric line in the raw log since `mark`: a line carrying an
83:  * `appVersion` must be exactly one JSON object with only BR-013 fields and a
84:  * known type (anything else fails the scan).
85:  */
86: function metricLinesSince(serverLog: { linesSince(mark: ServerLogMark): string[] }, mark: ServerLogMark): 
MetricLine[] {
87:   const lines: MetricLine[] = [];
88:   for (const raw of serverLog.linesSince(mark)) {
89:     if (!raw.includes('"appVersion"')) continue;
90:     const text = raw.replace(ANSI, '');
91:     const parsed = JSON.parse(text) as Record<string, unknown>;
92:     expect(Object.keys(parsed).filter((key) => !METRIC_LINE_KEYS.has(key)), `only BR-013 fields: 
${text}`).toEqual([]);
93:     expect(METRIC_TYPES.has(String(parsed.type)), `known type: ${text}`).toBe(true);
94:     expect(String(parsed.appVersion)).toMatch(/^[0-9A-Za-z.-]{1,32}\+(local|[0-9a-f]{12})$/);
95:     lines.push({ ...parsed, raw: text } as MetricLine);
96:   }
97:   return lines;
98: }
