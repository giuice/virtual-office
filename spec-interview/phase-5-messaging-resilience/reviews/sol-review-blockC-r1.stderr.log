179: const viewKeyPrefix = (userId: string) => `${VIEW_KEY_PREFIX}${userId}:`;
180: 
181: interface ConversationViewRecord {
182:   conversationId: string;
183:   at: number;
184: }
185: 
186: function parseViewRecord(raw: string | null): ConversationViewRecord | null {
187:   if (!raw) return null;
188:   try {
189:     const parsed: unknown = JSON.parse(raw);
190:     if (!parsed || typeof parsed !== 'object') return null;
191:     const { conversationId, at } = parsed as Record<string, unknown>;
192:     return typeof conversationId === 'string' && typeof at === 'number' ? { conversationId, at } : null;
193:   } catch {
194:     return null;
195:   }
196: }
