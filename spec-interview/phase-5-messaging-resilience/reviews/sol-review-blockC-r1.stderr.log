1: // Desktop-notification observation shared by the Phase 4 notification spec
2: // (messaging-desktop-notifications.spec.ts) and the Phase 5 mention
3: // notification spec (messaging-phase5/mention-notifications.spec.ts). The
4: // page's Notification constructor is wrapped by an init script that records
5: // every construction (title, body, tag) and every permission request, while
6: // permission and requestPermission keep the browser's real behavior (granted
7: // through Playwright, or the browser's own denial when nothing is granted).
8: import { expect, type BrowserContext, type Page } from '@playwright/test';
9: 
10: export const NOTIFICATION_RECV_TIMEOUT_MS = 15_000;
11: /** Long enough for a notification the page was going to show to be constructed. */
12: export const NOTIFICATION_QUIET_WINDOW_MS = 2_500;
13: 
14: export interface RecordedNotification {
15:   title: string;
16:   body: string;
17:   tag: string;
18: }
19: 
20: export interface NotificationRecord {
21:   constructed: RecordedNotification[];
22:   permissionRequests: number;
23: }
24: 
25: /** Init script: records Notification constructions and permission requests. */
26: export function installNotificationRecorder(): void {
27:   const target = window as unknown as {
28:     __notificationRecord: NotificationRecord;
29:     __notificationInstances: Notification[];
30:   };
31:   target.__notificationRecord = { constructed: [], permissionRequests: 0 };
32:   target.__notificationInstances = [];
33:   const RealNotification = window.Notification;
34:   if (typeof RealNotification !== 'function') return;
35:   class RecordingNotification extends RealNotification {
36:     constructor(title: string, options?: NotificationOptions) {
37:       // Recorded before construction, so an attempt that throws still counts.
38:       target.__notificationRecord.constructed.push({
39:         title,
40:         body: options?.body ?? '',
41:         tag: options?.tag ?? '',
42:       });
43:       super(title, options);
44:       target.__notificationInstances.push(this);
45:     }
46: 
47:     static requestPermission(callback?: NotificationPermissionCallback): Promise<NotificationPermission> {
48:       target.__notificationRecord.permissionRequests += 1;
49:       return RealNotification.requestPermission(callback);
50:     }
51:   }
52:   Object.defineProperty(window, 'Notification', {
53:     value: RecordingNotification,
54:     writable: true,
55:     configurable: true,
56:   });
57: }
58: 
59: /** Page init script: the tab is in the background from its first script on. */
60: export function startHidden(): void {
61:   Object.defineProperty(document, 'visibilityState', { configurable: true, get: () => 'hidden' });
62:   Object.defineProperty(document, 'hidden', { configurable: true, get: () => true });
63: }
64: 
65: export async function notificationRecord(page: Page): Promise<NotificationRecord> {
66:   return page.evaluate(
67:     () => (window as unknown as { __notificationRecord: NotificationRecord }).__notificationRecord,
68:   );
69: }
70: 
71: export async function notificationsOf(page: Page): Promise<RecordedNotification[]> {
72:   return (await notificationRecord(page)).constructed;
73: }
74: 
75: /** Waits for the page's notification count to reach `count`, then returns them. */
76: export async function expectNotificationCount(page: Page, count: number): Promise<RecordedNotification[]> {
77:   await expect
78:     .poll(async () => (await notificationsOf(page)).length, { timeout: NOTIFICATION_RECV_TIMEOUT_MS })
79:     .toBe(count);
80:   return notificationsOf(page);
81: }
82: 
83: /** After a quiet window, the page still has exactly `count` notifications. */
84: export async function expectNoNewNotification(page: Page, count: number, reason: string): Promise<void> {
85:   await page.waitForTimeout(NOTIFICATION_QUIET_WINDOW_MS);
86:   expect((await notificationsOf(page)).length, reason).toBe(count);
87: }
88: 
89: /** Clicks the newest recorded notification with `tag`, as the OS would on a click. */
90: export async function clickNotification(page: Page, tag: string): Promise<void> {
91:   const clicked = await page.evaluate((wanted) => {
92:     const instances = (window as unknown as { __notificationInstances: Notification[] }).__notificationInstances;
93:     const notification = instances.filter((candidate) => candidate.tag === wanted).at(-1);
94:     if (!notification) return false;
95:     notification.dispatchEvent(new Event('click'));
96:     return true;
97:   }, tag);
98:   expect(clicked, `a notification tagged ${tag}`).toBe(true);
99: }
100: 
101: /** Grants the notification permission to the app's origin in this browser context. */
102: export async function grantNotifications(context: BrowserContext, origin: string): Promise<void> {
103:   await context.grantPermissions(['notifications'], { origin });
104: }
105: 
106: export const notificationTagOf = (conversationId: string) => `vo-messaging-conversation-${conversationId}`;
107: export const notificationsToggle = (page: Page) => page.getByTestId('messaging-notifications-toggle');

