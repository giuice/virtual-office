179: // DELETE payloads only carry the primary key under RLS, so the conversation
180: // is unknown — drop the message from every cached conversation.
181: const removeMessageFromAllCaches = (queryClient: QueryClient, messageId: string) => {
182:   const allMessagesQueries = queryClient.getQueriesData<MessagesInfiniteData>({
183:     queryKey: ['messages'],
184:   });
185: 
186:   allMessagesQueries.forEach(([queryKey, oldData]) => {
187:     if (!oldData?.pages) return;
188: 
189:     let changed = false;
190:     const pages = oldData.pages.map((page) => {
191:       const filtered = page.messages.filter((existing) => existing.id !== messageId);
192:       if (filtered.length !== page.messages.length) {
193:         changed = true;
194:         return { ...page, messages: filtered };
195:       }
196:       return page;
197:     });
198: 
199:     if (changed) {
200:       queryClient.setQueryData(queryKey, { ...oldData, pages });
201:     }
202:   });
203: };
