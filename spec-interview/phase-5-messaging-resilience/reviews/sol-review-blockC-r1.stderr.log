1: // src/lib/messaging/outbox/outbox-metrics.ts
2: // Phase 5 T19 (FR-027, FR-028): the outbox's metric events, recorded at its
3: // trace points (message-outbox.ts, outbox-sign-out.ts) — send latency from
4: // the original press (kept by a manual retry, FR-009), time waited in the
5: // outbox before the successful dispatch, and every outcome by reason. Only
6: // closed enums and durations leave here (no key, conversation, or text).
7: //
8: // Explicit mapping of the outbox's outcomes onto the contract's reasons (the
9: // T6 enums have no separate value for these):
10: // - a 401 while the client still holds a session (retried, BR-005) and a
11: //   fence answered 401 -> `session_ended` (the server refused the request's
12: //   session);
13: // - a definitive 4xx without a specific reason (`rejected`) -> `invalid_request`;
14: // - no answer: the request's own deadline -> `timeout`; aborted because
15: //   connectivity returned, or failed while the browser is offline ->
16: //   `offline`; any other network failure -> `network_error`;
17: // - 5xx and any answer that confirms nothing -> `server_error`;
18: // - 409 ATTEMPT_SUPERSEDED (a newer attempt of the key exists, possibly in
19: //   another tab) is not an outcome of the send and is not recorded; a claim
20: //   taken over after its lease ended is recorded by the tab that takes it
21: //   over, through that tab's own outcome.
22: import type { MessagingSendOutcomeReason } from '@/lib/messaging/metrics-contract';
23: import { metricDurationMs, recordMessagingMetric } from '@/lib/messaging/metrics-recorder';
24: import type { OutboxFailureReason, OutboxItem } from '@/types/message-outbox';
25: import type { OutboxAttemptOutcome, OutboxRequestFailure } from './outbox-outcome';
26: 
27: const FAILURE_REASONS: Record<OutboxFailureReason, MessagingSendOutcomeReason> = {
28:   not_participant: 'lost_access',
29:   sender_mismatch: 'sender_mismatch',
30:   client_message_id_reused: 'key_reused',
31:   content_too_large: 'content_too_large',
32:   invalid_request: 'invalid_request',
33:   rejected: 'invalid_request',
34: };
35: 
36: const REQUEST_FAILURE_REASONS: Record<OutboxRequestFailure, MessagingSendOutcomeReason> = {
37:   timeout: 'timeout',
38:   offline: 'offline',
39:   network: 'network_error',
40: };
41: 
42: /** The contract reason of an attempt's outcome, or null when it is not a send outcome (superseded). */
43: export function sendOutcomeReason(outcome: OutboxAttemptOutcome): MessagingSendOutcomeReason | null {
44:   switch (outcome.kind) {
45:     case 'delivered':
46:       return 'delivered';
47:     case 'expired':
48:       return 'expired';
49:     case 'superseded':
50:       return null;
51:     case 'failed':
52:       return FAILURE_REASONS[outcome.reason];
53:     case 'transient':
54:     case 'unknown': {
55:       const { status } = outcome;
56:       if (status === null) return REQUEST_FAILURE_REASONS[(outcome.kind === 'unknown' && outcome.failure) || 
'network'];
57:       if (status === 429) return 'rate_limited';
58:       if (status === 401) return 'session_ended';
59:       if (status === 409) return null;
60:       return 'server_error';
61:     }
62:   }
63: }
64: 
65: function recordOutcome(reason: MessagingSendOutcomeReason): void {
66:   recordMessagingMetric({ type: 'send_outcome', reason });
67: }
68: 
69: /**
70:  * One answered (or failed) attempt of `item` in this tab. Delivered: also its
71:  * latency from the original press to the confirmation (`confirmedAt`) and its
72:  * wait in the outbox until the dispatch that succeeded (`dispatchedAt`).
73:  */
74: export function recordAttemptMetrics(
75:   item: OutboxItem,
76:   outcome: OutboxAttemptOutcome,
77:   dispatchedAt: number,
78:   confirmedAt: number
79: ): void {
80:   const reason = sendOutcomeReason(outcome);
81:   if (reason === null) return;
82:   if (reason === 'delivered') {
83:     recordDeliveredMetrics(item, confirmedAt, dispatchedAt);
84:     return;
85:   }
86:   recordOutcome(reason);
87: }
88: 
89: /**
90:  * `item` was confirmed at `confirmedAt` (a create/fence answer, or its stored
91:  * message observed in the feed); `dispatchedAt` is null when the dispatch
92:  * that stored it is not known here.
93:  */
94: export function recordDeliveredMetrics(item: OutboxItem, confirmedAt: number, dispatchedAt: number | null): void {
95:   const latency = metricDurationMs(item.pressedSendAt, confirmedAt);
96:   if (latency !== null) recordMessagingMetric({ type: 'send_latency', durationMs: latency });
97:   const wait = dispatchedAt === null ? null : metricDurationMs(item.pressedSendAt, dispatchedAt);
98:   if (wait !== null) recordMessagingMetric({ type: 'outbox_wait', durationMs: wait });
99:   recordOutcome('delivered');
100: }
101: 
102: /** A send queued while the browser is offline (FR-001): its immediate outcome. */
103: export function recordQueuedOfflineMetric(): void {
104:   recordOutcome('offline');
105: }
106: 
107: /** Unsent items removed by the user: "Cancelar" (one) or "Sair mesmo" (`count`). */
108: export function recordCancelledMetrics(count = 1): void {
109:   const recorded = Math.min(Math.max(0, Math.floor(count)), 50);
110:   for (let index = 0; index < recorded; index += 1) recordOutcome('cancelled');
111: }
