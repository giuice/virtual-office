40: /**
41:  * Phase 5 T17 (FR-023, BR-010, AC-023, AC-037): the composer's "@" mention
42:  * list. Typing "@" (at the start or after a space) offers the conversation's
43:  * current members except the viewer — the members route roster
44:  * (`useConversationMembers`, T4/T15), so a removed or never-joined user is
45:  * never offered — filtered as the user types. Arrows move, Enter/Tab choose,
46:  * Escape closes it (until the caret leaves that "@"), and the mouse picks an
47:  * option. A chosen member is inserted as "@<name> " and stays a mention while
48:  * that token is intact; "@name" typed without choosing is plain text.
49:  * `mentionIds` is what the send carries (users.id, sorted).
50:  */
51: export function useComposerMentions({
52:   conversationId,
53:   viewerId,
54:   content,
55:   setContent,
56:   textareaRef,
57: }: UseComposerMentionsOptions) {
