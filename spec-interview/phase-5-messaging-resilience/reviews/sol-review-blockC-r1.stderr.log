1181:   /**
1182:    * T27 (FR-006, FR-009, BR-005): an earlier attempt of `item` may be stored.
1183:    * Fences the key under the item's new generation before anything else;
1184:    * only a not-stored answer lets the item be sent, and only while it is
1185:    * still this tab's claim and inside its delivery window, and this drain may
1186:    * still dispatch (F4/F5: not held, stopped, or taken over meanwhile).
1187:    */
1188:   private async fenceThenAttempt(
1189:     item: OutboxItem,
1190:     session: DrainSession,
1191:     timing: DispatchTiming
1192:   ): Promise<OutboxAttemptOutcome> {
1193:     let fence: OutboxFenceOutcome;
1194:     const deadline: RequestDeadline = { hit: false };
1195:     try {
1196:       const response = await this.withDeadline(item, (signal) =>
1197:         messagingApi.fenceMessageAttempt(
1198:           {
1199:             conversationId: item.conversationId,
1200:             clientMessageId: item.clientMessageId,
1201:             attemptGeneration: item.attemptGeneration,
1202:             expectedSenderId: this.ownerId,
1203:           },
1204:           signal
1205:         ),
1206:         deadline
1207:       );
1208:       this.observeResponse();
1209:       fence = classifyFenceResponse(response, {
1210:         senderId: this.ownerId,
1211:         conversationId: item.conversationId,
1212:         clientMessageId: item.clientMessageId,
1213:       });
1214:     } catch (error) {
1215:       this.observeRequestFailure(error);
1216:       fence = { kind: 'unknown', status: null, failure: requestFailure(error, deadline) };
1217:     }
1218:     this.trace('fence', { conversationId: item.conversationId, generation: item.attemptGeneration, outcome: 
fence.kind });
1219:     if (fence.kind !== 'not_stored') return fence;
1220:     if (Date.now() >= item.windowStartedAt + DELIVERY_WINDOW_MS) return { kind: 'expired' };
1221:     // T11 (FR-011): the create is a new dispatch; the drain discards this outcome when the owner is gone.
1222:     if (!(await this.verifyOwner())) return { kind: 'superseded' };
1223:     const current = await updateOutboxItem(this.ownerId, item.clientMessageId, () => undefined);
1224:     if (
1225:       !this.mayDispatch(session) ||
1226:       current?.state !== 'claimed' ||
1227:       current.claimHolder !== this.tabId ||
1228:       current.attemptGeneration !== item.attemptGeneration
1229:     ) {
1230:       return { kind: 'superseded' };
1231:     }
1232:     // The fence's generation is now the key's current one: the create may commit under it.
1233:     timing.dispatchedAt = Date.now();
1234:     return this.attempt(item);
1235:   }
