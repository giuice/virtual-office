283: export interface PolledMessagesMerge {
284:   data: MessagesInfiniteData;
285:   /** Messages the poll added to page 0 (not cached before). */
286:   added: Message[];
287:   changed: boolean;
288: }
289: 
290: /**
291:  * Phase 5 T14 (FR-016, AC-048): merges a polling-fallback read of a
292:  * conversation (`polled`, oldest first) into its cached feed without ever
293:  * going back to older data:
294:  * - a message is never duplicated: one already in ANY page is never added
295:  *   again, and one the cache held when the poll started (`cachedAtStart`) but
296:  *   no longer holds (removed meanwhile), or seen deleted, is not brought back;
297:  * - an existing message is replaced by its polled copy only when
298:  *   `replaceExisting` — the caller's proof that nothing wrote the feed since
299:  *   the poll started, so the polled copy is the newer state (receipts,
300:  *   reactions, attachments, mentions); otherwise the cached copy is kept;
301:  * - a new message is placed in page 0 (the newest window) in feed order, and
302:  *   only when it is not older than page 0's oldest message: an older one
303:  *   belongs to history that is not loaded. Older pages are never replaced,
304:  *   dropped or reordered.
305:  */
306: export function mergePolledMessages(
307:   oldData: MessagesInfiniteData,
308:   polled: readonly Message[],
309:   options: {
310:     replaceExisting: boolean;
311:     cachedAtStart: ReadonlySet<string>;
312:     isDeleted: (messageId: string) => boolean;
313:   }
314: ): PolledMessagesMerge {
315:   const polledById = new Map(polled.map((message) => [message.id, message]));
316:   const cached = new Set<string>();
317:   let changed = false;
318: 
319:   const pages = oldData.pages.map((page) => {
320:     let pageChanged = false;
321:     const messages = page.messages.map((existing) => {
322:       cached.add(existing.id);
323:       if (!options.replaceExisting) return existing;
324:       const next = polledById.get(existing.id);
325:       if (!next || options.isDeleted(existing.id) || sameMessage(existing, next)) return existing;
326:       pageChanged = true;
327:       return next;
328:     });
329:     if (!pageChanged) return page;
330:     changed = true;
331:     return { ...page, messages };
332:   });
333: 
334:   const newest = pages[0];
335:   const floor = newest.messages[0] ?? pages.slice(1).find((page) => page.messages.length > 0)?.messages.at(-1);
336:   const added = polled.filter(
337:     (message) =>
338:       !cached.has(message.id) &&
339:       !options.cachedAtStart.has(message.id) &&
340:       !options.isDeleted(message.id) &&
341:       (!floor || compareFeedOrder(message, floor) >= 0)
342:   );
343:   if (added.length > 0) {
344:     const merged = [...newest.messages];
345:     for (const message of added) {
346:       const index = merged.findIndex((existing) => compareFeedOrder(existing, message) > 0);
347:       if (index === -1) merged.push(message);
348:       else merged.splice(index, 0, message);
349:     }
350:     pages[0] = { ...newest, messages: merged };
351:     changed = true;
352:   }
353: 
354:   return { data: changed ? { ...oldData, pages } : oldData, added, changed };
355: }

