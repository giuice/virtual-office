1: // src/lib/messaging/drawer-restore.ts
2: //
3: // Phase 5 T20 (FR-031, BR-016): the messaging drawer is restored after a page
4: // reload, per application user (users.id), in the tab that was reloaded.
5: //
6: // Storage: sessionStorage `vo:messaging:drawer:<users.id>`, present only while
7: // that user's drawer is open in this tab: `{ minimized, view, conversationId }`
8: // (`conversationId` only for the conversation view). sessionStorage survives a
9: // reload of the same tab and is not shared with other tabs, so a reload
10: // restores what that tab showed, and another tab's drawer never moves it.
11: // The record is read once per page load, and only when the document was
12: // loaded by a reload or a back/forward navigation (FR-031 "after a page
13: // reload"): a new tab, a typed URL or a sign-in redirect starts closed.
14: //
15: // The Phase 4 keys (localStorage `messaging_drawer_minimized`,
16: // `messaging_drawer_active_view`, `messaging_active_conversation_id`) were
17: // global to the browser, so any user signing in inherited them; they are
18: // removed and never read.
19: 
20: export const DRAWER_RESTORE_KEY_PREFIX = 'vo:messaging:drawer:';
21: 
22: const LEGACY_DRAWER_KEYS = [
23:   'messaging_drawer_minimized',
24:   'messaging_drawer_active_view',
25:   'messaging_active_conversation_id',
26: ] as const;
27: 
28: const UUID_PATTERN = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
29: 
30: /** An open drawer as one user left it in this tab. */
31: export interface SavedDrawer {
32:   minimized: boolean;
33:   /** The drawer view to reopen ('search' is saved as 'list'). */
34:   view: 'list' | 'conversation';
35:   /** The conversation shown, only for the conversation view. */
36:   conversationId: string | null;
37: }
38: 
39: const keyFor = (ownerId: string) => `${DRAWER_RESTORE_KEY_PREFIX}${ownerId}`;
40: 
41: function tabStorage(): Storage | null {
42:   try {
43:     return typeof window === 'undefined' ? null : window.sessionStorage;
44:   } catch {
45:     return null;
46:   }
47: }
48: 
49: /** Whether this document was loaded by a reload (or a back/forward navigation). */
50: export function isRestoringPageLoad(): boolean {
51:   try {
52:     if (typeof performance === 'undefined' || typeof performance.getEntriesByType !== 'function') return false;
53:     const [navigation] = performance.getEntriesByType('navigation') as PerformanceNavigationTiming[];
54:     return navigation?.type === 'reload' || navigation?.type === 'back_forward';
55:   } catch {
56:     return false;
57:   }
58: }
59: 
60: /** The drawer `ownerId` left open in this tab, or null (closed, absent, or unreadable). */
61: export function readSavedDrawer(ownerId: string): SavedDrawer | null {
62:   const storage = tabStorage();
63:   if (!storage) return null;
64:   try {
65:     const raw = storage.getItem(keyFor(ownerId));
66:     if (!raw) return null;
67:     const parsed: unknown = JSON.parse(raw);
68:     if (!parsed || typeof parsed !== 'object') return null;
69:     const record = parsed as Record<string, unknown>;
70:     const view = record.view === 'conversation' ? 'conversation' : 'list';
71:     const conversationId =
72:       view === 'conversation' && typeof record.conversationId === 'string' && 
UUID_PATTERN.test(record.conversationId)
73:         ? record.conversationId
74:         : null;
75:     return { minimized: record.minimized === true, view: conversationId ? view : 'list', conversationId };
76:   } catch {
77:     return null;
78:   }
79: }
80: 
81: /** Saves `ownerId`'s drawer for this tab; `null` (closed) removes the record. */
82: export function saveDrawer(ownerId: string, drawer: SavedDrawer | null): void {
83:   const storage = tabStorage();
84:   if (!storage) return;
85:   try {
86:     if (drawer) {
87:       storage.setItem(keyFor(ownerId), JSON.stringify(drawer));
88:     } else {
89:       storage.removeItem(keyFor(ownerId));
90:     }
91:   } catch {
92:     // Storage full or blocked: the drawer simply is not restored.
93:   }
94: }
95: 
96: /** Removes the Phase 4 browser-wide drawer keys (never read: they belong to no user). */
97: export function removeLegacyDrawerKeys(): void {
98:   try {
99:     if (typeof window === 'undefined') return;
100:     for (const key of LEGACY_DRAWER_KEYS) window.localStorage.removeItem(key);
101:   } catch {
102:     // Blocked storage: nothing to remove.
103:   }
104: }

