1: // src/lib/messaging/stream-metrics.ts
2: // Phase 5 T19 (FR-027): drops, recoveries and outage durations of every
3: // messaging Realtime stream (messages, list, typing), derived from this
4: // tab's stream health store (T13, realtime-health.ts) — read only, nothing
5: // in the streams' lifecycle changes.
6: //
7: // An outage episode of a stream starts with its first failure after being
8: // healthy (or after starting): one `<stream>_stream_drop` with the failure's
9: // reason. It ends when the stream is SUBSCRIBED again: one
10: // `<stream>_stream_recovery` with the outage duration (from when the stream
11: // became unhealthy) and the number of failures (rejoin attempts) in it. A
12: // stream that stops during an outage (signed out, conversation closed,
13: // access lost) ends its episode without a recovery event.
14: import type { MessagingStreamDropReason, MessagingMetricType } from '@/lib/messaging/metrics-contract';
15: import { metricCount, metricDurationMs, recordMessagingMetric } from '@/lib/messaging/metrics-recorder';
16: import type {
17:   MessagingRealtimeHealth,
18:   MessagingRealtimeStream,
19:   MessagingStreamHealth,
20: } from '@/lib/messaging/realtime-health';
21: 
22: const STREAMS: readonly MessagingRealtimeStream[] = ['messages', 'list', 'typing'];
23: 
24: const DROP_TYPE: Record<MessagingRealtimeStream, MessagingMetricType> = {
25:   messages: 'messages_stream_drop',
26:   list: 'list_stream_drop',
27:   typing: 'typing_stream_drop',
28: };
29: 
30: const RECOVERY_TYPE: Record<MessagingRealtimeStream, MessagingMetricType> = {
31:   messages: 'messages_stream_recovery',
32:   list: 'list_stream_recovery',
33:   typing: 'typing_stream_recovery',
34: };
35: 
36: function dropReason(status: string | null): MessagingStreamDropReason {
37:   if (typeof navigator !== 'undefined' && navigator.onLine === false) return 'offline';
38:   if (status === 'TIMED_OUT') return 'timeout';
39:   if (status === 'CLOSED') return 'closed';
40:   return 'error';
41: }
42: 
43: const failed = (entry: MessagingStreamHealth): boolean => !entry.healthy && entry.failures > 0;
44: 
45: /** Records stream drop/recovery metrics while subscribed to `health`; returns the unsubscribe function. */
46: export function observeStreamHealthMetrics(health: MessagingRealtimeHealth): () => void {
47:   /** Open outage episodes: since when the stream has been unhealthy. */
48:   const outages = new Map<MessagingRealtimeStream, number>();
49: 
50:   const check = () => {
51:     try {
52:       const snapshot = health.getSnapshot();
53:       for (const stream of STREAMS) {
54:         const entry = snapshot[stream];
55:         const since = outages.get(stream);
56:         if (!entry) {
57:           outages.delete(stream);
58:         } else if (since === undefined && failed(entry)) {
59:           outages.set(stream, entry.unhealthySince ?? Date.now());
60:           recordMessagingMetric({ type: DROP_TYPE[stream], reason: dropReason(entry.status) });
61:         } else if (since !== undefined && entry.healthy) {
62:           outages.delete(stream);
63:           const durationMs = metricDurationMs(since, Date.now());
64:           if (durationMs !== null) {
65:             recordMessagingMetric({ type: RECOVERY_TYPE[stream], durationMs, count: metricCount(entry.failures) });
66:           }
67:         }
68:       }
69:     } catch {
70:       // Metrics never affect messaging.
71:     }
72:   };
73: 
74:   check();
75:   return health.subscribe(check);
76: }
