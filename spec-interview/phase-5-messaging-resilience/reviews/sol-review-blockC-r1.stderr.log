95: /** sessionStorage is per tab: the other open tabs of `page`'s context on the same origin. */
96: function sameOriginTabs(page: Page): Page[] {
97:   const origin = new URL(page.url()).origin;
98:   return page
99:     .context()
100:     .pages()
101:     .filter((tab) => tab !== page && !tab.isClosed() && /^https?:/.test(tab.url()) && new URL(tab.url()).origin 
=== origin);
102: }
103: 
104: async function clearTabSessionStorage(tab: Page, prefix: string): Promise<string[]> {
105:   return tab.evaluate((keyPrefix) => {
106:     const keys = Array.from({ length: window.sessionStorage.length }, (_, index) => 
window.sessionStorage.key(index)).filter(
107:       (key): key is string => key !== null && key.startsWith(keyPrefix),
108:     );
109:     for (const key of keys) window.sessionStorage.removeItem(key);
110:     return keys;
111:   }, prefix);
112: }
