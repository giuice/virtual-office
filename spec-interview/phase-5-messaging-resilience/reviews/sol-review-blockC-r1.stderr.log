40: /** Least time between the starts of two requests of this tab (≤ 6 per minute). */
41: const MIN_REQUEST_INTERVAL_MS = 10_000;
42: /** After a failed or aborted request. */
43: const FAILURE_PAUSE_MS = 15_000;
44: /** After a 429: the route's budget window. */
45: const OVERLOAD_PAUSE_MS = 60_000;
46: const SCOPE = 'MessagingMetrics';
47: 
48: /**
49:  * Scheduling clock: monotonic, so a wall-clock jump (a corrected or changed
50:  * system time) neither stalls delivery nor bursts it.
51:  */
52: const monotonicNow = (): number =>
53:   typeof performance !== 'undefined' && typeof performance.now === 'function' ? performance.now() : Date.now();
54: 
55: const encoder = typeof TextEncoder !== 'undefined' ? new TextEncoder() : null;
56: const byteLength = (text: string): number => (encoder ? encoder.encode(text).byteLength : text.length * 3);
57: 
58: const tracing = (): boolean => {
59:   try {
60:     return debugLogger.messaging.enabled();
61:   } catch {
62:     return false;
63:   }
64: };
65: 
66: const trace = (event: string, details: Record<string, unknown>): void => {
67:   if (tracing()) debugLogger.messaging.event(SCOPE, event, details);
68: };
69: 
70: /** A non-negative integer duration (ms) of an interval, or null when the clock makes it meaningless. */
71: export function metricDurationMs(from: number, to: number): number | null {
72:   const duration = Math.round(to - from);
73:   return Number.isSafeInteger(duration) && duration >= 0 ? duration : null;
74: }
75: 
76: /** A count clamped to the contract's bound. */
77: export const metricCount = (count: number): number =>
78:   Math.min(MESSAGING_METRICS_MAX_COUNT, Math.max(0, Math.floor(Number.isFinite(count) ? count : 0)));
79: 
80: class MessagingMetricsRecorder {
81:   private buffer: MessagingMetricEventInput[] = [];
82:   private dropped = 0;
83:   /** Whose events the buffer holds (the last activated user). */
84:   private bufferOwner: string | null = null;
85:   /** Delivery runs only while that user is active. */
86:   private active = false;
87:   private inFlight = false;
88:   private timer: ReturnType<typeof setTimeout> | null = null;
89:   /** When the oldest event still waiting arrived (the batch is gathered from then). */
90:   private waitingSince: number | null = null;
91:   /** No request starts before this time. */
92:   private nextRequestAt = 0;
93: 
94:   record(event: MessagingMetricEventInput): void {
95:     this.buffer.push(event);
96:     if (this.buffer.length > MESSAGING_METRICS_MAX_BUFFERED_EVENTS) {
97:       const excess = this.buffer.length - MESSAGING_METRICS_MAX_BUFFERED_EVENTS;
98:       this.buffer.splice(0, excess);
99:       this.dropped += excess;
100:     }
101:     if (this.waitingSince === null) this.waitingSince = monotonicNow();
102:     trace('recorded', { type: event.type, buffered: this.buffer.length, dropped: this.dropped });
103:     this.schedule();
104:   }
105: 
106:   /** Delivery runs for `userId` (users.id) until deactivated; another user's events are discarded first. */
107:   activate(userId: string): void {
108:     if (this.bufferOwner !== null && this.bufferOwner !== userId) {
109:       this.clearTimer();
110:       if (this.buffer.length > 0) trace('discarded', { buffered: this.buffer.length });
111:       this.buffer = [];
112:       this.waitingSince = null;
113:     }
114:     this.bufferOwner = userId;
115:     this.active = true;
116:     this.schedule();
117:   }
118: 
119:   deactivate(userId: string): void {
120:     if (this.bufferOwner !== userId) return;
121:     this.active = false;
122:     this.clearTimer();
123:   }
124: 
125:   private clearTimer(): void {
126:     if (this.timer) clearTimeout(this.timer);
127:     this.timer = null;
128:   }
129: 
130:   private schedule(): void {
131:     if (!this.active || this.inFlight || this.timer || this.buffer.length === 0) return;
132:     const now = monotonicNow();
133:     const gathered = this.buffer.length >= MESSAGING_METRICS_MAX_EVENTS ? now : (this.waitingSince ?? now) + 
FLUSH_DELAY_MS;
134:     const delay = Math.max(0, this.nextRequestAt - now, gathered - now);
135:     this.timer = setTimeout(() => {
136:       this.timer = null;
137:       this.flush();
138:     }, delay);
139:   }
140: 
141:   /** Takes the oldest events that fit one batch (by count and body size) out of the buffer. */
142:   private takeBatch(): { body: string; size: number } | null {
143:     let count = 0;
144:     let body = '';
145:     const most = Math.min(this.buffer.length, MESSAGING_METRICS_MAX_EVENTS);
146:     for (let size = 1; size <= most; size += 1) {
147:       const candidate = JSON.stringify({ events: this.buffer.slice(0, size) });
148:       if (byteLength(candidate) > MESSAGING_METRICS_MAX_BYTES) break;
149:       body = candidate;
150:       count = size;
151:     }
152:     if (count === 0) {
153:       // An event that cannot fit any batch (never with the contract's fields) is dropped.
154:       this.buffer.shift();
155:       this.dropped += 1;
156:       return null;
157:     }
158:     this.buffer.splice(0, count);
159:     this.waitingSince = this.buffer.length > 0 ? monotonicNow() : null;
160:     return { body, size: count };
161:   }
162: 
163:   private flush(): void {
164:     if (!this.active || this.inFlight || this.buffer.length === 0) return;
165:     if (typeof fetch !== 'function') return;
166:     if (typeof navigator !== 'undefined' && navigator.onLine === false) {
167:       // Offline: the batch would only fail; checked again later.
168:       this.pause(monotonicNow() + FLUSH_DELAY_MS);
169:       this.schedule();
170:       return;
171:     }
172:     const batch = this.takeBatch();
173:     if (!batch) {
174:       this.schedule();
175:       return;
176:     }
177:     const startedAt = monotonicNow();
178:     this.inFlight = true;
179:     this.nextRequestAt = startedAt + MIN_REQUEST_INTERVAL_MS;
180:     const controller = typeof AbortController !== 'undefined' ? new AbortController() : null;
181:     const deadline = setTimeout(() => controller?.abort(), MESSAGING_METRICS_REQUEST_TIMEOUT_MS);
182:     trace('send', { events: batch.size, buffered: this.buffer.length, dropped: this.dropped });
183:     let request: Promise<Response>;
184:     try {
185:       request = fetch(MESSAGING_METRICS_PATH, {
186:         method: 'POST',
187:         headers: { 'Content-Type': 'application/json' },
188:         body: batch.body,
189:         credentials: 'same-origin',
190:         cache: 'no-store',
191:         signal: controller?.signal,
192:       });
193:     } catch {
194:       request = Promise.reject(new Error('fetch failed'));
195:     }
196:     request
197:       .then((response) => {
198:         const status = response.status;
199:         // The body is never needed; release the connection.
200:         void response.body?.cancel().catch(() => undefined);
201:         if (status === 429) {
202:           this.pause(startedAt + OVERLOAD_PAUSE_MS);
203:         } else if (status < 200 || status >= 300) {
204:           this.pause(monotonicNow() + FAILURE_PAUSE_MS);
205:         }
206:         trace('sent', { status, events: batch.size });
207:       })
208:       .catch((error: unknown) => {
209:         const aborted = error instanceof DOMException && error.name === 'AbortError';
210:         this.pause(monotonicNow() + FAILURE_PAUSE_MS);
211:         trace('send-failed', { aborted, events: batch.size, elapsedMs: Math.round(monotonicNow() - startedAt) });
212:       })
213:       .finally(() => {
214:         clearTimeout(deadline);
215:         this.inFlight = false;
216:         this.schedule();
217:       });
218:   }
219: 
220:   private pause(until: number): void {
221:     this.nextRequestAt = Math.max(this.nextRequestAt, until);
222:   }
223: }
224: 
225: let recorder: MessagingMetricsRecorder | null = null;
226: 
227: const currentRecorder = (): MessagingMetricsRecorder | null => {
228:   if (typeof window === 'undefined') return null;
229:   recorder ??= new MessagingMetricsRecorder();
230:   return recorder;
231: };
232: 
233: /**
234:  * Records one metric event of this tab (FR-027). Synchronous, never throws,
235:  * never waits for delivery (FR-028).
236:  */
237: export function recordMessagingMetric(event: MessagingMetricEventInput): void {
238:   try {
239:     currentRecorder()?.record(event);
240:   } catch {
241:     // Metrics never affect messaging.
242:   }
243: }
244: 
245: /**
246:  * Delivers this tab's metrics while `userId` (users.id) is the messaging
247:  * user; returns the function that stops delivery for that user.
248:  */
249: export function activateMessagingMetrics(userId: string): () => void {
250:   try {
251:     currentRecorder()?.activate(userId);
252:   } catch {
253:     return () => undefined;
254:   }
255:   return () => {
256:     try {
257:       currentRecorder()?.deactivate(userId);
258:     } catch {
259:       // Metrics never affect messaging.
260:     }
261:   };
262: }

