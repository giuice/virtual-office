47: /** The user's in-app opt-in on this browser. Absent (never chosen) means off. */
48: function readPreference(userId: string): boolean {
49:   try {
50:     return window.localStorage.getItem(preferenceKey(userId)) === PREFERENCE_ON;
51:   } catch {
52:     return false;
53:   }
54: }
