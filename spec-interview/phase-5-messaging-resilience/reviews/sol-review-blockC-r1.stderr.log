123: // Ids of messages this client saw deleted through a Realtime DELETE event, per
124: // query client, bounded to the last 1000 (the oldest are forgotten first).
125: // Only three merges consult it: a create response (useMessages), a Realtime
126: // INSERT (useMessageSubscription) and the re-merge after an in-flight fetch
127: // (keepMessageThroughInflightFetch). It does not reconcile deletions this
128: // client missed (e.g. during a Realtime stream gap), and fetched pages are
129: // not filtered by it: a feed GET that read the row before it was deleted can
130: // still return it. No product path deletes stored messages today; the only
131: // deletion is a sender's own Data API delete under RLS (delete_own_messages).
132: const MAX_REMEMBERED_DELETIONS = 1000;
133: const deletedMessageIds = new WeakMap<QueryClient, Set<string>>();
134: 
135: export function markMessageDeleted(queryClient: QueryClient, messageId: string): void {
136:   let ids = deletedMessageIds.get(queryClient);
137:   if (!ids) {
138:     ids = new Set();
139:     deletedMessageIds.set(queryClient, ids);
140:   }
141:   ids.delete(messageId);
142:   ids.add(messageId);
143:   if (ids.size > MAX_REMEMBERED_DELETIONS) {
144:     const oldest = ids.values().next().value;
145:     if (oldest !== undefined) ids.delete(oldest);
146:   }
147: }
