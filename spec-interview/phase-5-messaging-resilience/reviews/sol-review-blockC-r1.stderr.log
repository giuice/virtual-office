273:  * cross-tab check-and-set runs under a Web Lock, which makes it atomic
274:  * between tabs; without Web Locks it is best effort.
275:  */
276: export async function claimMessageNotification(messageId: string): Promise<boolean> {
277:   if (!rememberTabClaim(messageId)) return false;
