105: async function clearAuthCookies(context: BrowserContext): Promise<void> {
106:   await context.clearCookies({ name: AUTH_COOKIE });
107:   expect((await context.cookies()).filter((cookie) => AUTH_COOKIE.test(cookie.name))).toEqual([]);
108: }
