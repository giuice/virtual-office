166: /**
167:  * Phase 5 FR-025 (browser-wide suppression): each tab of the user records in
168:  * localStorage, under its own key, the conversation it shows while it is
169:  * visible; a tab about to announce a message first reads every other tab's
170:  * record, synchronously. So no tab announces a conversation another visible
171:  * tab of the same user is viewing, whichever tab received the message first.
172:  * A visible tab refreshes its record (VIEW_HEARTBEAT_MS); a record older than
173:  * VIEW_TTL_MS (a tab that crashed or froze without hiding) no longer counts.
174:  */
175: const VIEW_KEY_PREFIX = 'vo:messaging:notification-view:';
176: export const VIEW_HEARTBEAT_MS = 10_000;
177: const VIEW_TTL_MS = 30_000;
