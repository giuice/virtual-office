55: /**
56:  * Replaces the outbox copies of a conversation's pending view with `items`
57:  * (in creation order), keeping the pending copies that are not outbox items
58:  * (attachment/voice sends, which are never queued).
59:  */
60: export function writeOutboxView(
61:   queryClient: QueryClient,
62:   ownerId: string,
63:   conversationId: string,
64:   items: readonly OutboxItem[]
65: ): void {
66:   const outboxCopies = [...items].sort((a, b) => a.order - b.order).map(outboxItemToPendingMessage);
67:   const outboxKeys = new Set(outboxCopies.map((message) => message.clientMessageId));
68:   queryClient.setQueryData<Message[]>(pendingMessagesQueryKey(ownerId, conversationId), (current) => {
69:     const others = (current ?? []).filter(
70:       (message) =>
71:         message.deliveryState === undefined && !outboxKeys.has(normalizeClientMessageId(message.clientMessageId) 
?? '')
72:     );
73:     if (others.length === 0) return outboxCopies;
74:     return [...others, ...outboxCopies].sort((a, b) => a.timestamp.getTime() - b.timestamp.getTime());
75:   });
76: }
