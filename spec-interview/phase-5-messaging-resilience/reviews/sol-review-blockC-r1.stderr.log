13:  *
14:  * Real accounts A and C, the real app, local Supabase. The drawer of a tab is
15:  * saved for the signed-in user (users.id) in that tab's sessionStorage
16:  * (`vo:messaging:drawer:<users.id>`, src/lib/messaging/drawer-restore.ts) and
17:  * read once, when the conversation list of a reloaded page arrives.
18:  *
19:  * "C signs in on that browser" is covered both ways a browser sees it: in the
20:  * same tab after A signed out (with the login page reloaded first, so C's
21:  * sign-in happens on a reloaded page — the one load that reads a saved
22:  * drawer), and in another tab while A's tab stays open (that tab switches to C
23:  * in place).
24:  */
25: 
26: const LIST_PATH = '/api/conversations/get';
27: /** After the list has arrived: long enough for a restore to have rendered. */
28: const SETTLE_MS = 1_500;
29: const AUTH_COOKIE = /^sb-.+-auth-token(\.\d+)?$/;
30: 
31: const drawer = (page: Page) => page.getByTestId('messaging-drawer');
32: const drawerTitle = (page: Page) => page.getByTestId('messaging-drawer-title');
33: const feed = (page: Page) => page.getByTestId('messages-feed');
34: const trigger = (page: Page) => page.getByTestId('messaging-drawer-trigger');
35: const listItem = (page: Page, conversationId: string) => page.getByTestId(`conversation-item-${conversationId}`);
36: 
37: interface ListLoad {
38:   request: Request;
39:   startedAt: number;
40:   finished: boolean;
41: }
42: 
43: /** Every conversation-list request of `page` (all its documents), with when it started. */
44: function trackListLoads(page: Page): ListLoad[] {
45:   const loads: ListLoad[] = [];
46:   const isList = (request: Request) => request.method() === 'GET' && new URL(request.url()).pathname === LIST_PATH;
47:   page.on('request', (request) => {
48:     if (isList(request)) loads.push({ request, startedAt: Date.now(), finished: false });
49:   });
50:   const finish = (request: Request) => {
51:     const load = loads.find((entry) => entry.request === request);
52:     if (load) load.finished = true;
53:   };
54:   page.on('requestfinished', finish);
55:   page.on('requestfailed', finish);
56:   return loads;
57: }
58: 
59: /** Waits until a list request that started at or after `since` has finished, then lets the page settle. */
60: async function listLoadedSince(page: Page, loads: ListLoad[], since: number): Promise<void> {
61:   await expect
62:     .poll(() => loads.some((load) => load.startedAt >= since && load.finished), { timeout: STEP_TIMEOUT_MS })
63:     .toBe(true);
64:   await page.waitForTimeout(SETTLE_MS);
65: }
66: 
67: async function reloadAndWaitForList(page: Page, loads: ListLoad[]): Promise<void> {
68:   const since = Date.now();
69:   await page.reload();
70:   await listLoadedSince(page, loads, since);
71: }
72: 
73: /** The drawer `userId` left saved in this tab (sessionStorage), or null. */
74: async function savedDrawer(page: Page, userId: string): Promise<Record<string, unknown> | null> {
75:   const raw = await page.evaluate((key) => window.sessionStorage.getItem(key), `vo:messaging:drawer:${userId}`);
76:   return raw ? (JSON.parse(raw) as Record<string, unknown>) : null;
77: }
78: 
79: async function expectDrawerClosed(page: Page): Promise<void> {
80:   await expect(drawer(page)).toHaveCount(0);
81:   await expect(trigger(page)).toBeVisible();
82: }
83: 
84: /** "Sign out" in the account menu (nothing unsent: no confirmation); ends on the login page. */
85: async function signOut(page: Page): Promise<void> {
86:   await page.getByTestId('account-menu-trigger').click();
87:   await page.getByRole('button', { name: 'Sign out', exact: true }).click();
88:   await page.waitForURL(/\/login/, { timeout: STEP_TIMEOUT_MS });
89: }
90: 
91: /** Signs in on the login page already shown (no navigation of its own, unlike fixtures `login`). */
92: async function signInOnThisPage(page: Page, user: Phase5User, loads: ListLoad[]): Promise<void> {
93:   await expect(page).toHaveURL(/\/login/);
94:   await page.getByLabel(/^email$/i).fill(user.email);
95:   await page.getByLabel(/^(password|senha)$/i).fill(user.password);
96:   const since = Date.now();
97:   await page.getByRole('button', { name: /^(sign in|entrar)$/i }).click();
98:   await page.waitForURL(/dashboard|floor-plan/, { timeout: 30_000 });
99:   await listLoadedSince(page, loads, since);
100: }
101: 
102: const navigationType = (page: Page) =>
103:   page.evaluate(() => (performance.getEntriesByType('navigation')[0] as PerformanceNavigationTiming | 
undefined)?.type ?? null);
