111: interface MetricsRequest {
112:   startedAt: number;
113:   endedAt?: number;
114:   status?: number;
115:   failure?: string;
116:   body: string;
117: }
118: 
119: /** A's metric deliveries as the page issues them, with how many were in flight at once. */
120: function trackMetricsRequests(page: Page): { requests: MetricsRequest[]; maxInFlight(): number } {
121:   const requests: MetricsRequest[] = [];
122:   const byRequest = new Map<Request, MetricsRequest>();
123:   let inFlight = 0;
124:   let maxInFlight = 0;
125:   const end = (request: Request, update: Partial<MetricsRequest>) => {
126:     const record = byRequest.get(request);
127:     if (!record || record.endedAt !== undefined) return;
128:     Object.assign(record, update, { endedAt: Date.now() });
129:     inFlight -= 1;
130:   };
131:   page.on('request', (request) => {
132:     if (request.method() !== 'POST' || new URL(request.url()).pathname !== METRICS_PATH) return;
133:     const record: MetricsRequest = { startedAt: Date.now(), body: request.postData() ?? '' };
134:     requests.push(record);
135:     byRequest.set(request, record);
136:     inFlight += 1;
137:     maxInFlight = Math.max(maxInFlight, inFlight);
138:   });
139:   // A route-fulfilled answer is reported by 'response' (its headers arrived: the request is answered).
140:   page.on('response', (response) => end(response.request(), { status: response.status() }));
141:   page.on('requestfailed', (request) => end(request, { failure: request.failure()?.errorText ?? 'failed' }));
142:   return { requests, maxInFlight: () => maxInFlight };
143: }
