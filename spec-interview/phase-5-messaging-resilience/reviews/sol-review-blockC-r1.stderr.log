134: const handleReactionUpdate = (
135:   queryClient: QueryClient,
136:   messageId: string,
137:   userId: string,
138:   emoji: string,
139:   eventType: 'INSERT' | 'DELETE',
140:   timestamp: Date
141: ) => {
142:   if (debugLogger.messaging.enabled()) {
143:     debugLogger.messaging.trace('useMessageSubscription', 'reaction:event', {
144:       messageId,
145:       emoji,
146:       eventType,
147:     });
148:   }
149: 
150:   // Update all conversation caches that might contain this message
151:   const allMessagesQueries = queryClient.getQueriesData<MessagesInfiniteData>({
152:     queryKey: ['messages'],
153:   });
154: 
155:   allMessagesQueries.forEach(([queryKey, oldData]) => {
156:     if (!oldData?.pages) return;
157: 
158:     const currentPages = oldData.pages;
159:     const nextPages = toggleReactionInPages({
160:       pages: currentPages,
161:       messageId,
162:       emoji,
163:       userId,
164:       timestamp: eventType === 'INSERT' ? timestamp : undefined,
165:       mode: eventType === 'INSERT' ? 'add' : 'remove',
166:     });
167: 
168:     if (nextPages === currentPages) {
169:       return;
170:     }
171: 
172:     queryClient.setQueryData(queryKey, {
173:       ...oldData,
174:       pages: nextPages,
175:     });
176:   });
177: };
