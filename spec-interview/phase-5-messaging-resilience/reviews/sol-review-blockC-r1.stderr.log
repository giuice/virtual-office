59: export interface OutboxSignOut {
60:   /**
61:    * Waits (at most 3 s) for the drains to stop, then deletes every item of the
62:    * owner if the browser is still signed in as the owner (F2; else deletes
63:    * nothing); rejects if the delete fails or takes more than 3 s.
64:    */
65:   discard(): Promise<void>;
66:   /** The sign-out ended (or failed): every tab's outbox follows the browser's identity again. Idempotent. */
67:   release(): void;
68: }
69: 
70: /** Whether the browser is signed in as the owner now (its users.supabase_uid), read from its session. */
71: export type OutboxOwnerCheck = () => Promise<boolean>;
72: 
73: /**
74:  * The owner's unsent outbox items in this browser (all conversations, all
75:  * tabs); 0 unless the browser is signed in as the owner (F2). Rejects when
76:  * the identity check or the read takes more than 3 s.
77:  */
78: export async function countUnsentOutboxItems(ownerId: string, isOwner: OutboxOwnerCheck): Promise<number> {
79:   if (!(await within(isOwner(), STORAGE_WAIT_MS, 'identity check'))) return 0;
80:   const items = await within(listOutboxItems(ownerId), STORAGE_WAIT_MS, 'read');
81:   // F3: a retired item is already delivered.
82:   return items.filter((item) => !item.retired).length;
83: }
84: 
85: /** Waits until no tab holds (or waits for) a drain lock of the owner, at most `maxMs`. */
86: async function waitForDrainsToStop(ownerId: string, maxMs: number): Promise<void> {
87:   const locks = typeof navigator !== 'undefined' ? navigator.locks : undefined;
88:   if (!locks) return;
89:   const prefix = outboxDrainLockPrefix(ownerId);
90:   let names: string[];
91:   try {
