39: /** The fields a metric log line may carry (BR-013; metrics-contract.ts). */
40: const METRIC_LINE_KEYS = new Set(['ts', 'appVersion', 'type', 'reason', 'conversationType', 'durationMs', 'count', 
'occurredAt']);
41: /** The fields a client event may carry. */
42: const METRIC_EVENT_KEYS = new Set(['type', 'reason', 'conversationType', 'durationMs', 'count', 'occurredAt']);
43: const METRIC_TYPES = new Set([
44:   'send_latency',
