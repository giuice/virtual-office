10: /**
11:  * What the drawer control shows:
12:  * - unsupported: the browser has no Notifications API;
13:  * - blocked: the browser permission is "denied";
14:  * - enabled: the user turned them on here and the permission is "granted";
15:  * - available: anything else (never asked, dismissed, or turned off in-app).
16:  */
17: export type DesktopNotificationStatus = 'unsupported' | 'blocked' | 'enabled' | 'available';
