110: /** Counts the tab's authorization reads that got an answer. */
111: function countAuthorizationReads(page: Page): { finished: number } {
112:   const reads = { finished: 0 };
113:   page.on('requestfinished', (request) => {
114:     if (isAuthorizationRead(new URL(request.url()))) reads.finished += 1;
115:   });
