538:  p_sender_id uuid,
539:  p_content text,
540:  p_type text,
541:  p_reply_to_id uuid,
542:  p_client_message_id uuid,
543:  p_attempt_generation bigint,
544:  p_composition jsonb,
545:  p_upload_ids uuid[]
546:)
547:returns jsonb
548:language plpgsql
549:security invoker
550:set search_path = ''
551:as $$
552:declare
553:  v_count integer;
554:  v_locked integer;
555:  v_voice integer;
556:  v_message_id uuid;
557:  v_new_id uuid := pg_catalog.gen_random_uuid();
558:  v_generation bigint;
559:  v_committed_at timestamptz;
560:begin
561:  if p_conversation_id is null or p_sender_id is null or p_content is null or p_type is null then
562:    raise exception 'create_message_attempt: conversation, sender, content and type are required'
563:      using errcode = '22004';
564:  end if;
565:  if p_attempt_generation is not null and (p_client_message_id is null or p_attempt_generation < 1) then
566:    raise exception 'ATTEMPT_GENERATION_INVALID' using errcode = '22023';
567:  end if;
568:  if p_composition is not null and (p_client_message_id is null or pg_catalog.jsonb_typeof(p_composition) <> 
'object') then
569:    raise exception 'create_message_attempt: a composition needs a client key and must be an object'
570:      using errcode = '22023';
571:  end if;
572:
573:  v_count := coalesce(pg_catalog.cardinality(p_upload_ids), 0);
574:  -- Same bound as the route's attachment policy (5 per message).
575:  if v_count > 5 then
576:    raise exception 'ATTACHMENT_COUNT_INVALID' using errcode = '22023';
577:  end if;
578:  if v_count > 0 then
579:    if (select pg_catalog.count(distinct u) from pg_catalog.unnest(p_upload_ids) as u) <> v_count then
580:      raise exception 'ATTACHMENT_DUPLICATE' using errcode = '22023';
581:    end if;
582:    -- Attachment messages are typed image or file (the only types allowed to
583:    -- carry empty content).
584:    if p_type not in ('image', 'file') then
585:      raise exception 'create_message_attempt: type must be image or file'
586:        using errcode = '22023';
587:    end if;
588:  end if;
589:
590:  -- Defense in depth: the route already required membership.
591:  if not exists (
592:    select 1
593:    from public.conversation_members cm
594:    where cm.conversation_id = p_conversation_id
595:      and cm.user_id = p_sender_id
596:  ) then
597:    raise exception 'create_message_attempt: sender is not a member of the conversation'
598:      using errcode = '42501';
599:  end if;
