157:--   create or replace function public.create_message_with_attachments(
158:--     p_conversation_id uuid,
159:--     p_sender_id uuid,
160:--     p_content text,
161:--     p_type text,
162:--     p_reply_to_id uuid,
163:--     p_client_message_id uuid,
164:--     p_upload_ids uuid[]
165:--   )
166:--   returns jsonb
167:--   language plpgsql
168:--   security invoker
169:--   set search_path = ''
170:--   as $$
171:--   declare
172:--     v_count integer;
173:--     v_locked integer;
174:--     v_voice integer;
175:--     v_message_id uuid;
176:--   begin
177:--     if p_conversation_id is null or p_sender_id is null or p_content is null or p_type is null then
178:--       raise exception 'create_message_with_attachments: conversation, sender, content and type are required'
179:--         using errcode = '22004';
180:--     end if;
181:--
182:--     v_count := coalesce(pg_catalog.cardinality(p_upload_ids), 0);
183:--     -- Same bound as the route's attachment policy (5 per message).
184:--     if v_count < 1 or v_count > 5 then
185:--       raise exception 'ATTACHMENT_COUNT_INVALID' using errcode = '22023';
186:--     end if;
187:--     if (select pg_catalog.count(distinct u) from pg_catalog.unnest(p_upload_ids) as u) <> v_count then
188:--       raise exception 'ATTACHMENT_DUPLICATE' using errcode = '22023';
189:--     end if;
190:--
191:--     -- Attachment messages are typed image or file (the only types allowed to
192:--     -- carry empty content).
193:--     if p_type not in ('image', 'file') then
194:--       raise exception 'create_message_with_attachments: type must be image or file'
195:--         using errcode = '22023';
196:--     end if;
197:--
198:--     -- A reply target must be a message of the same conversation.
199:--     if p_reply_to_id is not null and not exists (
200:--       select 1
201:--       from public.messages r
202:--       where r.id = p_reply_to_id
203:--         and r.conversation_id = p_conversation_id
204:--     ) then
205:--       raise exception 'INVALID_REPLY_TARGET' using errcode = '22023';
206:--     end if;
207:--
208:--     -- Defense in depth: the route already required membership.
209:--     if not exists (
210:--       select 1
211:--       from public.conversation_members cm
212:--       where cm.conversation_id = p_conversation_id
213:--         and cm.user_id = p_sender_id
214:--     ) then
215:--       raise exception 'create_message_with_attachments: sender is not a member of the conversation'
216:--         using errcode = '42501';
217:--     end if;
218:--
219:--     -- Replay of a composition whose create already committed: answer with the
220:--     -- stored message and link nothing (its uploads were consumed by the first
221:--     -- create).
222:--     if p_client_message_id is not null then
223:--       select m.id into v_message_id
224:--       from public.messages m
225:--       where m.sender_id = p_sender_id
226:--         and m.conversation_id = p_conversation_id
227:--         and m.client_message_id = p_client_message_id;
228:--       if v_message_id is not null then
229:--         return pg_catalog.jsonb_build_object('message_id', v_message_id, 'created', false);
230:--       end if;
231:--     end if;
232:--
233:--     -- Lock the caller's pending uploads for this conversation (id order avoids
234:--     -- deadlocks between overlapping sets). A concurrent cancel or link of the
235:--     -- same upload waits here; once it commits the row is gone.
236:--     select pg_catalog.count(*), pg_catalog.count(*) filter (where locked.duration is not null)
237:--     into v_locked, v_voice
238:--     from (
239:--       select u.id, u.duration
240:--       from public.message_attachment_uploads u
241:--       where u.id = any (p_upload_ids)
242:--         and u.uploader_id = p_sender_id
243:--         and u.conversation_id = p_conversation_id
244:--       order by u.id
245:--       for update
246:--     ) as locked;
247:--
248:--     if v_locked <> v_count then
249:--       -- A concurrent create with the same key may have consumed them.
250:--       if p_client_message_id is not null then
251:--         select m.id into v_message_id
252:--         from public.messages m
253:--         where m.sender_id = p_sender_id
254:--           and m.conversation_id = p_conversation_id
255:--           and m.client_message_id = p_client_message_id;
256:--         if v_message_id is not null then
257:--           return pg_catalog.jsonb_build_object('message_id', v_message_id, 'created', false);
258:--         end if;
259:--       end if;
260:--       -- Unknown, foreign, other-conversation, cancelled, or already linked.
261:--       raise exception 'ATTACHMENT_UPLOAD_NOT_FOUND' using errcode = '22023';
262:--     end if;
263:--
264:--     -- Phase 4 T15: a voice note is the only attachment of its message, which is
265:--     -- typed file.
266:--     if v_voice > 0 and v_count > 1 then
