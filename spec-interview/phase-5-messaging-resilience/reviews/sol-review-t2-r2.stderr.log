198:  async function lockMessageRow(messageId: string) {
199:    const holder = new Client({ connectionString: MESSAGING_DB_URL });
200:    await holder.connect();
201:    await holder.query('begin');
202:    await holder.query('select id from public.messages where id = $1 for update', [messageId]);
203:    const pid = (await holder.query<{ pid: number }>('select pg_backend_pid() as pid')).rows[0].pid;
204:    let released = false;
205:    return {
206:      pid,
207:      async release() {
208:        if (released) return;
209:        released = true;
210:        await holder.query('rollback').catch(() => undefined);
211:        await holder.end();
212:      },
213:    };
214:  }
