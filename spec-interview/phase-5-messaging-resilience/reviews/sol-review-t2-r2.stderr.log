693:  if v_message_id is null then
694:    -- Lost the race on the same key: the winner's message is committed.
695:    select m.id into v_message_id
696:    from public.messages m
697:    where m.sender_id = p_sender_id
698:      and m.conversation_id = p_conversation_id
699:      and m.client_message_id = p_client_message_id;
700:    return private.message_attempt_replay(
701:      p_sender_id, p_conversation_id, p_client_message_id, p_attempt_generation, v_message_id);
702:  end if;
703:
704:  if v_count > 0 then
705:    insert into public.message_attachments (id, message_id, name, type, size, url, duration, waveform_data)
706:    select u.id, v_message_id, u.name, u.type, u.size, u.storage_path, u.duration, u.waveform_data
707:    from public.message_attachment_uploads u
708:    where u.id = any (p_upload_ids);
709:
710:    delete from public.message_attachment_uploads u
711:    where u.id = any (p_upload_ids);
712:  end if;
713:
714:  -- Commit-time fence check (see header): lock the key row only now, after
715:  -- the INSERT, and hold it until commit.
716:  if p_client_message_id is not null then
717:    insert into private.message_send_attempts (sender_id, conversation_id, client_message_id)
718:    values (p_sender_id, p_conversation_id, p_client_message_id)
719:    on conflict (sender_id, conversation_id, client_message_id) do nothing;
720:
721:    select a.fence_generation, a.committed_at into v_generation, v_committed_at
722:    from private.message_send_attempts a
723:    where a.sender_id = p_sender_id
724:      and a.conversation_id = p_conversation_id
725:      and a.client_message_id = p_client_message_id
726:    for update;
