728:    if v_generation is not null and (p_attempt_generation is null or p_attempt_generation < v_generation) then
729:      raise exception 'ATTEMPT_SUPERSEDED' using errcode = 'P0001';
730:    end if;
731:    -- Our INSERT succeeded, so no message holds the key now: a commit
732:    -- recorded earlier means that message was deleted.
