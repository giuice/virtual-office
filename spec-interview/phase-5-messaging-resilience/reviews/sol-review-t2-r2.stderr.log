628:  if v_count > 0 then
629:    -- Lock the caller's pending uploads for this conversation (id order avoids
630:    -- deadlocks between overlapping sets). A concurrent cancel or link of the
631:    -- same upload waits here; once it commits the row is gone.
632:    select pg_catalog.count(*), pg_catalog.count(*) filter (where locked.duration is not null)
633:    into v_locked, v_voice
634:    from (
635:      select u.id, u.duration
636:      from public.message_attachment_uploads u
637:      where u.id = any (p_upload_ids)
638:        and u.uploader_id = p_sender_id
639:        and u.conversation_id = p_conversation_id
640:      order by u.id
641:      for update
642:    ) as locked;
643:
644:    if v_locked <> v_count then
645:      -- A concurrent create with the same key may have consumed them.
646:      if p_client_message_id is not null then
647:        select m.id into v_message_id
648:        from public.messages m
649:        where m.sender_id = p_sender_id
650:          and m.conversation_id = p_conversation_id
651:          and m.client_message_id = p_client_message_id;
652:        if v_message_id is not null then
653:          return private.message_attempt_replay(
654:            p_sender_id, p_conversation_id, p_client_message_id, p_attempt_generation, v_message_id);
655:        end if;
656:      end if;
657:      -- Unknown, foreign, other-conversation, cancelled, or already linked.
658:      raise exception 'ATTACHMENT_UPLOAD_NOT_FOUND' using errcode = '22023';
659:    end if;
660:
661:    -- Phase 4 T15: a voice note is the only attachment of its message, which
662:    -- is typed file.
663:    if v_voice > 0 and v_count > 1 then
664:      raise exception 'VOICE_NOTE_NOT_ALONE' using errcode = '22023';
665:    end if;
666:    if v_voice > 0 and p_type <> 'file' then
667:      raise exception 'create_message_attempt: a voice note message must be typed file'
668:        using errcode = '22023';
669:    end if;
670:  end if;
