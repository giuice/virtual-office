370:-- ============================================================================
371:-- Replay answer (internal): stored message id + its recorded composition.
372:-- A generation-carrying replay older than the key's fence generation is
373:-- refused; a generation-less replay always answers (Phase 4 contract).
374:-- ============================================================================
375:create or replace function private.message_attempt_replay(
376:  p_sender_id uuid,
377:  p_conversation_id uuid,
378:  p_client_message_id uuid,
379:  p_attempt_generation bigint,
380:  p_message_id uuid
381:)
382:returns jsonb
383:language plpgsql
384:security invoker
385:set search_path = ''
386:as $$
387:declare
388:  v_generation bigint;
389:  v_composition jsonb;
390:begin
391:  -- Delivery record (FR-006): a replay that finds a message the key row does
392:  -- not track yet records it under the key lock, so a later deletion is never
393:  -- mistaken for "not stored". A composition recorded for another message is
394:  -- discarded (it was not this message's).
395:  insert into private.message_send_attempts as a
396:    (sender_id, conversation_id, client_message_id, committed_at, message_id)
397:  values (p_sender_id, p_conversation_id, p_client_message_id, pg_catalog.now(), p_message_id)
398:  on conflict (sender_id, conversation_id, client_message_id) do update
399:    set message_id = excluded.message_id,
400:        committed_at = coalesce(a.committed_at, excluded.committed_at),
401:        composition = case when a.message_id = excluded.message_id then a.composition end,
402:        updated_at = pg_catalog.now()
403:    where a.message_id is distinct from excluded.message_id or a.committed_at is null;
404:
405:  select a.fence_generation, case when a.message_id = p_message_id then a.composition end
406:  into v_generation, v_composition
407:  from private.message_send_attempts a
408:  where a.sender_id = p_sender_id
409:    and a.conversation_id = p_conversation_id
410:    and a.client_message_id = p_client_message_id;
411:
412:  if p_attempt_generation is not null and v_generation is not null and p_attempt_generation < v_generation then
413:    raise exception 'ATTEMPT_SUPERSEDED' using errcode = 'P0001';
414:  end if;
415:
416:  return pg_catalog.jsonb_build_object(
417:    'message_id', p_message_id,
418:    'created', false,
419:    'composition', v_composition
420:  );
421:end
422:$$;
