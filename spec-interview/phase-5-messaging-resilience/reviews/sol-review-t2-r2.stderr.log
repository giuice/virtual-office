838:
839:-- No writer (clients, service role, owner) may set, change or clear a
840:-- message's key after it was inserted, nor move a keyed message to another
841:-- conversation or sender (which would carry the key outside its delivery
842:-- record): a key is only ever assigned by the INSERT that the fence guards. No
843:-- shipped build updates client_message_id, conversation_id or sender_id. The
844:-- sender FK's ON DELETE SET NULL (user deletion) stays allowed.
845:create or replace function private.reject_client_message_id_change()
846:returns trigger
847:language plpgsql
848:security invoker
849:set search_path = ''
850:as $$
851:begin
852:  raise exception 'CLIENT_MESSAGE_ID_IMMUTABLE' using errcode = '42501';
853:end
854:$$;
855:
856:comment on function private.reject_client_message_id_change() is
857:  'Phase 5 T2 trigger function: messages.client_message_id cannot change after insert, and a keyed message cannot 
move to another conversation or sender.';
858:
859:revoke all on function private.reject_client_message_id_change() from public, anon, authenticated;
860:
861:drop trigger if exists messages_client_message_id_immutable on public.messages;
862:create trigger messages_client_message_id_immutable
863:  before update of client_message_id, conversation_id, sender_id on public.messages
864:  for each row
865:  when (
866:    old.client_message_id is distinct from new.client_message_id
867:    or (
868:      old.client_message_id is not null
869:      and (
870:        old.conversation_id is distinct from new.conversation_id
871:        or (new.sender_id is not null and old.sender_id is distinct from new.sender_id)
872:      )
873:    )
874:  )
875:  execute function private.reject_client_message_id_change();
876:
877:-- Every keyed insert that does not come from create_message_attempt (an older
878:-- server build's direct service-role insert, a script) obeys the generation-
879:-- less rule at the database boundary: it commits only while the key has no
880:-- fence state (D4), and it records its delivery under the key lock. AFTER
881:-- ROW: the row exists for the message_id reference, and the key lock is held
882:-- until commit, exactly like create_message_attempt's check.
883:create or replace function private.fence_raw_keyed_message_insert()
884:returns trigger
885:language plpgsql
886:security invoker
887:set search_path = ''
888:as $$
889:declare
890:  v_generation bigint;
891:begin
892:  if pg_catalog.current_setting('virtual_office.create_message_attempt_id', true) = new.id::text then
893:    return null;
894:  end if;
895:
896:  insert into private.message_send_attempts (sender_id, conversation_id, client_message_id)
897:  values (new.sender_id, new.conversation_id, new.client_message_id)
898:  on conflict (sender_id, conversation_id, client_message_id) do nothing;
899:
900:  select a.fence_generation into v_generation
901:  from private.message_send_attempts a
902:  where a.sender_id = new.sender_id
903:    and a.conversation_id = new.conversation_id
904:    and a.client_message_id = new.client_message_id
905:  for update;
906:
907:  if v_generation is not null then
908:    raise exception 'ATTEMPT_SUPERSEDED' using errcode = 'P0001';
909:  end if;
910:
911:  update private.message_send_attempts a
912:  set committed_at = pg_catalog.now(),
913:      message_id = new.id,
914:      composition = null,
915:      updated_at = pg_catalog.now()
916:  where a.sender_id = new.sender_id
917:    and a.conversation_id = new.conversation_id
918:    and a.client_message_id = new.client_message_id;
919:  return null;
920:end
921:$$;
922:
923:comment on function private.fence_raw_keyed_message_insert() is
924:  'Phase 5 T2 trigger function: a keyed insert outside create_message_attempt commits only while its key has no 
fence state, and records its delivery.';
925:
926:revoke all on function private.fence_raw_keyed_message_insert() from public, anon, authenticated;
927:
928:drop trigger if exists messages_keyed_insert_fence on public.messages;
929:create trigger messages_keyed_insert_fence
930:  after insert on public.messages
931:  for each row
932:  when (new.client_message_id is not null and new.sender_id is not null)
933:  execute function private.fence_raw_keyed_message_insert();
934:
935:-- Delta backfill under the locks taken above: keyed rows committed between the
936:-- first backfill and the trigger's creation (normally none).
937:insert into private.message_send_attempts as a
938:  (sender_id, conversation_id, client_message_id, committed_at, message_id)
939:select m.sender_id, m.conversation_id, m.client_message_id, m.timestamp, m.id
940:from public.messages m
941:where m.client_message_id is not null
942:  and m.sender_id is not null
943:on conflict (sender_id, conversation_id, client_message_id) do update
944:  set message_id = excluded.message_id,
945:      committed_at = coalesce(a.committed_at, excluded.committed_at),
946:      composition = case when a.message_id = excluded.message_id then a.composition end,
947:      updated_at = pg_catalog.now()
948:  where a.message_id is distinct from excluded.message_id or a.committed_at is null;
949:
950:commit;

