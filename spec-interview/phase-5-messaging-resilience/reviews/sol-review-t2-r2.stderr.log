// src/lib/messaging/message-attempts.ts
// Phase 5 T2 (FR-006, FR-011, FR-024, FR-034, BR-005): request parsing and
// replay comparison shared by POST /api/messages/create and
// POST /api/messages/fence. The database enforces attempt fencing
// (public.fence_message_attempt / public.create_message_attempt); this module
// only validates input and normalizes compositions.
import type { NextResponse } from 'next/server';
import { jsonError } from '@/lib/api/server-error';
import type { ApiErrorBody } from '@/lib/api/error-contract';

const UUID_PATTERN = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;

export function isUuid(value: unknown): value is string {
  return typeof value === 'string' && UUID_PATTERN.test(value);
}

type FieldResult<T> = { ok: true; value: T } | { ok: false; response: NextResponse<ApiErrorBody> };

/**
 * Optional attempt generation: a positive safe integer. Absent → undefined
 * (Phase 4 client). It is only meaningful together with a clientMessageId.
 */
export function parseAttemptGeneration(value: unknown, hasClientKey: boolean): FieldResult<number | undefined> {
  if (value === undefined || value === null) {
    return { ok: true, value: undefined };
  }
  if (typeof value !== 'number' || !Number.isSafeInteger(value) || value < 1) {
    return {
      ok: false,
      response: jsonError(400, 'INVALID_ATTEMPT_GENERATION', 'attemptGeneration must be a positive integer'),
    };
  }
  if (!hasClientKey) {
    return {
      ok: false,
      response: jsonError(400, 'INVALID_ATTEMPT_GENERATION', 'attemptGeneration requires clientMessageId'),
    };
  }
  return { ok: true, value };
}

/**
 * Optional expected sender (users.id of the outbox item's owner, FR-011).
 * Required whenever an attempt generation is sent: every Phase 5 dispatch
 * carries both.
 */
export function parseExpectedSenderId(value: unknown, required: boolean): FieldResult<string | undefined> {
  if (value === undefined || value === null) {
    if (required) {
      return {
        ok: false,
        response: jsonError(400, 'INVALID_EXPECTED_SENDER', 'expectedSenderId is required with attemptGeneration'),
      };
    }
    return { ok: true, value: undefined };
  }
  if (!isUuid(value)) {
    return { ok: false, response: jsonError(400, 'INVALID_EXPECTED_SENDER', 'expectedSenderId must be a UUID') };
  }
  return { ok: true, value: value.toLowerCase() };
}

/**
 * Phase 5 T2: the message stored under this key was deleted since. The key's
 * item was delivered; nothing was stored and it must not be resent.
 */
export function messageDeletedResponse(): NextResponse<ApiErrorBody> {
  return jsonError(410, 'MESSAGE_DELETED', 'The message sent with this clientMessageId was deleted');
}

/** BR-005: a newer attempt of the same key exists; clients ignore this outcome. */
export function attemptSupersededResponse(): NextResponse<ApiErrorBody> {
  return jsonError(409, 'ATTEMPT_SUPERSEDED', 'A newer attempt of this clientMessageId exists');
}
// src/lib/messaging/message-composition.ts
// Phase 5 T2 (FR-024): the original submitted composition of a keyed create,
// stored in private.message_send_attempts and compared against on replay.
// Pure helpers (no server or client dependencies).
import { MessageType, type MessageComposition } from '@/types/messaging';

export function buildComposition(input: {
  content: string;
  type: MessageType | null;
  replyToId?: string;
  attachmentIds: readonly string[];
}): MessageComposition {
  return {
    content: input.content,
    type: input.type,
    replyToId: input.replyToId ?? null,
    attachmentIds: [...input.attachmentIds].sort(),
  };
}

function isStringArray(value: unknown): value is string[] {
  return Array.isArray(value) && value.every((item) => typeof item === 'string');
}

/** A composition read back from private.message_send_attempts; null when absent or malformed. */
export function parseStoredComposition(value: unknown): MessageComposition | null {
  if (typeof value !== 'object' || value === null || Array.isArray(value)) {
    return null;
  }
  const record = value as Record<string, unknown>;
  const type = record.type;
  const replyToId = record.replyToId;
  if (
    typeof record.content !== 'string' ||
    !(type === null || (typeof type === 'string' && (Object.values(MessageType) as string[]).includes(type))) ||
    !(replyToId === null || typeof replyToId === 'string') ||
    !isStringArray(record.attachmentIds)
  ) {
    return null;
  }
  return {
    content: record.content,
    type: type as MessageType | null,
    replyToId,
    attachmentIds: [...record.attachmentIds].sort(),
  };
}

function sameIds(a: readonly string[], b: readonly string[]): boolean {
  const left = [...a].sort();
  const right = [...b].sort();
  return left.length === right.length && left.every((id, index) => id === right[index]);
}

/** FR-024: an unchanged replay matches the ORIGINAL submitted composition. */
export function isSameStoredComposition(stored: MessageComposition, requested: MessageComposition): boolean {
  return (
    stored.content === requested.content &&
    stored.type === requested.type &&
    stored.replyToId === requested.replyToId &&
    sameIds(stored.attachmentIds, requested.attachmentIds)
  );
}
// src/repositories/implementations/supabase/message-attempt-rpc.ts
// Phase 5 T2: typed calls to the fenced create / fence RPCs
// (migration 20261007095045_message_send_attempt_fencing). Service role only.
import type { PostgrestError, SupabaseClient } from '@supabase/supabase-js';

import {
  AttemptSupersededError,
  MessageDeletedError,
  type ClientMessageKey,
} from '@/repositories/interfaces/IMessageRepository';
import {
  AttachmentLinkError,
  type AttachmentLinkFailureCode,
} from '@/repositories/interfaces/IMessageAttachmentUploadRepository';
import { parseStoredComposition } from '@/lib/messaging/message-composition';
import type { Message, MessageAttempt, MessageAttemptFenceResult, MessageComposition } from '@/types/messaging';

export interface CreateMessageAttemptInput {
  data: Pick<Message, 'conversationId' | 'senderId' | 'content' | 'type' | 'replyToId'>;
  clientMessageId?: string;
  attempt?: MessageAttempt;
  uploadIds: readonly string[];
}

export interface CreateMessageAttemptResult {
  messageId: string;
  created: boolean;
  storedComposition: MessageComposition | null;
}

/** Raised by the RPC call; carries the PostgREST error for caller-specific mapping. */
export class MessageAttemptRpcError extends Error {
  constructor(readonly postgrestError: PostgrestError) {
    super(postgrestError.message);
    this.name = 'MessageAttemptRpcError';
  }
}

const LINK_FAILURE_CODES: readonly AttachmentLinkFailureCode[] = [
  'ATTACHMENT_UPLOAD_NOT_FOUND',
  'ATTACHMENT_COUNT_INVALID',
  'ATTACHMENT_DUPLICATE',
  'INVALID_REPLY_TARGET',
  'VOICE_NOTE_NOT_ALONE',
];

function isRecord(value: unknown): value is Record<string, unknown> {
  return typeof value === 'object' && value !== null && !Array.isArray(value);
}

/**
 * Calls public.create_message_attempt. Throws AttemptSupersededError when the
 * attempt was fenced (nothing stored), MessageDeletedError when a
 * generation-carrying create would recreate a deleted message,
 * AttachmentLinkError for the
 * database's validation refusals (reply target, membership, uploads), and
 * MessageAttemptRpcError for anything else.
 */
export async function createMessageAttempt(
  client: SupabaseClient,
  input: CreateMessageAttemptInput
): Promise<CreateMessageAttemptResult> {
  const { data, error } = await client.rpc('create_message_attempt', {
    p_conversation_id: input.data.conversationId,
    p_sender_id: input.data.senderId,
    p_content: input.data.content,
    p_type: input.data.type,
    p_reply_to_id: input.data.replyToId ?? null,
    p_client_message_id: input.clientMessageId ?? null,
    p_attempt_generation: input.attempt?.generation ?? null,
    p_composition: input.clientMessageId && input.attempt ? input.attempt.composition : null,
    p_upload_ids: [...input.uploadIds],
  });

  if (error) {
    if (error.message === 'ATTEMPT_SUPERSEDED') {
      throw new AttemptSupersededError();
    }
    if (error.message === 'MESSAGE_DELETED') {
      throw new MessageDeletedError();
    }
    const linkFailure = LINK_FAILURE_CODES.find((code) => error.message === code);
    if (error.code === '22023' && linkFailure) {
      throw new AttachmentLinkError(linkFailure);
    }
    if (error.code === '42501') {
      throw new AttachmentLinkError('NOT_PARTICIPANT');
    }
    console.error('Error in create_message_attempt RPC:', error);
    throw new MessageAttemptRpcError(error);
  }
  if (!isRecord(data) || typeof data.message_id !== 'string' || typeof data.created !== 'boolean') {
    throw new Error('create_message_attempt returned an unexpected result');
  }
  return {
    messageId: data.message_id,
    created: data.created,
    storedComposition: data.created ? null : parseStoredComposition(data.composition),
  };
}

/** Calls public.fence_message_attempt. */
export async function fenceMessageAttempt(
  client: SupabaseClient,
  key: ClientMessageKey,
  generation: number
): Promise<MessageAttemptFenceResult> {
  const { data, error } = await client.rpc('fence_message_attempt', {
    p_sender_id: key.senderId,
    p_conversation_id: key.conversationId,
    p_client_message_id: key.clientMessageId,
    p_attempt_generation: generation,
  });

  if (error) {
    if (error.code !== '42501') {
      console.error('Error in fence_message_attempt RPC:', error);
    }
    throw new MessageAttemptRpcError(error);
  }
  if (isRecord(data)) {
    if (data.outcome === 'superseded' || data.outcome === 'not_stored') {
      return { outcome: data.outcome };
    }
    if (data.outcome === 'stored' && (typeof data.message_id === 'string' || data.message_id === null)) {
      return { outcome: 'stored', messageId: data.message_id };
    }
  }
  throw new Error('fence_message_attempt returned an unexpected result');
}
// src/app/api/messages/fence/route.ts
import { NextRequest, NextResponse } from 'next/server';
import { IMessageRepository } from '@/repositories/interfaces';
import { MessageAttemptRpcError, SupabaseMessageRepository } from '@/repositories/implementations/supabase';
import { isAuthzFailure, jsonError, requireConversationParticipant } from '@/lib/auth/authorize';
import { enforceRateLimit } from '@/lib/auth/rate-limit';
import {
  attemptSupersededResponse,
  isUuid,
  parseAttemptGeneration,
  parseExpectedSenderId,
} from '@/lib/messaging/message-attempts';

/**
 * POST /api/messages/fence — Phase 5 T2 (FR-006, FR-011, FR-034, BR-001,
 * BR-005; SPEC section 12): fence/lookup of the CALLER'S OWN composition key.
 * Body: { conversationId, clientMessageId, attemptGeneration, expectedSenderId }
 * (all required). The key is always scoped to the authenticated sender
 * (users.id resolved from the session), so another user's key is never read
 * or changed: it is simply a different (empty) key of the caller.
 *
 * 200 { outcome: 'stored', clientMessageId, attemptGeneration, message } — the
 *     key's message is committed (the item resolves as delivered); `message`
 *     is null when it was committed and has been deleted since;
 * 200 { outcome: 'not_stored', clientMessageId, attemptGeneration } — nothing
 *     is stored and no attempt older than attemptGeneration can commit any more;
 * 409 ATTEMPT_SUPERSEDED — a newer generation exists (nothing changed);
 * 403 SENDER_MISMATCH (expectedSenderId is not the authenticated user; nothing
 *     fenced), 403 NOT_PARTICIPANT (incl. a missing conversation), 401 when not
 *     signed in, 400 for malformed fields, 429 when rate limited.
 * Never creates a message.
 */
export async function POST(request: NextRequest) {
  try {
    let body: Record<string, unknown>;
    try {
      body = await request.json();
    } catch {
      return jsonError(400, 'BAD_REQUEST', 'Invalid JSON payload');
    }
    if (typeof body !== 'object' || body === null || Array.isArray(body)) {
      return jsonError(400, 'BAD_REQUEST', 'Invalid JSON payload');
    }

    if (!isUuid(body.conversationId)) {
      return jsonError(400, 'BAD_REQUEST', 'conversationId must be a UUID');
    }
    const conversationId = body.conversationId.toLowerCase();
    if (!isUuid(body.clientMessageId)) {
      return jsonError(400, 'INVALID_CLIENT_MESSAGE_ID', 'clientMessageId must be a UUID');
    }
    const clientMessageId = body.clientMessageId.toLowerCase();
    if (body.attemptGeneration === undefined || body.attemptGeneration === null) {
      return jsonError(400, 'INVALID_ATTEMPT_GENERATION', 'attemptGeneration is required');
    }
    const attemptGeneration = parseAttemptGeneration(body.attemptGeneration, true);
    if (!attemptGeneration.ok) {
      return attemptGeneration.response;
    }
    const generation = attemptGeneration.value as number;
    const expectedSenderId = parseExpectedSenderId(body.expectedSenderId, true);
    if (!expectedSenderId.ok) {
      return expectedSenderId.response;
    }

    const ctx = await requireConversationParticipant(conversationId, {
      expectedSenderId: expectedSenderId.value,
      missingConversationAsNotParticipant: true,
    });
    if (isAuthzFailure(ctx)) {
      return ctx.errorResponse;
    }
    const { serviceClient, dbUser, conversation } = ctx;

    const rateLimited = await enforceRateLimit(serviceClient, dbUser.id, 'message:fence');
    if (rateLimited) {
      return rateLimited;
    }

    const messageRepository: IMessageRepository = new SupabaseMessageRepository(serviceClient);
    let fence;
    try {
      fence = await messageRepository.fenceClientMessage(
        { senderId: dbUser.id, conversationId: conversation.id, clientMessageId },
        generation
      );
    } catch (error) {
      if (error instanceof MessageAttemptRpcError && error.postgrestError.code === '42501') {
        return jsonError(403, 'NOT_PARTICIPANT', 'You are not a participant of this conversation');
      }
      throw error;
    }

    if (fence.outcome === 'superseded') {
      return attemptSupersededResponse();
    }
    if (fence.outcome === 'not_stored') {
      return NextResponse.json(
        { outcome: 'not_stored', clientMessageId, attemptGeneration: generation },
        { status: 200 }
      );
    }

    const stored = fence.messageId ? await messageRepository.findById(fence.messageId) : null;
    if (!stored) {
      // Committed under the key and deleted since: delivered, never resent.
      return NextResponse.json(
        { outcome: 'stored', clientMessageId, attemptGeneration: generation, message: null },
        { status: 200 }
      );
    }
    return NextResponse.json(
      {
        outcome: 'stored',
        clientMessageId,
        attemptGeneration: generation,
        // Not other users' pins or stars, which findById (service client) loads.
        message: { ...stored, pins: undefined, stars: undefined, clientMessageId },
      },
      { status: 200 }
    );
  } catch (error) {
    console.error('Error fencing message attempt:', error);
    return jsonError(500, 'INTERNAL_ERROR', 'Failed to fence message attempt');
  }
}

