601:  -- Replay of a key whose create already committed: answer with the stored
602:  -- message and link nothing (its uploads were consumed by the first create).
603:  -- Checked before the reply target: an unchanged replay is compared against
604:  -- the original composition, not re-validated (FR-024), so a reply target
605:  -- deleted since does not turn it into a refusal.
606:  if p_client_message_id is not null then
607:    select m.id into v_message_id
608:    from public.messages m
609:    where m.sender_id = p_sender_id
610:      and m.conversation_id = p_conversation_id
611:      and m.client_message_id = p_client_message_id;
612:    if v_message_id is not null then
613:      return private.message_attempt_replay(
614:        p_sender_id, p_conversation_id, p_client_message_id, p_attempt_generation, v_message_id);
615:    end if;
616:  end if;
617:
618:  -- A reply target must be a message of the same conversation.
619:  if p_reply_to_id is not null and not exists (
