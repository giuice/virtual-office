672:  -- This INSERT is checked below (commit-time fence check); the
673:  -- messages_keyed_insert_fence trigger recognizes it by its pre-generated id
674:  -- and leaves it to this function. Any other keyed insert is checked by the
675:  -- trigger itself.
676:  perform pg_catalog.set_config('virtual_office.create_message_attempt_id', v_new_id::text, true);
677:  insert into public.messages (id, conversation_id, sender_id, content, type, status, reply_to_id, 
client_message_id)
678:  values (
679:    v_new_id,
680:    p_conversation_id,
681:    p_sender_id,
682:    p_content,
683:    p_type::public.message_type,
684:    'sent'::public.message_status,
685:    p_reply_to_id,
686:    p_client_message_id
687:  )
688:  on conflict (sender_id, conversation_id, client_message_id) where client_message_id is not null
689:  do nothing
690:  returning id into v_message_id;
691:  perform pg_catalog.set_config('virtual_office.create_message_attempt_id', '', true);
