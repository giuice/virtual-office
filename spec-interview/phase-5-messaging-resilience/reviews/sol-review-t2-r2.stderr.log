const { Client } = require('pg');
(async () => {
  const c = new Client({ host: '127.0.0.1', port: 54322, user: 'postgres', password: '[REDACTED_SECRET]', database: 
'postgres', connectionTimeoutMillis: 4000, query_timeout: 8000 });
  try {
    await c.connect();
    await c.query('BEGIN READ ONLY');
    const qs = {
      identity: \"select current_database(), inet_server_addr()::text, inet_server_port(), 
current_setting('server_version') as server_version, current_setting('transaction_read_only') as read_only\",
      migration: \"select version from supabase_migrations.schema_migrations where version in ('20261005004335', 
'20261005141134', '20261007095045') order by version\",
      policies: \"select policyname, cmd, roles, qual, with_check from pg_policies where schemaname = 'public' and 
tablename = 'messages'\",
      triggers: \"select t.tgname, pg_get_triggerdef(t.oid) as definition from pg_trigger t where t.tgrelid = 
'public.messages'::regclass and not t.tgisinternal order by t.tgname\",
      constraints: \"select conname, pg_get_constraintdef(oid) as definition from pg_constraint where conrelid in 
('public.messages'::regclass, 'private.message_send_attempts'::regclass) order by conrelid, conname\",
      functions: \"select n.nspname as schema, p.proname, pg_get_function_identity_arguments(p.oid) as args, 
p.prosecdef as definer, p.provolatile as volatility, p.proconfig, 
has_function_privilege('authenticated',p.oid,'EXECUTE') as authenticated_execute, 
has_function_privilege('anon',p.oid,'EXECUTE') as anon_execute, has_function_privilege('service_role',p.oid,'EXECUTE') 
as service_execute from pg_proc p join pg_namespace n on n.oid=p.pronamespace where n.nspname in 
('public','private','graphql_public') and p.prokind='f' order by n.nspname,p.proname\",
      guc_paths: \"select n.nspname as schema, p.proname, pg_get_function_identity_arguments(p.oid) as args, p.prosrc 
from pg_proc p join pg_namespace n on n.oid=p.pronamespace where n.nspname in ('public','private','graphql_public') 
and (p.prosrc ilike '%set_config%' or p.prosrc ilike '%execute %' or p.prosrc ilike '%request.headers%' or p.prosrc 
ilike '%create_message_attempt_id%' or p.prosrc ilike '%request.jwt%') order by n.nspname,p.proname\",
      role_settings: \"select r.rolname, s.setdatabase, s.setconfig from pg_db_role_setting s left join pg_roles r on 
r.oid=s.setrole\",
      exposure: \"select n.nspname, has_schema_privilege('authenticated',n.oid,'CREATE') as auth_create, 
has_schema_privilege('authenticated',n.oid,'USAGE') as auth_usage from pg_namespace n where n.nspname in 
('public','private','graphql_public','pg_catalog')\",
      grants: \"select has_table_privilege('authenticated','public.messages','INSERT') as auth_insert, 
has_table_privilege('authenticated','private.message_send_attempts','SELECT,INSERT,UPDATE') as auth_attempts, 
has_table_privilege('anon','private.message_send_attempts','SELECT,INSERT,UPDATE') as anon_attempts\",
      coverage: \"select count(*) filter (where m.client_message_id is not null and m.sender_id is not null) as keyed, 
count(*) filter (where m.client_message_id is not null and m.sender_id is null) as orphan_keyed, count(*) filter 
(where m.client_message_id is not null and m.sender_id is not null and not exists (select 1 from 
private.message_send_attempts a where a.sender_id=m.sender_id and a.conversation_id=m.conversation_id and 
a.client_message_id=m.client_message_id and a.message_id=m.id and a.committed_at is not null)) as missing_delivery 
from public.messages m\"
    };
    for (const [label, sql] of Object.entries(qs)) {
      try { console.log(JSON.stringify({label, rows:(await c.query(sql)).rows})); }
      catch (e) { console.log(JSON.stringify({label, error:e.message})); break; }
    }
    await c.query('ROLLBACK');
  } catch(e) { console.log(JSON.stringify({error:e.message})); process.exitCode=1; }
  finally { await c.end(); }
})();
