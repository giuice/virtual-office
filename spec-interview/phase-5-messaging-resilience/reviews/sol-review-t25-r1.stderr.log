 162:   private _decodeUserBroadcast(
 163:     buffer: ArrayBuffer,
 164:     view: DataView,
 165:     decoder: TextDecoder
 166:   ): {
 167:     join_ref: null
 168:     ref: null
 169:     topic: string
 170:     event: string
