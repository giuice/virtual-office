 679:         record.seq > since
 680:         && (stream === undefined || record.stream === stream)
 681:         && (direction === undefined || record.direction === direction)
 682:         && (action === undefined || record.action === action)
 683:         && (events === undefined || events.includes(record.event)),
 684:     );
 685:   }
