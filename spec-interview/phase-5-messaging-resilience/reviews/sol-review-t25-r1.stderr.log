 181:     const userEvent = decoder.decode(buffer.slice(offset, offset + userEventSize))
 182:     offset = offset + userEventSize
 183:     const metadata = decoder.decode(buffer.slice(offset, offset + metadataSize))
 184:     offset = offset + metadataSize
 185: 
 186:     const payload = buffer.slice(offset, buffer.byteLength)
 187:     const parsedPayload =
 188:       payloadEncoding === this.JSON_ENCODING ? JSON.parse(decoder.decode(payload)) : payload
 189: 
 190:     const data: { [key: string]: any } = {
 191:       type: this.BROADCAST_EVENT,
 192:       event: userEvent,
 193:       payload: parsedPayload,
 194:     }
 195: 
 196:     // Metadata is optional and always JSON encoded
 197:     if (metadataSize > 0) {
 198:       data['meta'] = JSON.parse(metadata)
 199:     }
 200: 
 201:     return { join_ref: null, ref: null, topic: topic, event: this.BROADCAST_EVENT, payload: data }
