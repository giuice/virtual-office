 404:   private log(
 405:     connection: RoutedConnection,
 406:     direction: FrameDirection,
 407:     stream: ObservedRealtimeStream,
 408:     frame: PhoenixFrame,
 409:     action: FrameAction,
 410:   ): void {
 411:     this.frameLog.push({
 412:       seq: this.next(),
 413:       at: Date.now(),
 414:       connection: connection.id,
 415:       direction,
 416:       stream,
 417:       topic: frame.topic,
 418:       event: frame.event,
 419:       joinRef: frame.joinRef,
 420:       ref: frame.ref,
 421:       action,
 422:       detail: summarize(frame),
 423:     });
 424:   }
