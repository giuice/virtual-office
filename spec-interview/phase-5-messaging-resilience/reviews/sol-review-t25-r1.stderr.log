  28:           }
  29:         }
  30:       )
  31:       .on(
  32:         'postgres_changes',
  33:         { event: 'UPDATE', schema: 'public', table: 'conversations' },
  34:         (payload) => {
  35:           const row = payload.new as any;
  36:           const participants: string[] = row?.participants ?? [];
  37:           if (participants.includes(userId)) {
  38:             queryClient.invalidateQueries({ queryKey: ['conversations', userId] });
  39:             queryClient.invalidateQueries({ queryKey: ['conversation', row.id] });
  40:           }
  41:         }
  42:       )
  43:       .on(
  44:         'postgres_changes',
  45:         { event: 'DELETE', schema: 'public', table: 'conversations' },
  46:         (payload) => {
  47:           const row = payload.old as any;
  48:           const participants: string[] = row?.participants ?? [];
  49:           if (participants.includes(userId)) {
  50:             queryClient.invalidateQueries({ queryKey: ['conversations', userId] });
  51:             queryClient.removeQueries({ queryKey: ['conversation', row.id] });
  52:           }
  53:         }
  54:       )
  55:       // Changes committed before this channel was streaming (between the
  56:       // list's first fetch and the join, or while reconnecting) never arrive
  57:       // as events, so unread counts and order would stay stale. Refetch once
  58:       // the server confirms the postgres_changes stream for each (re)join.
