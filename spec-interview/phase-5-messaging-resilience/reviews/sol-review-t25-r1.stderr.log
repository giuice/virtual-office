 613:   async settle(): Promise<void> {
 614:     await Promise.all([...this.pendingStatus]);
 615:   }
 616: 
 617:   statuses(stream: ObservedRealtimeStream, { since = 0 }: { since?: number } = {}): StatusRecord[] {
 618:     return this.statusLog
 619:       .filter((record) => record.stream === stream && record.seq > since)
 620:       .sort((left, right) => left.seq - right.seq);
 621:   }
 622: 
 623:   status(stream: ObservedRealtimeStream): string | null {
 624:     const all = this.statuses(stream);
 625:     return all.length ? all[all.length - 1].status : null;
 626:   }
 627: 
 628:   async waitForStatus(
 629:     stream: ObservedRealtimeStream,
 630:     status: string,
 631:     { since = 0, timeout = 30_000 }: { since?: number; timeout?: number } = {},
 632:   ): Promise<StatusRecord> {
 633:     let found: StatusRecord | undefined;
 634:     await expect
 635:       .poll(
 636:         () => {
 637:           found = this.statuses(stream, { since }).find((record) => record.status === status);
 638:           return found !== undefined;
 639:         },
 640:         { timeout, message: `${stream} stream reports ${status} (since #${since})` },
 641:       )
 642:       .toBe(true);
 643:     return found as StatusRecord;
 644:   }
 645: 
 646:   joinedTopics(stream: ObservedRealtimeStream): string[] {
 647:     return this.openConnections().flatMap((connection) =>
 648:       [...connection.topics]
 649:         .filter(([, state]) => state.stream === stream && state.joined)
 650:         .map(([topic]) => topic),
 651:     );
 652:   }
 653: 
 654:   async waitForReady(stream: ObservedRealtimeStream, { timeout = 30_000 }: { timeout?: number } = {}): 
Promise<void> {
 655:     await expect
 656:       .poll(
 657:         () => {
 658:           const subscribed = stream === 'presence'
 659:             ? ['SUBSCRIBED', 'RECONNECTED'].includes(this.status(stream) ?? '')
 660:             : this.status(stream) === 'SUBSCRIBED';
 661:           const joined = this.openConnections().some((connection) =>
 662:             [...connection.topics.values()].some(
 663:               (state) =>
 664:                 state.stream === stream
 665:                 && state.joined
 666:                 && (!POSTGRES_STREAMS.has(stream) || state.confirmedJoinRef === state.joinRef),
 667:             ),
 668:           );
 669:           return subscribed && joined;
 670:         },
 671:         { timeout, message: `${stream} stream joined, SUBSCRIBED and streaming` },
 672:       )
 673:       .toBe(true);
 674:   }
 675: 
 676:   frames({ stream, since = 0, direction, action, events }: FrameFilter = {}): FrameRecord[] {
 677:     return this.frameLog.filter(
