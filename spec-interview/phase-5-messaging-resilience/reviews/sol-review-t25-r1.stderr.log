 134:       const frame: unknown = JSON.parse(message);
 135:       if (Array.isArray(frame) && frame.length === 5 && typeof frame[2] === 'string' && typeof frame[3] === 
'string') {
 136:         const [joinRef, ref, topic, event, payload] = frame as [unknown, unknown, string, string, unknown];
 137:         return {
 138:           joinRef: typeof joinRef === 'string' ? joinRef : null,
 139:           ref: typeof ref === 'string' ? ref : null,
 140:           topic,
 141:           event,
 142:           payload,
 143:           binary: false,
 144:         };
 145:       }
 146:     } catch {
 147:       // Not a Phoenix JSON frame.
 148:     }
 149:     return null;
 150:   }
 151:   if (message.length < 1) return null;
 152:   const kind = message.readUInt8(0);
 153:   // Server â†’ client user broadcast: kind 4, [topic, event, meta] sizes, encoding.
 154:   if (direction === 'in' && kind === 4 && message.length >= 5) {
 155:     const topicSize = message.readUInt8(1);
 156:     const eventSize = message.readUInt8(2);
 157:     const offset = 5;
 158:     return {
 159:       joinRef: null,
 160:       ref: null,
 161:       topic: message.toString('utf8', offset, offset + topicSize),
 162:       event: 'broadcast',
 163:       payload: { event: message.toString('utf8', offset + topicSize, offset + topicSize + eventSize) },
 164:       binary: true,
 165:     };
 166:   }
 167:   // Client â†’ server user broadcast push: kind 3, [joinRef, ref, topic, event, meta] sizes, encoding.
 168:   if (direction === 'out' && kind === 3 && message.length >= 7) {
 169:     const joinRefSize = message.readUInt8(1);
 170:     const refSize = message.readUInt8(2);
 171:     const topicSize = message.readUInt8(3);
 172:     const eventSize = message.readUInt8(4);
 173:     let offset = 7;
 174:     const joinRef = message.toString('utf8', offset, offset + joinRefSize);
 175:     offset += joinRefSize;
 176:     const ref = message.toString('utf8', offset, offset + refSize);
 177:     offset += refSize;
 178:     const topic = message.toString('utf8', offset, offset + topicSize);
 179:     offset += topicSize;
 180:     return {
 181:       joinRef: joinRef || null,
 182:       ref: ref || null,
 183:       topic,
 184:       event: 'broadcast',
 185:       payload: { event: message.toString('utf8', offset, offset + eventSize) },
 186:       binary: true,
 187:     };
 188:   }
 189:   return null;
 190: }
 191: 
 192: const encodeFrame = (frame: [string | null, string | null, string, string, unknown]): string => 
JSON.stringify(frame);
 193: 
 194: /** Identifying, content-free summary of a frame for the log. */
 195: function summarize(frame: PhoenixFrame): FrameDetail {
 196:   const payload = (frame.payload ?? {}) as Record<string, unknown>;
 197:   const detail: FrameDetail = {};
 198:   if (typeof payload.status === 'string') detail.status = payload.status;
 199:   if (typeof payload.extension === 'string') detail.extension = payload.extension;
 200:   if (frame.event === 'broadcast' && typeof payload.event === 'string') detail.broadcastEvent = payload.event;
 201:   if (frame.event === 'postgres_changes') {
 202:     const data = (payload.data ?? {}) as Record<string, unknown>;
 203:     if (typeof data.table === 'string') detail.table = data.table;
 204:     if (typeof data.type === 'string') detail.type = data.type;
 205:     const record = (data.record ?? data.old_record ?? {}) as Record<string, unknown>;
 206:     if (typeof record.id === 'string') detail.recordId = record.id;
 207:   }
 208:   return detail;
 209: }
 210: 
 211: // ---------------------------------------------------------------------------
 212: // Records
 213: // ---------------------------------------------------------------------------
 214: 
 215: export interface FrameDetail {
 216:   status?: string;
 217:   extension?: string;
 218:   broadcastEvent?: string;
 219:   table?: string;
 220:   type?: string;
 221:   recordId?: string;
 222: }
 223: 
 224: /**
 225:  * pass: forwarded unchanged; drop: withheld by the active fault;
 226:  * inject: produced by the harness toward the page; inject-server: produced by
 227:  * the harness toward the server.
 228:  */
 229: export type FrameAction = 'pass' | 'drop' | 'inject' | 'inject-server';
 230: 
 231: export interface FrameRecord {
 232:   seq: number;
 233:   at: number;
 234:   connection: number;
 235:   direction: FrameDirection;
 236:   stream: ObservedRealtimeStream;
 237:   topic: string;
 238:   event: string;
 239:   joinRef: string | null;
 240:   ref: string | null;
 241:   action: FrameAction;
 242:   detail: FrameDetail;
 243: }
 244: 
 245: export interface StatusRecord {
 246:   seq: number;
 247:   at: number;
 248:   stream: ObservedRealtimeStream;
 249:   status: string;
 250:   page: string;
 251:   /** typing: the conversation of the channel. */
 252:   conversationId?: string;
 253: }
 254: 
 255: export interface ConnectionRecord {
 256:   id: number;
 257:   openedSeq: number;
 258:   closedSeq: number | null;
 259: }
 260: 
 261: export interface FaultKick {
 262:   /** Sequence point taken just before the fault was armed. */
 263:   mark: number;
 264:   /** Joined channels of the stream that were kicked. */
 265:   kicked: number;
 266: }
 267: 
 268: export interface FrameFilter {
 269:   stream?: ObservedRealtimeStream;
 270:   since?: number;
 271:   direction?: FrameDirection;
 272:   action?: FrameAction;
 273:   events?: readonly string[];
 274: }
 275: 
 276: export interface RealtimeFaultController {
 277:   fail(stream: MessagingRealtimeStream, kind: RealtimeFaultKind): Promise<FaultKick>;
 278:   restore(stream?: MessagingRealtimeStream): number;
 279:   activeFaults(): Array<{ stream: MessagingRealtimeStream; kind: RealtimeFaultKind; joinAttempts: number }>;
 280:   mark(): number;
 281:   status(stream: ObservedRealtimeStream): string | null;
 282:   statuses(stream: ObservedRealtimeStream, options?: { since?: number }): StatusRecord[];
 283:   waitForStatus(
 284:     stream: ObservedRealtimeStream,
 285:     status: string,
 286:     options?: { since?: number; timeout?: number },
 287:   ): Promise<StatusRecord>;
 288:   waitForReady(stream: ObservedRealtimeStream, options?: { timeout?: number }): Promise<void>;
 289:   frames(filter?: FrameFilter): FrameRecord[];
 290:   /** Joined topics of the stream on the open sockets. */
 291:   joinedTopics(stream: ObservedRealtimeStream): string[];
 292:   connections(): ConnectionRecord[];
 293:   /** Waits for console status values still being read from the page. */
 294:   settle(): Promise<void>;
 295:   watchPage(page: Page, label: string): void;
 296:   /** Refused non-loopback Realtime hosts and frames the harness failed to handle (must stay empty). */
 297:   violations(): string[];
 298: }
 299: 
 300: // ---------------------------------------------------------------------------
 301: // Controller
 302: // ---------------------------------------------------------------------------
 303: 
 304: interface TopicState {
 305:   stream: ObservedRealtimeStream;
 306:   /** Join ref (= ref) of the latest phx_join of this topic. */
 307:   joinRef: string | null;
 308:   joined: boolean;
 309:   /** Latest join confirmed by the server's postgres_changes `system` ok. */
 310:   confirmedJoinRef: string | null;
 311:   /** Join being closed by the harness's real-server close. */
 312:   closingJoinRef: string | null;
 313: }
 314: 
 315: interface RoutedConnection {
 316:   id: number;
 317:   page: WebSocketRoute;
 318:   server: WebSocketRoute;
 319:   topics: Map<string, TopicState>;
 320:   record: ConnectionRecord;
 321: }
 322: 
 323: interface ActiveFault {
 324:   kind: RealtimeFaultKind;
 325:   since: number;
 326:   joinAttempts: number;
 327: }
 328: 
 329: const STATUS_TRACE = /^\[(useMessageSubscription|useConversationRealtime|useConversationPresence):trace\] 
status\b/;
 330: const TRACE_STREAM: Record<string, MessagingRealtimeStream> = {
 331:   useMessageSubscription: 'messages',
 332:   useConversationRealtime: 'list',
 333:   useConversationPresence: 'typing',
 334: };
 335: const PRESENCE_EVENT_PREFIX = '{"schema":"presence-observability-v1"';
 336: 
 337: class FaultHarness implements RealtimeFaultController {
 338:   private seq = 0;
 339:   private readonly frameLog: FrameRecord[] = [];
 340:   private readonly statusLog: StatusRecord[] = [];
 341:   private readonly pendingStatus = new Set<Promise<void>>();
 342:   private readonly faults = new Map<MessagingRealtimeStream, ActiveFault>();
 343:   private readonly routed: RoutedConnection[] = [];
 344:   private readonly refused: string[] = [];
 345:   private readonly internalErrors: string[] = [];
 346:   private readonly harnessRefs = new Set<string>();
 347:   private harnessRefCounter = 0;
 348: 
 349:   next(): number {
 350:     this.seq += 1;
 351:     return this.seq;
 352:   }
 353: 
 354:   mark(): number {
 355:     return this.next();
 356:   }
 357: 
 358:   // --- routing -------------------------------------------------------------
 359: 
 360:   route(ws: WebSocketRoute): void {
 361:     if (!isLoopbackUrl(ws.url())) {
 362:       this.refused.push(new URL(ws.url()).host);
 363:       void ws.close({ code: 4001, reason: 'test: only local Realtime is allowed' });
 364:       return;
 365:     }
 366:     const server = ws.connectToServer();
 367:     const connection: RoutedConnection = {
 368:       id: this.routed.length + 1,
 369:       page: ws,
 370:       server,
 371:       topics: new Map(),
 372:       record: { id: this.routed.length + 1, openedSeq: this.next(), closedSeq: null },
 373:     };
 374:     this.routed.push(connection);
 375:     ws.onMessage((message) => this.fromPage(connection, message));
 376:     server.onMessage((message) => this.fromServer(connection, message));
 377:     // Setting close handlers disables Playwright's automatic forwarding:
 378:     // forward the close both ways, unchanged.
 379:     ws.onClose((code, reason) => {
 380:       this.closeConnection(connection);
 381:       void server.close({ code, reason });
 382:     });
 383:     server.onClose((code, reason) => {
 384:       this.closeConnection(connection);
 385:       void ws.close({ code, reason });
 386:     });
 387:   }
 388: 
 389:   private closeConnection(connection: RoutedConnection): void {
 390:     if (connection.record.closedSeq === null) {
 391:       connection.record.closedSeq = this.next();
 392:     }
 393:   }
 394: 
 395:   private topicState(connection: RoutedConnection, topic: string, stream: ObservedRealtimeStream): TopicState {
 396:     let state = connection.topics.get(topic);
 397:     if (!state) {
 398:       state = { stream, joinRef: null, joined: false, confirmedJoinRef: null, closingJoinRef: null };
 399:       connection.topics.set(topic, state);
 400:     }
 401:     return state;
 402:   }
 403: 
 404:   private log(
 405:     connection: RoutedConnection,
 406:     direction: FrameDirection,
 407:     stream: ObservedRealtimeStream,
 408:     frame: PhoenixFrame,
 409:     action: FrameAction,
 410:   ): void {
 411:     this.frameLog.push({
 412:       seq: this.next(),
 413:       at: Date.now(),
 414:       connection: connection.id,
 415:       direction,
 416:       stream,
 417:       topic: frame.topic,
 418:       event: frame.event,
 419:       joinRef: frame.joinRef,
 420:       ref: frame.ref,
 421:       action,
 422:       detail: summarize(frame),
 423:     });
 424:   }
 425: 
 426:   /** Page â†’ server: always forwarded unchanged; joins are tracked. */
 427:   private fromPage(connection: RoutedConnection, message: string | Buffer): void {
 428:     connection.server.send(message);
 429:     try {
 430:       this.trackPageFrame(connection, message);
 431:     } catch (error) {
 432:       this.internalErrors.push(`page frame: ${String(error)}`);
 433:     }
 434:   }
 435: 
 436:   private trackPageFrame(connection: RoutedConnection, message: string | Buffer): void {
 437:     const frame = decodeFrame(message, 'out');
 438:     const stream = frame ? classifyRealtimeTopic(frame.topic) : null;
 439:     if (!frame || !stream) return;
 440:     this.log(connection, 'out', stream, frame, 'pass');
 441:     const state = this.topicState(connection, frame.topic, stream);
 442:     if (frame.event === 'phx_join') {
 443:       state.joinRef = frame.ref;
 444:       state.joined = false;
 445:       state.confirmedJoinRef = null;
 446:       state.closingJoinRef = null;
 447:       const fault = isMessagingStream(stream) ? this.faults.get(stream) : undefined;
 448:       if (fault) {
 449:         fault.joinAttempts += 1;
 450:         if (fault.kind === 'error') {
 451:           this.injectToPage(connection, stream, [
 452:             frame.ref,
 453:             frame.ref,
 454:             frame.topic,
 455:             'phx_reply',
 456:             { status: 'error', response: { reason: ERROR_REPLY_REASON } },
 457:           ]);
 458:         }
 459:         // 'timeout' and 'close': the server's reply is withheld (fromServer).
 460:       }
 461:     } else if (frame.event === 'phx_leave' && frame.joinRef === state.joinRef) {
 462:       state.joined = false;
 463:     }
 464:   }
 465: 
 466:   /** Server â†’ page: forwarded unless it belongs to a faulted stream. */
 467:   private fromServer(connection: RoutedConnection, message: string | Buffer): void {
 468:     let forward = true;
 469:     try {
 470:       forward = this.shapeServerFrame(connection, message);
 471:     } catch (error) {
 472:       // Fail open: a frame the harness cannot handle reaches the page unchanged.
 473:       this.internalErrors.push(`server frame: ${String(error)}`);
 474:     }
 475:     if (forward) connection.page.send(message);
 476:   }
 477: 
 478:   /** Returns whether the server frame is forwarded to the page. */
 479:   private shapeServerFrame(connection: RoutedConnection, message: string | Buffer): boolean {
 480:     const frame = decodeFrame(message, 'in');
 481:     const stream = frame ? classifyRealtimeTopic(frame.topic) : null;
 482:     if (!frame || !stream) return true;
 483:     if (frame.event === 'phx_reply' && frame.ref !== null && this.harnessRefs.has(frame.ref)) {
 484:       // Reply to the harness's own push: never the page's business.
 485:       this.log(connection, 'in', stream, frame, 'drop');
 486:       return false;
 487:     }
 488:     const state = this.topicState(connection, frame.topic, stream);
 489:     const fault = isMessagingStream(stream) ? this.faults.get(stream) : undefined;
 490:     const isServerClose =
 491:       state.closingJoinRef !== null
 492:       && frame.joinRef === state.closingJoinRef
 493:       && (frame.event === 'phx_close' || frame.event === 'system');
 494:     if (fault && !isServerClose) {
 495:       this.log(connection, 'in', stream, frame, 'drop');
 496:       return false;
 497:     }
 498:     const sameJoin = frame.joinRef !== null && frame.joinRef === state.joinRef;
 499:     if (frame.event === 'phx_reply' && frame.ref !== null && frame.ref === state.joinRef) {
 500:       state.joined = (frame.payload as { status?: unknown } | null)?.status === 'ok';
 501:     } else if ((frame.event === 'phx_close' || frame.event === 'phx_error') && sameJoin) {
 502:       state.joined = false;
 503:     } else if (frame.event === 'system' && sameJoin) {
 504:       const body = (frame.payload ?? {}) as { extension?: unknown; status?: unknown };
 505:       if (body.extension === 'postgres_changes' && body.status === 'ok') {
 506:         state.confirmedJoinRef = frame.joinRef;
 507:       }
 508:     }
 509:     this.log(connection, 'in', stream, frame, 'pass');
 510:     return true;
 511:   }
 512: 
 513:   private injectToPage(
 514:     connection: RoutedConnection,
 515:     stream: ObservedRealtimeStream,
 516:     frame: [string | null, string | null, string, string, unknown],
 517:   ): void {
 518:     const encoded = encodeFrame(frame);
 519:     connection.page.send(encoded);
 520:     this.log(connection, 'in', stream, decodeFrame(encoded, 'in') as PhoenixFrame, 'inject');
 521:   }
 522: 
 523:   private openConnections(): RoutedConnection[] {
 524:     return this.routed.filter((connection) => connection.record.closedSeq === null);
 525:   }
 526: 
 527:   // --- faults --------------------------------------------------------------
 528: 
 529:   async fail(stream: MessagingRealtimeStream, kind: RealtimeFaultKind): Promise<FaultKick> {
 530:     if (this.faults.has(stream)) {
 531:       throw new Error(`The ${stream} stream is already faulted; restore it first.`);
 532:     }
 533:     const mark = this.mark();
 534:     this.faults.set(stream, { kind, since: mark, joinAttempts: 0 });
 535:     let kicked = 0;
 536:     for (const connection of this.openConnections()) {
 537:       for (const [topic, state] of connection.topics) {
 538:         if (state.stream !== stream || !state.joined || state.joinRef === null) continue;
 539:         kicked += 1;
 540:         if (kind === 'close') {
 541:           // Real server close: Realtime re-validates the channel's token,
 542:           // pushes `system` error + `phx_close`, and ends the server channel.
 543:           this.harnessRefCounter += 1;
 544:           const ref = `t25-close-${this.harnessRefCounter}`;
 545:           this.harnessRefs.add(ref);
 546:           state.closingJoinRef = state.joinRef;
 547:           const encoded = encodeFrame([state.joinRef, ref, topic, 'access_token', { access_token: 
INVALID_ACCESS_TOKEN }]);
 548:           connection.server.send(encoded);
 549:           this.log(connection, 'out', stream, decodeFrame(encoded, 'out') as PhoenixFrame, 'inject-server');
 550:         } else {
 551:           state.joined = false;
 552:           this.injectToPage(connection, stream, [state.joinRef, state.joinRef, topic, 'phx_error', {}]);
 553:         }
 554:       }
 555:     }
 556:     return { mark, kicked };
 557:   }
 558: 
 559:   restore(stream?: MessagingRealtimeStream): number {
 560:     if (stream) {
 561:       this.faults.delete(stream);
 562:     } else {
 563:       this.faults.clear();
 564:     }
 565:     return this.mark();
 566:   }
 567: 
 568:   activeFaults() {
 569:     return [...this.faults].map(([stream, fault]) => ({ stream, kind: fault.kind, joinAttempts: 
fault.joinAttempts }));
 570:   }
 571: 
 572:   // --- observation ---------------------------------------------------------
 573: 
 574:   watchPage(page: Page, label: string): void {
 575:     page.on('console', (message) => this.onConsole(message, label));
 576:   }
 577: 
 578:   private onConsole(message: ConsoleMessage, label: string): void {
 579:     const text = message.text();
 580:     const trace = STATUS_TRACE.exec(text);
 581:     if (trace) {
 582:       const seq = this.next();
 583:       const at = Date.now();
 584:       const stream = TRACE_STREAM[trace[1]];
 585:       const read = (async () => {
 586:         const value = (await message.args()[1]?.jsonValue()) as { status?: unknown; conversationId?: unknown } | 
undefined;
 587:         if (typeof value?.status !== 'string') return;
 588:         this.statusLog.push({
 589:           seq,
 590:           at,
 591:           stream,
 592:           status: value.status,
 593:           page: label,
 594:           ...(typeof value.conversationId === 'string' ? { conversationId: value.conversationId } : {}),
 595:         });
 596:       })().catch(() => {});
 597:       this.pendingStatus.add(read);
 598:       void read.finally(() => this.pendingStatus.delete(read));
 599:       return;
 600:     }
 601:     if (text.startsWith(PRESENCE_EVENT_PREFIX)) {
 602:       try {
 603:         const event = JSON.parse(text) as { category?: unknown; action?: unknown; resultCode?: unknown };
 604:         if (event.category === 'realtime' && event.action === 'subscription' && typeof event.resultCode === 
'string') {
 605:           this.statusLog.push({ seq: this.next(), at: Date.now(), stream: 'presence', status: event.resultCode, 
page: label });
 606:         }
 607:       } catch {
 608:         // Not a complete observability line.
 609:       }
 610:     }
 611:   }
 612: 
 613:   async settle(): Promise<void> {
 614:     await Promise.all([...this.pendingStatus]);
 615:   }
 616: 
 617:   statuses(stream: ObservedRealtimeStream, { since = 0 }: { since?: number } = {}): StatusRecord[] {
 618:     return this.statusLog
 619:       .filter((record) => record.stream === stream && record.seq > since)
 620:       .sort((left, right) => left.seq - right.seq);
 621:   }
 622: 
 623:   status(stream: ObservedRealtimeStream): string | null {
 624:     const all = this.statuses(stream);
 625:     return all.length ? all[all.length - 1].status : null;
 626:   }
 627: 
 628:   async waitForStatus(
 629:     stream: ObservedRealtimeStream,
 630:     status: string,
 631:     { since = 0, timeout = 30_000 }: { since?: number; timeout?: number } = {},
 632:   ): Promise<StatusRecord> {
 633:     let found: StatusRecord | undefined;
 634:     await expect
 635:       .poll(
 636:         () => {
 637:           found = this.statuses(stream, { since }).find((record) => record.status === status);
 638:           return found !== undefined;
 639:         },
 640:         { timeout, message: `${stream} stream reports ${status} (since #${since})` },
 641:       )
 642:       .toBe(true);
 643:     return found as StatusRecord;
 644:   }
 645: 
 646:   joinedTopics(stream: ObservedRealtimeStream): string[] {
 647:     return this.openConnections().flatMap((connection) =>
 648:       [...connection.topics]
 649:         .filter(([, state]) => state.stream === stream && state.joined)
 650:         .map(([topic]) => topic),
 651:     );
 652:   }
 653: 
 654:   async waitForReady(stream: ObservedRealtimeStream, { timeout = 30_000 }: { timeout?: number } = {}): 
Promise<void> {
 655:     await expect
 656:       .poll(
 657:         () => {
 658:           const subscribed = stream === 'presence'
 659:             ? ['SUBSCRIBED', 'RECONNECTED'].includes(this.status(stream) ?? '')
 660:             : this.status(stream) === 'SUBSCRIBED';
 661:           const joined = this.openConnections().some((connection) =>
 662:             [...connection.topics.values()].some(
 663:               (state) =>
 664:                 state.stream === stream
 665:                 && state.joined
 666:                 && (!POSTGRES_STREAMS.has(stream) || state.confirmedJoinRef === state.joinRef),
 667:             ),
 668:           );
 669:           return subscribed && joined;
 670:         },
 671:         { timeout, message: `${stream} stream joined, SUBSCRIBED and streaming` },
 672:       )
 673:       .toBe(true);
 674:   }
 675: 
 676:   frames({ stream, since = 0, direction, action, events }: FrameFilter = {}): FrameRecord[] {
 677:     return this.frameLog.filter(
 678:       (record) =>
 679:         record.seq > since
 680:         && (stream === undefined || record.stream === stream)
 681:         && (direction === undefined || record.direction === direction)
 682:         && (action === undefined || record.action === action)
 683:         && (events === undefined || events.includes(record.event)),
 684:     );
 685:   }
 686: 
 687:   connections(): ConnectionRecord[] {
 688:     return this.routed.map((connection) => ({ ...connection.record }));
 689:   }
 690: 
 691:   violations(): string[] {
 692:     return [...this.refused.map((host) => `refused non-loopback Realtime host ${host}`), ...this.internalErrors];
 693:   }
 694: }
 695: 
 696: /**
 697:  * Routes the context's Realtime sockets through a fault harness and records
 698:  * the page's subscribe-callback statuses. With `reload` (default) the page is
 699:  * reloaded so its socket is created under the route.
 700:  */
 701: export async function attachRealtimeFaultHarness(
 702:   context: BrowserContext,
 703:   page: Page,
 704:   label: string,
 705:   { reload = true }: { reload?: boolean } = {},
 706: ): Promise<RealtimeFaultController> {
 707:   const harness = new FaultHarness();
 708:   await context.routeWebSocket(/\/realtime\/v1\/websocket/, (ws) => harness.route(ws));
 709:   await context.addInitScript((key) => {
 710:     try {
 711:       window.localStorage.setItem(key, '1');
 712:     } catch {
 713:       // Storage unavailable: the dev server enables the traces by default.
 714:     }
 715:   }, MESSAGING_DEBUG_FLAG_KEY);
 716:   harness.watchPage(page, label);
 717:   if (reload && page.url() !== 'about:blank') {
 718:     await page.reload();
 719:   }
 720:   return harness;
 721: }

