 574:   watchPage(page: Page, label: string): void {
 575:     page.on('console', (message) => this.onConsole(message, label));
 576:   }
 577: 
 578:   private onConsole(message: ConsoleMessage, label: string): void {
 579:     const text = message.text();
 580:     const trace = STATUS_TRACE.exec(text);
 581:     if (trace) {
 582:       const seq = this.next();
 583:       const at = Date.now();
 584:       const stream = TRACE_STREAM[trace[1]];
 585:       const read = (async () => {
 586:         const value = (await message.args()[1]?.jsonValue()) as { status?: unknown; conversationId?: unknown } | 
undefined;
 587:         if (typeof value?.status !== 'string') return;
 588:         this.statusLog.push({
 589:           seq,
 590:           at,
 591:           stream,
 592:           status: value.status,
 593:           page: label,
 594:           ...(typeof value.conversationId === 'string' ? { conversationId: value.conversationId } : {}),
 595:         });
 596:       })().catch(() => {});
 597:       this.pendingStatus.add(read);
 598:       void read.finally(() => this.pendingStatus.delete(read));
 599:       return;
 600:     }
 601:     if (text.startsWith(PRESENCE_EVENT_PREFIX)) {
 602:       try {
 603:         const event = JSON.parse(text) as { category?: unknown; action?: unknown; resultCode?: unknown };
 604:         if (event.category === 'realtime' && event.action === 'subscription' && typeof event.resultCode === 
'string') {
 605:           this.statusLog.push({ seq: this.next(), at: Date.now(), stream: 'presence', status: event.resultCode, 
page: label });
 606:         }
 607:       } catch {
 608:         // Not a complete observability line.
 609:       }
 610:     }
 611:   }
