 426:   /** Page â†’ server: always forwarded unchanged; joins are tracked. */
 427:   private fromPage(connection: RoutedConnection, message: string | Buffer): void {
 428:     connection.server.send(message);
 429:     try {
 430:       this.trackPageFrame(connection, message);
 431:     } catch (error) {
 432:       this.internalErrors.push(`page frame: ${String(error)}`);
 433:     }
 434:   }
 435: 
 436:   private trackPageFrame(connection: RoutedConnection, message: string | Buffer): void {
 437:     const frame = decodeFrame(message, 'out');
 438:     const stream = frame ? classifyRealtimeTopic(frame.topic) : null;
 439:     if (!frame || !stream) return;
 440:     this.log(connection, 'out', stream, frame, 'pass');
 441:     const state = this.topicState(connection, frame.topic, stream);
 442:     if (frame.event === 'phx_join') {
 443:       state.joinRef = frame.ref;
 444:       state.joined = false;
 445:       state.confirmedJoinRef = null;
 446:       state.closingJoinRef = null;
 447:       const fault = isMessagingStream(stream) ? this.faults.get(stream) : undefined;
 448:       if (fault) {
 449:         fault.joinAttempts += 1;
 450:         if (fault.kind === 'error') {
 451:           this.injectToPage(connection, stream, [
 452:             frame.ref,
 453:             frame.ref,
 454:             frame.topic,
 455:             'phx_reply',
 456:             { status: 'error', response: { reason: ERROR_REPLY_REASON } },
 457:           ]);
 458:         }
 459:         // 'timeout' and 'close': the server's reply is withheld (fromServer).
 460:       }
 461:     } else if (frame.event === 'phx_leave' && frame.joinRef === state.joinRef) {
 462:       state.joined = false;
 463:     }
 464:   }
 465: 
 466:   /** Server â†’ page: forwarded unless it belongs to a faulted stream. */
 467:   private fromServer(connection: RoutedConnection, message: string | Buffer): void {
 468:     let forward = true;
 469:     try {
 470:       forward = this.shapeServerFrame(connection, message);
 471:     } catch (error) {
 472:       // Fail open: a frame the harness cannot handle reaches the page unchanged.
 473:       this.internalErrors.push(`server frame: ${String(error)}`);
 474:     }
 475:     if (forward) connection.page.send(message);
 476:   }
 477: 
 478:   /** Returns whether the server frame is forwarded to the page. */
 479:   private shapeServerFrame(connection: RoutedConnection, message: string | Buffer): boolean {
 480:     const frame = decodeFrame(message, 'in');
 481:     const stream = frame ? classifyRealtimeTopic(frame.topic) : null;
 482:     if (!frame || !stream) return true;
 483:     if (frame.event === 'phx_reply' && frame.ref !== null && this.harnessRefs.has(frame.ref)) {
 484:       // Reply to the harness's own push: never the page's business.
 485:       this.log(connection, 'in', stream, frame, 'drop');
 486:       return false;
 487:     }
 488:     const state = this.topicState(connection, frame.topic, stream);
 489:     const fault = isMessagingStream(stream) ? this.faults.get(stream) : undefined;
 490:     const isServerClose =
 491:       state.closingJoinRef !== null
 492:       && frame.joinRef === state.closingJoinRef
 493:       && (frame.event === 'phx_close' || frame.event === 'system');
 494:     if (fault && !isServerClose) {
 495:       this.log(connection, 'in', stream, frame, 'drop');
 496:       return false;
 497:     }
 498:     const sameJoin = frame.joinRef !== null && frame.joinRef === state.joinRef;
 499:     if (frame.event === 'phx_reply' && frame.ref !== null && frame.ref === state.joinRef) {
 500:       state.joined = (frame.payload as { status?: unknown } | null)?.status === 'ok';
 501:     } else if ((frame.event === 'phx_close' || frame.event === 'phx_error') && sameJoin) {
 502:       state.joined = false;
 503:     } else if (frame.event === 'system' && sameJoin) {
 504:       const body = (frame.payload ?? {}) as { extension?: unknown; status?: unknown };
 505:       if (body.extension === 'postgres_changes' && body.status === 'ok') {
 506:         state.confirmedJoinRef = frame.joinRef;
 507:       }
 508:     }
 509:     this.log(connection, 'in', stream, frame, 'pass');
 510:     return true;
 511:   }
 512: 
 513:   private injectToPage(
 514:     connection: RoutedConnection,
 515:     stream: ObservedRealtimeStream,
 516:     frame: [string | null, string | null, string, string, unknown],
 517:   ): void {
 518:     const encoded = encodeFrame(frame);
 519:     connection.page.send(encoded);
 520:     this.log(connection, 'in', stream, decodeFrame(encoded, 'in') as PhoenixFrame, 'inject');
 521:   }
 522: 
 523:   private openConnections(): RoutedConnection[] {
 524:     return this.routed.filter((connection) => connection.record.closedSeq === null);
 525:   }
 526: 
 527:   // --- faults --------------------------------------------------------------
 528: 
 529:   async fail(stream: MessagingRealtimeStream, kind: RealtimeFaultKind): Promise<FaultKick> {
 530:     if (this.faults.has(stream)) {
 531:       throw new Error(`The ${stream} stream is already faulted; restore it first.`);
 532:     }
 533:     const mark = this.mark();
 534:     this.faults.set(stream, { kind, since: mark, joinAttempts: 0 });
 535:     let kicked = 0;
 536:     for (const connection of this.openConnections()) {
 537:       for (const [topic, state] of connection.topics) {
 538:         if (state.stream !== stream || !state.joined || state.joinRef === null) continue;
 539:         kicked += 1;
 540:         if (kind === 'close') {
 541:           // Real server close: Realtime re-validates the channel's token,
 542:           // pushes `system` error + `phx_close`, and ends the server channel.
 543:           this.harnessRefCounter += 1;
 544:           const ref = `t25-close-${this.harnessRefCounter}`;
 545:           this.harnessRefs.add(ref);
 546:           state.closingJoinRef = state.joinRef;
 547:           const encoded = encodeFrame([state.joinRef, ref, topic, 'access_token', { access_token: 
INVALID_ACCESS_TOKEN }]);
 548:           connection.server.send(encoded);
 549:           this.log(connection, 'out', stream, decodeFrame(encoded, 'out') as PhoenixFrame, 'inject-server');
 550:         } else {
 551:           state.joined = false;
 552:           this.injectToPage(connection, stream, [state.joinRef, state.joinRef, topic, 'phx_error', {}]);
 553:         }
 554:       }
 555:     }
 556:     return { mark, kicked };
 557:   }
 558: 
 559:   restore(stream?: MessagingRealtimeStream): number {
 560:     if (stream) {
 561:       this.faults.delete(stream);
 562:     } else {
 563:       this.faults.clear();
 564:     }
 565:     return this.mark();
 566:   }
 567: 
 568:   activeFaults() {
 569:     return [...this.faults].map(([stream, fault]) => ({ stream, kind: fault.kind, joinAttempts: 
fault.joinAttempts }));
 570:   }
