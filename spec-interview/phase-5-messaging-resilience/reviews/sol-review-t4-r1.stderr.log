656:   if v_count > 0 then
657:     insert into public.message_attachments (id, message_id, name, type, size, url, duration, waveform_data)
658:     select u.id, v_message_id, u.name, u.type, u.size, u.storage_path, u.duration, u.waveform_data
659:     from public.message_attachment_uploads u
