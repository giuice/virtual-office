447: -- ============================================================================
448: -- Fenced create (T3 body) + mentions written with the first creation.
449: -- ============================================================================
450: create or replace function public.create_message_attempt(
451:   p_conversation_id uuid,
452:   p_sender_id uuid,
453:   p_content text,
454:   p_type text,
455:   p_reply_to_id uuid,
456:   p_client_message_id uuid,
457:   p_attempt_generation bigint,
458:   p_composition jsonb,
459:   p_upload_ids uuid[],
460:   p_insert_quota_limit integer,
461:   p_insert_quota_window_seconds integer
462: )
463: returns jsonb
464: language plpgsql
465: security invoker
466: set search_path = ''
467: as $$
468: declare
469:   v_count integer;
470:   v_locked integer;
471:   v_voice integer;
472:   v_message_id uuid;
473:   v_new_id uuid := pg_catalog.gen_random_uuid();
474:   v_generation bigint;
475:   v_committed_at timestamptz;
476:   v_quota_allowed boolean;
477:   v_row public.messages%rowtype;
478:   v_mention_ids uuid[] := '{}'::uuid[];
479:   v_mentioned uuid[] := '{}'::uuid[];
480: begin
481:   if p_conversation_id is null or p_sender_id is null or p_content is null or p_type is null then
482:     raise exception 'create_message_attempt: conversation, sender, content and type are required'
483:       using errcode = '22004';
484:   end if;
485:   if p_attempt_generation is not null and (p_client_message_id is null or p_attempt_generation < 1) then
486:     raise exception 'ATTEMPT_GENERATION_INVALID' using errcode = '22023';
487:   end if;
488:   if p_composition is not null and (p_client_message_id is null or pg_catalog.jsonb_typeof(p_composition) <> 
'object') then
489:     raise exception 'create_message_attempt: a composition needs a client key and must be an object'
490:       using errcode = '22023';
491:   end if;
492:   -- Phase 5 T3: both NULL (no charge: callers that charged elsewhere) or both
493:   -- positive.
494:   if (p_insert_quota_limit is null) <> (p_insert_quota_window_seconds is null)
495:      or p_insert_quota_limit < 1
496:      or p_insert_quota_window_seconds < 1 then
497:     raise exception 'INSERT_QUOTA_INVALID' using errcode = '22023';
498:   end if;
499: 
500:   -- Phase 5 T4 (FR-024): requested mention ids come from the original
501:   -- composition (absent key = none requested). At most 50 UUID strings.
502:   if p_composition is not null and p_composition ? 'mentionIds' then
503:     if pg_catalog.jsonb_typeof(p_composition -> 'mentionIds') <> 'array'
504:        or pg_catalog.jsonb_array_length(p_composition -> 'mentionIds') > 50
505:        or exists (
506:          select 1
507:          from pg_catalog.jsonb_array_elements(p_composition -> 'mentionIds') as e(v)
508:          where pg_catalog.jsonb_typeof(e.v) <> 'string'
509:             or (e.v #>> '{}') !~* '^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$'
510:        ) then
511:       raise exception 'MENTION_IDS_INVALID' using errcode = '22023';
512:     end if;
513:     select coalesce(pg_catalog.array_agg(distinct (e.v #>> '{}')::uuid), '{}'::uuid[])
514:     into v_mention_ids
515:     from pg_catalog.jsonb_array_elements(p_composition -> 'mentionIds') as e(v);
516:   end if;
517: 
518:   v_count := coalesce(pg_catalog.cardinality(p_upload_ids), 0);
519:   -- Same bound as the route's attachment policy (5 per message).
520:   if v_count > 5 then
521:     raise exception 'ATTACHMENT_COUNT_INVALID' using errcode = '22023';
522:   end if;
523:   if v_count > 0 then
524:     if (select pg_catalog.count(distinct u) from pg_catalog.unnest(p_upload_ids) as u) <> v_count then
525:       raise exception 'ATTACHMENT_DUPLICATE' using errcode = '22023';
526:     end if;
527:     -- Attachment messages are typed image or file (the only types allowed to
528:     -- carry empty content).
529:     if p_type not in ('image', 'file') then
530:       raise exception 'create_message_attempt: type must be image or file'
531:         using errcode = '22023';
532:     end if;
533:   end if;
534: 
535:   -- Defense in depth: the route already required membership.
536:   if not exists (
537:     select 1
538:     from public.conversation_members cm
539:     where cm.conversation_id = p_conversation_id
540:       and cm.user_id = p_sender_id
541:   ) then
542:     -- Explicit marker (Phase 5 T3): callers map only this to NOT_PARTICIPANT.
543:     raise exception 'NOT_PARTICIPANT' using errcode = '42501';
544:   end if;
545: 
546:   -- Replay of a key whose create already committed: answer with the stored
547:   -- message and link nothing (its uploads were consumed by the first create).
548:   -- Checked before the reply target: an unchanged replay is compared against
549:   -- the original composition, not re-validated (FR-024), so a reply target
550:   -- deleted since does not turn it into a refusal. Not an insertion: the
551:   -- insertion quota is not charged (Phase 5 T3, D1), and no mention is
552:   -- written or re-validated (Phase 5 T4).
553:   if p_client_message_id is not null then
554:     select m.id into v_message_id
555:     from public.messages m
556:     where m.sender_id = p_sender_id
557:       and m.conversation_id = p_conversation_id
558:       and m.client_message_id = p_client_message_id;
559:     if v_message_id is not null then
