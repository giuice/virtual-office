692:     select a.fence_generation, a.committed_at into v_generation, v_committed_at
693:     from private.message_send_attempts a
694:     where a.sender_id = p_sender_id
695:       and a.conversation_id = p_conversation_id
696:       and a.client_message_id = p_client_message_id
