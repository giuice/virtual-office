160: export async function fenceMessageAttempt(
161:   client: SupabaseClient,
162:   key: ClientMessageKey,
163:   generation: number
164: ): Promise<MessageAttemptFenceResult> {
165:   const { data, error } = await client.rpc('fence_message_attempt', {
166:     p_sender_id: key.senderId,
