    messages_triggers: \"select t.tgname, pg_catalog.pg_get_triggerdef(t.oid) as definition from pg_catalog.pg_trigger 
t where t.tgrelid='public.messages'::regclass and not t.tgisinternal\",
    messages_grants: \"select r.role, has_table_privilege(r.role,'public.messages','INSERT') as insert_allowed, 
has_table_privilege(r.role,'public.messages','UPDATE') as update_allowed, 
has_table_privilege(r.role,'private.message_send_attempts','SELECT,INSERT,UPDATE,DELETE') as attempts_any from 
unnest(array['anon','authenticated','service_role']) r(role)\",
    constraints: \"select conname, pg_catalog.pg_get_constraintdef(oid) as definition from pg_catalog.pg_constraint 
where conrelid in ('public.messages'::regclass,'private.message_send_attempts'::regclass)\",
    indexes: \"select indexname, indexdef from pg_catalog.pg_indexes where schemaname='public' and 
tablename='messages'\",
    role_config: \"select rolname, rolconfig from pg_catalog.pg_roles where rolname in 
('authenticator','service_role')\"
  };
