1: // src/lib/auth/authorize.ts
2: // Single authorization gate for messaging routes (audit S-05).
3: // Rule: every route resolves the requester, checks participation here, and only
4: // then may use the service-role client for the mutation. RLS stays as
5: // defense-in-depth, never the primary gate.
6: import type { NextResponse } from 'next/server';
7: import type { SupabaseClient } from '@supabase/supabase-js';
8: import { jsonError } from '@/lib/api/server-error';
9: import { createSupabaseServerClient } from '@/lib/supabase/server-client';
10: import { requireAuthUser } from '@/lib/auth/session';
11: import type { User } from '@/types/database';
12: 
13: export { jsonError } from '@/lib/api/server-error';
14: 
15: export interface ConversationAccess {
16:   id: string;
17:   type: string;
18:   roomId: string | null;
19: }
20: 
21: export interface ParticipantContext {
22:   /** User-scoped client â€” use for reads so RLS still applies. */
23:   supabase: SupabaseClient;
24:   /** Service-role client â€” use ONLY for the mutation after this check passed. */
25:   serviceClient: SupabaseClient;
26:   dbUser: User;
27:   conversation: ConversationAccess;
28: }
29: 
30: export interface MessageParticipantContext extends ParticipantContext {
31:   message: {
32:     id: string;
33:     conversationId: string;
34:     senderId: string | null;
35:   };
36: }
37: 
38: export interface AuthzFailure {
39:   errorResponse: NextResponse;
40: }
41: 
42: export function isAuthzFailure(result: object): result is AuthzFailure {
43:   return 'errorResponse' in result;
44: }
45: 
46: async function loadConversationAccess(
47:   serviceClient: SupabaseClient,
48:   conversationId: string,
49:   dbUserId: string
50: ): Promise<{ conversation: ConversationAccess; isMember: boolean } | AuthzFailure> {
51:   const { data: row, error } = await serviceClient
52:     .from('conversations')
53:     .select('id, type, room_id, conversation_members(user_id)')
54:     .eq('id', conversationId)
55:     .eq('conversation_members.user_id', dbUserId)
56:     .maybeSingle();
57: 
58:   if (error) {
59:     console.error('[authorize] Failed to load conversation:', error.message);
60:     return { errorResponse: jsonError(500, 'INTERNAL_ERROR', 'Failed to load conversation') };
61:   }
62:   if (!row) {
63:     return { errorResponse: jsonError(404, 'CONVERSATION_NOT_FOUND', 'Conversation not found') };
64:   }
65: 
66:   const conversationMembers = Array.isArray((row as { conversation_members?: unknown }).conversation_members)
67:     ? ((row as { conversation_members: { user_id: string }[] }).conversation_members ?? [])
68:     : [];
69: 
70:   return {
71:     conversation: {
72:       id: row.id,
73:       type: row.type,
74:       roomId: row.room_id ?? null,
75:     },
76:     isMember: conversationMembers.length > 0,
77:   };
78: }
79: 
80: export interface ConversationParticipantOptions {
81:   /**
82:    * Phase 5 FR-011: the sender the client expects (users.id of its outbox
83:    * item's owner). When the authenticated user differs, the request is refused
84:    * with 403 SENDER_MISMATCH before the conversation is read.
85:    */
86:   expectedSenderId?: string;
87:   /**
88:    * Phase 5 BR-005: answer a missing conversation like a non-member (403
89:    * NOT_PARTICIPANT) instead of 404, so the outcome is uniform and does not
90:    * reveal whether a conversation exists.
91:    */
92:   missingConversationAsNotParticipant?: boolean;
93: }
94: 
95: function notParticipant(): AuthzFailure {
96:   return {
97:     errorResponse: jsonError(403, 'NOT_PARTICIPANT', 'You are not a participant of this conversation'),
98:   };
99: }
100: 
101: /**
102:  * Resolves the session and asserts the requester participates in the
103:  * conversation. Membership authority is now conversation_members (synced from
104:  * participants[] by DB trigger; participants[] will be removed in Phase 3).
105:  */
106: export async function requireConversationParticipant(
107:   conversationId: string,
108:   options: ConversationParticipantOptions = {}
109: ): Promise<ParticipantContext | AuthzFailure> {
110:   if (!conversationId || typeof conversationId !== 'string') {
111:     return { errorResponse: jsonError(400, 'BAD_REQUEST', 'conversationId is required') };
112:   }
113: 
114:   const auth = await requireAuthUser();
115:   if ('errorResponse' in auth) {
116:     return auth;
117:   }
118: 
119:   if (
120:     options.expectedSenderId !== undefined &&
121:     options.expectedSenderId.toLowerCase() !== auth.dbUser.id.toLowerCase()
122:   ) {
123:     return {
124:       errorResponse: jsonError(403, 'SENDER_MISMATCH', 'The authenticated user is not the expected sender'),
125:     };
126:   }
127: 
128:   const serviceClient = await createSupabaseServerClient('service_role');
129:   const access = await loadConversationAccess(serviceClient, conversationId, auth.dbUser.id);
130:   if (isAuthzFailure(access)) {
131:     if (options.missingConversationAsNotParticipant && access.errorResponse.status === 404) {
132:       return notParticipant();
133:     }
134:     return access;
135:   }
136: 
137:   if (!access.isMember) {
138:     return notParticipant();
139:   }
140: 
141:   const { conversation } = access;
142: 
143:   return {
144:     supabase: auth.supabase,
145:     serviceClient,
146:     dbUser: auth.dbUser,
147:     conversation,
148:   };
149: }
150: 
151: /**
152:  * Same as requireConversationParticipant, but scoped by message â€” for routes
153:  * addressed by messageId (react, pin, star, attachment access).
154:  */
155: export async function requireMessageParticipant(
156:   messageId: string
157: ): Promise<MessageParticipantContext | AuthzFailure> {
158:   if (!messageId || typeof messageId !== 'string') {
159:     return { errorResponse: jsonError(400, 'BAD_REQUEST', 'messageId is required') };
160:   }
161: 
162:   const auth = await requireAuthUser();
163:   if ('errorResponse' in auth) {
164:     return auth;
165:   }
166: 
167:   const serviceClient = await createSupabaseServerClient('service_role');
168:   const { data: messageRow, error: messageError } = await serviceClient
169:     .from('messages')
170:     .select('id, conversation_id, sender_id')
171:     .eq('id', messageId)
172:     .maybeSingle();
173: 
174:   if (messageError) {
175:     console.error('[authorize] Failed to load message:', messageError.message);
176:     return { errorResponse: jsonError(500, 'INTERNAL_ERROR', 'Failed to load message') };
177:   }
178:   if (!messageRow) {
179:     return { errorResponse: jsonError(404, 'MESSAGE_NOT_FOUND', 'Message not found') };
180:   }
181: 
182:   const access = await loadConversationAccess(serviceClient, messageRow.conversation_id, auth.dbUser.id);
183:   if (isAuthzFailure(access)) {
184:     return access;
185:   }
186: 
187:   if (!access.isMember) {
188:     return {
189:       errorResponse: jsonError(403, 'NOT_PARTICIPANT', 'You are not a participant of this conversation'),
190:     };
191:   }
192: 
193:   return {
194:     supabase: auth.supabase,
195:     serviceClient,
196:     dbUser: auth.dbUser,
197:     conversation: access.conversation,
198:     message: {
199:       id: messageRow.id,
200:       conversationId: messageRow.conversation_id,
201:       senderId: messageRow.sender_id ?? null,
202:     },
203:   };
204: }
src/lib/auth/session.ts
1: // src/lib/auth/session.ts
2: import type { NextResponse } from 'next/server';
3: import type { SupabaseClient, User as SupabaseAuthUser } from '@supabase/supabase-js';
4: import { API_ERROR_CODES } from '@/lib/api/error-contract';
5: import { jsonError } from '@/lib/api/server-error';
6: import {
7:   createAuthCorrelationId,
8:   getAuthErrorCode,
9:   recordAuthValidation,
10: } from '@/lib/auth/auth-metrics';
11: import { createSupabaseServerClient } from '@/lib/supabase/server-client';
12: import { SupabaseUserRepository } from '@/repositories/implementations/supabase';
13: import type { User } from '@/types/database';
14: 
15: type SessionResult = {
16:   supabaseUid?: string; // Supabase Auth UID
17:   userDbId?: string; // Database UUID (from users table)
18:   error?: string;
19: };
20: 
21: /**
22:  * Validates the user session and returns the user ID if valid
23:  * Handles the relationship between Supabase Auth UIDs and Database UUIDs
24:  *
25:  * @returns Object containing supabaseUid (Supabase Auth UID), userDbId (Database UUID), and error (if any)
26:  */
27: export async function validateUserSession(): Promise<SessionResult> {
28:   try {
29:     const supabase = await createSupabaseServerClient();
30:     
31:     const { data, error } = await supabase.auth.getUser();
32:     
33:     if (error) {
34:       console.error('Session error:', error.message);
35:       return { error: error.message };
36:     }
37:     
38:     if (!data.user) {
39:       return { error: 'No active session' };
40:     }
41:     
42:     const supabaseUid = data.user.id; // This is the Supabase Auth UID
43:     
44:     // Get the database user record to fetch the database UUID
45:     const { data: userRecord, error: userError } = await supabase
46:       .from('users')
47:       .select('id') // Database UUID
48:       .eq('supabase_uid', supabaseUid) // supabase_uid column holds the Supabase Auth UID
49:       .single();
50:     
51:     if (userError) {
52:       console.error('User lookup error:', userError.message);
53:       return { supabaseUid, error: 'User record not found' };
54:     }
55:     
56:     // Return both IDs for flexible usage
57:     return { 
58:       supabaseUid,   // Supabase Auth UID (from auth)
59:       userDbId: userRecord.id // Database UUID (from users table)
60:     };
61:     
62:   } catch (error) {
63:     console.error('Session validation error:', error);
64:     return { error: 'Failed to validate session' };
65:   }
66: }
67: 
68: type RequireAuthResult =
69:   | { supabase: SupabaseClient; dbUser: User; authUser: SupabaseAuthUser }
70:   | { errorResponse: NextResponse };
71: 
72: interface RequireAuthUserOptions {
73:   correlationId?: string;
74:   pathname?: string;
75:   beforeDatabaseOperation?: () => void;
76: }
77: 
78: type RequireAuthUserArgument = RequireAuthUserOptions | (() => void);
79: 
80: function normalizeRequireAuthOptions(argument?: RequireAuthUserArgument): RequireAuthUserOptions {
81:   return typeof argument === 'function' ? { beforeDatabaseOperation: argument } : (argument ?? {});
82: }
83: 
84: export async function requireAuthUser(argument?: RequireAuthUserArgument): Promise<RequireAuthResult> {
85:   const { correlationId: providedCorrelationId, pathname, beforeDatabaseOperation } = 
normalizeRequireAuthOptions(argument);
86:   const correlationId = providedCorrelationId ?? createAuthCorrelationId();
87:   let refreshed = false;
88:   const supabase = await createSupabaseServerClient(undefined, {
89:     onAuthCookiesSet: () => {
90:       refreshed = true;
91:     },
92:   });
93:   let authResult: Awaited<ReturnType<typeof supabase.auth.getUser>>;
94:   try {
95:     authResult = await supabase.auth.getUser();
96:   } catch (error) {
97:     recordAuthValidation({
98:       correlationId,
99:       boundary: 'route',
100:       pathname: pathname ?? '/unattributed',
101:       authMethod: 'getUser',
102:       authStatus: 'error',
103:       authErrorCode: getAuthErrorCode(error),
104:       refreshed,
105:     });
106:     throw error;
107:   }
108: 
109:   const { data, error } = authResult;
110:   recordAuthValidation({
111:     correlationId,
112:     boundary: 'route',
113:     pathname: pathname ?? '/unattributed',
114:     authMethod: 'getUser',
115:     authStatus: error ? 'error' : data.user ? 'authenticated' : 'unauthenticated',
116:     authErrorCode: getAuthErrorCode(error),
117:     refreshed,
118:   });
119: 
120:   if (error || !data.user) {
121:     const isRateLimited = error?.status === 429;
122:     return {
123:       errorResponse: jsonError(
124:         isRateLimited ? 429 : 401,
125:         isRateLimited ? API_ERROR_CODES.RATE_LIMITED : API_ERROR_CODES.UNAUTHORIZED,
126:         isRateLimited ? 'Authentication service rate limit reached' : 'Authentication required',
127:         { correlationId, cause: error, context: 'requireAuthUser.getUser' }
128:       ),
129:     };
130:   }
131: 
132:   const userRepository = new SupabaseUserRepository(supabase);
133: 
134:   let dbUser: User | null;
135:   try {
136:     beforeDatabaseOperation?.();
137:     dbUser = await userRepository.findBySupabaseUid(data.user.id);
138:   } catch (lookupError) {
139:     return {
140:       errorResponse: jsonError(
141:         500,
142:         API_ERROR_CODES.INTERNAL_ERROR,
143:         'Failed to load authenticated user profile',
144:         { correlationId, cause: lookupError, context: 'requireAuthUser.profileLookup' }
145:       ),
146:     };
147:   }
148: 
149:   if (!dbUser) {
150:     return {
151:       errorResponse: jsonError(
152:         404,
153:         API_ERROR_CODES.PROFILE_NOT_FOUND,
154:         'Authenticated user profile not found',
155:         { correlationId, context: 'requireAuthUser.profileLookup' }
156:       ),
157:     };
158:   }
159: 
160:   return { supabase, dbUser, authUser: data.user };
161: }
src/lib/auth/rate-limit.ts
1: // src/lib/auth/rate-limit.ts
2: import { NextResponse } from 'next/server';
3: import type { SupabaseClient } from '@supabase/supabase-js';
4: import { jsonError } from '@/lib/auth/authorize';
5: 
6: // Audit M-09: per-user fixed-window limits for messaging mutations.
7: // Enforced by the service-role-only check_rate_limit RPC (shared Postgres
8: // counter, safe across serverless instances).
9: const RATE_LIMITS = {
10:   'message:create': { limit: 30, windowSeconds: 60 },
11:   'message:react': { limit: 60, windowSeconds: 60 },
12:   // Phase 4 T13: one upload per file, up to 5 files per message, plus retries
13:   // of failed uploads; 10/min refused the second full message in a minute.
14:   // 30/min = six 5-file messages, in line with message:create (each file is
15:   // still capped at 10 MB and only links to the uploader's own message).
16:   'message:upload': { limit: 30, windowSeconds: 60 },
17:   // Phase 4 T12: cancelling pending uploads (composer remove/cancel).
18:   'message:upload-cancel': { limit: 60, windowSeconds: 60 },
19:   // Phase 5 T2: fence/lookup of the caller's own composition key (outbox
20:   // recovery after unknown outcomes). Budget semantics are revisited in T3.
21:   'message:fence': { limit: 60, windowSeconds: 60 },
22:   // Visible-message receipts are batched by the drawer while it scrolls.
23:   'conversation:read-receipts': { limit: 120, windowSeconds: 60 },
24: } as const;
25: 
26: export type RateLimitedAction = keyof typeof RATE_LIMITS;
27: 
28: /**
29:  * Returns a 429 response when the user exceeded the action's limit,
30:  * null when the request may proceed. Call AFTER the authz check, with the
31:  * authenticated user's DB id (users.id, not supabase_uid).
32:  *
33:  * Fails open: an RPC error (e.g. migration not applied yet) is logged and
34:  * the request is allowed â€” rate limiting must never take messaging down.
35:  */
36: export async function enforceRateLimit(
37:   serviceClient: SupabaseClient,
38:   userDbId: string,
39:   action: RateLimitedAction
40: ): Promise<NextResponse | null> {
41:   const { limit, windowSeconds } = RATE_LIMITS[action];
42: 
43:   try {
44:     const { data: allowed, error } = await serviceClient.rpc('check_rate_limit', {
45:       p_user_id: userDbId,
46:       p_action: action,
47:       p_limit: limit,
48:       p_window_seconds: windowSeconds,
49:     });
50: 
51:     if (error) {
52:       console.error(`Rate limit check failed for ${action}:`, error);
53:       return null;
54:     }
55: 
56:     if (allowed === false) {
57:       return jsonError(429, 'rate_limited', 'Too many requests. Please slow down.');
58:     }
59: 
60:     return null;
61:   } catch (error) {
62:     console.error(`Rate limit check threw for ${action}:`, error);
63:     return null;
64:   }
65: }

