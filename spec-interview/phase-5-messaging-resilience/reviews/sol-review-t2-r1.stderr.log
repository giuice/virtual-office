125: create table if not exists private.message_send_attempts (
126:   sender_id uuid not null references public.users (id) on delete cascade,
127:   conversation_id uuid not null references public.conversations (id) on delete cascade,
128:   client_message_id uuid not null,
129:   fence_generation bigint,
130:   committed_at timestamptz,
131:   message_id uuid references public.messages (id) on delete set null,
132:   composition jsonb,
