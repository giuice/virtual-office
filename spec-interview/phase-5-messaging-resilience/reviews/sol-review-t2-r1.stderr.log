134:   updated_at timestamptz not null default now(),
135:   constraint message_send_attempts_pkey primary key (sender_id, conversation_id, client_message_id),
136:   constraint message_send_attempts_generation_check check (fence_generation is null or fence_generation >= 1),
137:   constraint message_send_attempts_composition_check check (composition is null or jsonb_typeof(composition) = 
'object')
