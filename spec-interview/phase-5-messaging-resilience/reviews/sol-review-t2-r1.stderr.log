1: // src/lib/messaging/message-attempts.ts
2: // Phase 5 T2 (FR-006, FR-011, FR-024, FR-034, BR-005): request parsing and
3: // replay comparison shared by POST /api/messages/create and
4: // POST /api/messages/fence. The database enforces attempt fencing
5: // (public.fence_message_attempt / public.create_message_attempt); this module
6: // only validates input and normalizes compositions.
7: import type { NextResponse } from 'next/server';
8: import { jsonError } from '@/lib/api/server-error';
9: import type { ApiErrorBody } from '@/lib/api/error-contract';
10: 
11: const UUID_PATTERN = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
12: 
13: export function isUuid(value: unknown): value is string {
14:   return typeof value === 'string' && UUID_PATTERN.test(value);
15: }
16: 
17: type FieldResult<T> = { ok: true; value: T } | { ok: false; response: NextResponse<ApiErrorBody> };
18: 
19: /**
20:  * Optional attempt generation: a positive safe integer. Absent â†’ undefined
21:  * (Phase 4 client). It is only meaningful together with a clientMessageId.
22:  */
23: export function parseAttemptGeneration(value: unknown, hasClientKey: boolean): FieldResult<number | undefined> {
24:   if (value === undefined || value === null) {
25:     return { ok: true, value: undefined };
26:   }
27:   if (typeof value !== 'number' || !Number.isSafeInteger(value) || value < 1) {
28:     return {
29:       ok: false,
30:       response: jsonError(400, 'INVALID_ATTEMPT_GENERATION', 'attemptGeneration must be a positive integer'),
31:     };
32:   }
33:   if (!hasClientKey) {
34:     return {
35:       ok: false,
36:       response: jsonError(400, 'INVALID_ATTEMPT_GENERATION', 'attemptGeneration requires clientMessageId'),
37:     };
38:   }
39:   return { ok: true, value };
40: }
41: 
42: /**
43:  * Optional expected sender (users.id of the outbox item's owner, FR-011).
44:  * Required whenever an attempt generation is sent: every Phase 5 dispatch
45:  * carries both.
46:  */
47: export function parseExpectedSenderId(value: unknown, required: boolean): FieldResult<string | undefined> {
48:   if (value === undefined || value === null) {
49:     if (required) {
50:       return {
51:         ok: false,
52:         response: jsonError(400, 'INVALID_EXPECTED_SENDER', 'expectedSenderId is required with attemptGeneration'),
53:       };
54:     }
55:     return { ok: true, value: undefined };
56:   }
57:   if (!isUuid(value)) {
58:     return { ok: false, response: jsonError(400, 'INVALID_EXPECTED_SENDER', 'expectedSenderId must be a UUID') };
59:   }
60:   return { ok: true, value: value.toLowerCase() };
61: }
62: 
63: /**
64:  * Phase 5 T2: the message stored under this key was deleted since. The key's
65:  * item was delivered; nothing was stored and it must not be resent.
66:  */
67: export function messageDeletedResponse(): NextResponse<ApiErrorBody> {
68:   return jsonError(410, 'MESSAGE_DELETED', 'The message sent with this clientMessageId was deleted');
69: }
70: 
71: /** BR-005: a newer attempt of the same key exists; clients ignore this outcome. */
72: export function attemptSupersededResponse(): NextResponse<ApiErrorBody> {
73:   return jsonError(409, 'ATTEMPT_SUPERSEDED', 'A newer attempt of this clientMessageId exists');
74: }
