162: -- ============================================================================
163: -- Replay answer (internal): stored message id + its recorded composition.
164: -- A generation-carrying replay older than the key's fence generation is
165: -- refused; a generation-less replay always answers (Phase 4 contract).
166: -- ============================================================================
167: create or replace function private.message_attempt_replay(
168:   p_sender_id uuid,
169:   p_conversation_id uuid,
170:   p_client_message_id uuid,
171:   p_attempt_generation bigint,
172:   p_message_id uuid
173: )
174: returns jsonb
175: language plpgsql
176: security invoker
177: set search_path = ''
178: as $$
179: declare
180:   v_generation bigint;
181:   v_composition jsonb;
182: begin
183:   select a.fence_generation, case when a.message_id = p_message_id then a.composition end
184:   into v_generation, v_composition
185:   from private.message_send_attempts a
186:   where a.sender_id = p_sender_id
187:     and a.conversation_id = p_conversation_id
188:     and a.client_message_id = p_client_message_id;
189: 
190:   if p_attempt_generation is not null and v_generation is not null and p_attempt_generation < v_generation then
191:     raise exception 'ATTEMPT_SUPERSEDED' using errcode = 'P0001';
192:   end if;
193: 
194:   return pg_catalog.jsonb_build_object(
195:     'message_id', p_message_id,
196:     'created', false,
197:     'composition', v_composition
198:   );
199: end
200: $$;
