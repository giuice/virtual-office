36:     try {
37:       body = await request.json();
38:     } catch {
39:       return jsonError(400, 'BAD_REQUEST', 'Invalid JSON payload');
40:     }
41:     if (typeof body !== 'object' || body === null || Array.isArray(body)) {
42:       return jsonError(400, 'BAD_REQUEST', 'Invalid JSON payload');
43:     }
44: 
45:     if (!isUuid(body.conversationId)) {
46:       return jsonError(400, 'BAD_REQUEST', 'conversationId must be a UUID');
47:     }
48:     const conversationId = body.conversationId.toLowerCase();
49:     if (!isUuid(body.clientMessageId)) {
50:       return jsonError(400, 'INVALID_CLIENT_MESSAGE_ID', 'clientMessageId must be a UUID');
51:     }
52:     const clientMessageId = body.clientMessageId.toLowerCase();
53:     if (body.attemptGeneration === undefined || body.attemptGeneration === null) {
54:       return jsonError(400, 'INVALID_ATTEMPT_GENERATION', 'attemptGeneration is required');
55:     }
56:     const attemptGeneration = parseAttemptGeneration(body.attemptGeneration, true);
57:     if (!attemptGeneration.ok) {
