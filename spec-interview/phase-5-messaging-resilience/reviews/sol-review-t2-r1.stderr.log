214: language plpgsql
215: security invoker
216: set search_path = ''
217: as $$
218: declare
219:   v_count integer;
220:   v_locked integer;
221:   v_voice integer;
222:   v_message_id uuid;
223: begin
224:   if p_conversation_id is null or p_sender_id is null or p_content is null or p_type is null then
225:     raise exception 'create_message_with_attachments: conversation, sender, content and type are required'
226:       using errcode = '22004';
227:   end if;
228: 
229:   v_count := coalesce(pg_catalog.cardinality(p_upload_ids), 0);
230:   -- Same bound as the route's attachment policy (5 per message).
231:   if v_count < 1 or v_count > 5 then
232:     raise exception 'ATTACHMENT_COUNT_INVALID' using errcode = '22023';
233:   end if;
234:   if (select pg_catalog.count(distinct u) from pg_catalog.unnest(p_upload_ids) as u) <> v_count then
235:     raise exception 'ATTACHMENT_DUPLICATE' using errcode = '22023';
236:   end if;
237: 
238:   -- Attachment messages are typed image or file (the only types allowed to
239:   -- carry empty content).
240:   if p_type not in ('image', 'file') then
241:     raise exception 'create_message_with_attachments: type must be image or file'
242:       using errcode = '22023';
243:   end if;
244: 
245:   -- A reply target must be a message of the same conversation.
246:   if p_reply_to_id is not null and not exists (
247:     select 1
248:     from public.messages r
249:     where r.id = p_reply_to_id
250:       and r.conversation_id = p_conversation_id
251:   ) then
252:     raise exception 'INVALID_REPLY_TARGET' using errcode = '22023';
253:   end if;
254: 
255:   -- Defense in depth: the route already required membership.
256:   if not exists (
257:     select 1
258:     from public.conversation_members cm
259:     where cm.conversation_id = p_conversation_id
260:       and cm.user_id = p_sender_id
261:   ) then
262:     raise exception 'create_message_with_attachments: sender is not a member of the conversation'
263:       using errcode = '42501';
264:   end if;
265: 
266:   -- Replay of a composition whose create already committed: answer with the
267:   -- stored message and link nothing (its uploads were consumed by the first
268:   -- create).
269:   if p_client_message_id is not null then
270:     select m.id into v_message_id
271:     from public.messages m
272:     where m.sender_id = p_sender_id
273:       and m.conversation_id = p_conversation_id
274:       and m.client_message_id = p_client_message_id;
275:     if v_message_id is not null then
276:       return pg_catalog.jsonb_build_object('message_id', v_message_id, 'created', false);
277:     end if;
278:   end if;
279: 
280:   -- Lock the caller's pending uploads for this conversation (id order avoids
281:   -- deadlocks between overlapping sets). A concurrent cancel or link of the
282:   -- same upload waits here; once it commits the row is gone.
283:   select pg_catalog.count(*), pg_catalog.count(*) filter (where locked.duration is not null)
284:   into v_locked, v_voice
285:   from (
286:     select u.id, u.duration
287:     from public.message_attachment_uploads u
288:     where u.id = any (p_upload_ids)
289:       and u.uploader_id = p_sender_id
290:       and u.conversation_id = p_conversation_id
291:     order by u.id
292:     for update
293:   ) as locked;
294: 
295:   if v_locked <> v_count then
296:     -- A concurrent create with the same key may have consumed them.
297:     if p_client_message_id is not null then
298:       select m.id into v_message_id
299:       from public.messages m
300:       where m.sender_id = p_sender_id
301:         and m.conversation_id = p_conversation_id
302:         and m.client_message_id = p_client_message_id;
303:       if v_message_id is not null then
304:         return pg_catalog.jsonb_build_object('message_id', v_message_id, 'created', false);
305:       end if;
306:     end if;
307:     -- Unknown, foreign, other-conversation, cancelled, or already linked.
308:     raise exception 'ATTACHMENT_UPLOAD_NOT_FOUND' using errcode = '22023';
309:   end if;
310: 
311:   -- Phase 4 T15: a voice note is the only attachment of its message, which is
312:   -- typed file.
313:   if v_voice > 0 and v_count > 1 then
314:     raise exception 'VOICE_NOTE_NOT_ALONE' using errcode = '22023';
315:   end if;
316:   if v_voice > 0 and p_type <> 'file' then
317:     raise exception 'create_message_with_attachments: a voice note message must be typed file'
318:       using errcode = '22023';
319:   end if;
320: 
321:   insert into public.messages (conversation_id, sender_id, content, type, status, reply_to_id, client_message_id)
322:   values (
323:     p_conversation_id,
324:     p_sender_id,
325:     p_content,
326:     p_type::public.message_type,
327:     'sent'::public.message_status,
328:     p_reply_to_id,
329:     p_client_message_id
330:   )
331:   on conflict (sender_id, conversation_id, client_message_id) where client_message_id is not null
332:   do nothing
333:   returning id into v_message_id;
334: 
335:   if v_message_id is null then
336:     -- Lost the race on the same key: the winner's message is committed.
337:     select m.id into v_message_id
338:     from public.messages m
339:     where m.sender_id = p_sender_id
340:       and m.conversation_id = p_conversation_id
341:       and m.client_message_id = p_client_message_id;
342:     return pg_catalog.jsonb_build_object('message_id', v_message_id, 'created', false);
343:   end if;
344: 
345:   insert into public.message_attachments (id, message_id, name, type, size, url, duration, waveform_data)
346:   select u.id, v_message_id, u.name, u.type, u.size, u.storage_path, u.duration, u.waveform_data
347:   from public.message_attachment_uploads u
348:   where u.id = any (p_upload_ids);
349: 
350:   delete from public.message_attachment_uploads u
351:   where u.id = any (p_upload_ids);
352: 
353:   return pg_catalog.jsonb_build_object('message_id', v_message_id, 'created', true);
354: end
