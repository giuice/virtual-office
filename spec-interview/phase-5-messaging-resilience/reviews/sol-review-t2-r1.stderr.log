211: -- Fence / lookup.
212: -- ============================================================================
213: create or replace function public.fence_message_attempt(
214:   p_sender_id uuid,
215:   p_conversation_id uuid,
216:   p_client_message_id uuid,
217:   p_attempt_generation bigint
218: )
219: returns jsonb
220: language plpgsql
221: security invoker
222: set search_path = ''
223: as $$
224: declare
225:   v_generation bigint;
226:   v_committed_at timestamptz;
227:   v_message_id uuid;
228: begin
229:   if p_sender_id is null or p_conversation_id is null or p_client_message_id is null or p_attempt_generation is 
null then
230:     raise exception 'fence_message_attempt: sender, conversation, key and generation are required'
231:       using errcode = '22004';
232:   end if;
233:   if p_attempt_generation < 1 then
234:     raise exception 'ATTEMPT_GENERATION_INVALID' using errcode = '22023';
235:   end if;
236: 
237:   -- Defense in depth: the route already required membership.
238:   if not exists (
239:     select 1
240:     from public.conversation_members cm
241:     where cm.conversation_id = p_conversation_id
242:       and cm.user_id = p_sender_id
243:   ) then
244:     raise exception 'fence_message_attempt: sender is not a member of the conversation'
245:       using errcode = '42501';
246:   end if;
247: 
248:   insert into private.message_send_attempts (sender_id, conversation_id, client_message_id)
249:   values (p_sender_id, p_conversation_id, p_client_message_id)
250:   on conflict (sender_id, conversation_id, client_message_id) do nothing;
251: 
252:   select a.fence_generation, a.committed_at into v_generation, v_committed_at
253:   from private.message_send_attempts a
254:   where a.sender_id = p_sender_id
255:     and a.conversation_id = p_conversation_id
256:     and a.client_message_id = p_client_message_id
257:   for update;
258: 
259:   if v_generation is not null and p_attempt_generation < v_generation then
260:     return pg_catalog.jsonb_build_object('outcome', 'superseded', 'current_generation', v_generation);
261:   end if;
262: 
263:   if v_generation is null or p_attempt_generation > v_generation then
264:     update private.message_send_attempts a
265:     set fence_generation = p_attempt_generation,
266:         updated_at = pg_catalog.now()
267:     where a.sender_id = p_sender_id
268:       and a.conversation_id = p_conversation_id
269:       and a.client_message_id = p_client_message_id;
270:   end if;
271: 
272:   -- A new statement (new snapshot) after the row lock: a create that held the
273:   -- lock has committed by now and its message is visible.
274:   select m.id into v_message_id
275:   from public.messages m
276:   where m.sender_id = p_sender_id
277:     and m.conversation_id = p_conversation_id
278:     and m.client_message_id = p_client_message_id;
279: 
280:   if v_message_id is not null or v_committed_at is not null then
281:     -- message_id is null when the committed message was deleted since.
