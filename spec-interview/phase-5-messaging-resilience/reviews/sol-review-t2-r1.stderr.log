9:   type: MessageType | null;
10:   replyToId?: string;
11:   attachmentIds: readonly string[];
12: }): MessageComposition {
13:   return {
14:     content: input.content,
15:     type: input.type,
16:     replyToId: input.replyToId ?? null,
17:     attachmentIds: [...input.attachmentIds].sort(),
18:   };
19: }
20: 
21: function isStringArray(value: unknown): value is string[] {
22:   return Array.isArray(value) && value.every((item) => typeof item === 'string');
23: }
24: 
25: /** A composition read back from private.message_send_attempts; null when absent or malformed. */
26: export function parseStoredComposition(value: unknown): MessageComposition | null {
27:   if (typeof value !== 'object' || value === null || Array.isArray(value)) {
28:     return null;
29:   }
30:   const record = value as Record<string, unknown>;
31:   const type = record.type;
32:   const replyToId = record.replyToId;
33:   if (
34:     typeof record.content !== 'string' ||
35:     !(type === null || (typeof type === 'string' && (Object.values(MessageType) as string[]).includes(type))) ||
36:     !(replyToId === null || typeof replyToId === 'string') ||
37:     !isStringArray(record.attachmentIds)
38:   ) {
39:     return null;
40:   }
41:   return {
42:     content: record.content,
43:     type: type as MessageType | null,
44:     replyToId,
45:     attachmentIds: [...record.attachmentIds].sort(),
46:   };
47: }
48: 
49: function sameIds(a: readonly string[], b: readonly string[]): boolean {
50:   const left = [...a].sort();
51:   const right = [...b].sort();
52:   return left.length === right.length && left.every((id, index) => id === right[index]);
53: }
54: 
55: /** FR-024: an unchanged replay matches the ORIGINAL submitted composition. */
56: export function isSameStoredComposition(stored: MessageComposition, requested: MessageComposition): boolean {
57:   return (
58:     stored.content === requested.content &&
59:     stored.type === requested.type &&
60:     stored.replyToId === requested.replyToId &&
61:     sameIds(stored.attachmentIds, requested.attachmentIds)
62:   );
63: }
