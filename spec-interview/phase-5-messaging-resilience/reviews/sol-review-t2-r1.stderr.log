      });

      if (!response.ok) {
        const errorData = await response.json();
        throw new Error(errorData.error || 'Failed to delete file attachment');
      }

      const data = await response.json();
      return data.success;
    } catch (error) {
      console.error('Error deleting file attachment:', error);
      throw error;
    }
  },

