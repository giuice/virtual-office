112:     return NextResponse.json(
113:       {
114:         outcome: 'stored',
115:         clientMessageId,
116:         attemptGeneration: generation,
117:         // Not other users' pins or stars, which findById (service client) loads.
118:         message: { ...stored, pins: undefined, stars: undefined, clientMessageId },
119:       },
120:       { status: 200 }
121:     );
122:   } catch (error) {
123:     console.error('Error fencing message attempt:', error);
124:     return jsonError(500, 'INTERNAL_ERROR', 'Failed to fence message attempt');
125:   }
