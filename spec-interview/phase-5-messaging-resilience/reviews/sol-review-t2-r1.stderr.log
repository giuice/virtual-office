1: // src/repositories/implementations/supabase/message-attempt-rpc.ts
2: // Phase 5 T2: typed calls to the fenced create / fence RPCs
3: // (migration 20261007095045_message_send_attempt_fencing). Service role only.
4: import type { PostgrestError, SupabaseClient } from '@supabase/supabase-js';
5: 
6: import {
7:   AttemptSupersededError,
8:   MessageDeletedError,
9:   type ClientMessageKey,
10: } from '@/repositories/interfaces/IMessageRepository';
11: import {
12:   AttachmentLinkError,
13:   type AttachmentLinkFailureCode,
14: } from '@/repositories/interfaces/IMessageAttachmentUploadRepository';
15: import { parseStoredComposition } from '@/lib/messaging/message-composition';
16: import type { Message, MessageAttempt, MessageAttemptFenceResult, MessageComposition } from '@/types/messaging';
17: 
18: export interface CreateMessageAttemptInput {
19:   data: Pick<Message, 'conversationId' | 'senderId' | 'content' | 'type' | 'replyToId'>;
20:   clientMessageId?: string;
21:   attempt?: MessageAttempt;
22:   uploadIds: readonly string[];
23: }
24: 
25: export interface CreateMessageAttemptResult {
26:   messageId: string;
27:   created: boolean;
28:   storedComposition: MessageComposition | null;
29: }
30: 
31: /** Raised by the RPC call; carries the PostgREST error for caller-specific mapping. */
32: export class MessageAttemptRpcError extends Error {
33:   constructor(readonly postgrestError: PostgrestError) {
34:     super(postgrestError.message);
35:     this.name = 'MessageAttemptRpcError';
36:   }
37: }
38: 
39: const LINK_FAILURE_CODES: readonly AttachmentLinkFailureCode[] = [
40:   'ATTACHMENT_UPLOAD_NOT_FOUND',
41:   'ATTACHMENT_COUNT_INVALID',
42:   'ATTACHMENT_DUPLICATE',
43:   'INVALID_REPLY_TARGET',
44:   'VOICE_NOTE_NOT_ALONE',
45: ];
46: 
47: function isRecord(value: unknown): value is Record<string, unknown> {
48:   return typeof value === 'object' && value !== null && !Array.isArray(value);
49: }
50: 
51: /**
52:  * Calls public.create_message_attempt. Throws AttemptSupersededError when the
53:  * attempt was fenced (nothing stored), MessageDeletedError when a
54:  * generation-carrying create would recreate a deleted message,
55:  * AttachmentLinkError for the
56:  * database's validation refusals (reply target, membership, uploads), and
57:  * MessageAttemptRpcError for anything else.
58:  */
59: export async function createMessageAttempt(
60:   client: SupabaseClient,
61:   input: CreateMessageAttemptInput
62: ): Promise<CreateMessageAttemptResult> {
63:   const { data, error } = await client.rpc('create_message_attempt', {
64:     p_conversation_id: input.data.conversationId,
65:     p_sender_id: input.data.senderId,
66:     p_content: input.data.content,
67:     p_type: input.data.type,
68:     p_reply_to_id: input.data.replyToId ?? null,
69:     p_client_message_id: input.clientMessageId ?? null,
70:     p_attempt_generation: input.attempt?.generation ?? null,
71:     p_composition: input.clientMessageId && input.attempt ? input.attempt.composition : null,
72:     p_upload_ids: [...input.uploadIds],
73:   });
74: 
75:   if (error) {
76:     if (error.message === 'ATTEMPT_SUPERSEDED') {
77:       throw new AttemptSupersededError();
78:     }
79:     if (error.message === 'MESSAGE_DELETED') {
80:       throw new MessageDeletedError();
81:     }
82:     const linkFailure = LINK_FAILURE_CODES.find((code) => error.message === code);
83:     if (error.code === '22023' && linkFailure) {
84:       throw new AttachmentLinkError(linkFailure);
85:     }
86:     if (error.code === '42501') {
87:       throw new AttachmentLinkError('NOT_PARTICIPANT');
88:     }
89:     console.error('Error in create_message_attempt RPC:', error);
90:     throw new MessageAttemptRpcError(error);
91:   }
92:   if (!isRecord(data) || typeof data.message_id !== 'string' || typeof data.created !== 'boolean') {
93:     throw new Error('create_message_attempt returned an unexpected result');
94:   }
95:   return {
96:     messageId: data.message_id,
97:     created: data.created,
98:     storedComposition: data.created ? null : parseStoredComposition(data.composition),
99:   };
100: }
101: 
102: /** Calls public.fence_message_attempt. */
103: export async function fenceMessageAttempt(
104:   client: SupabaseClient,
105:   key: ClientMessageKey,
106:   generation: number
107: ): Promise<MessageAttemptFenceResult> {
108:   const { data, error } = await client.rpc('fence_message_attempt', {
109:     p_sender_id: key.senderId,
110:     p_conversation_id: key.conversationId,
111:     p_client_message_id: key.clientMessageId,
112:     p_attempt_generation: generation,
113:   });
114: 
115:   if (error) {
116:     if (error.code !== '42501') {
117:       console.error('Error in fence_message_attempt RPC:', error);
118:     }
119:     throw new MessageAttemptRpcError(error);
120:   }
121:   if (isRecord(data)) {
122:     if (data.outcome === 'superseded' || data.outcome === 'not_stored') {
123:       return { outcome: data.outcome };
124:     }
125:     if (data.outcome === 'stored' && (typeof data.message_id === 'string' || data.message_id === null)) {
126:       return { outcome: 'stored', messageId: data.message_id };
127:     }
128:   }
129:   throw new Error('fence_message_attempt returned an unexpected result');
130: }

