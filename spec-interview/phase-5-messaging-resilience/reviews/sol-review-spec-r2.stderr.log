   1: // src/lib/messaging/message-cache.ts
   2: // Shared cache-merge helper for the ['messages', conversationId] infinite
   3: // query (audit B-04). Page 0 holds the NEWEST window (pages go newer ->
   4: // older), so incoming messages must land in page 0 — appending to the last
   5: // page renders them in the middle of history once older pages are loaded.
   6: import type { QueryClient } from '@tanstack/react-query';
   7: 
   8: import { Message } from '@/types/messaging';
   9: 
  10: export interface MessagesPage {
  11:   messages: Message[];
  12:   hasMoreOlder?: boolean;
  13:   nextCursorBefore?: string;
  14: }
  15: 
  16: export interface MessagesInfiniteData {
  17:   pages: MessagesPage[];
  18:   pageParams: unknown[];
  19: }
  20: 
  21: const OPTIMISTIC_ID_PREFIX = 'temp-';
  22: 
  23: const getTimeMs = (value: Date | string): number => {
  24:   const time = value instanceof Date ? value.getTime() : new Date(value).getTime();
  25:   return Number.isFinite(time) ? time : NaN;
  26: };
  27: 
  28: export const isOptimisticMatch = (existing: Message, incoming: Message): boolean => {
  29:   if (!existing.id.startsWith(OPTIMISTIC_ID_PREFIX)) {
  30:     return false;
  31:   }
  32:   if (existing.senderId !== incoming.senderId) {
  33:     return false;
  34:   }
  35:   if (existing.content !== incoming.content) {
  36:     return false;
  37:   }
  38: 
  39:   const existingTime = getTimeMs(existing.timestamp);
  40:   const incomingTime = getTimeMs(incoming.timestamp);
  41: 
  42:   return (
  43:     Number.isFinite(existingTime) &&
  44:     Number.isFinite(incomingTime) &&
  45:     Math.abs(existingTime - incomingTime) <= 1000
  46:   );
  47: };
  48: 
  49: const replaceAt = (
  50:   oldData: MessagesInfiniteData,
  51:   pageIndex: number,
  52:   messageIndex: number,
  53:   message: Message
  54: ): MessagesInfiniteData => {
  55:   const pages = [...oldData.pages];
  56:   const messages = [...pages[pageIndex].messages];
  57:   messages[messageIndex] = message;
  58:   pages[pageIndex] = { ...pages[pageIndex], messages };
  59:   return { ...oldData, pages };
  60: };
  61: 
  62: /**
  63:  * Merges an incoming message into the infinite-query cache:
  64:  * - id already present in ANY page → no-op (realtime echo / duplicate event);
  65:  * - a matching optimistic `temp-` message → replaced in place (attachments
  66:  *   from the optimistic copy survive, because realtime rows never carry them);
  67:  * - otherwise → appended to page 0, the newest window.
  68:  */
  69: export function appendMessageToPages(
  70:   oldData: MessagesInfiniteData | undefined,
  71:   message: Message
  72: ): MessagesInfiniteData {
  73:   if (!oldData || !oldData.pages || oldData.pages.length === 0) {
  74:     return { pages: [{ messages: [message] }], pageParams: [undefined] };
  75:   }
  76: 
  77:   for (const page of oldData.pages) {
  78:     if (page.messages.some((existing) => existing.id === message.id)) {
  79:       return oldData;
  80:     }
  81:   }
  82: 
  83:   // An optimistic incoming message (the send path) must never swallow another
  84:   // pending temp- message with identical content sent moments before.
  85:   if (!message.id.startsWith(OPTIMISTIC_ID_PREFIX)) {
  86:     for (let pageIndex = 0; pageIndex < oldData.pages.length; pageIndex++) {
  87:       const messageIndex = oldData.pages[pageIndex].messages.findIndex((existing) =>
  88:         isOptimisticMatch(existing, message)
  89:       );
  90:       if (messageIndex >= 0) {
  91:         const optimistic = oldData.pages[pageIndex].messages[messageIndex];
  92:         const merged: Message = {
  93:           ...message,
  94:           attachments: message.attachments?.length ? message.attachments : optimistic.attachments,
  95:         };
  96:         return replaceAt(oldData, pageIndex, messageIndex, merged);
  97:       }
  98:     }
  99:   }
 100: 
 101:   const pages = [...oldData.pages];
 102:   pages[0] = { ...pages[0], messages: [...pages[0].messages, message] };
 103:   return { ...oldData, pages };
 104: }
 105: 
 106: /** Replaces a message by id across all pages (optimistic → saved swap). */
 107: export function replaceMessageInPages(
 108:   oldData: MessagesInfiniteData | undefined,
 109:   previousId: string,
 110:   message: Message
 111: ): MessagesInfiniteData | undefined {
 112:   if (!oldData || !oldData.pages) {
 113:     return oldData;
 114:   }
 115: 
 116:   // If the saved id already landed via realtime, drop the optimistic copy
 117:   // instead of swapping it in twice.
 118:   const savedAlreadyPresent = oldData.pages.some((page) =>
 119:     page.messages.some((existing) => existing.id === message.id)
 120:   );
 121:   if (savedAlreadyPresent) {
 122:     return {
 123:       ...oldData,
 124:       pages: oldData.pages.map((page) => ({
 125:         ...page,
 126:         messages: page.messages.filter((existing) => existing.id !== previousId),
 127:       })),
 128:     };
 129:   }
 130: 
 131:   for (let pageIndex = 0; pageIndex < oldData.pages.length; pageIndex++) {
 132:     const messageIndex = oldData.pages[pageIndex].messages.findIndex(
 133:       (existing) => existing.id === previousId
 134:     );
 135:     if (messageIndex >= 0) {
 136:       return replaceAt(oldData, pageIndex, messageIndex, message);
 137:     }
 138:   }
 139: 
 140:   // Neither copy is cached: a refetch that read the server before the save
 141:   // committed replaced the page and dropped the optimistic copy. The saved
 142:   // message is persisted, so it belongs in the feed.
 143:   return appendMessageToPages(oldData, message);
 144: }
 145: 
 146: const messagesQueryKey = (conversationId: string) => ['messages', conversationId] as const;
 147: 
 148: const isMessageCached = (data: MessagesInfiniteData | undefined, messageId: string): boolean =>
 149:   Boolean(data?.pages?.some((page) => page.messages.some((existing) => existing.id === messageId)));
 150: 
 151: /**
 152:  * Whether a conversation's feed cache holds the message right now. Components
 153:  * render the feed from a provider that re-renders only once TanStack Query
 154:  * delivers its (deferred) observer notification, so the rendered list can
 155:  * briefly lag behind the cache.
 156:  */
 157: export function isMessageInFeedCache(
 158:   queryClient: QueryClient,
 159:   conversationId: string,
 160:   messageId: string
 161: ): boolean {
 162:   return isMessageCached(
 163:     queryClient.getQueryData<MessagesInfiniteData>(messagesQueryKey(conversationId)),
 164:     messageId
 165:   );
 166: }
 167: 
 168: /**
 169:  * Keeps a just-merged message (a resolved send, a realtime INSERT) in the
 170:  * feed when a fetch of that feed is already in flight.
 171:  *
 172:  * A fetch resolves with the server rows it read when it started and replaces
 173:  * the cached pages. If the message was committed after that read, the result
 174:  * lacks it and would silently drop it from the feed until some later
 175:  * refetch. Once the in-flight fetch settles the message is merged again
 176:  * (a no-op when the result already has it). If the message leaves the cache
 177:  * while the fetch is still running (deleted, or a failed send rolled back),
 178:  * it is not brought back.
 179:  */
 180: export function keepMessageThroughInflightFetch(
 181:   queryClient: QueryClient,
 182:   conversationId: string,
 183:   message: Message
 184: ): void {
 185:   const queryKey = messagesQueryKey(conversationId);
 186:   const queryCache = queryClient.getQueryCache();
 187:   const query = queryCache.find<MessagesInfiniteData>({ queryKey, exact: true });
 188:   if (!query || query.state.fetchStatus !== 'fetching') {
 189:     return;
 190:   }
 191: 
 192:   const unsubscribe = queryCache.subscribe((event) => {
 193:     if (event.query !== query) {
 194:       return;
 195:     }
 196:     if (event.type === 'removed') {
 197:       unsubscribe();
 198:       return;
 199:     }
 200:     if (event.type !== 'updated') {
 201:       return;
 202:     }
 203:     if (query.state.fetchStatus === 'fetching') {
 204:       // Until the fetch settles, data only changes through local updates.
 205:       if (!isMessageCached(query.state.data, message.id)) {
 206:         unsubscribe();
 207:       }
 208:       return;
 209:     }
 210:     unsubscribe();
 211:     queryClient.setQueryData<MessagesInfiniteData | undefined>(queryKey, (oldData) =>
 212:       oldData ? appendMessageToPages(oldData, message) : oldData
 213:     );
 214:   });
 215: }
