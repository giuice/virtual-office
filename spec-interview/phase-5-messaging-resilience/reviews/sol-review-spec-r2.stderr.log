  66:  * page loaded is not announced either: messages that already existed are
  67:  * never announced (TRACK T31).
  68:  */
  69: export function useIncomingMessageNotifications({
  70:   currentUserId,
  71:   conversationsLoaded,
  72:   getCachedConversations,
  73:   viewedConversationId,
  74:   onOpenConversation,
  75: }: UseIncomingMessageNotificationsOptions) {
  76:   const { companyUsers } = useCompany();
  77:   const viewedConversationIdRef = useRef(viewedConversationId);
  78:   const companyUsersRef = useRef(companyUsers);
  79:   const onOpenConversationRef = useRef(onOpenConversation);
