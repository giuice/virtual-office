  82:   useEffect(() => {
  83:     viewedConversationIdRef.current = viewedConversationId;
  84:     companyUsersRef.current = companyUsers;
  85:     onOpenConversationRef.current = onOpenConversation;
  86:   }, [viewedConversationId, companyUsers, onOpenConversation]);
  87: 
  88:   // The state at load: the first list this page received for this user.
  89:   const readLoadBaseline = useCallback((): LoadBaseline | null => {
  90:     if (!currentUserId) return null;
  91:     if (loadBaselineRef.current?.userId !== currentUserId) {
  92:       const conversations = getCachedConversations();
  93:       loadBaselineRef.current = conversations.length > 0 || conversationsLoaded
  94:         ? captureLoadBaseline(currentUserId, conversations)
  95:         : null;
