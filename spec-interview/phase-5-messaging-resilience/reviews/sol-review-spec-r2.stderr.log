 177:       setActionLoading(false);
 178:     }
 179:   }, [supabaseClient]);
 180: 
 181:   const signOut = useCallback(async () => { setActionLoading(true);
 182:     setActionError(null);
 183:     let presenceError: unknown = null;
 184:     let localSignOutError: unknown = null;
 185:     const cleanupErrors: unknown[] = [];
 186:     let cleanupAttempted = false;
 187:     const cleanPresenceClient = (): void => {
 188:       if (cleanupAttempted) return;
 189:       cleanupAttempted = true;
 190:       try {
 191:         invalidatePresenceClientLifecycle({ reason: 'logout' });
 192:       } catch (error) {
 193:         cleanupErrors.push(error);
 194:       }
 195:       try {
 196:         queryClient.removeQueries({ queryKey: presenceQueryKeys.all });
 197:       } catch (error) {
 198:         cleanupErrors.push(error);
 199:       }
 200:       clearPresenceStorage();
 201:     };
 202:     try {
 203:       if (user) {
 204:         try {
 205:           await fencePresenceLogout();
 206:         } catch (error) {
 207:           presenceError = error;
 208:         }
 209:       }
 210: 
 211:       // Clear the old tenant generation before Supabase emits SIGNED_OUT and
 212:       // consumers can begin rendering the next identity.
 213:       cleanPresenceClient();
 214: 
 215:       try {
 216:         const { error } = await supabaseClient.auth.signOut({ scope: 'local' });
 217:         localSignOutError = error;
 218:       } catch (error) {
 219:         localSignOutError = error;
 220:       }
 221:     } finally {
 222:       cleanPresenceClient();
 223:       setActionLoading(false);
 224:     }
 225: 
 226:     const signOutError = combineSignOutErrors(
 227:       presenceError,
 228:       localSignOutError,
 229:       cleanupErrors,
 230:     );
 231:     if (signOutError) {
 232:       console.error('Sign out error:', signOutError);
 233:       const friendlyMessage = mapSupabaseAuthError(signOutError);
 234:       setActionError(friendlyMessage);
 235:       throw new Error(friendlyMessage, { cause: signOutError });
 236:     }
 237:   }, [queryClient, supabaseClient, user]);
 238: 
 239:   const value: AuthContextType = useMemo(
 240:     () => ({ session, user, loading: sessionLoading, error: sessionError, isAuthReady, signIn, signOut, signUp, 
signInWithGoogle, actionLoading, actionError }),
 241:     [
 242:       actionError,
 243:       actionLoading,
 244:       isAuthReady,
 245:       session,
 246:       sessionError,
 247:       sessionLoading,
 248:       signIn,
 249:       signInWithGoogle,
 250:       signOut,
 251:       signUp,
 252:       user,
 253:     ],
 254:   );
 255: 
 256:   return <AuthContext.Provider value={value}>{children}</AuthContext.Provider>;
 257: }
 258: 
 259: export function useAuth() { const context = use(AuthContext);
 260:   if (context === undefined) {
 261:     throw new Error('useAuth must be used within an AuthProvider'); }
 262:   return context;
 263: }
