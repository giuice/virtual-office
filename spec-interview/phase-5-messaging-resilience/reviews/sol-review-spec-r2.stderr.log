 162: function claimAcrossTabs(messageId: string): boolean {
 163:   try {
 164:     const now = Date.now();
 165:     const raw = window.localStorage.getItem(NOTIFIED_STORAGE_KEY);
 166:     const parsed: unknown = raw ? JSON.parse(raw) : {};
 167:     const claims: Record<string, number> = {};
 168:     if (parsed && typeof parsed === 'object' && !Array.isArray(parsed)) {
 169:       for (const [id, at] of Object.entries(parsed as Record<string, unknown>)) {
 170:         if (typeof at === 'number' && now - at < NOTIFIED_TTL_MS) claims[id] = at;
 171:       }
 172:     }
 173:     if (claims[messageId] !== undefined) return false;
 174:     claims[messageId] = now;
 175:     window.localStorage.setItem(NOTIFIED_STORAGE_KEY, JSON.stringify(claims));
 176:     return true;
 177:   } catch {
 178:     // No shared storage: this tab alone decides.
 179:     return true;
 180:   }
 181: }
