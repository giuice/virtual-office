 104:   return useCallback(async (message: Message, conversation: Conversation) => {
 105:     // Disabled, denied, or unsupported: nothing is attempted (AC-028).
 106:     if (!currentUserId || readDesktopNotificationStatus(currentUserId) !== 'enabled') return;
 107: 
 108:     // Already in the conversation's activity when this page loaded: it existed
 109:     // before, even if Realtime delivers it late. Both times are server times.
 110:     const loadedActivity = readLoadBaseline()?.lastActivityByConversation.get(conversation.id);
 111:     const sentAt = new Date(message.timestamp).getTime();
 112:     if (loadedActivity !== undefined && Number.isFinite(sentAt) && sentAt <= loadedActivity) return;
 113: 
 114:     const decision = decideIncomingMessage({
 115:       message,
 116:       conversation,
 117:       currentUserId,
 118:       viewedConversationId: viewedConversationIdRef.current,
