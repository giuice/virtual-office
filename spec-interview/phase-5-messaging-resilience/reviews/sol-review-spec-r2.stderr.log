 219: /**
 220:  * POST /api/messages/create
 221:  * Body: { conversationId, content, type?, replyToId?, clientMessageId?, attachmentIds? }
 222:  * `content` may be empty (or omitted) only when `attachmentIds` lists 1–5 of
 223:  * the caller's pending uploads for this conversation (Phase 4 T12); the type
 224:  * of such a message is derived from its attachments (image or file; a voice
 225:  * note — Phase 4 T15 — is the only attachment of a file message).
 226:  * 201 created; 200 replay of `clientMessageId` (nothing inserted or linked);
 227:  * 409 CLIENT_MESSAGE_ID_REUSED when the replay's composition differs.
 228:  */
 229: export async function POST(request: NextRequest) {
 230:   try {
 231:     let body: Record<string, unknown>;
 232:     try {
 233:       body = await request.json();
 234:     } catch {
 235:       return jsonError(400, 'BAD_REQUEST', 'Invalid JSON payload');
 236:     }
 237:     if (typeof body !== 'object' || body === null || Array.isArray(body)) {
 238:       return jsonError(400, 'BAD_REQUEST', 'Invalid JSON payload');
 239:     }
 240: 
 241:     const attachmentIds = parseAttachmentIds(body.attachmentIds);
 242:     if (!attachmentIds.ok) {
 243:       return jsonError(400, attachmentIds.code, attachmentIds.message);
 244:     }
 245:     const hasAttachments = attachmentIds.value !== undefined;
 246: 
 247:     const conversationId = typeof body.conversationId === 'string' ? body.conversationId : null;
 248:     const rawContent = body.content === undefined && hasAttachments ? '' : body.content;
 249:     if (!conversationId || typeof rawContent !== 'string') {
 250:       return jsonError(400, 'BAD_REQUEST', 'Missing required fields: conversationId, content');
 251:     }
 252: 
 253:     const trimmedContent = rawContent.trim();
 254:     if (trimmedContent.length === 0 && !hasAttachments) {
 255:       return jsonError(400, 'BAD_REQUEST', 'Content must not be empty');
 256:     }
 257:     if (trimmedContent.length > MAX_CONTENT_LENGTH) {
 258:       return jsonError(413, 'CONTENT_TOO_LARGE', `Content exceeds the ${MAX_CONTENT_LENGTH} character limit`);
 259:     }
 260: 
 261:     const clientMessageId = parseClientMessageId(body.clientMessageId);
 262:     if (!clientMessageId.ok) {
 263:       return jsonError(400, 'INVALID_CLIENT_MESSAGE_ID', 'clientMessageId must be a UUID');
 264:     }
 265: 
 266:     const ctx = await requireConversationParticipant(conversationId);
 267:     if (isAuthzFailure(ctx)) {
 268:       return ctx.errorResponse;
 269:     }
 270:     const { serviceClient, dbUser, conversation } = ctx;
 271: 
 272:     const rateLimited = await enforceRateLimit(serviceClient, dbUser.id, 'message:create');
 273:     if (rateLimited) {
 274:       return rateLimited;
 275:     }
 276: 
 277:     const messageRepository: IMessageRepository = new SupabaseMessageRepository(serviceClient);
 278:     const conversationRepository: IConversationRepository = new SupabaseConversationRepository(serviceClient);
 279: 
 280:     // Audit S-04: replyToId must reference a message in the SAME conversation.
 281:     let replyToId: string | undefined;
 282:     if (body.replyToId !== undefined && body.replyToId !== null) {
 283:       if (typeof body.replyToId !== 'string') {
 284:         return jsonError(400, 'BAD_REQUEST', 'replyToId must be a string');
 285:       }
 286:       const { data: replyTarget, error: replyError } = await serviceClient
 287:         .from('messages')
 288:         .select('id, conversation_id')
 289:         .eq('id', body.replyToId)
 290:         .maybeSingle();
 291:       if (replyError) {
 292:         console.error('Failed to validate replyToId:', replyError.message);
 293:         return jsonError(500, 'INTERNAL_ERROR', 'Failed to create message');
 294:       }
 295:       if (!replyTarget || replyTarget.conversation_id !== conversation.id) {
 296:         return jsonError(400, 'INVALID_REPLY_TARGET', 'replyToId must reference a message in the same 
conversation');
 297:       }
 298:       replyToId = replyTarget.id;
 299:     }
 300: 
 301:     const baseMessageData: Omit<MessageCreateData, 'type'> = {
 302:       conversationId: conversation.id,
 303:       senderId: dbUser.id,
 304:       content: trimmedContent,
 305:       // Audit S-04: never trust client-supplied status (pre-marked read/delivered).
 306:       status: MessageStatus.SENT,
 307:       replyToId,
 308:     };
 309: 
 310:     if (attachmentIds.value) {
 311:       const result = await createWithAttachments(
 312:         serviceClient,
 313:         messageRepository,
 314:         conversationRepository,
 315:         new SupabaseMessageAttachmentUploadRepository(serviceClient),
 316:         baseMessageData,
 317:         attachmentIds.value,
 318:         clientMessageId.value
 319:       );
 320:       return result.response;
 321:     }
 322: 
 323:     const safeType: MessageType = Object.values(MessageType).includes(body.type as MessageType)
 324:       ? (body.type as MessageType)
 325:       : MessageType.TEXT;
 326:     const messageData: MessageCreateData = { ...baseMessageData, type: safeType };
 327: 
 328:     let createdMessage: Message;
 329:     if (clientMessageId.value) {
 330:       const outcome = await messageRepository.createWithClientKey(messageData, clientMessageId.value);
 331:       if (!outcome.created) {
 332:         // A retry of a composition whose create already committed (e.g. its
 333:         // response was lost): answer with the stored message, insert nothing.
 334:         // The key is per composition, so a different payload — including a
 335:         // stored message that carries attachments — is a client bug.
 336:         const stored = (await messageRepository.findById(outcome.message.id)) ?? outcome.message;
 337:         const linkedIds = await new 
SupabaseMessageAttachmentUploadRepository(serviceClient).listLinkedAttachmentIds(stored.id);
 338:         if (!isSameComposition(stored, linkedIds, { ...messageData, attachmentIds: [] })) {
 339:           return clientKeyReused();
 340:         }
 341:         return NextResponse.json({ message: asResponseMessage(stored) }, { status: 200 });
 342:       }
 343:       createdMessage = outcome.message;
 344:     } else {
 345:       createdMessage = await messageRepository.create(messageData);
 346:     }
 347: 
 348:     await touchConversation(conversationRepository, conversation.id);
 349: 
 350:     return NextResponse.json({ message: createdMessage }, { status: 201 });
 351:   } catch (error) {
 352:     console.error('Error creating message:', error);
 353:     return jsonError(500, 'INTERNAL_ERROR', 'Failed to create message');
 354:   }
 355: }
