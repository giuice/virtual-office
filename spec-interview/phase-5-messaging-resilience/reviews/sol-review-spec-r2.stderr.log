  53:   -- Bounded input: the route caps the batch at 100 ids as well.
  54:   if pg_catalog.cardinality(p_message_ids) > 100 then
  55:     raise exception 'mark_messages_read: at most 100 message ids per call'
  56:       using errcode = '22023';
