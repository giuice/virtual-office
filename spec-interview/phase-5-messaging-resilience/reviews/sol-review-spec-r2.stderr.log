 141: const serverStatus = (): DesktopNotificationStatus => 'unsupported';
 142: 
 143: /** State and actions of the drawer's desktop-notification control. */
 144: export function useDesktopNotificationSetting(currentUserId: string | undefined) {
 145:   const getStatus = useCallback(() => readDesktopNotificationStatus(currentUserId), [currentUserId]);
 146:   const status = useSyncExternalStore(subscribeDesktopNotificationStatus, getStatus, serverStatus);
 147: 
 148:   /** User action only: asks for permission when needed, then turns them on. */
 149:   const enable = useCallback(async (): Promise<DesktopNotificationStatus> => {
 150:     if (!currentUserId) return readDesktopNotificationStatus(currentUserId);
 151:     const permission = await requestDesktopNotificationPermission();
 152:     // Also written when refused, so the control re-reads the new permission.
 153:     writeDesktopNotificationPreference(currentUserId, permission === 'granted');
 154:     return readDesktopNotificationStatus(currentUserId);
 155:   }, [currentUserId]);
 156: 
 157:   const disable = useCallback(() => {
 158:     if (currentUserId) writeDesktopNotificationPreference(currentUserId, false);
 159:   }, [currentUserId]);
 160: 
 161:   return { status, enable, disable };
 162: }

