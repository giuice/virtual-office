  47: 
  48: /** Init script: records Notification constructions and permission requests. */
  49: function installNotificationRecorder(): void {
  50:   const target = window as unknown as {
  51:     __notificationRecord: NotificationRecord;
  52:     __notificationInstances: Notification[];
  53:   };
  54:   target.__notificationRecord = { constructed: [], permissionRequests: 0 };
  55:   target.__notificationInstances = [];
  56:   const RealNotification = window.Notification;
  57:   if (typeof RealNotification !== 'function') return;
  58:   class RecordingNotification extends RealNotification {
  59:     constructor(title: string, options?: NotificationOptions) {
  60:       // Recorded before construction, so an attempt that throws still counts.
  61:       target.__notificationRecord.constructed.push({
  62:         title,
  63:         body: options?.body ?? '',
  64:         tag: options?.tag ?? '',
  65:       });
  66:       super(title, options);
  67:       target.__notificationInstances.push(this);
  68:     }
  69: 
  70:     static requestPermission(callback?: NotificationPermissionCallback): Promise<NotificationPermission> {
  71:       target.__notificationRecord.permissionRequests += 1;
  72:       return RealNotification.requestPermission(callback);
  73:     }
  74:   }
  75:   Object.defineProperty(window, 'Notification', {
  76:     value: RecordingNotification,
  77:     writable: true,
  78:     configurable: true,
  79:   });
  80: }
