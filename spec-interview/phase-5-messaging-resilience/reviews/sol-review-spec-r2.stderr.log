 210:   const sendMessage = useCallback(
 211:     async (
 212:       content: string,
 213:       options?: {
 214:         replyToId?: string;
 215:         attachments?: FileAttachment[];
 216:         type?: MessageType;
 217:         // Composition key (FR-024): a retry with the same key gets back the
 218:         // message already stored, which then replaces this optimistic copy.
 219:         clientMessageId?: string;
 220:       }
 221:     ) => {
 222:       const trimmedContent = content.trim();
 223:       const attachments = options?.attachments?.length ? options.attachments : undefined;
 224:       // Attachment messages take their type from their files, as the server
 225:       // derives it (all images → image, otherwise file).
 226:       const messageType = attachments
 227:         ? attachmentMessageType(attachments.map((attachment) => attachment.type))
 228:         : options?.type || MessageType.TEXT;
 229:       const instrumentationEnabled = debugLogger.messaging.enabled();
 230:       const traceId = instrumentationEnabled ? createTraceId('hook-send') : '';
 231: 
 232:       if (!currentUserProfile?.id || !activeConversationId || (!trimmedContent && !attachments)) {
 233:         if (instrumentationEnabled) {
 234:           debugLogger.messaging.trace('useMessages.sendMessage', 'skip:missing-context', {
 235:             traceId,
 236:             hasProfile: Boolean(currentUserProfile?.id),
 237:             conversationId: activeConversationId,
 238:             hasContent: Boolean(trimmedContent),
 239:           });
 240:         }
 241:         return;
 242:       }
 243: 
 244:       const start = instrumentationEnabled ? getTimestamp() : 0;
 245:       if (instrumentationEnabled) {
 246:         debugLogger.messaging.event('useMessages.sendMessage', 'optimistic:start', {
 247:           traceId,
 248:           conversationId: activeConversationId,
 249:           contentLength: trimmedContent.length,
 250:           type: messageType,
 251:           attachments: attachments?.length || 0,
 252:         });
 253:       }
 254: 
 255:       const now = new Date();
 256:       const optimisticMessage: Message = {
 257:         id: `temp-${now.getTime()}`,
 258:         conversationId: activeConversationId,
 259:         senderId: currentUserProfile.id, // DB ID for UI representation
 260:         content: trimmedContent,
 261:         timestamp: now,
 262:         status: MessageStatus.SENDING,
 263:         type: messageType,
 264:         replyToId: options?.replyToId,
 265:         attachments,
 266:         reactions: [],
 267:         isEdited: false,
 268:       };
 269: 
 270:       // Optimistically add to page 0 (newest window) via the shared helper (B-04)
 271:       queryClient.setQueryData<MessagesInfiniteData | undefined>(
 272:         ['messages', activeConversationId],
 273:         (oldData) => appendMessageToPages(oldData, optimisticMessage)
 274:       );
 275: 
 276:       if (instrumentationEnabled) {
 277:         debugLogger.messaging.event('useMessages.sendMessage', 'optimistic:applied', {
 278:           traceId,
 279:           optimisticId: optimisticMessage.id,
 280:           conversationId: activeConversationId,
 281:         });
 282:       }
 283: 
 284:       try {
 285:         // Server derives sender from session; do not send senderId
 286:         const savedMessage = await messagingApi.sendMessage(
 287:           {
 288:             conversationId: activeConversationId,
 289:             content: trimmedContent,
 290:             replyToId: options?.replyToId,
 291:             type: messageType,
 292:           },
 293:           {
 294:             clientMessageId: options?.clientMessageId,
 295:             attachmentIds: attachments?.map((attachment) => attachment.id),
 296:           }
 297:         );
 298: 
 299:         if (instrumentationEnabled) {
 300:           const duration = start ? getTimestamp() - start : 0;
 301:           if (start) {
 302:             debugLogger.messaging.metric('useMessages.sendMessage', 'roundtrip', duration, {
 303:               traceId,
 304:               conversationId: activeConversationId,
 305:               messageId: savedMessage.id,
 306:             });
 307:           }
 308:           debugLogger.messaging.event('useMessages.sendMessage', 'api:success', {
 309:             traceId,
 310:             messageId: savedMessage.id,
 311:             status: savedMessage.status,
 312:           });
 313:         }
 314: 
 315:         // Replace optimistic with saved (drops the temp copy if realtime
 316:         // already delivered the saved id)
 317:         queryClient.setQueryData<MessagesInfiniteData | undefined>(
 318:           ['messages', activeConversationId],
 319:           (oldData) => replaceMessageInPages(oldData, optimisticMessage.id, savedMessage)
 320:         );
 321:         keepMessageThroughInflightFetch(queryClient, activeConversationId, savedMessage);
 322:         return savedMessage;
 323:       } catch (err) {
 324:         if (instrumentationEnabled) {
 325:           const duration = start ? getTimestamp() - start : 0;
 326:           debugLogger.messaging.error('useMessages.sendMessage', 'api:error', {
 327:             traceId,
 328:             conversationId: activeConversationId,
 329:             duration,
 330:             error: err instanceof Error ? err.message : err,
 331:           });
 332:         }
 333:         // Remove the optimistic message on failure so UI does not show a failed temp message
 334:         queryClient.setQueryData<MessagesInfiniteData | undefined>(
 335:           ['messages', activeConversationId],
 336:           (oldData) => {
 337:             if (!oldData || !oldData.pages) return oldData;
 338:             const updatedPages = oldData.pages.map((page) => ({
 339:               ...page,
 340:               messages: page.messages.filter((m) => m.id !== optimisticMessage.id),
 341:             }));
 342:             return { ...oldData, pages: updatedPages };
 343:           }
 344:         );
 345:         throw err;
 346:       }
 347:     },
 348:     [activeConversationId, currentUserProfile?.id, queryClient]
 349:   );
