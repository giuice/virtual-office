 232:     notification.onclick = () => {
 233:       try {
 234:         window.focus();
 235:       } catch {
 236:         // Focusing is best effort.
 237:       }
 238:       onClick();
 239:       notification.close();
 240:     };
 241:     return notification;
 242:   } catch {
 243:     // e.g. browsers that only allow notifications from a service worker.
 244:     return null;
 245:   }
