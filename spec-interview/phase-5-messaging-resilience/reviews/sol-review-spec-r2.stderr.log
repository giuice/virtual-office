   1: // src/lib/auth/rate-limit.ts
   2: import { NextResponse } from 'next/server';
   3: import type { SupabaseClient } from '@supabase/supabase-js';
   4: import { jsonError } from '@/lib/auth/authorize';
   5: 
   6: // Audit M-09: per-user fixed-window limits for messaging mutations.
   7: // Enforced by the service-role-only check_rate_limit RPC (shared Postgres
   8: // counter, safe across serverless instances).
   9: const RATE_LIMITS = {
  10:   'message:create': { limit: 30, windowSeconds: 60 },
  11:   'message:react': { limit: 60, windowSeconds: 60 },
  12:   // Phase 4 T13: one upload per file, up to 5 files per message, plus retries
  13:   // of failed uploads; 10/min refused the second full message in a minute.
  14:   // 30/min = six 5-file messages, in line with message:create (each file is
  15:   // still capped at 10 MB and only links to the uploader's own message).
  16:   'message:upload': { limit: 30, windowSeconds: 60 },
  17:   // Phase 4 T12: cancelling pending uploads (composer remove/cancel).
  18:   'message:upload-cancel': { limit: 60, windowSeconds: 60 },
  19:   // Visible-message receipts are batched by the drawer while it scrolls.
  20:   'conversation:read-receipts': { limit: 120, windowSeconds: 60 },
  21: } as const;
  22: 
  23: export type RateLimitedAction = keyof typeof RATE_LIMITS;
  24: 
  25: /**
  26:  * Returns a 429 response when the user exceeded the action's limit,
  27:  * null when the request may proceed. Call AFTER the authz check, with the
  28:  * authenticated user's DB id (users.id, not supabase_uid).
  29:  *
  30:  * Fails open: an RPC error (e.g. migration not applied yet) is logged and
  31:  * the request is allowed — rate limiting must never take messaging down.
  32:  */
  33: export async function enforceRateLimit(
  34:   serviceClient: SupabaseClient,
  35:   userDbId: string,
  36:   action: RateLimitedAction
  37: ): Promise<NextResponse | null> {
  38:   const { limit, windowSeconds } = RATE_LIMITS[action];
  39: 
  40:   try {
  41:     const { data: allowed, error } = await serviceClient.rpc('check_rate_limit', {
  42:       p_user_id: userDbId,
  43:       p_action: action,
  44:       p_limit: limit,
  45:       p_window_seconds: windowSeconds,
  46:     });
  47: 
  48:     if (error) {
  49:       console.error(`Rate limit check failed for ${action}:`, error);
  50:       return null;
  51:     }
  52: 
  53:     if (allowed === false) {
  54:       return jsonError(429, 'rate_limited', 'Too many requests. Please slow down.');
  55:     }
  56: 
  57:     return null;
  58:   } catch (error) {
  59:     console.error(`Rate limit check threw for ${action}:`, error);
  60:     return null;
  61:   }
  62: }

