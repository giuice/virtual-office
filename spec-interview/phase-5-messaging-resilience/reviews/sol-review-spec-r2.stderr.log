 183: /**
 184:  * Claims a message so it is announced (or knowingly left unannounced) once:
 185:  * once per tab, and once across this browser's tabs of the app. The
 186:  * cross-tab check-and-set runs under a Web Lock, which makes it atomic
 187:  * between tabs; without Web Locks it is best effort.
 188:  */
 189: export async function claimMessageNotification(messageId: string): Promise<boolean> {
 190:   if (!rememberTabClaim(messageId)) return false;
 191:   const locks = typeof navigator !== 'undefined' ? navigator.locks : undefined;
 192:   if (locks?.request) {
 193:     try {
 194:       return await locks.request(NOTIFIED_LOCK_NAME, () => claimAcrossTabs(messageId));
 195:     } catch {
 196:       return claimAcrossTabs(messageId);
 197:     }
 198:   }
 199:   return claimAcrossTabs(messageId);
 200: }
