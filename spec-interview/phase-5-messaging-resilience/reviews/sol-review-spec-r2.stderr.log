  41: declare
  42:   v_recorded integer;
  43: begin
  44:   if p_conversation_id is null or p_user_id is null then
  45:     raise exception 'mark_messages_read: conversation and user are required'
  46:       using errcode = '22004';
  47:   end if;
  48: 
  49:   if p_message_ids is null or pg_catalog.cardinality(p_message_ids) = 0 then
  50:     return 0;
