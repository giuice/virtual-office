 100: --    aggregate, no N+1). Viewer derived server-side; counts are never exposed
 101: --    for other users (fixes the unread_count JSONB privacy leak).
 102: --    sender_id IS DISTINCT FROM user_id so system messages (null sender)
 103: --    count as unread too.
 104: -- ============================================================================
 105: -- Drop first: an older version may exist with different parameter names,
 106: -- and CREATE OR REPLACE cannot rename parameters (error 42P13).
 107: drop function if exists public.get_unread_counts(uuid[]);
 108: create function public.get_unread_counts(p_conversation_ids uuid[])
 109: returns table (conversation_id uuid, unread_count bigint)
 110: language sql
 111: stable
 112: security definer
 113: set search_path = public, pg_temp
 114: as $$
 115:   select cm.conversation_id, count(m.id)::bigint
 116:   from public.conversation_members cm
 117:   left join public.messages m
 118:     on m.conversation_id = cm.conversation_id
 119:    and m."timestamp" > coalesce(cm.last_read_at, '-infinity'::timestamptz)
 120:    and m.sender_id is distinct from cm.user_id
 121:   where cm.user_id = private.current_app_user_id()
 122:     and cm.conversation_id = any (p_conversation_ids)
 123:   group by cm.conversation_id
 124: $$;
 125: 
 126: revoke all on function public.get_unread_counts(uuid[]) from public;
 127: grant execute on function public.get_unread_counts(uuid[]) to authenticated;
 128: 
 129: -- ============================================================================
 130: -- 6) RPC: atomic mark-read. Sets the read cursor AND writes per-message
 131: --    receipts for everything the user just saw, in one transaction
 132: --    (supabase-js cannot express INSERT...SELECT). service_role only — the
 133: --    /api/conversations/read route gates with requireConversationParticipant.
 134: -- ============================================================================
 135: -- A legacy mark_conversation_read(uuid, uuid) exists in the live DB with old
 136: -- parameter names ("conv_id") — must drop before recreating (error 42P13).
 137: drop function if exists public.mark_conversation_read(uuid, uuid);
 138: create function public.mark_conversation_read(p_conversation_id uuid, p_user_id uuid)
 139: returns void
 140: language plpgsql
 141: security definer
 142: set search_path = public, pg_temp
 143: as $$
 144: begin
 145:   insert into public.conversation_members (conversation_id, user_id, last_read_at)
 146:   values (p_conversation_id, p_user_id, now())
 147:   on conflict (conversation_id, user_id)
 148:     do update set last_read_at = now(), updated_at = now();
 149: 
 150:   insert into public.message_read_receipts (message_id, conversation_id, user_id)
 151:   select m.id, m.conversation_id, p_user_id
 152:   from public.messages m
 153:   where m.conversation_id = p_conversation_id
 154:     and m.sender_id is not null
 155:     and m.sender_id <> p_user_id
 156:   on conflict (message_id, user_id) do nothing;
 157: end $$;
 158: 
 159: revoke all on function public.mark_conversation_read(uuid, uuid) from public, authenticated;
 160: grant execute on function public.mark_conversation_read(uuid, uuid) to service_role;
 161: 
 162: -- ============================================================================
 163: -- 7) Realtime: receipts INSERTs drive the sender's live read indicator.
 164: --    Idempotent — 20251009 phase3 may already have added the table.
 165: --    The existing SELECT policy ("Users can view their own read receipts")
 166: --    already lets the message sender receive these events through WAL RLS.
 167: -- ============================================================================
 168: do $$
 169: begin
 170:   if not exists (
 171:     select 1 from pg_publication_tables
 172:     where pubname = 'supabase_realtime'
 173:       and schemaname = 'public'
 174:       and tablename = 'message_read_receipts'
 175:   ) then
 176:     alter publication supabase_realtime add table public.message_read_receipts;
 177:   end if;
 178: end $$;
