  54:     and (select realtime.topic()) =
  55:         'company:' || private.current_presence_company_id()::text || ':presence'
  56:     and private.is_presence_auth_session_unfenced()
  57: );
  58: 
  59: -- A private channel join always probes Broadcast read authorization alongside
  60: -- Presence read authorization. Permit only that synthetic/read path on the
  61: -- exact company Presence topic; clients still receive no Broadcast INSERT grant.
  62: drop policy if exists phase6_company_presence_channel_broadcast_receive
  63:     on realtime.messages;
  64: create policy phase6_company_presence_channel_broadcast_receive
  65: on realtime.messages
  66: for select
  67: to authenticated
  68: using (
  69:     realtime.messages.extension = 'broadcast'
  70:     and (select realtime.topic()) =
  71:         'company:' || private.current_presence_company_id()::text || ':presence'
  72:     and private.is_presence_auth_session_unfenced()
  73: );
  74: 
  75: drop policy if exists phase6_company_presence_track on realtime.messages;
  76: create policy phase6_company_presence_track
  77: on realtime.messages
  78: for insert
  79: to authenticated
  80: with check (
  81:     realtime.messages.extension = 'presence'
  82:     and (select realtime.topic()) =
  83:         'company:' || private.current_presence_company_id()::text || ':presence'
  84:     and private.is_presence_auth_session_unfenced()
  85: );
  86: 
  87: do $$
  88: declare
  89:     v_users_count integer;
  90:     v_spaces_count integer;
  91:     v_knock_count integer;
  92:     v_presence_policy_count integer;
  93: begin
  94:     select
  95:         pg_catalog.count(*) filter (where tablename = 'users'),
  96:         pg_catalog.count(*) filter (where tablename = 'spaces'),
  97:         pg_catalog.count(*) filter (where tablename = 'knock_requests')
  98:     into v_users_count, v_spaces_count, v_knock_count
  99:     from pg_catalog.pg_publication_tables
 100:     where pubname = 'supabase_realtime'
 101:       and schemaname = 'public'
 102:       and tablename in ('users', 'spaces', 'knock_requests');
 103: 
 104:     if v_users_count <> 1 or v_spaces_count <> 1 or v_knock_count <> 0 then
 105:         raise exception
 106:             'PHASE6_REALTIME_PUBLICATION_READBACK_FAILED users=% spaces=% knock=%',
 107:             v_users_count,
 108:             v_spaces_count,
 109:             v_knock_count;
 110:     end if;
 111: 
 112:     select pg_catalog.count(*)
 113:     into v_presence_policy_count
 114:     from pg_catalog.pg_policies
 115:     where schemaname = 'realtime'
 116:       and tablename = 'messages'
 117:       and policyname in (
 118:           'phase6_company_presence_channel_broadcast_receive',
 119:           'phase6_company_presence_receive',
 120:           'phase6_company_presence_track'
 121:       );
 122: 
 123:     if v_presence_policy_count <> 3 then
 124:         raise exception
 125:             'PHASE6_REALTIME_POLICY_READBACK_FAILED count=%',
 126:             v_presence_policy_count;
 127:     end if;
 128: end;
 129: $$;
 130: 
 131: commit;

