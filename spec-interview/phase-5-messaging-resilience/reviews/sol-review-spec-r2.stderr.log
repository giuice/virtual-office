 123: export function MessageComposer({
 124:   onSendMessage,
 125:   conversationId,
 126:   replyToMessage,
 127:   onCancelReply,
 128:   disabled = false,
 129:   placeholder = "Type a message...",
 130:   initialValue = "",
 131:   onValueChange
 132: }: MessageComposerProps) {
 133:   const [content, setContent] = useState(initialValue);
 134:   // A failed send keeps the draft (text and, via the parent, the reply
 135:   // target) in the composer; this flag drives the error + retry row.
 136:   const [sendFailed, setSendFailed] = useState(false);
 137:   const [isSending, setIsSending] = useState(false);
 138:   // Synchronous guard: a double click/Enter lands before React re-renders
 139:   // the disabled send button, and must not create a second message.
 140:   const sendInFlightRef = useRef(false);
 141:   // The last composition submitted without a confirmed send. A retry of the
 142:   // same text and reply target reuses its key, so a create that committed on
 143:   // the server but lost its response is not stored twice; any other draft is
 144:   // a new composition with a new key.
 145:   const unconfirmedSendRef = useRef<{
 146:     key: string;
 147:     content: string;
 148:     replyToId: string | null;
 149:     attachments: string;
 150:   } | null>(null);
 151:   const textareaRef = useRef<HTMLTextAreaElement>(null);
 152:   const fileInputRef = useRef<HTMLInputElement>(null);
 153:   const imageInputRef = useRef<HTMLInputElement>(null);
 154:   const [isDraggingFiles, setIsDraggingFiles] = useState(false);
 155:   const { companyUsers, currentUserProfile } = useCompany();
 156:   const {
 157:     items: pendingFiles,
 158:     rejections: fileRejections,
 159:     allUploaded,
 160:     addFiles,
 161:     addVoiceNote,
 162:     remove: removePendingFile,
 163:     retry: retryPendingFile,
 164:     setSendingUploadIds,
 165:     clearSent,
 166:     dismissRejections,
 167:     reject: rejectFiles,
 168:   } = useComposerAttachments(conversationId);
 169:   // Voice note (T16): a finished recording becomes the message's only
 170:   // attachment and uploads at once, like a file; text may go with it.
 171:   const recorder = useVoiceRecorder({ conversationId, onRecorded: addVoiceNote });
 172:   const isRecording = recorder.status !== 'idle';
 173:   const voiceNote = pendingFiles.find((item) => item.voice) ?? null;
 174:   const regularFiles = voiceNote ? pendingFiles.filter((item) => !item.voice) : pendingFiles;
 175:   const recordingUnavailable =
 176:     recorder.support === 'unsupported'
 177:       ? 'unsupported'
 178:       : regularFiles.length > 0
 179:         ? 'files-pending'
 180:         : voiceNote
 181:           ? 'voice-pending'
 182:           : null;
 183:   const hasDraft = !!content.trim() || pendingFiles.length > 0;
 184:   // A message is sent only once every file has finished uploading (BR-007)
 185:   // and never in the middle of a recording.
 186:   const canSubmit = hasDraft && allUploaded && !disabled && !isRecording;
 187:   
 188:   // Set focus on textarea when reply mode is activated
 189:   useEffect(() => {
 190:     if (replyToMessage && textareaRef.current) {
 191:       textareaRef.current.focus();
 192:     }
 193:   }, [replyToMessage]);
 194:   
 195:   // Handle content change
 196:   const handleContentChange = (e: React.ChangeEvent<HTMLTextAreaElement>) => {
 197:     const newContent = e.target.value;
 198:     setContent(newContent);
 199:     // Nothing left to retry once the draft is erased.
 200:     if (!newContent.trim() && pendingFiles.length === 0) {
 201:       setSendFailed(false);
 202:       unconfirmedSendRef.current = null;
 203:     }
 204:     
 205:     // Call onValueChange callback if provided
 206:     if (onValueChange) {
 207:       onValueChange(newContent);
 208:     }
 209:   };
 210:   
 211:   const submitDraft = async () => {
 212:     if (!canSubmit || sendInFlightRef.current) return;
 213: 
 214:     const submittedContent = content;
 215:     const attachments = pendingFiles.flatMap((file) => (file.uploaded ? [file.uploaded] : []));
 216:     const attachmentIds = attachments.map((attachment) => attachment.id);
 217:     const composition = {
 218:       content: submittedContent.trim(),
 219:       replyToId: replyToMessage?.id ?? null,
 220:       attachments: attachmentSetKey(attachments),
 221:     };
 222:     const unconfirmed = unconfirmedSendRef.current;
 223:     const clientMessageId =
 224:       unconfirmed &&
 225:       unconfirmed.content === composition.content &&
 226:       unconfirmed.replyToId === composition.replyToId &&
 227:       unconfirmed.attachments === composition.attachments
 228:         ? unconfirmed.key
 229:         : uuidv4();
 230:     unconfirmedSendRef.current = { key: clientMessageId, ...composition };
 231:     sendInFlightRef.current = true;
 232:     setSendingUploadIds(attachmentIds);
 233:     setIsSending(true);
 234:     setSendFailed(false);
 235:     try {
 236:       await onSendMessage(submittedContent, { clientMessageId, attachments });
 237:       unconfirmedSendRef.current = null;
 238:       // Clear only what was sent: text typed or files added while the send
 239:       // was in flight belong to the next message and must survive.
 240:       setContent((current) => (current === submittedContent ? '' : current));
 241:       clearSent(attachmentIds);
 242:     } catch (error) {
 243:       console.error('Failed to send message:', error);
 244:       // The draft (text, reply target, files) stays in the composer; the
 245:       // user can retry it.
 246:       setSendFailed(true);
 247:     } finally {
 248:       sendInFlightRef.current = false;
 249:       setSendingUploadIds([]);
 250:       setIsSending(false);
 251:     }
 252:   };
 253: 
 254:   // Handle form submission
 255:   const handleSubmit = (e: React.FormEvent) => {
 256:     e.preventDefault();
 257:     void submitDraft();
 258:   };
 259: 
 260:   const handleRetry = () => {
 261:     void submitDraft();
 262:     textareaRef.current?.focus();
 263:   };
 264: 
 265:   // Handle key press (Enter to send, Shift+Enter for new line)
 266:   const handleKeyPress = (e: React.KeyboardEvent<HTMLTextAreaElement>) => {
 267:     if (e.key === 'Enter' && !e.shiftKey) {
 268:       e.preventDefault();
 269:       handleSubmit(e);
 270:     }

