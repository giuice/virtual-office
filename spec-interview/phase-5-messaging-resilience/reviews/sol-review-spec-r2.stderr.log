  70:   -- get a receipt (system messages with a null sender may). Repeats are
  71:   -- idempotent on the unique (message_id, user_id).
  72:   insert into public.message_read_receipts (message_id, conversation_id, user_id)
  73:   select m.id, m.conversation_id, p_user_id
  74:   from public.messages m
  75:   where m.conversation_id = p_conversation_id
  76:     and m.id = any (p_message_ids)
  77:     and m.sender_id is distinct from p_user_id
  78:   on conflict (message_id, user_id) do nothing;
