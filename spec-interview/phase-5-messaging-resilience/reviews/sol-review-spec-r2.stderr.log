 223: /** Shows the notification; returns null when the browser refuses to construct it. */
 224: export function showDesktopNotification(
 225:   title: string,
 226:   options: { body: string; tag: string },
 227:   onClick: () => void,
 228: ): Notification | null {
 229:   if (readPermission() !== 'granted') return null;
