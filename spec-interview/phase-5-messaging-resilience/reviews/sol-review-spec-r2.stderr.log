   7: import { debugLogger } from '@/utils/debug-logger';
   8: 
   9: export interface TypingUser {
  10:   userId: string;
  11:   displayName: string;
  12: }
  13: 
  14: // How long a remote "typing" signal stays visible without a refresh.
  15: const REMOTE_TYPING_TTL_MS = 4000;
  16: // Inactivity window before the local user stops broadcasting "typing".
  17: const LOCAL_TYPING_IDLE_MS = 2000;
  18: 
  19: /**
  20:  * Single owner of the `conversation:{id}` Realtime channel: presence tracking
  21:  * plus typing indicators over broadcast (audit B-02 — typing is ephemeral and
  22:  * never touches Postgres). Both send and receive run through the ONE
  23:  * subscribed channel; creating a fresh channel per send leaks channel objects
  24:  * and, with Phoenix topics, can kick the subscribed one off the socket.
  25:  */
  26: export function useConversationPresence(conversationId: string | null) {
  27:   const { user } = useAuth();
  28:   const [presenceState, updatePresenceState] = useReducerState<Record<string, any>>({});
  29:   const [typingUsers, updateTypingUsers] = useReducerState<TypingUser[]>([]);
  30: 
  31:   const channelRef = useRef<RealtimeChannel | null>(null);
  32:   const isSubscribedRef = useRef(false);
  33:   const remoteTypingTimersRef = useRef(new Map<string, ReturnType<typeof setTimeout>>());
  34:   const localTypingRef = useRef(false);
  35:   const localIdleTimerRef = useRef<ReturnType<typeof setTimeout> | null>(null);
  36: 
  37:   const sendTypingIndicator = useCallback((isTyping: boolean) => {
  38:     const channel = channelRef.current;
  39:     if (!channel || !isSubscribedRef.current || !user) return;
  40: 
  41:     const userDisplayName =
  42:       (user.user_metadata as any)?.full_name ||
  43:       (user.user_metadata as any)?.name ||
  44:       user.email?.split('@')[0] ||
  45:       'User';
  46: 
  47:     void channel.send({
  48:       type: 'broadcast',
  49:       event: 'typing',
  50:       payload: { userId: user.id, userDisplayName, isTyping },
  51:     });
  52:   }, [user]);
  53: 
  54:   /** Stop broadcasting "typing" for the local user (blur, send, unmount). */
  55:   const stopTyping = useCallback(() => {
  56:     if (localIdleTimerRef.current) {
  57:       clearTimeout(localIdleTimerRef.current);
  58:       localIdleTimerRef.current = null;
  59:     }
  60:     if (localTypingRef.current) {
  61:       localTypingRef.current = false;
  62:       sendTypingIndicator(false);
  63:     }
  64:   }, [sendTypingIndicator]);
  65: 
  66:   /** Call on every input change; debounces the broadcast and auto-stops. */
  67:   const notifyTyping = useCallback(() => {
  68:     if (!localTypingRef.current) {
  69:       localTypingRef.current = true;
  70:       sendTypingIndicator(true);
  71:     }
  72:     if (localIdleTimerRef.current) {
  73:       clearTimeout(localIdleTimerRef.current);
  74:     }
  75:     localIdleTimerRef.current = setTimeout(stopTyping, LOCAL_TYPING_IDLE_MS);
  76:   }, [sendTypingIndicator, stopTyping]);
  77: 
  78:   useEffect(() => {
  79:     if (!conversationId || !user) {
  80:       return;
  81:     }
  82: 
  83:     const remoteTimers = remoteTypingTimersRef.current;
  84: 
  85:     const clearRemoteTyping = (userId: string) => {
  86:       const timer = remoteTimers.get(userId);
  87:       if (timer) {
  88:         clearTimeout(timer);
  89:         remoteTimers.delete(userId);
  90:       }
  91:       updateTypingUsers(prev => prev.filter(t => t.userId !== userId));
  92:     };
  93: 
  94:     const channel = supabase
  95:       .channel(`conversation:${conversationId}`, {
  96:         config: {
  97:           broadcast: { self: false },
  98:           presence: { key: user.id }
  99:         }
 100:       })
 101:       .on('presence', { event: 'sync' }, () => {
 102:         updatePresenceState(channel.presenceState());
 103:       })
 104:       .on('broadcast', { event: 'typing' }, (payload) => {
 105:         const { userId, userDisplayName, isTyping } = payload.payload ?? {};
 106:         if (!userId || userId === user.id) return;
 107: 
 108:         if (!isTyping) {
 109:           clearRemoteTyping(userId);
 110:           return;
 111:         }
 112: 
 113:         updateTypingUsers(prev =>
 114:           prev.some(t => t.userId === userId)
 115:             ? prev
 116:             : [...prev, { userId, displayName: userDisplayName || 'Someone' }]
 117:         );
 118: 
 119:         // Reset (not stack) the TTL timer so continuous typing stays visible.
 120:         const existing = remoteTimers.get(userId);
 121:         if (existing) clearTimeout(existing);
 122:         remoteTimers.set(
 123:           userId,
 124:           setTimeout(() => {
 125:             remoteTimers.delete(userId);
 126:             updateTypingUsers(prev => prev.filter(t => t.userId !== userId));
 127:           }, REMOTE_TYPING_TTL_MS)
 128:         );
 129:       })
 130:       .subscribe(async (status) => {
 131:         if (debugLogger.messaging.enabled()) {
 132:           debugLogger.messaging.trace('useConversationPresence', 'status', {
 133:             conversationId,
 134:             status,
 135:           });
 136:         }
 137: 
 138:         if (status === 'SUBSCRIBED') {
 139:           isSubscribedRef.current = true;
 140:           const userDisplayName =
 141:             (user.user_metadata as any)?.full_name ||
 142:             (user.user_metadata as any)?.name ||
 143:             user.email?.split('@')[0] ||
