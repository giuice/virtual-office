   9: /** Upper bound of visible message ids per request (mirrored by the RPC). */
  10: const MAX_READ_RECEIPT_MESSAGE_IDS = 100;
  11: 
  12: const messageIdsSchema = z
  13:   .array(z.guid())
  14:   .min(1)
  15:   .max(MAX_READ_RECEIPT_MESSAGE_IDS);
  16: 
  17: /**
  18:  * PATCH { conversationId }               — legacy mark-all (published clients):
  19:  *   advances last_read_at and receipts every message from others.
  20:  * PATCH { conversationId, messageIds }   — Phase 4 per-message receipts: records
  21:  *   receipts only for the given visible ids of this conversation, never for the
  22:  *   caller's own messages, without moving last_read_at.
  23:  */
  24: export async function PATCH(request: NextRequest) {
  25:   try {
  26:     let body: Record<string, unknown>;
  27:     try {
  28:       const parsedBody: unknown = await request.json();
  29:       if (typeof parsedBody !== 'object' || parsedBody === null || Array.isArray(parsedBody)) {
  30:         return jsonError(400, 'BAD_REQUEST', 'Invalid JSON payload');
  31:       }
  32:       body = parsedBody as Record<string, unknown>;
  33:     } catch {
  34:       return jsonError(400, 'BAD_REQUEST', 'Invalid JSON payload');
  35:     }
  36: 
  37:     const conversationId = typeof body.conversationId === 'string' ? body.conversationId : null;
  38:     if (!conversationId) {
  39:       return jsonError(400, 'BAD_REQUEST', 'Missing required field: conversationId');
  40:     }
  41: 
  42:     let messageIds: string[] | null = null;
  43:     if (body.messageIds !== undefined) {
  44:       const parsed = messageIdsSchema.safeParse(body.messageIds);
  45:       if (!parsed.success) {
  46:         return jsonError(
  47:           400,
  48:           'BAD_REQUEST',
  49:           `messageIds must be 1-${MAX_READ_RECEIPT_MESSAGE_IDS} message UUIDs`
  50:         );
  51:       }
  52:       messageIds = [...new Set(parsed.data.map((id) => id.toLowerCase()))];
  53:     }
  54: 
  55:     // Audit B-01: participants hold DB UUIDs, so the participant check must use
  56:     // dbUser.id — the gate already compares the right identity. The legacy route
  57:     // compared the Supabase UID and returned a permanent 403.
  58:     const ctx = await requireConversationParticipant(conversationId);
  59:     if (isAuthzFailure(ctx)) {
  60:       return ctx.errorResponse;
  61:     }
  62: 
  63:     const conversationRepository: IConversationRepository = new SupabaseConversationRepository(
  64:       ctx.serviceClient
  65:     );
  66: 
  67:     if (messageIds) {
  68:       const rateLimited = await enforceRateLimit(
  69:         ctx.serviceClient,
  70:         ctx.dbUser.id,
  71:         'conversation:read-receipts'
  72:       );
  73:       if (rateLimited) {
  74:         return rateLimited;
  75:       }
  76: 
  77:       const recorded = await conversationRepository.markMessagesRead(
  78:         conversationId,
  79:         ctx.dbUser.id,
  80:         messageIds
  81:       );
  82:       return NextResponse.json({ success: true, recorded }, { status: 200 });
  83:     }
  84: 
  85:     // Phase 2.2: atomic RPC — sets conversation_members.last_read_at and
  86:     // writes per-message read receipts in one transaction.
  87:     const success = await conversationRepository.markConversationRead(conversationId, ctx.dbUser.id);
  88: 
  89:     if (!success) {
  90:       return jsonError(500, 'INTERNAL_ERROR', 'Failed to mark conversation as read');
  91:     }
  92: 
  93:     return NextResponse.json({ success: true }, { status: 200 });
  94:   } catch (error) {
  95:     console.error('Error marking conversation as read:', error);
  96:     return jsonError(500, 'INTERNAL_ERROR', 'Internal Server Error');
  97:   }
  98: }

