 251:   /**
 252:    * Every captured metric line, identified by BR-013 fields only (lines carry
 253:    * no tag): a JSON object with an `appVersion` and a known metric `type`.
 254:    */
 255:   function metricLines(): Record<string, unknown>[] {
 256:     const lines: Record<string, unknown>[] = [];
 257:     for (const line of captured) {
 258:       const parsed = parseObject(line.text);
 259:       if (!parsed || !('appVersion' in parsed) || !(MESSAGING_METRIC_TYPES as readonly 
unknown[]).includes(parsed.type)) {
