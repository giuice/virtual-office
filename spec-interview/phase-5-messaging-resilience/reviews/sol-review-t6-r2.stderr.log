 145: /**
 146:  * Reads the raw request body, refusing it as soon as more than `maxBytes`
 147:  * arrive. A declared Content-Length over the limit is refused without
 148:  * reading, but the limit is always enforced on the bytes actually received,
 149:  * so a missing (chunked) or understated Content-Length cannot bypass it.
 150:  */
 151: export async function readBoundedBody(request: Request, maxBytes: number): Promise<BoundedBodyResult> {
 152:   const declared = request.headers.get('content-length');
 153:   if (declared !== null && /^\d+$/.test(declared.trim()) && Number(declared.trim()) > maxBytes) {
 154:     await request.body?.cancel().catch(() => undefined);
 155:     return { ok: false, reason: 'too_large' };
 156:   }
 157:   if (!request.body) {
 158:     return { ok: true, bytes: new Uint8Array(0) };
 159:   }
 160: 
 161:   const reader = request.body.getReader();
 162:   const chunks: Uint8Array[] = [];
 163:   let total = 0;
 164:   try {
 165:     for (;;) {
 166:       const { done, value } = await reader.read();
 167:       if (done) break;
 168:       total += value.byteLength;
 169:       if (total > maxBytes) {
 170:         await reader.cancel().catch(() => undefined);
 171:         return { ok: false, reason: 'too_large' };
 172:       }
 173:       chunks.push(value);
 174:     }
 175:   } catch {
 176:     return { ok: false, reason: 'unreadable' };
 177:   }
 178: 
 179:   const bytes = new Uint8Array(total);
 180:   let offset = 0;
 181:   for (const chunk of chunks) {
 182:     bytes.set(chunk, offset);
 183:     offset += chunk.byteLength;
 184:   }
 185:   return { ok: true, bytes };
 186: }
