 175:   function jsonRequest(body: unknown, headers: Record<string, string> = {}): NextRequest {
 176:     return new NextRequest(PATH, {
 177:       method: 'POST',
 178:       headers: { 'content-type': 'application/json', ...headers },
 179:       body: typeof body === 'string' ? body : JSON.stringify(body),
 180:     });
 181:   }
 182: 
 183:   interface StreamProbe {
 184:     /** Bytes the route pulled from the source so far. */
 185:     pulledBytes: number;
 186:     /** Whether the route cancelled the body. */
 187:     cancelled: boolean;
 188:   }
 189: 
 190:   /**
 191:    * A body streamed in chunks (no Content-Length unless given, i.e. chunked
 192:    * transfer) from an instrumented source that produces a chunk only when
 193:    * the reader pulls one (highWaterMark 0: nothing is read ahead).
 194:    */
 195:   function streamedRequest(
 196:     text: string,
 197:     chunkSize = 1024,
 198:     headers: Record<string, string> = {},
 199:   ): { request: NextRequest; probe: StreamProbe } {
 200:     const bytes = new TextEncoder().encode(text);
 201:     const probe: StreamProbe = { pulledBytes: 0, cancelled: false };
 202:     const stream = new ReadableStream<Uint8Array>(
 203:       {
 204:         pull(controller) {
 205:           if (probe.pulledBytes >= bytes.byteLength) {
 206:             controller.close();
 207:             return;
 208:           }
 209:           const chunk = bytes.slice(probe.pulledBytes, probe.pulledBytes + chunkSize);
 210:           probe.pulledBytes += chunk.byteLength;
 211:           controller.enqueue(chunk);
 212:         },
 213:         cancel() {
 214:           probe.cancelled = true;
 215:         },
 216:       },
 217:       { highWaterMark: 0 },
 218:     );
 219:     const request = new NextRequest(PATH, {
 220:       method: 'POST',
 221:       headers: { 'content-type': 'application/json', ...headers },
 222:       body: stream,
 223:       duplex: 'half',
 224:     } as ConstructorParameters<typeof NextRequest>[1] & { duplex: 'half' });
 225:     if (!('content-length' in headers)) expect(request.headers.get('content-length')).toBeNull();
 226:     return { request, probe };
 227:   }
 228: 
 229:   async function call(user: MessagingDbUser | null, request: NextRequest): Promise<RouteResult> {
 230:     return asSession(cookiesOf(user), async () => {
 231:       const response = await metricsRoute(request);
 232:       return { status: response.status, body: (await response.json()) as RouteResult['body'] };
 233:     });
 234:   }
 235: 
 236:   function post(user: MessagingDbUser | null, body: unknown): Promise<RouteResult> {
 237:     return call(user, jsonRequest(body));
 238:   }
 239: 
 240:   function parseObject(text: string): Record<string, unknown> | null {
 241:     try {
 242:       const value: unknown = JSON.parse(text);
 243:       return typeof value === 'object' && value !== null && !Array.isArray(value)
 244:         ? (value as Record<string, unknown>)
 245:         : null;
 246:     } catch {
 247:       return null;
 248:     }
 249:   }
 250: 
 251:   /**
 252:    * Every captured metric line, identified by BR-013 fields only (lines carry
 253:    * no tag): a JSON object with an `appVersion` and a known metric `type`.
 254:    */
 255:   function metricLines(): Record<string, unknown>[] {
 256:     const lines: Record<string, unknown>[] = [];
 257:     for (const line of captured) {
 258:       const parsed = parseObject(line.text);
 259:       if (!parsed || !('appVersion' in parsed) || !(MESSAGING_METRIC_TYPES as readonly 
unknown[]).includes(parsed.type)) {
 260:         continue;
 261:       }
 262:       expect(line.method, 'metric lines are written with console.info').toBe('info');
 263:       lines.push(parsed);
 264:     }
 265:     return lines;
 266:   }
 267: 
 268:   function allOutput(): string {
 269:     return captured.map((line) => line.text).join('\n');
 270:   }
 271: 
 272:   /** No captured output at all looks like a metric line (broader than metricLines). */
 273:   function expectNoMetricOutput(): void {
 274:     expect(metricLines()).toHaveLength(0);
 275:     expect(allOutput()).not.toContain('"appVersion"');
 276:   }
 277: 
 278:   function expectBr013Line(line: Record<string, unknown>): void {
 279:     for (const key of Object.keys(line)) expect(LINE_KEYS.has(key), `unexpected key ${key}`).toBe(true);
 280:     expect(line.appVersion).toBe(expectedVersion);
 281:     expect(Number.isNaN(Date.parse(String(line.ts)))).toBe(false);
 282:   }
