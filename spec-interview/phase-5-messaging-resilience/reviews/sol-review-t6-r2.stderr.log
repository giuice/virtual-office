 159:   /** Waits for the next fixed window when fewer than `seconds` remain in this one. */
 160:   async function ensureWindowHeadroom(seconds = 15): Promise<void> {
 161:     const [{ remaining }] = await world.query<{ remaining: string }>(
 162:       `select ($1::numeric - (extract(epoch from clock_timestamp())::numeric % $1::numeric))::text as remaining`,
 163:       [WINDOW_SECONDS],
 164:     );
 165:     const left = Number(remaining);
 166:     if (left < seconds) {
 167:       await new Promise((resolve) => setTimeout(resolve, Math.ceil(left * 1000) + 250));
 168:     }
 169:   }
