 457:   it('accepts a body of exactly 16 KB and rejects larger bodies, declared or chunked', async () => {
 458:     const base = JSON.stringify({ events: [{ type: 'polling_start' }], pad: '' });
 459:     const atLimit = JSON.stringify({ events: [{ type: 'polling_start' }], pad: 
'x'.repeat(MESSAGING_METRICS_MAX_BYTES - base.length) });
 460:     expect(new TextEncoder().encode(atLimit).byteLength).toBe(MESSAGING_METRICS_MAX_BYTES);
 461:     const overLimit = JSON.stringify({ events: [{ type: 'polling_start' }], pad: 
'x'.repeat(MESSAGING_METRICS_MAX_BYTES - base.length + 1) });
 462: 
 463:     const ok = await call(world.primary, jsonRequest(atLimit));
 464:     expect(ok.status, JSON.stringify(ok.body)).toBe(202);
 465:     expect(metricLines()).toHaveLength(1);
 466: 
 467:     const okStreamed = streamedRequest(atLimit);
 468:     const okStreamedResult = await call(world.primary, okStreamed.request);
 469:     expect(okStreamedResult.status, JSON.stringify(okStreamedResult.body)).toBe(202);
 470:     expect(okStreamed.probe.pulledBytes).toBe(MESSAGING_METRICS_MAX_BYTES);
 471:     expect(metricLines()).toHaveLength(2);
 472: 
 473:     captured.length = 0;
 474:     // No Content-Length header on an in-memory body: counted while reading.
 475:     const undeclared = await call(world.primary, jsonRequest(overLimit));
 476:     expect(undeclared.status).toBe(413);
 477:     expect(undeclared.body.code).toBe('METRICS_PAYLOAD_TOO_LARGE');
 478: 
 479:     // Declared Content-Length over the limit: refused without reading a byte.
 480:     const declared = streamedRequest(overLimit, 1024, { 'content-length': String(MESSAGING_METRICS_MAX_BYTES + 
1) });
 481:     const declaredResult = await call(world.primary, declared.request);
 482:     expect(declaredResult.status).toBe(413);
 483:     expect(declaredResult.body.code).toBe('METRICS_PAYLOAD_TOO_LARGE');
 484:     expect(declared.probe.pulledBytes).toBe(0);
 485:     expect(declared.probe.cancelled).toBe(true);
 486: 
 487:     // Understated Content-Length: the received bytes still decide.
 488:     const understated = streamedRequest(overLimit, 1024, { 'content-length': '10' });
 489:     const understatedResult = await call(world.primary, understated.request);
 490:     expect(understatedResult.status).toBe(413);
 491:     expect(understatedResult.body.code).toBe('METRICS_PAYLOAD_TOO_LARGE');
 492:     expect(understated.probe.cancelled).toBe(true);
 493: 
 494:     // Chunked: no Content-Length, counted on the bytes received.
 495:     const chunked = streamedRequest(overLimit);
 496:     const chunkedResult = await call(world.primary, chunked.request);
 497:     expect(chunkedResult.status).toBe(413);
 498:     expect(chunkedResult.body.code).toBe('METRICS_PAYLOAD_TOO_LARGE');
 499:     expect(chunked.probe.cancelled).toBe(true);
 500: 
 501:     // Multi-byte characters count as bytes, not characters.
 502:     const multiByte = JSON.stringify({ events: [{ type: 'polling_start' }], pad: 
'é'.repeat(MESSAGING_METRICS_MAX_BYTES / 2) });
 503:     expect(multiByte.length).toBeLessThan(MESSAGING_METRICS_MAX_BYTES);
 504:     const wide = streamedRequest(multiByte);
 505:     expect((await call(world.primary, wide.request)).status).toBe(413);
 506:     expect(wide.probe.cancelled).toBe(true);
 507: 
 508:     // A 4 MB chunked body is cut off right after the limit: the reader is
 509:     // cancelled and pulls at most one chunk beyond 16 KB, never the whole body.
 510:     const hugeChunk = 4096;
 511:     const huge = streamedRequest(JSON.stringify({ events: [], pad: 'y'.repeat(4 * 1024 * 1024) }), hugeChunk);
 512:     const hugeResult = await call(world.primary, huge.request);
 513:     expect(hugeResult.status).toBe(413);
 514:     expect(huge.probe.cancelled).toBe(true);
 515:     expect(huge.probe.pulledBytes).toBeGreaterThan(MESSAGING_METRICS_MAX_BYTES);
 516:     expect(huge.probe.pulledBytes).toBeLessThanOrEqual(MESSAGING_METRICS_MAX_BYTES + hugeChunk);
 517: 
 518:     expectNoMetricOutput();
 519:   });
