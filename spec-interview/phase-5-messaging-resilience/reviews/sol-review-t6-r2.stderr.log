   2: import { NextResponse } from 'next/server';
   3: import type { SupabaseClient } from '@supabase/supabase-js';
   4: import { jsonError } from '@/lib/auth/authorize';
   5: import type { InsertionQuota } from '@/types/messaging';
   6: 
   7: interface RateLimitPolicy {
   8:   limit: number;
   9:   windowSeconds: number;
  10:   /**
  11:    * Phase 5 T3 (D4 planning decision): when the limit cannot be checked (RPC
  12:    * error, missing or revoked function, unexpected result), refuse the request
  13:    * with 429 instead of allowing it. Other actions keep failing open.
  14:    */
  15:   failClosed: boolean;
  16: }
  17: 
  18: // Audit M-09: per-user fixed-window limits for messaging mutations.
  19: // Enforced by the service-role-only check_rate_limit RPC (shared Postgres
  20: // counter, safe across serverless instances).
  21: //
  22: // Phase 5 T3 (FR-008) message send budgets, all per user and fail-closed:
  23: //   * 'message:create' — INSERTION QUOTA (unchanged 30/60 s; D1 needs a burst
  24: //     of >= 10). Every create of this build (keyed, unkeyed, attachments) is
  25: //     charged by the database in the transaction of a winning insertion only
  26: //     (create_message_attempt → private.charge_message_insertion_quota,
  27: //     migration 20261007114454; serialized per user, rollover-safe):
  28: //     replays, lost same-key races and refused or failed creates never
  29: //     consume it; MESSAGE_INSERTION_QUOTA hands it over. Clients cannot insert
  30: //     messages directly. Phase 4 servers charge the same counter at their
  31: //     route, so both builds share one quota.
  32: //   * 'message:create-request' — REQUEST BUDGET: every authenticated create
  33: //     request (malformed bodies, validation failures, replays, quota losers
  34: //     included), charged first, in its own transaction, so it survives an
  35: //     insertion rollback. 60/60 s = 2x the insertion quota: a full quota of
  36: //     new messages plus one replay or retry each; an outbox drain of 10 items
  37: //     with one replay each uses 20.
  38: //   * 'message:fence' — FENCE BUDGET: every authenticated fence/lookup call
  39: //     plus the fence step of each generation-carrying create. 90/60 s = the
  40: //     request budget's 60 generation-carrying creates plus 30 explicit
  41: //     lookups; a drain of 10 items (create + lookup + replay each) uses 30.
  42: //   Bound on private.message_send_attempts growth: a key row is created only
  43: //   by a fence step (<= 90 per user per minute) or a committed generation-less
  44: //   keyed create (<= 30, insertion quota): <= 120 new rows per user per minute.
  45: const RATE_LIMITS = {
  46:   'message:create': { limit: 30, windowSeconds: 60, failClosed: true },
  47:   'message:create-request': { limit: 60, windowSeconds: 60, failClosed: true },
  48:   'message:react': { limit: 60, windowSeconds: 60, failClosed: false },
  49:   // Phase 4 T13: one upload per file, up to 5 files per message, plus retries
  50:   // of failed uploads; 10/min refused the second full message in a minute.
  51:   // 30/min = six 5-file messages, in line with message:create (each file is
  52:   // still capped at 10 MB and only links to the uploader's own message).
  53:   'message:upload': { limit: 30, windowSeconds: 60, failClosed: false },
  54:   // Phase 4 T12: cancelling pending uploads (composer remove/cancel).
  55:   'message:upload-cancel': { limit: 60, windowSeconds: 60, failClosed: false },
  56:   // Phase 5 T2/T3: fence/lookup of the caller's own composition key (outbox
  57:   // recovery after unknown outcomes), see the budgets above.
  58:   'message:fence': { limit: 90, windowSeconds: 60, failClosed: true },
  59:   // Visible-message receipts are batched by the drawer while it scrolls.
  60:   'conversation:read-receipts': { limit: 120, windowSeconds: 60, failClosed: false },
  61:   // Phase 5 T6 (FR-027, AC-028): messaging metric batches (<= 50 events,
  62:   // <= 16 KB each) from all of the user's tabs, charged on every
  63:   // authenticated request (oversized and malformed ones included). Bounds the
  64:   // log volume to 30 x 50 = 1,500 lines per user per fixed 60-second bucket;
  65:   // like every fixed window, up to 2x that (3,000 lines) can land within one
  66:   // rolling minute across a bucket boundary. Fail-closed: the client drops a
  67:   // refused batch, so refusing never affects messaging.
  68:   'messaging:metrics': { limit: 30, windowSeconds: 60, failClosed: true },
  69: } as const satisfies Record<string, RateLimitPolicy>;
  70: 
  71: export type RateLimitedAction = keyof typeof RATE_LIMITS;
  72: 
  73: /**
  74:  * The message insertion quota handed to the database, which charges it to
  75:  * the 'message:create' counter in the transaction of a winning insertion.
  76:  */
  77: export const MESSAGE_INSERTION_QUOTA: InsertionQuota = {
  78:   limit: RATE_LIMITS['message:create'].limit,
  79:   windowSeconds: RATE_LIMITS['message:create'].windowSeconds,
  80: };
  81: 
  82: /** 429: the user exhausted a limit (transient). */
  83: export function rateLimitExceededResponse(): NextResponse {
  84:   return jsonError(429, 'rate_limited', 'Too many requests. Please slow down.');
  85: }
  86: 
  87: /** 429: a fail-closed limit could not be checked (transient). */
  88: export function rateLimitUnavailableResponse(): NextResponse {
  89:   return jsonError(429, 'rate_limited', 'The request could not be rate checked. Please retry shortly.');
  90: }
  91: 
  92: /**
  93:  * Returns a 429 response when the user exceeded the action's limit,
  94:  * null when the request may proceed. Call AFTER authentication, with the
  95:  * authenticated user's DB id (users.id, not supabase_uid).
  96:  *
  97:  * Fail-open actions: an RPC error (e.g. migration not applied yet) is logged
  98:  * and the request is allowed — rate limiting must never take those down.
  99:  * Fail-closed actions (Phase 5 T3: message send budgets): an RPC error or an
 100:  * unexpected result refuses the request with 429.
 101:  */
 102: export async function enforceRateLimit(
 103:   serviceClient: SupabaseClient,
 104:   userDbId: string,
 105:   action: RateLimitedAction
 106: ): Promise<NextResponse | null> {
 107:   const { limit, windowSeconds, failClosed } = RATE_LIMITS[action];
 108: 
 109:   try {
 110:     const { data: allowed, error } = await serviceClient.rpc('check_rate_limit', {
 111:       p_user_id: userDbId,
 112:       p_action: action,
 113:       p_limit: limit,
 114:       p_window_seconds: windowSeconds,
 115:     });
 116: 
 117:     if (error) {
 118:       console.error(`Rate limit check failed for ${action}:`, error);
 119:       return failClosed ? rateLimitUnavailableResponse() : null;
 120:     }
 121: 
 122:     if (allowed === false) {
 123:       return rateLimitExceededResponse();
 124:     }
 125: 
 126:     if (failClosed && allowed !== true) {
 127:       console.error(`Rate limit check returned an unexpected result for ${action}:`, allowed);
 128:       return rateLimitUnavailableResponse();
 129:     }
 130: 
 131:     return null;
 132:   } catch (error) {
 133:     console.error(`Rate limit check threw for ${action}:`, error);
 134:     return failClosed ? rateLimitUnavailableResponse() : null;
 135:   }
