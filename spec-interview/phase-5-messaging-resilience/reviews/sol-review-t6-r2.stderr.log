 284:   function expectNoSensitiveOutput(extra: string[] = []): void {
 285:     const output = allOutput();
 286:     for (const value of [...sensitive, ...extra]) {
 287:       expect(output.includes(value), `log output must not contain ${JSON.stringify(value.slice(0, 
12))}…`).toBe(false);
 288:     }
 289:   }
