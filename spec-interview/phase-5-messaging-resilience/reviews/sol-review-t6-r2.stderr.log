   7: export interface SerializedSupabaseError {
   8:   code?: string;
   9:   message?: string;
  10:   details?: string | null;
  11:   hint?: string | null;
  12:   status?: number;
  13: }
  14: 
  15: export interface ServerErrorOptions {
  16:   correlationId?: string;
  17:   cause?: unknown;
  18:   context?: string;
  19: }
  20: 
  21: function isRecord(value: unknown): value is Record<string, unknown> {
  22:   return typeof value === 'object' && value !== null;
  23: }
  24: 
  25: function readString(record: Record<string, unknown>, key: string): string | undefined {
  26:   return typeof record[key] === 'string' ? record[key] : undefined;
  27: }
  28: 
  29: function readNullableString(record: Record<string, unknown>, key: string): string | null | undefined {
  30:   const value = record[key];
  31:   return typeof value === 'string' || value === null ? value : undefined;
  32: }
  33: 
  34: export function createCorrelationId(): string {
  35:   return randomUUID();
  36: }
  37: 
  38: /**
  39:  * Supabase/PostgREST errors are commonly plain objects rather than Error
  40:  * instances. Read only their documented diagnostic fields so logs retain the
  41:  * useful database code without serializing request/session internals.
  42:  */
  43: export function serializeSupabaseError(error: unknown): SerializedSupabaseError | undefined {
  44:   if (!isRecord(error)) {
  45:     return typeof error === 'string' ? { message: error } : undefined;
  46:   }
  47: 
  48:   const serialized: SerializedSupabaseError = {};
  49:   const code = readString(error, 'code');
  50:   const message = readString(error, 'message');
  51:   const details = readNullableString(error, 'details');
  52:   const hint = readNullableString(error, 'hint');
  53:   const status = typeof error.status === 'number' ? error.status : undefined;
  54: 
  55:   if (code !== undefined) serialized.code = code;
  56:   if (message !== undefined) serialized.message = message;
  57:   if (details !== undefined) serialized.details = details;
  58:   if (hint !== undefined) serialized.hint = hint;
  59:   if (status !== undefined) serialized.status = status;
  60: 
  61:   return Object.keys(serialized).length > 0 ? serialized : undefined;
  62: }
  63: 
  64: export function logServerError(
  65:   status: number,
  66:   code: ApiErrorCode,
  67:   message: string,
  68:   options: ServerErrorOptions = {}
  69: ): void {
  70:   const cause = serializeSupabaseError(options.cause);
  71:   const entry = {
  72:     event: 'api_error',
  73:     correlationId: options.correlationId,
  74:     context: options.context,
  75:     status,
  76:     code,
  77:     message,
  78:     cause,
  79:   };
  80: 
  81:   console.error(JSON.stringify(entry));
  82: }
  83: 
  84: export function jsonError(
  85:   status: number,
  86:   code: ApiErrorCode,
  87:   message: string,
  88:   options: ServerErrorOptions = {}
  89: ): NextResponse<ApiErrorBody> {
  90:   logServerError(status, code, message, options);
  91: 
  92:   const body: ApiErrorBody = { error: message, code };
  93:   if (options.correlationId) {
  94:     body.correlationId = options.correlationId;
  95:   }
  96: 
  97:   return NextResponse.json(body, {
  98:     status,
  99:     headers: options.correlationId
 100:       ? { 'x-correlation-id': options.correlationId }
 101:       : undefined,
 102:   });
 103: }
 104: 
 105: export function jsonSuccess<T>(
 106:   body: T,
 107:   correlationId: string,
 108:   init: ResponseInit = {}
 109: ): NextResponse<T> {
 110:   const headers = new Headers(init.headers);
 111:   headers.set('x-correlation-id', correlationId);
 112:   return NextResponse.json(body, { ...init, headers });
 113: }
