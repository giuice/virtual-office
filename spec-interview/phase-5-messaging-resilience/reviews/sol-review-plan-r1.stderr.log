   2: import { NextResponse } from 'next/server';
   3: import type { SupabaseClient } from '@supabase/supabase-js';
   4: import { jsonError } from '@/lib/auth/authorize';
   5: 
   6: // Audit M-09: per-user fixed-window limits for messaging mutations.
   7: // Enforced by the service-role-only check_rate_limit RPC (shared Postgres
   8: // counter, safe across serverless instances).
   9: const RATE_LIMITS = {
  10:   'message:create': { limit: 30, windowSeconds: 60 },
  11:   'message:react': { limit: 60, windowSeconds: 60 },
  12:   // Phase 4 T13: one upload per file, up to 5 files per message, plus retries
  13:   // of failed uploads; 10/min refused the second full message in a minute.
  14:   // 30/min = six 5-file messages, in line with message:create (each file is
  15:   // still capped at 10 MB and only links to the uploader's own message).
  16:   'message:upload': { limit: 30, windowSeconds: 60 },
  17:   // Phase 4 T12: cancelling pending uploads (composer remove/cancel).
  18:   'message:upload-cancel': { limit: 60, windowSeconds: 60 },
  19:   // Visible-message receipts are batched by the drawer while it scrolls.
  20:   'conversation:read-receipts': { limit: 120, windowSeconds: 60 },
  21: } as const;
  22: 
  23: export type RateLimitedAction = keyof typeof RATE_LIMITS;
  24: 
  25: /**
  26:  * Returns a 429 response when the user exceeded the action's limit,
  27:  * null when the request may proceed. Call AFTER the authz check, with the
  28:  * authenticated user's DB id (users.id, not supabase_uid).
  29:  *
  30:  * Fails open: an RPC error (e.g. migration not applied yet) is logged and
  31:  * the request is allowed — rate limiting must never take messaging down.
  32:  */
  33: export async function enforceRateLimit(
  34:   serviceClient: SupabaseClient,
  35:   userDbId: string,
  36:   action: RateLimitedAction
  37: ): Promise<NextResponse | null> {
  38:   const { limit, windowSeconds } = RATE_LIMITS[action];
  39: 
  40:   try {
  41:     const { data: allowed, error } = await serviceClient.rpc('check_rate_limit', {
  42:       p_user_id: userDbId,
  43:       p_action: action,
  44:       p_limit: limit,
  45:       p_window_seconds: windowSeconds,
  46:     });
  47: 
  48:     if (error) {
  49:       console.error(`Rate limit check failed for ${action}:`, error);
  50:       return null;
  51:     }
  52: 
  53:     if (allowed === false) {
  54:       return jsonError(429, 'rate_limited', 'Too many requests. Please slow down.');
  55:     }
  56: 
  57:     return null;
  58:   } catch (error) {
  59:     console.error(`Rate limit check threw for ${action}:`, error);
  60:     return null;
  61:   }
  62: }
   1: -- Phase 3.4 (messaging audit 2026-06-10, M-09) — per-user rate limiting for
   2: -- messaging mutations (create / react / upload).
   3: --
   4: -- Fixed-window counters in Postgres: no new infra, serverless-safe (every
   5: -- Next.js instance shares the same counter). The function is SECURITY
   6: -- DEFINER and executable by service_role ONLY — it takes the target user id
   7: -- as a parameter, so an authenticated caller could otherwise exhaust another
   8: -- user's quota on purpose. API routes call it through the service client
   9: -- AFTER the authz check, passing the authenticated user's DB id.
  10: --
  11: -- Re-runnable: create table if not exists; function is CREATE OR REPLACE.
  12: 
  13: create table if not exists private.rate_limit_counters (
  14:   user_id uuid not null,
  15:   action text not null,
  16:   window_start timestamptz not null,
  17:   count integer not null default 0,
  18:   primary key (user_id, action, window_start)
  19: );
  20: 
  21: alter table private.rate_limit_counters enable row level security;
  22: -- No policies on purpose: only the SECURITY DEFINER function (and
  23: -- service_role) touch this table.
  24: 
  25: -- Lives in public (PostgREST does not expose the private schema for RPC) but
  26: -- is executable by service_role only — same pattern as mark_conversation_read.
  27: create or replace function public.check_rate_limit(
  28:   p_user_id uuid,
  29:   p_action text,
  30:   p_limit integer,
  31:   p_window_seconds integer
  32: ) returns boolean
  33: language plpgsql
  34: security definer
  35: set search_path = ''
  36: as $$
  37: declare
  38:   v_window_start timestamptz;
  39:   v_count integer;
  40: begin
  41:   v_window_start := to_timestamp(
  42:     floor(extract(epoch from now()) / p_window_seconds) * p_window_seconds
  43:   );
  44: 
  45:   insert into private.rate_limit_counters as c (user_id, action, window_start, count)
  46:   values (p_user_id, p_action, v_window_start, 1)
  47:   on conflict (user_id, action, window_start)
  48:   do update set count = c.count + 1
  49:   returning count into v_count;
  50: 
  51:   -- Opportunistic cleanup of this user's expired windows (PK-indexed, cheap).
  52:   delete from private.rate_limit_counters
  53:   where user_id = p_user_id
  54:     and action = p_action
  55:     and window_start < v_window_start;
  56: 
  57:   return v_count <= p_limit;
  58: end;
  59: $$;
  60: 
  61: revoke all on function public.check_rate_limit(uuid, text, integer, integer) from public;
  62: revoke all on function public.check_rate_limit(uuid, text, integer, integer) from anon, authenticated;
  63: grant execute on function public.check_rate_limit(uuid, text, integer, integer) to service_role;

