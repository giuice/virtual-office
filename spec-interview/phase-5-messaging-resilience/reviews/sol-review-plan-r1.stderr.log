  46: function inspectStream(stream, destination) {
  47:   return new Promise((resolveDrain) => {
  48:     let pending = '';
  49:     let isDrained = false;
  50: 
  51:     const drain = () => {
  52:       if (isDrained) return;
  53:       isDrained = true;
  54:       const metric = sanitizeAuthMetricLine(pending);
  55:       if (metric) appendFileSync(outputPath, `${JSON.stringify(metric)}\n`, 'utf8');
  56:       pending = '';
  57:       resolveDrain();
  58:     };
  59: 
  60:     stream.on('data', (chunk) => {
  61:       destination.write(chunk);
  62:       pending += chunk.toString('utf8');
  63:       const lines = pending.split(/\r?\n/);
  64:       pending = lines.pop() ?? '';
  65:       for (const line of lines) {
  66:         const metric = sanitizeAuthMetricLine(line);
  67:         if (metric) appendFileSync(outputPath, `${JSON.stringify(metric)}\n`, 'utf8');
  68:       }
  69:     });
  70:     stream.once('end', drain);
  71:     stream.once('close', drain);
  72:     stream.once('error', drain);
  73:   });
  74: }
