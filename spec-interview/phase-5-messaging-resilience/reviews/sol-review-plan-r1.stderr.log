  88:     (stored.replyToId ?? null) === (expected.replyToId ?? null) &&
  89:     storedAttachmentIds.length === expectedAttachmentIds.length &&
  90:     storedAttachmentIds.every((id, index) => id === expectedAttachmentIds[index])
  91:   );
