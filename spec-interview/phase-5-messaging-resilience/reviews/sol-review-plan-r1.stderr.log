 126:     const attachmentKind = !message.content.trim() && message.type === MessageType.FILE
 127:       ? await resolveAttachmentKind(message.id)
 128:       : null;
 129:     if (readDesktopNotificationStatus(currentUserId) !== 'enabled') return;
 130: 
 131:     const senderName = companyUsersRef.current.find((user) => user.id === message.senderId)?.displayName?.trim()
 132:       || 'Nova mensagem';
 133:     showDesktopNotification(
 134:       notificationTitle(conversation, senderName),
 135:       { body: notificationBody(message, attachmentKind), tag: notificationTag(conversation.id) },
 136:       () => onOpenConversationRef.current(conversation.id),
 137:     );
 138:   }, [currentUserId, readLoadBaseline]);
 139: }
