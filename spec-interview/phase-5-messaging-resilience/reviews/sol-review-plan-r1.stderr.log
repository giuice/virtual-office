 247:     const conversationId = typeof body.conversationId === 'string' ? body.conversationId : null;
 248:     const rawContent = body.content === undefined && hasAttachments ? '' : body.content;
 249:     if (!conversationId || typeof rawContent !== 'string') {
 250:       return jsonError(400, 'BAD_REQUEST', 'Missing required fields: conversationId, content');
 251:     }
 252: 
 253:     const trimmedContent = rawContent.trim();
 254:     if (trimmedContent.length === 0 && !hasAttachments) {
 255:       return jsonError(400, 'BAD_REQUEST', 'Content must not be empty');
 256:     }
 257:     if (trimmedContent.length > MAX_CONTENT_LENGTH) {
 258:       return jsonError(413, 'CONTENT_TOO_LARGE', `Content exceeds the ${MAX_CONTENT_LENGTH} character limit`);
 259:     }
 260: 
 261:     const clientMessageId = parseClientMessageId(body.clientMessageId);
 262:     if (!clientMessageId.ok) {
 263:       return jsonError(400, 'INVALID_CLIENT_MESSAGE_ID', 'clientMessageId must be a UUID');
 264:     }
 265: 
 266:     const ctx = await requireConversationParticipant(conversationId);
 267:     if (isAuthzFailure(ctx)) {
 268:       return ctx.errorResponse;
 269:     }
 270:     const { serviceClient, dbUser, conversation } = ctx;
 271: 
 272:     const rateLimited = await enforceRateLimit(serviceClient, dbUser.id, 'message:create');
 273:     if (rateLimited) {
 274:       return rateLimited;
 275:     }
 276: 
 277:     const messageRepository: IMessageRepository = new SupabaseMessageRepository(serviceClient);
 278:     const conversationRepository: IConversationRepository = new SupabaseConversationRepository(serviceClient);
 279: 
 280:     // Audit S-04: replyToId must reference a message in the SAME conversation.
 281:     let replyToId: string | undefined;
 282:     if (body.replyToId !== undefined && body.replyToId !== null) {
 283:       if (typeof body.replyToId !== 'string') {
 284:         return jsonError(400, 'BAD_REQUEST', 'replyToId must be a string');
 285:       }
 286:       const { data: replyTarget, error: replyError } = await serviceClient
 287:         .from('messages')
 288:         .select('id, conversation_id')
 289:         .eq('id', body.replyToId)
