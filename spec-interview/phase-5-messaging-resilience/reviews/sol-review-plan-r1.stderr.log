  82: /** Page init script: the tab is in the background from its first script on. */
  83: function startHidden(): void {
  84:   Object.defineProperty(document, 'visibilityState', { configurable: true, get: () => 'hidden' });
  85:   Object.defineProperty(document, 'hidden', { configurable: true, get: () => true });
  86: }
  87: 
  88: /** Page init script: a browser without the Notifications API. */
  89: function removeNotificationApi(): void {
  90:   delete (window as { Notification?: unknown }).Notification;
  91: }
  92: 
  93: async function notificationRecord(page: Page): Promise<NotificationRecord> {
  94:   return page.evaluate(
  95:     () => (window as unknown as { __notificationRecord: NotificationRecord }).__notificationRecord,
  96:   );
  97: }
  98: 
  99: async function notificationsOf(page: Page): Promise<RecordedNotification[]> {
 100:   return (await notificationRecord(page)).constructed;
 101: }
