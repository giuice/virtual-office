  37: /** Signs in through @supabase/ssr and returns the auth cookies it wrote. */
  38: export async function signInSessionCookies(email: string): Promise<SessionCookie[]> {
  39:   const written = new Map<string, string>();
  40:   const client = createServerClient(MESSAGING_API_URL, MESSAGING_ANON_KEY, {
  41:     cookies: {
  42:       getAll: () => [...written].map(([name, value]) => ({ name, value })),
  43:       setAll: (cookiesToSet) => {
  44:         for (const { name, value } of cookiesToSet) {
  45:           if (value) written.set(name, value);
  46:           else written.delete(name);
  47:         }
  48:       },
  49:     },
  50:   });
  51:   const { error } = await client.auth.signInWithPassword({ email, password: MESSAGING_DB_PASSWORD });
  52:   if (error) {
  53:     throw new Error(`Failed to create SSR session for ${email}: ${error.message}`);
  54:   }
  55:   if (written.size === 0) {
  56:     throw new Error(`No auth cookies were written for ${email}`);
  57:   }
  58:   return [...written].map(([name, value]) => ({ name, value }));
  59: }
  60: 
  61: /** Runs `fn` with the given session cookies as the incoming request cookies. */
  62: export async function asSession<T>(cookies: readonly SessionCookie[], fn: () => Promise<T>): Promise<T> {
  63:   const previous = jar.current;
  64:   jar.current = [...cookies];
  65:   try {
  66:     return await fn();
  67:   } finally {
  68:     jar.current = previous;
  69:   }
