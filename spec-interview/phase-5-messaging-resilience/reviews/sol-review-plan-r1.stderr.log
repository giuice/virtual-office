 296:         return jsonError(400, 'INVALID_REPLY_TARGET', 'replyToId must reference a message in the same 
conversation');
 297:       }
 298:       replyToId = replyTarget.id;
 299:     }
 300: 
 301:     const baseMessageData: Omit<MessageCreateData, 'type'> = {
 302:       conversationId: conversation.id,
 303:       senderId: dbUser.id,
 304:       content: trimmedContent,
 305:       // Audit S-04: never trust client-supplied status (pre-marked read/delivered).
 306:       status: MessageStatus.SENT,
 307:       replyToId,
 308:     };
 309: 
 310:     if (attachmentIds.value) {
 311:       const result = await createWithAttachments(
 312:         serviceClient,
 313:         messageRepository,
 314:         conversationRepository,
 315:         new SupabaseMessageAttachmentUploadRepository(serviceClient),
 316:         baseMessageData,
 317:         attachmentIds.value,
 318:         clientMessageId.value
 319:       );
 320:       return result.response;
 321:     }
