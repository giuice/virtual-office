   1: -- Phase 2.4 (messaging audit 2026-06-10, M-06 + realtime-miss root cause).
   2: --
   3: -- Runtime evidence (2026-06-12, node probe with @supabase/supabase-js):
   4: -- a service_role subscriber on postgres_changes for messages /
   5: -- message_read_receipts / message_reactions / conversations reaches
   6: -- SUBSCRIBED but receives ZERO events — the tables are not in the
   7: -- supabase_realtime publication. Every postgres_changes subscription in the
   8: -- app has been a silent no-op (the channel still reports SUBSCRIBED).
   9: --
  10: -- Also: message_read_receipts has RLS enabled but no member-visible SELECT
  11: -- policy (probe: a member cannot read receipts written by the other member
  12: -- of their own conversation). Realtime applies SELECT policies per
  13: -- subscriber (WALRUS), so without this policy receipt INSERTs would never
  14: -- be delivered to the sender and the ✓✓ indicator could not flip live.
  15: --
  16: -- Re-runnable: publication adds are guarded; the policy is drop-and-create.
  17: 
  18: -- ============================================================================
  19: -- 1) supabase_realtime publication — messaging tables
  20: -- ============================================================================
  21: do $$
  22: declare
  23:   t text;
  24: begin
  25:   if not exists (select 1 from pg_publication where pubname = 'supabase_realtime') then
  26:     create publication supabase_realtime;
  27:   end if;
  28: 
  29:   foreach t in array array[
  30:     'messages',
  31:     'message_read_receipts',
  32:     'message_reactions',
  33:     'conversations'
  34:   ] loop
  35:     if not exists (
  36:       select 1
  37:       from pg_publication_tables
  38:       where pubname = 'supabase_realtime'
  39:         and schemaname = 'public'
  40:         and tablename = t
  41:     ) then
  42:       execute format('alter publication supabase_realtime add table only public.%I', t);
  43:     end if;
  44:   end loop;
  45: end $$;
