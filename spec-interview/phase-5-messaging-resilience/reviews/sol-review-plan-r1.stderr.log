 437: export interface RealtimeConnectionControl {
 438:   /**
 439:    * Drops the page's Realtime connection: closes every open socket (the
 440:    * server side too) and closes each reconnect attempt as soon as it is made,
 441:    * until `restore()`. Resolves once the page has noticed (messaging channel
 442:    * no longer SUBSCRIBED).
 443:    */
 444:   drop(): Promise<void>;
 445:   /** Lets the next reconnect attempt through to the server. */
 446:   restore(): void;
 447:   /** Server confirmations of the messaging postgres_changes stream received so far. */
 448:   streamConfirmations(): number;
 449:   /** Waits for a confirmation after the first `after` ones (i.e. the next (re)join). */
 450:   waitForStreamConfirmation(after: number, options?: { timeout?: number }): Promise<void>;
 451:   /** Reconnect attempts closed while dropped. */
 452:   refusedAttempts(): number;
 453: }
 454: 
 455: /**
 456:  * Puts the page's Realtime WebSocket under the test's control (install before
 457:  * the page navigates). Chromium offline emulation (`context.setOffline`) does
 458:  * not close an open WebSocket — the connection keeps streaming — so a real
 459:  * Realtime drop is produced here instead. The app's own reconnect (supabase
 460:  * socket backoff and the messaging channel retry) is untouched: it only sees
 461:  * its socket close and its reconnect attempts fail until `restore()`.
 462:  * Routed sockets do not emit page `websocket` events, so stream
 463:  * confirmations are counted here rather than by watchMessagingChangesStream.
 464:  */
 465: export async function controlRealtimeConnection(page: Page): Promise<RealtimeConnectionControl> {
 466:   let connected = true;
 467:   let confirmations = 0;
 468:   let refused = 0;
 469:   const openRoutes = new Set<WebSocketRoute>();
 470: 
 471:   await page.routeWebSocket(/\/realtime\/v1\/websocket/, (route) => {
 472:     if (!connected) {
 473:       refused += 1;
 474:       void route.close({ code: 4000, reason: 'test: Realtime connection dropped' });
 475:       return;
 476:     }
 477:     const server = route.connectToServer();
 478:     openRoutes.add(route);
 479:     server.onMessage((message) => {
 480:       if (isMessagingStreamReadyFrame(message)) confirmations += 1;
 481:       route.send(message);
 482:     });
 483:   });
 484: 
 485:   return {
 486:     async drop() {
 487:       connected = false;
 488:       const routes = [...openRoutes];
 489:       openRoutes.clear();
 490:       await Promise.all(
 491:         routes.map((route) => route.close({ code: 4000, reason: 'test: Realtime connection dropped' })),
 492:       );
 493:       await page.waitForFunction(
 494:         () => document.documentElement.getAttribute('data-messaging-realtime-ready') !== 'true',
 495:         undefined,
 496:         { timeout: 15_000 },
 497:       );
 498:     },
 499:     restore() {
 500:       connected = true;
 501:     },
 502:     streamConfirmations: () => confirmations,
 503:     async waitForStreamConfirmation(after, { timeout = 30_000 } = {}) {
 504:       await expect
 505:         .poll(() => confirmations, {
 506:           timeout,
 507:           message: 'messaging postgres_changes stream confirmed again by the server',
 508:         })
 509:         .toBeGreaterThan(after);
 510:     },
 511:     refusedAttempts: () => refused,
 512:   };
 513: }
