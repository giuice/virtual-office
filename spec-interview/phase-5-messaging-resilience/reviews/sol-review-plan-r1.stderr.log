 229: export async function POST(request: NextRequest) {
 230:   try {
 231:     let body: Record<string, unknown>;
 232:     try {
 233:       body = await request.json();
 234:     } catch {
 235:       return jsonError(400, 'BAD_REQUEST', 'Invalid JSON payload');
 236:     }
 237:     if (typeof body !== 'object' || body === null || Array.isArray(body)) {
