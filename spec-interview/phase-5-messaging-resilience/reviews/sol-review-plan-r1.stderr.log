 109: /** After a quiet window, the page still has exactly `count` notifications. */
 110: async function expectNoNewNotification(page: Page, count: number, reason: string): Promise<void> {
 111:   await page.waitForTimeout(QUIET_WINDOW_MS);
 112:   expect((await notificationsOf(page)).length, reason).toBe(count);
 113: }
