 206: // Update conversation last activity. Besides ordering the list, this UPDATE on
 207: // conversations is what fires useConversationRealtime's cache invalidation so
 208: // recipients' unread badges refresh. Unread counts are derived from
 209: // conversation_members.last_read_at (Phase 2.2) — nothing to increment here.
 210: async function touchConversation(conversationRepository: IConversationRepository, conversationId: string) {
 211:   try {
 212:     await conversationRepository.updateLastActivityTimestamp(conversationId);
 213:   } catch (updateError) {
 214:     console.warn('Failed to update conversation activity:', updateError);
 215:     // Don't fail the request if conversation update fails
 216:   }
 217: }
