   6: /**
   7:  * Subscribe to real-time conversation changes and keep React Query caches fresh.
   8:  * Expects `userId` to be the Database User ID (not Supabase UID).
   9:  */
  10: export function useConversationRealtime(userId?: string) {
  11:   const queryClient = useQueryClient();
  12:   const [connectionStatus, setConnectionStatus] = useState<string | null>(null);
  13: 
  14:   useEffect(() => {
  15:     if (!userId) return;
  16: 
  17:     const channel = supabase
  18:       .channel('conversations-changes')
  19:       .on(
  20:         'postgres_changes',
  21:         { event: 'INSERT', schema: 'public', table: 'conversations' },
  22:         (payload) => {
  23:           const row = payload.new as any;
  24:           const participants: string[] = row?.participants ?? [];
  25:           if (participants.includes(userId)) {
  26:             queryClient.invalidateQueries({ queryKey: ['conversations', userId] });
  27:           }
  28:         }
  29:       )
  30:       .on(
  31:         'postgres_changes',
  32:         { event: 'UPDATE', schema: 'public', table: 'conversations' },
  33:         (payload) => {
  34:           const row = payload.new as any;
  35:           const participants: string[] = row?.participants ?? [];
  36:           if (participants.includes(userId)) {
  37:             queryClient.invalidateQueries({ queryKey: ['conversations', userId] });
  38:             queryClient.invalidateQueries({ queryKey: ['conversation', row.id] });
  39:           }
  40:         }
  41:       )
  42:       .on(
  43:         'postgres_changes',
  44:         { event: 'DELETE', schema: 'public', table: 'conversations' },
  45:         (payload) => {
  46:           const row = payload.old as any;
  47:           const participants: string[] = row?.participants ?? [];
  48:           if (participants.includes(userId)) {
  49:             queryClient.invalidateQueries({ queryKey: ['conversations', userId] });
  50:             queryClient.removeQueries({ queryKey: ['conversation', row.id] });
  51:           }
  52:         }
  53:       )
  54:       // Changes committed before this channel was streaming (between the
  55:       // list's first fetch and the join, or while reconnecting) never arrive
  56:       // as events, so unread counts and order would stay stale. Refetch once
  57:       // the server confirms the postgres_changes stream for each (re)join.
  58:       .on('system', {}, (payload: RealtimeSystemPayload) => {
  59:         if (payload.extension === 'postgres_changes' && payload.status === 'ok') {
  60:           void queryClient.invalidateQueries({ queryKey: ['conversations', userId] });
  61:         }
  62:       });
  63: 
  64:     const subscription = channel.subscribe((status) => {
  65:       setConnectionStatus(status);
  66:     });
  67: 
  68:     return () => {
  69:       subscription.unsubscribe();
  70:     };
  71:   }, [queryClient, userId]);
  72: 
  73:   return { connectionStatus };
  74: }
