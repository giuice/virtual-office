 326:     const messageData: MessageCreateData = { ...baseMessageData, type: safeType };
 327: 
 328:     let createdMessage: Message;
 329:     if (clientMessageId.value) {
 330:       const outcome = await messageRepository.createWithClientKey(messageData, clientMessageId.value);
 331:       if (!outcome.created) {
