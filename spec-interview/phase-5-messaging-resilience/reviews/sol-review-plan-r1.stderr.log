  90: async function waitForPosixProcessGroupExit(pid, timeoutMs) {
  91:   const deadline = Date.now() + timeoutMs;
  92:   while (Date.now() < deadline) {
  93:     if (!isPosixProcessGroupAlive(pid)) return true;
  94:     await delay(50);
  95:   }
  96:   return !isPosixProcessGroupAlive(pid);
