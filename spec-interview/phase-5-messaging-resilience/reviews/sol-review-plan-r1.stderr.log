  49: 
  50: function captureLoadBaseline(userId: string, conversations: Conversation[]): LoadBaseline {
  51:   const lastActivityByConversation = new Map<string, number>();
  52:   for (const conversation of conversations) {
  53:     const at = new Date(conversation.lastActivity).getTime();
  54:     if (Number.isFinite(at)) lastActivityByConversation.set(conversation.id, at);
  55:   }
  56:   return { userId, lastActivityByConversation };
