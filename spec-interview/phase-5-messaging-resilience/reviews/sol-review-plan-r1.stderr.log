  72: /**
  73:  * A replayed key must carry the same composition: content, reply target, the
  74:  * same attachment set (attachment id = upload id), and — for messages without
  75:  * attachments — the same type (attachment messages derive their type from
  76:  * their attachments).
  77:  */
  78: function isSameComposition(
  79:   stored: Message,
  80:   storedAttachmentIdList: readonly string[],
  81:   expected: { content: string; type?: MessageType; replyToId?: string; attachmentIds: readonly string[] }
  82: ): boolean {
