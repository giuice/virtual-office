 129: /**
 130:  * Creates the message and links its pending uploads in one transaction
 131:  * (BR-007: never visible partially attached). The uploads must belong to the
 132:  * caller for this conversation and pass the attachment policy on their STORED
 133:  * objects.
 134:  */
 135: async function createWithAttachments(
 136:   serviceClient: SupabaseClient,
 137:   messageRepository: IMessageRepository,
 138:   conversationRepository: IConversationRepository,
 139:   uploads: IMessageAttachmentUploadRepository,
 140:   messageData: Omit<MessageCreateData, 'type'>,
 141:   attachmentIds: string[],
 142:   clientMessageId: string | undefined
 143: ): Promise<{ response: NextResponse; created: boolean }> {
 144:   const owned = await uploads.findOwned(attachmentIds, messageData.senderId, messageData.conversationId);
 145: 
 146:   let type = MessageType.FILE;
 147:   const allUploadsPending = owned.length === attachmentIds.length;
 148:   if (allUploadsPending) {
 149:     // Phase 4 T15: a voice note travels alone (the database enforces it too).
 150:     if (owned.length > 1 && owned.some((upload) => upload.duration !== undefined)) {
 151:       return { response: voiceNoteNotAlone(), created: false };
 152:     }
 153:     const violation = await validateUploadsForLink(serviceClient, owned);
 154:     if (violation) {
 155:       return { response: jsonError(violation.status, violation.code, violation.message), created: false };
 156:     }
 157:     type = attachmentMessageType(owned.map((upload) => upload.type));
 158:   } else if (!clientMessageId) {
 159:     // Unknown, another user's, another conversation's, cancelled, or sent.
 160:     return { response: attachmentNotFound(), created: false };
 161:   }
 162:   // With a key and missing uploads the database decides: a replay of a
 163:   // committed create (its uploads were consumed) or ATTACHMENT_NOT_FOUND.
 164: 
 165:   let outcome: { messageId: string; created: boolean };
 166:   try {
 167:     outcome = await uploads.createMessageWithAttachments({ ...messageData, type }, attachmentIds, 
clientMessageId);
 168:   } catch (error) {
 169:     if (error instanceof AttachmentLinkError) {
 170:       return { response: attachmentLinkFailure(error), created: false };
 171:     }
 172:     throw error;
 173:   }
 174: 
 175:   if (outcome.created && !allUploadsPending) {
 176:     // The database can only replay or refuse when uploads were missing here.
 177:     throw new Error('create_message_with_attachments linked uploads that failed the policy pre-check');
 178:   }
 179:   if (outcome.created) {
 180:     // Committed: bump activity now so a failed read-back below (500, then a
 181:     // 200 replay on retry) never skips the recipients' badge refresh.
 182:     await touchConversation(conversationRepository, messageData.conversationId);
 183:   }
 184: 
 185:   const stored = await messageRepository.findById(outcome.messageId);
 186:   if (!stored) {
 187:     throw new Error(`Message ${outcome.messageId} not found after create`);
 188:   }
 189:   // Read strictly: findById degrades attachment read errors to [] (which would
 190:   // turn a genuine replay into a false 409 or answer 201 without files).
 191:   const linkedIds = await uploads.listLinkedAttachmentIds(outcome.messageId);
 192:   if (!outcome.created) {
 193:     if (!isSameComposition(stored, linkedIds, { ...messageData, attachmentIds })) {
 194:       return { response: clientKeyReused(), created: false };
 195:     }
 196:     return { response: NextResponse.json({ message: asResponseMessage(stored) }, { status: 200 }), created: 
false };
 197:   }
 198:   if ((stored.attachments ?? []).length !== linkedIds.length) {
 199:     // The message and its files are committed; a retry with the same key
 200:     // replays it (200) once the read succeeds.
 201:     throw new Error(`Attachments of message ${outcome.messageId} could not be read after create`);
 202:   }
 203:   return { response: NextResponse.json({ message: asResponseMessage(stored) }, { status: 201 }), created: true };
 204: }
