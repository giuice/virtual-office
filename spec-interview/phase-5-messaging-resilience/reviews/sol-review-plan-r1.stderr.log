 439: async function removeSeededMember(payload: unknown): Promise<NextResponse> {
 440:   const parsed = removeMemberSchema.safeParse(payload);
 441:   if (!parsed.success) {
 442:     return NextResponse.json(
 443:       { error: "action 'remove-member', conversationId and userId (UUIDs) are required" },
 444:       { status: 400 },
 445:     );
 446:   }
 447:   const conversationId = parsed.data.conversationId.toLowerCase();
 448:   const userId = parsed.data.userId.toLowerCase();
 449: 
 450:   try {
 451:     const supabase = await createSupabaseServerClient('service_role');
 452:     const seeder = new MessagingTestSeeder(supabase);
 453:     const isSeeded = await seeder.isSeededConversationMember(conversationId, userId, seededAccountEmails());
 454:     if (!isSeeded) {
 455:       return NextResponse.json(
 456:         { error: 'Only seeded Playwright accounts in seeded conversations can be removed' },
 457:         { status: 403 },
 458:       );
 459:     }
 460:     const removed = await seeder.removeConversationMember(conversationId, userId);
 461:     return NextResponse.json({ success: true, removed }, { status: 200 });
 462:   } catch (error) {
 463:     console.error('[Messaging Seed Route] Failed to remove conversation member', error);
 464:     return NextResponse.json(
 465:       { error: 'Failed to remove conversation member', details: (error as Error).message },
 466:       { status: 500 },
 467:     );
 468:   }
 469: }
