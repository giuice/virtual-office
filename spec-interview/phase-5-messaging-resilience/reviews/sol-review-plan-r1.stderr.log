  44: const TOO_MANY_ATTACHMENTS_MESSAGE = `A message can carry at most ${MAX_ATTACHMENTS_PER_MESSAGE} attachments`;
  45: 
  46: /**
  47:  * Phase 4 T12 (FR-008): optional ids of the caller's pending uploads
  48:  * (POST /api/messages/upload) to attach. Absent or empty → no attachments.
  49:  */
  50: function parseAttachmentIds(
  51:   value: unknown
  52: ): { ok: true; value: string[] | undefined } | { ok: false; code: string; message: string } {
  53:   if (value === undefined || value === null) {
  54:     return { ok: true, value: undefined };
  55:   }
  56:   if (!Array.isArray(value) || value.some((id) => typeof id !== 'string' || !UUID_PATTERN.test(id))) {
  57:     return { ok: false, code: 'INVALID_ATTACHMENT_ID', message: 'attachmentIds must be an array of upload ids' };
  58:   }
  59:   const ids = (value as string[]).map((id) => id.toLowerCase());
  60:   if (ids.length === 0) {
  61:     return { ok: true, value: undefined };
  62:   }
  63:   if (ids.length > MAX_ATTACHMENTS_PER_MESSAGE) {
  64:     return { ok: false, code: 'TOO_MANY_ATTACHMENTS', message: TOO_MANY_ATTACHMENTS_MESSAGE };
  65:   }
  66:   if (new Set(ids).size !== ids.length) {
  67:     return { ok: false, code: 'DUPLICATE_ATTACHMENT', message: 'attachmentIds must not repeat an upload' };
  68:   }
  69:   return { ok: true, value: ids };
