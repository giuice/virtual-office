 103: /** Waits for the page's notification count to reach `count`, then returns them. */
 104: async function expectNotificationCount(page: Page, count: number): Promise<RecordedNotification[]> {
 105:   await expect.poll(async () => (await notificationsOf(page)).length, { timeout: RECV_TIMEOUT_MS }).toBe(count);
 106:   return notificationsOf(page);
 107: }
