  34: function parseClientMessageId(value: unknown): { ok: true; value: string | undefined } | { ok: false } {
  35:   if (value === undefined || value === null) {
  36:     return { ok: true, value: undefined };
  37:   }
  38:   if (typeof value !== 'string' || !UUID_PATTERN.test(value)) {
