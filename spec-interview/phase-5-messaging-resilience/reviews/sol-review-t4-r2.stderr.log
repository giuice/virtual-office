 325:         create or replace function public.t4_test_fail_mention_insert() returns trigger
 326:         language plpgsql set search_path = '' as $$
 327:         begin
 328:           raise exception 'T4_TEST_FORCED_MENTION_FAILURE';
 329:         end
 330:         $$`);
 331:       await world.query(
 332:         `create trigger t4_test_fail_mention_insert before insert on public.message_mentions
 333:          for each row when (new.mentioned_user_id = '${secondary.appUserId}'::uuid)
 334:          execute function public.t4_test_fail_mention_insert()`,
 335:       );
 336:       const textKey = randomUUID();
 337:       const attachmentKey = randomUUID();
 338:       let uploadId = '';
 339:       try {
 340:         const text = await postCreate(primary, {
 341:           conversationId,
 342:           content: `T4 forced failure ${textKey}`,
 343:           mentionIds: [secondary.appUserId, third.appUserId],
 344:           ...attempt(primary, textKey, 1),
 345:         });
 346:         expect(text.status).toBe(500);
 347:         expect(await keyRows(primary, conversationId, textKey)).toHaveLength(0);
 348:         expect((await storedComposition(conversationId, textKey))?.committed_at ?? null).toBeNull();
 349: 
 350:         uploadId = await upload(primary, conversationId);
 351:         const withFile = await postCreate(primary, {
 352:           conversationId,
 353:           content: '',
 354:           attachmentIds: [uploadId],
 355:           mentionIds: [secondary.appUserId],
 356:           ...attempt(primary, attachmentKey, 1),
 357:         });
 358:         expect(withFile.status).toBe(500);
 359:         expect(await keyRows(primary, conversationId, attachmentKey)).toHaveLength(0);
 360:         expect(await world.query('select 1 from public.message_attachments where id = $1', 
[uploadId])).toHaveLength(0);
 361:         expect(await world.query('select 1 from public.message_attachment_uploads where id = $1', 
[uploadId])).toHaveLength(1);
 362: 
 363:         // No mention row of any message in this conversation, and no insertion charged.
 364:         expect(
 365:           await world.query(
 366:             `select 1 from public.message_mentions mm join public.messages m on m.id = mm.message_id
 367:              where m.client_message_id = any($1::uuid[])`,
 368:             [[textKey, attachmentKey]],
 369:           ),
 370:         ).toHaveLength(0);
 371:         expect(
 372:           await world.query(`select 1 from private.rate_limit_counters where user_id = $1 and action = 
'message:create'`, [
 373:             primary.appUserId,
 374:           ]),
 375:         ).toHaveLength(0);
 376:       } finally {
 377:         await world.query('drop trigger if exists t4_test_fail_mention_insert on public.message_mentions');
 378:         await world.query('drop function if exists public.t4_test_fail_mention_insert()');
 379:       }
 380: 
 381:       // Once storage works, the same attempts create everything exactly once.
 382:       const textRetry = await postCreate(primary, {
 383:         conversationId,
 384:         content: `T4 forced failure ${textKey}`,
 385:         mentionIds: [secondary.appUserId, third.appUserId],
 386:         ...attempt(primary, textKey, 1),
 387:       });
 388:       expect(textRetry.status, JSON.stringify(textRetry.body)).toBe(201);
 389:       expect(await storedMentions(textRetry.body.message?.id as string)).toEqual(sorted([secondary.appUserId, 
third.appUserId]));
 390:       const fileRetry = await postCreate(primary, {
 391:         conversationId,
 392:         content: '',
 393:         attachmentIds: [uploadId],
 394:         mentionIds: [secondary.appUserId],
 395:         ...attempt(primary, attachmentKey, 1),
