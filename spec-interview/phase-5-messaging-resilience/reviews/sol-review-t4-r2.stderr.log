  39:     const messageRepository: IMessageRepository = new SupabaseMessageRepository(ctx.supabase);
  40:     const paginationOptions: PaginationOptions = {
  41:       limit,
  42:       cursorBefore: cursorBefore || undefined,
  43:       cursorAfter: cursorAfter || undefined,
  44:     };
  45: 
  46:     const result: PaginatedResult<Message> = await messageRepository.findByConversation(
  47:       conversationId,
  48:       paginationOptions
  49:     );
