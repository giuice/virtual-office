 631:   private async readCreatedMessage(messageId: string, withMentions: boolean): Promise<Message> {
 632:     const { data, error } = await this.supabaseClient
 633:       .from(this.MSG_TABLE_NAME)
 634:       .select('*')
 635:       .eq('id', messageId)
 636:       .single();
 637: 
 638:     if (error || !data) {
 639:       console.error('Error reading message after create:', error);
 640:       throw error || new Error(`Message ${messageId} not found after create`);
 641:     }
 642:     if (!withMentions) {
 643:       return mapCreatedMessage(data as MessageRow);
 644:     }
 645:     const mentions = await this.loadMentionedUserIds([messageId]);
 646:     return mapCreatedMessage(data as MessageRow, mentions.get(messageId.toLowerCase()) ?? []);
 647:   }
 648: 
 649:   // Idempotent create (Phase 4 FR-024): the composition key is unique per
 650:   // (sender_id, conversation_id) through the partial unique index
 651:   // messages_sender_conversation_client_message_id_key. Phase 5 T2: the insert
 652:   // runs in public.create_message_attempt, which returns the stored message on
 653:   // a replay or a lost same-key race, and refuses to commit a fenced attempt
 654:   // (AttemptSupersededError) — see migration 20261007095045. Phase 5 T3: a
 655:   // winning insertion charges insertQuota in the same transaction
 656:   // (InsertionRateLimitError, nothing stored) — migration 20261007114454.
 657:   async createWithClientKey(
 658:     messageData: MessageCreateData,
 659:     clientMessageId: string,
 660:     attempt: MessageAttempt | undefined,
 661:     insertQuota: InsertionQuota | null
 662:   ): Promise<MessageCreateResult> {
 663:     const result = await createMessageAttempt(this.supabaseClient, {
 664:       data: messageData,
 665:       clientMessageId,
 666:       attempt,
 667:       uploadIds: [],
 668:       insertQuota,
 669:     });
 670: 
 671:     // Phase 5 T4: a winning insertion answers with the mentions it stored in
 672:     // its own transaction; a replay reads the stored message and mentions.
 673:     const createdRow = result.created ? parseCreatedRow(result.createdRow) : null;
 674:     return {
 675:       message: createdRow
 676:         ? mapCreatedMessage(createdRow, result.mentionedUserIds ?? [])
 677:         : await this.readCreatedMessage(result.messageId, true),
 678:       created: result.created,
 679:       storedComposition: result.storedComposition,
 680:     };
 681:   }
