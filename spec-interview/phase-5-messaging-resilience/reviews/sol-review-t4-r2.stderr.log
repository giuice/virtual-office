 604:   // Phase 5 T3: unkeyed create in public.create_message_attempt (null key and
 605:   // generation) so the insertion quota is charged in the insertion's own
 606:   // transaction — a failed INSERT is never charged (migration 20261007114454).
 607:   // The answer is the row the function built in that transaction: no
 608:   // post-commit read can fail after the message is stored (a keyless retry
 609:   // would duplicate it).
 610:   async createUnkeyed(messageData: MessageCreateData, insertQuota: InsertionQuota): Promise<Message> {
 611:     const result = await createMessageAttempt(this.supabaseClient, {
 612:       data: messageData,
 613:       uploadIds: [],
 614:       insertQuota,
 615:     });
 616:     if (!result.created) {
 617:       throw new Error(`create_message_attempt replayed unkeyed message ${result.messageId}`);
 618:     }
 619:     // An unkeyed create carries no composition, hence no mention (T4): its
 620:     // legacy response shape is unchanged (no mentionedUserIds).
 621:     const row = parseCreatedRow(result.createdRow);
 622:     if (row) {
 623:       return mapCreatedMessage(row);
 624:     }
 625:     // Unreachable while the function returns its RETURNING row; the message is
 626:     // committed, so read it rather than answer 500 for a stored message.
 627:     console.error('create_message_attempt returned a malformed created row:', result.messageId);
 628:     return this.readCreatedMessage(result.messageId, false);
 629:   }
