 397:       expect(fileRetry.status, JSON.stringify(fileRetry.body)).toBe(201);
 398:       expect(fileRetry.body.message?.attachments?.map((item) => item.id)).toEqual([uploadId]);
 399:       expect(await storedMentions(fileRetry.body.message?.id as string)).toEqual([secondary.appUserId]);
 400:     });
