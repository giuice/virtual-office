 471:   async findByConversation(conversationId: string, options?: PaginationOptions): 
Promise<PaginatedResult<Message>> {
 472:     const limit = options?.limit ?? 50; // Default limit for messages
 473: 
 474:     // Keyset pagination by timestamp when provided
 475:     const hasCursorBefore = !!options?.cursorBefore;
 476:     const hasCursorAfter = !!options?.cursorAfter;
 477: 
 478:     let data: any[] | null = null;
 479:     let error: any | null = null;
 480: 
 481:     if (hasCursorBefore || hasCursorAfter) {
 482:       // Use keyset pagination - fetch limit + 1 to check for more results.
 483:       // Audit M-03: composite (timestamp, id) cursor so equal timestamps
 484:       // cannot skip or duplicate rows across pages. Legacy timestamp-only
 485:       // cursors are still accepted.
 486:       let query = this.supabaseClient
 487:         .from(this.MSG_TABLE_NAME)
 488:         .select('*')
 489:         .eq('conversation_id', conversationId);
 490: 
 491:       if (hasCursorBefore) {
 492:         const { ts, id } = parseCompositeCursor(options!.cursorBefore!);
 493:         query = id
 494:           ? query.or(`timestamp.lt."${ts}",and(timestamp.eq."${ts}",id.lt."${id}")`)
 495:           : query.lt('timestamp', ts);
 496:         // Get older messages relative to cursorBefore, newest-first to apply limit
 497:         query = query
 498:           .order('timestamp', { ascending: false })
 499:           .order('id', { ascending: false })
 500:           .limit(limit + 1);
 501:       } else if (hasCursorAfter) {
 502:         const { ts, id } = parseCompositeCursor(options!.cursorAfter!);
 503:         query = id
 504:           ? query.or(`timestamp.gt."${ts}",and(timestamp.eq."${ts}",id.gt."${id}")`)
 505:           : query.gt('timestamp', ts);
 506:         // Get newer messages relative to cursorAfter, oldest-first for append
 507:         query = query
 508:           .order('timestamp', { ascending: true })
 509:           .order('id', { ascending: true })
 510:           .limit(limit + 1);
 511:       }
 512: 
 513:       const res = await query;
 514:       data = res.data as any[] | null;
 515:       error = res.error;
 516:       if (error) {
 517:         console.error('Error fetching messages by conversation (keyset):', error);
 518:         throw error;
 519:       }
 520:       // For cursorBefore branch, data is DESC; reverse to ASC for rendering
 521:       if (hasCursorBefore && data) {
 522:         data = [...data].reverse();
 523:       }
 524:     } else {
 525:       // Initial load: fetch most recent messages, newest first
 526:       const res = await this.supabaseClient
 527:         .from(this.MSG_TABLE_NAME)
 528:         .select('*')
 529:         .eq('conversation_id', conversationId)
 530:         .order('timestamp', { ascending: false })
 531:         .order('id', { ascending: false })
 532:         .limit(limit + 1);
 533:       data = res.data as any[] | null;
 534:       error = res.error;
 535:       if (error) {
 536:         console.error('Error fetching messages by conversation (initial):', error);
 537:         throw error;
 538:       }
 539:       // Reverse to oldest-first for UI rendering
 540:       if (data) {
 541:         data = [...data].reverse();
 542:       }
 543:     }
 544: 
 545:     if (!data || data.length === 0) {
 546:       return {
 547:         items: [],
 548:         hasMore: false,
 549:         nextCursor: null
 550:       };
 551:     }
 552: 
 553:     // Check if we have more results
 554:     const hasMore = data.length > limit;
 555:     // Trim to actual limit, preserving chronological (oldest->newest) order
 556:     const trimmedData = hasMore
 557:       ? (hasCursorAfter ? data.slice(0, limit) : data.slice(data.length - limit))
 558:       : data;
 559: 
 560:     const enrichedMessages = await this.enrichFeedMessages(
 561:       mapMessageArrayToCamelCase(trimmedData),
 562:       conversationId
 563:     );
 564: 
 565:     // Determine nextCursor based on pagination direction. Built from the RAW
 566:     // row (full Postgres timestamp precision) — Date#toISOString truncates to
 567:     // milliseconds, which can skip sub-millisecond neighbors at the boundary.
 568:     let nextCursor: string | number | null = null;
 569:     if (hasMore) {
 570:       if (hasCursorAfter) {
 571:         // Paging toward newer messages: continue after the newest returned row
 572:         const newestRow = trimmedData[trimmedData.length - 1];
 573:         nextCursor = buildCompositeCursor(newestRow);
 574:       } else {
 575:         // Initial load or paging toward older messages: continue before the
 576:         // oldest returned row (trimmedData is oldest-first)
 577:         const oldestRow = trimmedData[0];
 578:         nextCursor = buildCompositeCursor(oldestRow);
 579:       }
 580:     }
 581: 
 582:     return {
 583:       items: enrichedMessages,
 584:       hasMore,
 585:       nextCursor
 586:     };
 587:   }
