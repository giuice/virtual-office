 825:   async getMessageReaders(messageId: string, senderId: string): Promise<MessageReader[]> {
 826:     // One query: receipts joined with the reader's users row, most recent
 827:     // first. The sender's own receipt is excluded defensively (BR-002: the
 828:     // RPCs never write one). Callers must have verified the requester IS the
 829:     // sender (BR-003); on a user-scoped client RLS enforces it again.
 830:     const { data, error } = await this.supabaseClient
 831:       .from(this.READ_RECEIPT_TABLE_NAME)
 832:       .select('user_id, read_at, reader:users!message_read_receipts_user_id_fkey(display_name, avatar_url)')
 833:       .eq('message_id', messageId)
 834:       .neq('user_id', senderId)
 835:       .order('read_at', { ascending: false })
 836:       .order('user_id', { ascending: true })
 837:       .overrideTypes<MessageReaderRow[], { merge: false }>();
 838: 
 839:     if (error) {
 840:       console.error('Error fetching message readers:', error);
 841:       throw error;
 842:     }
 843: 
 844:     return (data ?? []).map((row) => ({
 845:       userId: row.user_id,
 846:       displayName: row.reader?.display_name ?? null,
 847:       avatarUrl: row.reader?.avatar_url ?? null,
 848:       readAt: new Date(row.read_at),
 849:     }));
 850:   }
