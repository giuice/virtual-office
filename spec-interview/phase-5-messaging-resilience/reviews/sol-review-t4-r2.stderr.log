  52:     // hasMore plus a composite (timestamp, id) cursor — no probe query.
  53:     // nextCursorBefore is only set when older messages actually exist, so the
  54:     // client's hasNextPage matches reality.
  55:     const isPagingNewer = Boolean(cursorAfter);
