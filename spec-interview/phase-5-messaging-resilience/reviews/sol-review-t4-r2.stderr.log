 209: export class SupabaseMessageRepository implements IMessageRepository {
 210:   private MSG_TABLE_NAME = 'messages'; // Ensure this matches your Supabase table name
 211:   private REACTION_TABLE_NAME = 'message_reactions'; // Assuming separate table
 212:   private ATTACHMENT_TABLE_NAME = 'message_attachments'; // Assuming separate table
 213:   private READ_RECEIPT_TABLE_NAME = 'message_read_receipts'; // Read receipts table
 214:   private MESSAGE_PIN_TABLE_NAME = 'pinned_messages'; // Message pins table
 215:   private MESSAGE_STAR_TABLE_NAME = 'starred_messages'; // Message stars table
 216:   private supabaseClient: SupabaseClient;
 217: 
 218:   constructor(supabaseClient: SupabaseClient) {
 219:     this.supabaseClient = supabaseClient;
 220:   }
 221: 
 222:   /**
 223:    * Phase 5 T4 (FR-024): mentioned users (users.id, sorted) per message id;
 224:    * every requested id gets an entry (empty when none). Read through
 225:    * public.list_message_mentions, which answers ONE jsonb object per call, so
 226:    * PostgREST's max-rows can never truncate it (review T4 r1 finding 1); ids
 227:    * are sent in batches of MENTION_READ_BATCH_SIZE. SECURITY INVOKER: under a
 228:    * user-scoped client, mention RLS limits the answer to conversations the
 229:    * caller belongs to. Throws when they cannot be read: an empty list would
 230:    * silently drop a mention (highlight, notification).
 231:    */
 232:   private async loadMentionedUserIds(messageIds: readonly string[]): Promise<Map<string, string[]>> {
 233:     // Keys lowercase: the database answers with lowercase uuid text.
 234:     const byMessageId = new Map<string, string[]>(messageIds.map((id) => [id.toLowerCase(), []]));
 235:     const uniqueIds = [...byMessageId.keys()];
 236:     const batches: string[][] = [];
 237:     for (let start = 0; start < uniqueIds.length; start += MENTION_READ_BATCH_SIZE) {
 238:       batches.push(uniqueIds.slice(start, start + MENTION_READ_BATCH_SIZE));
 239:     }
 240:     const answers = await Promise.all(
 241:       batches.map((batch) => this.supabaseClient.rpc('list_message_mentions', { p_message_ids: batch }))
 242:     );
 243:     for (const { data, error } of answers) {
 244:       if (error) {
 245:         console.error('Error fetching message mentions:', error);
 246:         throw error;
 247:       }
 248:       if (typeof data !== 'object' || data === null || Array.isArray(data)) {
 249:         throw new Error('list_message_mentions returned an unexpected result');
 250:       }
 251:       for (const [messageId, ids] of Object.entries(data as Record<string, unknown>)) {
 252:         const target = byMessageId.get(messageId);
 253:         if (!target || !Array.isArray(ids) || ids.some((id) => typeof id !== 'string')) {
 254:           throw new Error('list_message_mentions returned an unexpected result');
 255:         }
 256:         target.push(...(ids as string[]));
 257:       }
 258:     }
 259:     byMessageId.forEach((ids) => ids.sort());
 260:     return byMessageId;
 261:   }
 262: 
 263:   private async enrichMessages(messages: Message[]): Promise<Message[]> {
 264:     if (messages.length === 0) {
 265:       return messages;
 266:     }
 267: 
 268:     const messageIds = messages.map(m => m.id);
 269:     // Started first, awaited after the other reads (one fewer serial round trip).
 270:     const mentionsPromise = this.loadMentionedUserIds(messageIds);
 271:     // Settle it even when an await below throws (no unhandled rejection).
 272:     mentionsPromise.catch(() => undefined);
 273: 
 274:     const { data: attachmentsData } = await this.supabaseClient
 275:       .from(this.ATTACHMENT_TABLE_NAME)
 276:       .select('*')
 277:       .in('message_id', messageIds);
 278: 
 279:     const attachmentsByMessageId = (attachmentsData as AttachmentRow[] | null || []).reduce((acc: Record<string, 
FileAttachment[]>, row: AttachmentRow) => {
 280:       const msgId = row.message_id as string;
 281:       if (!acc[msgId]) acc[msgId] = [];
 282:       acc[msgId].push(mapAttachmentToCamelCase(row));
 283:       return acc;
 284:     }, {} as Record<string, FileAttachment[]>);
 285: 
 286:     const { data: reactionsData } = await this.supabaseClient
 287:       .from(this.REACTION_TABLE_NAME)
 288:       .select('*')
 289:       .in('message_id', messageIds);
 290: 
 291:     const reactionsByMessageId = (reactionsData as ReactionRow[] | null || []).reduce((acc: Record<string, 
MessageReaction[]>, row: ReactionRow) => {
 292:       const msgId = row.message_id as string;
 293:       if (!acc[msgId]) acc[msgId] = [];
 294:       acc[msgId].push(mapReactionToCamelCase(row));
 295:       return acc;
 296:     }, {} as Record<string, MessageReaction[]>);
 297: 
 298:     const mentionsByMessageId = await mentionsPromise;
 299:     messages.forEach(message => {
 300:       message.attachments = attachmentsByMessageId[message.id] || [];
 301:       message.reactions = reactionsByMessageId[message.id] || [];
 302:       message.mentionedUserIds = mentionsByMessageId.get(message.id.toLowerCase()) ?? [];
 303:     });
 304: 
 305:     return messages;
 306:   }
 307: 
 308:   // Full feed enrichment shared by the paginated feed and the starred list
 309:   // (Phase 4 FR-021): attachments, reactions, pins, the viewer's stars
 310:   // (star RLS returns only the caller's own rows), readCount and the derived
 311:   // READ status. Routes still strip readCount from messages the viewer did
 312:   // not send (FR-003).
 313:   private async enrichFeedMessages(messages: Message[], conversationId: string): Promise<Message[]> {
 314:     if (messages.length === 0) {
 315:       return messages;
 316:     }
 317: 
 318:     const messageIds = messages.map(m => m.id);
 319:     const enrichedMessages = await this.enrichMessages(messages);
 320: 
 321:     // Fetch all pins for these messages in bulk
 322:     const { data: pinsData, error: pinsError } = await this.supabaseClient
 323:       .from(this.MESSAGE_PIN_TABLE_NAME)
 324:       .select('*')
 325:       .in('message_id', messageIds);
 326: 
 327:     if (pinsError) {
 328:       console.error(`Error fetching pins for conversation ${conversationId}:`, pinsError);
 329:     }
 330:     const pinsByMessageId = (pinsData as MessagePinRow[] | null || []).reduce((acc: Record<string, 
MessagePin[]>, row: MessagePinRow) => {
 331:       const msgId = row.message_id;
 332:       if (!acc[msgId]) acc[msgId] = [];
 333:       acc[msgId].push(mapMessagePinToCamelCase(row));
 334:       return acc;
 335:     }, {} as Record<string, MessagePin[]>);
 336: 
 337:     // Fetch all stars for these messages in bulk
 338:     const { data: starsData, error: starsError } = await this.supabaseClient
 339:       .from(this.MESSAGE_STAR_TABLE_NAME)
 340:       .select('*')
 341:       .in('message_id', messageIds);
 342: 
 343:     if (starsError) {
 344:       console.error(`Error fetching stars for conversation ${conversationId}:`, starsError);
 345:     }
 346:     const starsByMessageId = (starsData as MessageStarRow[] | null || []).reduce((acc: Record<string, 
MessageStar[]>, row: MessageStarRow) => {
 347:       const msgId = row.message_id;
 348:       if (!acc[msgId]) acc[msgId] = [];
 349:       acc[msgId].push(mapMessageStarToCamelCase(row));
 350:       return acc;
 351:     }, {} as Record<string, MessageStar[]>);
 352: 
 353:     // Audit B-05/Phase 2.2: messages.status is frozen at 'sent' in the DB;
 354:     // the read indicator derives from message_read_receipts. Rule: read if
 355:     // ANY non-sender receipt exists (receipts are only ever written for
 356:     // non-senders). Phase 4 FR-001: readCount is the number of distinct
 357:     // non-sender readers ("Lida por N"); (message_id, user_id) is unique, so
 358:     // counting rows counts readers. Receipt RLS returns every reader's row
 359:     // only to the message's sender (anyone else sees just their own), so the
 360:     // count is exact for the viewer's own messages — the only ones it is
 361:     // shown on.
 362:     const { data: receiptsData, error: receiptsError } = await this.supabaseClient
 363:       .from(this.READ_RECEIPT_TABLE_NAME)
 364:       .select('message_id, user_id')
 365:       .in('message_id', messageIds);
 366: 
 367:     if (receiptsError) {
 368:       console.error(`Error fetching read receipts for conversation ${conversationId}:`, receiptsError);
 369:     }
 370:     const senderByMessageId = new Map(enrichedMessages.map(message => [message.id, message.senderId]));
 371:     const readCountByMessageId = new Map<string, number>();
 372:     for (const row of (receiptsData || []) as Array<{ message_id: string; user_id: string }>) {
 373:       if (row.user_id === senderByMessageId.get(row.message_id)) continue;
 374:       readCountByMessageId.set(row.message_id, (readCountByMessageId.get(row.message_id) ?? 0) + 1);
 375:     }
 376: 
 377:     enrichedMessages.forEach(message => {
 378:       message.pins = pinsByMessageId[message.id] || [];
 379:       message.stars = starsByMessageId[message.id] || [];
 380:       message.readCount = readCountByMessageId.get(message.id) ?? 0;
 381:       if (message.readCount > 0 && message.status !== MessageStatus.FAILED) {
 382:         message.status = MessageStatus.READ;
 383:       }
 384:     });
 385: 
 386:     return enrichedMessages;
 387:   }
 388: 
 389:   async findById(id: string): Promise<Message | null> {
 390:     const { data, error } = await this.supabaseClient
 391:       .from(this.MSG_TABLE_NAME)
 392:       .select('*') // TODO: Select related reactions/attachments if needed
 393:       .eq('id', id)
 394:       .single();
 395: 
 396:     if (error && error.code !== 'PGRST116') {
 397:       console.error('Error fetching message by ID:', error);
 398:       throw error;
 399:     }
 400: 
 401:     if (!data) {
 402:       return null;
 403:     }
 404: 
 405:     // Map the core message data
 406:     const message = mapMessageToCamelCase(data);
 407:     const mentionsPromise = this.loadMentionedUserIds([message.id]);
 408:     mentionsPromise.catch(() => undefined);
 409: 
 410:     const [
 411:       { data: attachmentsData, error: attachmentsError },
 412:       { data: reactionsData, error: reactionsError },
 413:       { data: pinsData, error: pinsError },
 414:       { data: starsData, error: starsError }
 415:     ] = await Promise.all([
 416:       this.supabaseClient
 417:         .from(this.ATTACHMENT_TABLE_NAME)
 418:         .select('*')
 419:         .eq('message_id', message.id),
 420:       this.supabaseClient
 421:         .from(this.REACTION_TABLE_NAME)
 422:         .select('*')
 423:         .eq('message_id', message.id),
 424:       this.supabaseClient
 425:         .from(this.MESSAGE_PIN_TABLE_NAME)
 426:         .select('*')
 427:         .eq('message_id', message.id),
 428:       this.supabaseClient
 429:         .from(this.MESSAGE_STAR_TABLE_NAME)
 430:         .select('*')
 431:         .eq('message_id', message.id)
 432:     ]);
 433:     message.mentionedUserIds = (await mentionsPromise).get(message.id.toLowerCase()) ?? [];
 434: 
 435:     if (attachmentsError) {
 436:       console.error(`Error fetching attachments for message ID ${message.id}:`, attachmentsError);
 437:       // Decide if you want to throw or return message without attachments
 438:       // For now, return message with empty attachments array on error
 439:       message.attachments = [];
 440:     } else {
 441:       message.attachments = mapAttachmentArrayToCamelCase(attachmentsData || []);
 442:     }
 443: 
 444:     if (reactionsError) {
 445:       console.error(`Error fetching reactions for message ID ${message.id}:`, reactionsError);
 446:       // Return message with empty reactions array on error
 447:       message.reactions = [];
 448:     } else {
 449:       message.reactions = mapReactionArrayToCamelCase(reactionsData || []);
 450:     }
 451: 
 452:     if (pinsError) {
 453:       console.error(`Error fetching pins for message ID ${message.id}:`, pinsError);
 454:       message.pins = [];
 455:     } else {
 456:       // Map pins
 457:       message.pins = (pinsData as MessagePinRow[] | null || []).map((p: MessagePinRow) => 
mapMessagePinToCamelCase(p));
 458:     }
 459: 
 460:     if (starsError) {
 461:       console.error(`Error fetching stars for message ID ${message.id}:`, starsError);
 462:       message.stars = [];
 463:     } else {
 464:       // Map stars
 465:       message.stars = (starsData as MessageStarRow[] | null || []).map((s: MessageStarRow) => 
mapMessageStarToCamelCase(s));
 466:     }
 467: 
 468:     return message;
 469:   }
