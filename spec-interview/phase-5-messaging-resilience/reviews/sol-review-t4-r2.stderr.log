 566:   describe('reads above the PostgREST max-rows limit (review T4 r1)', () => {
 567:     // supabase/config.toml max_rows = 1000: a row-returning Data API read stops
 568:     // there silently. Bulk fixtures are seeded with trusted SQL (the create
 569:     // path is covered above; its rate limits forbid 100 route creates here).
 570:     const MAX_ROWS = 1000;
 571:     const seededConversations: string[] = [];
 572:     const seededUsers: string[] = [];
 573: 
 574:     afterAll(async () => {
 575:       if (!world) return;
 576:       await world.query('delete from public.conversations where id = any($1::uuid[])', [seededConversations]);
 577:       await world.query('delete from public.users where id = any($1::uuid[])', [seededUsers]);
 578:     });
 579: 
 580:     async function seedUsers(label: string, count: number): Promise<string[]> {
 581:       const rows = await world.query<{ id: string }>(
 582:         `insert into public.users (supabase_uid, email, display_name, company_id, role)
 583:          select gen_random_uuid()::text, 't4-' || $1 || '-' || n || '-' || gen_random_uuid() || '@local.test',
 584:                 'T4 ' || $1 || ' ' || lpad(n::text, 4, '0'), $2, 'member'::public.user_role
 585:          from generate_series(1, $3::int) as n
 586:          returning id`,
 587:         [label, world.companyId, count],
 588:       );
 589:       const ids = rows.map((row) => row.id);
 590:       seededUsers.push(...ids);
 591:       return ids;
 592:     }
 593: 
 594:     async function seedGroup(participants: string[]): Promise<string> {
 595:       const rows = await world.query<{ id: string }>(
 596:         `insert into public.conversations (type, visibility, participants, name)
 597:          values ('group', 'private', $1::uuid[], $2) returning id`,
 598:         [participants, `T4 bulk ${randomUUID()}`],
 599:       );
 600:       seededConversations.push(rows[0].id);
 601:       return rows[0].id;
 602:     }
 603: 
 604:     it('returns every mention of a 100-message feed page holding more than 1000 mention rows', async () => {
 605:       const { primary, secondary } = world;
 606:       const mentioned = sorted(await seedUsers('mentioned', 11));
 607:       const conversationId = await seedGroup([primary.appUserId, secondary.appUserId, ...mentioned]);
 608:       const messages = await world.query<{ id: string }>(
 609:         `insert into public.messages (conversation_id, sender_id, content, type, status, timestamp)
 610:          select $1, $2, 'T4 bulk ' || n, 'text', 'sent', now() - make_interval(secs => 200 - n)
 611:          from generate_series(1, 100) as n returning id`,
 612:         [conversationId, primary.appUserId],
 613:       );
 614:       await world.query(
 615:         `insert into public.message_mentions (message_id, mentioned_user_id)
 616:          select m, u from unnest($1::uuid[]) as m cross join unnest($2::uuid[]) as u`,
 617:         [messages.map((row) => row.id), mentioned],
 618:       );
 619:       expect(messages.length * mentioned.length).toBeGreaterThan(MAX_ROWS);
 620: 
 621:       // The hazard: one row-returning read of these mentions is cut at max-rows.
 622:       const capped = await secondary.client
 623:         .from('message_mentions')
 624:         .select('message_id')
 625:         .in('message_id', messages.map((row) => row.id));
 626:       expect(capped.error).toBeNull();
 627:       expect(capped.data).toHaveLength(MAX_ROWS);
 628: 
 629:       // The feed answers every mention of every message on the page.
 630:       const feed = await getFeed(secondary, conversationId);
 631:       expect(feed.status).toBe(200);
 632:       expect(feed.body.messages).toHaveLength(100);
 633:       for (const message of feed.body.messages ?? []) {
 634:         expect(message.mentionedUserIds).toEqual(mentioned);
 635:       }
 636:     });
