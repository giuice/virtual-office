 971:   /**
 972:    * Phase 4 FR-021 / BR-009: the caller's starred messages in one
 973:    * conversation, newest MESSAGE first (not star time), keyset-paginated by
 974:    * the feed's composite "{raw_pg_timestamp}|{id}" cursor (`cursorBefore`
 975:    * continues with older messages). Items come back newest-first with full
 976:    * feed enrichment. The caller must authorize conversation membership
 977:    * first; with the user-scoped client, message RLS (member-only) and star
 978:    * RLS (own stars only) also apply.
 979:    */
 980:   async getStarredMessages(
 981:     userId: string,
 982:     conversationId: string,
 983:     options?: Pick<PaginationOptions, 'limit' | 'cursorBefore'>
 984:   ): Promise<PaginatedResult<Message>> {
 985:     const limit = options?.limit ?? 20;
 986: 
 987:     // Driven from the caller's star rows (bounded by how many they starred),
 988:     // with the starred message as an inner to-one embed: filters, ordering
 989:     // and the keyset cursor apply to the MESSAGE columns, so the cursor is
 990:     // the feed's. Driving from messages instead would scan (and evaluate
 991:     // message RLS on) the whole conversation when stars are sparse.
 992:     // messages.conversation_id is authoritative; the denormalized
 993:     // starred_messages.conversation_id only narrows the star scan.
 994:     let query = this.supabaseClient
 995:       .from(this.MESSAGE_STAR_TABLE_NAME)
 996:       .select('message:messages!message_stars_message_id_fkey!inner(*)')
 997:       .eq('user_id', userId)
 998:       .eq('conversation_id', conversationId)
 999:       .eq('message.conversation_id', conversationId);
1000: 
1001:     if (options?.cursorBefore) {
1002:       const { ts, id } = parseCompositeCursor(options.cursorBefore);
1003:       query = id
1004:         ? query.or(`timestamp.lt."${ts}",and(timestamp.eq."${ts}",id.lt."${id}")`, { referencedTable: 'message' 
})
1005:         : query.lt('message.timestamp', ts);
1006:     }
1007: 
1008:     const { data, error } = await query
1009:       .order('message(timestamp)', { ascending: false })
1010:       .order('message(id)', { ascending: false })
1011:       .limit(limit + 1);
1012: 
1013:     if (error) {
1014:       console.error('Error fetching starred messages:', error);
1015:       throw error;
1016:     }
1017: 
1018:     const rows = ((data ?? []) as unknown as Array<{ message: MessageRow }>).map((row) => row.message);
1019:     const hasMore = rows.length > limit;
1020:     const pageRows = hasMore ? rows.slice(0, limit) : rows;
1021:     const items = await this.enrichFeedMessages(mapMessageArrayToCamelCase(pageRows), conversationId);
1022:     // Personal stars only, even if a privileged client is ever passed in.
1023:     items.forEach(message => {
1024:       message.stars = (message.stars ?? []).filter(star => star.userId === userId);
1025:     });
1026: 
1027:     return {
1028:       items,
1029:       hasMore,
1030:       // RAW row timestamp keeps microsecond precision (see findByConversation).
1031:       nextCursor: hasMore ? buildCompositeCursor(pageRows[pageRows.length - 1]) : null,
1032:     };
1033:   }
1034: }

