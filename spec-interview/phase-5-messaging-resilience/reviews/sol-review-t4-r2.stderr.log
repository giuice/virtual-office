  39: };
  40: /** A messages row returned by create_message_attempt (Phase 5 T3); null if malformed. */
  41: function parseCreatedRow(value: Record<string, unknown> | null): MessageRow | null {
  42:   if (
  43:     !value ||
  44:     typeof value.id !== 'string' ||
  45:     typeof value.conversation_id !== 'string' ||
  46:     typeof value.sender_id !== 'string' ||
  47:     typeof value.content !== 'string' ||
  48:     typeof value.timestamp !== 'string' ||
  49:     typeof value.type !== 'string' ||
  50:     typeof value.status !== 'string' ||
  51:     typeof value.is_edited !== 'boolean' ||
  52:     (value.reply_to_id !== null && typeof value.reply_to_id !== 'string')
  53:   ) {
  54:     return null;
  55:   }
  56:   return {
  57:     id: value.id,
  58:     conversation_id: value.conversation_id,
  59:     sender_id: value.sender_id,
  60:     content: value.content,
  61:     timestamp: value.timestamp,
  62:     type: value.type,
  63:     status: value.status,
  64:     reply_to_id: value.reply_to_id,
  65:     is_edited: value.is_edited,
  66:   };
  67: }
  68: 
  69: function mapMessageToCamelCase(data: MessageRow): Message {
  70:   if (!data) return data;
  71:   return {
  72:     id: data.id,
  73:     conversationId: data.conversation_id,
  74:     senderId: data.sender_id,
  75:     content: data.content,
  76:     timestamp: new Date(data.timestamp), // Convert DB timestamp string/obj to Date
  77:     type: data.type as MessageType,
  78:     status: data.status as MessageStatus,
  79:     replyToId: data.reply_to_id || undefined,
  80:     isEdited: data.is_edited,
  81:     attachments: [], // Placeholder - fetch separately
  82:     reactions: []    // Placeholder - fetch separately
  83:   };
  84: }
  85: 
  86: interface AttachmentFields {
  87:   id: string;
  88:   name: string;
  89:   type: string;
  90:   size: number;
  91:   url: string;
  92:   thumbnail_url?: string | null;
  93:   // Voice notes (Phase 4 T15).
  94:   duration?: number | null;
  95:   waveform_data?: unknown;
  96: }
  97: 
  98: // Map DB snake_case to FileAttachment type (camelCase); voice notes also
  99: // carry duration and waveformData (VoiceNoteAttachment).
 100: function mapAttachmentToCamelCase(data: AttachmentFields): FileAttachment | VoiceNoteAttachment {
 101:   if (!data) return data;
 102:   // Audit S-03: the bucket is private and `url` stores the storage path —
 103:   // expose the authz'd API route, which redirects to a signed URL. Legacy
 104:   // rows holding a full URL pass through (migration rewrites them to paths).
 105:   const isStoragePath = (value: string): boolean => !value.startsWith('http') && !value.startsWith('/');
 106:   const thumbnail = data.thumbnail_url || undefined;
 107:   const attachment: FileAttachment = {
 108:     id: data.id,
 109:     name: data.name,
 110:     type: data.type,
 111:     size: data.size,
 112:     url: isStoragePath(data.url) ? `/api/messages/attachment/${data.id}` : data.url,
 113:     thumbnailUrl: thumbnail && isStoragePath(thumbnail) ? `/api/messages/attachment/${data.id}` : thumbnail
 114:   };
 115:   if (typeof data.duration === 'number') {
 116:     return { ...attachment, duration: data.duration, waveformData: toVoiceNoteWaveform(data.waveform_data) ?? 
undefined };
 117:   }
 118:   return attachment;
 119: }
 120: 
 121: // Map DB snake_case to MessageReaction type (camelCase)
 122: function mapReactionToCamelCase(data: { emoji: string; user_id: string; timestamp: string }): MessageReaction {
 123:   if (!data) return data;
 124:   return {
 125:     // Assuming reaction table doesn't have its own ID in the type, or map data.id if it does
 126:     emoji: data.emoji,
 127:     userId: data.user_id,
 128:     timestamp: new Date(data.timestamp) // Convert DB timestamp string/obj to Date
 129:   };
 130: }
 131: 
 132: // Map DB snake_case to MessagePin type (camelCase)
 133: function mapMessagePinToCamelCase(data: { id: string; message_id: string; conversation_id: string; pinned_by: 
string; pinned_at: string }): MessagePin {
 134:   if (!data) return data;
 135:   return {
 136:     id: data.id,
 137:     messageId: data.message_id,
 138:     conversationId: data.conversation_id,
 139:     userId: data.pinned_by, // mapped from pinned_by
 140:     pinnedAt: new Date(data.pinned_at)
 141:   };
 142: }
 143: 
 144: // Map DB snake_case to MessageStar type (camelCase)
 145: function mapMessageStarToCamelCase(data: { id: string; message_id: string; conversation_id: string; user_id: 
string; starred_at: string }): MessageStar {
 146:   if (!data) return data;
 147:   return {
 148:     id: data.id,
 149:     messageId: data.message_id,
 150:     conversationId: data.conversation_id,
 151:     userId: data.user_id,
 152:     starredAt: new Date(data.starred_at)
 153:   };
 154: }
 155: 
 156: // Map array helpers
 157: type MessageCreateData = Omit<Message, 'id' | 'timestamp' | 'reactions' | 'attachments' | 'isEdited'>;
 158: 
 159: // Map Message type (camelCase) to DB schema (snake_case) for INSERT.
 160: // timestamp, id and is_edited use their column defaults; reactions and
 161: // attachments live in their own tables.
 162: function toMessageInsertRow(messageData: MessageCreateData) {
 163:   return {
 164:     conversation_id: messageData.conversationId,
 165:     sender_id: messageData.senderId,
 166:     content: messageData.content,
 167:     type: messageData.type,
 168:     status: messageData.status,
 169:     reply_to_id: messageData.replyToId,
 170:   };
 171: }
 172: 
 173: function mapCreatedMessage(row: MessageRow, mentionedUserIds?: string[]): Message {
 174:   const message = mapMessageToCamelCase(row);
 175:   message.reactions = message.reactions || [];
 176:   message.attachments = message.attachments || [];
 177:   if (mentionedUserIds) {
 178:     message.mentionedUserIds = [...mentionedUserIds].sort();
 179:   }
 180:   return message;
 181: }
 182: 
 183: function mapMessageArrayToCamelCase(dataArray: MessageRow[]): Message[] {
 184:   if (!dataArray) return [];
 185:   return dataArray.map(item => mapMessageToCamelCase(item));
 186: }
 187: function mapAttachmentArrayToCamelCase(dataArray: AttachmentFields[]): FileAttachment[] {
 188:   if (!dataArray) return [];
 189:   return dataArray.map(item => mapAttachmentToCamelCase(item));
 190: }
 191: function mapReactionArrayToCamelCase(dataArray: { emoji: string; user_id: string; timestamp: string }[]): 
MessageReaction[] {
 192:   if (!dataArray) return [];
 193:   return dataArray.map(item => mapReactionToCamelCase(item));
 194: }
 195: 
 196: type AttachmentRow = AttachmentFields & { message_id: string };
 197: type ReactionRow = { message_id: string; user_id: string; emoji: string; timestamp: string };
 198: type MessagePinRow = { id: string; message_id: string; conversation_id: string; pinned_by: string; pinned_at: 
string };
 199: type MessageStarRow = { id: string; message_id: string; conversation_id: string; user_id: string; starred_at: 
string };
 200: /** Most message ids per public.list_message_mentions call (the function accepts 1000). */
 201: const MENTION_READ_BATCH_SIZE = 500;
 202: type MessageReaderRow = {
 203:   user_id: string;
 204:   read_at: string;
 205:   reader: { display_name: string | null; avatar_url: string | null } | null;
 206: };
