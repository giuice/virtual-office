 617: -- ---------------------------------------------------------------------------
 618: -- 4. conversations: client writes.
 619: -- ---------------------------------------------------------------------------
 620: -- Authorizes a client-created conversation under row locks (see header).
 621: -- Raises CONVERSATION_CREATE_FORBIDDEN / ROOM_ACCESS_DENIED (42501),
 622: -- USER_NOT_FOUND / ROOM_NOT_FOUND (P0002).
 623: create or replace function private.authorize_client_conversation_insert(
 624:   p_type text,
 625:   p_participants uuid[],
 626:   p_room_id uuid,
 627:   p_visibility text
 628: )
 629: returns void
 630: language plpgsql
 631: security definer
 632: set search_path = ''
 633: as $$
 634: declare
 635:   v_caller uuid := private.current_app_user_id();
 636:   v_users public.users[];
 637:   v_space public.spaces;
 638:   v_derived text;
 639: begin
 640:   if v_caller is null
 641:      or p_participants is null
 642:      or array_position(p_participants, null) is not null
 643:      or not (v_caller = any (p_participants)) then
 644:     raise exception 'CONVERSATION_CREATE_FORBIDDEN' using errcode = '42501';
 645:   end if;
 646: 
 647:   if p_type = 'direct' then
 648:     if pg_catalog.cardinality(p_participants) <> 2
 649:        or (select pg_catalog.count(distinct x) from pg_catalog.unnest(p_participants) as t(x)) <> 2
 650:        or p_room_id is not null
 651:        or p_visibility is distinct from 'direct' then
 652:       raise exception 'CONVERSATION_CREATE_FORBIDDEN' using errcode = '42501';
 653:     end if;
 654: 
 655:     select pg_catalog.array_agg(locked order by (locked).id) into v_users
 656:     from (
 657:       select u as locked
 658:       from public.users u
 659:       where u.id = any (p_participants)
 660:       order by u.id
 661:       for share
 662:     ) as l;
 663:     if coalesce(pg_catalog.cardinality(v_users), 0) <> 2 then
 664:       raise exception 'USER_NOT_FOUND' using errcode = 'P0002';
 665:     end if;
 666:     if (v_users[1]).company_id is not null
 667:        and (v_users[2]).company_id is not null
 668:        and (v_users[1]).company_id <> (v_users[2]).company_id then
 669:       raise exception 'CONVERSATION_CREATE_FORBIDDEN' using errcode = '42501',
 670:         detail = 'COMPANY_MISMATCH';
 671:     end if;
 672:     return;
 673:   end if;
 674: 
 675:   if p_type = 'room' then
 676:     if pg_catalog.cardinality(p_participants) <> 1 or p_room_id is null then
 677:       raise exception 'CONVERSATION_CREATE_FORBIDDEN' using errcode = '42501';
 678:     end if;
 679:     perform private.authorize_room_membership(array[v_caller], p_room_id);
 680: 
 681:     select s.* into v_space from public.spaces s where s.id = p_room_id;
 682:     v_derived := case
 683:       when (v_space.access_control -> 'isPublic') = 'false'::jsonb then 'private'
 684:       else 'public'
 685:     end;
 686:     if p_visibility is distinct from v_derived then
 687:       raise exception 'CONVERSATION_CREATE_FORBIDDEN' using errcode = '42501',
 688:         detail = 'VISIBILITY_MISMATCH';
 689:     end if;
 690:     return;
 691:   end if;
 692: 
 693:   raise exception 'CONVERSATION_CREATE_FORBIDDEN' using errcode = '42501';
 694: end;
 695: $$;
