1023:   -- Ids outside the conversation are ignored; the caller's own messages never
1024:   -- get a receipt (system messages with a null sender may). Repeats are
1025:   -- idempotent on the unique (message_id, user_id).
1026:   insert into public.message_read_receipts (message_id, conversation_id, user_id)
