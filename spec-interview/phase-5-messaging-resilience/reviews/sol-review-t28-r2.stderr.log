 421: -- Locks the users (FOR SHARE, id order) and then the space (FOR SHARE) and
 422: -- raises unless every user passes the room's access rules on the locked rows:
 423: -- USER_NOT_FOUND / ROOM_NOT_FOUND (P0002), ROOM_ACCESS_DENIED (42501).
 424: -- Called only from SECURITY DEFINER code of this migration.
 425: create or replace function private.authorize_room_membership(p_user_ids uuid[], p_space_id uuid)
 426: returns void
 427: language plpgsql
 428: set search_path = ''
 429: as $$
 430: declare
 431:   v_user public.users;
 432:   v_space public.spaces;
 433:   v_count integer;
 434: begin
 435:   if p_space_id is null or p_user_ids is null or pg_catalog.cardinality(p_user_ids) = 0 then
 436:     raise exception 'ROOM_NOT_FOUND' using errcode = 'P0002';
 437:   end if;
 438: 
 439:   select pg_catalog.count(*) into v_count
 440:   from (
 441:     select u.id
 442:     from public.users u
 443:     where u.id = any (p_user_ids)
 444:     order by u.id
 445:     for share
 446:   ) as locked;
 447:   if v_count <> (select pg_catalog.count(distinct x) from pg_catalog.unnest(p_user_ids) as t(x) where x is not 
null)
 448:      or array_position(p_user_ids, null) is not null then
 449:     raise exception 'USER_NOT_FOUND' using errcode = 'P0002';
 450:   end if;

