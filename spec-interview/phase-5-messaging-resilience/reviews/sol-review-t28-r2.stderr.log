1000: 
1001:   if p_message_ids is null or pg_catalog.cardinality(p_message_ids) = 0 then
1002:     return 0;
1003:   end if;
1004: 
1005:   -- Bounded input: the route caps the batch at 100 ids as well.
1006:   if pg_catalog.cardinality(p_message_ids) > 100 then
