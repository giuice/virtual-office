 728: -- ---------------------------------------------------------------------------
 729: -- 5. Participants sync: creation, and authorized additions only.
 730: -- ---------------------------------------------------------------------------
 731: create or replace function public.sync_conversation_members()
 732: returns trigger
 733: language plpgsql
 734: security definer
 735: set search_path = ''
 736: as $$
 737: declare
 738:   v_added uuid[];
 739: begin
 740:   if tg_op = 'INSERT' then
 741:     -- The memberships of a new conversation (client inserts were authorized
 742:     -- by conversations_guard_client_insert; service-role/admin inserts are
 743:     -- server code).
 744:     insert into public.conversation_members (conversation_id, user_id, last_read_at)
 745:     select new.id, u.id, pg_catalog.now()
 746:     from public.users u
 747:     where u.id = any (coalesce(new.participants, '{}'::uuid[]))
 748:     on conflict (conversation_id, user_id) do nothing;
 749:     return new;
 750:   end if;
 751: 
 752:   -- UPDATE OF participants: only ids newly added get a membership; an id
 753:   -- already in the old array (e.g. a removed member) is never re-created.
 754:   select coalesce(pg_catalog.array_agg(distinct u.id order by u.id), '{}'::uuid[])
 755:   into v_added
 756:   from public.users u
 757:   where u.id = any (coalesce(new.participants, '{}'::uuid[]))
 758:     and array_position(coalesce(old.participants, '{}'::uuid[]), u.id) is null;
 759: 
 760:   if pg_catalog.cardinality(v_added) = 0 then
 761:     return new;
 762:   end if;
 763: 
 764:   if new.type <> 'room'::public.conversation_type or new.room_id is null then
 765:     raise exception 'MEMBERSHIP_GRANT_FORBIDDEN' using errcode = '42501';
 766:   end if;
 767:   if exists (
 768:     select 1
 769:     from private.conversation_member_revocations r
 770:     where r.conversation_id = new.id
 771:       and r.user_id = any (v_added)
 772:   ) then
 773:     raise exception 'MEMBERSHIP_REVOKED' using errcode = '42501';
 774:   end if;
 775: 
 776:   perform private.authorize_room_membership(v_added, new.room_id);
 777: 
 778:   insert into public.conversation_members (conversation_id, user_id, last_read_at)
 779:   select new.id, a.user_id, pg_catalog.now()
 780:   from pg_catalog.unnest(v_added) as a(user_id)
 781:   on conflict (conversation_id, user_id) do nothing;
 782:   return new;
 783: end;
 784: $$;
 785: 
 786: -- A trigger function cannot be called directly; the baseline grants are still
 787: -- removed from the API roles (RLS review). service_role keeps its grant.
 788: revoke execute on function public.sync_conversation_members() from public, anon, authenticated;
