 const fs=(await c.query(\"select p.proname,n.nspname,p.prosrc from pg_proc p join pg_namespace n on 
n.oid=p.pronamespace where n.nspname in ('public','private') and p.prokind='f' order by 2,1\")).rows;
 for(const f of fs){
  if("'!/(presence|knock|company|screen_share)/.test(f.proname))continue;
  const ls=f.prosrc.split('"'\\n');const steps=[];
  for(let i=0;i<ls.length;i++)if("'!ls[i].trim().startsWith('"'--')&&/\\b(for update|for share|for no key update|for 
key share|lock table|update public\\.users|update public\\.spaces)\\b/i.test(ls[i])){
