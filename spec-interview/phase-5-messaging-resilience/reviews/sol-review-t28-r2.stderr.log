12:   v_mention_ids uuid[] := '{}'::uuid[];
13:   v_mentioned uuid[] := '{}'::uuid[];
14: begin
15:   if p_conversation_id is null or p_sender_id is null or p_content is null or p_type is null then
16:     raise exception 'create_message_attempt: conversation, sender, content and type are required'
17:       using errcode = '22004';
18:   end if;
19:   if p_attempt_generation is not null and (p_client_message_id is null or p_attempt_generation < 1) then
20:     raise exception 'ATTEMPT_GENERATION_INVALID' using errcode = '22023';
21:   end if;
22:   if p_composition is not null and (p_client_message_id is null or pg_catalog.jsonb_typeof(p_composition) <> 
'object') then
23:     raise exception 'create_message_attempt: a composition needs a client key and must be an object'
24:       using errcode = '22023';
25:   end if;
26:   -- Phase 5 T3: both NULL (no charge: callers that charged elsewhere) or both
27:   -- positive.
28:   if (p_insert_quota_limit is null) <> (p_insert_quota_window_seconds is null)
29:      or p_insert_quota_limit < 1
30:      or p_insert_quota_window_seconds < 1 then
31:     raise exception 'INSERT_QUOTA_INVALID' using errcode = '22023';
32:   end if;
33: 
34:   -- Phase 5 T4 (FR-024): requested mention ids come from the original
35:   -- composition (absent key = none requested). At most 50 UUID strings.
36:   if p_composition is not null and p_composition ? 'mentionIds' then
37:     if pg_catalog.jsonb_typeof(p_composition -> 'mentionIds') <> 'array'
38:        or pg_catalog.jsonb_array_length(p_composition -> 'mentionIds') > 50
39:        or exists (
40:          select 1
41:          from pg_catalog.jsonb_array_elements(p_composition -> 'mentionIds') as e(v)
42:          where pg_catalog.jsonb_typeof(e.v) <> 'string'
43:             or (e.v #>> '{}') !~* '^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$'
44:        ) then
45:       raise exception 'MENTION_IDS_INVALID' using errcode = '22023';
46:     end if;
47:     select coalesce(pg_catalog.array_agg(distinct (e.v #>> '{}')::uuid), '{}'::uuid[])
48:     into v_mention_ids
49:     from pg_catalog.jsonb_array_elements(p_composition -> 'mentionIds') as e(v);
50:   end if;
51: 
52:   v_count := coalesce(pg_catalog.cardinality(p_upload_ids), 0);
53:   -- Same bound as the route's attachment policy (5 per message).
54:   if v_count > 5 then
55:     raise exception 'ATTACHMENT_COUNT_INVALID' using errcode = '22023';
56:   end if;
57:   if v_count > 0 then
58:     if (select pg_catalog.count(distinct u) from pg_catalog.unnest(p_upload_ids) as u) <> v_count then
59:       raise exception 'ATTACHMENT_DUPLICATE' using errcode = '22023';
60:     end if;
61:     -- Attachment messages are typed image or file (the only types allowed to
62:     -- carry empty content).
63:     if p_type not in ('image', 'file') then
64:       raise exception 'create_message_attempt: type must be image or file'
65:         using errcode = '22023';
66:     end if;
67:   end if;
68: 
69:   -- Defense in depth: the route already required membership.
70:   if not exists (
71:     select 1
72:     from public.conversation_members cm
73:     where cm.conversation_id = p_conversation_id
74:       and cm.user_id = p_sender_id
75:   ) then
76:     -- Explicit marker (Phase 5 T3): callers map only this to NOT_PARTICIPANT.
77:     raise exception 'NOT_PARTICIPANT' using errcode = '42501';
78:   end if;
79: 
80:   -- Replay of a key whose create already committed: answer with the stored
81:   -- message and link nothing (its uploads were consumed by the first create).
82:   -- Checked before the reply target: an unchanged replay is compared against
83:   -- the original composition, not re-validated (FR-024), so a reply target
84:   -- deleted since does not turn it into a refusal. Not an insertion: the
85:   -- insertion quota is not charged (Phase 5 T3, D1), and no mention is
86:   -- written or re-validated (Phase 5 T4).
87:   if p_client_message_id is not null then
88:     select m.id into v_message_id
89:     from public.messages m
90:     where m.sender_id = p_sender_id
91:       and m.conversation_id = p_conversation_id
92:       and m.client_message_id = p_client_message_id;
93:     if v_message_id is not null then
94:       return private.message_attempt_replay(
95:         p_sender_id, p_conversation_id, p_client_message_id, p_attempt_generation, v_message_id);
96:     end if;
97:   end if;
98: 
99:   -- A reply target must be a message of the same conversation.
100:   if p_reply_to_id is not null and not exists (
101:     select 1
102:     from public.messages r
103:     where r.id = p_reply_to_id
104:       and r.conversation_id = p_conversation_id
105:   ) then
106:     raise exception 'INVALID_REPLY_TARGET' using errcode = '22023';
107:   end if;
108: 
109:   if v_count > 0 then
110:     -- Lock the caller's pending uploads for this conversation (id order avoids
111:     -- deadlocks between overlapping sets). A concurrent cancel or link of the
112:     -- same upload waits here; once it commits the row is gone.
113:     select pg_catalog.count(*), pg_catalog.count(*) filter (where locked.duration is not null)
114:     into v_locked, v_voice
115:     from (
116:       select u.id, u.duration
117:       from public.message_attachment_uploads u
118:       where u.id = any (p_upload_ids)
119:         and u.uploader_id = p_sender_id
120:         and u.conversation_id = p_conversation_id
121:       order by u.id
122:       for update
123:     ) as locked;
124: 
125:     if v_locked <> v_count then
126:       -- A concurrent create with the same key may have consumed them.
127:       if p_client_message_id is not null then
128:         select m.id into v_message_id
129:         from public.messages m
130:         where m.sender_id = p_sender_id
131:           and m.conversation_id = p_conversation_id
132:           and m.client_message_id = p_client_message_id;
133:         if v_message_id is not null then
134:           return private.message_attempt_replay(
135:             p_sender_id, p_conversation_id, p_client_message_id, p_attempt_generation, v_message_id);
136:         end if;
137:       end if;
138:       -- Unknown, foreign, other-conversation, cancelled, or already linked.
139:       raise exception 'ATTACHMENT_UPLOAD_NOT_FOUND' using errcode = '22023';
140:     end if;
141: 
142:     -- Phase 4 T15: a voice note is the only attachment of its message, which
143:     -- is typed file.
144:     if v_voice > 0 and v_count > 1 then
145:       raise exception 'VOICE_NOTE_NOT_ALONE' using errcode = '22023';
146:     end if;
147:     if v_voice > 0 and p_type <> 'file' then
148:       raise exception 'create_message_attempt: a voice note message must be typed file'
149:         using errcode = '22023';
150:     end if;
151:   end if;
152: 
