 474: -- 3. conversation_members: client writes.
 475: -- ---------------------------------------------------------------------------
 476: -- Locks the existing membership row FOR KEY SHARE (a concurrent DELETE waits
 477: -- for the caller, or has committed and the row is gone). True when it exists.
 478: create or replace function private.lock_existing_conversation_membership(p_conversation_id uuid, p_user_id uuid)
 479: returns boolean
 480: language plpgsql
 481: security definer
 482: set search_path = ''
 483: as $$
 484: begin
 485:   perform 1
 486:   from public.conversation_members cm
 487:   where cm.conversation_id = p_conversation_id
 488:     and cm.user_id = p_user_id
 489:   for key share;
 490:   return found;
 491: end;
 492: $$;
 493: 
 494: revoke all on function private.lock_existing_conversation_membership(uuid, uuid) from public, anon, 
authenticated, service_role;
 495: grant execute on function private.lock_existing_conversation_membership(uuid, uuid) to authenticated, 
service_role;
 496: 
 497: -- SECURITY INVOKER on purpose: current_user is the role of the INSERT
 498: -- statement (anon/authenticated/service_role for Data API requests; the
 499: -- function owner inside SECURITY DEFINER code such as the participants sync).
 500: create or replace function private.guard_conversation_member_insert()
 501: returns trigger
 502: language plpgsql
 503: set search_path = ''
 504: as $$
 505: begin
 506:   if current_user in ('anon', 'authenticated', 'service_role') then
 507:     -- API roles never create a membership: only the upsert of an existing
 508:     -- row (which then takes the ON CONFLICT DO UPDATE path) is accepted.
 509:     if not private.lock_existing_conversation_membership(new.conversation_id, new.user_id) then
 510:       raise exception 'NOT_PARTICIPANT' using errcode = '42501';
 511:     end if;
 512:   else
 513:     -- Authorized creation (SECURITY DEFINER code of this migration, or a
 514:     -- database administrator). Review T28 r1 #1: re-checked here, at the
 515:     -- insertion boundary, after every authorization wait of the caller. The
 516:     -- existing row (if any) is locked first, so a removal either committed
 517:     -- (row gone, its revocation committed with it and visible below) or waits
 518:     -- for this transaction. A revoked user is never inserted; only
 519:     -- public.restore_conversation_membership lifts a revocation (it deletes
 520:     -- the revocation before inserting).
 521:     perform 1
 522:     from public.conversation_members cm
 523:     where cm.conversation_id = new.conversation_id
 524:       and cm.user_id = new.user_id
 525:     for key share;
 526:     if exists (
 527:       select 1
 528:       from private.conversation_member_revocations r
 529:       where r.conversation_id = new.conversation_id
 530:         and r.user_id = new.user_id
 531:     ) then
 532:       raise exception 'MEMBERSHIP_REVOKED' using errcode = '42501';
 533:     end if;
 534:   end if;
 535:   return new;
 536: end;
 537: $$;
 538: 
 539: revoke all on function private.guard_conversation_member_insert() from public, anon, authenticated, service_role;
