 790: -- ---------------------------------------------------------------------------
 791: -- 6. Server join / authorized rejoin.
 792: -- ---------------------------------------------------------------------------
 793: -- Room join (POST /api/conversations/join, room resolver). Returns true when a
 794: -- membership was created, false when the user already is a member. Raises
 795: -- CONVERSATION_NOT_FOUND / ROOM_NOT_FOUND / USER_NOT_FOUND (P0002),
 796: -- JOIN_FORBIDDEN / MEMBERSHIP_REVOKED / ROOM_ACCESS_DENIED (42501).
 797: -- Lock order (review T28 r1 #5): the user and the space (authorize_room_
 798: -- membership: users -> spaces, the Presence order), THEN the conversation â€”
 799: -- the order of a space DELETE, which locks the space and then, through
 800: -- ON DELETE SET NULL, its room conversation. The conversation is re-read
 801: -- under its lock and must still belong to the authorized room.
 802: create or replace function public.join_room_conversation(p_conversation_id uuid, p_user_id uuid)
 803: returns boolean
 804: language plpgsql
 805: security definer
 806: set search_path = ''
 807: as $$
 808: declare
 809:   v_conversation public.conversations;
 810:   v_room_id uuid;
 811: begin
 812:   if p_conversation_id is null or p_user_id is null then
 813:     raise exception 'join_room_conversation: conversation and user are required' using errcode = '22004';
 814:   end if;
 815: 
 816:   -- Unlocked read: a current member is answered without any lock (no grant).
 817:   select c.* into v_conversation
 818:   from public.conversations c
 819:   where c.id = p_conversation_id;
 820:   if not found then
 821:     raise exception 'CONVERSATION_NOT_FOUND' using errcode = 'P0002';
 822:   end if;
 823:   if exists (
 824:     select 1
 825:     from public.conversation_members cm
 826:     where cm.conversation_id = p_conversation_id
 827:       and cm.user_id = p_user_id
 828:   ) then
 829:     return false;
 830:   end if;
 831:   if v_conversation.type <> 'room'::public.conversation_type or v_conversation.room_id is null then
 832:     raise exception 'JOIN_FORBIDDEN' using errcode = '42501';
 833:   end if;
 834:   v_room_id := v_conversation.room_id;
 835: 
 836:   perform private.authorize_room_membership(array[p_user_id], v_room_id);
 837: 
 838:   select c.* into v_conversation
 839:   from public.conversations c
 840:   where c.id = p_conversation_id
 841:   for no key update;
 842:   if not found then
 843:     raise exception 'CONVERSATION_NOT_FOUND' using errcode = 'P0002';
 844:   end if;
 845:   if v_conversation.type <> 'room'::public.conversation_type
 846:      or v_conversation.room_id is distinct from v_room_id then
 847:     raise exception 'JOIN_FORBIDDEN' using errcode = '42501';
 848:   end if;
 849:   if exists (
 850:     select 1
 851:     from public.conversation_members cm
 852:     where cm.conversation_id = p_conversation_id
 853:       and cm.user_id = p_user_id
 854:   ) then
 855:     return false;
 856:   end if;
 857:   if exists (
 858:     select 1
 859:     from private.conversation_member_revocations r
 860:     where r.conversation_id = p_conversation_id
 861:       and r.user_id = p_user_id
 862:   ) then
 863:     raise exception 'MEMBERSHIP_REVOKED' using errcode = '42501';
 864:   end if;
 865: 
 866:   if array_position(coalesce(v_conversation.participants, '{}'::uuid[]), p_user_id) is null then
 867:     -- sync_conversation_members creates the membership (same checks; the
 868:     -- locks are already held, so it does not wait).
 869:     update public.conversations c
 870:     set participants = pg_catalog.array_append(coalesce(c.participants, '{}'::uuid[]), p_user_id)
 871:     where c.id = p_conversation_id;
 872:   else
 873:     insert into public.conversation_members (conversation_id, user_id, last_read_at)
 874:     values (p_conversation_id, p_user_id, pg_catalog.now())
 875:     on conflict (conversation_id, user_id) do nothing;
 876:   end if;
 877:   return true;
 878: end;
 879: $$;
 880: 
 881: revoke all on function public.join_room_conversation(uuid, uuid) from public, anon, authenticated, service_role;
 882: grant execute on function public.join_room_conversation(uuid, uuid) to service_role;
 883: 
 884: -- The explicitly authorized rejoin of a revoked member (server/admin only), and
 885: -- the only code that lifts a revocation. A ROOM conversation requires the
 886: -- room's access rules on the locked rows; a room conversation whose space was
 887: -- deleted (room_id set NULL) raises ROOM_NOT_FOUND and keeps the revocation
 888: -- (review T28 r1 #4). A direct or group conversation restores only an original
 889: -- participant. Same lock order as join_room_conversation. Returns false when
 890: -- the user already is a member. Raises CONVERSATION_NOT_FOUND / ROOM_NOT_FOUND
 891: -- / USER_NOT_FOUND (P0002), MEMBERSHIP_GRANT_FORBIDDEN / ROOM_ACCESS_DENIED
 892: -- (42501).
 893: create or replace function public.restore_conversation_membership(p_conversation_id uuid, p_user_id uuid)
 894: returns boolean
 895: language plpgsql
 896: security definer
 897: set search_path = ''
 898: as $$
 899: declare
 900:   v_conversation public.conversations;
 901:   v_type public.conversation_type;
 902:   v_room_id uuid;
 903:   v_in_participants boolean;
 904: begin
 905:   if p_conversation_id is null or p_user_id is null then
 906:     raise exception 'restore_conversation_membership: conversation and user are required' using errcode = 
'22004';
 907:   end if;
 908: 
 909:   select c.* into v_conversation
 910:   from public.conversations c
 911:   where c.id = p_conversation_id;
 912:   if not found then
 913:     raise exception 'CONVERSATION_NOT_FOUND' using errcode = 'P0002';
 914:   end if;
 915:   if exists (
 916:     select 1
 917:     from public.conversation_members cm
 918:     where cm.conversation_id = p_conversation_id
 919:       and cm.user_id = p_user_id
 920:   ) then
 921:     return false;
 922:   end if;
 923:   v_type := v_conversation.type;
 924:   v_room_id := v_conversation.room_id;
 925: 
 926:   if v_type = 'room'::public.conversation_type then
 927:     if v_room_id is null then
 928:       raise exception 'ROOM_NOT_FOUND' using errcode = 'P0002';
 929:     end if;
 930:     perform private.authorize_room_membership(array[p_user_id], v_room_id);
 931:   else
 932:     perform 1 from public.users u where u.id = p_user_id for share;
 933:     if not found then
 934:       raise exception 'USER_NOT_FOUND' using errcode = 'P0002';
 935:     end if;
 936:   end if;
 937: 
 938:   select c.* into v_conversation
 939:   from public.conversations c
 940:   where c.id = p_conversation_id
 941:   for no key update;
 942:   if not found then
 943:     raise exception 'CONVERSATION_NOT_FOUND' using errcode = 'P0002';
 944:   end if;
 945:   if v_conversation.type is distinct from v_type
 946:      or v_conversation.room_id is distinct from v_room_id then
 947:     raise exception 'MEMBERSHIP_GRANT_FORBIDDEN' using errcode = '42501';
 948:   end if;
 949:   if exists (
 950:     select 1
 951:     from public.conversation_members cm
 952:     where cm.conversation_id = p_conversation_id
 953:       and cm.user_id = p_user_id
 954:   ) then
 955:     return false;
 956:   end if;
 957: 
 958:   v_in_participants :=
 959:     array_position(coalesce(v_conversation.participants, '{}'::uuid[]), p_user_id) is not null;
 960:   if v_type <> 'room'::public.conversation_type and not v_in_participants then
 961:     raise exception 'MEMBERSHIP_GRANT_FORBIDDEN' using errcode = '42501';
 962:   end if;
 963: 
 964:   delete from private.conversation_member_revocations r
 965:   where r.conversation_id = p_conversation_id
