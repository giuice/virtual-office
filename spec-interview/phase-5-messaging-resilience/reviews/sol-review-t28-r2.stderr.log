 302: -- JavaScript truthiness of a JSON value as the TypeScript code sees it after
 303: -- JSON.parse (numbers become IEEE doubles). Returns NULL for a number outside
 304: -- the double range â€” e.g. 1e-400, which JSON.parse turns into 0, or 1e400
 305: -- (Infinity) â€” because PostgreSQL refuses it as out of range; callers treat
 306: -- NULL as a malformed ACL and deny (ROOM_ACL_INVALID), never as truthy.
 307: create or replace function private.jsonb_js_truthy(p_value jsonb)
 308: returns boolean
 309: language plpgsql
 310: immutable
 311: set search_path = ''
 312: as $$
 313: begin
 314:   case pg_catalog.jsonb_typeof(p_value)
 315:     when 'boolean' then
 316:       return (p_value)::text::boolean;
 317:     when 'number' then
 318:       begin
 319:         return ((p_value)::text)::double precision <> 0;
 320:       exception when numeric_value_out_of_range then
 321:         return null;
 322:       end;
 323:     when 'string' then
 324:       return (p_value #>> '{}') <> '';
 325:     when 'object' then
 326:       return true;
 327:     when 'array' then
 328:       return true;
 329:     else
 330:       -- JSON null, or a missing key (SQL NULL).
 331:       return false;
 332:   end case;
 333: end;
 334: $$;
 335: 
 336: revoke all on function private.jsonb_js_truthy(jsonb) from public, anon, authenticated, service_role;
 337: 
 338: -- Pure function of the two rows; null = allowed, otherwise the reason.
 339: -- Mirrors the TypeScript rule: different (non-null) companies deny; with an
 340: -- access_control object, a non-empty allowedUsers must contain users.id, a
 341: -- non-empty allowedRoles must contain the user's role, and a room that is not
 342: -- public (JavaScript truthiness of isPublic) with no allowed users/roles
 343: -- denies a user without a company; a falsy access_control (null, false, 0,
 344: -- "") skips the access-control checks, as in TypeScript. Stricter than the
 345: -- TypeScript rule only for malformed data, which denies (ROOM_ACL_INVALID): an
 346: -- allowedUsers/allowedRoles that is neither an array nor null (TypeScript
 347: -- would treat a string by its characters), and an access_control or isPublic
 348: -- number outside the double range (JSON.parse would turn it into 0/Infinity).
 349: create or replace function private.room_access_denial(p_user public.users, p_space public.spaces)
 350: returns text
 351: language plpgsql
 352: stable
 353: set search_path = ''
 354: as $$
 355: declare
 356:   v_ac jsonb := p_space.access_control;
 357:   v_users jsonb;
 358:   v_roles jsonb;
 359:   v_truthy boolean;
 360:   v_public boolean;
 361: begin
 362:   if p_space.company_id is not null
 363:      and p_user.company_id is not null
 364:      and p_space.company_id <> p_user.company_id then
 365:     return 'COMPANY_MISMATCH';
 366:   end if;
 367: 
 368:   -- `if (accessControl)`: a falsy value (null, false, 0, "") skips every
 369:   -- access-control check.
 370:   v_truthy := private.jsonb_js_truthy(v_ac);
 371:   if v_truthy is null then
 372:     return 'ROOM_ACL_INVALID';
 373:   end if;
 374:   if not v_truthy then
 375:     return null;
 376:   end if;
 377:   if pg_catalog.jsonb_typeof(v_ac) <> 'object' then
 378:     -- A truthy JavaScript non-object (true, string, number, array) has no
 379:     -- such properties.
 380:     v_ac := '{}'::jsonb;
 381:   end if;
 382: 
 383:   v_users := v_ac -> 'allowedUsers';
 384:   v_roles := v_ac -> 'allowedRoles';
 385:   if v_users is null or pg_catalog.jsonb_typeof(v_users) = 'null' then
 386:     v_users := '[]'::jsonb;
 387:   end if;
 388:   if v_roles is null or pg_catalog.jsonb_typeof(v_roles) = 'null' then
 389:     v_roles := '[]'::jsonb;
 390:   end if;
 391:   if pg_catalog.jsonb_typeof(v_users) <> 'array' or pg_catalog.jsonb_typeof(v_roles) <> 'array' then
 392:     return 'ROOM_ACL_INVALID';
 393:   end if;
 394: 
 395:   if pg_catalog.jsonb_array_length(v_users) > 0 and not (v_users ? (p_user.id)::text) then
 396:     return 'NOT_ALLOWED_USER';
 397:   end if;
 398:   if pg_catalog.jsonb_array_length(v_roles) > 0
 399:      and p_user.role is not null
 400:      and not (v_roles ? (p_user.role)::text) then
 401:     return 'NOT_ALLOWED_ROLE';
 402:   end if;
 403: 
 404:   v_public := private.jsonb_js_truthy(v_ac -> 'isPublic');
 405:   if v_public is null then
 406:     return 'ROOM_ACL_INVALID';
 407:   end if;
 408:   if not v_public
 409:      and pg_catalog.jsonb_array_length(v_users) = 0
 410:      and pg_catalog.jsonb_array_length(v_roles) = 0
 411:      and p_user.company_id is null then
 412:     return 'PRIVATE_NO_COMPANY';
 413:   end if;
 414: 
 415:   return null;
 416: end;
 417: $$;
 418: 
 419: revoke all on function private.room_access_denial(public.users, public.spaces) from public, anon, authenticated, 
service_role;
