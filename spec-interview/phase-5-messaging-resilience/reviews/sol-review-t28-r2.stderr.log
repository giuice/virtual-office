 568: -- A removed membership (not an FK cascade of a deleted conversation or user,
 569: -- whose parent row is already gone) becomes a revocation.
 570: create or replace function private.record_conversation_member_revocation()
 571: returns trigger
 572: language plpgsql
 573: security definer
 574: set search_path = ''
 575: as $$
 576: begin
 577:   insert into private.conversation_member_revocations (conversation_id, user_id)
 578:   select old.conversation_id, old.user_id
 579:   where exists (select 1 from public.conversations c where c.id = old.conversation_id)
 580:     and exists (select 1 from public.users u where u.id = old.user_id)
 581:   on conflict (conversation_id, user_id) do update
 582:     set revoked_at = pg_catalog.now();
 583:   return old;
 584: end;
 585: $$;
