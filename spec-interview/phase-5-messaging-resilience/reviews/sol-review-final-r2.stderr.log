   2: // Phase 5 T11 (FR-011, FR-012, BR-001): who the browser is authenticated as,
   3: // compared with the owner of an outbox.
   4: //
   5: // The outbox belongs to an application user (users.id). Its owner's auth
   6: // identity is that user's `users.supabase_uid`, and the browser's current one
   7: // is the auth user of the session the Supabase browser client reads from its
   8: // storage (the auth cookies every tab of the browser shares) — so a sign-out
   9: // or a sign-in as another account in any tab, or cookies cleared or replaced
  10: // by the server, is seen by every tab on its next check, with or without an
  11: // auth event. The server still checks every request's sender (the route
  12: // compares the expected sender with users.id resolved from auth.getUser()).
  13: import { isAuthRetryableFetchError } from '@supabase/supabase-js';
  14: 
  15: import { supabase } from '@/lib/supabase/client';
  16: 
  17: /**
  18:  * - `owner`: the browser holds a session of the outbox's owner;
  19:  * - `other`: it holds another user's session (an account switch);
  20:  * - `ended`: it holds no session (signed out, cookies cleared, or the
  21:  *   refresh was rejected and the session removed);
  22:  * - `unverified`: the session could not be read (its refresh failed in
  23:  *   transit): nothing is concluded, the check is repeated later.
  24:  */
  25: export type OutboxIdentityState = 'owner' | 'other' | 'ended' | 'unverified';
  26: 
  27: export interface OutboxIdentity {
  28:   /** The browser's authenticated user compared with the owner, read now. */
  29:   check(): Promise<OutboxIdentityState>;
  30:   /** Calls `listener` (asynchronously) after every auth state change this tab's auth client reports. */
  31:   onChange(listener: () => void): () => void;
  32: }
  33: 
  34: /** `ownerAuthUid`: the owner's `users.supabase_uid` (never users.id). */
  35: export function createOutboxIdentity(ownerAuthUid: string): OutboxIdentity {
  36:   return {
  37:     async check() {
  38:       try {
  39:         const { data, error } = await supabase.auth.getSession();
  40:         const session = data.session;
  41:         if (session) return session.user.id === ownerAuthUid ? 'owner' : 'other';
  42:         return error && isAuthRetryableFetchError(error) ? 'unverified' : 'ended';
  43:       } catch {
  44:         return 'unverified';
  45:       }
  46:     },
  47:     onChange(listener) {
  48:       // The auth client may still hold its lock while notifying: read the
  49:       // session only after the callback returned.
  50:       const { data } = supabase.auth.onAuthStateChange(() => {
  51:         setTimeout(listener, 0);
  52:       });
  53:       return () => data.subscription.unsubscribe();
  54:     },
  55:   };
