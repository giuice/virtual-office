 204:   test('AC-026: a hidden tab that receives a room mention first stays silent while B\'s other tab views the 
room; with both tabs hidden exactly one tab announces it', async ({
 205:     phase5World,
 206:     openDevice,
 207:   }) => {
 208:     const { roomId } = phase5World.conversations;
 209:     const { B } = phase5World.users;
 210:     const b = await openDevice('B');
 211:     const a = await openDevice('A');
 212:     await prepareBrowser(b);
 213:     const raceText = `@${B.displayName} t18 race ${randomUUID()}`;
 214: 
 215:     // Tab V: the Realtime frames of the message being raced are held until released.
 216:     const viewer = b.page;
 217:     const heldFrames: string[] = [];
 218:     let heldText = raceText;
 219:     let deliverToViewer: (frame: string) => void = () => undefined;
 220:     await viewer.routeWebSocket(/\/realtime\/v1\/websocket/, (socket) => {
 221:       const server = socket.connectToServer();
 222:       deliverToViewer = (frame) => socket.send(frame);
 223:       server.onMessage((frame) => {
 224:         if (typeof frame === 'string' && frame.includes(heldText)) {
 225:           heldFrames.push(frame);
 226:           return;
 227:         }
 228:         socket.send(frame);
 229:       });
 230:     });
 231:     await loadApp(viewer);
 232:     await enableNotifications(viewer);
 233:     await openConversation(viewer, roomId);
 234: 
 235:     // Tab H: hidden from its first script on.
 236:     const hidden = await b.newTab();
 237:     await hidden.addInitScript(startHidden);
 238:     await loadApp(hidden);
 239:     expect(await hidden.evaluate(() => document.visibilityState)).toBe('hidden');
 240:     await expect(notificationsToggle(hidden)).toHaveAccessibleName('Notificações ativadas');
 241:     const hiddenReads = countAuthorizationReads(hidden);
 242:     const total = async () => [...(await notificationsOf(viewer)), ...(await notificationsOf(hidden))];
 243: 
 244:     // ---- H receives the mention first and finishes its decision; then V gets it.
 245:     const raceMessage = await send(a.page, roomId, raceText, [B.userId]);
 246:     await expect.poll(() => heldFrames.length, { timeout: NOTIFICATION_RECV_TIMEOUT_MS }).toBeGreaterThan(0);
 247:     await expect
 248:       .poll(() => hiddenReads.finished, { timeout: NOTIFICATION_RECV_TIMEOUT_MS, message: 'H authorized the 
mention first' })
 249:       .toBe(1);
 250:     await hidden.waitForTimeout(NOTIFICATION_QUIET_WINDOW_MS);
 251:     expect(await total(), 'no tab announces a conversation another visible tab of B views').toEqual([]);
 252:     heldFrames.splice(0).forEach((frame) => deliverToViewer(frame));
 253:     await expect(feedMessage(viewer, raceMessage)).toBeVisible({ timeout: STEP_TIMEOUT_MS });
 254:     await viewer.waitForTimeout(NOTIFICATION_QUIET_WINDOW_MS);
 255:     expect(await total(), 'still none after V received it').toEqual([]);
 256: 
 257:     // ---- Both tabs hidden: exactly one notification in the browser. Block C
 258:     // fix F4: H receives the mention first and its authorization read fails
 259:     // in transit; V (its copy held until then) authorizes and announces it.
 260:     await setTabHidden(viewer, true);
 261:     const bothHiddenText = `@${B.displayName} t18 both hidden ${randomUUID()}`;
 262:     heldText = bothHiddenText;
 263:     let hiddenFailedReads = 0;
 264:     await hidden.route(isAuthorizationRead, async (route: Route) => {
 265:       hiddenFailedReads += 1;
 266:       await route.abort('failed');
 267:     });
 268:     await send(a.page, roomId, bothHiddenText, [B.userId]);
 269:     await expect.poll(() => heldFrames.length, { timeout: NOTIFICATION_RECV_TIMEOUT_MS }).toBeGreaterThan(0);
 270:     await expect
 271:       .poll(() => hiddenFailedReads, { timeout: NOTIFICATION_RECV_TIMEOUT_MS, message: "H's authorization read 
failed" })
 272:       .toBe(1);
 273:     await hidden.waitForTimeout(1_000);
 274:     expect(await total(), 'nothing announced while V has not received it').toEqual([]);
 275:     heldFrames.splice(0).forEach((frame) => deliverToViewer(frame));
 276:     await expect.poll(async () => (await total()).length, { timeout: NOTIFICATION_RECV_TIMEOUT_MS }).toBe(1);
 277:     await viewer.waitForTimeout(NOTIFICATION_QUIET_WINDOW_MS);
 278:     const expected = {
 279:       title: `${phase5World.users.A.displayName} mencionou você em ${await conversationName(roomId)}`,
 280:       body: bothHiddenText,
 281:       tag: notificationTagOf(roomId),
 282:     };
 283:     expect(await total(), 'one notification across both hidden tabs').toEqual([expected]);
 284:     expect(await notificationsOf(viewer), 'announced by V, whose read succeeded').toEqual([expected]);
 285:     expect(hiddenFailedReads, 'H read once').toBe(1);
 286:   });
