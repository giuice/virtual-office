  24:  * Phase 5 T18 — @mention desktop notifications (FR-025, BR-011; AC-025,
  25:  * AC-026, AC-049 and the notification clause of AC-046).
  26:  *
  27:  * Real accounts, the real app, local Supabase and its Realtime. Notifications
  28:  * are observed as in the Phase 4 spec (helpers/desktop-notification-recorder:
  29:  * the page's Notification constructor recorded, the browser's real
  30:  * permission granted). A sends through the real create route with the
  31:  * composer's contract (clientMessageId + mentionIds). Tabs are hidden by the
  32:  * visibility emulation the Phase 4 specs use (setTabHidden / startHidden).
  33:  * Faults are network shaping only: one tab's Realtime frames for one message
  34:  * held and released, the authorization read (GET /api/messages/get
  35:  * ?source=notification) held before or after the server answered or failed
  36:  * in transit, the list/roster reads a removal causes held, and the
  37:  * browser's auth cookies replaced by C's real ones (a sign-in completed by a
  38:  * server response in another tab, as in T11) — no auth event in this tab.
  39:  */
  40: 
  41: const isAuthorizationRead = (url: URL) =>
  42:   url.pathname === '/api/messages/get' && url.searchParams.get('source') === 'notification';
  43: 
  44: const feedMessage = (page: Page, messageId: string) => page.getByTestId(`message-${messageId}`);
  45: const listItem = (page: Page, conversationId: string) => page.getByTestId(`conversation-item-${conversationId}`);
  46: 
  47: const AUTH_COOKIE = /^sb-.+-auth-token(\.\d+)?$/;
  48: 
  49: function deferred(): { promise: Promise<void>; resolve: () => void } {
  50:   let resolve: () => void = () => undefined;
  51:   const promise = new Promise<void>((done) => {
  52:     resolve = done;
  53:   });
  54:   return { promise, resolve };
  55: }
  56: 
  57: async function conversationName(conversationId: string): Promise<string> {
  58:   return withLocalMessagingDb(async (db) => {
  59:     const { rows } = await db.query<{ name: string | null }>('select name from public.conversations where id = 
$1', [
  60:       conversationId,
  61:     ]);
  62:     const name = rows[0]?.name?.trim();
  63:     expect(name, `name of conversation ${conversationId}`).toBeTruthy();
  64:     return name as string;
  65:   });
  66: }
  67: 
  68: async function storedMentions(messageId: string): Promise<string[]> {
  69:   return withLocalMessagingDb(async (db) => {
  70:     const { rows } = await db.query<{ user_id: string }>(
  71:       'select mentioned_user_id::text as user_id from public.message_mentions where message_id = $1 order by 1',
  72:       [messageId],
  73:     );
  74:     return rows.map((row) => row.user_id);
  75:   });
  76: }
  77: 
  78: /** A sends through the real create route with the composer's keyed contract. */
  79: async function send(
  80:   page: Page,
  81:   conversationId: string,
  82:   content: string,
  83:   mentionIds: string[] = [],
  84:   extra: Record<string, unknown> = {},
  85: ): Promise<string> {
  86:   return createViaApi(page, { conversationId, content, clientMessageId: randomUUID(), mentionIds, ...extra });
  87: }
  88: 
  89: /** Loads the app in the tab (Realtime list and messages streams up) with the drawer open. */
  90: async function loadApp(page: Page): Promise<void> {
  91:   const streamConfirmed = watchMessagingChangesStream(page);
  92:   await page.goto('/floor-plan');
  93:   await waitForRealtimeReady(page);
  94:   await streamConfirmed();
  95:   await openDrawer(page);
  96: }
  97: 
  98: /** B's browser records notifications and has the permission (before its tabs load). */
  99: async function prepareBrowser(device: Phase5Device): Promise<void> {
 100:   await grantNotifications(device.context, new URL(device.page.url()).origin);
 101:   await device.context.addInitScript(installNotificationRecorder);
 102: }
 103: 
 104: /** Turns notifications on in the drawer (shared by the browser's tabs). */
 105: async function enableNotifications(page: Page): Promise<void> {
 106:   const toggle = notificationsToggle(page);
 107:   await toggle.click();
 108:   await expect(toggle).toHaveAccessibleName('Notificações ativadas');
 109: }
 110: 
 111: /** Counts the tab's authorization reads that got an answer. */
 112: function countAuthorizationReads(page: Page): { finished: number } {
 113:   const reads = { finished: 0 };
 114:   page.on('requestfinished', (request) => {
 115:     if (isAuthorizationRead(new URL(request.url()))) reads.finished += 1;
 116:   });
 117:   return reads;
 118: }
