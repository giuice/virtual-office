 288:   test('AC-049/AC-046: a held authorization is dropped when B\'s removal arrives or the browser switches account 
before display, and refused when the removal precedes it; an unchanged replay after B left announces nothing to B', 
async ({
 289:     phase5World,
 290:     openDevice,
 291:     membership,
 292:   }) => {
 293:     const { roomId, groupId, directId } = phase5World.conversations;
 294:     const { B, C } = phase5World.users;
 295:     const c = await openDevice('C');
 296:     const cCookies: Cookie[] = (await c.context.cookies()).filter((cookie) => AUTH_COOKIE.test(cookie.name));
 297:     expect(cCookies.length, "C's real session cookies").toBeGreaterThan(0);
 298:     const b = await openDevice('B');
 299:     const a = await openDevice('A');
 300:     await prepareBrowser(b);
 301:     const membershipDeletes = watchMembershipDeletes(b.page);
 302:     await loadApp(b.page);
 303:     await enableNotifications(b.page);
 304:     await setTabHidden(b.page, true);
 305:     for (const id of [roomId, groupId]) await expect(listItem(b.page, id)).toBeVisible({ timeout: 
STEP_TIMEOUT_MS });
 306: 
 307:     // Block C fix F1: B's list and roster reads, held (before the server) while `holdRefetches`.
 308:     let holdRefetches = false;
 309:     let refetchGate = deferred();
 310:     const heldRefetches: number[] = [];
 311:     await b.page.route(
 312:       (url) => url.pathname === '/api/conversations/get' || url.pathname === '/api/conversations/members',
 313:       async (route: Route) => {
 314:         if (holdRefetches) {
 315:           heldRefetches.push(Date.now());
 316:           await refetchGate.promise;
 317:         }
 318:         await route.continue().catch(() => undefined);
 319:       },
 320:     );
 321: 
 322:     // B's authorization reads: answered at once, or held before/after the server answered.
 323:     type Mode = 'pass' | 'hold-before-server' | 'hold-after-server';
 324:     let mode: Mode = 'pass';
 325:     let gate = deferred();
 326:     const reads: Array<{ mode: Mode; status: number | null }> = [];
 327:     await b.page.route(isAuthorizationRead, async (route: Route) => {
 328:       const read = { mode, status: null as number | null };
 329:       reads.push(read);
 330:       const held = gate.promise;
 331:       if (read.mode === 'hold-before-server') await held;
 332:       const response = await route.fetch();
 333:       read.status = response.status();
 334:       if (read.mode === 'hold-after-server') await held;
 335:       await route.fulfill({ response }).catch(() => undefined);
 336:     });
 337:     const holdRead = async (next: Mode, send: () => Promise<string>): Promise<{ messageId: string; read: { 
status: number | null } }> => {
 338:       mode = next;
 339:       gate = deferred();
 340:       const before = reads.length;
 341:       const messageId = await send();
 342:       await expect.poll(() => reads.length, { timeout: NOTIFICATION_RECV_TIMEOUT_MS }).toBe(before + 1);
 343:       const read = reads[before];
 344:       if (next === 'hold-after-server') {
 345:         await expect.poll(() => read.status, { timeout: STEP_TIMEOUT_MS, message: 'the server said "member"' 
}).toBe(200);
 346:       }
 347:       return { messageId, read };
 348:     };
 349:     const mention = (conversationId: string, label: string) => () =>
 350:       send(a.page, conversationId, `@${B.displayName} t18 ${label} ${randomUUID()}`, [B.userId]);
 351: 
 352:     // ---- Control: held after the server answered and released unchanged → shown.
 353:     await holdRead('hold-after-server', mention(roomId, 'held control'));
 354:     await b.page.waitForTimeout(1_000);
 355:     expect(await notificationsOf(b.page), 'nothing shown while held').toEqual([]);
 356:     gate.resolve();
 357:     await expectNotificationCount(b.page, 1);
 358: 
 359:     // ---- Held before the check runs, B removed from the group → the check refuses (403).
 360:     const beforeCheck = await holdRead('hold-before-server', mention(groupId, 'removed before check'));
 361:     expect(await membership.remove(groupId, 'B')).toBe(1);
 362:     await expect(listItem(b.page, groupId), "B's app received the removal").toHaveCount(0, { timeout: 
STEP_TIMEOUT_MS });
 363:     gate.resolve();
 364:     await expect.poll(() => beforeCheck.read.status, { timeout: STEP_TIMEOUT_MS }).toBe(403);
 365:     await expectNoNewNotification(b.page, 1, 'a check run after the removal refuses it');
 366: 
 367:     // ---- AC-046: a keyed room message mentioning B and C (B is notified while a member).
 368:     mode = 'pass';
 369:     const replayBody = {
 370:       conversationId: roomId,
 371:       content: `@${B.displayName} @${C.displayName} t18 replay ${randomUUID()}`,
 372:       clientMessageId: randomUUID(),
 373:       mentionIds: [B.userId, C.userId].sort(),
 374:     };
 375:     const first = await a.page.request.post('/api/messages/create', { data: replayBody });
 376:     expect(first.status()).toBe(201);
 377:     const replayed = ((await first.json()) as { message: { id: string } }).message.id;
 378:     await expectNotificationCount(b.page, 2);
 379: 
 380:     // ---- The check returned "member", display held; B's removal from the room
 381:     // arrives and the authorization is released before the list/roster
 382:     // refetches it causes have landed (held) → dropped (block C fix F1).
 383:     await holdRead('hold-after-server', mention(roomId, 'removed after check'));
 384:     holdRefetches = true;
 385:     refetchGate = deferred();
 386:     const deletesBefore = membershipDeletes.length;
 387:     expect(await membership.remove(roomId, 'B')).toBe(1);
 388:     await expect
 389:       .poll(() => membershipDeletes.length, { timeout: STEP_TIMEOUT_MS, message: "B's tab received the 
membership DELETE" })
 390:       .toBeGreaterThan(deletesBefore);
 391:     const deleteReceivedAt = membershipDeletes[deletesBefore];
 392:     await expect
 393:       .poll(() => heldRefetches.filter((at) => at >= deleteReceivedAt).length, {
 394:         timeout: STEP_TIMEOUT_MS,
 395:         message: 'the list refetch the removal caused is held',
 396:       })
 397:       .toBeGreaterThan(0);
 398:     await expect(listItem(b.page, roomId), 'the cached list still shows the room').toHaveCount(1);
 399:     gate.resolve();
 400:     await expectNoNewNotification(b.page, 2, 'a removal received before display drops the notification');
 401:     await expect(listItem(b.page, roomId), 'refetch still held during the decision').toHaveCount(1);
 402:     holdRefetches = false;
 403:     refetchGate.resolve();
 404:     await expect(listItem(b.page, roomId), "B's app shows the removal").toHaveCount(0, { timeout: 
STEP_TIMEOUT_MS });
 405: 
 406:     // ---- AC-046: A's unchanged replay after B left returns the stored message and announces nothing to B.
 407:     const replay = await a.page.request.post('/api/messages/create', { data: replayBody });
 408:     expect(replay.status(), await replay.text()).toBe(200);
 409:     expect(((await replay.json()) as { message: { id: string } }).message.id).toBe(replayed);
 410:     expect(await storedMentions(replayed)).toEqual([B.userId, C.userId].sort());
 411:     await expectNoNewNotification(b.page, 2, 'the replay announces nothing to the removed recipient');
 412: 
 413:     // ---- Final review #1: the read said "member", the claim waits on the
 414:     // browser-wide notification lock. Control: released with B's session → shown once.
 415:     const bCookies: Cookie[] = (await b.context.cookies()).filter((cookie) => AUTH_COOKIE.test(cookie.name));
 416:     mode = 'pass';
 417:     let releaseClaimLock = await holdNotificationClaimLock(b.page);
 418:     let readsBefore = reads.length;
 419:     await mention(directId, 'claim wait control')();
 420:     await expect.poll(() => reads.length, { timeout: NOTIFICATION_RECV_TIMEOUT_MS }).toBe(readsBefore + 1);
 421:     await expect.poll(() => pendingNotificationClaims(b.page), { timeout: STEP_TIMEOUT_MS, message: "B's claim 
waits on the lock" }).toBe(1);
 422:     expect(await notificationsOf(b.page), 'nothing shown while the claim waits').toHaveLength(2);
 423:     await releaseClaimLock();
 424:     await expectNotificationCount(b.page, 3);
 425: 
 426:     // ---- Same wait, the browser switches to C's session meanwhile → dropped.
 427:     releaseClaimLock = await holdNotificationClaimLock(b.page);
 428:     readsBefore = reads.length;
 429:     await mention(directId, 'claim wait account switch')();
 430:     await expect.poll(() => reads.length, { timeout: NOTIFICATION_RECV_TIMEOUT_MS }).toBe(readsBefore + 1);
 431:     await expect.poll(() => pendingNotificationClaims(b.page), { timeout: STEP_TIMEOUT_MS, message: "B's claim 
waits on the lock" }).toBe(1);
 432:     await b.page.route('**/api/presence/**', () => undefined);
 433:     await switchAuthCookies(b.context, cCookies);
 434:     await releaseClaimLock();
 435:     await expectNoNewNotification(b.page, 3, 'an account switch while the claim waits drops the notification');
 436:     await switchAuthCookies(b.context, bCookies);
 437:     await b.page.unroute('**/api/presence/**');
 438: 
 439:     // ---- The check returned "member" for B, display held; the browser now holds C's session → dropped.
 440:     await holdRead('hold-after-server', mention(directId, 'account switch'));
 441:     // The stale tab's presence heartbeats are held (they would run under C's cookies).
 442:     await b.page.route('**/api/presence/**', () => undefined);
 443:     await switchAuthCookies(b.context, cCookies);
 444:     gate.resolve();
 445:     await expectNoNewNotification(b.page, 3, 'an account switch before display drops the notification');
 446:     expect(reads.map((read) => [read.mode, read.status])).toEqual([
 447:       ['hold-after-server', 200],
 448:       ['hold-before-server', 403],
 449:       ['pass', 200],
 450:       ['hold-after-server', 200],
 451:       ['pass', 200],
 452:       ['pass', 200],
 453:       ['hold-after-server', 200],
 454:     ]);
 455:   });
 456: });
