174:export function listOutboxItems(ownerId: string, conversationId?: string): Promise<OutboxItem[]> {
175:  return inTransaction<OutboxItem[]>('readonly', ({ items }, done) => {
176:    const request = conversationId
177:      ? items
178:          .index(BY_CONVERSATION_ORDER)
179:          .getAll(IDBKeyRange.bound([ownerId, conversationId, -Infinity], [ownerId, conversationId, Infinity]))
180:      : items.index(BY_OWNER_ORDER).getAll(IDBKeyRange.bound([ownerId, -Infinity], [ownerId, Infinity]));
181:    request.onsuccess = () => done(request.result as OutboxItem[]);
182:  });
183:}
