158:/** Adds a new item, giving it the owner's next creation order. Resolves once committed. */
159:export function addOutboxItem(item: Omit<OutboxItem, 'order'>): Promise<OutboxItem> {
160:  return inTransaction<OutboxItem>('readwrite', ({ items, meta }, done) => {
161:    const metaRequest = meta.get(item.ownerId);
162:    metaRequest.onsuccess = () => {
163:      const current = metaRequest.result as OwnerMeta | undefined;
164:      const order = current?.nextOrder ?? 1;
165:      const stored: OutboxItem = { ...item, order };
166:      meta.put({ ownerId: item.ownerId, nextOrder: order + 1 } satisfies OwnerMeta);
167:      items.add(stored);
168:      done(stored);
169:    };
170:  });
171:}
