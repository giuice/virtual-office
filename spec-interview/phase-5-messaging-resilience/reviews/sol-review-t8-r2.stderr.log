 */
export interface ConversationMember {
  userId: string; // users.id
  displayName: string | null;
  avatarUrl: string | null;
}

    () => starredQuery.data?.pages.flatMap((page) => page.messages) ?? [],
    [starredQuery.data]
  );
  const isStarredRendered = showStarred && !starredQuery.isPending && !starredQuery.isError;

  // Skeleton only for the first load; refetches and older pages keep the feed.
  const showSkeleton = isLoading || loadingMessages;
  // The feed's viewport is unmounted while the starred view is shown, so
  // returning to the feed starts at the newest message again.
  const isFeedRendered = !showSkeleton && !errorMessages && !!activeConversation && !showStarred;
  const { viewportRef, markOwnSend, scrollMessageIntoView, captureBeforeCommit } = useFeedScrollAnchor({
    conversationId: activeConversationId,
    messages,
    isFeedRendered,
  });

  // The scrolling element (feed or starred view; only one is mounted) is also
  // the visibility root for read receipts.
  const [viewportElement, setViewportElement] = useState<HTMLDivElement | null>(null);
  const attachReceiptViewport = useCallback((node: HTMLDivElement | null) => {
    setViewportElement(node);
    return () => {
      setViewportElement((current) => (current === node ? null : current));
    };
  }, []);
  const attachViewport = useCallback(
    (node: HTMLDivElement | null) => {
      const detachReceipts = attachReceiptViewport(node);
      const detachAnchor = viewportRef(node);
      return () => {
        detachAnchor?.();
        detachReceipts();
      };
    },
    [attachReceiptViewport, viewportRef]
  );

  // Only messages actually seen in the drawer's conversation view count as
  // read (BR-001). Starred results are messages of this conversation shown in
  // the same drawer view, so seeing one counts too; the per-conversation
  // "already reported" set is shared, so nothing is reported twice.
  useVisibleMessageReceipts({
    conversationId: activeConversationId,
    viewport: viewportElement,
    enabled:
      (showStarred ? isStarredRendered : isFeedRendered) &&
      isDrawerOpen &&
      !isMinimized &&
      activeView === 'conversation',
    messages: showStarred ? starredMessages : messages,
    currentUserId: currentUserProfile?.id ?? null,
    isDirectConversation: activeConversation?.type === ConversationType.DIRECT,
    submit: markMessagesAsRead,
  });

  const messageMap = useMemo(() => {
    const map = new Map<string, Message>();
    messages.forEach((message) => {
      map.set(message.id, message);
    });
    return map;
  }, [messages]);

  const repliesByParent = useMemo(() => {
    const grouped = new Map<string, Message[]>();
    messages.forEach((message) => {
      if (message.replyToId) {
        const list = grouped.get(message.replyToId) ?? [];
        list.push(message);
        grouped.set(message.replyToId, list);
      }
    });

    grouped.forEach((list) => {
      list.sort((a, b) => a.timestamp.getTime() - b.timestamp.getTime());
    });

    return grouped;
  }, [messages]);

  const topLevelMessages = useMemo(() => {
    return messages.filter((message) => {
      if (!message.replyToId) {
        return true;
      }
      // If parent message is not currently loaded, treat as top-level so it remains visible
      return !messageMap.has(message.replyToId);
    });
  }, [messages, messageMap]);

  // A reply renders only inside its expanded parent thread(s).
  const revealMessage = useCallback((messageId: string) => {
    const ancestors: Record<string, boolean> = {};
    let parentId = messageMap.get(messageId)?.replyToId;
    while (parentId && messageMap.has(parentId) && !ancestors[parentId]) {
      ancestors[parentId] = true;
      parentId = messageMap.get(parentId)?.replyToId;
    }
    setExpandedThreads((prev) => ({ ...prev, ...ancestors }));
  }, [messageMap]);

/** Sends `texts` offline from A's composer; each one is stored as a waiting item and shown as "pendente". */
async function queueOffline(a: Phase5Device, conversationId: string, texts: readonly string[]): Promise<OutboxRow[]> {
  for (const [index, text] of texts.entries()) {
    await sendFromComposer(a.page, text);
    await expect(composerInput(a.page)).toHaveValue('');
    await expect.poll(async () => (await readOutbox(a.page)).length).toBe(index + 1);
  }
  const items = await readOutbox(a.page);
  expect(items.map((item) => item.content)).toEqual(texts);
  for (const item of items) {
    expect(item).toMatchObject({
      ownerId: a.user.userId,
      conversationId,
      state: 'waiting',
      attemptGeneration: 0,
      failureReason: null,
      mentionIds: [],
      schemaVersion: 1,
    });
    expect(item.clientMessageId).toMatch(/^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/);
    expect(item.windowStartedAt).toBe(item.pressedSendAt);
    await expectPendingLabel(a.page, item.clientMessageId, 'pending', 'pendente');
  }
  for (let index = 1; index < items.length; index += 1) {
    expect(items[index].order).toBeGreaterThan(items[index - 1].order);
    expect(items[index].pressedSendAt).toBeGreaterThanOrEqual(items[index - 1].pressedSendAt);
  }
  return items;
}

test.describe('Phase 5 T8 — durable outbox', () => {
  test.beforeEach(async ({ budgets }) => {
    await budgets.reset();
  });

  test('AC-001/AC-002: offline sends are queued, then delivered in order, once each, within 10 s', async ({
    phase5World,
    openDevice,
  }) => {
    const { directId } = phase5World.conversations;
    const a = await openDevice('A');
    const b = await openDevice('B');

    // A reply target with one earlier reply, so its thread can be expanded.
    const parentText = `t8 parent ${randomUUID()}`;
    const parentId = await createViaApi(a.page, { conversationId: directId, content: parentText });
    await createViaApi(a.page, { conversationId: directId, content: `t8 earlier reply ${randomUUID()}`, replyToId: 
parentId });

    await openConversation(b.page, directId);
    await waitForRealtimeReady(b.page);
    await b.page.getByTestId(`reply-count-${parentId}`).click();
    await openConversation(a.page, directId);
    await a.page.getByTestId(`reply-count-${parentId}`).click();
    const creates = trackCreates(a.page);

    const texts = [`t8 offline one ${randomUUID()}`, `t8 offline reply ${randomUUID()}`, `t8 offline three 
${randomUUID()}`];
    await watchArrivals(b.page, texts);

    await goOffline(a.page);
    await sendFromComposer(a.page, texts[0]);
    await a.page.getByTestId(`reply-button-${parentId}`).click();
    await expect(composer(a.page).getByTestId('reply-composer-preview')).toContainText(parentText);
    await sendFromComposer(a.page, texts[1]);
    await expect(composer(a.page).getByTestId('reply-composer-preview')).toBeHidden();
    await sendFromComposer(a.page, texts[2]);

    // AC-001: pending with a text label, composer empty, in the outbox, nothing sent.
    await expect.poll(async () => (await readOutbox(a.page)).length).toBe(3);
    const queued = await readOutbox(a.page);
    expect(queued.map((item) => item.content)).toEqual(texts);
    expect(queued.map((item) => item.replyToId)).toEqual([null, parentId, null]);
    for (const item of queued) {
      expect(item).toMatchObject({ ownerId: a.user.userId, conversationId: directId, state: 'waiting', 
attemptGeneration: 0 });
      await expectPendingLabel(a.page, item.clientMessageId, 'pending', 'pendente');
    }
    expect(queued[1].order).toBeGreaterThan(queued[0].order);
    expect(queued[2].order).toBeGreaterThan(queued[1].order);
    await expect(composerInput(a.page)).toHaveValue('');
    // B does not see them; nothing reached the server.
    await a.page.waitForTimeout(1_500);
    expect(creates, 'no create request while offline').toHaveLength(0);
    expect(await storedWithTexts(directId, texts)).toHaveLength(0);
    expect(Object.values((await readArrivals(b.page)).max).every((count) => count === 0)).toBe(true);

    // AC-002: connectivity returns; no click.
    const reconnectedAt = Date.now();
    await a.context.setOffline(false);
    await expect
      .poll(async () => Object.keys((await readArrivals(b.page)).first).length, { timeout: D1_DEADLINE_MS })
      .toBe(3);
    const arrivals = await readArrivals(b.page);
    const lastArrival = Math.max(...texts.map((text) => arrivals.first[text]));
    expect(lastArrival - reconnectedAt, 'B saw all three within 10 s of 
reconnecting').toBeLessThanOrEqual(D1_DEADLINE_MS);
    expect([...texts].sort((x, y) => arrivals.first[x] - arrivals.first[y]), 'B saw them in send 
order').toEqual(texts);

    const stored = await storedWithTexts(directId, texts);
    expect(stored.map((row) => row.content), 'one stored row per text, in send order').toEqual(texts);
    expect(stored.map((row) => row.key)).toEqual(queued.map((item) => item.clientMessageId));
    expect(stored.map((row) => row.reply_to_id)).toEqual([null, parentId, null]);
    expect(stored.every((row) => row.sender_id === a.user.userId)).toBe(true);

    await expectDeliveredInFeed(a.page, stored);
    await expect.poll(async () => (await readOutbox(a.page)).length).toBe(0);
    const sent = creates;
    expect(sent.filter((attempt) => attempt.failure !== undefined), 'no failed create').toHaveLength(0);
    expect(sent.map((attempt) => attempt.body.clientMessageId)).toEqual(queued.map((item) => item.clientMessageId));
    for (const attempt of sent) {
      expect(attempt.body).toMatchObject({ attemptGeneration: 1, expectedSenderId: a.user.userId });
      expect(attempt.body).not.toHaveProperty('mentionIds');
    }
    expectNoOverlap(sent);

    // Once each, throughout.
    await b.page.waitForTimeout(1_500);
    const settled = await readArrivals(b.page);
    for (const text of texts) expect(settled.max[text], `B never showed "${text}" twice`).toBe(1);
  });

  test('D1: ten messages queued offline are delivered in order, once each, within 10 s, one create at a time', async ({
    phase5World,
    openDevice,
