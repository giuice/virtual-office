185:/**
186: * Reads the item and replaces it with `change(item)` in one transaction
187: * (`null` deletes it; `undefined` leaves it). Resolves with the stored result
188: * (`null` when the item is missing or was deleted).
189: */
190:export function updateOutboxItem(
191:  ownerId: string,
192:  clientMessageId: string,
193:  change: (item: OutboxItem) => OutboxItem | null | undefined
194:): Promise<OutboxItem | null> {
195:  return inTransaction<OutboxItem | null>('readwrite', ({ items }, done) => {
196:    const request = items.get([ownerId, clientMessageId]);
197:    request.onsuccess = () => {
198:      const item = request.result as OutboxItem | undefined;
199:      if (!item) {
200:        done(null);
201:        return;
202:      }
203:      const next = change(item);
204:      if (next === undefined) {
205:        done(item);
206:      } else if (next === null) {
207:        items.delete([ownerId, clientMessageId]);
208:        done(null);
209:      } else {
210:        items.put(next);
211:        done(next);
212:      }
213:    };
214:  });
215:}
216:
217:export function deleteOutboxItem(ownerId: string, clientMessageId: string): Promise<void> {
218:  return inTransaction<void>('readwrite', ({ items }, done) => {
219:    items.delete([ownerId, clientMessageId]);
220:    done(undefined);
221:  });
222:}
