import { randomUUID } from 'node:crypto';

import type { Page, Request, Route } from '@playwright/test';

import { test, expect, type Phase5Device } from '../fixtures/messaging-phase5';
import { openDrawer, waitForRealtimeReady } from '../helpers/drawer-helpers';
import { MESSAGING_OUTBOX_DB_NAME } from '../helpers/messaging-browser-state';
import { withLocalMessagingDb } from '../helpers/messaging-local-db';

/**
 * Phase 5 T8 — durable outbox with ordered automatic delivery (FR-001,
 * FR-002, FR-003, FR-010, FR-033, BR-002, BR-003; AC-001, AC-002, AC-004,
 * AC-011, AC-039; D1, D2, D5).
 *
 * Everything is real: the app, its IndexedDB outbox, the create route and the
 * local database. Offline is the browser context's network emulation
 * (`context.setOffline`: navigator.onLine false, every request fails); held
 * creates are delayed pass-through to the real server (route.fetch). The
 * outbox is read from the page's own IndexedDB (inspection only). Storage
 * failures (AC-039) are browser conditions installed before the app loads:
 * `indexedDB.open` throwing SecurityError (storage blocked for the site), and
 * outbox write transactions that fail to commit (as on QuotaExceededError).
 * Chromium's CDP quota override does not affect IndexedDB in Playwright's
 * off-the-record contexts (probed in Chrome and Edge), so the write failure is
 * produced in the page instead.
 *
 * Exactly once is checked three ways: one stored row per text (any key) in
 * the database, at most one bubble per text in B's feed at any moment
 * (MutationObserver), and one stored bubble (no pending copy) in A's feed.
 */

/** D1: with ≤ 10 pending and quota available, all delivered within 10 s of reconnecting. */
const D1_DEADLINE_MS = 10_000;
const STEP_TIMEOUT_MS = 20_000;
const D5_TEXT = 'Este navegador não permite guardar mensagens; libere o armazenamento do site';

interface OutboxRow {
  ownerId: string;
  clientMessageId: string;
  conversationId: string;
  content: string;
  replyToId: string | null;
  mentionIds: string[];
  pressedSendAt: number;
  windowStartedAt: number;
  order: number;
  state: string;
  failureReason: string | null;
  attemptGeneration: number;
  claimHolder: string | null;
  leaseExpiresAt: number | null;
  schemaVersion: number;
}

/** The page's outbox items, in creation order (read-only; never creates the database). */
async function readOutbox(page: Page): Promise<OutboxRow[]> {
  const rows = await page.evaluate(async (name: string) => {
    const databases = typeof indexedDB.databases === 'function' ? await indexedDB.databases() : [];
    if (!databases.some((database) => database.name === name)) return [];
    return new Promise<unknown[]>((resolve, reject) => {
      const request = indexedDB.open(name);
      request.onerror = () => reject(request.error);
      request.onsuccess = () => {
        const db = request.result;
        if (!db.objectStoreNames.contains('items')) {
          db.close();
          resolve([]);
          return;
        }
        const read = db.transaction('items', 'readonly').objectStore('items').getAll();
        read.onsuccess = () => {
          db.close();
          resolve(read.result);
        };
        read.onerror = () => {
          db.close();
          reject(read.error);
        };
      };
    });
  }, MESSAGING_OUTBOX_DB_NAME);
  return (rows as OutboxRow[]).sort((a, b) => a.order - b.order);
}

interface CreateAttempt {
  body: Record<string, unknown>;
  startSeq: number;
  endSeq?: number;
  startedAt: number;
  endedAt?: number;
  status?: number;
  failure?: string;
}

/** Every create request of the page, with the order in which requests started and ended. */
function trackCreates(page: Page): CreateAttempt[] {
  const attempts: CreateAttempt[] = [];
  const byRequest = new Map<Request, CreateAttempt>();
  let seq = 0;
  const isCreate = (request: Request) =>
    request.method() === 'POST' && new URL(request.url()).pathname === '/api/messages/create';
  page.on('request', (request) => {
    if (!isCreate(request)) return;
    seq += 1;
    const attempt: CreateAttempt = {
      body: (request.postDataJSON() ?? {}) as Record<string, unknown>,
      startSeq: seq,
      startedAt: Date.now(),
    };
    attempts.push(attempt);
    byRequest.set(request, attempt);
  });
  page.on('requestfinished', (request) => {
    const attempt = byRequest.get(request);
    if (!attempt) return;
    seq += 1;
    attempt.endSeq = seq;
    attempt.endedAt = Date.now();
    void request.response().then((response) => {
      attempt.status = response?.status();
    });
  });
  page.on('requestfailed', (request) => {
    const attempt = byRequest.get(request);
    if (!attempt) return;
    seq += 1;
    attempt.endSeq = seq;
    attempt.endedAt = Date.now();
    attempt.failure = request.failure()?.errorText ?? 'failed';
  });
  return attempts;
}

/** BR-003: each create of the conversation started only after the previous one ended. */
function expectNoOverlap(attempts: readonly CreateAttempt[]): void {
  for (let index = 1; index < attempts.length; index += 1) {
    const previous = attempts[index - 1];
    expect(previous.endSeq, `create ${index - 1} ended`).toBeDefined();
    expect(attempts[index].startSeq, `create ${index} starts after create ${index - 1} ended`).toBeGreaterThan(
      previous.endSeq as number,
    );
  }
}

interface StoredRow {
  id: string;
  key: string | null;
  content: string;
  reply_to_id: string | null;
  sender_id: string;
}

/** Every stored message of the conversation with one of `texts` (any key), oldest first. */
async function storedWithTexts(conversationId: string, texts: readonly string[]): Promise<StoredRow[]> {
  return withLocalMessagingDb(async (db) => {
    const result = await db.query<StoredRow>(
      `select id::text as id, client_message_id::text as key, content, reply_to_id::text as reply_to_id,
              sender_id::text as sender_id
         from public.messages
        where conversation_id = $1 and content = any($2::text[])
        order by "timestamp", id`,
      [conversationId, [...texts]],
    );
    return result.rows;
  });
}

/** Opens the conversation in the drawer (also when the drawer restores it directly). */
async function openConversation(page: Page, conversationId: string): Promise<void> {
  if (!page.url().includes('/floor-plan')) await page.goto('/floor-plan');
  await openDrawer(page);
  const item = page.locator(`[data-testid="conversation-item-${conversationId}"]`);
  const feed = page.getByTestId('messages-feed');
  await expect(item.or(feed).first()).toBeVisible({ timeout: STEP_TIMEOUT_MS });
  if (await item.isVisible()) await item.click();
  await expect(feed).toBeVisible({ timeout: STEP_TIMEOUT_MS });
}

const composer = (page: Page) => page.getByTestId('composer');
const composerInput = (page: Page) => composer(page).locator('textarea').first();

async function sendFromComposer(page: Page, text: string): Promise<void> {
  await composerInput(page).fill(text);
  await composer(page).getByTestId('message-send-button').click();
}

/** A's own API create (warms the create route; gives a reply target). */
async function createViaApi(page: Page, data: Record<string, unknown>): Promise<string> {
  const response = await page.request.post('/api/messages/create', { data });
  const body = (await response.json().catch(() => null)) as { message?: { id?: string } } | null;
  expect(response.status(), JSON.stringify(body)).toBe(201);
  return body?.message?.id as string;
}

interface ArrivalState {
  evaluations: number;
  first: Record<string, number>;
  max: Record<string, number>;
}

/** Records, in the page, when each text first shows in the feed and the most bubbles it ever had at once. */
async function watchArrivals(page: Page, texts: readonly string[]): Promise<void> {
  await page.evaluate((tracked: string[]) => {
    const state = { evaluations: 0, first: {} as Record<string, number>, max: {} as Record<string, number> };
    const evaluate = () => {
      state.evaluations += 1;
      const counts: Record<string, number> = {};
      const feed = document.querySelector('[data-testid="messages-feed"]');
      for (const item of feed ? Array.from(feed.querySelectorAll('[data-testid^="message-"][data-thread-depth]')) : 
[]) {
        const own = Array.from(item.querySelectorAll('p')).map((paragraph) => paragraph.textContent ?? '');
        for (const text of tracked) {
          if (own.includes(text)) counts[text] = (counts[text] ?? 0) + 1;
        }
      }
      const now = Date.now();
      for (const text of tracked) {
        const count = counts[text] ?? 0;
        if (count > 0 && state.first[text] === undefined) state.first[text] = now;
        state.max[text] = Math.max(state.max[text] ?? 0, count);
      }
    };
    (window as unknown as { __t8Arrivals?: typeof state }).__t8Arrivals = state;
    evaluate();
    new MutationObserver(evaluate).observe(document.body, { subtree: true, childList: true, characterData: true });
  }, [...texts]);
}

async function readArrivals(page: Page): Promise<ArrivalState> {
  return page.evaluate(() => (window as unknown as { __t8Arrivals: ArrivalState }).__t8Arrivals);
}

/** The pending copy of `key` in A's feed shows `label` as text. */
async function expectPendingLabel(page: Page, key: string, state: 'pending' | 'sending', label: string): Promise<void> 
{
  const bubble = page.getByTestId(`message-temp-${key}`);
  await expect(bubble).toBeVisible({ timeout: STEP_TIMEOUT_MS });
  const stateLabel = bubble.getByTestId(`message-delivery-state-temp-${key}`);
  await expect(stateLabel).toHaveText(label);
  await expect(stateLabel).toHaveAttribute('data-delivery-state', state);
}

/** A's feed holds exactly one bubble of each text: the stored one, no pending copy. */
async function expectDeliveredInFeed(page: Page, rows: readonly StoredRow[]): Promise<void> {
  for (const row of rows) {
    await expect(page.getByTestId(`message-${row.id}`)).toBeVisible({ timeout: STEP_TIMEOUT_MS });
    await expect(
      page.locator('[data-testid="messages-feed"] [data-testid^="message-"][data-thread-depth]', { hasText: 
row.content }),
    ).toHaveCount(1);
  }
  await expect(page.locator('[data-testid="messages-feed"] [data-testid^="message-temp-"]')).toHaveCount(0);
}

async function goOffline(page: Page): Promise<void> {
  await page.context().setOffline(true);
  await expect.poll(() => page.evaluate(() => navigator.onLine)).toBe(false);
}

