6:import type { QueryClient } from '@tanstack/react-query';
7:
8:import { Message } from '@/types/messaging';
9:
10:export interface MessagesPage {
11:  messages: Message[];
12:  hasMoreOlder?: boolean;
13:  nextCursorBefore?: string;
14:}
15:
16:export interface MessagesInfiniteData {
17:  pages: MessagesPage[];
18:  pageParams: unknown[];
19:}
20:
21:/** Query key of the sender's pending (not yet confirmed) messages of a conversation. */
22:export const pendingMessagesQueryKey = (userId: string, conversationId: string) =>
23:  ['messages-pending', userId, conversationId] as const;
24:
25:/** Prefix of a pending message's id (`temp-<clientMessageId>`); never a stored id. */
26:export const PENDING_MESSAGE_ID_PREFIX = 'temp-';
27:
28:/** A composition key in canonical form (lowercase), or null when absent. */
29:export const normalizeClientMessageId = (value: string | null | undefined): string | null =>
30:  typeof value === 'string' && value.length > 0 ? value.toLowerCase() : null;
31:
32:const correlationKey = (message: Message): string | null => {
33:  const key = normalizeClientMessageId(message.clientMessageId);
34:  return key ? `${message.senderId}:${key}` : null;
35:};
36:
37:/**
38: * Phase 5 FR-034: the pending messages still to show next to the stored feed.
39: * A pending message is matched to a stored one ONLY by its sender and
40: * `clientMessageId` (the server stores at most one message per sender,
41: * conversation and key): once the feed holds the stored message — from a
42: * Realtime INSERT, a feed fetch or the create response, in any order — the
43: * pending copy is hidden, so the message is one bubble. Content, timestamps
44: * and reply targets are never compared; a stored message without a key (an
45: * unkeyed or pre-Phase-4 create) matches nothing.
46: */
47:export function visiblePendingMessages(stored: readonly Message[], pending: readonly Message[]): Message[] {
48:  if (pending.length === 0) return [];
49:  const storedKeys = new Set<string>();
50:  for (const message of stored) {
51:    const key = correlationKey(message);
52:    if (key) storedKeys.add(key);
53:  }
54:  return pending.filter((message) => {
55:    const key = correlationKey(message);
56:    return key === null || !storedKeys.has(key);
57:  });
58:}
59:
60:type StoredMessageObserver = (conversationId: string, stored: readonly Message[]) => void;
61:const storedMessageObservers = new WeakMap<QueryClient, Set<StoredMessageObserver>>();
62:
63:/**
64: * Phase 5 T8: calls `observer` with every batch of stored keyed messages
65: * that resolvePendingMessages sees (a Realtime INSERT, the rendered feed after
66: * a fetch), so the durable outbox confirms an item the first time its stored
67: * key is observed from any source. Returns the unsubscribe function.
68: */
69:export function observeStoredMessages(queryClient: QueryClient, observer: StoredMessageObserver): () => void {
70:  let observers = storedMessageObservers.get(queryClient);
71:  if (!observers) {
72:    observers = new Set();
73:    storedMessageObservers.set(queryClient, observers);
74:  }
75:  observers.add(observer);
76:  return () => {
77:    storedMessageObservers.get(queryClient)?.delete(observer);
78:  };
79:}
80:
81:/**
82: * Phase 5 FR-034: retires the sender's pending messages of a conversation
83: * whose stored message has been observed (`stored`: a Realtime INSERT just
84: * merged, or the feed as rendered after a fetch). A pending message is
85: * resolved the first time its key is seen: it is removed from every pending
86: * list of that conversation, so it is not shown again as "sending" if the
87: * stored message later leaves the feed (for example a Realtime DELETE). Call
88: * it only after the stored message is in the feed cache, so no render shows
89: * neither copy.
90: */
91:export function resolvePendingMessages(
92:  queryClient: QueryClient,
93:  conversationId: string,
94:  stored: readonly Message[]
95:): void {
96:  const storedKeys = new Set<string>();
97:  for (const message of stored) {
98:    const key = correlationKey(message);
99:    if (key) storedKeys.add(key);
100:  }
101:  if (storedKeys.size === 0) return;
102:  // Phase 5 T8: the outbox confirms (and deletes) the items of these keys.
103:  storedMessageObservers.get(queryClient)?.forEach((observer) => observer(conversationId, stored));
104:  queryClient
105:    .getQueriesData<Message[]>({ queryKey: ['messages-pending'] })
106:    .forEach(([queryKey, pending]) => {
107:      if (queryKey[2] !== conversationId || !pending?.length) return;
108:      const remaining = pending.filter((message) => {
109:        const key = correlationKey(message);
110:        return key === null || !storedKeys.has(key);
111:      });
112:      if (remaining.length !== pending.length) {
113:        queryClient.setQueryData<Message[]>(queryKey, remaining);
114:      }
115:    });
116:}
117:
118:/** Whether `pending` still holds the pending message of `clientMessageId` (not yet resolved). */
119:export function isPendingMessage(pending: readonly Message[] | undefined, clientMessageId: string): boolean {
120:  return Boolean(pending?.some((message) => normalizeClientMessageId(message.clientMessageId) === 
clientMessageId));
121:}
122:
123:// Ids of messages this client saw deleted through a Realtime DELETE event, per
124:// query client, bounded to the last 1000 (the oldest are forgotten first).
125:// Only three merges consult it: a create response (useMessages), a Realtime
126:// INSERT (useMessageSubscription) and the re-merge after an in-flight fetch
127:// (keepMessageThroughInflightFetch). It does not reconcile deletions this
128:// client missed (e.g. during a Realtime stream gap), and fetched pages are
129:// not filtered by it: a feed GET that read the row before it was deleted can
