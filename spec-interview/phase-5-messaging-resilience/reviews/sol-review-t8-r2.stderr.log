  SupabaseMessageRepository,
  SupabaseConversationRepository,
  SupabaseMessageAttachmentUploadRepository,
} from '@/repositories/implementations/supabase';
import { authorizeConversationParticipant, isAuthzFailure, jsonError } from '@/lib/auth/authorize';
import {
  MESSAGE_INSERTION_QUOTA,
  enforceRateLimit,
  rateLimitExceededResponse,
  rateLimitUnavailableResponse,
} from '@/lib/auth/rate-limit';
import { requireAuthUser } from '@/lib/auth/session';
import { createSupabaseServerClient } from '@/lib/supabase/server-client';
import { MAX_ATTACHMENTS_PER_MESSAGE, attachmentMessageType } from '@/lib/messaging/attachment-policy';
import { validateUploadsForLink } from '@/lib/messaging/attachment-uploads';
import {
  attemptSupersededResponse,
  isUuid,
  messageDeletedResponse,
  parseAttemptGeneration,
  parseExpectedSenderId,
  parseMentionIds,
} from '@/lib/messaging/message-attempts';
import { buildComposition, isSameStoredComposition } from '@/lib/messaging/message-composition';

// Audit S-04: cap message payload size server-side.
const MAX_CONTENT_LENGTH = 8192;

type MessageCreateData = Omit<Message, 'id' | 'timestamp' | 'reactions' | 'attachments' | 'isEdited'>;

/** A keyed create: its key and this dispatch's attempt (Phase 5 T2). */
interface KeyedCreate {
  clientMessageId: string;
  attempt: MessageAttempt;
}

/**
 * Phase 4 FR-024: optional composition key generated by the drawer composer
 * and resent on every retry of the same composition. Absent (the published
 * app) → legacy create; present → at most one message per key, sender, and
 * conversation.
 */
function parseClientMessageId(value: unknown): { ok: true; value: string | undefined } | { ok: false } {
  if (value === undefined || value === null) {
    return { ok: true, value: undefined };
  }
  if (!isUuid(value)) {
    return { ok: false };
  }
  return { ok: true, value: value.toLowerCase() };
}

const TOO_MANY_ATTACHMENTS_MESSAGE = `A message can carry at most ${MAX_ATTACHMENTS_PER_MESSAGE} attachments`;

/**
 * Phase 4 T12 (FR-008): optional ids of the caller's pending uploads
 * (POST /api/messages/upload) to attach. Absent or empty → no attachments.
 */
function parseAttachmentIds(
  value: unknown
): { ok: true; value: string[] | undefined } | { ok: false; code: string; message: string } {
  if (value === undefined || value === null) {
    return { ok: true, value: undefined };
  }
  if (!Array.isArray(value) || value.some((id) => !isUuid(id))) {
    return { ok: false, code: 'INVALID_ATTACHMENT_ID', message: 'attachmentIds must be an array of upload ids' };
  }
  const ids = (value as string[]).map((id) => id.toLowerCase());
  if (ids.length === 0) {
    return { ok: true, value: undefined };
  }
  if (ids.length > MAX_ATTACHMENTS_PER_MESSAGE) {
    return { ok: false, code: 'TOO_MANY_ATTACHMENTS', message: TOO_MANY_ATTACHMENTS_MESSAGE };
  }
  if (new Set(ids).size !== ids.length) {
    return { ok: false, code: 'DUPLICATE_ATTACHMENT', message: 'attachmentIds must not repeat an upload' };
  }
  return { ok: true, value: ids };
}

/**
 * A replayed key must carry the same composition: content, reply target, the
 * same attachment set (attachment id = upload id), and — for messages without
 * attachments — the same type (attachment messages derive their type from
 * their attachments). Phase 5 T2 (FR-024): compared against the ORIGINAL
 * submitted composition recorded with the key; keyed messages created before
 * Phase 5 have none and are compared against the stored message (Phase 4).
 * Phase 5 T4: the requested mention ids are part of the composition (a stored
 * composition without them requested none); a message without a recorded
 * composition predates mentions, so only a replay requesting none matches.
    const safeType: MessageType = Object.values(MessageType).includes(body.type as MessageType)
      ? (body.type as MessageType)
      : MessageType.TEXT;

    let keyed: KeyedCreate | undefined;
    if (clientMessageId.value) {
      keyed = {
        clientMessageId: clientMessageId.value,
        attempt: {
          generation: attemptGeneration.value,
          composition: buildComposition({
            content: trimmedContent,
            type: attachmentIds.value ? null : safeType,
            replyToId,
            attachmentIds: attachmentIds.value ?? [],
            mentionIds: mentionIds.value,
          }),
        },
      };
    }

    if (keyed?.attempt.generation !== undefined) {
      // FR-006: an attempt that reached the server fences every older
      // generation before its INSERT, so a stale fence or request arriving
      // later is refused; the create below re-checks at commit time.
      // Phase 5 T3: this fence step consumes the fence budget.
      const overFenceBudget = await enforceRateLimit(serviceClient, dbUser.id, 'message:fence');
      if (overFenceBudget) {
        return overFenceBudget;
      }
      let fence;
      try {
        fence = await messageRepository.fenceClientMessage(
          { senderId: dbUser.id, conversationId: conversation.id, clientMessageId: keyed.clientMessageId },
          keyed.attempt.generation
        );
      } catch (error) {
        const refusal = createRefusal(error);
        if (refusal) {
          return refusal;
        }
        throw error;
      }
      if (fence.outcome === 'superseded') {
        return attemptSupersededResponse();
      }
      if (fence.outcome === 'stored' && fence.messageId === null) {
        // Delivered under this key and deleted since: never recreate it.
        return messageDeletedResponse();
      }
    }

    if (attachmentIds.value) {
      return await createWithAttachments(
        serviceClient,
        messageRepository,
        conversationRepository,
        new SupabaseMessageAttachmentUploadRepository(serviceClient),
        baseMessageData,
        attachmentIds.value,
        keyed
      );
    }

    const messageData: MessageCreateData = { ...baseMessageData, type: safeType };

    if (!keyed) {
      // Unkeyed text create (published client): created by the transactional
      // create function, which charges the insertion quota only when the
      // insertion commits (Phase 5 T3). Same legacy response.
      let createdMessage: Message;
      try {
        createdMessage = await messageRepository.createUnkeyed(messageData, MESSAGE_INSERTION_QUOTA);
      } catch (error) {
        const refusal = createRefusal(error);
        if (refusal) {
          return refusal;
        }
        throw error;
      }
      await touchConversation(conversationRepository, conversation.id);
      return NextResponse.json({ message: createdMessage }, { status: 201 });
    }

    let outcome;
    try {
      outcome = await messageRepository.createWithClientKey(
        messageData,
        keyed.clientMessageId,
        keyed.attempt,
        MESSAGE_INSERTION_QUOTA
      );
    } catch (error) {
      const refusal = createRefusal(error);
      if (refusal) {
        return refusal;
      }
      throw error;
    }
    if (!outcome.created) {
      // A retry of a composition whose create already committed (e.g. its
      // response was lost): answer with the stored message, insert nothing.
      // The key is per composition, so a different payload — including a
      // stored message that carries attachments — is a client bug.
      const stored = (await messageRepository.findById(outcome.message.id)) ?? outcome.message;
      const linkedIds = await new 
SupabaseMessageAttachmentUploadRepository(serviceClient).listLinkedAttachmentIds(stored.id);
      if (!isSameComposition(outcome.storedComposition, stored, linkedIds, keyed.attempt.composition)) {
        return clientKeyReused();
      }
      return messageResponse(stored, 200, keyed);
    }

    await touchConversation(conversationRepository, conversation.id);

    return messageResponse(outcome.message, 201, keyed);
  } catch (error) {
    console.error('Error creating message:', error);
    return jsonError(500, 'INTERNAL_ERROR', 'Failed to create message');
  return {
    id: value.id,
    conversation_id: value.conversation_id,
    sender_id: value.sender_id,
    content: value.content,
    timestamp: value.timestamp,
    type: value.type,
    status: value.status,
    reply_to_id: value.reply_to_id,
    is_edited: value.is_edited,
    client_message_id: typeof value.client_message_id === 'string' ? value.client_message_id : null,
  };
}

function mapMessageToCamelCase(data: MessageRow): Message {
  if (!data) return data;
  return {
    id: data.id,
    conversationId: data.conversation_id,
    senderId: data.sender_id,
    content: data.content,
    timestamp: new Date(data.timestamp), // Convert DB timestamp string/obj to Date
    type: data.type as MessageType,
    status: data.status as MessageStatus,
    replyToId: data.reply_to_id || undefined,
    isEdited: data.is_edited,
    clientMessageId: data.client_message_id ?? undefined,
    attachments: [], // Placeholder - fetch separately
    reactions: []    // Placeholder - fetch separately
  };
}

interface AttachmentFields {
  id: string;
  name: string;
  type: string;
  size: number;
  url: string;
  thumbnail_url?: string | null;
  // Voice notes (Phase 4 T15).
  // transaction — a failed INSERT is never charged (migration 20261007114454).
  // The answer is the row the function built in that transaction: no
  // post-commit read can fail after the message is stored (a keyless retry
  // would duplicate it).
  async createUnkeyed(messageData: MessageCreateData, insertQuota: InsertionQuota): Promise<Message> {
    const result = await createMessageAttempt(this.supabaseClient, {
      data: messageData,
      uploadIds: [],
      insertQuota,
    });
    if (!result.created) {
      throw new Error(`create_message_attempt replayed unkeyed message ${result.messageId}`);
    }
    // An unkeyed create carries no composition, hence no mention (T4): its
    // legacy response shape is unchanged (no mentionedUserIds).
    const row = parseCreatedRow(result.createdRow);
    if (row) {
      return mapCreatedMessage(row);
    }
    // Unreachable while the function returns its RETURNING row; the message is
    // committed, so read it rather than answer 500 for a stored message.
    console.error('create_message_attempt returned a malformed created row:', result.messageId);
    return this.readCreatedMessage(result.messageId, false);
  }

  private async readCreatedMessage(messageId: string, withMentions: boolean): Promise<Message> {
    const { data, error } = await this.supabaseClient
      .from(this.MSG_TABLE_NAME)
      .select('*')
      .eq('id', messageId)
      .single();

    if (error || !data) {
      console.error('Error reading message after create:', error);
      throw error || new Error(`Message ${messageId} not found after create`);
    }
    if (!withMentions) {
      return mapCreatedMessage(data as MessageRow);
    }
    const mentions = await this.loadMentionedUserIds([messageId]);
    return mapCreatedMessage(data as MessageRow, mentions.get(messageId.toLowerCase()) ?? []);
  }

  // Idempotent create (Phase 4 FR-024): the composition key is unique per
  // (sender_id, conversation_id) through the partial unique index
  // messages_sender_conversation_client_message_id_key. Phase 5 T2: the insert
  // runs in public.create_message_attempt, which returns the stored message on
  // a replay or a lost same-key race, and refuses to commit a fenced attempt
  // (AttemptSupersededError) — see migration 20261007095045. Phase 5 T3: a
  // winning insertion charges insertQuota in the same transaction
  // (InsertionRateLimitError, nothing stored) — migration 20261007114454.
  async createWithClientKey(
    messageData: MessageCreateData,
    clientMessageId: string,
    attempt: MessageAttempt | undefined,
    insertQuota: InsertionQuota | null
  ): Promise<MessageCreateResult> {
    const result = await createMessageAttempt(this.supabaseClient, {
      data: messageData,
      clientMessageId,
      attempt,
      uploadIds: [],
      insertQuota,
    });

    // Phase 5 T4: a winning insertion answers with the mentions it stored in
    // its own transaction; a replay reads the stored message and mentions.
    const createdRow = result.created ? parseCreatedRow(result.createdRow) : null;
    return {
      message: createdRow
        ? mapCreatedMessage(createdRow, result.mentionedUserIds ?? [])
        : await this.readCreatedMessage(result.messageId, true),
      created: result.created,
      storedComposition: result.storedComposition,
    };
  }

// src/types/messaging.ts

// Message Types
export enum MessageType {
  TEXT = 'text',
  IMAGE = 'image',
  FILE = 'file',
  SYSTEM = 'system',
  ANNOUNCEMENT = 'announcement'
}

// Message Status
export enum MessageStatus {
  SENDING = 'sending',
  SENT = 'sent',
  DELIVERED = 'delivered',
  READ = 'read',
  FAILED = 'failed'
}

// File Attachment Type
export interface FileAttachment {
  id: string;
  name: string;
  type: string;
  size: number;
  url: string;
  thumbnailUrl?: string;
}

/**
 * A file uploaded for a conversation and not yet linked to a sent message
 * (Phase 4 T12). Visible to no one; `id` becomes the attachment id when the
 * message is created with it, or it is removed by cancelling the upload.
 */
export interface PendingAttachmentUpload {
  id: string;
  conversationId: string;
  uploaderId: string; // users.id
  storagePath: string;
  name: string;
  type: string;
  size: number;
  createdAt: Date;
  /** Voice notes only (Phase 4 T15): whole seconds, 1-120. */
  duration?: number;
  /** Voice notes only: 1-256 amplitudes in [0, 1]. */
  waveformData?: number[];
}

/** Outcome of creating a message together with its attachments. */
export interface MessageWithAttachmentsCreateResult {
  messageId: string;
  created: boolean;
  /**
   * Phase 5 T2: on a replay (created: false), the original composition
   * recorded when the message was created under its key; null when none was
   * recorded (keyed messages created before Phase 5).
   */
  storedComposition?: MessageComposition | null;
}

/**
 * Phase 5 T2 (FR-024): the original submitted composition of a keyed create,
 * normalized by the create route, which replays of the same key are compared
 * against. `type` is null for attachment messages (their type derives from
 * the attachments); `attachmentIds` is sorted. Phase 5 T4: `mentionIds` are
 * the REQUESTED mention user ids (users.id; lowercase, distinct, sorted), not
 * only the stored ones; a stored composition without them (created before T4)
 * means none were requested, like an empty list.
 */
export interface MessageComposition {
  content: string;
  type: MessageType | null;
  replyToId: string | null;
  attachmentIds: string[];
  mentionIds: string[];
}

/**
 * Phase 5 T2 (FR-006): one dispatch of a keyed composition. `generation` is
 * monotonic per (sender, conversation, clientMessageId); absent for Phase 4
 * clients, whose keyed creates commit only while the key has no fence state.
 */
export interface MessageAttempt {
  generation?: number;
  composition: MessageComposition;
}

/**
 * Phase 5 T3 (FR-008, D1): the sender's message insertion quota (at most
 * `limit` stored messages per fixed `windowSeconds` window). The database
 * charges it in the transaction of a winning insertion only; replays, lost
 * same-key races and refused creates never consume it.
 */
export interface InsertionQuota {
  limit: number;
  windowSeconds: number;
}

/**
 * Phase 5 T2: result of fencing/looking up the caller's own key. `superseded`
 * means a newer generation exists (nothing was changed). `stored` with a null
 * messageId: a message was committed under the key and deleted since.
 */
export type MessageAttemptFenceResult =
  | { outcome: 'superseded' }
  | { outcome: 'stored'; messageId: string | null }
  | { outcome: 'not_stored' };

// Voice Note Attachment (extends FileAttachment with voice-specific metadata)
export interface VoiceNoteAttachment extends FileAttachment {
  duration: number; // Duration in seconds
  waveformData?: number[]; // Amplitude array for waveform visualization
  transcription?: string; // Optional text transcription of voice message
}

// Message Reaction Type
export interface MessageReaction {
  emoji: string;

