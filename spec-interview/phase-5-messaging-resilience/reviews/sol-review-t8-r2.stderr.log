224:export type OutboxClaim =
225:  | { kind: 'claimed'; item: OutboxItem }
226:  | { kind: 'empty' }
227:  /** The oldest unresolved item is failed or expired: later items wait (BR-003). */
228:  | { kind: 'blocked'; item: OutboxItem };
229:
230:/**
231: * Atomically takes the conversation's OLDEST item for a new attempt: the next
232: * generation, state `claimed`, `claimHolder`, lease expiry. Only the oldest
233: * item is ever eligible (BR-003). The caller must hold the conversation's
234: * drain lock, so any `claimed` item found here belongs to a holder that is
235: * gone and is taken over under a newer generation.
236: */
237:export function claimOldestOutboxItem(
238:  ownerId: string,
239:  conversationId: string,
240:  claimHolder: string,
241:  leaseMs: number
242:): Promise<OutboxClaim> {
243:  return inTransaction<OutboxClaim>('readwrite', ({ items }, done) => {
244:    const range = IDBKeyRange.bound([ownerId, conversationId, -Infinity], [ownerId, conversationId, Infinity]);
245:    const request = items.index(BY_CONVERSATION_ORDER).openCursor(range);
246:    request.onsuccess = () => {
247:      const cursor = request.result;
248:      if (!cursor) {
249:        done({ kind: 'empty' });
250:        return;
251:      }
252:      const item = cursor.value as OutboxItem;
253:      if (item.state === 'failed' || item.state === 'expired') {
254:        done({ kind: 'blocked', item });
255:        return;
256:      }
257:      const now = Date.now();
258:      const claimed: OutboxItem = {
259:        ...item,
260:        state: 'claimed',
261:        attemptGeneration: item.attemptGeneration + 1,
262:        claimHolder,
263:        leaseExpiresAt: now + leaseMs,
264:        updatedAt: now,
265:      };
266:      cursor.update(claimed);
267:      done({ kind: 'claimed', item: claimed });
268:    };
269:  });
270:}

