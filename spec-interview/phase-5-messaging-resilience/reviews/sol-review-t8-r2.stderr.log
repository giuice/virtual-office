101:/**
102: * Runs `work` in one transaction and resolves with its result once the
103: * transaction COMMITTED (`complete`); rejects with OutboxStorageError if the
104: * transaction errors or aborts (e.g. QuotaExceededError). Write transactions
105: * use strict durability: the commit is flushed before `complete`.
106: */
107:async function inTransaction<T>(
108:  mode: IDBTransactionMode,
109:  work: (stores: { items: IDBObjectStore; meta: IDBObjectStore }, done: (value: T) => void) => void
110:): Promise<T> {
111:  const db = await database();
112:  return new Promise<T>((resolve, reject) => {
113:    let transaction: IDBTransaction;
114:    try {
115:      transaction = db.transaction([ITEMS_STORE, META_STORE], mode, { durability: mode === 'readwrite' ? 'strict' 
: 'default' });
116:    } catch (error) {
117:      if (connection) connection = null;
118:      reject(new OutboxStorageError(`Outbox transaction failed (${describe(error)})`, error));
119:      return;
120:    }
121:    let result: T | undefined;
122:    let settled = false;
123:    transaction.oncomplete = () => resolve(result as T);
124:    const fail = () => {
125:      reject(new OutboxStorageError(`Outbox transaction failed (${describe(transaction.error)})`, 
transaction.error));
126:    };
127:    transaction.onerror = (event) => {
128:      // The error event reaches the transaction before its abort; reject once.
129:      event.preventDefault();
130:      if (!settled) {
131:        settled = true;
132:        try {
133:          transaction.abort();
134:        } catch {
135:          // Already aborting.
136:        }
137:      }
138:    };
139:    transaction.onabort = fail;
140:    try {
141:      work(
142:        { items: transaction.objectStore(ITEMS_STORE), meta: transaction.objectStore(META_STORE) },
143:        (value) => {
144:          result = value;
145:        }
146:      );
147:    } catch (error) {
148:      try {
149:        transaction.abort();
150:      } catch {
151:        // Already aborting.
152:      }
153:      reject(new OutboxStorageError(`Outbox transaction failed (${describe(error)})`, error));
154:    }
155:  });
156:}
