369:         const request = items.index(BY_CONVERSATION_ORDER).openCursor(range);
370:         request.onsuccess = () => {
371:           const cursor = request.result;
372:           if (!cursor) {
373:             done({ kind: 'empty' });
374:             return;
375:           }
376:           const item = cursor.value as OutboxItem;
377:           if (untouchable(item)) {
378:             done({ kind: 'busy', item });
379:             return;
380:           }
381:           if (item.retired) {
382:             // Delivered (F3) and its claim may end now: removed; the next item follows.
383:             cursor.delete();
384:             cursor.continue();
385:             return;
386:           }
387:           if (item.state === 'failed' || item.state === 'expired') {
388:             done({ kind: 'blocked', item });
389:             return;
390:           }
391:           // A backoff longer than the longest one possible means the clock went
392:           // back: the item is due now rather than held indefinitely.
393:           const retryInMs =
394:             item.state === 'waiting' && typeof item.retryNotBefore === 'number' ? item.retryNotBefore - now : 0;
395:           if (retryInMs > 0 && retryInMs <= maxDeferMs) {
396:             done({ kind: 'deferred', item, retryInMs });
397:             return;
398:           }
399:           const claimed: OutboxItem = {
400:             ...item,
401:             state: 'claimed',
402:             attemptGeneration: item.attemptGeneration + 1,
403:             claimHolder,
404:             leaseExpiresAt: now + leaseMs,
405:             updatedAt: now,
406:           };
407:           cursor.update(claimed);
408:           done({ kind: 'claimed', item: claimed, previous: item });
409:         };
410:       };
411:       if (confirmed === null) {
412:         claimOldest();
413:         return;
414:       }
415:       // The confirmed item is removed (or left to a newer holder) before the oldest is read.
416:       const confirmedRequest = items.get([ownerId, confirmed.key]);
417:       confirmedRequest.onsuccess = () => {
418:         const item = confirmedRequest.result as OutboxItem | undefined;
419:         if (item && confirmedRemovable(item, claimHolder, confirmed.generation)) items.delete([ownerId, 
confirmed.key]);
420:         claimOldest();
421:       };
422:     },
423:     'strict'
424:   );
