884:       showConfirmed?.();
885:       showConfirmed = null;
886:     };
887:     try {
888:       while (!this.disposed && !this.held && !session.lost && isOnline()) {
889:         const claim = await claimOldestOutboxItem(
890:           this.ownerId,
891:           conversationId,
892:           this.tabId,
893:           CLAIM_LEASE_MS,
894:           session,
895:           confirmed,
896:           RETRY_MAX_MS
897:         );
898:         if (claim.kind === 'claimed' || confirmed !== null) {
899:           this.announce(conversationId, confirmed?.key, confirmed?.deleted);
900:         }
901:         confirmed = null;
902:         // Taken over meanwhile: the new holder fences whatever this claim took.
903:         if (session.lost) return;
904:         if (claim.kind !== 'claimed') {
905:           if (claim.kind === 'empty') this.drain(conversationId).retryDelayMs = RETRY_BASE_MS;
906:           if (claim.kind === 'deferred') this.scheduleRetry(conversationId, claim.retryInMs);
907:           // F4: another tab's live claim (it took the lock, or claimed before a steal).
908:           if (claim.kind === 'busy') this.scheduleRetry(conversationId, LOCK_BUSY_RETRY_MS);
909:           return;
910:         }
911:         const { item, previous } = claim;
912:         // T11 (FR-011): nothing is sent unless the browser's authenticated
913:         // user is the owner; the claim is then put back as it was. F4/F5: nor
914:         // once this drain lost its lock or was stopped during that check.
915:         if (!(await this.verifyOwner()) || !this.mayDispatch(session)) {
916:           await this.releaseUnsentClaim(item, previous);
917:           this.announce(conversationId);
918:           if (!session.lost) this.scheduleRetry(conversationId);
919:           return;
920:         }
921:         this.showItem(item);
922:         // Fenced first when an earlier attempt may be stored, or when the
923:         // item's 24 h window has ended (BR-006): not stored -> expired, and
924:         // no create is ever sent past the window without a manual retry.
