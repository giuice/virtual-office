328:   test('AC-016/AC-048: recovery during an in-flight poll — its stale response keeps the newer reaction, receipt 
and attachment message, the loaded older page and one bubble per message; no poll for 60 s after recovery', async ({
329:     phase5World,
330:     openDevice,
331:     realtimeFaults,
332:     request,
333:   }, testInfo) => {
334:     test.setTimeout(240_000);
335:     const { groupId } = phase5World.conversations;
336:     const { C } = phase5World.users;
337:     const b = await openDevice('B');
338:     const a = await openDevice('A');
339: 
340:     // History longer than one page (20): A and B alternate.
341:     const existing = (await storedIds(groupId)).length;
342:     expect(existing, 'seeded group history fits in two pages with the test messages').toBeLessThanOrEqual(10);
343:     for (let index = existing; index < 27; index += 1) {
344:       await createViaApi(index % 2 === 0 ? a.page : b.page, { conversationId: groupId, content: `t14 history 
${index} ${randomUUID()}` });
345:     }
346:     const ownIds = [
347:       await createViaApi(a.page, { conversationId: groupId, content: `t14 reaction target ${randomUUID()}` }),
348:       await createViaApi(a.page, { conversationId: groupId, content: `t14 receipt target ${randomUUID()}` }),
349:     ];
350:     const [reactionTarget, receiptTarget] = ownIds;
351:     const history = await storedIds(groupId);
352:     expect(history.length).toBeGreaterThan(20);
353:     expect(history.length).toBeLessThanOrEqual(40);
354:     const oldestId = history[0];
355: 
356:     const harness = await realtimeFaults.attach(a);
357:     const polls = recordPolls(a.page);
358:     await openConversation(a.page, groupId);
359:     await harness.waitForReady('messages');
360:     await harness.waitForReady('list');
361:     await expect(a.page.getByTestId(`message-${receiptTarget}`)).toBeVisible({ timeout: STEP_TIMEOUT_MS });
362:     // The older page is loaded.
363:     await expect(a.page.getByTestId(`message-${oldestId}`)).toHaveCount(0);
364:     await a.page.getByRole('button', { name: 'Load more messages' }).click();
365:     await expect(a.page.getByTestId(`message-${oldestId}`)).toHaveCount(1, { timeout: STEP_TIMEOUT_MS });
366:     for (const id of history) await expect(a.page.getByTestId(`message-${id}`)).toHaveCount(1);
367: 
368:     // The second feed poll is held in transit; its server read happens on demand.
369:     let feedPolls = 0;
370:     let markHeld: () => void = () => undefined;
371:     const held = new Promise<void>((resolve) => {
372:       markHeld = resolve;
373:     });
374:     let readNow: () => void = () => undefined;
375:     const readGate = new Promise<void>((resolve) => {
376:       readNow = resolve;
377:     });
378:     let release: () => void = () => undefined;
379:     const releaseGate = new Promise<void>((resolve) => {
380:       release = resolve;
381:     });
382:     let heldBody: { messages: Array<{ id: string; readCount?: number; reactions?: Array<{ emoji: string }> }> } | 
null = null;
383:     let heldFinished = false;
384:     await a.page.route(
385:       (url) => url.pathname === '/api/messages/get' && url.searchParams.get('source') === 'poll',
386:       async (route: Route) => {
387:         feedPolls += 1;
388:         if (feedPolls !== 2) {
389:           await route.continue();
390:           return;
391:         }
392:         markHeld();
393:         await readGate;
394:         const response = await route.fetch();
395:         const body = await response.text();
396:         heldBody = JSON.parse(body);
397:         await releaseGate;
398:         await route.fulfill({ response, body });
399:         heldFinished = true;
400:       },
401:     );
402: 
403:     // ---- Both required streams fail on the live socket; polling starts after 30 s.
404:     const messagesFault = await harness.fail('messages', 'error');
405:     const listFault = await harness.fail('list', 'error');
406:     await harness.waitForStatus('messages', 'CHANNEL_ERROR', { since: messagesFault.mark, timeout: 10_000 });
407:     await harness.waitForStatus('list', 'CHANNEL_ERROR', { since: listFault.mark, timeout: 10_000 });
408:     await expect.poll(() => feedPolls, { timeout: POLL_AFTER_UNHEALTHY_MS + 5_000 }).toBe(1);
409:     await held;
410:     const heldAt = Date.now();
411: 
412:     // ---- Realtime recovers while that poll is in flight.
413:     const restoreMark = harness.restore();
414:     await harness.waitForReady('messages', { timeout: RECOVERY_TIMEOUT_MS });
415:     await harness.waitForReady('list', { timeout: RECOVERY_TIMEOUT_MS });
416:     await harness.settle();
417:     // Healthy again: the later of the two streams' SUBSCRIBED after restore.
418:     const recoveredAt = Math.max(
419:       ...(['messages', 'list'] as const).map(
420:         (stream) =>
421:           (harness.statuses(stream, { since: restoreMark }).find((record) => record.status === 'SUBSCRIBED') as { 
at: number }).at,
422:       ),
423:     );
424:     // A message both deliver: live over the recovered stream, and in the held poll.
425:     const bothText = `t14 delivered by both ${randomUUID()}`;
426:     await watchArrivals(a.page, [bothText]);
427:     const bothMark = harness.mark();
428:     const bothId = await createViaApi(b.page, { conversationId: groupId, content: bothText });
429:     await expect(a.page.getByTestId(`message-${bothId}`)).toBeVisible({ timeout: STEP_TIMEOUT_MS });
430:     expect(
431:       harness
432:         .frames({ stream: 'messages', since: bothMark, direction: 'in', action: 'pass', events: 
['postgres_changes'] })
433:         .some((frame) => frame.detail.table === 'messages' && frame.detail.recordId === bothId),
434:       'delivered live over the recovered stream',
435:     ).toBe(true);
436:     readNow();
437:     await expect.poll(() => heldBody !== null, { timeout: STEP_TIMEOUT_MS }).toBe(true);
438: 
439:     // ---- Newer state over Realtime after the held poll read the server.
440:     const reaction = await b.page.request.post('/api/messages/react', { data: { messageId: reactionTarget, emoji: 
REACTION } });
441:     expect(reaction.status(), await reaction.text()).toBeLessThan(300);
442:     expect(await markReadAsSeededMember(request, { conversationId: groupId, userId: C.userId, messageIds: 
[receiptTarget] })).toBe(1);
443:     const fileId = await sendFile(b.page, groupId, `t14-${randomUUID()}.txt`);
444:     const reactionChip = `[data-testid="message-${reactionTarget}"] [data-testid="reaction-chip-${REACTION}"]`;
445:     await expect(a.page.locator(reactionChip)).toHaveCount(1, { timeout: STEP_TIMEOUT_MS });
446:     await expect(readBy(a.page, receiptTarget)).toHaveText('Lida por 1', { timeout: STEP_TIMEOUT_MS });
447:     await expect(a.page.locator(`[data-testid="message-${fileId}"][data-attachment-count="1"]`)).toHaveCount(1, {
448:       timeout: STEP_TIMEOUT_MS,
449:     });
450: 
451:     // The held response is stale: it has the message both delivered, none of the newer state.
452:     const stale = heldBody as unknown as { messages: Array<{ id: string; readCount?: number; reactions?: Array<{ 
emoji: string }> }> };
453:     const staleById = new Map(stale.messages.map((message) => [message.id, message]));
454:     expect(staleById.has(bothId), 'the held poll carries the message Realtime delivered').toBe(true);
455:     expect(staleById.has(fileId), 'the held poll predates the attachment message').toBe(false);
456:     expect(staleById.get(receiptTarget)?.readCount ?? 0, 'the held poll predates C\'s read').toBe(0);
457:     expect(staleById.get(reactionTarget)?.reactions ?? [], 'the held poll predates B\'s reaction').toEqual([]);
458:     expect(staleById.has(oldestId), 'the held poll covered the loaded older page').toBe(true);
459: 
460:     // ---- Release it: the newer state, the older page and one bubble per message stay.
461:     await watchFeedState(a.page, [
462:       { selector: reactionChip },
463:       { selector: `[data-testid="read-by-${receiptTarget}"]`, text: 'Lida por 1' },
464:       { selector: `[data-testid="message-${fileId}"][data-attachment-count="1"]` },
465:       { selector: `[data-testid="message-${bothId}"]` },
466:       { selector: `[data-testid="message-${oldestId}"]` },
467:     ]);
468:     release();
469:     await expect.poll(() => heldFinished, { timeout: STEP_TIMEOUT_MS }).toBe(true);
470:     await a.page.waitForTimeout(2_000);
471:     expect(await readFeedViolations(a.page), 'newer state, older page and single bubbles kept').toEqual([]);
472:     const all = await storedIds(groupId);
473:     for (const id of all) await expect(a.page.getByTestId(`message-${id}`), `${id} once`).toHaveCount(1);
474:     expect((await readArrivals(a.page)).max[bothText]).toBe(1);
475: 
476:     // ---- No new polling request starts during the 60 s after recovery.
477:     await a.page.waitForTimeout(Math.max(0, recoveredAt + 60_000 - Date.now()));
478:     expect(
479:       polls.filter((poll) => poll.kind !== 'readers' && poll.at > recoveredAt),
480:       'no polling request after recovery',
481:     ).toEqual([]);
482:     expect(feedPolls, 'only the two rounds before recovery').toBe(2);
483:     expect(harness.status('messages')).toBe('SUBSCRIBED');
484:     expect(harness.status('list')).toBe('SUBSCRIBED');
485:     testInfo.annotations.push({
486:       type: 't14-stale-poll',
487:       description: JSON.stringify({ heldToRecoveredMs: recoveredAt - heldAt, rounds: feedPolls }),
488:     });
489:   });
490: });

