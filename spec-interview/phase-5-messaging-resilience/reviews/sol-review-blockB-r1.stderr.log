278:   }, [userId, getCachedConversations, upsertConversation]);
279: 
280:   // Function to archive a conversation
281:   const archiveConversation = useCallback(async (conversationId: string) => {
282:     const instrumentationEnabled = debugLogger.messaging.enabled();
283:     const traceId = instrumentationEnabled ? createTraceId('archive-conv') : '';
284: 
285:     if (instrumentationEnabled) {
286:       debugLogger.messaging.event('useConversations.archive', 'start', {
287:         traceId,
288:         conversationId,
289:         userId,
290:       });
291:     }
292: 
293:     // Optimistic update first (archive is per-user — audit M-02: keep the
294:     // effective flag and the preference in sync)
295:     setConversationsData((prev) =>
296:       prev.map((conversation) =>
297:         conversation.id === conversationId
298:           ? applyArchiveState(conversation, true)
299:           : conversation
300:       )
301:     );
302: 
303:     // If this was the active conversation, clear it
304:     if (activeConversation && activeConversation.id === conversationId) {
305:       setActiveConversation(null);
306:     }
307: 
308:     try {
309:       await messagingApi.setConversationArchiveStatus(conversationId, currentUserProfile!.id, true);
310:       if (instrumentationEnabled) {
311:         debugLogger.messaging.event('useConversations.archive', 'success', { traceId, conversationId });
312:       }
313:     } catch (error) {
314:       // Revert on error
315:       setConversationsData((prev) =>
316:         prev.map((conversation) =>
317:           conversation.id === conversationId
318:             ? applyArchiveState(conversation, false)
319:             : conversation
320:         )
321:       );
322:       if (instrumentationEnabled) {
323:         debugLogger.messaging.error('useConversations.archive', 'error', {
324:           traceId,
325:           conversationId,
326:           error: error instanceof Error ? error.message : error,
327:         });
328:       }
329:       console.error('Error archiving conversation:', error);
330:       throw error;
331:     }
332:   }, [activeConversation, currentUserProfile, userId, setConversationsData]);
333: 
334:   // Function to unarchive a conversation
335:   const unarchiveConversation = useCallback(async (conversationId: string) => {
336:     const instrumentationEnabled = debugLogger.messaging.enabled();
337:     const traceId = instrumentationEnabled ? createTraceId('unarchive-conv') : '';
338: 
339:     if (instrumentationEnabled) {
340:       debugLogger.messaging.event('useConversations.unarchive', 'start', {
341:         traceId,
342:         conversationId,
343:         userId,
344:       });
345:     }
346:     // Optimistic update first
347:     setConversationsData((prev) =>
348:       prev.map((conversation) =>
349:         conversation.id === conversationId
350:           ? applyArchiveState(conversation, false)
351:           : conversation
352:       )
353:     );
354: 
355:     try {
356:       await messagingApi.setConversationArchiveStatus(conversationId, currentUserProfile!.id, false);
357:       if (instrumentationEnabled) {
358:         debugLogger.messaging.event('useConversations.unarchive', 'success', { traceId, conversationId });
359:       }
360:     } catch (error) {
361:       // Revert on error
362:       setConversationsData((prev) =>
363:         prev.map((conversation) =>
364:           conversation.id === conversationId
365:             ? applyArchiveState(conversation, true)
366:             : conversation
367:         )
368:       );
369:       if (instrumentationEnabled) {
370:         debugLogger.messaging.error('useConversations.unarchive', 'error', {
371:           traceId,
372:           conversationId,
373:           error: error instanceof Error ? error.message : error,
374:         });
375:       }
376:       console.error('Error unarchiving conversation:', error);
377:       throw error;
378:     }
379:   }, [currentUserProfile, userId, setConversationsData]);
380: 
381:   // Pin / Unpin conversations with optimistic updates
382:   const pinConversation = useCallback(async (conversationId: string) => {
383:     const traceId = debugLogger.messaging.enabled() ? createTraceId('pin-conv') : '';
384:     // Optimistic update - handle cases where preferences may not exist yet
385:     setConversationsData((prev) => prev.map((c) => {
386:       if (c.id !== conversationId) {
387:         return c;
388:       }
389:       // Create preferences if they don't exist
390:       const existingPrefs = c.preferences || {
391:         id: '',
392:         conversationId: c.id,
393:         userId: userId || '',
394:         isPinned: false,
395:         pinnedOrder: null,
396:         isStarred: false,
397:         isArchived: false,
398:         notificationsEnabled: true,
399:         createdAt: new Date(),
400:         updatedAt: new Date(),
401:       };
402:       return {
403:         ...c,
404:         preferences: {
405:           ...existingPrefs,
406:           isPinned: true,
407:           pinnedOrder: existingPrefs.pinnedOrder ?? 0,
408:         },
409:       };
410:     }));
411:     try {
412:       await messagingApi.updateConversationPreferences(conversationId, { isPinned: true });
413:       if (debugLogger.messaging.enabled()) {
414:         debugLogger.messaging.event('useConversations.pin', 'success', { traceId, conversationId });
415:       }
416:       // Refresh to get the real preferences from server
417:       await refreshConversations();
418:     } catch (error) {
419:       // Revert
420:       setConversationsData((prev) => prev.map((c) => {
421:         if (c.id !== conversationId) {
422:           return c;
423:         }
424:         if (!c.preferences) {
425:           return c;
426:         }
427:         return {
428:           ...c,
429:           preferences: {
430:             ...c.preferences,
431:             isPinned: false,
432:           },
433:         };
434:       }));
435:       if (debugLogger.messaging.enabled()) {
436:         debugLogger.messaging.error('useConversations.pin', 'error', { traceId, conversationId, error: error 
instanceof Error ? error.message : error });
437:       }
438:       throw error;
439:     }
440:   }, [userId, refreshConversations, setConversationsData]);
441: 
442:   const unpinConversation = useCallback(async (conversationId: string) => {
443:     const traceId = debugLogger.messaging.enabled() ? createTraceId('unpin-conv') : '';
444:     // Optimistic update
445:     setConversationsData((prev) => prev.map((c) => {
446:       if (c.id !== conversationId) {
447:         return c;
448:       }
449:       if (!c.preferences) {
450:         return c;
451:       }
452:       return {
453:         ...c,
454:         preferences: {
455:           ...c.preferences,
456:           isPinned: false,
457:           pinnedOrder: null,
458:         },
459:       };
460:     }));
461:     try {
462:       await messagingApi.updateConversationPreferences(conversationId, { isPinned: false });
463:       if (debugLogger.messaging.enabled()) {
464:         debugLogger.messaging.event('useConversations.unpin', 'success', { traceId, conversationId });
465:       }
466:       // Refresh to get the real preferences from server
467:       await refreshConversations();
468:     } catch (error) {
469:       // Revert
470:       setConversationsData((prev) => prev.map((c) => {
471:         if (c.id !== conversationId) {
472:           return c;
473:         }
474:         if (!c.preferences) {
475:           return c;
476:         }
477:         return {
478:           ...c,
479:           preferences: {
480:             ...c.preferences,
481:             isPinned: true,
482:           },
483:         };
484:       }));
485:       if (debugLogger.messaging.enabled()) {
486:         debugLogger.messaging.error('useConversations.unpin', 'error', { traceId, conversationId, error: error 
instanceof Error ? error.message : error });
487:       }
488:       throw error;
489:     }
490:   }, [refreshConversations, setConversationsData]);
491: 
492:   // Record receipts for messages the viewer actually saw (Phase 4: "read"
493:   // means visibly rendered, never "the conversation was opened"). The list's
494:   // unread counts are server-computed, so a batch that recorded anything
495:   // refetches them instead of guessing a local decrement. Errors propagate so
496:   // the caller can retry the batch.
497:   const markMessagesAsRead = useCallback(async (conversationId: string, messageIds: readonly string[]) => {
498:     if (!userId || messageIds.length === 0) return;
499: 
500:     const recorded = await messagingApi.markMessagesAsRead(conversationId, messageIds);
501: 
502:     if (debugLogger.messaging.enabled()) {
503:       debugLogger.messaging.event('useConversations.markMessagesRead', 'success', {
504:         conversationId,
505:         submitted: messageIds.length,
506:         recorded,
507:       });
508:     }
509: 
510:     if (recorded > 0) {
511:       await queryClient.invalidateQueries({ queryKey: conversationsQueryKey(userId) });
512:     }
513:   }, [userId, queryClient]);
514: 
515:   // Calculate total unread count (unreadCount is the viewer's own count,
516:   // server-computed — Phase 2.2). Archived conversations do not count.
517:   const totalUnreadCount = useMemo(() => {
518:     if (!userId) return 0;
519:     return conversations.reduce(
520:       (count, conversation) =>
521:         conversation.isArchived ? count : count + (conversation.unreadCount || 0),
522:       0
523:     );
524:   }, [conversations, userId]);
525: 
526:   // Update conversation with new message (immutable — audit M-04)
527:   const updateConversationWithMessage = useCallback((
528:     conversationId: string,
529:     lastMessage: Pick<Message, 'timestamp'>,
530:     senderId: string
531:   ) => {
532:     const instrumentationEnabled = debugLogger.messaging.enabled();
533:     if (instrumentationEnabled) {
534:       debugLogger.messaging.event('useConversations.updateWithMessage', 'incoming', {
535:         conversationId,
536:         senderId,
537:         lastActivity: lastMessage?.timestamp,
538:         activeConversationId: activeConversation?.id,
539:       });
540:     }
541: 
542:     setConversationsData((prev) => {
543:       const conversationIndex = prev.findIndex((c) => c.id === conversationId);
544: 
545:       if (conversationIndex === -1) {
546:         if (instrumentationEnabled) {
547:           debugLogger.messaging.warn('useConversations.updateWithMessage', 'miss:not-found', {
548:             conversationId,
549:           });
550:         }
551:         return prev;
552:       }
553: 
554:       const conversation: Conversation = {
555:         ...prev[conversationIndex],
556:         lastActivity: lastMessage.timestamp,
557:       };
558: 
559:       // A message from someone else is unread until it is actually seen —
560:       // also in the active conversation (the reader may be scrolled up, the
561:       // tab hidden, or the drawer closed). Visible-message receipts refetch
562:       // the server count once it has been seen.
563:       if (userId && senderId !== userId) {
564:         conversation.unreadCount = (conversation.unreadCount || 0) + 1;
565:       }
566: 
567:       // Move conversation to top of list
568:       const updated = [...prev];
569:       updated.splice(conversationIndex, 1);
570:       updated.unshift(conversation);
571:       return updated;
572:     });
573:   }, [activeConversation, userId, setConversationsData]);
574: 
575:   return {
576:     conversations,
577:     activeConversation,
578:     lastActiveConversation,
579:     setActiveConversation,
580:     loadingConversations,
581:     refreshingConversations,
582:     hasLoadedConversations,
583:     errorConversations,
584:     refreshConversations,
585:     getCachedConversations,
586:     getOrCreateRoomConversation,
587:     getOrCreateUserConversation,
588:     archiveConversation,
589:     unarchiveConversation,
590:     pinConversation,
591:     unpinConversation,
592:     markMessagesAsRead,
593:     totalUnreadCount,
594:     updateConversationWithMessage,
595:     clearLastActiveConversation,
596:   };
597: }
src/components/messaging/MessagingConnectionBanner.tsx
1: // src/components/messaging/MessagingConnectionBanner.tsx
2: 'use client';
3: 
4: import { useEffect, useState, useSyncExternalStore } from 'react';
5: 
6: import { useMessaging } from '@/contexts/messaging/MessagingContext';
7: import { REQUIRED_MESSAGING_STREAMS, unhealthySince } from '@/lib/messaging/realtime-health';
8: 
9: /** FR-014: a required stream unhealthy longer than this (browser online) shows "Reconectando…". */
10: const RECONNECTING_AFTER_MS = 5_000;
11: 
12: export const OFFLINE_BANNER_TEXT = 'Sem conexão — mensagens serão enviadas quando voltar';
13: export const RECONNECTING_BANNER_TEXT = 'Reconectando…';
14: 
15: const subscribeOnline = (listener: () => void) => {
16:   window.addEventListener('online', listener);
17:   window.addEventListener('offline', listener);
18:   return () => {
19:     window.removeEventListener('online', listener);
20:     window.removeEventListener('offline', listener);
21:   };
22: };
23: const readOnline = () => navigator.onLine !== false;
24: const readOnlineOnServer = () => true;
25: 
26: /**
27:  * Phase 5 T13 (FR-014, AC-014, AC-037): the drawer's connection banner — the
28:  * offline text as soon as the browser reports offline; "Reconectando…" while
29:  * online when the messages or the conversation-list stream has been unhealthy
30:  * for more than 5 s; nothing once all are healthy. A polite live region that
31:  * is always present, so each change is announced.
32:  */
33: export function MessagingConnectionBanner() {
34:   const { realtimeHealth } = useMessaging();
35:   const online = useSyncExternalStore(subscribeOnline, readOnline, readOnlineOnServer);
36:   const health = useSyncExternalStore(realtimeHealth.subscribe, realtimeHealth.getSnapshot, 
realtimeHealth.getSnapshot);
37:   const since = unhealthySince(health, REQUIRED_MESSAGING_STREAMS);
38:   // Re-render once the current unhealthy period passes the threshold.
39:   const [, setTick] = useState(0);
40: 
41:   useEffect(() => {
42:     if (since === null) return;
43:     const left = since + RECONNECTING_AFTER_MS - Date.now();
44:     if (left < 0) return;
45:     const timer = setTimeout(() => setTick((tick) => tick + 1), left + 50);
46:     return () => clearTimeout(timer);
47:   }, [since]);
48: 
49:   // Decided at render: when the earliest unhealthy stream recovers while another
50:   // one is already past the threshold, the banner stays without a healthy flash.
51:   const overdue = since !== null && Date.now() - since > RECONNECTING_AFTER_MS;
52:   const state = !online ? 'offline' : overdue ? 'reconnecting' : 'healthy';
53:   const text = state === 'offline' ? OFFLINE_BANNER_TEXT : state === 'reconnecting' ? RECONNECTING_BANNER_TEXT : 
'';
54: 
55:   return (
56:     <div role="status" aria-live="polite" data-testid="messaging-connection-banner" data-state={state}>
57:       {text ? (
58:         <p className="border-b bg-muted px-3 py-1.5 text-xs text-muted-foreground">{text}</p>
59:       ) : null}
60:     </div>
61:   );
62: }

