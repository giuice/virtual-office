1: // src/hooks/useConversations.ts
2: import { useState, useCallback, useEffect, useMemo, useRef } from 'react';
3: import { useQuery, useQueryClient } from '@tanstack/react-query';
4: import { useCompany } from '@/contexts/CompanyContext';
5: import { Conversation, ConversationType, Message } from '@/types/messaging';
6: import { messagingApi } from '@/lib/messaging-api';
7: import { useConversationRealtime } from '@/hooks/realtime/useConversationRealtime';
8: import { debugLogger } from '@/utils/debug-logger';
9: import type { MessagingRealtimeHealth } from '@/lib/messaging/realtime-health';
10: 
11: // Query key shared with useConversationRealtime invalidations (audit B-06):
12: // both sides MUST use ['conversations', <DB user id>].
13: export const conversationsQueryKey = (userId: string | undefined) =>
14:   ['conversations', userId] as const;
15: 
16: const NO_CONVERSATIONS: Conversation[] = [];
17: 
18: /**
19:  * The conversation list of `userId` (users.id) as the list query loads it.
20:  * Archived conversations are included (flagged isArchived) so the list's
21:  * Archived view can show them and unarchive works; the main list filters them
22:  * out client-side. `source: 'poll'`: the T14 polling fallback's request.
23:  */
24: export async function fetchConversationList(userId: string, source?: 'poll'): Promise<Conversation[]> {
25:   const result = await messagingApi.getConversations(userId, { includeArchived: true, source });
26:   return result.conversations;
27: }
28: 
29: // Archive is a per-user preference (audit M-02); keep the effective flag and
30: // the preference object in sync on optimistic updates.
31: const applyArchiveState = (conversation: Conversation, isArchived: boolean): Conversation => ({
32:   ...conversation,
33:   isArchived,
34:   preferences: conversation.preferences
35:     ? { ...conversation.preferences, isArchived }
36:     : conversation.preferences,
37: });
38: 
39: const createTraceId = (prefix: string): string => {
40:   try {
41:     if (typeof crypto !== 'undefined' && typeof crypto.randomUUID === 'function') {
42:       return crypto.randomUUID();
43:     }
44:   } catch (error) {
45:     // Ignore and fallback to timestamp-based identifier
46:   }
47:   return `${prefix}-${Date.now().toString(36)}-${Math.random().toString(36).slice(2)}`;
48: };
49: 
50: /** `realtimeHealth`: where the conversation-list stream reports its health (T13). */
51: export function useConversations(realtimeHealth: MessagingRealtimeHealth) {
52:   const { currentUserProfile } = useCompany();
53:   const queryClient = useQueryClient();
54:   const userId = currentUserProfile?.id;
55: 
56:   const [activeConversation, setActiveConversation] = useState<Conversation | null>(null);
57:   const lastActiveConversationRef = useRef<Conversation | null>(null);
58: 
59:   // Subscribe to realtime updates using the Database User ID (canonical).
60:   // Invalidations target the same query key as the query below.
61:   useConversationRealtime(userId, realtimeHealth);
62: 
63:   useEffect(() => {
64:     if (!debugLogger.messaging.enabled()) {
65:       return;
66:     }
67: 
68:     if (!userId) {
69:       debugLogger.messaging.trace('useConversations.realtime', 'skip:no-user');
70:       return;
71:     }
72: 
73:     debugLogger.messaging.trace('useConversations.realtime', 'subscribe', {
74:       userId,
75:     });
76:   }, [userId]);
77: 
78:   if (activeConversation?.type === ConversationType.DIRECT) {
79:     lastActiveConversationRef.current = activeConversation;
80:   }
81:   const lastActiveConversation = activeConversation?.type === ConversationType.DIRECT
82:     ? activeConversation
83:     : lastActiveConversationRef.current;
84: 
85:   const conversationsQuery = useQuery<Conversation[], Error>({
86:     queryKey: conversationsQueryKey(userId),
87:     // Query conversations by Database User ID.
88:     queryFn: () => fetchConversationList(userId!),
89:     enabled: !!userId,
90:     // Realtime invalidation (useConversationRealtime) is the primary freshness
91:     // signal; staleTime only guards against redundant mount refetches.
92:     staleTime: 30_000,
93:   });
94: 
95:   const conversations = conversationsQuery.data ?? NO_CONVERSATIONS;
96:   const loadingConversations = conversationsQuery.isLoading;
97:   const refreshingConversations = conversationsQuery.isFetching && !conversationsQuery.isLoading;
98:   const hasLoadedConversations = conversationsQuery.isSuccess;
99:   const errorConversations = conversationsQuery.isError ? 'Failed to load conversations' : null;
100: 
101:   // Imperative cache reader — the fix for the stale-closure retries in
102:   // ensureOpenForMessage (audit B-07): always reflects the latest fetch.
103:   const getCachedConversations = useCallback((): Conversation[] => {
104:     if (!userId) return NO_CONVERSATIONS;
105:     return queryClient.getQueryData<Conversation[]>(conversationsQueryKey(userId)) ?? NO_CONVERSATIONS;
106:   }, [queryClient, userId]);
107: 
108:   const setConversationsData = useCallback(
109:     (updater: (prev: Conversation[]) => Conversation[]) => {
110:       if (!userId) return;
111:       queryClient.setQueryData<Conversation[]>(
112:         conversationsQueryKey(userId),
113:         (prev) => updater(prev ?? NO_CONVERSATIONS)
114:       );
115:     },
116:     [queryClient, userId]
117:   );
118: 
119:   const upsertConversation = useCallback(
120:     (conversation: Conversation) => {
121:       setConversationsData((prev) => {
122:         const existingIndex = prev.findIndex((c) => c.id === conversation.id);
123:         if (existingIndex >= 0) {
124:           const updated = [...prev];
125:           updated[existingIndex] = conversation;
126:           return updated;
127:         }
128:         return [conversation, ...prev];
129:       });
130:     },
131:     [setConversationsData]
132:   );
133: 
134:   // Function to refresh conversations (invalidate + refetch via the query)
135:   const refreshConversations = useCallback(async () => {
136:     if (!userId) {
137:       if (debugLogger.messaging.enabled()) {
138:         debugLogger.messaging.trace('useConversations.refresh', 'skip:no-user');
139:       }
140:       return;
141:     }
142:     await queryClient.invalidateQueries({ queryKey: conversationsQueryKey(userId) });
143:   }, [queryClient, userId]);
144: 
145:   const clearLastActiveConversation = useCallback(() => {
146:     lastActiveConversationRef.current = null;
147:   }, []);
148: 
149:   // Function to get or create a room conversation
150:   const getOrCreateRoomConversation = useCallback(async (roomId: string, roomName: string): Promise<Conversation> 
=> {
151:     if (!userId) {
152:       throw new Error('User not authenticated');
153:     }
154: 
155:     const instrumentationEnabled = debugLogger.messaging.enabled();
156:     const traceId = instrumentationEnabled ? createTraceId('room-conv') : '';
157: 
158:     if (instrumentationEnabled) {
159:       debugLogger.messaging.event('useConversations.room', 'start', {
160:         traceId,
161:         roomId,
162:         roomName,
163:         userId,
164:       });
165:     }
166: 
167:     try {
168:       const existingConversation = getCachedConversations().find(
169:         (c) => c.type === ConversationType.ROOM && 'roomId' in c && c.roomId === roomId
170:       );
171: 
172:       if (existingConversation) {
173:         if (instrumentationEnabled) {
174:           debugLogger.messaging.event('useConversations.room', 'hit:existing', {
175:             traceId,
176:             roomId,
177:             conversationId: existingConversation.id,
178:           });
179:         }
180:         return existingConversation;
181:       }
182: 
183:       const resolvedConversation = await messagingApi.resolveConversation({
184:         type: ConversationType.ROOM,
185:         roomId,
186:       });
187: 
188:       if (instrumentationEnabled) {
189:         debugLogger.messaging.event('useConversations.room', 'created', {
190:           traceId,
191:           roomId,
192:           conversationId: resolvedConversation.id,
193:         });
194:       }
195: 
196:       upsertConversation(resolvedConversation);
197: 
198:       return resolvedConversation;
199:     } catch (error) {
200:       if (instrumentationEnabled) {
201:         debugLogger.messaging.error('useConversations.room', 'error', {
202:           traceId,
203:           roomId,
204:           error: error instanceof Error ? error.message : error,
205:         });
206:       }
207:       console.error('Error creating room conversation:', error);
208:       throw error;
209:     }
210:   }, [userId, getCachedConversations, upsertConversation]);
211: 
212:   // Function to get or create a direct conversation with another user
213:   const getOrCreateUserConversation = useCallback(async (otherUserId: string): Promise<Conversation> => {
214:     if (!userId) {
215:       throw new Error('User not authenticated');
216:     }
217:     // Compare Database User IDs to prevent self-DM
218:     if (userId === otherUserId) {
219:       throw new Error('Cannot create conversation with yourself');
220:     }
221:     const instrumentationEnabled = debugLogger.messaging.enabled();
222:     const traceId = instrumentationEnabled ? createTraceId('direct-conv') : '';
223: 
224:     if (instrumentationEnabled) {
225:       debugLogger.messaging.event('useConversations.direct', 'start', {
226:         traceId,
227:         userId,
228:         otherUserId,
229:       });
230:     }
231: 
232:     try {
233:       const existingConversation = getCachedConversations().find(
234:         (c) => c.type === ConversationType.DIRECT &&
235:              c.participants.includes(userId) &&
236:              c.participants.includes(otherUserId) &&
237:              c.participants.length === 2
238:       );
239: 
240:       if (existingConversation) {
241:         if (instrumentationEnabled) {
242:           debugLogger.messaging.event('useConversations.direct', 'hit:existing', {
243:             traceId,
244:             conversationId: existingConversation.id,
245:             otherUserId,
246:           });
247:         }
248:         return existingConversation;
249:       }
250: 
251:       const resolvedConversation = await messagingApi.resolveConversation({
252:         type: ConversationType.DIRECT,
253:         userId: otherUserId,
254:       });
255: 
256:       if (instrumentationEnabled) {
257:         debugLogger.messaging.event('useConversations.direct', 'created', {
258:           traceId,
259:           conversationId: resolvedConversation.id,
260:           otherUserId,
261:         });
262:       }
263: 
264:       upsertConversation(resolvedConversation);
265: 
266:       return resolvedConversation;
267:     } catch (error) {
268:       if (instrumentationEnabled) {
269:         debugLogger.messaging.error('useConversations.direct', 'error', {
270:           traceId,
