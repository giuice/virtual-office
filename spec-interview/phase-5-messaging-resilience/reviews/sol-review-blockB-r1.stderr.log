14: /**
15:  * Phase 5 T25 — per-stream Realtime fault harness probe (BR-015, AC-015,
16:  * AC-036). For every stream (messages/receipts/reactions, conversation list,
17:  * typing) × failure class (error, timed out, closed) A's target channel must
18:  * report the class's status through the app's own subscribe callback while,
19:  * on the same socket, the two other streams and Presence stay joined (no
20:  * status change, no join/leave/close/error frame) and keep delivering real
21:  * events B produces after the fault:
22:  *   list      B's message in the group (not open in A) → conversations UPDATE
23:  *             on the list topic → A's list query refetches (GET
24:  *             /api/conversations/get);
25:  *   typing    B types in the open DM → A shows "… está digitando…";
26:  *   messages  B's message in the open DM → messages INSERT on the messages
27:  *             topic → A's feed shows it.
28:  * The faulted stream must deliver nothing to the page (and its UI effect must
29:  * not happen). Presence must also receive a real event after the fault (B
30:  * opens a second tab: its Presence join reaches A). Afterwards restore() lets
31:  * every stream rejoin, a terminal closure included (application-level rejoin:
32:  * messages and list from T13, typing from T15).
33:  */
34: 
35: const KINDS: readonly RealtimeFaultKind[] = ['error', 'timeout', 'close'];
36: const DELIVERY_TIMEOUT_MS = 15_000;
37: /** How long an absent effect is watched (> typing TTL 4 s; > Realtime latency). */
38: const ABSENCE_WINDOW_MS = 6_000;
39: /** Recovery after restore: pending join timeout (10 s) + rejoin step (≤ 10 s). */
40: const RECOVERY_TIMEOUT_MS = 45_000;
41: const LIFECYCLE_EVENTS = ['phx_join', 'phx_leave', 'phx_close', 'phx_error'] as const;
