8:  *
9:  * Makes ONE messaging Realtime stream of a browser context fail while every
10:  * other channel on the same socket (the other messaging streams, Presence,
11:  * Knock, spaces, …) keeps flowing untouched. The browser's own WebSocket to
12:  * local Realtime stays the transport: `context.routeWebSocket` opens the
13:  * server connection from the page with the native WebSocket and hands every
14:  * frame to this module, which forwards it unchanged unless it belongs to the
15:  * faulted stream. The app's joins, its realtime-js/Phoenix client, its
16:  * subscribe callbacks and its retries are the real ones; no application
17:  * health is set here.
18:  *
19:  * Streams (topic → stream; realtime-js prefixes every topic with `realtime:`):
20:  *   messages  `messaging-db-changes:<companyId>:<userId>:<seq>:<uuid>`
21:  *             (useMessageSubscription: messages, receipts, reactions; a new
22:  *             topic on every application retry, so matched by prefix)
23:  *   list      `conversations-changes:<userId>:<uuid>` (useConversationRealtime;
24:  *             a new topic on every application retry from T13, so matched by
25:  *             prefix; the bare `conversations-changes` of earlier builds too)
26:  *   typing    `conversation:<id>:typing` (useConversationTyping, the T5
27:  *             private topic, from T15; the same topic on every rejoin) or the
28:  *             public `conversation:<id>` of earlier builds
29:  *   presence  `company:<companyId>:presence` (observed only, never faulted)
30:  *
31:  * fail(stream, kind) — until restore(stream), every server frame of that
32:  * stream is withheld (the stream is dark), and:
33:  *   'error'   the current join gets a `phx_error` (Phoenix channel crash
34:  *             signal; the client sees CHANNEL_ERROR and the SDK rejoins after
35:  *             1/2/5/10 s); each later join attempt is forwarded to the server,
36:  *             its real reply withheld and an error reply returned
37:  *             (CHANNEL_ERROR again).
38:  *   'timeout' the current join gets a `phx_error` (a joined channel cannot
39:  *             time out: this makes the client rejoin, so the recorded sequence
40:  *             starts CHANNEL_ERROR); each later join attempt is forwarded and
41:  *             its reply withheld, so the client's own join timer (10 s) fires
42:  *             TIMED_OUT.
43:  *   'close'   REAL SERVER CLOSE: the harness sends, on the target topic only,
44:  *             an `access_token` push with an invalid token; local Realtime
45:  *             answers with its own `system` error and `phx_close` and ends the
46:  *             server channel. The client sees CLOSED and, being closed rather
47:  *             than errored, the SDK never rejoins it (terminal). A later join
48:  *             attempt by the application is forwarded and its reply withheld
49:  *             (TIMED_OUT), so the stream stays unavailable until restore.
50:  * A fault armed while the stream has no joined channel only shapes its next
51:  * joins (e.g. 'timeout' before a conversation is opened gives a pure TIMED_OUT).
52:  *
53:  * Statuses are read from the application's own subscribe callbacks: the
54:  * messaging debug traces `[useMessageSubscription|useConversationRealtime|
55:  * useConversationTyping:trace] status` (enabled by the `vo:debug:messaging`
56:  * flag this harness sets) and Presence's `presence-observability-v1`
57:  * subscription events.
58:  *
59:  * API (fixtures/messaging-phase5-faults.ts → `realtimeFaults.attach(device)`):
60:  *   fail(stream, kind)          arm + kick; resolves with { mark, kicked }
61:  *   restore(stream?)            stop shaping (all streams when omitted)
62:  *   status(stream)              last status reported by the app callback
63:  *   statuses(stream, {since})   status history ({ seq, at, status, … })
64:  *   waitForStatus(stream, status, {since, timeout})
65:  *   waitForReady(stream)        SUBSCRIBED, joined, and (postgres streams)
66:  *                               server-confirmed changes stream
67:  *   frames({stream, since, …})  frame log of the classified topics
68:  *   mark()                      sequence point shared by frames and statuses
69:  *   connections()               routed sockets (open/closed)
70:  *   watchPage(page)             also record another tab's callbacks
71:  *   redeliver(seq)              sends a passed server→page postgres_changes
72:  *                               frame again, unchanged, on its socket (a
73:  *                               duplicated delivery of a real frame)
74:  *   dropConnection()            T13: a whole Realtime connection drop — every
75:  *                               routed socket of the context is closed (both
76:  *                               ways) and every reconnect attempt is closed
77:  *                               at once until restoreConnection(); all
78:  *                               channels (Presence included) see their socket
79:  *                               go, as on a real network drop
80:  *   retries(stream, {since})    T13: the app's own rejoin decisions
81:  *                               (`[<hook>] retry` traces: status, delay, attempt)
82:  * Install before the page creates its Realtime socket (attach reloads the
83:  * page by default). Do not combine with drawer-helpers'
84:  * controlRealtimeConnection on the same page: Playwright applies only one
85:  * WebSocket route per socket.
86:  */
87: 
88: export const MESSAGING_REALTIME_STREAMS = ['messages', 'list', 'typing'] as const;
89: export type MessagingRealtimeStream = (typeof MESSAGING_REALTIME_STREAMS)[number];
90: export type ObservedRealtimeStream = MessagingRealtimeStream | 'presence';
91: export type RealtimeFaultKind = 'error' | 'timeout' | 'close';
92: 
93: /** The subscribe-callback status each fault class produces on the target. */
94: export const FAULT_STATUS: Record<RealtimeFaultKind, 'CHANNEL_ERROR' | 'TIMED_OUT' | 'CLOSED'> = {
95:   error: 'CHANNEL_ERROR',
96:   timeout: 'TIMED_OUT',
97:   close: 'CLOSED',
98: };
99: 
100: export const MESSAGING_DEBUG_FLAG_KEY = 'vo:debug:messaging';
101: /** Token the harness pushes to close a channel through the server (never a JWT). */
102: const INVALID_ACCESS_TOKEN = 't25-invalid-access-token';
103: const ERROR_REPLY_REASON = 't25 injected stream fault';
104: 
105: const TYPING_TOPIC = 
/^realtime:conversation:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(:typing)?$/i;
106: const PRESENCE_TOPIC = 
/^realtime:company:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}:presence$/i;
107: 
108: export function classifyRealtimeTopic(topic: string): ObservedRealtimeStream | null {
109:   if (topic.startsWith('realtime:messaging-db-changes:')) return 'messages';
110:   if (topic === 'realtime:conversations-changes' || topic.startsWith('realtime:conversations-changes:')) return 
'list';
111:   if (TYPING_TOPIC.test(topic)) return 'typing';
112:   if (PRESENCE_TOPIC.test(topic)) return 'presence';
113:   return null;
114: }
115: 
116: const isMessagingStream = (stream: ObservedRealtimeStream): stream is MessagingRealtimeStream =>
117:   stream !== 'presence';
118: 
119: /** Streams whose server confirms the postgres_changes stream after the join. */
120: const POSTGRES_STREAMS: ReadonlySet<ObservedRealtimeStream> = new Set(['messages', 'list', 'presence']);
121: 
122: // ---------------------------------------------------------------------------
123: // Phoenix frames (realtime-js protocol 2.0.0: JSON arrays, binary broadcasts)
124: // ---------------------------------------------------------------------------
125: 
126: interface PhoenixFrame {
127:   joinRef: string | null;
128:   ref: string | null;
129:   topic: string;
130:   event: string;
131:   payload: unknown;
132:   binary: boolean;
133: }
134: 
135: type FrameDirection = 'in' | 'out';
136: 
137: function decodeFrame(message: string | Buffer, direction: FrameDirection): PhoenixFrame | null {
138:   try {
139:     return decodeFrameUnsafe(message, direction);
140:   } catch {
141:     return null;
142:   }
143: }
144: 
145: function decodeFrameUnsafe(message: string | Buffer, direction: FrameDirection): PhoenixFrame | null {
146:   if (typeof message === 'string') {
147:     try {
148:       const frame: unknown = JSON.parse(message);
149:       if (Array.isArray(frame) && frame.length === 5 && typeof frame[2] === 'string' && typeof frame[3] === 
'string') {
150:         const [joinRef, ref, topic, event, payload] = frame as [unknown, unknown, string, string, unknown];
151:         return {
152:           joinRef: typeof joinRef === 'string' ? joinRef : null,
153:           ref: typeof ref === 'string' ? ref : null,
154:           topic,
155:           event,
156:           payload,
157:           binary: false,
158:         };
159:       }
160:     } catch {
161:       // Not a Phoenix JSON frame.
162:     }
163:     return null;
164:   }
165:   if (message.length < 1) return null;
166:   const kind = message.readUInt8(0);
167:   // Server → client user broadcast: kind 4, [topic, event, meta] sizes, encoding.
168:   if (direction === 'in' && kind === 4 && message.length >= 5) {
169:     const topicSize = message.readUInt8(1);
170:     const eventSize = message.readUInt8(2);
171:     const offset = 5;
172:     return {
173:       joinRef: null,
174:       ref: null,
175:       topic: message.toString('utf8', offset, offset + topicSize),
176:       event: 'broadcast',
177:       payload: { event: message.toString('utf8', offset + topicSize, offset + topicSize + eventSize) },
178:       binary: true,
179:     };
180:   }
181:   // Client → server user broadcast push: kind 3, [joinRef, ref, topic, event, meta] sizes, encoding.
182:   if (direction === 'out' && kind === 3 && message.length >= 7) {
183:     const joinRefSize = message.readUInt8(1);
184:     const refSize = message.readUInt8(2);
185:     const topicSize = message.readUInt8(3);
250:   direction: FrameDirection;
251:   stream: ObservedRealtimeStream;
252:   topic: string;
253:   event: string;
254:   joinRef: string | null;
255:   ref: string | null;
256:   action: FrameAction;
257:   detail: FrameDetail;
258: }
259: 
260: export interface StatusRecord {
261:   seq: number;
262:   at: number;
263:   stream: ObservedRealtimeStream;
264:   status: string;
265:   page: string;
266:   /** typing: the conversation of the channel. */
267:   conversationId?: string;
268: }
269: 
270: export interface RetryRecord {
271:   seq: number;
272:   at: number;
273:   stream: MessagingRealtimeStream;
274:   /** The failure status that led to the retry. */
275:   status: string;
276:   delay: number;
277:   attempt: number;
278:   page: string;
279: }
280: 
281: export interface ConnectionRecord {
282:   id: number;
283:   openedSeq: number;
284:   closedSeq: number | null;
285: }
286: 
287: export interface FaultKick {
288:   /** Sequence point taken just before the fault was armed. */
289:   mark: number;
290:   /** Joined channels of the stream that were kicked. */
291:   kicked: number;
292: }
293: 
294: export interface FrameFilter {
295:   stream?: ObservedRealtimeStream;
296:   since?: number;
297:   direction?: FrameDirection;
298:   action?: FrameAction;
299:   events?: readonly string[];
300: }
301: 
302: export interface RealtimeFaultController {
303:   fail(stream: MessagingRealtimeStream, kind: RealtimeFaultKind): Promise<FaultKick>;
304:   restore(stream?: MessagingRealtimeStream): number;
305:   activeFaults(): Array<{ stream: MessagingRealtimeStream; kind: RealtimeFaultKind; joinAttempts: number }>;
306:   mark(): number;
307:   status(stream: ObservedRealtimeStream): string | null;
308:   statuses(stream: ObservedRealtimeStream, options?: { since?: number }): StatusRecord[];
309:   waitForStatus(
310:     stream: ObservedRealtimeStream,
311:     status: string,
312:     options?: { since?: number; timeout?: number },
313:   ): Promise<StatusRecord>;
314:   waitForReady(stream: ObservedRealtimeStream, options?: { timeout?: number }): Promise<void>;
315:   frames(filter?: FrameFilter): FrameRecord[];
316:   /** Joined topics of the stream on the open sockets. */
317:   joinedTopics(stream: ObservedRealtimeStream): string[];
318:   connections(): ConnectionRecord[];
319:   /** Waits for console status values still being read from the page. */
320:   settle(): Promise<void>;
321:   watchPage(page: Page, label: string): void;
322:   /**
323:    * Sends the passed server→page postgres_changes frame `seq` again, unchanged,
324:    * on the same socket (same topic and payload) — a duplicated delivery of a
325:    * real frame. Throws if that socket is closed or the frame's channel is no
326:    * longer joined or was rejoined since. Returns the logged redelivery.
327:    */
328:   redeliver(seq: number): FrameRecord;
329:   /** Refused non-loopback Realtime hosts and frames the harness failed to handle (must stay empty). */
330:   violations(): string[];
331:   /**
332:    * T13: drops the whole Realtime connection: closes every open routed socket
333:    * (page and server sides) and closes each new connection attempt at once
334:    * until restoreConnection(). Returns a sequence mark taken before the drop.
335:    */
336:   dropConnection(): Promise<number>;
337:   /** T13: lets the next connection attempt through again. Returns a sequence mark. */
338:   restoreConnection(): number;
339:   /** T13: connection attempts closed while dropped. */
340:   refusedConnections(): number;
341:   /** T13: the application's rejoin decisions of a stream (its `retry` traces). */
342:   retries(stream: MessagingRealtimeStream, options?: { since?: number }): RetryRecord[];
343: }
