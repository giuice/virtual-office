116: const readBy = (page: Page, messageId: string) => page.getByTestId(`read-by-${messageId}`);
117: 
118: interface StateCheck {
119:   selector: string;
120:   /** Text the single matching element must contain. */
121:   text?: string;
122: }
123: 
124: /**
125:  * Records, in the page, every moment one of `checks` does not hold (its
126:  * selector must match exactly one element, containing `text` when given) — a
127:  * newer state lost even briefly, a page of history gone, or a duplicated bubble.
128:  */
129: async function watchFeedState(page: Page, checks: readonly StateCheck[]): Promise<void> {
130:   await page.evaluate((tracked: StateCheck[]) => {
131:     const violations: Array<{ at: number; selector: string; count: number; text: string | null }> = [];
132:     const evaluate = () => {
133:       for (const check of tracked) {
134:         const elements = document.querySelectorAll(check.selector);
135:         const text = elements[0]?.textContent ?? null;
136:         if (elements.length !== 1 || (check.text !== undefined && !(text ?? '').includes(check.text))) {
137:           violations.push({ at: Date.now(), selector: check.selector, count: elements.length, text });
138:         }
139:       }
140:     };
141:     (window as unknown as { __t14Violations?: typeof violations }).__t14Violations = violations;
142:     evaluate();
143:     new MutationObserver(evaluate).observe(document.body, {
144:       subtree: true,
145:       childList: true,
146:       characterData: true,
147:       attributes: true,
148:     });
149:   }, [...checks]);
150: }
151: 
152: const readFeedViolations = (page: Page) =>
153:   page.evaluate(() => (window as unknown as { __t14Violations: unknown[] }).__t14Violations);
