56:     const isPoll = url.searchParams.get('source') === 'poll';
57:     const at = Date.now();
58:     if (url.pathname === '/api/messages/get' && isPoll) {
59:       requests.push({ kind: 'feed', at, roundStart: !url.searchParams.has('cursorBefore'), url: url.href });
60:     } else if (url.pathname === '/api/conversations/get' && isPoll) {
61:       requests.push({ kind: 'list', at, roundStart: true, url: url.href });
62:     } else if (/^\/api\/messages\/[^/]+\/readers$/.test(url.pathname)) {
63:       requests.push({ kind: 'readers', at, roundStart: true, url: url.href });
64:     }
65:   });
66:   return requests;
