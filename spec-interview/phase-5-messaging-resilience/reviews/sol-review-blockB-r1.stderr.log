496:   test('FR-002 (T13): the messages stream recovering drains a waiting outbox item at once, before its own 
backoff', async ({
497:     phase5World,
498:     openDevice,
499:     realtimeFaults,
500:   }, testInfo) => {
501:     const { directId } = phase5World.conversations;
502:     const a = await openDevice('A');
503:     // The page reloads under the harness (its socket is created through it).
504:     const harness = await realtimeFaults.attach(a);
505:     await openConversation(a.page, directId);
506:     await harness.waitForReady('messages');
507:     const calls = trackOutboxCalls(a.page);
508:     // A's create and fence requests fail in transit (the browser stays online).
509:     let failInTransit = true;
510:     await a.context.route(/\/api\/messages\/(create|fence)$/, async (route: Route) => {
511:       if (failInTransit) await route.abort('failed');
512:       else await route.continue();
513:     });
514: 
515:     const fault = await harness.fail('messages', 'error');
516:     await harness.waitForStatus('messages', 'CHANNEL_ERROR', { since: fault.mark });
517:     const text = `t13 drain on recovery ${randomUUID()}`;
518:     await sendFromComposer(a.page, text);
519:     // The item's own retries back off: 1, 2, 4, 8 s, then 15 s after the fifth failure.
520:     await expect.poll(() => calls.filter((call) => call.failure).length, { timeout: 30_000 
}).toBeGreaterThanOrEqual(5);
521:     const failed = calls.filter((call) => call.failure);
522:     const lastFailedAt = failed[failed.length - 1].startedAt;
523:     const lastGap = lastFailedAt - failed[failed.length - 2].startedAt;
524:     expect(lastGap, 'the item is backing off').toBeGreaterThanOrEqual(6_000);
525:     failInTransit = false;
526: 
527:     const restoreMark = harness.restore('messages');
528:     await harness.waitForReady('messages', { timeout: RECOVERY_TIMEOUT_MS });
529:     const subscribed = harness.statuses('messages', { since: restoreMark }).find((record) => record.status === 
'SUBSCRIBED');
530:     expect(subscribed).toBeDefined();
531:     await expect.poll(async () => (await storedWithTexts(directId, [text])).length, { timeout: STEP_TIMEOUT_MS 
}).toBe(1);
532:     const firstOk = calls.find((call) => !call.failure && call.startedAt > lastFailedAt);
