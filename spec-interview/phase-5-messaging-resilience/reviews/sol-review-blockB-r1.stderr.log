78: /** Samples the absence of a locator for a window (it must never be visible). */
79: async function expectNeverVisible(page: Page, selector: ReturnType<Page['getByText']>, windowMs: number, what: 
string) {
80:   const until = Date.now() + windowMs;
81:   while (Date.now() < until) {
82:     expect(await selector.isVisible(), what).toBe(false);
83:     await page.waitForTimeout(200);
84:   }
85: }
