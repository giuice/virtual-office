126: /** min(cap, round(base · 1.5^(n − 1))) for the n-th failure of an unhealthy period (FR-015 capped exponential 
backoff). */
127: const expectedDelay = (attempt: number) => Math.min(RETRY_MAX_MS, Math.round(RETRY_BASE_MS * 1.5 ** (attempt - 
1)));
