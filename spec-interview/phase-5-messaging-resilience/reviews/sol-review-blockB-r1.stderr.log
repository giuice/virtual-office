170: /** Opens the drawer on the conversation list and waits for the conversation's row. */
171: async function openList(device: Phase5Device, conversationId: string): Promise<void> {
172:   if (!device.page.url().includes('/floor-plan')) await device.page.goto('/floor-plan');
173:   await openDrawer(device.page);
174:   await expect(device.page.locator(`[data-testid="conversation-item-${conversationId}"]`)).toBeVisible({
175:     timeout: STEP_TIMEOUT_MS,
176:   });
177: }
