67: /** When the indicator disappeared at or after `since` (page clock = this machine's clock). */
68: async function goneAt(page: Page, since: number): Promise<number> {
69:   let at = -1;
70:   await expect
71:     .poll(
72:       async () => {
73:         const log = await readIndicatorLog(page);
74:         const current = log[log.length - 1];
75:         if (current?.text !== null) return false;
76:         // The last transition to absent (it may have been absent already).
77:         at = Math.max(since, current.at);
78:         return true;
79:       },
80:       { timeout: GONE_WITHIN_MS + 5_000, message: 'typing indicator disappears' },
81:     )
82:     .toBe(true);
83:   return at;
84: }
