129: /**
130:  * The application's retries of one unhealthy period: one per failed channel,
131:  * delays growing exponentially (×1.5) from 250 ms and never above the 5 s cap, each
132:  * on a new topic (the distinct topics joined since the fault are one per
133:  * retry that ran).
134:  */
135: function expectCappedBackoff(
136:   harness: RealtimeFaultController,
137:   stream: MessagingRealtimeStream,
138:   since: number,
139:   until: number,
140: ): RetryRecord[] {
141:   const retries = harness.retries(stream, { since }).filter((record) => record.seq < until);
142:   expect(retries.length, `${stream}: the application retried`).toBeGreaterThan(0);
143:   // Consecutive failures of one unhealthy period (an earlier failure within
144:   // 30 s of stability would start the count above 1), each delay per formula.
145:   const first = retries[0].attempt;
146:   expect(
147:     retries.map((record) => [record.attempt, record.delay]),
148:     `${stream}: increasing, capped delays`,
149:   ).toEqual(retries.map((_record, index) => [first + index, expectedDelay(first + index)]));
150:   const joinedTopics = new Set(
151:     harness
152:       .frames({ stream, since, direction: 'out', events: ['phx_join'] })
153:       .filter((frame) => frame.seq < until)
154:       .map((frame) => frame.topic),
155:   );
156:   // Every retry joins one new topic; the last one scheduled may be overtaken
157:   // by the SDK's own rejoin of the current channel (then it never runs).
158:   expect(joinedTopics.size, `${stream}: one new topic per retry`).toBeLessThanOrEqual(retries.length);
159:   expect(joinedTopics.size, `${stream}: one new topic per retry`).toBeGreaterThanOrEqual(retries.length - 1);
160:   return retries;
161: }
