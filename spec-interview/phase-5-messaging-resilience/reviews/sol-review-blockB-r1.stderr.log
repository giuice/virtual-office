937:           this.scheduleRetry(conversationId);
938:           return;
939:         }
940:         this.trace('attempt', { conversationId, generation: item.attemptGeneration, outcome: outcome.kind });
941:         if (outcome.kind === 'delivered') {
942:           const { message } = outcome;
943:           this.confirmDelivered(item);
944:           this.confirmedNotShown.add(item.clientMessageId);
945:           showConfirmed = () => {
946:             this.confirmedNotShown.delete(item.clientMessageId);
947:             showConfirmedOutboxMessage(this.queryClient, this.ownerId, conversationId, item.clientMessageId, 
message);
948:           };
