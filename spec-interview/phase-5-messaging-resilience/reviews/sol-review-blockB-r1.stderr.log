1: // src/lib/messaging/polling-fallback.ts
2: // Phase 5 T14 (FR-016, BR-012, AC-016, AC-048): what one polling-fallback
3: // round fetches while a required messaging Realtime stream is unhealthy, and
4: // how its results reach the caches without ever replacing newer state. The
5: // schedule (unhealthy > 30 s, visible tab, every 15 s) lives in
6: // useMessagingPollingFallback.
7: import type { QueryClient, QueryKey } from '@tanstack/react-query';
8: 
9: import { messagingApi } from '@/lib/messaging-api';
10: import {
11:   isMessageDeleted,
12:   keepMessageThroughInflightFetch,
13:   mergePolledMessages,
14:   type MessagesInfiniteData,
15: } from '@/lib/messaging/message-cache';
16: import type { Message } from '@/types/messaging';
17: 
18: /** Polling starts once a required stream has been unhealthy this long (BR-012). */
19: export const POLL_AFTER_UNHEALTHY_MS = 30_000;
20: /** Interval between polling rounds (BR-012). */
21: export const POLL_INTERVAL_MS = 15_000;
22: /** Messages per poll request (the route's maximum). */
23: const POLL_PAGE_SIZE = 100;
24: /** Bound on the requests of one feed poll (POLL_PAGE_SIZE messages each). */
25: const MAX_FEED_POLL_REQUESTS = 10;
26: 
27: type Snapshot<T> = { data: T | undefined; dataUpdatedAt: number };
28: 
29: const snapshotOf = <T>(queryClient: QueryClient, queryKey: QueryKey): Snapshot<T> | null => {
30:   const query = queryClient.getQueryCache().find<T>({ queryKey, exact: true });
31:   return query ? { data: query.state.data, dataUpdatedAt: query.state.dataUpdatedAt } : null;
32: };
33: 
34: /**
35:  * Nothing wrote the query since `start` (no Realtime update, fetch, or local
36:  * change) and no fetch of its own is running (which would replace whatever
37:  * is written now): a result read by the server after `start` is the newest
38:  * state the query can hold.
39:  */
40: const unchangedSince = <T>(queryClient: QueryClient, queryKey: QueryKey, start: Snapshot<T>): boolean => {
41:   const query = queryClient.getQueryCache().find<T>({ queryKey, exact: true });
42:   return Boolean(
43:     query &&
44:       query.state.data === start.data &&
45:       query.state.dataUpdatedAt === start.dataUpdatedAt &&
46:       query.state.fetchStatus !== 'fetching'
47:   );
48: };
49: 
50: const messageTime = (message: Message): number => new Date(message.timestamp).getTime();
51: 
52: /**
53:  * Polls the open conversation's feed: its new messages and the current state
54:  * (receipt summaries, reactions, attachments) of its loaded messages, read
55:  * newest first until the oldest loaded message is covered. Merged by
56:  * mergePolledMessages: new messages are added once; loaded messages take the
57:  * polled state only when the feed was not written while the poll ran (a
58:  * Realtime event, a refetch or a local change that lands first is newer and
59:  * wins; the next round catches up). A feed never loaded is left to its own
60:  * first fetch.
61:  */
62: export async function pollConversationFeed(
63:   queryClient: QueryClient,
64:   conversationId: string,
65:   isCurrent: () => boolean
66: ): Promise<void> {
67:   const queryKey = ['messages', conversationId] as const;
68:   const start = snapshotOf<MessagesInfiniteData>(queryClient, queryKey);
69:   const startData = start?.data;
70:   if (!start || !startData?.pages?.length) return;
71: 
72:   const cachedAtStart = new Set<string>();
73:   let oldestLoaded: Message | undefined;
74:   for (const page of startData.pages) {
75:     for (const message of page.messages) {
76:       cachedAtStart.add(message.id);
77:       if (!oldestLoaded || messageTime(message) < messageTime(oldestLoaded)) oldestLoaded = message;
78:     }
79:   }
80: 
81:   const polled: Message[] = [];
82:   let cursorBefore: string | undefined;
83:   let moreOlder = false;
84:   for (let request = 0; request < MAX_FEED_POLL_REQUESTS; request += 1) {
85:     const page = await messagingApi.getMessages(conversationId, {
86:       limit: POLL_PAGE_SIZE,
87:       cursorBefore,
88:       source: 'poll',
89:     });
90:     if (!isCurrent()) return;
91:     polled.unshift(...page.messages);
92:     moreOlder = Boolean(page.hasMoreOlder && page.nextCursorBefore);
93:     const oldestPolled = page.messages[0];
94:     if (!moreOlder || !oldestLoaded || (oldestPolled && messageTime(oldestPolled) <= messageTime(oldestLoaded))) {
95:       break;
96:     }
97:     cursorBefore = page.nextCursorBefore;
98:   }
99: 
100:   // More new messages than the bounded read reaches: merging them would leave
101:   // a hole between them and the loaded feed. The feed refetches instead
102:   // (without cancelling a fetch in flight).
103:   if (moreOlder && !polled.some((message) => cachedAtStart.has(message.id))) {
104:     void queryClient.invalidateQueries({ queryKey, exact: true }, { cancelRefetch: false });
105:     return;
106:   }
107: 
108:   const current = queryClient.getQueryData<MessagesInfiniteData>(queryKey);
109:   if (!current?.pages?.length) return;
110:   const merge = mergePolledMessages(current, polled, {
111:     replaceExisting: unchangedSince(queryClient, queryKey, start),
112:     cachedAtStart,
113:     isDeleted: (messageId) => isMessageDeleted(queryClient, messageId),
114:   });
115:   if (!merge.changed) return;
116:   queryClient.setQueryData<MessagesInfiniteData>(queryKey, merge.data);
117:   // A fetch of the feed's own already in flight replaces the pages when it
118:   // settles; the added messages are merged again after it.
119:   for (const message of merge.added) keepMessageThroughInflightFetch(queryClient, conversationId, message);
120: }
121: 
122: /**
123:  * Polls a whole-result query (the conversation list) with `fetcher` and
124:  * stores the result only if nothing wrote the query while the poll ran: a
125:  * Realtime update, local change or fetch of its own that lands first is at
126:  * least as new and wins (the next round catches up). Returns whether the
127:  * result was stored.
128:  */
129: export async function pollQueryIfUnchanged<T>(
130:   queryClient: QueryClient,
131:   queryKey: QueryKey,
132:   fetcher: () => Promise<T>,
133:   isCurrent: () => boolean
134: ): Promise<boolean> {
135:   const start = snapshotOf<T>(queryClient, queryKey);
136:   if (!start || start.data === undefined) return false;
137:   const result = await fetcher();
138:   if (!isCurrent() || !unchangedSince(queryClient, queryKey, start)) return false;
139:   queryClient.setQueryData<T>(queryKey, result);
140:   return true;
141: }

