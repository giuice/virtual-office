702:   private onConsole(message: ConsoleMessage, label: string): void {
703:     const text = message.text();
704:     const retry = RETRY_TRACE.exec(text);
705:     if (retry) {
706:       const seq = this.next();
707:       const at = Date.now();
708:       const stream = TRACE_STREAM[retry[1]];
709:       const read = (async () => {
710:         const value = (await message.args()[1]?.jsonValue()) as
711:           | { status?: unknown; delay?: unknown; attempt?: unknown }
712:           | undefined;
713:         if (typeof value?.delay !== 'number' || typeof value.status !== 'string') return;
714:         this.retryLog.push({
715:           seq,
716:           at,
717:           stream,
718:           status: value.status,
719:           delay: value.delay,
720:           attempt: typeof value.attempt === 'number' ? value.attempt : -1,
721:           page: label,
722:         });
723:       })().catch(() => {});
724:       this.pendingStatus.add(read);
725:       void read.finally(() => this.pendingStatus.delete(read));
726:       return;
727:     }
728:     const trace = STATUS_TRACE.exec(text);
729:     if (trace) {
730:       const seq = this.next();
731:       const at = Date.now();
732:       const stream = TRACE_STREAM[trace[1]];
733:       const read = (async () => {
734:         const value = (await message.args()[1]?.jsonValue()) as { status?: unknown; conversationId?: unknown } | 
undefined;
735:         if (typeof value?.status !== 'string') return;
736:         this.statusLog.push({
737:           seq,
738:           at,
739:           stream,
740:           status: value.status,
741:           page: label,
742:           ...(typeof value.conversationId === 'string' ? { conversationId: value.conversationId } : {}),
743:         });
744:       })().catch(() => {});
745:       this.pendingStatus.add(read);
746:       void read.finally(() => this.pendingStatus.delete(read));
747:       return;
748:     }
749:     if (text.startsWith(PRESENCE_EVENT_PREFIX)) {
750:       try {
751:         const event = JSON.parse(text) as { category?: unknown; action?: unknown; resultCode?: unknown };
752:         if (event.category === 'realtime' && event.action === 'subscription' && typeof event.resultCode === 
'string') {
753:           this.statusLog.push({ seq: this.next(), at: Date.now(), stream: 'presence', status: event.resultCode, 
page: label });
754:         }
755:       } catch {
756:         // Not a complete observability line.
757:       }
758:     }
759:   }
