389: class FaultHarness implements RealtimeFaultController {
390:   private seq = 0;
391:   private readonly frameLog: FrameRecord[] = [];
392:   private readonly statusLog: StatusRecord[] = [];
393:   private readonly retryLog: RetryRecord[] = [];
394:   private dropped = false;
395:   private refusedWhileDropped = 0;
396:   private readonly pendingStatus = new Set<Promise<void>>();
397:   private readonly faults = new Map<MessagingRealtimeStream, ActiveFault>();
398:   private readonly routed: RoutedConnection[] = [];
399:   private readonly refused: string[] = [];
400:   private readonly internalErrors: string[] = [];
401:   private readonly harnessRefs = new Set<string>();
402:   private harnessRefCounter = 0;
403:   /** Raw passed postgres_changes frames by log seq (for redeliver). */
404:   private readonly passedChanges = new Map<number, { connection: RoutedConnection; message: string | Buffer }>();
405: 
406:   next(): number {
407:     this.seq += 1;
408:     return this.seq;
409:   }
410: 
411:   mark(): number {
412:     return this.next();
413:   }
414: 
415:   // --- routing -------------------------------------------------------------
416: 
417:   route(ws: WebSocketRoute): void {
418:     if (!isLoopbackUrl(ws.url())) {
419:       this.refused.push(new URL(ws.url()).host);
420:       void ws.close({ code: 4001, reason: 'test: only local Realtime is allowed' });
421:       return;
422:     }
423:     if (this.dropped) {
424:       // T13 whole-connection drop: the attempt never reaches the server.
425:       this.refusedWhileDropped += 1;
426:       void ws.close({ code: 4000, reason: 'test: Realtime connection dropped' });
427:       return;
428:     }
429:     const server = ws.connectToServer();
430:     const connection: RoutedConnection = {
431:       id: this.routed.length + 1,
432:       page: ws,
433:       server,
434:       topics: new Map(),
435:       record: { id: this.routed.length + 1, openedSeq: this.next(), closedSeq: null },
436:     };
437:     this.routed.push(connection);
438:     ws.onMessage((message) => this.fromPage(connection, message));
439:     server.onMessage((message) => this.fromServer(connection, message));
440:     // Setting close handlers disables Playwright's automatic forwarding:
441:     // forward the close both ways, unchanged.
442:     ws.onClose((code, reason) => {
443:       this.closeConnection(connection);
444:       void server.close({ code, reason });
445:     });
446:     server.onClose((code, reason) => {
447:       this.closeConnection(connection);
448:       void ws.close({ code, reason });
449:     });
450:   }
451: 
452:   private closeConnection(connection: RoutedConnection): void {
453:     if (connection.record.closedSeq === null) {
454:       connection.record.closedSeq = this.next();
455:     }
456:   }
457: 
458:   private topicState(connection: RoutedConnection, topic: string, stream: ObservedRealtimeStream): TopicState {
459:     let state = connection.topics.get(topic);
460:     if (!state) {
461:       state = { stream, joinRef: null, joined: false, confirmedJoinRef: null, closingJoinRef: null, leftJoinRef: 
null };
462:       connection.topics.set(topic, state);
463:     }
464:     return state;
465:   }
466: 
467:   private log(
468:     connection: RoutedConnection,
469:     direction: FrameDirection,
470:     stream: ObservedRealtimeStream,
471:     frame: PhoenixFrame,
472:     action: FrameAction,
473:   ): number {
474:     const seq = this.next();
475:     this.frameLog.push({
476:       seq,
477:       at: Date.now(),
478:       connection: connection.id,
479:       direction,
480:       stream,
481:       topic: frame.topic,
482:       event: frame.event,
483:       joinRef: frame.joinRef,
484:       ref: frame.ref,
485:       action,
486:       detail: summarize(frame),
487:     });
488:     return seq;
489:   }
490: 
491:   /** Page → server: always forwarded unchanged; joins are tracked. */
492:   private fromPage(connection: RoutedConnection, message: string | Buffer): void {
493:     connection.server.send(message);
494:     try {
495:       this.trackPageFrame(connection, message);
496:     } catch (error) {
497:       this.internalErrors.push(`page frame: ${String(error)}`);
498:     }
499:   }
500: 
501:   private trackPageFrame(connection: RoutedConnection, message: string | Buffer): void {
502:     const frame = decodeFrame(message, 'out');
503:     const stream = frame ? classifyRealtimeTopic(frame.topic) : null;
504:     if (!frame || !stream) return;
505:     this.log(connection, 'out', stream, frame, 'pass');
506:     const state = this.topicState(connection, frame.topic, stream);
507:     if (frame.event === 'phx_join') {
508:       state.joinRef = frame.ref;
509:       state.joined = false;
510:       state.confirmedJoinRef = null;
511:       state.closingJoinRef = null;
512:       state.leftJoinRef = null;
513:       const fault = isMessagingStream(stream) ? this.faults.get(stream) : undefined;
514:       if (fault) {
515:         fault.joinAttempts += 1;
516:         if (fault.kind === 'error') {
517:           this.injectToPage(connection, stream, [
518:             frame.ref,
519:             frame.ref,
520:             frame.topic,
521:             'phx_reply',
522:             { status: 'error', response: { reason: ERROR_REPLY_REASON } },
523:           ]);
524:         }
525:         // 'timeout' and 'close': the server's reply is withheld (fromServer).
526:       }
527:     } else if (frame.event === 'phx_leave' && frame.joinRef === state.joinRef) {
528:       state.joined = false;
529:       state.leftJoinRef = frame.joinRef;
530:     }
531:   }
532: 
533:   /** Server → page: forwarded unless it belongs to a faulted stream. */
534:   private fromServer(connection: RoutedConnection, message: string | Buffer): void {
535:     let forward = true;
536:     try {
537:       forward = this.shapeServerFrame(connection, message);
538:     } catch (error) {
539:       // Fail open: a frame the harness cannot handle reaches the page unchanged.
540:       this.internalErrors.push(`server frame: ${String(error)}`);
541:     }
542:     if (forward) connection.page.send(message);
543:   }
544: 
545:   /** Returns whether the server frame is forwarded to the page. */
546:   private shapeServerFrame(connection: RoutedConnection, message: string | Buffer): boolean {
547:     const frame = decodeFrame(message, 'in');
548:     const stream = frame ? classifyRealtimeTopic(frame.topic) : null;
549:     if (!frame || !stream) return true;
550:     if (frame.event === 'phx_reply' && frame.ref !== null && this.harnessRefs.has(frame.ref)) {
551:       // Reply to the harness's own push: never the page's business.
552:       this.log(connection, 'in', stream, frame, 'drop');
553:       return false;
554:     }
555:     const state = this.topicState(connection, frame.topic, stream);
556:     const fault = isMessagingStream(stream) ? this.faults.get(stream) : undefined;
557:     const isServerClose =
558:       state.closingJoinRef !== null
559:       && frame.joinRef === state.closingJoinRef
560:       && (frame.event === 'phx_close' || frame.event === 'system');
561:     if (fault && !isServerClose) {
562:       this.log(connection, 'in', stream, frame, 'drop');
563:       return false;
564:     }
565:     const sameJoin = frame.joinRef !== null && frame.joinRef === state.joinRef;
566:     if (frame.event === 'phx_reply' && frame.ref !== null && frame.ref === state.joinRef) {
567:       state.joined = (frame.payload as { status?: unknown } | null)?.status === 'ok' && state.leftJoinRef !== 
frame.ref;
568:     } else if ((frame.event === 'phx_close' || frame.event === 'phx_error') && sameJoin) {
569:       state.joined = false;
570:     } else if (frame.event === 'system' && sameJoin) {
571:       const body = (frame.payload ?? {}) as { extension?: unknown; status?: unknown };
572:       if (body.extension === 'postgres_changes' && body.status === 'ok') {
573:         state.confirmedJoinRef = frame.joinRef;
574:       }
575:     }
576:     const seq = this.log(connection, 'in', stream, frame, 'pass');
577:     if (frame.event === 'postgres_changes') {
578:       this.passedChanges.set(seq, { connection, message });
579:     }
580:     return true;
581:   }
582: 
583:   redeliver(seq: number): FrameRecord {
584:     const passed = this.passedChanges.get(seq);
585:     const original = this.frameLog.find((record) => record.seq === seq);
586:     if (!passed || !original) {
587:       throw new Error(`No passed postgres_changes frame #${seq} to redeliver.`);
588:     }
589:     const { connection, message } = passed;
590:     if (connection.record.closedSeq !== null) {
591:       throw new Error(`Frame #${seq} came on socket ${connection.id}, which is closed.`);
592:     }
593:     const state = connection.topics.get(original.topic);
594:     // postgres_changes frames carry no join ref; the topic's join must be the
595:     // one that was current when the frame passed (no rejoin since).
596:     const rejoined = this.frameLog.some(
597:       (record) => record.seq > seq && record.connection === connection.id && record.topic === original.topic
598:         && record.direction === 'out' && record.event === 'phx_join',
599:     );
600:     if (!state?.joined || rejoined) {
601:       throw new Error(`Frame #${seq}'s channel ${original.topic} is no longer the same joined channel.`);
602:     }
603:     connection.page.send(message);
604:     const frame = decodeFrame(message, 'in') as PhoenixFrame;
605:     const redeliveredSeq = this.log(connection, 'in', original.stream, frame, 'redeliver');
606:     return this.frameLog.find((record) => record.seq === redeliveredSeq) as FrameRecord;
607:   }
