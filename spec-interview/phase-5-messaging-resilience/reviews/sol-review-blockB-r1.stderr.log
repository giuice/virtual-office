22: // Format message timestamp
23: const formatMessageTime = (timestamp: Date) => {
24:   if (!timestamp) return '';
25:   const date = new Date(timestamp);
26:   // An invalid date would make date-fns throw and unmount the feed.
27:   if (Number.isNaN(date.getTime())) return '';
28:   return formatDistanceToNow(date, {
29:     addSuffix: true
30:   });
31: };
32: 
33: // Get message status icon
34: // Get message status icon
35: const getMessageStatusIcon = (status: MessageStatus) => {
36:   switch (status) {
37:     case MessageStatus.SENT:
38:       return <CheckCheck className="size-4 text-gray-400" />;
39:     case MessageStatus.DELIVERED:
40:       return <CheckCheck className="size-4 text-blue-500" />;
41:     case MessageStatus.READ:
42:       return <CheckCheck className="size-4 text-green-500" />;
43:     case MessageStatus.FAILED:
44:       return <AlertCircle className="size-4 text-red-500" />;
45:     default:
46:       return null;
47:   }
48: };
