172:   let channel: RealtimeChannel | null = null;
173:   let generation = 0;
174:   let retryTimer: ReturnType<typeof setTimeout> | null = null;
175:   let stableTimer: ReturnType<typeof setTimeout> | null = null;
176:   let state: MessagingStreamHealth = {
177:     status: null,
178:     healthy: false,
179:     unhealthySince: Date.now(),
180:     failures: 0,
181:     lastRetryDelayMs: null,
182:     recoveries: 0,
183:   };
184:   /** A failure happened since the stream was last healthy (the next SUBSCRIBED is a recovery). */
185:   let failedSinceHealthy = false;
186:   const tracing = () => debugLogger.messaging.enabled();
187: 
188:   const publish = (next: MessagingStreamHealth) => {
189:     state = next;
190:     health.update(stream, next);
191:   };
192:   publish(state);
193: 
194:   const clearTimers = () => {
195:     if (retryTimer) clearTimeout(retryTimer);
196:     retryTimer = null;
197:     if (stableTimer) clearTimeout(stableTimer);
198:     stableTimer = null;
199:   };
200: 
201:   const retire = (owned: RealtimeChannel) => {
202:     if (channel === owned) {
203:       channel = null;
204:       generation += 1;
205:       if (stableTimer) clearTimeout(stableTimer);
206:       stableTimer = null;
207:       if (tracing()) debugLogger.messaging.trace(traceScope, 'unsubscribe', { channel: traceChannel });
208:     }
209:     void supabase
210:       .removeChannel(owned)
211:       .then((status) => {
212:         if (status !== 'ok') owned.teardown();
213:       })
214:       .catch(() => {
215:         owned.teardown();
216:       });
217:   };
218: 
219:   const join = () => {
220:     if (stopped) return;
221:     clearTimers();
222:     if (channel) retire(channel);
223:     if (tracing()) {
224:       debugLogger.messaging.trace(traceScope, 'subscribe:attempt', { channel: traceChannel, failures: 
state.failures });
225:     }
226:     generation += 1;
227:     const owned = generation;
228:     let next: RealtimeChannel | null = null;
229:     const isCurrent = (): boolean => !stopped && channel !== null && channel === next && generation === owned;
230:     next = options.bind(supabase.channel(options.createTopic(), options.channelOptions), isCurrent);
231:     channel = next;
232: 
233:     const scheduleRejoin = (status: string) => {
234:       const failures = state.failures + 1;
235:       const delay = Math.min(
236:         REALTIME_RETRY_MAX_MS,
237:         Math.round(REALTIME_RETRY_BASE_MS * REALTIME_RETRY_FACTOR ** (failures - 1))
238:       );
239:       publish({
240:         ...state,
241:         status,
242:         healthy: false,
243:         unhealthySince: state.unhealthySince ?? Date.now(),
244:         failures,
245:         lastRetryDelayMs: delay,
246:       });
247:       if (tracing()) {
248:         debugLogger.messaging.warn(traceScope, 'retry', { channel: traceChannel, status, delay, attempt: failures 
});
249:       }
250:       retryTimer = setTimeout(() => {
251:         retryTimer = null;
252:         if (!isCurrent()) return;
253:         // The socket itself is down: a channel joined now would only queue its
254:         // join, and leaving it before the socket returns cannot withdraw that
255:         // queued join (the server would keep an orphan channel streaming to
256:         // this page). The current channel stays (an errored one is rejoined by
257:         // the SDK as soon as the socket opens); checked again after the next
258:         // backoff, when a closed one is replaced.
259:         if (!supabase.realtime.isConnected()) {
260:           scheduleRejoin(status);
261:           return;
262:         }
263:         join();
264:       }, delay);
265:     };
266: 
267:     next.subscribe((status, error) => {
268:       if (!isCurrent()) return;
269:       options.onStatus?.(status);
270:       if (tracing()) debugLogger.messaging.trace(traceScope, 'status', { channel: traceChannel, status });
271: 
272:       if (FAILURE_STATUSES.has(status) && options.isAccessLoss?.(status, error)) {
273:         if (tracing()) debugLogger.messaging.warn(traceScope, 'access-lost', { channel: traceChannel, status });
274:         stop();
275:         options.onAccessLost?.();
276:         return;
277:       }
278: 
279:       if (status === 'SUBSCRIBED') {
280:         if (retryTimer) clearTimeout(retryTimer);
281:         retryTimer = null;
282:         const recovered = failedSinceHealthy;
283:         failedSinceHealthy = false;
284:         publish({
285:           ...state,
286:           status,
287:           healthy: true,
288:           unhealthySince: null,
289:           recoveries: state.recoveries + (recovered ? 1 : 0),
290:         });
291:         if (stableTimer) clearTimeout(stableTimer);
292:         stableTimer = setTimeout(() => {
293:           stableTimer = null;
294:           if (isCurrent()) publish({ ...state, failures: 0 });
295:         }, RETRY_STABLE_AFTER_MS);
296:         if (recovered) {
297:           if (tracing()) debugLogger.messaging.event(traceScope, 'recovered', { channel: traceChannel });
298:           options.onRecovered?.();
299:         }
300:         return;
301:       }
302: 
303:       if (!FAILURE_STATUSES.has(status)) {
304:         publish({ ...state, status });
305:         return;
306:       }
307:       if (stableTimer) clearTimeout(stableTimer);
308:       stableTimer = null;
309:       failedSinceHealthy = true;
310:       // One rejoin per failed channel (it may report several failures).
311:       if (retryTimer) {
312:         publish({ ...state, status, healthy: false, unhealthySince: state.unhealthySince ?? Date.now() });
313:         return;
314:       }
315:       scheduleRejoin(status);
316:     });
317:   };
318: 
319:   function stop(): void {
320:     if (stopped) return;
321:     stopped = true;
322:     clearTimers();
323:     if (channel) retire(channel);
324:     options.onStatus?.(null);
325:     health.update(stream, null);
326:   }
