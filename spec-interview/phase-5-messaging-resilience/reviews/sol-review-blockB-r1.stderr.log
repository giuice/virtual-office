849: export async function attachRealtimeFaultHarness(
850:   context: BrowserContext,
851:   page: Page,
852:   label: string,
853:   { reload = true }: { reload?: boolean } = {},
854: ): Promise<RealtimeFaultController> {
855:   const harness = new FaultHarness();
856:   await context.routeWebSocket(/\/realtime\/v1\/websocket/, (ws) => harness.route(ws));
857:   await context.addInitScript((key) => {
858:     try {
859:       window.localStorage.setItem(key, '1');
860:     } catch {
861:       // Storage unavailable: the dev server enables the traces by default.
862:     }
863:   }, MESSAGING_DEBUG_FLAG_KEY);
864:   harness.watchPage(page, label);
865:   if (reload && page.url() !== 'about:blank') {
866:     await page.reload();
867:   }
868:   return harness;
869: }
