345: // ---------------------------------------------------------------------------
346: // Controller
347: // ---------------------------------------------------------------------------
348: 
349: interface TopicState {
350:   stream: ObservedRealtimeStream;
351:   /** Join ref (= ref) of the latest phx_join of this topic. */
352:   joinRef: string | null;
353:   joined: boolean;
354:   /** Latest join confirmed by the server's postgres_changes `system` ok. */
355:   confirmedJoinRef: string | null;
356:   /** Join being closed by the harness's real-server close. */
357:   closingJoinRef: string | null;
358:   /**
359:    * T13: join the page already left. A join and its leave sent while the
360:    * socket was down are both flushed on reconnect; the server handles them in
361:    * order, so the join's late ok reply does not make the topic joined.
362:    */
363:   leftJoinRef: string | null;
364: }
365: 
366: interface RoutedConnection {
367:   id: number;
368:   page: WebSocketRoute;
369:   server: WebSocketRoute;
370:   topics: Map<string, TopicState>;
371:   record: ConnectionRecord;
372: }
373: 
374: interface ActiveFault {
375:   kind: RealtimeFaultKind;
376:   since: number;
377:   joinAttempts: number;
378: }
379: 
380: const STATUS_TRACE = /^\[(useMessageSubscription|useConversationRealtime|useConversationTyping):trace\] status\b/;
381: const RETRY_TRACE = /^\[(useMessageSubscription|useConversationRealtime|useConversationTyping)\] retry\b/;
382: const TRACE_STREAM: Record<string, MessagingRealtimeStream> = {
383:   useMessageSubscription: 'messages',
384:   useConversationRealtime: 'list',
385:   useConversationTyping: 'typing',
386: };
387: const PRESENCE_EVENT_PREFIX = '{"schema":"presence-observability-v1"';
