37: const LIVE_WITHIN_MS = 5_000;
38: /** Long enough for a read the open feed was going to report to go out (batch 300 ms + spacing 1 s). */
39: const QUIET_WINDOW_MS = 3_000;
40: 
41: const readBy = (page: Page, messageId: string) => page.getByTestId(`read-by-${messageId}`);
42: const readersList = (page: Page, messageId: string) => page.getByTestId(`readers-list-${messageId}`);
43: const readerItems = (page: Page, messageId: string) => readersList(page, 
messageId).locator('[data-testid^="reader-item-"]');
44: 
45: interface PageWatch {
46:   /** Requests that only a degraded tab makes (T14 polling marks them `source=poll`). */
47:   polls: string[];
48:   /** Realtime sockets opened after the watch started (a reconnect opens a new one). */
49:   sockets: string[];
50:   /** PATCH /api/conversations/read requests, with their body. */
51:   reads: Array<{ at: number; body: string }>;
52: }
53: 
54: /** Watches one page for polling, new Realtime sockets and read requests, and marks it to detect a reload. */
55: async function watchPage(page: Page): Promise<PageWatch> {
56:   const watch: PageWatch = { polls: [], sockets: [], reads: [] };
57:   page.on('request', (request) => {
58:     const url = new URL(request.url());
59:     if (url.searchParams.get('source') === 'poll') watch.polls.push(url.pathname);
60:     if (url.pathname === '/api/conversations/read' && request.method() === 'PATCH') {
61:       watch.reads.push({ at: Date.now(), body: request.postData() ?? '' });
62:     }
63:   });
64:   page.on('websocket', (socket) => {
65:     if (socket.url().includes('/realtime/')) watch.sockets.push(new URL(socket.url()).pathname);
66:   });
67:   await page.evaluate(() => {
68:     (window as unknown as { __t16NoReload?: boolean }).__t16NoReload = true;
69:   });
70:   return watch;
71: }
72: 
73: /** Healthy-path guarantees for one page: no reload, no reconnect, no polling. */
74: async function expectHealthyPath(page: Page, watch: PageWatch, label: string): Promise<void> {
75:   expect(
76:     await page.evaluate(() => (window as unknown as { __t16NoReload?: boolean }).__t16NoReload === true),
77:     `${label}: no reload`,
78:   ).toBe(true);
79:   expect(watch.sockets, `${label}: no new Realtime socket (no reconnect)`).toEqual([]);
80:   expect(watch.polls, `${label}: no polling while healthy`).toEqual([]);
81: }
82: 
83: /**
84:  * Records, in the page, every change of the conversation row's unread badge
85:  * (0 when the row shows none) with the page's time — the same machine clock
86:  * as the test.
87:  */
88: async function watchUnreadBadge(page: Page, conversationId: string): Promise<void> {
89:   await page.evaluate((id) => {
90:     const log: Array<{ at: number; count: number | null }> = [];
91:     let last: number | null | undefined;
92:     const read = () => {
93:       const row = document.querySelector(`[data-testid="conversation-item-${id}"]`);
94:       const badge = row?.querySelector(`[data-testid="conversation-unread-badge-${id}"]`);
95:       const count = row ? Number.parseInt((badge?.textContent ?? '0').trim(), 10) || 0 : null;
96:       if (count === last) return;
97:       last = count;
98:       log.push({ at: Date.now(), count });
99:     };
100:     (window as unknown as { __t16Badge?: typeof log }).__t16Badge = log;
101:     read();
102:     new MutationObserver(read).observe(document.body, { subtree: true, childList: true, characterData: true });
103:   }, conversationId);
104: }
105: 
106: /** When the page's badge first showed `count` at or after `since`; fails after the live deadline plus slack. */
107: async function badgeReachedAt(page: Page, count: number, since: number, message: string): Promise<number> {
108:   let at = -1;
109:   await expect
110:     .poll(
111:       async () => {
112:         const log = await page.evaluate(
113:           () => (window as unknown as { __t16Badge: Array<{ at: number; count: number | null }> }).__t16Badge,
114:         );
115:         const current = log[log.length - 1];
116:         if (current?.count !== count) return false;
117:         at = Math.max(since, current.at);
118:         return true;
119:       },
120:       { timeout: LIVE_WITHIN_MS + 5_000, message },
121:     )
122:     .toBe(true);
123:   return at;
124: }
125: 
126: /** A's own unread count of the conversation as the server computes it. */
127: async function serverUnread(page: Page, conversationId: string): Promise<number> {
128:   const response = await page.request.get('/api/conversations/get?includeArchived=true');
129:   expect(response.status()).toBe(200);
130:   const body = (await response.json()) as { conversations?: Array<{ id: string; unreadCount?: number }> };
131:   return body.conversations?.find((conversation) => conversation.id === conversationId)?.unreadCount ?? 0;
132: }
133: 
134: /** The stored readers of a message (non-sender receipts), most recent first. */
135: async function storedReaders(messageId: string): Promise<Array<{ userId: string; readAt: number }>> {
136:   return withLocalMessagingDb(async (db) => {
137:     const result = await db.query<{ user_id: string; read_at: Date }>(
138:       `select r.user_id::text as user_id, r.read_at
139:          from public.message_read_receipts r
140:          join public.messages m on m.id = r.message_id
141:         where r.message_id = $1 and r.user_id <> m.sender_id
142:         order by r.read_at desc, r.user_id`,
143:       [messageId],
144:     );
145:     return result.rows.map((row) => ({ userId: row.user_id, readAt: row.read_at.getTime() }));
146:   });
147: }
148: 
149: /** The reader rows an open reader list shows: user id and read time (ms). */
150: async function shownReaders(page: Page, messageId: string): Promise<Array<{ userId: string; readAt: number }>> {
151:   return readerItems(page, messageId).evaluateAll((rows) =>
152:     rows.map((row) => ({
153:       userId: (row.getAttribute('data-testid') ?? '').replace('reader-item-', ''),
154:       readAt: Date.parse(row.querySelector('[data-testid="reader-read-at"]')?.getAttribute('datetime') ?? ''),
155:     })),
156:   );
157: }
158: 
159: /** Readers equal (same users, same order, read times equal to the millisecond the browser keeps). */
160: function sameReaders(
161:   shown: ReadonlyArray<{ userId: string; readAt: number }>,
162:   stored: ReadonlyArray<{ userId: string; readAt: number }>,
163: ): boolean {
164:   return (
165:     shown.length === stored.length &&
166:     shown.every((reader, index) => reader.userId === stored[index].userId && Math.abs(reader.readAt - 
stored[index].readAt) < 1)
167:   );
168: }
