73: /** Records, in the page, every change of the banner's state and text with the page's time. */
74: async function watchBanner(page: Page): Promise<void> {
75:   await page.evaluate(() => {
76:     const log: Array<{ at: number; state: string; text: string }> = [];
77:     let last = '';
78:     const read = () => {
79:       const element = document.querySelector('[data-testid="messaging-connection-banner"]');
80:       const state = element?.getAttribute('data-state') ?? 'absent';
81:       const text = element?.textContent ?? '';
82:       const key = `${state}|${text}`;
83:       if (key === last) return;
84:       last = key;
85:       log.push({ at: Date.now(), state, text });
86:     };
87:     (window as unknown as { __t13Banner?: typeof log }).__t13Banner = log;
88:     read();
89:     new MutationObserver(read).observe(document.body, {
90:       subtree: true,
91:       childList: true,
92:       characterData: true,
93:       attributes: true,
94:       attributeFilter: ['data-state'],
95:     });
96:   });
97: }
