90: /**
91:  * Types one key every 150 ms into the composer of `page` until stopped
92:  * (continuous typing). `stop()` resolves with the time of the last keystroke.
93:  */
94: async function startTyping(page: Page): Promise<Typist> {
95:   await composerInput(page).click();
96:   let running = true;
97:   let lastKeyAt = Date.now();
98:   const loop = (async () => {
99:     let index = 0;
100:     while (running) {
101:       await page.keyboard.type('abcdefghij'[index % 10]);
102:       lastKeyAt = Date.now();
103:       index += 1;
104:       if (index % 40 === 0) {
105:         // Keep the draft short: erase without leaving the "typing" state.
106:         await page.keyboard.press('Backspace');
107:       }
108:       await page.waitForTimeout(KEY_INTERVAL_MS);
109:     }
110:   })();
111:   return {
112:     stop: async () => {
113:       running = false;
114:       await loop;
115:       return lastKeyAt;
116:     },
117:   };
118: }
