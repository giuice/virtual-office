46: /** Records, in the page, every change of the typing indicator (text, or null when absent) with the page's time. */
47: async function watchIndicator(page: Page): Promise<void> {
48:   await page.evaluate(() => {
49:     const log: Array<{ at: number; text: string | null }> = [];
50:     let last: string | null | undefined;
51:     const read = () => {
52:       const element = document.querySelector('[data-testid="typing-indicator"]');
53:       const text = element ? (element.textContent ?? '').trim() : null;
54:       if (text === last) return;
55:       last = text;
56:       log.push({ at: Date.now(), text });
57:     };
58:     (window as unknown as { __t15Typing?: typeof log }).__t15Typing = log;
59:     read();
60:     new MutationObserver(read).observe(document.body, { subtree: true, childList: true, characterData: true });
61:   });
62: }
63: 
64: const readIndicatorLog = (page: Page): Promise<IndicatorEntry[]> =>
65:   page.evaluate(() => (window as unknown as { __t15Typing: IndicatorEntry[] }).__t15Typing);
