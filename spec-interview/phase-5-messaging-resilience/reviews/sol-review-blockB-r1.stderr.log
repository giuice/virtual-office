43:   isCurrent: () => boolean
44: ): Promise<void> {
45:   if (debugLogger.messaging.enabled()) {
46:     debugLogger.messaging.event('useMessagingPollingFallback', 'poll', { conversationId });
47:   }
48:   await Promise.allSettled([
49:     conversationId ? pollConversationFeed(queryClient, conversationId, isCurrent) : Promise.resolve(),
50:     // An open reader list refetches through its own query: a Realtime receipt
51:     // invalidation cancels a poll fetch still running, so a stale poll never
52:     // lands after it.
53:     queryClient.refetchQueries({ queryKey: MESSAGE_READERS_QUERY_KEY, type: 'active' }, { cancelRefetch: false }),
54:     pollQueryIfUnchanged(
55:       queryClient,
56:       conversationsQueryKey(userId),
57:       () => fetchConversationList(userId, 'poll'),
58:       isCurrent
59:     ),
60:   ]);
61: }
62: 
63: /**
64:  * Phase 5 T14 (FR-016, BR-012): polling fallback while Realtime is unhealthy.
65:  * Once any required messaging stream (messages, list) has been unhealthy for
66:  * more than 30 s and the tab is visible, the open conversation's feed (new
67:  * messages, receipt summaries of its loaded messages), any open reader list
68:  * and the conversation list are fetched every 15 s; on becoming visible while
69:  * that holds, at once. Nothing polls while the tab is hidden, and no round
70:  * starts once every required stream is healthy again (a round in flight
71:  * finishes; its results merge without replacing newer state). Health is this
72:  * tab's (T13: healthy means SUBSCRIBED, not "no event missed"); there is no
73:  * reconciliation while the streams are healthy.
74:  */
75: export function useMessagingPollingFallback({ health, userId, conversationId }: 
UseMessagingPollingFallbackOptions): void {
76:   const queryClient = useQueryClient();
77:   const snapshot = useSyncExternalStore(health.subscribe, health.getSnapshot, health.getSnapshot);
78:   const since = unhealthySince(snapshot, REQUIRED_MESSAGING_STREAMS);
79:   const visible = useSyncExternalStore(subscribeVisibility, isTabVisible, () => true);
80: 
81:   const userRef = useRef(userId);
82:   const conversationRef = useRef(conversationId);
83:   useEffect(() => {
84:     userRef.current = userId;
85:     conversationRef.current = conversationId;
86:   }, [userId, conversationId]);
87: 
88:   const lastRoundAtRef = useRef<number | null>(null);
89:   const roundInFlightRef = useRef(false);
90:   const wasHiddenRef = useRef(false);
91: 
92:   useEffect(() => {
93:     if (!visible) {
94:       wasHiddenRef.current = true;
95:       return;
96:     }
97:     const becameVisible = wasHiddenRef.current;
98:     wasHiddenRef.current = false;
99:     if (!userId || since === null) return;
100: 
101:     let stopped = false;
102:     let timer: ReturnType<typeof setTimeout> | null = null;
103:     const schedule = (delay: number) => {
104:       timer = setTimeout(tick, Math.max(0, delay));
105:     };
106: 
107:     function tick() {
108:       timer = null;
109:       if (stopped || !userId) return;
110:       // Read at fire time (the store can change before React re-runs this effect).
111:       const unhealthyFrom = unhealthySince(health.getSnapshot(), REQUIRED_MESSAGING_STREAMS);
112:       if (unhealthyFrom === null || !isTabVisible()) return;
113:       const dueAt = unhealthyFrom + POLL_AFTER_UNHEALTHY_MS;
114:       if (Date.now() < dueAt) {
115:         schedule(dueAt - Date.now());
116:         return;
117:       }
118:       schedule(POLL_INTERVAL_MS);
119:       if (roundInFlightRef.current) return;
120:       roundInFlightRef.current = true;
121:       lastRoundAtRef.current = Date.now();
122:       const pollUser = userId;
123:       const isCurrent = () => userRef.current === pollUser;
124:       void pollOnce(queryClient, pollUser, conversationRef.current, isCurrent).finally(() => {
125:         roundInFlightRef.current = false;
126:       });
127:     }
128: 
129:     const now = Date.now();
130:     const eligibleAt = since + POLL_AFTER_UNHEALTHY_MS;
131:     const lastRoundAt = lastRoundAtRef.current;
132:     const at = becameVisible || lastRoundAt === null
133:       ? Math.max(now, eligibleAt)
134:       : Math.max(eligibleAt, lastRoundAt + POLL_INTERVAL_MS);
135:     schedule(at - now);
136: 
137:     return () => {
138:       stopped = true;
139:       if (timer) clearTimeout(timer);
140:     };
141:   }, [health, queryClient, since, userId, visible]);
142: }
