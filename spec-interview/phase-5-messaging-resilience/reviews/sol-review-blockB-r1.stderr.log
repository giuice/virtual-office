1: // src/lib/messaging/realtime-health.ts
2: // Phase 5 T13 (FR-014, FR-015): application-level health and recovery of the
3: // messaging Realtime streams.
4: //
5: // - MessagingRealtimeHealth: one small store of per-stream health (this tab,
6: //   the signed-in user's messaging provider). Consumers: the drawer's
7: //   connection banner (T13), polling fallback (T14), typing (T15), metrics
8: //   (T19). It holds no identity or message data, only channel states.
9: // - startRecoveringChannel(): the lifecycle of one stream's channel. After an
10: //   error, a timeout or a terminal closure the channel is left and a new one
11: //   joined (a new topic each time, or the same RLS-authorized topic for
12: //   typing) with capped exponential backoff — beyond the SDK's own rejoins,
13: //   which never follow a CLOSED channel. The stream's own handlers catch up
14: //   (refetch) when the server confirms the rejoined changes stream;
15: //   `onRecovered` reports a recovery to the owner. A failure the owner
16: //   classifies as access loss (a refused private join) stops the stream
17: //   instead of retrying it (T15).
18: // Only messaging channels go through here; Presence keeps its own lifecycle
19: // on the shared socket (the socket is never closed or reconnected here).
20: import type { RealtimeChannel, RealtimeChannelOptions } from '@supabase/supabase-js';
21: 
22: import { supabase } from '@/lib/supabase/client';
23: import { debugLogger } from '@/utils/debug-logger';
24: 
25: export type MessagingRealtimeStream = 'messages' | 'list' | 'typing';
26: 
27: /** The streams whose health the drawer banner follows (FR-014); typing is not required. */
28: export const REQUIRED_MESSAGING_STREAMS: readonly MessagingRealtimeStream[] = ['messages', 'list'];
29: 
30: export interface MessagingStreamHealth {
31:   /** Last status of the current channel's subscribe callback; null while its first join is pending. */
32:   status: string | null;
33:   /** The current channel is SUBSCRIBED. */
34:   healthy: boolean;
35:   /**
36:    * When the stream stopped being healthy (its start, or its first failure
37:    * after being healthy); null while healthy.
38:    */
39:   unhealthySince: number | null;
40:   /** Failures since the stream was last stable (they set the backoff). */
41:   failures: number;
42:   /** Delay before the latest rejoin attempt (ms); null before any. */
43:   lastRetryDelayMs: number | null;
44:   /** Times the stream became healthy again after a failure. */
45:   recoveries: number;
46: }
47: 
48: type Listener = () => void;
49: 
50: /**
51:  * Per-stream health of the messaging Realtime streams of this tab. A stream
52:  * with no entry is idle (not started: signed out, or its hook inactive).
53:  */
54: export class MessagingRealtimeHealth {
55:   private entries: Partial<Record<MessagingRealtimeStream, MessagingStreamHealth>> = {};
56:   private readonly listeners = new Set<Listener>();
57: 
58:   subscribe = (listener: Listener): (() => void) => {
59:     this.listeners.add(listener);
60:     return () => {
61:       this.listeners.delete(listener);
62:     };
63:   };
64: 
65:   /** Immutable snapshot (a new object after every change; use with useSyncExternalStore). */
66:   getSnapshot = (): Partial<Record<MessagingRealtimeStream, MessagingStreamHealth>> => this.entries;
67: 
68:   get(stream: MessagingRealtimeStream): MessagingStreamHealth | null {
69:     return this.entries[stream] ?? null;
70:   }
71: 
72:   /** @internal startRecoveringChannel */
73:   update(stream: MessagingRealtimeStream, next: MessagingStreamHealth | null): void {
74:     const entries = { ...this.entries };
75:     if (next) {
76:       entries[stream] = next;
77:     } else {
78:       delete entries[stream];
79:     }
80:     this.entries = entries;
81:     this.listeners.forEach((listener) => listener());
82:   }
83: }
84: 
85: /** The earliest moment any of `streams` became unhealthy (null when all are healthy or idle). */
86: export function unhealthySince(
87:   snapshot: Partial<Record<MessagingRealtimeStream, MessagingStreamHealth>>,
88:   streams: readonly MessagingRealtimeStream[]
89: ): number | null {
90:   let earliest: number | null = null;
91:   for (const stream of streams) {
92:     const since = snapshot[stream]?.unhealthySince ?? null;
93:     if (since !== null && (earliest === null || since < earliest)) earliest = since;
94:   }
95:   return earliest;
96: }
97: 
98: /**
99:  * Whether a postgres_changes payload is a change of `table` (and, when given,
100:  * of one of `events`). realtime-js routes a channel's postgres_changes to its
101:  * bindings by the server-assigned binding ids from the join reply; until that
102:  * reply arrives (a join whose reply was lost or delayed — the server may
103:  * already stream), every '*' binding receives every change of the channel
104:  * (RealtimeChannel `_updateFilterMessage`). Handlers therefore check that the
105:  * payload is their own before using it.
106:  */
107: export function isPostgresChangeOf(
108:   payload: { table?: string; eventType?: string },
109:   table: string,
110:   events?: readonly string[]
111: ): boolean {
112:   return payload.table === table && (events === undefined || events.includes(payload.eventType ?? ''));
113: }
114: 
115: export const REALTIME_RETRY_BASE_MS = 250;
116: /**
117:  * Growth of the backoff. 1.5 rather than 2 keeps an attempt within ~0.3 s
118:  * after a 3 s outage (attempts at 0.25, 0.63, 1.19, 2.03, 3.30 s…), so a
119:  * Realtime blip that short heals — the join itself takes ~1 s — before the
120:  * 5 s "Reconectando…" threshold (FR-014); the cap is reached after ~12 s.
121:  */
122: export const REALTIME_RETRY_FACTOR = 1.5;
123: export const REALTIME_RETRY_MAX_MS = 5_000;
124: /** A channel SUBSCRIBED this long resets the backoff. */
125: const RETRY_STABLE_AFTER_MS = 30_000;
126: const FAILURE_STATUSES = new Set(['TIMED_OUT', 'CHANNEL_ERROR', 'CLOSED']);
127: 
128: export interface RecoveringChannelOptions {
129:   stream: MessagingRealtimeStream;
130:   health: MessagingRealtimeHealth;
131:   /** Debug-trace scope and channel label (`[<scope>:trace] status` is read by the T25 harness). */
132:   traceScope: string;
133:   traceChannel: string;
134:   /**
135:    * The topic of each join: a new one every time (a left channel's topic is
136:    * never reused), except where authorization fixes the topic name (typing,
137:    * T15) — leaving a channel removes it from the client synchronously
138:    * (Phoenix leave closes at once on the client), so the same name can be
139:    * joined again right after.
140:    */
141:   createTopic: () => string;
142:   /** Channel options (e.g. `{ config: { private: true } }` for an RLS-authorized topic). */
143:   channelOptions?: RealtimeChannelOptions;
144:   /** Adds the stream's bindings; their handlers must do nothing unless `isCurrent()`. */
145:   bind: (channel: RealtimeChannel, isCurrent: () => boolean) => RealtimeChannel;
146:   /** Every subscribe-callback status of the current channel (null: stopped). */
147:   onStatus?: (status: string | null) => void;
148:   /** The stream is SUBSCRIBED again after a failure (never on its first join). */
149:   onRecovered?: () => void;
150:   /**
151:    * A failure that means the user no longer has access (e.g. the server
152:    * refused the join of a private topic). The stream then stops — no
153:    * rejoin, it becomes idle — and `onAccessLost` is called once; any other
154:    * failure is retried with backoff.
155:    */
156:   isAccessLoss?: (status: string, error: Error | undefined) => boolean;
157:   onAccessLost?: () => void;
158: }
159: 
160: /**
161:  * Joins the stream's channel and keeps it joined: after CHANNEL_ERROR,
162:  * TIMED_OUT or CLOSED the channel is left and a new one joined after
163:  * min(REALTIME_RETRY_MAX_MS, round(REALTIME_RETRY_BASE_MS · 1.5^(failures − 1))) —
164:  * unless the socket itself is down, when no channel is joined (an errored one
165:  * is rejoined by the SDK on reconnect); the failure count resets once a channel has
