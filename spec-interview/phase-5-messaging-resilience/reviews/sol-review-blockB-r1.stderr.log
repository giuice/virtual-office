310:  *   is a pre-outage attempt of a holder that did not supersede it (frozen):
311:  *   it is replaced under a newer generation (fenced first). A claim made
312:  *   since is never replaced.
313:  */
314: export interface ClaimTakeover {
315:   acquiredAt: number;
316:   stolen: boolean;
317:   supersedeBefore?: number | null;
318: }
319: 
320: /** The server confirmed `key` under `generation`: removed in the claim's transaction (see confirmedRemovable). */
321: export interface ConfirmedRemoval {
322:   key: string;
323:   generation: number;
324: }
325: 
326: /**
327:  * Atomically takes the conversation's OLDEST item for a new attempt: the next
328:  * generation, state `claimed`, `claimHolder`, lease expiry. Only the oldest
329:  * item is ever eligible (BR-003). The caller must hold the conversation's
330:  * drain lock (Web Lock, T10); a `claimed` item of another holder is taken over
331:  * under a newer generation only as `takeover` allows, else `busy`. Retired
332:  * items (F3: delivered, kept only for their claim) are removed on the way,
333:  * unless their claim may not be replaced (`busy`).
334:  *
335:  * Strict durability (block A fix F1): the claim — the item's new generation
336:  * and dispatched state — is flushed before its request can leave the
337:  * machine, so an OS crash can never bring back an earlier state (e.g. a
338:  * cancellable generation 0) of an item whose attempt may be stored.
339:  *
340:  * `confirmed`: an item of this owner just confirmed by the server, removed in
341:  * the same transaction before the next one is taken. `maxDeferMs`: the
342:  * longest transient backoff; a waiting item whose `retryNotBefore` is at most
343:  * that far ahead is not claimed yet (`deferred`).
344:  */
345: export function claimOldestOutboxItem(
346:   ownerId: string,
347:   conversationId: string,
348:   claimHolder: string,
349:   leaseMs: number,
350:   takeover: ClaimTakeover,
351:   confirmed: ConfirmedRemoval | null = null,
352:   maxDeferMs = 0
353: ): Promise<OutboxClaim> {
354:   return inTransaction<OutboxClaim>(
355:     'readwrite',
356:     ({ items }, done) => {
357:       const now = Date.now();
358:       /** A live claim of another holder that this drain must leave alone (F4). */
359:       const untouchable = (item: OutboxItem): boolean =>
360:         item.state === 'claimed' &&
361:         item.claimHolder !== null &&
362:         item.claimHolder !== claimHolder &&
363:         item.leaseExpiresAt !== null &&
364:         item.leaseExpiresAt > now &&
365:         (takeover.stolen || item.updatedAt >= takeover.acquiredAt) &&
366:         !(typeof takeover.supersedeBefore === 'number' && item.updatedAt < takeover.supersedeBefore);
367:       const claimOldest = () => {
368:         const range = IDBKeyRange.bound([ownerId, conversationId, -Infinity], [ownerId, conversationId, 
