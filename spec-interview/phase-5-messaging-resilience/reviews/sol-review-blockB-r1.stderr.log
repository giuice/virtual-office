50: // Phase 5 T8 (SPEC §13): a pending copy's state as text, not colour only.
51: const DELIVERY_STATE_LABELS: Record<MessageDeliveryState, string> = {
52:   pending: 'pendente',
53:   sending: 'enviando',
54:   failed: 'não enviada',
55:   expired: 'expirada',
56: };
57: 
58: function MessageDeliveryLabel({ state, messageId }: { state: MessageDeliveryState; messageId: string }) {
59:   return (
60:     <span
61:       className={cn('font-medium', state === 'failed' || state === 'expired' ? 'text-destructive' : 
'text-muted-foreground')}
62:       data-testid={`message-delivery-state-${messageId}`}
165:   if (!showActions) return null;
166:   return <div className="flex items-center gap-1 absolute -top-4 right-2 bg-background shadow rounded-md p-1" 
data-avatar-interactive data-testid={`message-actions-${message.id}`}>
167:       {onReply && <Button variant="ghost" size="icon" className="size-7" aria-label="Responder" onClick={e => {
168:       e.stopPropagation();
169:       onReply(message);
170:     }} data-avatar-interactive data-testid={`message-action-reply-${message.id}`}>
171:         <Reply className="size-4" />
172:       </Button>}
173:       <EmojiPicker onEmojiSelect={emoji => onReaction?.(message.id, emoji)} />
174:       <DropdownMenu onOpenChange={onMenuOpenChange}>
175:         <DropdownMenuTrigger asChild>
176:           <Button variant="ghost" size="icon" className="size-7" data-avatar-interactive onClick={e => 
e.stopPropagation()} aria-label="Mais ações" data-testid={`message-more-actions-${message.id}`}>
177:             <MoreHorizontal className="size-4" />
178:           </Button>
179:         </DropdownMenuTrigger>
180:         <DropdownMenuContent align="end" onPointerDownOutside={e => e.stopPropagation()} onClick={e => 
e.stopPropagation()} onKeyDown={e => e.stopPropagation()}>
181:           <DropdownMenuItem onSelect={e => {
182:           e.preventDefault();
183:           isPinned ? onUnpin?.(message.id) : onPin?.(message.id);
184:         }}>
185:             <Pin className={cn("mr-2 size-4", isPinned && "fill-current")} />
186:             {isPinned ? 'Unpin Message' : 'Pin Message'}
187:           </DropdownMenuItem>
188:           {/* Stars are personal (Phase 4 FR-020). The menu closes after the
189:               action so focus returns to the trigger. */}
190:           <DropdownMenuItem onSelect={() => {
191:           isStarred ? onUnstar?.(message.id) : onStar?.(message.id);
192:         }} data-testid={`message-star-toggle-${message.id}`}>
193:             <Star className={cn("mr-2 size-4", isStarred && "fill-yellow-400 text-yellow-400")} 
aria-hidden="true" />
194:             {isStarred ? 'Remover dos favoritos' : 'Favoritar'}
195:           </DropdownMenuItem>
196:         </DropdownMenuContent>
197:       </DropdownMenu>
198:     </div>;
199: }
