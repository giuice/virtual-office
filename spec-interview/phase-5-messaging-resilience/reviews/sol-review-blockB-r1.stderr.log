180: const messagesQueryKey = (conversationId: string) => ['messages', conversationId] as const;
181: 
182: const isMessageCached = (data: MessagesInfiniteData | undefined, messageId: string): boolean =>
183:   Boolean(data?.pages?.some((page) => page.messages.some((existing) => existing.id === messageId)));
184: 
185: /**
186:  * Whether a conversation's feed cache holds the message right now. Components
187:  * render the feed from a provider that re-renders only once TanStack Query
188:  * delivers its (deferred) observer notification, so the rendered list can
189:  * briefly lag behind the cache.
190:  */
191: export function isMessageInFeedCache(
192:   queryClient: QueryClient,
193:   conversationId: string,
194:   messageId: string
195: ): boolean {
196:   return isMessageCached(
197:     queryClient.getQueryData<MessagesInfiniteData>(messagesQueryKey(conversationId)),
198:     messageId
199:   );
200: }
201: 
202: /**
203:  * Keeps a just-merged message (a resolved send, a realtime INSERT) in the
204:  * feed when a fetch of that feed is already in flight.
205:  *
206:  * A fetch resolves with the server rows it read when it started and replaces
207:  * the cached pages. If the message was committed after that read, the result
208:  * lacks it and would silently drop it from the feed until some later
209:  * refetch. Once the in-flight fetch settles the message is merged again
210:  * (a no-op when the result already has it). If the message leaves the cache
211:  * while the fetch is still running (deleted, or a failed send rolled back),
212:  * it is not brought back, and neither is a message this client has seen
213:  * deleted by a Realtime DELETE (isMessageDeleted) by the time the fetch
214:  * settles.
215:  */
216: export function keepMessageThroughInflightFetch(
217:   queryClient: QueryClient,
218:   conversationId: string,
219:   message: Message
220: ): void {
221:   const queryKey = messagesQueryKey(conversationId);
222:   const queryCache = queryClient.getQueryCache();
223:   const query = queryCache.find<MessagesInfiniteData>({ queryKey, exact: true });
224:   if (!query || query.state.fetchStatus !== 'fetching') {
225:     return;
226:   }
227: 
228:   const unsubscribe = queryCache.subscribe((event) => {
229:     if (event.query !== query) {
230:       return;
231:     }
232:     if (event.type === 'removed') {
233:       unsubscribe();
234:       return;
235:     }
236:     if (event.type !== 'updated') {
237:       return;
238:     }
239:     if (query.state.fetchStatus === 'fetching') {
240:       // Until the fetch settles, data only changes through local updates.
241:       if (!isMessageCached(query.state.data, message.id)) {
242:         unsubscribe();
243:       }
244:       return;
245:     }
246:     unsubscribe();
247:     if (isMessageDeleted(queryClient, message.id)) {
248:       return;
249:     }
250:     queryClient.setQueryData<MessagesInfiniteData | undefined>(queryKey, (oldData) =>
251:       oldData ? appendMessageToPages(oldData, message) : oldData
252:     );
253:   });
254: }
255: 
256: /** Feed order: oldest first by timestamp, then id (the server's keyset order). */
257: const compareFeedOrder = (a: Message, b: Message): number => {
258:   const byTime = new Date(a.timestamp).getTime() - new Date(b.timestamp).getTime();
259:   if (byTime !== 0) return byTime;
260:   return a.id < b.id ? -1 : a.id > b.id ? 1 : 0;
261: };
262: 
263: const sameMessage = (a: Message, b: Message): boolean => JSON.stringify(a) === JSON.stringify(b);
264: 
265: export interface PolledMessagesMerge {
266:   data: MessagesInfiniteData;
267:   /** Messages the poll added to page 0 (not cached before). */
268:   added: Message[];
269:   changed: boolean;
270: }
271: 
272: /**
273:  * Phase 5 T14 (FR-016, AC-048): merges a polling-fallback read of a
274:  * conversation (`polled`, oldest first) into its cached feed without ever
275:  * going back to older data:
276:  * - a message is never duplicated: one already in ANY page is never added
277:  *   again, and one the cache held when the poll started (`cachedAtStart`) but
278:  *   no longer holds (removed meanwhile), or seen deleted, is not brought back;
279:  * - an existing message is replaced by its polled copy only when
280:  *   `replaceExisting` — the caller's proof that nothing wrote the feed since
281:  *   the poll started, so the polled copy is the newer state (receipts,
282:  *   reactions, attachments, mentions); otherwise the cached copy is kept;
283:  * - a new message is placed in page 0 (the newest window) in feed order, and
284:  *   only when it is not older than page 0's oldest message: an older one
285:  *   belongs to history that is not loaded. Older pages are never replaced,
286:  *   dropped or reordered.
287:  */
288: export function mergePolledMessages(
289:   oldData: MessagesInfiniteData,
290:   polled: readonly Message[],
291:   options: {
292:     replaceExisting: boolean;
293:     cachedAtStart: ReadonlySet<string>;
294:     isDeleted: (messageId: string) => boolean;
295:   }
296: ): PolledMessagesMerge {
297:   const polledById = new Map(polled.map((message) => [message.id, message]));
298:   const cached = new Set<string>();
299:   let changed = false;
300: 
301:   const pages = oldData.pages.map((page) => {
302:     let pageChanged = false;
303:     const messages = page.messages.map((existing) => {
304:       cached.add(existing.id);
305:       if (!options.replaceExisting) return existing;
306:       const next = polledById.get(existing.id);
307:       if (!next || options.isDeleted(existing.id) || sameMessage(existing, next)) return existing;
308:       pageChanged = true;
309:       return next;
310:     });
311:     if (!pageChanged) return page;
312:     changed = true;
313:     return { ...page, messages };
314:   });
315: 
316:   const newest = pages[0];
317:   const floor = newest.messages[0] ?? pages.slice(1).find((page) => page.messages.length > 0)?.messages.at(-1);
318:   const added = polled.filter(
319:     (message) =>
320:       !cached.has(message.id) &&
321:       !options.cachedAtStart.has(message.id) &&
322:       !options.isDeleted(message.id) &&
323:       (!floor || compareFeedOrder(message, floor) >= 0)
324:   );
325:   if (added.length > 0) {
326:     const merged = [...newest.messages];
327:     for (const message of added) {
328:       const index = merged.findIndex((existing) => compareFeedOrder(existing, message) > 0);
329:       if (index === -1) merged.push(message);
330:       else merged.splice(index, 0, message);
331:     }
332:     pages[0] = { ...newest, messages: merged };
333:     changed = true;
334:   }
335: 
336:   return { data: changed ? { ...oldData, pages } : oldData, added, changed };
337: }

