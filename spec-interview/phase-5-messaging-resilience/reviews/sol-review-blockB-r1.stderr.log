1: // src/hooks/useMessageOutbox.ts
2: // Phase 5 T8: runs the signed-in user's durable message outbox (one per
3: // application user, users.id) for as long as the messaging provider is
4: // mounted, and returns the function that queues a text/reply send — plus
5: // (T27) "Tentar de novo" and "Apagar" for a failed or expired item, and
6: // (T10) "Cancelar" for a never-dispatched waiting item, and (T12) the count
7: // and deletion behind the "Sair" confirmation. T11: the outbox sends
8: // and applies responses only while the browser's authenticated user is its
9: // owner (users.id `ownerId`, whose auth identity is `ownerAuthUid`, that
10: // user's users.supabase_uid).
11: import { useCallback, useEffect, useMemo, useRef } from 'react';
12: import { useQueryClient } from '@tanstack/react-query';
13: 
14: import { MessageOutbox } from '@/lib/messaging/outbox/message-outbox';
15: import { createOutboxIdentity } from '@/lib/messaging/outbox/outbox-identity';
16: import {
17:   beginOutboxSignOut,
18:   countUnsentOutboxItems,
19:   type OutboxSignOut,
20: } from '@/lib/messaging/outbox/outbox-sign-out';
21: import type { OutboxEnqueueInput } from '@/types/message-outbox';
22: 
23: export type QueueTextMessage = (input: OutboxEnqueueInput) => Promise<void>;
24: 
25: export interface MessageOutboxActions {
26:   queueTextMessage: QueueTextMessage;
27:   /** "Tentar de novo" on a failed or expired item (by its clientMessageId). */
28:   retryOutboxMessage: (clientMessageId: string) => Promise<void>;
29:   /** "Apagar": removes a failed or expired item from this browser only. */
30:   discardOutboxMessage: (clientMessageId: string) => Promise<void>;
31:   /** "Cancelar" (T10): removes a never-dispatched waiting item in every tab, unless a claim won. */
32:   cancelOutboxMessage: (clientMessageId: string) => Promise<void>;
33:   /**
34:    * T12: the signed-in user's unsent items in this browser (0 when there is no
35:    * outbox user, or the browser is not signed in as that user — F2).
36:    */
37:   countUnsentOutboxMessages: () => Promise<number>;
38:   /**
39:    * T12 "Sair mesmo": stops every drain of the user in every tab now; then
40:    * `discard()` deletes the user's outbox and `release()` ends the stop once
41:    * the sign-out finished. Null when there is no outbox user.
42:    */
43:   beginOutboxSignOut: () => OutboxSignOut | null;
44:   /**
45:    * T13 (FR-002): the messages Realtime stream recovered; every conversation
46:    * drains again (owner check and sign-out stop still apply). No-op without an outbox.
47:    */
48:   resumeOutboxDrains: () => void;
49: }
50: 
51: export function useMessageOutbox(
52:   ownerId: string | null | undefined,
53:   ownerAuthUid: string | null | undefined
54: ): MessageOutboxActions {
55:   const queryClient = useQueryClient();
56:   const outboxRef = useRef<MessageOutbox | null>(null);
57: 
58:   // The browser's authenticated user compared with the owner (T11); also gates
59:   // the sign-out count and deletion (block A fix F2).
60:   const identity = useMemo(() => (ownerAuthUid ? createOutboxIdentity(ownerAuthUid) : null), [ownerAuthUid]);
61: 
62:   useEffect(() => {
63:     if (!ownerId || !identity) return;
64:     const outbox = new MessageOutbox(ownerId, queryClient, identity);
65:     outboxRef.current = outbox;
66:     outbox.start();
67:     return () => {
68:       outbox.dispose();
69:       if (outboxRef.current === outbox) outboxRef.current = null;
70:     };
71:   }, [ownerId, identity, queryClient]);
72: 
73:   const currentOutbox = useCallback((): MessageOutbox => {
74:     const outbox = outboxRef.current;
75:     if (!outbox || outbox.ownerId !== ownerId) {
76:       throw new Error('The message outbox is not ready');
77:     }
78:     return outbox;
79:   }, [ownerId]);
80: 
81:   const queueTextMessage = useCallback(
82:     async (input: OutboxEnqueueInput) => {
83:       await currentOutbox().enqueue(input);
84:     },
85:     [currentOutbox]
86:   );
87:   const retryOutboxMessage = useCallback(
88:     async (clientMessageId: string) => {
89:       await currentOutbox().retry(clientMessageId);
90:     },
91:     [currentOutbox]
92:   );
93:   const discardOutboxMessage = useCallback(
94:     async (clientMessageId: string) => {
95:       await currentOutbox().discard(clientMessageId);
96:     },
97:     [currentOutbox]
98:   );
99:   const cancelOutboxMessage = useCallback(
100:     async (clientMessageId: string) => {
101:       await currentOutbox().cancel(clientMessageId);
102:     },
103:     [currentOutbox]
104:   );
105: 
106:   // T12: read from and act on the outbox database by owner (users.id), so they
107:   // work whether or not this tab's instance has started — only while the
108:   // browser is signed in as the owner (F2: a stale tab's other user gets 0
109:   // and deletes nothing).
110:   const isOwner = useCallback(
111:     async () => (identity ? (await identity.check()) === 'owner' : false),
112:     [identity]
113:   );
114:   const countUnsentOutboxMessages = useCallback(
115:     async () => (ownerId ? countUnsentOutboxItems(ownerId, isOwner) : 0),
116:     [ownerId, isOwner]
117:   );
118:   const resumeOutboxDrains = useCallback(() => {
119:     const outbox = outboxRef.current;
120:     if (outbox && outbox.ownerId === ownerId) outbox.resumeDrains();
121:   }, [ownerId]);
122:   const beginSignOut = useCallback(
123:     () => (ownerId ? beginOutboxSignOut(ownerId, queryClient, isOwner) : null),
124:     [ownerId, queryClient, isOwner]
125:   );
126: 
127:   return useMemo(
128:     () => ({
129:       queueTextMessage,
130:       retryOutboxMessage,
131:       discardOutboxMessage,
132:       cancelOutboxMessage,
133:       countUnsentOutboxMessages,
134:       beginOutboxSignOut: beginSignOut,
135:       resumeOutboxDrains,
136:     }),
137:     [
138:       queueTextMessage,
139:       retryOutboxMessage,
140:       discardOutboxMessage,
141:       cancelOutboxMessage,
142:       countUnsentOutboxMessages,
143:       beginSignOut,
144:       resumeOutboxDrains,
145:     ]
146:   );
147: }

