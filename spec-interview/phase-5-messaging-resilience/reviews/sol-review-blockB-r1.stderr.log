51: function composerInput(page: Page) {
52:   return page
53:     .locator('[data-testid="composer"]')
54:     .or(page.locator('[data-testid="message-composer"]'))
55:     .locator('textarea, input[type="text"]')
56:     .first();
57: }
58: 
59: async function createAs(page: Page, conversationId: string, content: string): Promise<string> {
60:   const response = await page.request.post('/api/messages/create', { data: { conversationId, content } });
61:   const body = (await response.json().catch(() => null)) as { message?: { id?: string } } | null;
62:   expect(response.status(), JSON.stringify(body)).toBe(201);
63:   expect(body?.message?.id).toBeTruthy();
64:   return body?.message?.id as string;
65: }
