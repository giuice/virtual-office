67: /** Records A's conversation-list fetches (the list stream's invalidation effect). */
68: function recordListFetches(page: Page): () => number[] {
69:   const fetchedAt: number[] = [];
70:   page.on('request', (request) => {
71:     if (request.method() === 'GET' && new URL(request.url()).pathname === '/api/conversations/get') {
72:       fetchedAt.push(Date.now());
73:     }
74:   });
75:   return () => [...fetchedAt];
76: }
