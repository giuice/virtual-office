43: async function openConversation(page: Page, conversationId: string): Promise<void> {
44:   await page.goto('/floor-plan');
45:   await page.waitForLoadState('networkidle');
46:   await openDrawer(page);
47:   await waitForRealtimeReady(page);
48:   await selectConversation(page, { id: conversationId });
49: }
