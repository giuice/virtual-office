 613:   /**
 614:    * True only when `userId` is a member of `conversationId` and every member
 615:    * of that conversation (including `userId`) has one of `allowedEmails` — the
 616:    * shape of every conversation this seeder creates. Unknown ids are false.
 617:    */
 618:   async isSeededConversationMember(
 619:     conversationId: string,
 620:     userId: string,
 621:     allowedEmails: ReadonlySet<string>,
 622:   ): Promise<boolean> {
 623:     if (allowedEmails.size === 0) {
 624:       return false;
 625:     }
 626: 
 627:     const { data: members, error: membersError } = await this.supabase
 628:       .from('conversation_members')
 629:       .select('user_id')
 630:       .eq('conversation_id', conversationId)
 631:       .overrideTypes<Array<{ user_id: string }>, { merge: false }>();
 632:     if (membersError) {
 633:       throw new Error(`Failed to read conversation members: ${membersError.message}`);
 634:     }
 635:     const memberIds = [...new Set((members ?? []).map((member) => member.user_id))];
 636:     if (!memberIds.includes(userId)) {
 637:       return false;
 638:     }
 639: 
 640:     const { data: accounts, error: accountsError } = await this.supabase
 641:       .from('users')
 642:       .select('id, email')
 643:       .in('id', memberIds)
 644:       .overrideTypes<Array<{ id: string; email: string | null }>, { merge: false }>();
 645:     if (accountsError) {
 646:       throw new Error(`Failed to read conversation member accounts: ${accountsError.message}`);
 647:     }
 648:     const emailById = new Map(
 649:       (accounts ?? []).map((account) => [account.id, account.email?.trim().toLowerCase() ?? '']),
 650:     );
 651:     return memberIds.every((id) => allowedEmails.has(emailById.get(id) ?? ''));
