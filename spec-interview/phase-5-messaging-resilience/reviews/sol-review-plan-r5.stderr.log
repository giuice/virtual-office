"C:\\WINDOWS\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" -Command '$reviewLine = 170; Get-Content -LiteralPath 
'"'spec-interview\\phase-5-messaging-resilience\\SPEC.md' -Encoding UTF8 | Select-Object -Skip 170 | ForEach-Object { 
