 600:   async removeConversationMember(conversationId: string, userId: string): Promise<number> {
 601:     const { data, error } = await this.supabase
 602:       .from('conversation_members')
 603:       .delete()
 604:       .eq('conversation_id', conversationId)
 605:       .eq('user_id', userId)
