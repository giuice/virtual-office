   2: // Phase 5 T2: typed calls to the fenced create / fence RPCs
   3: // (migration 20261007095045_message_send_attempt_fencing). Service role only.
   4: import type { PostgrestError, SupabaseClient } from '@supabase/supabase-js';
   5: 
   6: import {
   7:   AttemptSupersededError,
   8:   InsertionRateLimitError,
   9:   MessageDeletedError,
  10:   type ClientMessageKey,
  11: } from '@/repositories/interfaces/IMessageRepository';
  12: import {
  13:   AttachmentLinkError,
  14:   type AttachmentLinkFailureCode,
  15: } from '@/repositories/interfaces/IMessageAttachmentUploadRepository';
  16: import { parseStoredComposition } from '@/lib/messaging/message-composition';
  17: import type {
  18:   InsertionQuota,
  19:   Message,
  20:   MessageAttempt,
  21:   MessageAttemptFenceResult,
  22:   MessageComposition,
  23: } from '@/types/messaging';
  24: 
  25: export interface CreateMessageAttemptInput {
  26:   data: Pick<Message, 'conversationId' | 'senderId' | 'content' | 'type' | 'replyToId'>;
  27:   clientMessageId?: string;
  28:   attempt?: MessageAttempt;
  29:   uploadIds: readonly string[];
  30:   /**
  31:    * Phase 5 T3 (migration 20261007114454): charged by a winning insertion in
  32:    * its own transaction; null = no charge.
  33:    */
  34:   insertQuota: InsertionQuota | null;
  35: }
  36: 
  37: export interface CreateMessageAttemptResult {
  38:   messageId: string;
  39:   created: boolean;
  40:   storedComposition: MessageComposition | null;
  41: }
  42: 
  43: /** Raised by the RPC call; carries the PostgREST error for caller-specific mapping. */
  44: export class MessageAttemptRpcError extends Error {
  45:   constructor(readonly postgrestError: PostgrestError) {
  46:     super(postgrestError.message);
  47:     this.name = 'MessageAttemptRpcError';
  48:   }
  49: }
  50: 
  51: const LINK_FAILURE_CODES: readonly AttachmentLinkFailureCode[] = [
  52:   'ATTACHMENT_UPLOAD_NOT_FOUND',
  53:   'ATTACHMENT_COUNT_INVALID',
  54:   'ATTACHMENT_DUPLICATE',
  55:   'INVALID_REPLY_TARGET',
  56:   'VOICE_NOTE_NOT_ALONE',
  57: ];
  58: 
  59: function isRecord(value: unknown): value is Record<string, unknown> {
  60:   return typeof value === 'object' && value !== null && !Array.isArray(value);
  61: }
  62: 
  63: /**
  64:  * Calls public.create_message_attempt. Throws AttemptSupersededError when the
  65:  * attempt was fenced (nothing stored), MessageDeletedError when a
  66:  * generation-carrying create would recreate a deleted message,
  67:  * InsertionRateLimitError when the winning insertion could not be charged to
  68:  * the insertion quota (exhausted or uncheckable; rolled back),
  69:  * AttachmentLinkError for the
  70:  * database's validation refusals (reply target, membership, uploads), and
  71:  * MessageAttemptRpcError for anything else.
  72:  */
  73: export async function createMessageAttempt(
  74:   client: SupabaseClient,
  75:   input: CreateMessageAttemptInput
  76: ): Promise<CreateMessageAttemptResult> {
  77:   const { data, error } = await client.rpc('create_message_attempt', {
  78:     p_conversation_id: input.data.conversationId,
  79:     p_sender_id: input.data.senderId,
  80:     p_content: input.data.content,
  81:     p_type: input.data.type,
  82:     p_reply_to_id: input.data.replyToId ?? null,
  83:     p_client_message_id: input.clientMessageId ?? null,
  84:     p_attempt_generation: input.attempt?.generation ?? null,
  85:     p_composition: input.clientMessageId && input.attempt ? input.attempt.composition : null,
  86:     p_upload_ids: [...input.uploadIds],
  87:     p_insert_quota_limit: input.insertQuota?.limit ?? null,
  88:     p_insert_quota_window_seconds: input.insertQuota?.windowSeconds ?? null,
  89:   });
  90: 
  91:   if (error) {
  92:     if (error.code === 'P0001' && error.message === 'RATE_LIMITED') {
  93:       throw new InsertionRateLimitError('exceeded');
  94:     }
  95:     if (error.code === 'P0001' && error.message === 'RATE_LIMIT_UNAVAILABLE') {
  96:       console.error('Insertion quota could not be charged in create_message_attempt:', error);
  97:       throw new InsertionRateLimitError('unavailable');
  98:     }
  99:     if (error.message === 'ATTEMPT_SUPERSEDED') {
 100:       throw new AttemptSupersededError();
 101:     }
 102:     if (error.message === 'MESSAGE_DELETED') {
 103:       throw new MessageDeletedError();
 104:     }
 105:     const linkFailure = LINK_FAILURE_CODES.find((code) => error.message === code);
 106:     if (error.code === '22023' && linkFailure) {
 107:       throw new AttachmentLinkError(linkFailure);
 108:     }
 109:     if (error.code === '42501') {
 110:       throw new AttachmentLinkError('NOT_PARTICIPANT');
 111:     }
 112:     console.error('Error in create_message_attempt RPC:', error);
 113:     throw new MessageAttemptRpcError(error);
 114:   }
 115:   if (!isRecord(data) || typeof data.message_id !== 'string' || typeof data.created !== 'boolean') {
 116:     throw new Error('create_message_attempt returned an unexpected result');
 117:   }
 118:   return {
 119:     messageId: data.message_id,
 120:     created: data.created,
 121:     storedComposition: data.created ? null : parseStoredComposition(data.composition),
 122:   };
 123: }
 124: 
 125: /** Calls public.fence_message_attempt. */
 126: export async function fenceMessageAttempt(
 127:   client: SupabaseClient,
 128:   key: ClientMessageKey,
 129:   generation: number
 130: ): Promise<MessageAttemptFenceResult> {
 131:   const { data, error } = await client.rpc('fence_message_attempt', {
 132:     p_sender_id: key.senderId,
 133:     p_conversation_id: key.conversationId,
 134:     p_client_message_id: key.clientMessageId,
 135:     p_attempt_generation: generation,
 136:   });
 137: 
 138:   if (error) {
 139:     if (error.code !== '42501') {
 140:       console.error('Error in fence_message_attempt RPC:', error);
 141:     }
 142:     throw new MessageAttemptRpcError(error);
 143:   }
 144:   if (isRecord(data)) {
 145:     if (data.outcome === 'superseded' || data.outcome === 'not_stored') {
 146:       return { outcome: data.outcome };
 147:     }
 148:     if (data.outcome === 'stored' && (typeof data.message_id === 'string' || data.message_id === null)) {
 149:       return { outcome: 'stored', messageId: data.message_id };
 150:     }
 151:   }
 152:   throw new Error('fence_message_attempt returned an unexpected result');
 153: }

