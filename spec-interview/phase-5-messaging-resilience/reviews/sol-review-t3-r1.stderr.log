 151:   async listLinkedAttachmentIds(messageId: string): Promise<string[]> {
 152:     const { data, error } = await this.supabaseClient
 153:       .from('message_attachments')
 154:       .select('id')
 155:       .eq('message_id', messageId);
 156: 
 157:     if (error) {
 158:       console.error('Error listing message attachments:', error);
 159:       throw error;
 160:     }
 161:     return ((data ?? []) as { id: string }[]).map((row) => row.id);
 162:   }
