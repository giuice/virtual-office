 845:   }
 846: 
 847:   /**
 848:    * Phase 4 FR-021 / BR-009: the caller's starred messages in one
 849:    * conversation, newest MESSAGE first (not star time), keyset-paginated by
 850:    * the feed's composite "{raw_pg_timestamp}|{id}" cursor (`cursorBefore`
 851:    * continues with older messages). Items come back newest-first with full
 852:    * feed enrichment. The caller must authorize conversation membership
 853:    * first; with the user-scoped client, message RLS (member-only) and star
 854:    * RLS (own stars only) also apply.
 855:    */
 856:   async getStarredMessages(
 857:     userId: string,
 858:     conversationId: string,
 859:     options?: Pick<PaginationOptions, 'limit' | 'cursorBefore'>
 860:   ): Promise<PaginatedResult<Message>> {
 861:     const limit = options?.limit ?? 20;
 862: 
 863:     // Driven from the caller's star rows (bounded by how many they starred),
 864:     // with the starred message as an inner to-one embed: filters, ordering
 865:     // and the keyset cursor apply to the MESSAGE columns, so the cursor is
 866:     // the feed's. Driving from messages instead would scan (and evaluate
 867:     // message RLS on) the whole conversation when stars are sparse.
 868:     // messages.conversation_id is authoritative; the denormalized
 869:     // starred_messages.conversation_id only narrows the star scan.
 870:     let query = this.supabaseClient
 871:       .from(this.MESSAGE_STAR_TABLE_NAME)
 872:       .select('message:messages!message_stars_message_id_fkey!inner(*)')
 873:       .eq('user_id', userId)
 874:       .eq('conversation_id', conversationId)
 875:       .eq('message.conversation_id', conversationId);
 876: 
 877:     if (options?.cursorBefore) {
 878:       const { ts, id } = parseCompositeCursor(options.cursorBefore);
 879:       query = id
 880:         ? query.or(`timestamp.lt."${ts}",and(timestamp.eq."${ts}",id.lt."${id}")`, { referencedTable: 'message' 
})
 881:         : query.lt('message.timestamp', ts);
 882:     }
 883: 
 884:     const { data, error } = await query
 885:       .order('message(timestamp)', { ascending: false })
 886:       .order('message(id)', { ascending: false })
 887:       .limit(limit + 1);
 888: 
 889:     if (error) {
 890:       console.error('Error fetching starred messages:', error);
 891:       throw error;
 892:     }
 893: 
 894:     const rows = ((data ?? []) as unknown as Array<{ message: MessageRow }>).map((row) => row.message);
 895:     const hasMore = rows.length > limit;
 896:     const pageRows = hasMore ? rows.slice(0, limit) : rows;
 897:     const items = await this.enrichFeedMessages(mapMessageArrayToCamelCase(pageRows), conversationId);
 898:     // Personal stars only, even if a privileged client is ever passed in.
 899:     items.forEach(message => {
 900:       message.stars = (message.stars ?? []).filter(star => star.userId === userId);
 901:     });
 902: 
 903:     return {
 904:       items,
 905:       hasMore,
 906:       // RAW row timestamp keeps microsecond precision (see findByConversation).
 907:       nextCursor: hasMore ? buildCompositeCursor(pageRows[pageRows.length - 1]) : null,
 908:     };
 909:   }
 910: }
