 175: export class SupabaseMessageRepository implements IMessageRepository {
 176:   private MSG_TABLE_NAME = 'messages'; // Ensure this matches your Supabase table name
 177:   private REACTION_TABLE_NAME = 'message_reactions'; // Assuming separate table
 178:   private ATTACHMENT_TABLE_NAME = 'message_attachments'; // Assuming separate table
 179:   private READ_RECEIPT_TABLE_NAME = 'message_read_receipts'; // Read receipts table
 180:   private MESSAGE_PIN_TABLE_NAME = 'pinned_messages'; // Message pins table
 181:   private MESSAGE_STAR_TABLE_NAME = 'starred_messages'; // Message stars table
 182:   private supabaseClient: SupabaseClient;
 183: 
 184:   constructor(supabaseClient: SupabaseClient) {
 185:     this.supabaseClient = supabaseClient;
 186:   }
 187: 
 188:   private async enrichMessages(messages: Message[]): Promise<Message[]> {
 189:     if (messages.length === 0) {
 190:       return messages;
 191:     }
 192: 
 193:     const messageIds = messages.map(m => m.id);
 194: 
 195:     const { data: attachmentsData } = await this.supabaseClient
 196:       .from(this.ATTACHMENT_TABLE_NAME)
 197:       .select('*')
 198:       .in('message_id', messageIds);
 199: 
 200:     const attachmentsByMessageId = (attachmentsData as AttachmentRow[] | null || []).reduce((acc: Record<string, 
FileAttachment[]>, row: AttachmentRow) => {
 201:       const msgId = row.message_id as string;
 202:       if (!acc[msgId]) acc[msgId] = [];
 203:       acc[msgId].push(mapAttachmentToCamelCase(row));
 204:       return acc;
 205:     }, {} as Record<string, FileAttachment[]>);
 206: 
 207:     const { data: reactionsData } = await this.supabaseClient
 208:       .from(this.REACTION_TABLE_NAME)
 209:       .select('*')
 210:       .in('message_id', messageIds);
 211: 
 212:     const reactionsByMessageId = (reactionsData as ReactionRow[] | null || []).reduce((acc: Record<string, 
MessageReaction[]>, row: ReactionRow) => {
 213:       const msgId = row.message_id as string;
 214:       if (!acc[msgId]) acc[msgId] = [];
 215:       acc[msgId].push(mapReactionToCamelCase(row));
 216:       return acc;
 217:     }, {} as Record<string, MessageReaction[]>);
 218: 
 219:     messages.forEach(message => {
 220:       message.attachments = attachmentsByMessageId[message.id] || [];
 221:       message.reactions = reactionsByMessageId[message.id] || [];
 222:     });
 223: 
 224:     return messages;
 225:   }
 226: 
 227:   // Full feed enrichment shared by the paginated feed and the starred list
 228:   // (Phase 4 FR-021): attachments, reactions, pins, the viewer's stars
 229:   // (star RLS returns only the caller's own rows), readCount and the derived
 230:   // READ status. Routes still strip readCount from messages the viewer did
 231:   // not send (FR-003).
 232:   private async enrichFeedMessages(messages: Message[], conversationId: string): Promise<Message[]> {
 233:     if (messages.length === 0) {
 234:       return messages;
 235:     }
 236: 
 237:     const messageIds = messages.map(m => m.id);
 238:     const enrichedMessages = await this.enrichMessages(messages);
 239: 
 240:     // Fetch all pins for these messages in bulk
 241:     const { data: pinsData, error: pinsError } = await this.supabaseClient
 242:       .from(this.MESSAGE_PIN_TABLE_NAME)
 243:       .select('*')
 244:       .in('message_id', messageIds);
 245: 
 246:     if (pinsError) {
 247:       console.error(`Error fetching pins for conversation ${conversationId}:`, pinsError);
 248:     }
 249:     const pinsByMessageId = (pinsData as MessagePinRow[] | null || []).reduce((acc: Record<string, 
MessagePin[]>, row: MessagePinRow) => {
 250:       const msgId = row.message_id;
 251:       if (!acc[msgId]) acc[msgId] = [];
 252:       acc[msgId].push(mapMessagePinToCamelCase(row));
 253:       return acc;
 254:     }, {} as Record<string, MessagePin[]>);
 255: 
 256:     // Fetch all stars for these messages in bulk
 257:     const { data: starsData, error: starsError } = await this.supabaseClient
 258:       .from(this.MESSAGE_STAR_TABLE_NAME)
 259:       .select('*')
 260:       .in('message_id', messageIds);
 261: 
 262:     if (starsError) {
 263:       console.error(`Error fetching stars for conversation ${conversationId}:`, starsError);
 264:     }
 265:     const starsByMessageId = (starsData as MessageStarRow[] | null || []).reduce((acc: Record<string, 
MessageStar[]>, row: MessageStarRow) => {
 266:       const msgId = row.message_id;
 267:       if (!acc[msgId]) acc[msgId] = [];
 268:       acc[msgId].push(mapMessageStarToCamelCase(row));
 269:       return acc;
 270:     }, {} as Record<string, MessageStar[]>);
 271: 
 272:     // Audit B-05/Phase 2.2: messages.status is frozen at 'sent' in the DB;
 273:     // the read indicator derives from message_read_receipts. Rule: read if
 274:     // ANY non-sender receipt exists (receipts are only ever written for
 275:     // non-senders). Phase 4 FR-001: readCount is the number of distinct
 276:     // non-sender readers ("Lida por N"); (message_id, user_id) is unique, so
 277:     // counting rows counts readers. Receipt RLS returns every reader's row
 278:     // only to the message's sender (anyone else sees just their own), so the
 279:     // count is exact for the viewer's own messages — the only ones it is
 280:     // shown on.
 281:     const { data: receiptsData, error: receiptsError } = await this.supabaseClient
 282:       .from(this.READ_RECEIPT_TABLE_NAME)
 283:       .select('message_id, user_id')
 284:       .in('message_id', messageIds);
 285: 
 286:     if (receiptsError) {
 287:       console.error(`Error fetching read receipts for conversation ${conversationId}:`, receiptsError);
 288:     }
 289:     const senderByMessageId = new Map(enrichedMessages.map(message => [message.id, message.senderId]));
 290:     const readCountByMessageId = new Map<string, number>();
 291:     for (const row of (receiptsData || []) as Array<{ message_id: string; user_id: string }>) {
 292:       if (row.user_id === senderByMessageId.get(row.message_id)) continue;
 293:       readCountByMessageId.set(row.message_id, (readCountByMessageId.get(row.message_id) ?? 0) + 1);
 294:     }
 295: 
 296:     enrichedMessages.forEach(message => {
 297:       message.pins = pinsByMessageId[message.id] || [];
 298:       message.stars = starsByMessageId[message.id] || [];
 299:       message.readCount = readCountByMessageId.get(message.id) ?? 0;
 300:       if (message.readCount > 0 && message.status !== MessageStatus.FAILED) {
 301:         message.status = MessageStatus.READ;
 302:       }
 303:     });
 304: 
 305:     return enrichedMessages;
 306:   }
