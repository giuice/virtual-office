 697:   // --- Read Receipt Methods ---
 698:   // Receipts are written exclusively by the service_role-only RPCs
 699:   // mark_conversation_read / mark_messages_read (PATCH /api/conversations/read).
 700: 
 701:   async getMessageReaders(messageId: string, senderId: string): Promise<MessageReader[]> {
 702:     // One query: receipts joined with the reader's users row, most recent
 703:     // first. The sender's own receipt is excluded defensively (BR-002: the
 704:     // RPCs never write one). Callers must have verified the requester IS the
 705:     // sender (BR-003); on a user-scoped client RLS enforces it again.
 706:     const { data, error } = await this.supabaseClient
 707:       .from(this.READ_RECEIPT_TABLE_NAME)
 708:       .select('user_id, read_at, reader:users!message_read_receipts_user_id_fkey(display_name, avatar_url)')
 709:       .eq('message_id', messageId)
 710:       .neq('user_id', senderId)
 711:       .order('read_at', { ascending: false })
 712:       .order('user_id', { ascending: true })
 713:       .overrideTypes<MessageReaderRow[], { merge: false }>();
 714: 
 715:     if (error) {
 716:       console.error('Error fetching message readers:', error);
 717:       throw error;
 718:     }
 719: 
 720:     return (data ?? []).map((row) => ({
 721:       userId: row.user_id,
 722:       displayName: row.reader?.display_name ?? null,
 723:       avatarUrl: row.reader?.avatar_url ?? null,
 724:       readAt: new Date(row.read_at),
 725:     }));
 726:   }
 727: 
 728:   // --- Message Pin Methods ---
 729: 
 730:   async pinMessage(messageId: string, conversationId: string, userId: string): Promise<MessagePin> {
 731:     const dbData = {
 732:       message_id: messageId,
 733:       conversation_id: conversationId,
 734:       pinned_by: userId, // user_id renamed to pinned_by
 735:       pinned_at: new Date().toISOString()
 736:     };
 737: 
 738:     const { data, error } = await this.supabaseClient
 739:       .from(this.MESSAGE_PIN_TABLE_NAME)
 740:       .upsert(dbData, { onConflict: 'message_id, pinned_by' }) // Updated conflict target (was user_id)
 741:       .select()
 742:       .single();
 743: 
 744:     if (error || !data) {
 745:       console.error('Error pinning message:', error);
 746:       throw error || new Error('Failed to pin message or retrieve created data.');
 747:     }
 748: 
 749:     return mapMessagePinToCamelCase(data);
 750:   }
 751: 
 752:   async unpinMessage(messageId: string, userId: string): Promise<boolean> {
 753:     const { error, count } = await this.supabaseClient
 754:       .from(this.MESSAGE_PIN_TABLE_NAME)
 755:       .delete({ count: 'exact' })
 756:       .eq('message_id', messageId)
 757:       .eq('pinned_by', userId); // Ensure user owns the pinned_by
 758: 
 759:     if (error) {
 760:       console.error('Error unpinning message:', error);
 761:       return false;
 762:     }
 763: 
 764:     return (count ?? 0) > 0;
 765:   }
