 194:   /**
 195:    * Holds FOR UPDATE on a message row from a separate connection: a create
 196:    * replying to it blocks inside its INSERT (the reply_to_id foreign-key
 197:    * check needs FOR KEY SHARE on that row) until `release`.
 198:    */
 199:   async function lockMessageRow(messageId: string) {
 200:     const holder = new Client({ connectionString: MESSAGING_DB_URL });
 201:     await holder.connect();
 202:     await holder.query('begin');
 203:     await holder.query('select id from public.messages where id = $1 for update', [messageId]);
 204:     const pid = (await holder.query<{ pid: number }>('select pg_backend_pid() as pid')).rows[0].pid;
 205:     let released = false;
 206:     return {
 207:       pid,
 208:       async release() {
 209:         if (released) return;
 210:         released = true;
 211:         await holder.query('rollback').catch(() => undefined);
 212:         await holder.end();
 213:       },
 214:     };
 215:   }
