 435: -- Fence / lookup.
 436: -- ============================================================================
 437: create or replace function public.fence_message_attempt(
 438:   p_sender_id uuid,
 439:   p_conversation_id uuid,
 440:   p_client_message_id uuid,
 441:   p_attempt_generation bigint
 442: )
 443: returns jsonb
 444: language plpgsql
 445: security invoker
 446: set search_path = ''
 447: as $$
 448: declare
 449:   v_generation bigint;
 450:   v_committed_at timestamptz;
 451:   v_message_id uuid;
 452: begin
 453:   if p_sender_id is null or p_conversation_id is null or p_client_message_id is null or p_attempt_generation is 
null then
 454:     raise exception 'fence_message_attempt: sender, conversation, key and generation are required'
 455:       using errcode = '22004';
 456:   end if;
 457:   if p_attempt_generation < 1 then
 458:     raise exception 'ATTEMPT_GENERATION_INVALID' using errcode = '22023';
 459:   end if;
 460: 
 461:   -- Defense in depth: the route already required membership.
 462:   if not exists (
 463:     select 1
 464:     from public.conversation_members cm
 465:     where cm.conversation_id = p_conversation_id
 466:       and cm.user_id = p_sender_id
 467:   ) then
 468:     raise exception 'fence_message_attempt: sender is not a member of the conversation'
 469:       using errcode = '42501';
 470:   end if;
 471: 
 472:   insert into private.message_send_attempts (sender_id, conversation_id, client_message_id)
 473:   values (p_sender_id, p_conversation_id, p_client_message_id)
 474:   on conflict (sender_id, conversation_id, client_message_id) do nothing;
 475: 
 476:   select a.fence_generation, a.committed_at into v_generation, v_committed_at
 477:   from private.message_send_attempts a
 478:   where a.sender_id = p_sender_id
 479:     and a.conversation_id = p_conversation_id
 480:     and a.client_message_id = p_client_message_id
 481:   for update;
 482: 
 483:   if v_generation is not null and p_attempt_generation < v_generation then
 484:     return pg_catalog.jsonb_build_object('outcome', 'superseded', 'current_generation', v_generation);
 485:   end if;
 486: 
 487:   if v_generation is null or p_attempt_generation > v_generation then
 488:     update private.message_send_attempts a
 489:     set fence_generation = p_attempt_generation,
 490:         updated_at = pg_catalog.now()
 491:     where a.sender_id = p_sender_id
 492:       and a.conversation_id = p_conversation_id
 493:       and a.client_message_id = p_client_message_id;
 494:   end if;
 495: 
 496:   -- A new statement (new snapshot) after the row lock: a create that held the
 497:   -- lock has committed by now and its message is visible.
 498:   select m.id into v_message_id
 499:   from public.messages m
 500:   where m.sender_id = p_sender_id
 501:     and m.conversation_id = p_conversation_id
 502:     and m.client_message_id = p_client_message_id;
 503: 
 504:   if v_message_id is not null then
 505:     -- Delivery record, still under the key lock: a message the row does not
 506:     -- track yet (written before this migration) is recorded now, so its later
 507:     -- deletion is never reported as not stored.
 508:     update private.message_send_attempts a
 509:     set message_id = v_message_id,
 510:         committed_at = coalesce(a.committed_at, pg_catalog.now()),
 511:         composition = case when a.message_id = v_message_id then a.composition end,
 512:         updated_at = pg_catalog.now()
 513:     where a.sender_id = p_sender_id
 514:       and a.conversation_id = p_conversation_id
 515:       and a.client_message_id = p_client_message_id
 516:       and (a.message_id is distinct from v_message_id or a.committed_at is null);
 517:   end if;
 518: 
 519:   if v_message_id is not null or v_committed_at is not null then
 520:     -- message_id is null when the committed message was deleted since.
 521:     return pg_catalog.jsonb_build_object('outcome', 'stored', 'message_id', v_message_id);
 522:   end if;
 523:   return pg_catalog.jsonb_build_object('outcome', 'not_stored');
 524: end
 525: $$;
