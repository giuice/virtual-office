 308:   async findById(id: string): Promise<Message | null> {
 309:     const { data, error } = await this.supabaseClient
 310:       .from(this.MSG_TABLE_NAME)
 311:       .select('*') // TODO: Select related reactions/attachments if needed
 312:       .eq('id', id)
 313:       .single();
 314: 
 315:     if (error && error.code !== 'PGRST116') {
 316:       console.error('Error fetching message by ID:', error);
 317:       throw error;
 318:     }
 319: 
 320:     if (!data) {
 321:       return null;
 322:     }
 323: 
 324:     // Map the core message data
 325:     const message = mapMessageToCamelCase(data);
 326: 
 327:     const [
 328:       { data: attachmentsData, error: attachmentsError },
 329:       { data: reactionsData, error: reactionsError },
 330:       { data: pinsData, error: pinsError },
 331:       { data: starsData, error: starsError }
 332:     ] = await Promise.all([
 333:       this.supabaseClient
 334:         .from(this.ATTACHMENT_TABLE_NAME)
 335:         .select('*')
 336:         .eq('message_id', message.id),
 337:       this.supabaseClient
 338:         .from(this.REACTION_TABLE_NAME)
 339:         .select('*')
 340:         .eq('message_id', message.id),
 341:       this.supabaseClient
 342:         .from(this.MESSAGE_PIN_TABLE_NAME)
 343:         .select('*')
 344:         .eq('message_id', message.id),
 345:       this.supabaseClient
 346:         .from(this.MESSAGE_STAR_TABLE_NAME)
 347:         .select('*')
 348:         .eq('message_id', message.id)
 349:     ]);
 350: 
 351:     if (attachmentsError) {
 352:       console.error(`Error fetching attachments for message ID ${message.id}:`, attachmentsError);
 353:       // Decide if you want to throw or return message without attachments
 354:       // For now, return message with empty attachments array on error
 355:       message.attachments = [];
 356:     } else {
 357:       message.attachments = mapAttachmentArrayToCamelCase(attachmentsData || []);
 358:     }
 359: 
 360:     if (reactionsError) {
 361:       console.error(`Error fetching reactions for message ID ${message.id}:`, reactionsError);
 362:       // Return message with empty reactions array on error
 363:       message.reactions = [];
 364:     } else {
 365:       message.reactions = mapReactionArrayToCamelCase(reactionsData || []);
 366:     }
 367: 
 368:     if (pinsError) {
 369:       console.error(`Error fetching pins for message ID ${message.id}:`, pinsError);
 370:       message.pins = [];
 371:     } else {
 372:       // Map pins
 373:       message.pins = (pinsData as MessagePinRow[] | null || []).map((p: MessagePinRow) => 
mapMessagePinToCamelCase(p));
 374:     }
 375: 
 376:     if (starsError) {
 377:       console.error(`Error fetching stars for message ID ${message.id}:`, starsError);
 378:       message.stars = [];
 379:     } else {
 380:       // Map stars
 381:       message.stars = (starsData as MessageStarRow[] | null || []).map((s: MessageStarRow) => 
mapMessageStarToCamelCase(s));
 382:     }
 383: 
 384:     return message;
 385:   }
