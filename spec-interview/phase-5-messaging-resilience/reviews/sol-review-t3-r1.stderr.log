   1: -- Phase 3.4 (messaging audit 2026-06-10, M-09) — per-user rate limiting for
   2: -- messaging mutations (create / react / upload).
   3: --
   4: -- Fixed-window counters in Postgres: no new infra, serverless-safe (every
   5: -- Next.js instance shares the same counter). The function is SECURITY
   6: -- DEFINER and executable by service_role ONLY — it takes the target user id
   7: -- as a parameter, so an authenticated caller could otherwise exhaust another
   8: -- user's quota on purpose. API routes call it through the service client
   9: -- AFTER the authz check, passing the authenticated user's DB id.
  10: --
  11: -- Re-runnable: create table if not exists; function is CREATE OR REPLACE.
  12: 
  13: create table if not exists private.rate_limit_counters (
  14:   user_id uuid not null,
  15:   action text not null,
  16:   window_start timestamptz not null,
  17:   count integer not null default 0,
  18:   primary key (user_id, action, window_start)
  19: );
  20: 
  21: alter table private.rate_limit_counters enable row level security;
  22: -- No policies on purpose: only the SECURITY DEFINER function (and
  23: -- service_role) touch this table.
  24: 
  25: -- Lives in public (PostgREST does not expose the private schema for RPC) but
  26: -- is executable by service_role only — same pattern as mark_conversation_read.
  27: create or replace function public.check_rate_limit(
  28:   p_user_id uuid,
  29:   p_action text,
  30:   p_limit integer,
  31:   p_window_seconds integer
  32: ) returns boolean
  33: language plpgsql
  34: security definer
  35: set search_path = ''
  36: as $$
  37: declare
  38:   v_window_start timestamptz;
  39:   v_count integer;
  40: begin
  41:   v_window_start := to_timestamp(
  42:     floor(extract(epoch from now()) / p_window_seconds) * p_window_seconds
  43:   );
  44: 
  45:   insert into private.rate_limit_counters as c (user_id, action, window_start, count)
  46:   values (p_user_id, p_action, v_window_start, 1)
  47:   on conflict (user_id, action, window_start)
  48:   do update set count = c.count + 1
  49:   returning count into v_count;
  50: 
  51:   -- Opportunistic cleanup of this user's expired windows (PK-indexed, cheap).
  52:   delete from private.rate_limit_counters
  53:   where user_id = p_user_id
  54:     and action = p_action
  55:     and window_start < v_window_start;
  56: 
  57:   return v_count <= p_limit;
  58: end;
  59: $$;
  60: 
  61: revoke all on function public.check_rate_limit(uuid, text, integer, integer) from public;
  62: revoke all on function public.check_rate_limit(uuid, text, integer, integer) from anon, authenticated;
  63: grant execute on function public.check_rate_limit(uuid, text, integer, integer) to service_role;
