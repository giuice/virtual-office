 372: -- ============================================================================
 373: -- Replay answer (internal): stored message id + its recorded composition.
 374: -- A generation-carrying replay older than the key's fence generation is
 375: -- refused; a generation-less replay always answers (Phase 4 contract).
 376: -- ============================================================================
 377: create or replace function private.message_attempt_replay(
 378:   p_sender_id uuid,
 379:   p_conversation_id uuid,
 380:   p_client_message_id uuid,
 381:   p_attempt_generation bigint,
 382:   p_message_id uuid
 383: )
 384: returns jsonb
 385: language plpgsql
 386: security invoker
 387: set search_path = ''
 388: as $$
 389: declare
 390:   v_generation bigint;
 391:   v_composition jsonb;
 392: begin
 393:   -- Delivery record (FR-006): a replay that finds a message the key row does
 394:   -- not track yet records it under the key lock, so a later deletion is never
 395:   -- mistaken for "not stored". A composition recorded for another message is
 396:   -- discarded (it was not this message's).
 397:   insert into private.message_send_attempts as a
 398:     (sender_id, conversation_id, client_message_id, committed_at, message_id)
 399:   values (p_sender_id, p_conversation_id, p_client_message_id, pg_catalog.now(), p_message_id)
 400:   on conflict (sender_id, conversation_id, client_message_id) do update
 401:     set message_id = excluded.message_id,
 402:         committed_at = coalesce(a.committed_at, excluded.committed_at),
 403:         composition = case when a.message_id = excluded.message_id then a.composition end,
 404:         updated_at = pg_catalog.now()
 405:     where a.message_id is distinct from excluded.message_id or a.committed_at is null;
 406: 
 407:   select a.fence_generation, case when a.message_id = p_message_id then a.composition end
 408:   into v_generation, v_composition
 409:   from private.message_send_attempts a
 410:   where a.sender_id = p_sender_id
 411:     and a.conversation_id = p_conversation_id
 412:     and a.client_message_id = p_client_message_id;
 413: 
 414:   if p_attempt_generation is not null and v_generation is not null and p_attempt_generation < v_generation then
 415:     raise exception 'ATTEMPT_SUPERSEDED' using errcode = 'P0001';
 416:   end if;
 417: 
 418:   return pg_catalog.jsonb_build_object(
 419:     'message_id', p_message_id,
 420:     'created', false,
 421:     'composition', v_composition
 422:   );
 423: end
