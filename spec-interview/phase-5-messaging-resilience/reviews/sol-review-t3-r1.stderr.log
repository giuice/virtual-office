 118:   async deleteStaleOwned(uploaderId: string, olderThan: Date, limit: number): Promise<PendingAttachmentUpload[]> 
{
 119:     const cutoff = olderThan.toISOString();
 120:     const { data: candidates, error: selectError } = await this.supabaseClient
 121:       .from(this.TABLE_NAME)
 122:       .select('id')
 123:       .eq('uploader_id', uploaderId)
 124:       .lt('created_at', cutoff)
 125:       .order('created_at', { ascending: true })
 126:       .limit(limit);
 127: 
 128:     if (selectError) {
 129:       console.error('Error listing stale pending attachment uploads:', selectError);
 130:       throw selectError;
 131:     }
 132:     const ids = ((candidates ?? []) as { id: string }[]).map((row) => row.id);
 133:     if (ids.length === 0) return [];
 134: 
 135:     // Re-filter on delete: a row linked or cancelled meanwhile is not returned.
 136:     const { data, error } = await this.supabaseClient
 137:       .from(this.TABLE_NAME)
 138:       .delete()
 139:       .in('id', ids)
 140:       .eq('uploader_id', uploaderId)
 141:       .lt('created_at', cutoff)
 142:       .select(COLUMNS);
 143: 
 144:     if (error) {
 145:       console.error('Error deleting stale pending attachment uploads:', error);
 146:       throw error;
 147:     }
 148:     return ((data ?? []) as PendingUploadRow[]).map(mapRow);
 149:   }
