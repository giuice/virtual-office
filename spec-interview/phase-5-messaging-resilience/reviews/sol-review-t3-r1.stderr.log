  40:   storagePath: string;
  41:   name: string;
  42:   type: string;
  43:   size: number;
  44:   createdAt: Date;
  45:   /** Voice notes only (Phase 4 T15): whole seconds, 1-120. */
  46:   duration?: number;
  47:   /** Voice notes only: 1-256 amplitudes in [0, 1]. */
  48:   waveformData?: number[];
  49: }
  50: 
  51: /** Outcome of creating a message together with its attachments. */
  52: export interface MessageWithAttachmentsCreateResult {
  53:   messageId: string;
  54:   created: boolean;
  55:   /**
  56:    * Phase 5 T2: on a replay (created: false), the original composition
  57:    * recorded when the message was created under its key; null when none was
  58:    * recorded (keyed messages created before Phase 5).
  59:    */
  60:   storedComposition?: MessageComposition | null;
  61: }
  62: 
  63: /**
  64:  * Phase 5 T2 (FR-024): the original submitted composition of a keyed create,
  65:  * normalized by the create route, which replays of the same key are compared
  66:  * against. `type` is null for attachment messages (their type derives from
  67:  * the attachments); `attachmentIds` is sorted. Requested mention ids (T4) are
  68:  * added as an optional sorted array; a stored composition without them means
  69:  * none were requested.
  70:  */
  71: export interface MessageComposition {
  72:   content: string;
  73:   type: MessageType | null;
  74:   replyToId: string | null;
  75:   attachmentIds: string[];
  76: }
  77: 
  78: /**
  79:  * Phase 5 T2 (FR-006): one dispatch of a keyed composition. `generation` is
  80:  * monotonic per (sender, conversation, clientMessageId); absent for Phase 4
  81:  * clients, whose keyed creates commit only while the key has no fence state.
  82:  */
  83: export interface MessageAttempt {
  84:   generation?: number;
  85:   composition: MessageComposition;
  86: }
  87: 
  88: /**
  89:  * Phase 5 T3 (FR-008, D1): the sender's message insertion quota (at most
  90:  * `limit` stored messages per fixed `windowSeconds` window). The database
  91:  * charges it in the transaction of a winning insertion only; replays, lost
  92:  * same-key races and refused creates never consume it.
  93:  */
  94: export interface InsertionQuota {
  95:   limit: number;
  96:   windowSeconds: number;
  97: }
  98: 
  99: /**
 100:  * Phase 5 T2: result of fencing/looking up the caller's own key. `superseded`
 101:  * means a newer generation exists (nothing was changed). `stored` with a null
 102:  * messageId: a message was committed under the key and deleted since.
 103:  */
 104: export type MessageAttemptFenceResult =
 105:   | { outcome: 'superseded' }
 106:   | { outcome: 'stored'; messageId: string | null }
 107:   | { outcome: 'not_stored' };
