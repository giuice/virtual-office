 132: // attachments live in their own tables.
 133: function toMessageInsertRow(messageData: MessageCreateData) {
 134:   return {
 135:     conversation_id: messageData.conversationId,
 136:     sender_id: messageData.senderId,
 137:     content: messageData.content,
 138:     type: messageData.type,
 139:     status: messageData.status,
 140:     reply_to_id: messageData.replyToId,
 141:   };
 142: }
 143: 
 144: function mapCreatedMessage(row: MessageRow): Message {
 145:   const message = mapMessageToCamelCase(row);
 146:   message.reactions = message.reactions || [];
 147:   message.attachments = message.attachments || [];
 148:   return message;
 149: }
 150: 
 151: function mapMessageArrayToCamelCase(dataArray: MessageRow[]): Message[] {
 152:   if (!dataArray) return [];
 153:   return dataArray.map(item => mapMessageToCamelCase(item));
 154: }
 155: function mapAttachmentArrayToCamelCase(dataArray: AttachmentFields[]): FileAttachment[] {
 156:   if (!dataArray) return [];
 157:   return dataArray.map(item => mapAttachmentToCamelCase(item));
 158: }
 159: function mapReactionArrayToCamelCase(dataArray: { emoji: string; user_id: string; timestamp: string }[]): 
MessageReaction[] {
 160:   if (!dataArray) return [];
 161:   return dataArray.map(item => mapReactionToCamelCase(item));
 162: }
 163: 
 164: type AttachmentRow = AttachmentFields & { message_id: string };
 165: type ReactionRow = { message_id: string; user_id: string; emoji: string; timestamp: string };
 166: type MessagePinRow = { id: string; message_id: string; conversation_id: string; pinned_by: string; pinned_at: 
string };
 167: type MessageStarRow = { id: string; message_id: string; conversation_id: string; user_id: string; starred_at: 
string };
 168: type MessageReaderRow = {
 169:   user_id: string;
 170:   read_at: string;
 171:   reader: { display_name: string | null; avatar_url: string | null } | null;
 172: };
