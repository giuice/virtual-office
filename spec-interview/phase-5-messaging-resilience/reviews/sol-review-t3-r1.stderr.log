  19: function parseCompositeCursor(cursor: string): { ts: string; id: string | null } {
  20:   const sep = cursor.indexOf('|');
  21:   if (sep === -1) {
  22:     return { ts: cursor, id: null };
  23:   }
  24:   return { ts: cursor.slice(0, sep), id: cursor.slice(sep + 1) };
