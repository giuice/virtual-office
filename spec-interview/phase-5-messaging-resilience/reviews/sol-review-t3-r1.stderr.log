  31: /**
  32:  * A file uploaded for a conversation and not yet linked to a sent message
  33:  * (Phase 4 T12). Visible to no one; `id` becomes the attachment id when the
  34:  * message is created with it, or it is removed by cancelling the upload.
  35:  */
  36: export interface PendingAttachmentUpload {
  37:   id: string;
  38:   conversationId: string;
