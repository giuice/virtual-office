  12: // Composite keyset cursor "{raw_pg_timestamp}|{id}" (audit M-03). The raw
  13: // Postgres timestamp keeps microsecond precision; the id breaks ties between
  14: // equal timestamps. Legacy timestamp-only cursors parse with id = null.
  15: function buildCompositeCursor(row: { timestamp: string; id: string }): string {
  16:   return `${row.timestamp}|${row.id}`;
