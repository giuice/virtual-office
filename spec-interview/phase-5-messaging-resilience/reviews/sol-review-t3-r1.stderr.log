 767:   async getPinnedMessages(conversationId: string, _userId: string): Promise<Message[]> {
 768:     // First, get the pinned message IDs for this conversation (shared pins)
 769:     const { data: pinsData, error: pinsError } = await this.supabaseClient
 770:       .from(this.MESSAGE_PIN_TABLE_NAME)
 771:       .select('message_id')
 772:       .eq('conversation_id', conversationId);
 773:     // .eq('user_id', userId); // Removed user_id filter for shared pins
 774: 
 775:     if (pinsError) {
 776:       console.error('Error fetching pinned message IDs:', pinsError);
 777:       throw pinsError;
 778:     }
 779: 
 780:     if (!pinsData || pinsData.length === 0) {
 781:       return [];
 782:     }
 783: 
 784:     const pinnedMessageIds = pinsData.map((p: any) => p.message_id);
 785: 
 786:     // Fetch the actual messages
 787:     const { data: messagesData, error: messagesError } = await this.supabaseClient
 788:       .from(this.MSG_TABLE_NAME)
 789:       .select('*')
 790:       .eq('conversation_id', conversationId)
 791:       .in('id', pinnedMessageIds)
 792:       .order('timestamp', { ascending: false });
 793: 
 794:     if (messagesError) {
 795:       console.error('Error fetching pinned messages:', messagesError);
 796:       throw messagesError;
 797:     }
 798: 
 799:     if (!messagesData || messagesData.length === 0) {
 800:       return [];
 801:     }
 802: 
 803:     // Map to Message objects
 804:     const messages = mapMessageArrayToCamelCase(messagesData);
 805:     return this.enrichMessages(messages);
 806:   }
