 164:   async createMessageWithAttachments(
 165:     data: MessageWithAttachmentsCreateData,
 166:     uploadIds: readonly string[],
 167:     clientMessageId: string | undefined,
 168:     attempt: MessageAttempt | undefined,
 169:     insertQuota: InsertionQuota | null
 170:   ): Promise<MessageWithAttachmentsCreateResult> {
 171:     // Phase 5 T2: public.create_message_attempt (fenced at commit time) took
 172:     // over create_message_with_attachments' body; that function now delegates
 173:     // to it for older builds. Without uploads it would create a text message.
 174:     if (uploadIds.length === 0) {
 175:       throw new AttachmentLinkError('ATTACHMENT_COUNT_INVALID');
 176:     }
 177:     const result = await createMessageAttempt(this.supabaseClient, {
 178:       data,
 179:       clientMessageId,
 180:       attempt,
 181:       uploadIds,
 182:       insertQuota,
 183:     });
 184:     return { messageId: result.messageId, created: result.created, storedComposition: result.storedComposition };
 185:   }
