 810:   async starMessage(messageId: string, conversationId: string, userId: string): Promise<MessageStar> {
 811:     const dbData = {
 812:       message_id: messageId,
 813:       conversation_id: conversationId,
 814:       user_id: userId,
 815:       starred_at: new Date().toISOString()
 816:     };
 817: 
 818:     const { data, error } = await this.supabaseClient
 819:       .from(this.MESSAGE_STAR_TABLE_NAME)
 820:       .upsert(dbData, { onConflict: 'message_id, user_id' })
 821:       .select()
 822:       .single();
 823: 
 824:     if (error || !data) {
 825:       console.error('Error starring message:', error);
 826:       throw error || new Error('Failed to star message or retrieve created data.');
 827:     }
 828: 
 829:     return mapMessageStarToCamelCase(data);
 830:   }
 831: 
 832:   async unstarMessage(messageId: string, userId: string): Promise<boolean> {
 833:     const { error, count } = await this.supabaseClient
 834:       .from(this.MESSAGE_STAR_TABLE_NAME)
 835:       .delete({ count: 'exact' })
 836:       .eq('message_id', messageId)
 837:       .eq('user_id', userId);
 838: 
 839:     if (error) {
