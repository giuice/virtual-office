 387:   async findByConversation(conversationId: string, options?: PaginationOptions): 
Promise<PaginatedResult<Message>> {
 388:     const limit = options?.limit ?? 50; // Default limit for messages
 389: 
 390:     // Keyset pagination by timestamp when provided
 391:     const hasCursorBefore = !!options?.cursorBefore;
 392:     const hasCursorAfter = !!options?.cursorAfter;
 393: 
 394:     let data: any[] | null = null;
 395:     let error: any | null = null;
 396: 
 397:     if (hasCursorBefore || hasCursorAfter) {
 398:       // Use keyset pagination - fetch limit + 1 to check for more results.
 399:       // Audit M-03: composite (timestamp, id) cursor so equal timestamps
 400:       // cannot skip or duplicate rows across pages. Legacy timestamp-only
 401:       // cursors are still accepted.
 402:       let query = this.supabaseClient
 403:         .from(this.MSG_TABLE_NAME)
 404:         .select('*')
 405:         .eq('conversation_id', conversationId);
 406: 
 407:       if (hasCursorBefore) {
 408:         const { ts, id } = parseCompositeCursor(options!.cursorBefore!);
 409:         query = id
 410:           ? query.or(`timestamp.lt."${ts}",and(timestamp.eq."${ts}",id.lt."${id}")`)
 411:           : query.lt('timestamp', ts);
 412:         // Get older messages relative to cursorBefore, newest-first to apply limit
 413:         query = query
 414:           .order('timestamp', { ascending: false })
 415:           .order('id', { ascending: false })
 416:           .limit(limit + 1);
 417:       } else if (hasCursorAfter) {
 418:         const { ts, id } = parseCompositeCursor(options!.cursorAfter!);
 419:         query = id
 420:           ? query.or(`timestamp.gt."${ts}",and(timestamp.eq."${ts}",id.gt."${id}")`)
 421:           : query.gt('timestamp', ts);
 422:         // Get newer messages relative to cursorAfter, oldest-first for append
 423:         query = query
 424:           .order('timestamp', { ascending: true })
 425:           .order('id', { ascending: true })
 426:           .limit(limit + 1);
 427:       }
 428: 
 429:       const res = await query;
 430:       data = res.data as any[] | null;
 431:       error = res.error;
 432:       if (error) {
 433:         console.error('Error fetching messages by conversation (keyset):', error);
 434:         throw error;
 435:       }
 436:       // For cursorBefore branch, data is DESC; reverse to ASC for rendering
 437:       if (hasCursorBefore && data) {
 438:         data = [...data].reverse();
 439:       }
 440:     } else {
 441:       // Initial load: fetch most recent messages, newest first
 442:       const res = await this.supabaseClient
 443:         .from(this.MSG_TABLE_NAME)
 444:         .select('*')
 445:         .eq('conversation_id', conversationId)
 446:         .order('timestamp', { ascending: false })
 447:         .order('id', { ascending: false })
 448:         .limit(limit + 1);
 449:       data = res.data as any[] | null;
 450:       error = res.error;
 451:       if (error) {
 452:         console.error('Error fetching messages by conversation (initial):', error);
 453:         throw error;
 454:       }
 455:       // Reverse to oldest-first for UI rendering
 456:       if (data) {
 457:         data = [...data].reverse();
 458:       }
 459:     }
 460: 
 461:     if (!data || data.length === 0) {
 462:       return {
 463:         items: [],
 464:         hasMore: false,
 465:         nextCursor: null
 466:       };
 467:     }
 468: 
 469:     // Check if we have more results
 470:     const hasMore = data.length > limit;
 471:     // Trim to actual limit, preserving chronological (oldest->newest) order
 472:     const trimmedData = hasMore
 473:       ? (hasCursorAfter ? data.slice(0, limit) : data.slice(data.length - limit))
 474:       : data;
 475: 
 476:     const enrichedMessages = await this.enrichFeedMessages(
 477:       mapMessageArrayToCamelCase(trimmedData),
 478:       conversationId
 479:     );
