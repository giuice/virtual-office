   2: import { NextRequest, NextResponse } from 'next/server';
   3: import { IMessageRepository } from '@/repositories/interfaces';
   4: import { MessageAttemptRpcError, SupabaseMessageRepository } from '@/repositories/implementations/supabase';
   5: import { authorizeConversationParticipant, isAuthzFailure, jsonError } from '@/lib/auth/authorize';
   6: import { enforceRateLimit } from '@/lib/auth/rate-limit';
   7: import { requireAuthUser } from '@/lib/auth/session';
   8: import { createSupabaseServerClient } from '@/lib/supabase/server-client';
   9: import {
  10:   attemptSupersededResponse,
  11:   isUuid,
  12:   parseAttemptGeneration,
  13:   parseExpectedSenderId,
  14: } from '@/lib/messaging/message-attempts';
  15: 
  16: /**
  17:  * POST /api/messages/fence — Phase 5 T2 (FR-006, FR-011, FR-034, BR-001,
  18:  * BR-005; SPEC section 12): fence/lookup of the CALLER'S OWN composition key.
  19:  * Body: { conversationId, clientMessageId, attemptGeneration, expectedSenderId }
  20:  * (all required). The key is always scoped to the authenticated sender
  21:  * (users.id resolved from the session), so another user's key is never read
  22:  * or changed: it is simply a different (empty) key of the caller.
  23:  *
  24:  * 200 { outcome: 'stored', clientMessageId, attemptGeneration, message } — the
  25:  *     key's message is committed (the item resolves as delivered); `message`
  26:  *     is null when it was committed and has been deleted since;
  27:  * 200 { outcome: 'not_stored', clientMessageId, attemptGeneration } — nothing
  28:  *     is stored and no attempt older than attemptGeneration can commit any more;
  29:  * 409 ATTEMPT_SUPERSEDED — a newer generation exists (nothing changed);
  30:  * 403 SENDER_MISMATCH (expectedSenderId is not the authenticated user; nothing
  31:  *     fenced), 403 NOT_PARTICIPANT (incl. a missing conversation), 401 when not
  32:  *     signed in, 400 for malformed fields, 429 when rate limited.
  33:  * Never creates a message.
  34:  *
  35:  * Phase 5 T3 (FR-008): authenticated first (401, nobody charged); every
  36:  * authenticated call — malformed ones included — then consumes the caller's
  37:  * fence budget ('message:fence', shared with the fence step of
  38:  * generation-carrying creates). Exhausted, or not checkable (fail-closed):
  39:  * 429 `rate_limited`.
  40:  */
  41: export async function POST(request: NextRequest) {
  42:   try {
  43:     const auth = await requireAuthUser();
  44:     if ('errorResponse' in auth) {
  45:       return auth.errorResponse;
  46:     }
  47:     const serviceClient = await createSupabaseServerClient('service_role');
  48:     const overFenceBudget = await enforceRateLimit(serviceClient, auth.dbUser.id, 'message:fence');
  49:     if (overFenceBudget) {
  50:       return overFenceBudget;
  51:     }
  52: 
  53:     let body: Record<string, unknown>;
  54:     try {
  55:       body = await request.json();
  56:     } catch {
  57:       return jsonError(400, 'BAD_REQUEST', 'Invalid JSON payload');
  58:     }
  59:     if (typeof body !== 'object' || body === null || Array.isArray(body)) {
  60:       return jsonError(400, 'BAD_REQUEST', 'Invalid JSON payload');
  61:     }
  62: 
  63:     if (!isUuid(body.conversationId)) {
  64:       return jsonError(400, 'BAD_REQUEST', 'conversationId must be a UUID');
  65:     }
  66:     const conversationId = body.conversationId.toLowerCase();
  67:     if (!isUuid(body.clientMessageId)) {
  68:       return jsonError(400, 'INVALID_CLIENT_MESSAGE_ID', 'clientMessageId must be a UUID');
  69:     }
  70:     const clientMessageId = body.clientMessageId.toLowerCase();
  71:     if (body.attemptGeneration === undefined || body.attemptGeneration === null) {
  72:       return jsonError(400, 'INVALID_ATTEMPT_GENERATION', 'attemptGeneration is required');
  73:     }
  74:     const attemptGeneration = parseAttemptGeneration(body.attemptGeneration, true);
  75:     if (!attemptGeneration.ok) {
  76:       return attemptGeneration.response;
  77:     }
  78:     const generation = attemptGeneration.value as number;
  79:     const expectedSenderId = parseExpectedSenderId(body.expectedSenderId, true);
  80:     if (!expectedSenderId.ok) {
  81:       return expectedSenderId.response;
  82:     }
  83: 
  84:     const ctx = await authorizeConversationParticipant(auth, serviceClient, conversationId, {
  85:       expectedSenderId: expectedSenderId.value,
  86:       missingConversationAsNotParticipant: true,
  87:     });
  88:     if (isAuthzFailure(ctx)) {
  89:       return ctx.errorResponse;
  90:     }
  91:     const { dbUser, conversation } = ctx;
  92: 
  93:     const messageRepository: IMessageRepository = new SupabaseMessageRepository(serviceClient);
  94:     let fence;
  95:     try {
  96:       fence = await messageRepository.fenceClientMessage(
  97:         { senderId: dbUser.id, conversationId: conversation.id, clientMessageId },
  98:         generation
  99:       );
 100:     } catch (error) {
 101:       if (error instanceof MessageAttemptRpcError && error.postgrestError.code === '42501') {
 102:         return jsonError(403, 'NOT_PARTICIPANT', 'You are not a participant of this conversation');
 103:       }
 104:       throw error;
 105:     }
 106: 
 107:     if (fence.outcome === 'superseded') {
 108:       return attemptSupersededResponse();
 109:     }
 110:     if (fence.outcome === 'not_stored') {
 111:       return NextResponse.json(
 112:         { outcome: 'not_stored', clientMessageId, attemptGeneration: generation },
 113:         { status: 200 }
 114:       );
 115:     }
 116: 
 117:     const stored = fence.messageId ? await messageRepository.findById(fence.messageId) : null;
 118:     if (!stored) {
 119:       // Committed under the key and deleted since: delivered, never resent.
 120:       return NextResponse.json(
 121:         { outcome: 'stored', clientMessageId, attemptGeneration: generation, message: null },
 122:         { status: 200 }
 123:       );
 124:     }
 125:     return NextResponse.json(
 126:       {
 127:         outcome: 'stored',
 128:         clientMessageId,
 129:         attemptGeneration: generation,
 130:         // Not other users' pins or stars, which findById (service client) loads.
 131:         message: { ...stored, pins: undefined, stars: undefined, clientMessageId },
 132:       },
 133:       { status: 200 }
 134:     );
 135:   } catch (error) {
 136:     console.error('Error fencing message attempt:', error);
 137:     return jsonError(500, 'INTERNAL_ERROR', 'Failed to fence message attempt');
 138:   }
 139: }
