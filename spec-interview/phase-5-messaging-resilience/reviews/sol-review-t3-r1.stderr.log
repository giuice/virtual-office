   7: interface RateLimitPolicy {
   8:   limit: number;
   9:   windowSeconds: number;
  10:   /**
  11:    * Phase 5 T3 (D4 planning decision): when the limit cannot be checked (RPC
  12:    * error, missing or revoked function, unexpected result), refuse the request
  13:    * with 429 instead of allowing it. Other actions keep failing open.
  14:    */
  15:   failClosed: boolean;
  16: }
  17: 
  18: // Audit M-09: per-user fixed-window limits for messaging mutations.
  19: // Enforced by the service-role-only check_rate_limit RPC (shared Postgres
  20: // counter, safe across serverless instances).
  21: //
  22: // Phase 5 T3 (FR-008) message send budgets, all per user and fail-closed:
  23: //   * 'message:create' — INSERTION QUOTA (unchanged 30/60 s; D1 needs a burst
  24: //     of >= 10). Keyed and attachment creates are charged by the database in
  25: //     the transaction of a winning insertion only (create_message_attempt,
  26: //     migration 20261007114454): replays, lost same-key races and refused
  27: //     creates never consume it. Unkeyed text creates (published client) are
  28: //     charged by the route right before their insert. Phase 4 servers charge
  29: //     the same counter at their route, so both builds share one quota.
  30: //   * 'message:create-request' — REQUEST BUDGET: every authenticated create
  31: //     request (malformed bodies, validation failures, replays, quota losers
  32: //     included), charged first, in its own transaction, so it survives an
  33: //     insertion rollback. 60/60 s = 2x the insertion quota: a full quota of
  34: //     new messages plus one replay or retry each; an outbox drain of 10 items
  35: //     with one replay each uses 20.
  36: //   * 'message:fence' — FENCE BUDGET: every authenticated fence/lookup call
  37: //     plus the fence step of each generation-carrying create. 90/60 s = the
  38: //     request budget's 60 generation-carrying creates plus 30 explicit
  39: //     lookups; a drain of 10 items (create + lookup + replay each) uses 30.
  40: //   Bound on private.message_send_attempts growth: a key row is created only
  41: //   by a fence step (<= 90 per user per minute) or a committed generation-less
  42: //   keyed create (<= 30, insertion quota): <= 120 new rows per user per minute.
  43: const RATE_LIMITS = {
  44:   'message:create': { limit: 30, windowSeconds: 60, failClosed: true },
  45:   'message:create-request': { limit: 60, windowSeconds: 60, failClosed: true },
  46:   'message:react': { limit: 60, windowSeconds: 60, failClosed: false },
  47:   // Phase 4 T13: one upload per file, up to 5 files per message, plus retries
  48:   // of failed uploads; 10/min refused the second full message in a minute.
  49:   // 30/min = six 5-file messages, in line with message:create (each file is
  50:   // still capped at 10 MB and only links to the uploader's own message).
  51:   'message:upload': { limit: 30, windowSeconds: 60, failClosed: false },
  52:   // Phase 4 T12: cancelling pending uploads (composer remove/cancel).
  53:   'message:upload-cancel': { limit: 60, windowSeconds: 60, failClosed: false },
  54:   // Phase 5 T2/T3: fence/lookup of the caller's own composition key (outbox
  55:   // recovery after unknown outcomes), see the budgets above.
  56:   'message:fence': { limit: 90, windowSeconds: 60, failClosed: true },
  57:   // Visible-message receipts are batched by the drawer while it scrolls.
  58:   'conversation:read-receipts': { limit: 120, windowSeconds: 60, failClosed: false },
  59: } as const satisfies Record<string, RateLimitPolicy>;
  60: 
  61: export type RateLimitedAction = keyof typeof RATE_LIMITS;
  62: 
  63: /**
  64:  * The message insertion quota handed to the database, which charges it to
  65:  * the 'message:create' counter in the transaction of a winning insertion.
  66:  */
  67: export const MESSAGE_INSERTION_QUOTA: InsertionQuota = {
  68:   limit: RATE_LIMITS['message:create'].limit,
  69:   windowSeconds: RATE_LIMITS['message:create'].windowSeconds,
  70: };
  71: 
  72: /** 429: the user exhausted a limit (transient). */
  73: export function rateLimitExceededResponse(): NextResponse {
  74:   return jsonError(429, 'rate_limited', 'Too many requests. Please slow down.');
  75: }
  76: 
  77: /** 429: a fail-closed limit could not be checked (transient). */
  78: export function rateLimitUnavailableResponse(): NextResponse {
  79:   return jsonError(429, 'rate_limited', 'The request could not be rate checked. Please retry shortly.');
  80: }
  81: 
  82: /**
  83:  * Returns a 429 response when the user exceeded the action's limit,
  84:  * null when the request may proceed. Call AFTER authentication, with the
  85:  * authenticated user's DB id (users.id, not supabase_uid).
  86:  *
  87:  * Fail-open actions: an RPC error (e.g. migration not applied yet) is logged
  88:  * and the request is allowed — rate limiting must never take those down.
  89:  * Fail-closed actions (Phase 5 T3: message send budgets): an RPC error or an
  90:  * unexpected result refuses the request with 429.
  91:  */
  92: export async function enforceRateLimit(
  93:   serviceClient: SupabaseClient,
  94:   userDbId: string,
  95:   action: RateLimitedAction
  96: ): Promise<NextResponse | null> {
  97:   const { limit, windowSeconds, failClosed } = RATE_LIMITS[action];
  98: 
  99:   try {
 100:     const { data: allowed, error } = await serviceClient.rpc('check_rate_limit', {
 101:       p_user_id: userDbId,
 102:       p_action: action,
 103:       p_limit: limit,
 104:       p_window_seconds: windowSeconds,
 105:     });
 106: 
 107:     if (error) {
 108:       console.error(`Rate limit check failed for ${action}:`, error);
 109:       return failClosed ? rateLimitUnavailableResponse() : null;
 110:     }
 111: 
 112:     if (allowed === false) {
 113:       return rateLimitExceededResponse();
 114:     }
 115: 
 116:     if (failClosed && allowed !== true) {
 117:       console.error(`Rate limit check returned an unexpected result for ${action}:`, allowed);
 118:       return rateLimitUnavailableResponse();
 119:     }
 120: 
 121:     return null;
 122:   } catch (error) {
 123:     console.error(`Rate limit check threw for ${action}:`, error);
 124:     return failClosed ? rateLimitUnavailableResponse() : null;
 125:   }
 126: }
