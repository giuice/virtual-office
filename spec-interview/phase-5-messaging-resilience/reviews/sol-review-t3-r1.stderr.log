 806: -- ============================================================================
 807: -- Backfill: delivery records for keyed messages created before this migration
 808: -- (no fence state; their original composition is unavailable). It runs here,
 809: -- BEFORE the policy and trigger changes below take their exclusive locks on
 810: -- messages; on first application the foreign keys created above already hold
 811: -- SHARE ROW EXCLUSIVE on messages, so message writes wait for this scan too
 812: -- (see the lock warning in the header); the same statement runs
 813: -- again after the trigger exists to catch keyed rows committed in between.
 814: -- Messages deleted before this migration leave no record (unrecoverable).
 815: -- ============================================================================
 816: insert into private.message_send_attempts as a
 817:   (sender_id, conversation_id, client_message_id, committed_at, message_id)
 818: select m.sender_id, m.conversation_id, m.client_message_id, m.timestamp, m.id
 819: from public.messages m
 820: where m.client_message_id is not null
 821:   and m.sender_id is not null
 822: on conflict (sender_id, conversation_id, client_message_id) do update
 823:   set message_id = excluded.message_id,
 824:       committed_at = coalesce(a.committed_at, excluded.committed_at),
 825:       composition = case when a.message_id = excluded.message_id then a.composition end,
 826:       updated_at = pg_catalog.now()
 827:   where a.message_id is distinct from excluded.message_id or a.committed_at is null;
 828: 
 829: -- ============================================================================
 830: -- Keyed messages are written only through the fenced contract.
 831: -- ============================================================================
 832: -- Clients (authenticated, under RLS) may still insert their own UNKEYED
 833: -- messages directly (no shipped build does; the policy is kept as it was), but
 834: -- never a keyed one: a keyed create must go through POST /api/messages/create.
 835: alter policy "send_message_as_self" on public.messages
 836:   with check (
 837:     (sender_id = (select private.current_app_user_id()))
 838:     and private.is_conversation_member(conversation_id)
 839:     and content <> ''
 840:     and client_message_id is null
 841:   );
 842: 
 843: -- No writer (clients, service role, owner) may set, change or clear a
 844: -- message's key after it was inserted, nor move a keyed message to another
 845: -- conversation or sender (which would carry the key outside its delivery
 846: -- record): a key is only ever assigned by the INSERT that the fence guards. No
 847: -- shipped build updates client_message_id, conversation_id or sender_id. The
 848: -- sender FK's ON DELETE SET NULL (user deletion) stays allowed.
