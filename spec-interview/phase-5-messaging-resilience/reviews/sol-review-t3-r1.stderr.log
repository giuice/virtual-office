  83:   if (ids.length === 0) {
  84:     return { ok: true, value: undefined };
  85:   }
  86:   if (ids.length > MAX_ATTACHMENTS_PER_MESSAGE) {
  87:     return { ok: false, code: 'TOO_MANY_ATTACHMENTS', message: TOO_MANY_ATTACHMENTS_MESSAGE };
  88:   }
  89:   if (new Set(ids).size !== ids.length) {
  90:     return { ok: false, code: 'DUPLICATE_ATTACHMENT', message: 'attachmentIds must not repeat an upload' };
  91:   }
  92:   return { ok: true, value: ids };
  93: }
  94: 
  95: /**
  96:  * A replayed key must carry the same composition: content, reply target, the
  97:  * same attachment set (attachment id = upload id), and — for messages without
  98:  * attachments — the same type (attachment messages derive their type from
  99:  * their attachments). Phase 5 T2 (FR-024): compared against the ORIGINAL
 100:  * submitted composition recorded with the key; keyed messages created before
 101:  * Phase 5 have none and are compared against the stored message (Phase 4).
 102:  */
 103: function isSameComposition(
 104:   storedComposition: MessageComposition | null | undefined,
 105:   stored: Message,
 106:   storedAttachmentIdList: readonly string[],
 107:   requested: MessageComposition
 108: ): boolean {
 109:   if (storedComposition) {
 110:     return isSameStoredComposition(storedComposition, requested);
 111:   }
 112:   const storedAttachmentIds = [...storedAttachmentIdList].sort();
 113:   const expectedAttachmentIds = [...requested.attachmentIds].sort();
 114:   return (
 115:     stored.content === requested.content &&
 116:     (requested.type === null || stored.type === requested.type) &&
 117:     (stored.replyToId ?? null) === requested.replyToId &&
 118:     storedAttachmentIds.length === expectedAttachmentIds.length &&
 119:     storedAttachmentIds.every((id, index) => id === expectedAttachmentIds[index])
 120:   );
 121: }
 122: 
 123: // Responses carry the message, its attachments and reactions — not other
 124: // users' pins or stars, which findById (service client) also loads. Keyed
 125: // responses carry the key (FR-034) on the message and at the top level, plus
 126: // the attempt generation they answer.
 127: function messageResponse(message: Message, status: 200 | 201, keyed?: KeyedCreate): NextResponse {
 128:   const responseMessage: Message = { ...message, pins: undefined, stars: undefined };
 129:   if (!keyed) {
 130:     return NextResponse.json({ message: responseMessage }, { status });
 131:   }
 132:   return NextResponse.json(
 133:     {
 134:       message: { ...responseMessage, clientMessageId: keyed.clientMessageId },
 135:       clientMessageId: keyed.clientMessageId,
 136:       ...(keyed.attempt.generation !== undefined ? { attemptGeneration: keyed.attempt.generation } : {}),
 137:     },
 138:     { status }
 139:   );
 140: }
 141: 
 142: function clientKeyReused() {
 143:   return jsonError(409, 'CLIENT_MESSAGE_ID_REUSED', 'clientMessageId was already used for a different message');
 144: }
 145: 
 146: function attachmentNotFound() {
 147:   return jsonError(400, 'ATTACHMENT_NOT_FOUND', 'An attachment was not found; upload it again');
 148: }
 149: 
 150: function invalidReplyTarget() {
 151:   return jsonError(400, 'INVALID_REPLY_TARGET', 'replyToId must reference a message in the same conversation');
 152: }
 153: 
 154: function notParticipant() {
 155:   return jsonError(403, 'NOT_PARTICIPANT', 'You are not a participant of this conversation');
 156: }
 157: 
 158: function attachmentLinkFailure(error: AttachmentLinkError) {
 159:   switch (error.code) {
 160:     case 'NOT_PARTICIPANT':
 161:       return notParticipant();
 162:     case 'ATTACHMENT_COUNT_INVALID':
 163:       return jsonError(400, 'TOO_MANY_ATTACHMENTS', TOO_MANY_ATTACHMENTS_MESSAGE);
 164:     case 'ATTACHMENT_DUPLICATE':
 165:       return jsonError(400, 'DUPLICATE_ATTACHMENT', 'attachmentIds must not repeat an upload');
 166:     case 'ATTACHMENT_UPLOAD_NOT_FOUND':
 167:       return attachmentNotFound();
 168:     case 'INVALID_REPLY_TARGET':
 169:       return invalidReplyTarget();
 170:     case 'VOICE_NOTE_NOT_ALONE':
 171:       return voiceNoteNotAlone();
 172:   }
 173: }
 174: 
 175: function voiceNoteNotAlone() {
 176:   return jsonError(400, 'VOICE_NOTE_NOT_ALONE', 'A voice note must be the only attachment of its message');
 177: }
 178: 
 179: /**
 180:  * Database refusals of a create (fenced attempt, validation race, insertion
 181:  * quota) as BR-005 / FR-008 outcomes; null otherwise.
 182:  */
 183: function createRefusal(error: unknown): NextResponse | null {
 184:   if (error instanceof InsertionRateLimitError) {
 185:     return error.reason === 'exceeded' ? rateLimitExceededResponse() : rateLimitUnavailableResponse();
 186:   }
 187:   if (error instanceof AttemptSupersededError) {
 188:     return attemptSupersededResponse();
 189:   }
 190:   if (error instanceof MessageDeletedError) {
 191:     return messageDeletedResponse();
 192:   }
 193:   if (error instanceof AttachmentLinkError) {
 194:     return attachmentLinkFailure(error);
 195:   }
 196:   if (error instanceof MessageAttemptRpcError && error.postgrestError.code === '42501') {
 197:     return notParticipant();
 198:   }
 199:   return null;
 200: }
 201: 
 202: /**
 203:  * Creates the message and links its pending uploads in one transaction
 204:  * (BR-007: never visible partially attached). The uploads must belong to the
 205:  * caller for this conversation and pass the attachment policy on their STORED
 206:  * objects. A keyed create commits only while its attempt is current (Phase 5
 207:  * T2); a fenced one stores and links nothing.
 208:  */
 209: async function createWithAttachments(
 210:   serviceClient: SupabaseClient,
 211:   messageRepository: IMessageRepository,
 212:   conversationRepository: IConversationRepository,
 213:   uploads: IMessageAttachmentUploadRepository,
 214:   messageData: Omit<MessageCreateData, 'type'>,
 215:   attachmentIds: string[],
 216:   keyed: KeyedCreate | undefined
 217: ): Promise<NextResponse> {
 218:   const owned = await uploads.findOwned(attachmentIds, messageData.senderId, messageData.conversationId);
 219: 
 220:   let type = MessageType.FILE;
 221:   const allUploadsPending = owned.length === attachmentIds.length;
 222:   if (allUploadsPending) {
 223:     // Phase 4 T15: a voice note travels alone (the database enforces it too).
 224:     if (owned.length > 1 && owned.some((upload) => upload.duration !== undefined)) {
 225:       return voiceNoteNotAlone();
 226:     }
 227:     const violation = await validateUploadsForLink(serviceClient, owned);
 228:     if (violation) {
 229:       return jsonError(violation.status, violation.code, violation.message);
 230:     }
 231:     type = attachmentMessageType(owned.map((upload) => upload.type));
 232:   } else if (!keyed) {
 233:     // Unknown, another user's, another conversation's, cancelled, or sent.
 234:     return attachmentNotFound();
 235:   }
 236:   // With a key and missing uploads the database decides: a replay of a
 237:   // committed create (its uploads were consumed) or ATTACHMENT_NOT_FOUND.
 238: 
 239:   let outcome: { messageId: string; created: boolean; storedComposition?: MessageComposition | null };
 240:   try {
 241:     outcome = await uploads.createMessageWithAttachments(
 242:       { ...messageData, type },
 243:       attachmentIds,
 244:       keyed?.clientMessageId,
 245:       keyed?.attempt,
 246:       MESSAGE_INSERTION_QUOTA
 247:     );
 248:   } catch (error) {
 249:     const refusal = createRefusal(error);
 250:     if (refusal) {
 251:       return refusal;
 252:     }
 253:     throw error;
 254:   }
 255: 
 256:   if (outcome.created && !allUploadsPending) {
 257:     // The database can only replay or refuse when uploads were missing here.
 258:     throw new Error('create_message_attempt linked uploads that failed the policy pre-check');
 259:   }
 260:   if (outcome.created) {
 261:     // Committed: bump activity now so a failed read-back below (500, then a
 262:     // 200 replay on retry) never skips the recipients' badge refresh.
 263:     await touchConversation(conversationRepository, messageData.conversationId);
 264:   }
 265: 
 266:   const stored = await messageRepository.findById(outcome.messageId);
 267:   if (!stored) {
 268:     throw new Error(`Message ${outcome.messageId} not found after create`);
 269:   }
 270:   // Read strictly: findById degrades attachment read errors to [] (which would
 271:   // turn a genuine replay into a false 409 or answer 201 without files).
 272:   const linkedIds = await uploads.listLinkedAttachmentIds(outcome.messageId);
 273:   if (!outcome.created) {
 274:     // Only a keyed create can replay.
 275:     if (!keyed || !isSameComposition(outcome.storedComposition, stored, linkedIds, keyed.attempt.composition)) {
 276:       return clientKeyReused();
 277:     }
 278:     return messageResponse(stored, 200, keyed);
 279:   }
 280:   if ((stored.attachments ?? []).length !== linkedIds.length) {
 281:     // The message and its files are committed; a retry with the same key
 282:     // replays it (200) once the read succeeds.
 283:     throw new Error(`Attachments of message ${outcome.messageId} could not be read after create`);
 284:   }
 285:   return messageResponse(stored, 201, keyed);
 286: }
 287: 
 288: // Update conversation last activity. Besides ordering the list, this UPDATE on
 289: // conversations is what fires useConversationRealtime's cache invalidation so
 290: // recipients' unread badges refresh. Unread counts are derived from
 291: // conversation_members.last_read_at (Phase 2.2) — nothing to increment here.
 292: async function touchConversation(conversationRepository: IConversationRepository, conversationId: string) {
 293:   try {
 294:     await conversationRepository.updateLastActivityTimestamp(conversationId);
 295:   } catch (updateError) {
 296:     console.warn('Failed to update conversation activity:', updateError);
 297:     // Don't fail the request if conversation update fails
 298:   }
 299: }
 300: 
 301: /**
 302:  * POST /api/messages/create
 303:  * Body: { conversationId, content, type?, replyToId?, clientMessageId?,
 304:  *         attachmentIds?, attemptGeneration?, expectedSenderId? }
 305:  * `content` may be empty (or omitted) only when `attachmentIds` lists 1–5 of
 306:  * the caller's pending uploads for this conversation (Phase 4 T12); the type
 307:  * of such a message is derived from its attachments (image or file; a voice
 308:  * note — Phase 4 T15 — is the only attachment of a file message).
 309:  * 201 created; 200 replay of `clientMessageId` (nothing inserted or linked);
 310:  * 409 CLIENT_MESSAGE_ID_REUSED when the replay's composition differs.
 311:  *
 312:  * Phase 5 T2 (FR-006, FR-011, BR-005): `attemptGeneration` (positive integer,
 313:  * requires `clientMessageId` and `expectedSenderId`) makes this dispatch an
 314:  * attempt of its key: it first fences every older generation, and commits only
 315:  * if no newer generation was fenced or dispatched before its commit; otherwise
 316:  * 409 ATTEMPT_SUPERSEDED and nothing is stored. A keyed create without a
 317:  * generation (Phase 4 client) commits only while the key has no fence state.
 318:  * `expectedSenderId` (users.id) different from the authenticated user → 403
 319:  * SENDER_MISMATCH, nothing stored or fenced. A generation-carrying create
 320:  * whose key's committed message was deleted since → 410 MESSAGE_DELETED
 321:  * (nothing stored; the item counts as delivered). A missing conversation answers
 322:  * 403 NOT_PARTICIPANT. Keyed responses carry `clientMessageId` (and
 323:  * `attemptGeneration` when sent).
 324:  *
 325:  * Phase 5 T3 (FR-008): budgets, each a transient 429 `rate_limited` when
 326:  * exhausted or when it cannot be checked (fail-closed). The request is
 327:  * authenticated first (401, nobody charged); then every authenticated request
 328:  * — malformed or invalid bodies, replays and quota losers included — consumes
 329:  * the request budget before anything else; a generation-carrying create's
 330:  * fence step consumes the fence budget; only a winning insertion consumes the
 331:  * insertion quota (charged by the database in its transaction; unkeyed text
 332:  * creates are charged right before their insert).
 333:  */
 334: export async function POST(request: NextRequest) {
 335:   try {
 336:     const auth = await requireAuthUser();
 337:     if ('errorResponse' in auth) {
 338:       return auth.errorResponse;
 339:     }
 340:     const serviceClient = await createSupabaseServerClient('service_role');
 341:     const overRequestBudget = await enforceRateLimit(serviceClient, auth.dbUser.id, 'message:create-request');
 342:     if (overRequestBudget) {
 343:       return overRequestBudget;
 344:     }
 345: 
 346:     let body: Record<string, unknown>;
 347:     try {
 348:       body = await request.json();
 349:     } catch {
 350:       return jsonError(400, 'BAD_REQUEST', 'Invalid JSON payload');
 351:     }
 352:     if (typeof body !== 'object' || body === null || Array.isArray(body)) {
 353:       return jsonError(400, 'BAD_REQUEST', 'Invalid JSON payload');
 354:     }
 355: 
 356:     const attachmentIds = parseAttachmentIds(body.attachmentIds);
 357:     if (!attachmentIds.ok) {
 358:       return jsonError(400, attachmentIds.code, attachmentIds.message);
 359:     }
 360:     const hasAttachments = attachmentIds.value !== undefined;
 361: 
 362:     const conversationId = typeof body.conversationId === 'string' ? body.conversationId : null;
 363:     const rawContent = body.content === undefined && hasAttachments ? '' : body.content;
 364:     if (!conversationId || typeof rawContent !== 'string') {
 365:       return jsonError(400, 'BAD_REQUEST', 'Missing required fields: conversationId, content');
 366:     }
 367:     if (!isUuid(conversationId)) {
 368:       return jsonError(400, 'BAD_REQUEST', 'conversationId must be a UUID');
 369:     }
 370: 
 371:     const trimmedContent = rawContent.trim();
 372:     if (trimmedContent.length === 0 && !hasAttachments) {
 373:       return jsonError(400, 'BAD_REQUEST', 'Content must not be empty');
 374:     }
 375:     if (trimmedContent.length > MAX_CONTENT_LENGTH) {
 376:       return jsonError(413, 'CONTENT_TOO_LARGE', `Content exceeds the ${MAX_CONTENT_LENGTH} character limit`);
 377:     }
 378: 
 379:     const clientMessageId = parseClientMessageId(body.clientMessageId);
 380:     if (!clientMessageId.ok) {
 381:       return jsonError(400, 'INVALID_CLIENT_MESSAGE_ID', 'clientMessageId must be a UUID');
 382:     }
 383:     const attemptGeneration = parseAttemptGeneration(body.attemptGeneration, clientMessageId.value !== 
undefined);
 384:     if (!attemptGeneration.ok) {
 385:       return attemptGeneration.response;
 386:     }
 387:     const expectedSenderId = parseExpectedSenderId(body.expectedSenderId, attemptGeneration.value !== undefined);
 388:     if (!expectedSenderId.ok) {
 389:       return expectedSenderId.response;
 390:     }
 391: 
 392:     const ctx = await authorizeConversationParticipant(auth, serviceClient, conversationId, {
 393:       expectedSenderId: expectedSenderId.value,
 394:       missingConversationAsNotParticipant: true,
 395:     });
 396:     if (isAuthzFailure(ctx)) {
 397:       return ctx.errorResponse;
 398:     }
 399:     const { dbUser, conversation } = ctx;
 400: 
 401:     const messageRepository: IMessageRepository = new SupabaseMessageRepository(serviceClient);
 402:     const conversationRepository: IConversationRepository = new SupabaseConversationRepository(serviceClient);
 403: 
 404:     // Audit S-04: replyToId must reference a message in the SAME conversation.
 405:     // Keyed creates are validated by the database AFTER the replay check
 406:     // (create_message_attempt): an unchanged replay of a stored message is not
 407:     // re-validated (FR-024), so a reply target deleted since cannot turn it
 408:     // into a refusal; a new insertion still gets 400 INVALID_REPLY_TARGET.
 409:     let replyToId: string | undefined;
 410:     if (body.replyToId !== undefined && body.replyToId !== null) {
 411:       if (typeof body.replyToId !== 'string') {
 412:         return jsonError(400, 'BAD_REQUEST', 'replyToId must be a string');
 413:       }
 414:       if (!isUuid(body.replyToId)) {
 415:         return invalidReplyTarget();
 416:       }
 417:     }
 418:     if (typeof body.replyToId === 'string' && clientMessageId.value) {
 419:       replyToId = body.replyToId.toLowerCase();
 420:     } else if (typeof body.replyToId === 'string') {
 421:       const { data: replyTarget, error: replyError } = await serviceClient
 422:         .from('messages')
 423:         .select('id, conversation_id')
 424:         .eq('id', body.replyToId)
 425:         .maybeSingle();
 426:       if (replyError) {
 427:         console.error('Failed to validate replyToId:', replyError.message);
 428:         return jsonError(500, 'INTERNAL_ERROR', 'Failed to create message');
 429:       }
 430:       if (!replyTarget || replyTarget.conversation_id !== conversation.id) {
 431:         return invalidReplyTarget();
 432:       }
 433:       replyToId = replyTarget.id;
 434:     }
 435: 
 436:     const baseMessageData: Omit<MessageCreateData, 'type'> = {
 437:       conversationId: conversation.id,
 438:       senderId: dbUser.id,
 439:       content: trimmedContent,
 440:       // Audit S-04: never trust client-supplied status (pre-marked read/delivered).
 441:       status: MessageStatus.SENT,
 442:       replyToId,
 443:     };
 444: 
 445:     const safeType: MessageType = Object.values(MessageType).includes(body.type as MessageType)
 446:       ? (body.type as MessageType)
 447:       : MessageType.TEXT;
 448: 
 449:     let keyed: KeyedCreate | undefined;
 450:     if (clientMessageId.value) {
 451:       keyed = {
 452:         clientMessageId: clientMessageId.value,
 453:         attempt: {
 454:           generation: attemptGeneration.value,
 455:           composition: buildComposition({
 456:             content: trimmedContent,
 457:             type: attachmentIds.value ? null : safeType,
 458:             replyToId,
 459:             attachmentIds: attachmentIds.value ?? [],
 460:           }),
 461:         },
 462:       };
 463:     }
 464: 
 465:     if (keyed?.attempt.generation !== undefined) {
 466:       // FR-006: an attempt that reached the server fences every older
 467:       // generation before its INSERT, so a stale fence or request arriving
 468:       // later is refused; the create below re-checks at commit time.
 469:       // Phase 5 T3: this fence step consumes the fence budget.
 470:       const overFenceBudget = await enforceRateLimit(serviceClient, dbUser.id, 'message:fence');
 471:       if (overFenceBudget) {
 472:         return overFenceBudget;
 473:       }
 474:       let fence;
 475:       try {
 476:         fence = await messageRepository.fenceClientMessage(
 477:           { senderId: dbUser.id, conversationId: conversation.id, clientMessageId: keyed.clientMessageId },
 478:           keyed.attempt.generation
 479:         );
 480:       } catch (error) {
 481:         const refusal = createRefusal(error);
 482:         if (refusal) {
 483:           return refusal;
 484:         }
 485:         throw error;
 486:       }
 487:       if (fence.outcome === 'superseded') {
 488:         return attemptSupersededResponse();
 489:       }
 490:       if (fence.outcome === 'stored' && fence.messageId === null) {
 491:         // Delivered under this key and deleted since: never recreate it.
 492:         return messageDeletedResponse();
 493:       }
 494:     }
 495: 
 496:     if (attachmentIds.value) {
 497:       return await createWithAttachments(
 498:         serviceClient,
 499:         messageRepository,
 500:         conversationRepository,
 501:         new SupabaseMessageAttachmentUploadRepository(serviceClient),
 502:         baseMessageData,
 503:         attachmentIds.value,
 504:         keyed
 505:       );
 506:     }
 507: 
 508:     const messageData: MessageCreateData = { ...baseMessageData, type: safeType };
 509: 
 510:     if (!keyed) {
 511:       // Unkeyed text create (published client): a direct insert, charged to
 512:       // the insertion quota right before it (no replay exists without a key).
 513:       const overInsertionQuota = await enforceRateLimit(serviceClient, dbUser.id, 'message:create');
 514:       if (overInsertionQuota) {
 515:         return overInsertionQuota;
 516:       }
 517:       const createdMessage = await messageRepository.create(messageData);
 518:       await touchConversation(conversationRepository, conversation.id);
 519:       return NextResponse.json({ message: createdMessage }, { status: 201 });
 520:     }
 521: 
 522:     let outcome;
 523:     try {
 524:       outcome = await messageRepository.createWithClientKey(
 525:         messageData,
 526:         keyed.clientMessageId,
 527:         keyed.attempt,
 528:         MESSAGE_INSERTION_QUOTA
 529:       );
 530:     } catch (error) {
 531:       const refusal = createRefusal(error);
 532:       if (refusal) {
 533:         return refusal;
 534:       }
 535:       throw error;
 536:     }
 537:     if (!outcome.created) {
 538:       // A retry of a composition whose create already committed (e.g. its
 539:       // response was lost): answer with the stored message, insert nothing.
 540:       // The key is per composition, so a different payload — including a
 541:       // stored message that carries attachments — is a client bug.
 542:       const stored = (await messageRepository.findById(outcome.message.id)) ?? outcome.message;
 543:       const linkedIds = await new 
SupabaseMessageAttachmentUploadRepository(serviceClient).listLinkedAttachmentIds(stored.id);
 544:       if (!isSameComposition(outcome.storedComposition, stored, linkedIds, keyed.attempt.composition)) {
 545:         return clientKeyReused();
 546:       }
 547:       return messageResponse(stored, 200, keyed);
 548:     }
 549: 
 550:     await touchConversation(conversationRepository, conversation.id);
 551: 
 552:     return messageResponse(outcome.message, 201, keyed);
 553:   } catch (error) {
 554:     console.error('Error creating message:', error);
 555:     return jsonError(500, 'INTERNAL_ERROR', 'Failed to create message');
 556:   }
 557: }

