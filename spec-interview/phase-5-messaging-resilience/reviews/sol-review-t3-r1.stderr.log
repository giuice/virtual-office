  81: 
  82:   async findOwned(
  83:     ids: readonly string[],
  84:     uploaderId: string,
  85:     conversationId: string
  86:   ): Promise<PendingAttachmentUpload[]> {
  87:     if (ids.length === 0) return [];
  88:     const { data, error } = await this.supabaseClient
  89:       .from(this.TABLE_NAME)
  90:       .select(COLUMNS)
  91:       .in('id', [...ids])
  92:       .eq('uploader_id', uploaderId)
  93:       .eq('conversation_id', conversationId);
  94: 
  95:     if (error) {
  96:       console.error('Error loading pending attachment uploads:', error);
  97:       throw error;
  98:     }
  99:     return ((data ?? []) as PendingUploadRow[]).map(mapRow);
 100:   }
 101: 
 102:   async deleteOwned(id: string, uploaderId: string): Promise<PendingAttachmentUpload | null> {
 103:     const { data, error } = await this.supabaseClient
 104:       .from(this.TABLE_NAME)
 105:       .delete()
 106:       .eq('id', id)
 107:       .eq('uploader_id', uploaderId)
 108:       .select(COLUMNS);
 109: 
 110:     if (error) {
 111:       console.error('Error deleting pending attachment upload:', error);
 112:       throw error;
 113:     }
 114:     const rows = (data ?? []) as PendingUploadRow[];
 115:     return rows.length > 0 ? mapRow(rows[0]) : null;
 116:   }
