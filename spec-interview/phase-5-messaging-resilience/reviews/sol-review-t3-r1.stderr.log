 108:   /**
 109:    * Fixed windows: wait for the next window when fewer than `seconds` remain
 110:    * in the current one, so a test's charges and fills share one window.
 111:    */
 112:   async function ensureWindowHeadroom(seconds = 25): Promise<void> {
 113:     const [{ remaining }] = await world.query<{ remaining: string }>(
 114:       `select ($1::numeric - (extract(epoch from clock_timestamp())::numeric % $1::numeric))::text as remaining`,
 115:       [WINDOW_SECONDS],
 116:     );
 117:     const left = Number(remaining);
 118:     if (left < seconds) {
 119:       await new Promise((resolve) => setTimeout(resolve, Math.ceil(left * 1000) + 250));
 120:     }
 121:     await resetCounters();
 122:   }
