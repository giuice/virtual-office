172: /**
173:  * Keeps a just-merged message (a resolved send, a realtime INSERT) in the
174:  * feed when a fetch of that feed is already in flight.
175:  *
176:  * A fetch resolves with the server rows it read when it started and replaces
177:  * the cached pages. If the message was committed after that read, the result
178:  * lacks it and would silently drop it from the feed until some later
179:  * refetch. Once the in-flight fetch settles the message is merged again
180:  * (a no-op when the result already has it). If the message leaves the cache
181:  * while the fetch is still running (deleted, or a failed send rolled back),
182:  * it is not brought back.
183:  */
184: export function keepMessageThroughInflightFetch(
185:   queryClient: QueryClient,
186:   conversationId: string,
187:   message: Message
188: ): void {
189:   const queryKey = messagesQueryKey(conversationId);
190:   const queryCache = queryClient.getQueryCache();
191:   const query = queryCache.find<MessagesInfiniteData>({ queryKey, exact: true });
192:   if (!query || query.state.fetchStatus !== 'fetching') {
193:     return;
194:   }
195: 
196:   const unsubscribe = queryCache.subscribe((event) => {
197:     if (event.query !== query) {
198:       return;
199:     }
200:     if (event.type === 'removed') {
201:       unsubscribe();
202:       return;
203:     }
204:     if (event.type !== 'updated') {
205:       return;
206:     }
207:     if (query.state.fetchStatus === 'fetching') {
208:       // Until the fetch settles, data only changes through local updates.
209:       if (!isMessageCached(query.state.data, message.id)) {
210:         unsubscribe();
211:       }
212:       return;
213:     }
214:     unsubscribe();
215:     if (isMessageDeleted(queryClient, message.id)) {
216:       return;
217:     }
218:     queryClient.setQueryData<MessagesInfiniteData | undefined>(queryKey, (oldData) =>
219:       oldData ? appendMessageToPages(oldData, message) : oldData
220:     );
221:   });
222: }

