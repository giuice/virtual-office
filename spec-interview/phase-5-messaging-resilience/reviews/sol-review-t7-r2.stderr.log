231:         if (!query) return 'unavailable';
232:         const data = query.state.data as MessagesInfiniteData | undefined;
233:         if (pagesContainMessage(data, messageId)) return 'found';
234: 
235:         const isFetching = query.state.fetchStatus === 'fetching';
236:         if (!isFetching && !data?.pages.at(-1)?.nextCursorBefore) {
237:           // History exhausted (or never loaded) without the message.
238:           return 'unavailable';
239:         }
240: 
241:         const failuresBefore = query.state.errorUpdateCount;
242:         // Without cancelRefetch a fetch already in flight is awaited instead
243:         // of being cancelled; the next round then loads the next older page.
244:         await fetchNextPage({ cancelRefetch: false });
245:         if (query.state.errorUpdateCount > failuresBefore) {
246:           if (signal.aborted) return 'cancelled';
247:           return pagesContainMessage(
248:             queryClient.getQueryData<MessagesInfiniteData>(queryKey),
249:             messageId
250:           )
251:             ? 'found'
252:             : 'unavailable';
253:         }
254:       }
255: 
256:       if (signal.aborted) return 'cancelled';
257:       return pagesContainMessage(queryClient.getQueryData<MessagesInfiniteData>(queryKey), messageId)
258:         ? 'found'
259:         : 'unavailable';
260:     },
261:     [activeConversationId, fetchNextPage, queryClient]
