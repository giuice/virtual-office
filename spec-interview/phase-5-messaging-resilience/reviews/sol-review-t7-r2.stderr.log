264:   const sendMessage = useCallback(
265:     async (
266:       content: string,
267:       options?: {
268:         replyToId?: string;
269:         attachments?: FileAttachment[];
270:         type?: MessageType;
271:         // Composition key (FR-024): a retry with the same key gets back the
272:         // message already stored. Phase 5 FR-034: every send is keyed (one
273:         // is generated when the caller has none), because the pending copy
274:         // is matched to the stored message only by this key.
275:         clientMessageId?: string;
276:       }
277:     ) => {
278:       const trimmedContent = content.trim();
279:       const attachments = options?.attachments?.length ? options.attachments : undefined;
280:       // Attachment messages take their type from their files, as the server
281:       // derives it (all images → image, otherwise file).
282:       const messageType = attachments
283:         ? attachmentMessageType(attachments.map((attachment) => attachment.type))
284:         : options?.type || MessageType.TEXT;
285:       const instrumentationEnabled = debugLogger.messaging.enabled();
286:       const traceId = instrumentationEnabled ? createTraceId('hook-send') : '';
287: 
288:       if (!currentUserProfile?.id || !activeConversationId || (!trimmedContent && !attachments)) {
289:         if (instrumentationEnabled) {
290:           debugLogger.messaging.trace('useMessages.sendMessage', 'skip:missing-context', {
291:             traceId,
292:             hasProfile: Boolean(currentUserProfile?.id),
293:             conversationId: activeConversationId,
294:             hasContent: Boolean(trimmedContent),
295:           });
296:         }
297:         return;
298:       }
299: 
300:       const start = instrumentationEnabled ? getTimestamp() : 0;
301:       if (instrumentationEnabled) {
302:         debugLogger.messaging.event('useMessages.sendMessage', 'optimistic:start', {
303:           traceId,
304:           conversationId: activeConversationId,
305:           contentLength: trimmedContent.length,
306:           type: messageType,
307:           attachments: attachments?.length || 0,
308:         });
309:       }
310: 
311:       const clientMessageId = normalizeClientMessageId(options?.clientMessageId) ?? uuidv4();
312:       const conversationId = activeConversationId;
313:       const pendingKey = pendingMessagesQueryKey(currentUserProfile.id, conversationId);
314:       const now = new Date();
315:       const optimisticMessage: Message = {
316:         id: `${PENDING_MESSAGE_ID_PREFIX}${clientMessageId}`,
317:         conversationId: activeConversationId,
318:         senderId: currentUserProfile.id, // DB ID for UI representation
319:         content: trimmedContent,
320:         timestamp: now,
321:         status: MessageStatus.SENDING,
322:         type: messageType,
323:         replyToId: options?.replyToId,
324:         attachments,
325:         reactions: [],
326:         isEdited: false,
327:         clientMessageId,
328:       };
329: 
330:       // Shown after the stored feed until its stored message arrives (FR-034).
331:       updatePendingMessages(queryClient, pendingKey, clientMessageId, optimisticMessage);
332: 
333:       if (instrumentationEnabled) {
334:         debugLogger.messaging.event('useMessages.sendMessage', 'optimistic:applied', {
335:           traceId,
336:           optimisticId: optimisticMessage.id,
337:           conversationId: activeConversationId,
338:         });
339:       }
340: 
341:       try {
342:         // Server derives sender from session; do not send senderId
343:         const savedMessage = await messagingApi.sendMessage(
344:           {
345:             conversationId: activeConversationId,
346:             content: trimmedContent,
347:             replyToId: options?.replyToId,
348:             type: messageType,
349:           },
350:           {
351:             clientMessageId,
352:             attachmentIds: attachments?.map((attachment) => attachment.id),
353:           }
354:         );
355: 
356:         if (instrumentationEnabled) {
357:           const duration = start ? getTimestamp() - start : 0;
358:           if (start) {
359:             debugLogger.messaging.metric('useMessages.sendMessage', 'roundtrip', duration, {
360:               traceId,
361:               conversationId: activeConversationId,
362:               messageId: savedMessage.id,
363:             });
364:           }
365:           debugLogger.messaging.event('useMessages.sendMessage', 'api:success', {
366:             traceId,
367:             messageId: savedMessage.id,
368:             status: savedMessage.status,
369:           });
370:         }
371: 
372:         // The server stored (or replayed) the message of this key. Unless the
373:         // feed already observed it (the pending copy is then resolved: its
374:         // stored copy came by Realtime or a fetch, and its absence now means
375:         // it was removed) or this client saw it deleted, merge it into the
376:         // feed first, then drop the pending copy: the copy is hidden as soon
377:         // as the feed holds the key, so neither step shows two bubbles or none.
378:         const confirmed: Message = {
379:           ...savedMessage,
