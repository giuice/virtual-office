109: /**
110:  * Holds every create of this tab: optionally before it reaches the server
111:  * (`holdRequest`), and always after the real server answered, until
112:  * `release()` hands the real response to the page. Nothing is mocked.
113:  */
114: async function holdCreates(page: Page, { holdRequest = false }: { holdRequest?: boolean } = {}): 
Promise<CreateHold> {
115:   const held: HeldCreate[] = [];
116:   const waiters: Array<(entry: HeldCreate) => void> = [];
117:   let handedOut = 0;
118:   await page.route('**/api/messages/create', async (route: Route) => {
119:     const requestGate = deferred();
120:     const releaseGate = deferred();
121:     const fetched = deferred();
122:     const fulfilled = deferred();
123:     const entry: HeldCreate = {
124:       request: (route.request().postDataJSON() ?? {}) as Record<string, unknown>,
125:       capturedAt: Date.now(),
126:       letRequestThrough: requestGate.resolve,
127:       release: releaseGate.resolve,
128:       fetched: fetched.promise,
129:       fulfilled: fulfilled.promise,
130:     };
131:     held.push(entry);
132:     waiters.shift()?.(entry);
133:     if (!holdRequest) requestGate.resolve();
134:     await requestGate.promise;
135:     const response = await route.fetch();
136:     entry.status = response.status();
137:     entry.body = (await response.json().catch(() => ({}))) as CreateResponseBody;
138:     entry.fetchedAt = Date.now();
139:     fetched.resolve();
140:     await releaseGate.promise;
141:     entry.releasedAt = Date.now();
142:     await route.fulfill({ response });
143:     fulfilled.resolve();
144:   });
145:   return {
146:     next: () => {
147:       const index = handedOut;
148:       handedOut += 1;
149:       if (held[index]) return Promise.resolve(held[index]);
150:       return new Promise<HeldCreate>((resolve) => waiters.push(resolve));
151:     },
152:     all: () => [...held],
153:   };
154: }
