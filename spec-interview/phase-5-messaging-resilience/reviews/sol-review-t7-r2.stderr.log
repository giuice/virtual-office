262:       if (eventType === 'INSERT' && payload.new) {
263:         const message = mapRowToMessage(payload.new);
264: 
265:         // M-08: image/file messages arrive without their attachments. The
266:         // bare row is not shown (BR-007: a message is never visible without
267:         // its files); the feed refetches it with them. The refetch is the
268:         // deferred, non-cancelling one, so it never aborts an older page the
269:         // reader is loading.
270:         if (ATTACHMENT_MESSAGE_TYPES.has(message.type as string)) {
271:           scheduleFeedRefetch(message.conversationId);
272:         } else {
273:           appendMessageToCache(queryClient, message);
274:         }
275: 
276:         const ignoreSenderId = ignoreSenderIdRef.current;
277:         if (ignoreSenderId && message.senderId === ignoreSenderId) {
278:           return;
279:         }
280: 
281:         const callback = onInsertRef.current;
282:         if (callback) {
283:           callback(message);
284:         }
285:         return;
286:       }
287: 
288:       if (eventType === 'UPDATE' && payload.new) {
289:         updateMessageInCache(queryClient, payload.new.conversation_id as string, payload.new);
290:         return;
291:       }
292: 
293:       if (eventType === 'DELETE' && payload.old) {
294:         // Remembered so a late create response cannot bring it back.
295:         markMessageDeleted(queryClient, payload.old.id as string);
296:         removeMessageFromAllCaches(queryClient, payload.old.id as string);
297:       }
298:     };
299: 
300:     // Phase 2.2: read-receipt INSERTs (written in bulk by the
301:     // mark_conversation_read RPC) flip the sender's read indicator.
302:     // Refetch derives status from message_read_receipts server-side.
303:     // A burst of receipt events becomes one refetch per conversation, and it
304:     // never cancels an in-flight fetch: an invalidation with the default
305:     // cancelRefetch aborts an older page the reader is loading, after which
306:     // the infinite query refetches only the pages it already had. While a
307:     // fetch is running the refetch waits for it, so no receipt is lost.
308:     // The same deferred refetch catches a feed (and an open starred list,
309:     // which also pages) up after the channel (re)joins.
310:     const deferredRefetchTimers = new Map<string, ReturnType<typeof setTimeout>>();
311:     const scheduleDeferredRefetch = (queryKey: QueryKey) => {
312:       const timerKey = hashKey(queryKey);
313:       if (deferredRefetchTimers.has(timerKey)) return;
314:       deferredRefetchTimers.set(
315:         timerKey,
316:         setTimeout(() => {
317:           deferredRefetchTimers.delete(timerKey);
318:           if (!isMounted) return;
319:           const query = queryClient.getQueryCache().find({ queryKey, exact: true });
320:           if (query?.state.fetchStatus === 'fetching') {
321:             scheduleDeferredRefetch(queryKey);
322:             return;
323:           }
324:           void queryClient.invalidateQueries({ queryKey }, { cancelRefetch: false });
325:         }, RECEIPT_REFETCH_DELAY_MS)
326:       );
327:     };
328:     const scheduleFeedRefetch = (conversationId: string) => {
329:       scheduleDeferredRefetch(['messages', conversationId]);
330:     };

