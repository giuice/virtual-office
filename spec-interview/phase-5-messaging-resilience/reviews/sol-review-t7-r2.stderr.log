108: export const messagingApi = {
109:   /**
110:    * Send a new message. `clientMessageId` is the composition key (Phase 4
111:    * FR-024): resending it on a retry returns the message the server already
112:    * stored for it instead of creating a duplicate. `attachmentIds` are the
113:    * caller's pending uploads (POST /api/messages/upload) linked to the new
114:    * message in the same transaction (Phase 4 T12/T13).
115:    */
116:   async sendMessage(
117:     message: Partial<Message>,
118:     options?: { clientMessageId?: string; attachmentIds?: string[] }
119:   ): Promise<Message> {
120:     const scope = 'messagingApi.sendMessage';
121:     const requestId = createRequestId('msg-send');
122:     const start = getTimestamp();
123:     debugLogger.messaging.event(scope, 'fetch:start', {
124:       requestId,
125:       conversationId: message.conversationId,
126:       hasAttachments: (options?.attachmentIds?.length ?? 0) > 0,
127:       type: message.type,
128:     });
129: 
130:     try {
131:       const response = await fetch('/api/messages/create', {
132:         method: 'POST',
133:         headers: {
134:           'Content-Type': 'application/json',
135:         },
136:         body: JSON.stringify({
137:           ...message,
138:           // Attachments travel as upload ids; the server returns the linked files.
139:           attachments: undefined,
140:           ...(options?.clientMessageId ? { clientMessageId: options.clientMessageId } : {}),
141:           ...(options?.attachmentIds?.length ? { attachmentIds: options.attachmentIds } : {}),
142:         }),
143:       });
144: 
145:       const duration = getTimestamp() - start;
146:       debugLogger.messaging.metric(scope, 'fetch', duration, {
147:         requestId,
148:         status: response.status,
149:       });
150: 
151:       if (!response.ok) {
152:         const errorData = await response.json();
153:         debugLogger.messaging.warn(scope, 'fetch:non-ok', {
154:           requestId,
155:           status: response.status,
156:           error: errorData.error,
157:         });
158:         throw new Error(errorData.error || 'Failed to send message');
159:       }
160: 
161:       const data = await response.json();
162:       debugLogger.messaging.event(scope, 'fetch:success', {
163:         requestId,
164:         messageId: data.message?.id,
165:         status: data.message?.status,
166:       });
167:       // Same shape as feed messages (Date timestamps), since the sent
168:       // message joins the feed cache when Realtime has not delivered it.
169:       return {
170:         ...data.message,
171:         timestamp: normalizeDate(data.message?.timestamp),
172:         reactions: normalizeReactions(data.message?.reactions),
173:       };
174:     } catch (error) {
175:       const duration = getTimestamp() - start;
176:       debugLogger.messaging.error(scope, 'fetch:error', {
177:         requestId,
178:         duration,
179:         error: error instanceof Error ? error.message : error,
180:       });
181:       console.error('Error sending message:', error);
182:       throw error;
183:     }
184:   },
185: 
186:   /**
187:    * Get messages for a conversation with pagination
188:    */
189:   async getMessages(
190:     conversationId: string,
191:     options?: {
192:       limit?: number;
193:       cursor?: string; // legacy offset cursor (kept for compatibility)
194:       cursorBefore?: string; // ISO timestamp for older paging
195:       cursorAfter?: string; // ISO timestamp for newer paging
196:     }
197:   ): Promise<{
198:     messages: Message[];
199:     nextCursorBefore?: string;
200:     hasMoreOlder?: boolean;
201:     nextCursor?: string; // legacy
202:     hasMore?: boolean;   // legacy
203:   }> {
204:     const scope = 'messagingApi.getMessages';
205:     const requestId = createRequestId('msg-list');
206:     const start = getTimestamp();
207:     debugLogger.messaging.event(scope, 'fetch:start', {
208:       requestId,
209:       conversationId,
210:       limit: options?.limit,
211:       cursor: options?.cursor,
212:       cursorBefore: options?.cursorBefore,
213:       cursorAfter: options?.cursorAfter,
214:     });
215: 
216:     try {
217:       const params = new URLSearchParams();
218:       params.append('conversationId', conversationId);
219:       
220:       if (options?.limit) {
221:         params.append('limit', options.limit.toString());
222:       }
223:       
224:       if (options?.cursor) params.append('cursor', options.cursor);
225:       if (options?.cursorBefore) params.append('cursorBefore', options.cursorBefore);
226:       if (options?.cursorAfter) params.append('cursorAfter', options.cursorAfter);
227:       
228:       const response = await fetch(`/api/messages/get?${params.toString()}`);
229:       const duration = getTimestamp() - start;
230:       debugLogger.messaging.metric(scope, 'fetch', duration, {
231:         requestId,
232:         status: response.status,
233:       });
234:       
235:       if (!response.ok) {
236:         const errorData = await response.json();
237:         debugLogger.messaging.warn(scope, 'fetch:non-ok', {
238:           requestId,
239:           status: response.status,
240:           error: errorData.error,
241:         });
242:         throw new Error(errorData.error || 'Failed to fetch messages');
243:       }
244:       
245:       const data = await response.json();
246:       debugLogger.messaging.event(scope, 'fetch:success', {
247:         requestId,
248:         total: Array.isArray(data.messages) ? data.messages.length : 0,
249:         hasMoreOlder: data.hasMoreOlder,
250:       });
251:       // Normalize timestamps to Date for client cache consistency
252:       if (Array.isArray(data.messages)) {
253:         data.messages = data.messages.map((m: Message) => ({
254:           ...m,
255:           timestamp: normalizeDate(m.timestamp),
256:           reactions: normalizeReactions(m.reactions),
257:         }));
258:       }
259:       return data;
260:     } catch (error) {
261:       const duration = getTimestamp() - start;
262:       debugLogger.messaging.error(scope, 'fetch:error', {
263:         requestId,
264:         duration,
265:         error: error instanceof Error ? error.message : error,
266:       });
267:       console.error('Error fetching messages:', error);
268:       throw error;
269:     }
270:   },
