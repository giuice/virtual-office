, 'CREATE TYPE', 'ALTER TYPE'\n    , 'CREATE RULE'\n    , 'COMMENT'\n    )\n    -- don't notify in case of CREATE TEMP 
table or other objects created on pg_temp\n    AND cmd.schema_name is distinct from 'pg_temp'\n    THEN\n      NOTIFY 
pgrst, 'reload schema';\n    END IF;\n  END LOOP;\nEND; $function$\n"},{"evtname":"pgrst_drop_watch","evtevent":"sql_dr
