 721: revoke all on function private.authorize_client_conversation_insert(text, uuid[], uuid, text) from public, anon, 
authenticated, service_role;
 722: grant execute on function private.authorize_client_conversation_insert(text, uuid[], uuid, text) to 
authenticated;
