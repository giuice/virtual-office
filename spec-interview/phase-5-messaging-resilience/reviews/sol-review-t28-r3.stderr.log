 724: -- SECURITY INVOKER: current_user identifies a Data API client.
 725: create or replace function private.guard_client_conversation_insert()
 726: returns trigger
 727: language plpgsql
 728: set search_path = ''
 729: as $$
 730: begin
 731:   if current_user in ('anon', 'authenticated') then
 732:     perform private.authorize_client_conversation_insert(
 733:       (new.type)::text, new.participants, new.room_id, (new.visibility)::text);
 734:   end if;
 735:   return new;
 736: end;
 737: $$;
 738: 
 739: revoke all on function private.guard_client_conversation_insert() from public, anon, authenticated, service_role;
 740: 
 741: drop trigger if exists conversations_guard_client_insert on public.conversations;
 742: create trigger conversations_guard_client_insert
 743:   before insert on public.conversations
 744:   for each row execute function private.guard_client_conversation_insert();
 745: 
 746: revoke insert, update, delete, truncate on table public.conversations from anon;
 747: -- No client deletes conversations (there is no DELETE policy; the only caller
 748: -- of a conversation delete is the service-role test seeder).
 749: revoke update, delete, truncate on table public.conversations from authenticated;
