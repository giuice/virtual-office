 724: -- SECURITY INVOKER: current_user identifies a Data API client.
 725: create or replace function private.guard_client_conversation_insert()
 726: returns trigger
 727: language plpgsql
 728: set search_path = ''
 729: as $$
 730: begin
 731:   if current_user in ('anon', 'authenticated') then
 732:     perform private.authorize_client_conversation_insert(
 733:       (new.type)::text, new.participants, new.room_id, (new.visibility)::text);
 734:   end if;
 735:   return new;
 736: end;
 737: $$;
 738: 
 739: revoke all on function private.guard_client_conversation_insert() from public, anon, authenticated, service_role;
 740: 
 741: drop trigger if exists conversations_guard_client_insert on public.conversations;
 742: create trigger conversations_guard_client_insert
 743:   before insert on public.conversations
 744:   for each row execute function private.guard_client_conversation_insert();
 745: 
 746: revoke insert, update, delete, truncate on table public.conversations from anon;
 747: -- No client deletes conversations (there is no DELETE policy; the only caller
 748: -- of a conversation delete is the service-role test seeder).
 749: revoke update, delete, truncate on table public.conversations from authenticated;
 750: grant update (name, last_activity, is_archived) on table public.conversations to authenticated;
 751: 
 752: -- ---------------------------------------------------------------------------
 753: -- 5. Participants sync: creation, and authorized additions only.
 754: -- ---------------------------------------------------------------------------
 755: create or replace function public.sync_conversation_members()
 756: returns trigger
 757: language plpgsql
 758: security definer
 759: set search_path = ''
 760: as $$
 761: declare
 762:   v_added uuid[];
 763: begin
 764:   if tg_op = 'INSERT' then
 765:     -- The memberships of a new conversation (client inserts were authorized
 766:     -- by conversations_guard_client_insert; service-role/admin inserts are
 767:     -- server code).
 768:     insert into public.conversation_members (conversation_id, user_id, last_read_at)
 769:     select new.id, u.id, pg_catalog.now()
 770:     from public.users u
 771:     where u.id = any (coalesce(new.participants, '{}'::uuid[]))
 772:     on conflict (conversation_id, user_id) do nothing;
 773:     return new;
 774:   end if;
 775: 
 776:   -- UPDATE OF participants: only ids newly added get a membership; an id
 777:   -- already in the old array (e.g. a removed member) is never re-created.
 778:   select coalesce(pg_catalog.array_agg(distinct u.id order by u.id), '{}'::uuid[])
 779:   into v_added
 780:   from public.users u
 781:   where u.id = any (coalesce(new.participants, '{}'::uuid[]))
 782:     and array_position(coalesce(old.participants, '{}'::uuid[]), u.id) is null;
 783: 
 784:   if pg_catalog.cardinality(v_added) = 0 then
 785:     return new;
 786:   end if;
 787: 
 788:   if new.type <> 'room'::public.conversation_type or new.room_id is null then
 789:     raise exception 'MEMBERSHIP_GRANT_FORBIDDEN' using errcode = '42501';
 790:   end if;
 791:   if exists (
 792:     select 1
 793:     from private.conversation_member_revocations r
 794:     where r.conversation_id = new.id
 795:       and r.user_id = any (v_added)
 796:   ) then
 797:     raise exception 'MEMBERSHIP_REVOKED' using errcode = '42501';
 798:   end if;
 799: 
 800:   perform private.authorize_room_membership(v_added, new.room_id);
 801: 
 802:   insert into public.conversation_members (conversation_id, user_id, last_read_at)
 803:   select new.id, a.user_id, pg_catalog.now()
 804:   from pg_catalog.unnest(v_added) as a(user_id)
 805:   on conflict (conversation_id, user_id) do nothing;
 806:   return new;
 807: end;
 808: $$;
 809: 
 810: -- A trigger function cannot be called directly; the baseline grants are still
 811: -- removed from the API roles (RLS review). service_role keeps its grant.
 812: revoke execute on function public.sync_conversation_members() from public, anon, authenticated;
 813: 
 814: -- ---------------------------------------------------------------------------
 815: -- 6. Server join / authorized rejoin.
 816: -- ---------------------------------------------------------------------------
 817: -- Room join (POST /api/conversations/join, room resolver). Returns true when a
 818: -- membership was created, false when the user already is a member. Raises
 819: -- CONVERSATION_NOT_FOUND / ROOM_NOT_FOUND / USER_NOT_FOUND (P0002),
 820: -- JOIN_FORBIDDEN / MEMBERSHIP_REVOKED / ROOM_ACCESS_DENIED (42501).
 821: -- Lock order (review T28 r1 #5): the user and the space (authorize_room_
 822: -- membership: users -> spaces, the Presence order), THEN the conversation â€”
 823: -- the order of a space DELETE, which locks the space and then, through
 824: -- ON DELETE SET NULL, its room conversation. The conversation is re-read
 825: -- under its lock and must still belong to the authorized room.
 826: create or replace function public.join_room_conversation(p_conversation_id uuid, p_user_id uuid)
 827: returns boolean
 828: language plpgsql
 829: security definer
 830: set search_path = ''
 831: as $$
 832: declare
 833:   v_conversation public.conversations;
 834:   v_room_id uuid;
 835: begin
 836:   if p_conversation_id is null or p_user_id is null then
 837:     raise exception 'join_room_conversation: conversation and user are required' using errcode = '22004';
 838:   end if;
 839: 
 840:   -- Unlocked read: a current member is answered without any lock (no grant).
 841:   select c.* into v_conversation
 842:   from public.conversations c
 843:   where c.id = p_conversation_id;
 844:   if not found then
 845:     raise exception 'CONVERSATION_NOT_FOUND' using errcode = 'P0002';
 846:   end if;
 847:   if exists (
 848:     select 1
 849:     from public.conversation_members cm
 850:     where cm.conversation_id = p_conversation_id
 851:       and cm.user_id = p_user_id
 852:   ) then
 853:     return false;
 854:   end if;
 855:   if v_conversation.type <> 'room'::public.conversation_type or v_conversation.room_id is null then
 856:     raise exception 'JOIN_FORBIDDEN' using errcode = '42501';
 857:   end if;
 858:   v_room_id := v_conversation.room_id;
 859: 
 860:   perform private.authorize_room_membership(array[p_user_id], v_room_id);
 861: 
 862:   select c.* into v_conversation
 863:   from public.conversations c
 864:   where c.id = p_conversation_id
 865:   for no key update;
 866:   if not found then
 867:     raise exception 'CONVERSATION_NOT_FOUND' using errcode = 'P0002';
 868:   end if;
 869:   if v_conversation.type <> 'room'::public.conversation_type
 870:      or v_conversation.room_id is distinct from v_room_id then
 871:     raise exception 'JOIN_FORBIDDEN' using errcode = '42501';
 872:   end if;
 873:   if exists (
 874:     select 1
 875:     from public.conversation_members cm
 876:     where cm.conversation_id = p_conversation_id
 877:       and cm.user_id = p_user_id
 878:   ) then
 879:     return false;
 880:   end if;
 881:   if exists (
 882:     select 1
 883:     from private.conversation_member_revocations r
 884:     where r.conversation_id = p_conversation_id
 885:       and r.user_id = p_user_id
 886:   ) then
 887:     raise exception 'MEMBERSHIP_REVOKED' using errcode = '42501';
 888:   end if;
 889: 
 890:   if array_position(coalesce(v_conversation.participants, '{}'::uuid[]), p_user_id) is null then
 891:     -- sync_conversation_members creates the membership (same checks; the
 892:     -- locks are already held, so it does not wait).
 893:     update public.conversations c
 894:     set participants = pg_catalog.array_append(coalesce(c.participants, '{}'::uuid[]), p_user_id)
 895:     where c.id = p_conversation_id;
 896:   else
 897:     insert into public.conversation_members (conversation_id, user_id, last_read_at)
 898:     values (p_conversation_id, p_user_id, pg_catalog.now())
 899:     on conflict (conversation_id, user_id) do nothing;
 900:   end if;
 901:   return true;
 902: end;
 903: $$;
 904: 
 905: revoke all on function public.join_room_conversation(uuid, uuid) from public, anon, authenticated, service_role;
 906: grant execute on function public.join_room_conversation(uuid, uuid) to service_role;
 907: 
 908: -- The explicitly authorized rejoin of a revoked member (server/admin only), and
 909: -- the only code that lifts a revocation. A ROOM conversation requires the
 910: -- room's access rules on the locked rows; a room conversation whose space was
 911: -- deleted (room_id set NULL) raises ROOM_NOT_FOUND and keeps the revocation
 912: -- (review T28 r1 #4). A direct or group conversation restores only an original
 913: -- participant. Same lock order as join_room_conversation. Returns false when
 914: -- the user already is a member. Raises CONVERSATION_NOT_FOUND / ROOM_NOT_FOUND
 915: -- / USER_NOT_FOUND (P0002), MEMBERSHIP_GRANT_FORBIDDEN / ROOM_ACCESS_DENIED
 916: -- (42501).
 917: create or replace function public.restore_conversation_membership(p_conversation_id uuid, p_user_id uuid)
 918: returns boolean
 919: language plpgsql
 920: security definer
 921: set search_path = ''
 922: as $$
 923: declare
 924:   v_conversation public.conversations;
 925:   v_type public.conversation_type;
 926:   v_room_id uuid;
 927:   v_in_participants boolean;
 928: begin
 929:   if p_conversation_id is null or p_user_id is null then
 930:     raise exception 'restore_conversation_membership: conversation and user are required' using errcode = 
'22004';
 931:   end if;
 932: 
 933:   select c.* into v_conversation
 934:   from public.conversations c
 935:   where c.id = p_conversation_id;
 936:   if not found then
 937:     raise exception 'CONVERSATION_NOT_FOUND' using errcode = 'P0002';
 938:   end if;
 939:   if exists (
 940:     select 1
 941:     from public.conversation_members cm
 942:     where cm.conversation_id = p_conversation_id
 943:       and cm.user_id = p_user_id
 944:   ) then
 945:     return false;
 946:   end if;
 947:   v_type := v_conversation.type;
 948:   v_room_id := v_conversation.room_id;
 949: 
 950:   if v_type = 'room'::public.conversation_type then
 951:     if v_room_id is null then
 952:       raise exception 'ROOM_NOT_FOUND' using errcode = 'P0002';
 953:     end if;
 954:     perform private.authorize_room_membership(array[p_user_id], v_room_id);
 955:   else
 956:     perform 1 from public.users u where u.id = p_user_id for share;
 957:     if not found then
 958:       raise exception 'USER_NOT_FOUND' using errcode = 'P0002';
 959:     end if;
 960:   end if;
 961: 
 962:   select c.* into v_conversation
 963:   from public.conversations c
 964:   where c.id = p_conversation_id
 965:   for no key update;
 966:   if not found then
 967:     raise exception 'CONVERSATION_NOT_FOUND' using errcode = 'P0002';
 968:   end if;
 969:   if v_conversation.type is distinct from v_type
 970:      or v_conversation.room_id is distinct from v_room_id then
 971:     raise exception 'MEMBERSHIP_GRANT_FORBIDDEN' using errcode = '42501';
 972:   end if;
 973:   if exists (
 974:     select 1
 975:     from public.conversation_members cm
 976:     where cm.conversation_id = p_conversation_id
 977:       and cm.user_id = p_user_id
 978:   ) then
 979:     return false;
 980:   end if;
 981: 
 982:   v_in_participants :=
 983:     array_position(coalesce(v_conversation.participants, '{}'::uuid[]), p_user_id) is not null;
 984:   if v_type <> 'room'::public.conversation_type and not v_in_participants then
 985:     raise exception 'MEMBERSHIP_GRANT_FORBIDDEN' using errcode = '42501';
 986:   end if;
 987: 
 988:   delete from private.conversation_member_revocations r
 989:   where r.conversation_id = p_conversation_id
 990:     and r.user_id = p_user_id;
 991: 
 992:   if not v_in_participants then
 993:     update public.conversations c
 994:     set participants = pg_catalog.array_append(coalesce(c.participants, '{}'::uuid[]), p_user_id)
 995:     where c.id = p_conversation_id;
 996:   else
 997:     insert into public.conversation_members (conversation_id, user_id, last_read_at)
 998:     values (p_conversation_id, p_user_id, pg_catalog.now())
 999:     on conflict (conversation_id, user_id) do nothing;
1000:   end if;
1001:   return true;
1002: end;
1003: $$;
1004: 
1005: revoke all on function public.restore_conversation_membership(uuid, uuid) from public, anon, authenticated, 
service_role;
1006: grant execute on function public.restore_conversation_membership(uuid, uuid) to service_role;
1007: 
1008: -- ---------------------------------------------------------------------------
1009: -- 7. Per-message read receipts: lock the membership (never for a removed one).
1010: -- ---------------------------------------------------------------------------
1011: create or replace function public.mark_messages_read(p_conversation_id uuid, p_user_id uuid, p_message_ids 
uuid[])
1012: returns integer
1013: language plpgsql
1014: security definer
1015: set search_path = ''
1016: as $$
1017: declare
1018:   v_recorded integer;
1019: begin
1020:   if p_conversation_id is null or p_user_id is null then
1021:     raise exception 'mark_messages_read: conversation and user are required'
1022:       using errcode = '22004';
1023:   end if;
1024: 
1025:   if p_message_ids is null or pg_catalog.cardinality(p_message_ids) = 0 then
1026:     return 0;
1027:   end if;
1028: 
1029:   -- Bounded input: the route caps the batch at 100 ids as well.
1030:   if pg_catalog.cardinality(p_message_ids) > 100 then
1031:     raise exception 'mark_messages_read: at most 100 message ids per call'
1032:       using errcode = '22023';
1033:   end if;
1034: 
1035:   -- Phase 5 T28: the membership row is locked until commit, so a concurrent
1036:   -- removal either committed first (refused here) or waits for these receipts.
1037:   perform 1
1038:   from public.conversation_members cm
1039:   where cm.conversation_id = p_conversation_id
1040:     and cm.user_id = p_user_id
1041:   for key share;
1042:   if not found then
1043:     raise exception 'mark_messages_read: user is not a member of the conversation'
1044:       using errcode = '42501';
1045:   end if;
1046: 
1047:   -- Ids outside the conversation are ignored; the caller's own messages never
1048:   -- get a receipt (system messages with a null sender may). Repeats are
1049:   -- idempotent on the unique (message_id, user_id).
1050:   insert into public.message_read_receipts (message_id, conversation_id, user_id)
1051:   select m.id, m.conversation_id, p_user_id
1052:   from public.messages m
1053:   where m.conversation_id = p_conversation_id
1054:     and m.id = any (p_message_ids)
1055:     and m.sender_id is distinct from p_user_id
1056:   on conflict (message_id, user_id) do nothing;
1057: 
1058:   get diagnostics v_recorded = row_count;
1059:   return v_recorded;
1060: end;
1061: $$;
1062: 
1063: commit;

