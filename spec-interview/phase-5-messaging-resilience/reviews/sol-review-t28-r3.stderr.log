 263: begin;
 264: 
 265: set local lock_timeout = '5s';
 266: 
 267: -- Review T28 r1 #2: no membership may be removed between the backfill below
 268: -- and the installation of the revocation trigger, so the tables are locked for
 269: -- the whole migration: public.users (EXCLUSIVE: it includes the SHARE ROW
 270: -- EXCLUSIVE the revocations foreign key needs, and it also excludes row locks
 271: -- on users â€” a SELECT ... FOR UPDATE holder would otherwise make the
 272: -- backfill's foreign-key check wait; Supabase/RLS review of r2), public.conversations
 273: -- and public.conversation_members (ACCESS EXCLUSIVE). Review T28 r2 #1:
 274: -- application transactions take these tables in BOTH orders (e.g.
 275: -- mark_conversation_read updates conversation_members and then its receipt
 276: -- inserts lock conversations through their foreign key; joins lock users and
 277: -- conversations; Presence writes users), so no table order is safe while
 278: -- waiting. Every lock is therefore taken NOWAIT: the migration never waits
 279: -- behind (nor deadlocks with) an application transaction; on contention it
 280: -- fails at once with lock_not_available (55P03) before changing anything, and
 281: -- the operator re-runs the whole migration. Once these locks are held, no later
 282: -- statement of this migration waits for an application lock: the rows it
 283: -- reads or references (users, conversations, conversation_members) cannot be
 284: -- locked by anyone else, the revocations table is new, and functions, triggers,
 285: -- policies and grants touch only the catalog and these tables.
 286: lock table public.users in exclusive mode nowait;
 287: lock table public.conversations, public.conversation_members in access exclusive mode nowait;
 288: 
 289: -- ---------------------------------------------------------------------------
 290: -- 1. Revocations (removed memberships stay removed).
 291: -- ---------------------------------------------------------------------------
 292: create table if not exists private.conversation_member_revocations (
 293:   conversation_id uuid not null references public.conversations (id) on delete cascade,
 294:   user_id uuid not null references public.users (id) on delete cascade,
 295:   revoked_at timestamptz not null default pg_catalog.now(),
 296:   primary key (conversation_id, user_id)
 297: );
 298: 
 299: create index if not exists idx_conversation_member_revocations_user_id
 300:   on private.conversation_member_revocations (user_id);
 301: 
 302: alter table private.conversation_member_revocations enable row level security;
 303: revoke all on table private.conversation_member_revocations from public, anon, authenticated, service_role;
 304: 
 305: comment on table private.conversation_member_revocations is
 306:   'Phase 5 T28: memberships removed (DELETE of a conversation_members row that was not an FK cascade). A revoked 
user is never re-added by participants syncs or joins; only public.restore_conversation_membership lifts it. No API 
role has any privilege.';
 307: 
 308: -- Participants that lost their membership before this migration (a removed
 309: -- member stays in conversations.participants) are revocations.
 310: insert into private.conversation_member_revocations (conversation_id, user_id)
 311: select distinct c.id, p.user_id
 312: from public.conversations c
 313: cross join lateral pg_catalog.unnest(c.participants) as p(user_id)
 314: join public.users u on u.id = p.user_id
 315: where not exists (
 316:   select 1
 317:   from public.conversation_members cm
 318:   where cm.conversation_id = c.id
 319:     and cm.user_id = p.user_id
 320: )
 321: on conflict (conversation_id, user_id) do nothing;
 322: 
 323: -- ---------------------------------------------------------------------------
 324: -- 2. Room access rules (ConversationResolverService.assertRoomAccess).
 325: -- ---------------------------------------------------------------------------
 326: -- JavaScript truthiness of a JSON value as the TypeScript code sees it after
 327: -- JSON.parse (numbers become IEEE doubles). Returns NULL for a number outside
 328: -- the double range â€” e.g. 1e-400, which JSON.parse turns into 0, or 1e400
 329: -- (Infinity) â€” because PostgreSQL refuses it as out of range; callers treat
 330: -- NULL as a malformed ACL and deny (ROOM_ACL_INVALID), never as truthy.
 331: create or replace function private.jsonb_js_truthy(p_value jsonb)
 332: returns boolean
 333: language plpgsql
 334: immutable
 335: set search_path = ''
 336: as $$
 337: begin
 338:   case pg_catalog.jsonb_typeof(p_value)
 339:     when 'boolean' then
 340:       return (p_value)::text::boolean;
 341:     when 'number' then
 342:       begin
 343:         return ((p_value)::text)::double precision <> 0;
 344:       exception when numeric_value_out_of_range then
 345:         return null;
 346:       end;
 347:     when 'string' then
 348:       return (p_value #>> '{}') <> '';
 349:     when 'object' then
 350:       return true;
 351:     when 'array' then
 352:       return true;
 353:     else
 354:       -- JSON null, or a missing key (SQL NULL).
 355:       return false;
 356:   end case;
 357: end;
 358: $$;
 359: 
 360: revoke all on function private.jsonb_js_truthy(jsonb) from public, anon, authenticated, service_role;
 361: 
 362: -- Pure function of the two rows; null = allowed, otherwise the reason.
 363: -- Mirrors the TypeScript rule: different (non-null) companies deny; with an
 364: -- access_control object, a non-empty allowedUsers must contain users.id, a
 365: -- non-empty allowedRoles must contain the user's role, and a room that is not
 366: -- public (JavaScript truthiness of isPublic) with no allowed users/roles
 367: -- denies a user without a company; a falsy access_control (null, false, 0,
 368: -- "") skips the access-control checks, as in TypeScript. Stricter than the
 369: -- TypeScript rule only for malformed data, which denies (ROOM_ACL_INVALID): an
 370: -- allowedUsers/allowedRoles that is neither an array nor null (TypeScript
 371: -- would treat a string by its characters), and an access_control or isPublic
 372: -- number outside the double range (JSON.parse would turn it into 0/Infinity).
 373: create or replace function private.room_access_denial(p_user public.users, p_space public.spaces)
 374: returns text
 375: language plpgsql
 376: stable
 377: set search_path = ''
 378: as $$
 379: declare
 380:   v_ac jsonb := p_space.access_control;
 381:   v_users jsonb;
 382:   v_roles jsonb;
 383:   v_truthy boolean;
 384:   v_public boolean;
 385: begin
 386:   if p_space.company_id is not null
 387:      and p_user.company_id is not null
 388:      and p_space.company_id <> p_user.company_id then
 389:     return 'COMPANY_MISMATCH';
 390:   end if;
 391: 
 392:   -- `if (accessControl)`: a falsy value (null, false, 0, "") skips every
 393:   -- access-control check.
 394:   v_truthy := private.jsonb_js_truthy(v_ac);
 395:   if v_truthy is null then
 396:     return 'ROOM_ACL_INVALID';
 397:   end if;
 398:   if not v_truthy then
 399:     return null;
 400:   end if;
 401:   if pg_catalog.jsonb_typeof(v_ac) <> 'object' then
 402:     -- A truthy JavaScript non-object (true, string, number, array) has no
 403:     -- such properties.
 404:     v_ac := '{}'::jsonb;
 405:   end if;
 406: 
 407:   v_users := v_ac -> 'allowedUsers';
 408:   v_roles := v_ac -> 'allowedRoles';
 409:   if v_users is null or pg_catalog.jsonb_typeof(v_users) = 'null' then
 410:     v_users := '[]'::jsonb;
 411:   end if;
 412:   if v_roles is null or pg_catalog.jsonb_typeof(v_roles) = 'null' then
 413:     v_roles := '[]'::jsonb;
 414:   end if;
 415:   if pg_catalog.jsonb_typeof(v_users) <> 'array' or pg_catalog.jsonb_typeof(v_roles) <> 'array' then
 416:     return 'ROOM_ACL_INVALID';
 417:   end if;
 418: 
 419:   if pg_catalog.jsonb_array_length(v_users) > 0 and not (v_users ? (p_user.id)::text) then
 420:     return 'NOT_ALLOWED_USER';
 421:   end if;
 422:   if pg_catalog.jsonb_array_length(v_roles) > 0
 423:      and p_user.role is not null
 424:      and not (v_roles ? (p_user.role)::text) then
 425:     return 'NOT_ALLOWED_ROLE';
 426:   end if;
 427: 
 428:   v_public := private.jsonb_js_truthy(v_ac -> 'isPublic');
 429:   if v_public is null then
 430:     return 'ROOM_ACL_INVALID';
 431:   end if;
 432:   if not v_public
 433:      and pg_catalog.jsonb_array_length(v_users) = 0
 434:      and pg_catalog.jsonb_array_length(v_roles) = 0
 435:      and p_user.company_id is null then
 436:     return 'PRIVATE_NO_COMPANY';
 437:   end if;
 438: 
 439:   return null;
 440: end;
 441: $$;
 442: 
 443: revoke all on function private.room_access_denial(public.users, public.spaces) from public, anon, authenticated, 
service_role;
 444: 
 445: -- Locks the users (FOR SHARE, id order) and then the space (FOR SHARE) and
 446: -- raises unless every user passes the room's access rules on the locked rows:
 447: -- USER_NOT_FOUND / ROOM_NOT_FOUND (P0002), ROOM_ACCESS_DENIED (42501).
 448: -- Called only from SECURITY DEFINER code of this migration.
 449: create or replace function private.authorize_room_membership(p_user_ids uuid[], p_space_id uuid)
 450: returns void
 451: language plpgsql
 452: set search_path = ''
 453: as $$
 454: declare
 455:   v_user public.users;
 456:   v_space public.spaces;
 457:   v_count integer;
 458: begin
 459:   if p_space_id is null or p_user_ids is null or pg_catalog.cardinality(p_user_ids) = 0 then
 460:     raise exception 'ROOM_NOT_FOUND' using errcode = 'P0002';
 461:   end if;
 462: 
 463:   select pg_catalog.count(*) into v_count
 464:   from (
 465:     select u.id
 466:     from public.users u
 467:     where u.id = any (p_user_ids)
 468:     order by u.id
 469:     for share
 470:   ) as locked;
 471:   if v_count <> (select pg_catalog.count(distinct x) from pg_catalog.unnest(p_user_ids) as t(x) where x is not 
null)
 472:      or array_position(p_user_ids, null) is not null then
 473:     raise exception 'USER_NOT_FOUND' using errcode = 'P0002';
 474:   end if;
 475: 
 476:   select s.* into v_space
 477:   from public.spaces s
 478:   where s.id = p_space_id
 479:   for share;
 480:   if not found then
 481:     raise exception 'ROOM_NOT_FOUND' using errcode = 'P0002';
 482:   end if;
 483: 
 484:   for v_user in
 485:     select u.* from public.users u where u.id = any (p_user_ids) order by u.id
 486:   loop
 487:     if private.room_access_denial(v_user, v_space) is not null then
 488:       raise exception 'ROOM_ACCESS_DENIED' using errcode = '42501',
 489:         detail = private.room_access_denial(v_user, v_space);
 490:     end if;
 491:   end loop;
 492: end;
 493: $$;
 494: 
 495: revoke all on function private.authorize_room_membership(uuid[], uuid) from public, anon, authenticated, 
service_role;
 496: 
 497: -- ---------------------------------------------------------------------------
 498: -- 3. conversation_members: client writes.
 499: -- ---------------------------------------------------------------------------
 500: -- Locks the existing membership row FOR KEY SHARE (a concurrent DELETE waits
 501: -- for the caller, or has committed and the row is gone). True when it exists.
 502: create or replace function private.lock_existing_conversation_membership(p_conversation_id uuid, p_user_id uuid)
 503: returns boolean
 504: language plpgsql
 505: security definer
 506: set search_path = ''
 507: as $$
 508: begin
 509:   perform 1
 510:   from public.conversation_members cm
 511:   where cm.conversation_id = p_conversation_id
 512:     and cm.user_id = p_user_id
 513:   for key share;
 514:   return found;
 515: end;
 516: $$;
 517: 
 518: revoke all on function private.lock_existing_conversation_membership(uuid, uuid) from public, anon, 
authenticated, service_role;
 519: grant execute on function private.lock_existing_conversation_membership(uuid, uuid) to authenticated, 
service_role;
 520: 
 521: -- SECURITY INVOKER on purpose: current_user is the role of the INSERT
 522: -- statement (anon/authenticated/service_role for Data API requests; the
 523: -- function owner inside SECURITY DEFINER code such as the participants sync).
 524: create or replace function private.guard_conversation_member_insert()
 525: returns trigger
 526: language plpgsql
 527: set search_path = ''
 528: as $$
 529: begin
 530:   if current_user in ('anon', 'authenticated', 'service_role') then
 531:     -- API roles never create a membership: only the upsert of an existing
 532:     -- row (which then takes the ON CONFLICT DO UPDATE path) is accepted.
 533:     if not private.lock_existing_conversation_membership(new.conversation_id, new.user_id) then
 534:       raise exception 'NOT_PARTICIPANT' using errcode = '42501';
 535:     end if;
 536:   else
 537:     -- Authorized creation (SECURITY DEFINER code of this migration, or a
 538:     -- database administrator). Review T28 r1 #1: re-checked here, at the
 539:     -- insertion boundary, after every authorization wait of the caller. The
 540:     -- existing row (if any) is locked first, so a removal either committed
 541:     -- (row gone, its revocation committed with it and visible below) or waits
 542:     -- for this transaction. A revoked user is never inserted; only
 543:     -- public.restore_conversation_membership lifts a revocation (it deletes
 544:     -- the revocation before inserting).
 545:     perform 1
 546:     from public.conversation_members cm
 547:     where cm.conversation_id = new.conversation_id
 548:       and cm.user_id = new.user_id
 549:     for key share;
 550:     if exists (
 551:       select 1
 552:       from private.conversation_member_revocations r
 553:       where r.conversation_id = new.conversation_id
 554:         and r.user_id = new.user_id
 555:     ) then
 556:       raise exception 'MEMBERSHIP_REVOKED' using errcode = '42501';
 557:     end if;
 558:   end if;
 559:   return new;
 560: end;
 561: $$;
 562: 
 563: revoke all on function private.guard_conversation_member_insert() from public, anon, authenticated, service_role;
 564: 
 565: drop trigger if exists conversation_members_guard_insert on public.conversation_members;
 566: create trigger conversation_members_guard_insert
 567:   before insert on public.conversation_members
 568:   for each row execute function private.guard_conversation_member_insert();
 569: 
 570: create or replace function private.guard_conversation_member_identity()
 571: returns trigger
 572: language plpgsql
 573: set search_path = ''
 574: as $$
 575: begin
 576:   if new.id is distinct from old.id
 577:      or new.conversation_id is distinct from old.conversation_id
 578:      or new.user_id is distinct from old.user_id then
 579:     raise exception 'MEMBERSHIP_IDENTITY_IMMUTABLE' using errcode = '42501';
 580:   end if;
 581:   return new;
 582: end;
 583: $$;
 584: 
 585: revoke all on function private.guard_conversation_member_identity() from public, anon, authenticated, 
service_role;
 586: 
 587: drop trigger if exists conversation_members_identity_immutable on public.conversation_members;
 588: create trigger conversation_members_identity_immutable
 589:   before update on public.conversation_members
 590:   for each row execute function private.guard_conversation_member_identity();
 591: 
 592: -- A removed membership (not an FK cascade of a deleted conversation or user,
 593: -- whose parent row is already gone) becomes a revocation.
 594: create or replace function private.record_conversation_member_revocation()
 595: returns trigger
 596: language plpgsql
 597: security definer
 598: set search_path = ''
 599: as $$
 600: begin
 601:   insert into private.conversation_member_revocations (conversation_id, user_id)
 602:   select old.conversation_id, old.user_id
 603:   where exists (select 1 from public.conversations c where c.id = old.conversation_id)
 604:     and exists (select 1 from public.users u where u.id = old.user_id)
 605:   on conflict (conversation_id, user_id) do update
 606:     set revoked_at = pg_catalog.now();
 607:   return old;
 608: end;
 609: $$;
 610: 
 611: revoke all on function private.record_conversation_member_revocation() from public, anon, authenticated, 
service_role;
 612: 
 613: drop trigger if exists conversation_members_record_revocation on public.conversation_members;
 614: create trigger conversation_members_record_revocation
 615:   after delete on public.conversation_members
 616:   for each row execute function private.record_conversation_member_revocation();
 617: 
 618: drop policy if exists "Users can delete their own conversation preferences" on public.conversation_members;
 619: 
 620: drop policy if exists "Users can insert their own conversation preferences" on public.conversation_members;
 621: create policy "Users can insert their own conversation preferences"
 622:   on public.conversation_members
 623:   for insert
 624:   to authenticated
 625:   with check (
 626:     user_id = (select private.current_app_user_id())
 627:     and private.is_conversation_member(conversation_id)
 628:   );
 629: 
 630: drop policy if exists "Users can update their own conversation preferences" on public.conversation_members;
 631: create policy "Users can update their own conversation preferences"
 632:   on public.conversation_members
 633:   for update
 634:   to authenticated
 635:   using (user_id = (select private.current_app_user_id()))
 636:   with check (user_id = (select private.current_app_user_id()));
 637: 
 638: revoke insert, update, delete, truncate on table public.conversation_members from anon;
 639: revoke delete, truncate on table public.conversation_members from authenticated;
