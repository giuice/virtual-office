 641: -- ---------------------------------------------------------------------------
 642: -- 4. conversations: client writes.
 643: -- ---------------------------------------------------------------------------
 644: -- Authorizes a client-created conversation under row locks (see header).
 645: -- Raises CONVERSATION_CREATE_FORBIDDEN / ROOM_ACCESS_DENIED (42501),
 646: -- USER_NOT_FOUND / ROOM_NOT_FOUND (P0002).
 647: create or replace function private.authorize_client_conversation_insert(
 648:   p_type text,
 649:   p_participants uuid[],
 650:   p_room_id uuid,
 651:   p_visibility text
 652: )
 653: returns void
 654: language plpgsql
 655: security definer
 656: set search_path = ''
 657: as $$
 658: declare
 659:   v_caller uuid := private.current_app_user_id();
 660:   v_users public.users[];
 661:   v_space public.spaces;
 662:   v_derived text;
 663: begin
 664:   if v_caller is null
 665:      or p_participants is null
 666:      or array_position(p_participants, null) is not null
 667:      or not (v_caller = any (p_participants)) then
 668:     raise exception 'CONVERSATION_CREATE_FORBIDDEN' using errcode = '42501';
 669:   end if;
 670: 
 671:   if p_type = 'direct' then
 672:     if pg_catalog.cardinality(p_participants) <> 2
 673:        or (select pg_catalog.count(distinct x) from pg_catalog.unnest(p_participants) as t(x)) <> 2
 674:        or p_room_id is not null
 675:        or p_visibility is distinct from 'direct' then
 676:       raise exception 'CONVERSATION_CREATE_FORBIDDEN' using errcode = '42501';
 677:     end if;
 678: 
 679:     select pg_catalog.array_agg(locked order by (locked).id) into v_users
 680:     from (
 681:       select u as locked
 682:       from public.users u
 683:       where u.id = any (p_participants)
 684:       order by u.id
 685:       for share
 686:     ) as l;
 687:     if coalesce(pg_catalog.cardinality(v_users), 0) <> 2 then
 688:       raise exception 'USER_NOT_FOUND' using errcode = 'P0002';
 689:     end if;
 690:     if (v_users[1]).company_id is not null
 691:        and (v_users[2]).company_id is not null
 692:        and (v_users[1]).company_id <> (v_users[2]).company_id then
 693:       raise exception 'CONVERSATION_CREATE_FORBIDDEN' using errcode = '42501',
 694:         detail = 'COMPANY_MISMATCH';
 695:     end if;
 696:     return;
 697:   end if;
 698: 
 699:   if p_type = 'room' then
 700:     if pg_catalog.cardinality(p_participants) <> 1 or p_room_id is null then
 701:       raise exception 'CONVERSATION_CREATE_FORBIDDEN' using errcode = '42501';
 702:     end if;
 703:     perform private.authorize_room_membership(array[v_caller], p_room_id);
 704: 
 705:     select s.* into v_space from public.spaces s where s.id = p_room_id;
 706:     v_derived := case
 707:       when (v_space.access_control -> 'isPublic') = 'false'::jsonb then 'private'
 708:       else 'public'
 709:     end;
 710:     if p_visibility is distinct from v_derived then
 711:       raise exception 'CONVERSATION_CREATE_FORBIDDEN' using errcode = '42501',
 712:         detail = 'VISIBILITY_MISMATCH';
 713:     end if;
 714:     return;
 715:   end if;
 716: 
 717:   raise exception 'CONVERSATION_CREATE_FORBIDDEN' using errcode = '42501';
 718: end;
 719: $$;
