 752: -- ---------------------------------------------------------------------------
 753: -- 5. Participants sync: creation, and authorized additions only.
 754: -- ---------------------------------------------------------------------------
 755: create or replace function public.sync_conversation_members()
 756: returns trigger
 757: language plpgsql
 758: security definer
 759: set search_path = ''
 760: as $$
 761: declare
 762:   v_added uuid[];
 763: begin
 764:   if tg_op = 'INSERT' then
 765:     -- The memberships of a new conversation (client inserts were authorized
 766:     -- by conversations_guard_client_insert; service-role/admin inserts are
 767:     -- server code).
 768:     insert into public.conversation_members (conversation_id, user_id, last_read_at)
 769:     select new.id, u.id, pg_catalog.now()
 770:     from public.users u
 771:     where u.id = any (coalesce(new.participants, '{}'::uuid[]))
 772:     on conflict (conversation_id, user_id) do nothing;
 773:     return new;
 774:   end if;
 775: 
 776:   -- UPDATE OF participants: only ids newly added get a membership; an id
 777:   -- already in the old array (e.g. a removed member) is never re-created.
 778:   select coalesce(pg_catalog.array_agg(distinct u.id order by u.id), '{}'::uuid[])
 779:   into v_added
 780:   from public.users u
 781:   where u.id = any (coalesce(new.participants, '{}'::uuid[]))
 782:     and array_position(coalesce(old.participants, '{}'::uuid[]), u.id) is null;
 783: 
 784:   if pg_catalog.cardinality(v_added) = 0 then
 785:     return new;
 786:   end if;
 787: 
 788:   if new.type <> 'room'::public.conversation_type or new.room_id is null then
 789:     raise exception 'MEMBERSHIP_GRANT_FORBIDDEN' using errcode = '42501';
 790:   end if;
 791:   if exists (
 792:     select 1
 793:     from private.conversation_member_revocations r
 794:     where r.conversation_id = new.id
 795:       and r.user_id = any (v_added)
 796:   ) then
 797:     raise exception 'MEMBERSHIP_REVOKED' using errcode = '42501';
 798:   end if;
 799: 
 800:   perform private.authorize_room_membership(v_added, new.room_id);
 801: 
 802:   insert into public.conversation_members (conversation_id, user_id, last_read_at)
 803:   select new.id, a.user_id, pg_catalog.now()
 804:   from pg_catalog.unnest(v_added) as a(user_id)
 805:   on conflict (conversation_id, user_id) do nothing;
 806:   return new;
 807: end;
 808: $$;
 809: 
 810: -- A trigger function cannot be called directly; the baseline grants are still
 811: -- removed from the API roles (RLS review). service_role keeps its grant.
 812: revoke execute on function public.sync_conversation_members() from public, anon, authenticated;
