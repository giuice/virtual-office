 495: // The same contract read from the catalog and evaluated by Postgres exactly as
 496: // the Realtime server evaluates it (role + request.jwt.claims + realtime.topic
 497: // set per transaction), inside transactions that are rolled back.
 498: describe('conversation typing topic: realtime.messages policy contract', () => {
 499:   let world: MessagingDbWorld;
 500: 
 501:   beforeAll(async () => {
 502:     world = await createMessagingWorld({ historyMessageCount: 0, withGroupThirdMember: true });
 503:   });
 504: 
 505:   afterAll(async () => {
 506:     if (world) await world.cleanup();
 507:   });
 508: 
 509:   /**
 510:    * Runs `body` as `role` with the given JWT subject, auth session and realtime
 511:    * topic, then rolls back.
 512:    */
 513:   const asRealtime = async (
 514:     role: 'authenticated' | 'anon',
 515:     sub: string | null,
 516:     topic: string,
 517:     body: () => Promise<void>,
 518:     sessionId: string = randomUUID(),
 519:   ): Promise<void> => {
 520:     await world.query('begin');
 521:     try {
 522:       await world.query(`select pg_catalog.set_config('request.jwt.claims', $1, true)`, [
 523:         JSON.stringify(sub ? { role, sub, session_id: sessionId } : { role }),
 524:       ]);
 525:       await world.query(`select pg_catalog.set_config('realtime.topic', $1, true)`, [topic]);
 526:       await world.query(`set local role ${role}`);
 527:       await body();
 528:     } finally {
 529:       await world.query('rollback');
 530:     }
 531:   };
 532: 
 533:   const expectDenied = async (sql: string, params: unknown[]): Promise<void> => {
 534:     await world.query('savepoint denied');
 535:     await expect(world.query(sql, params)).rejects.toMatchObject({ code: '42501' });
 536:     await world.query('rollback to savepoint denied');
 537:   };
