  52: async function waitFor(predicate: () => boolean, timeoutMs: number): Promise<boolean> {
  53:   const deadline = Date.now() + timeoutMs;
  54:   while (!predicate() && Date.now() < deadline) {
  55:     await sleep(50);
  56:   }
  57:   return predicate();
  58: }
