  60: function anonClient(): SupabaseClient {
  61:   return createClient(MESSAGING_API_URL, MESSAGING_ANON_KEY, {
  62:     auth: { persistSession: false, autoRefreshToken: false },
  63:   });
  64: }
  65: 
  66: /** A second, independent signed-in session (own Realtime socket) of a user. */
  67: async function signedInClient(user: MessagingDbUser): Promise<SupabaseClient> {
  68:   const client = anonClient();
  69:   const { error } = await client.auth.signInWithPassword({
  70:     email: user.email,
  71:     password: MESSAGING_DB_PASSWORD,
  72:   });
  73:   if (error) throw new Error(`sign-in failed for a fixture user: ${error.message}`);
  74:   return client;
  75: }
