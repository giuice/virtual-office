 114: /** Realtime REST batch endpoint (what `channel.send` falls back to). */
 115: async function restBatchSend(
 116:   token: string | null,
 117:   topic: string,
 118:   payload: TypingSignal,
 119:   isPrivate: boolean,
 120: ): Promise<number> {
 121:   const response = await fetch(`${MESSAGING_API_URL}/realtime/v1/api/broadcast`, {
 122:     method: 'POST',
 123:     headers: {
 124:       apikey: MESSAGING_ANON_KEY,
 125:       Authorization: `Bearer ${token ?? MESSAGING_ANON_KEY}`,
 126:       'Content-Type': 'application/json',
 127:     },
 128:     body: JSON.stringify({ messages: [{ topic, event: 'typing', payload, private: isPrivate }] }),
 129:   });
 130:   await response.body?.cancel();
 131:   return response.status;
 132: }
 133: 
 134: /** Realtime REST per-topic endpoint (what `channel.httpSend` uses). */
 135: async function restTopicSend(
 136:   token: string | null,
 137:   topic: string,
 138:   payload: TypingSignal,
 139:   isPrivate: boolean,
 140: ): Promise<number> {
 141:   const url = new URL(
 142:     `${MESSAGING_API_URL}/realtime/v1/api/broadcast/${encodeURIComponent(topic)}/events/typing`,
 143:   );
 144:   if (isPrivate) url.searchParams.set('private', 'true');
 145:   const response = await fetch(url, {
 146:     method: 'POST',
 147:     headers: {
 148:       apikey: MESSAGING_ANON_KEY,
 149:       Authorization: `Bearer ${token ?? MESSAGING_ANON_KEY}`,
 150:       'Content-Type': 'application/json',
 151:     },
 152:     body: JSON.stringify(payload),
 153:   });
 154:   await response.body?.cancel();
 155:   return response.status;
 156: }
