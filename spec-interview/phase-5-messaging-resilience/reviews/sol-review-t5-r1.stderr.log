  77: async function accessToken(client: SupabaseClient): Promise<string | null> {
  78:   const { data } = await client.auth.getSession();
  79:   return data.session?.access_token ?? null;
  80: }
  81: 
  82: async function joinTopic(client: SupabaseClient, topic: string, isPrivate: boolean): Promise<TopicJoin> {
  83:   const received: TypingSignal[] = [];
  84:   const lifecycle: JoinStatus[] = [];
  85:   const channel = client.channel(topic, {
  86:     config: { private: isPrivate, broadcast: { self: false, ack: true } },
  87:   });
  88:   channel.on('broadcast', { event: 'typing' }, ({ payload }) => {
  89:     received.push(payload as TypingSignal);
  90:   });
  91:   const outcome = await new Promise<{ status: JoinStatus; error: string | null }>((resolve) => {
  92:     const timer = setTimeout(() => resolve({ status: 'TIMED_OUT', error: 'join not answered' }), 
JOIN_TIMEOUT_MS);
  93:     channel.subscribe((status, err) => {
  94:       lifecycle.push(status as JoinStatus);
  95:       clearTimeout(timer);
  96:       resolve({ status: status as JoinStatus, error: err?.message ?? null });
  97:     });
  98:   });
  99:   if (outcome.status !== 'SUBSCRIBED') {
 100:     // A refused join would otherwise keep rejoining in the background.
 101:     await client.removeChannel(channel);
 102:   }
 103:   return { client, channel, received, lifecycle, ...outcome };
 104: }
