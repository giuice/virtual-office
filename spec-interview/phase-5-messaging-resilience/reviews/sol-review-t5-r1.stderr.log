 424:   it('refuses a removed member a new join and REST sends; a token refresh ends its stale subscription', async () 
=> {
 425:     const { primary, secondary, groupConversationId } = world;
 426:     const removed = world.groupThirdMember as MessagingDbUser;
 427:     const topic = conversationTypingTopic(groupConversationId);
 428:     try {
 429:       const sender = await joinTopic(primary.client, topic, true);
 430:       const receiver = await joinTopic(secondary.client, topic, true);
 431:       const stale = await joinTopic(removed.client, topic, true);
 432:       expect([sender.status, receiver.status, stale.status]).toEqual(['SUBSCRIBED', 'SUBSCRIBED', 'SUBSCRIBED']);
 433: 
 434:       const tag = randomUUID();
 435:       expect(await wsSend(sender, signal(primary.appUserId, `before-${tag}`))).toBe('ok');
 436:       expect(await waitFor(() => markers(stale).includes(`before-${tag}`), DELIVERY_TIMEOUT_MS)).toBe(true);
 437:       // The removed member had sent before removal (write authorization cached).
 438:       expect(await wsSend(stale, signal(removed.appUserId, `stale-before-${tag}`))).toBe('ok');
 439:       expect(await waitFor(() => markers(receiver).includes(`stale-before-${tag}`), 
DELIVERY_TIMEOUT_MS)).toBe(true);
 440: 
 441:       // Administrative removal (service role) = revocation (T28).
 442:       await world.query(
 443:         'delete from public.conversation_members where conversation_id = $1 and user_id = $2',
 444:         [groupConversationId, removed.appUserId],
 445:       );
 446: 
 447:       // A fresh join (new session of the removed user) is refused.
 448:       const rejoin = await joinTopic(track(await signedInClient(removed)), topic, true);
 449:       expect(rejoin.status).toBe('CHANNEL_ERROR');
 450:       expect(rejoin.error).toMatch(/^Unauthorized: You do not have permissions to read from this Channel topic/);
 451:       // REST sends from the removed user are refused (per-topic) or dropped (batch).
 452:       const removedToken = await accessToken(removed.client);
 453:       expect(
 454:         await restTopicSend(removedToken, topic, signal(removed.appUserId, `removed-http-${tag}`), true),
 455:       ).toBe(403);
 456:       await restBatchSend(removedToken, topic, signal(removed.appUserId, `removed-rest-${tag}`), true);
 457:       expect(
 458:         await restBatchSend(await accessToken(primary.client), topic, signal(primary.appUserId, 
`rest-control-${tag}`), true),
 459:       ).toBe(202);
 460:       expect(await waitFor(() => markers(receiver).includes(`rest-control-${tag}`), 
DELIVERY_TIMEOUT_MS)).toBe(true);
 461: 
 462:       // Until re-authorized, the stale join keeps its cached authorization
 463:       // (accepted residual, SPEC D3/D6; the application leaves on its removal
 464:       // signal — T15). Pushing a refreshed access token (what supabase-js does
 465:       // on TOKEN_REFRESHED) makes the server re-check the policies and close
 466:       // the channel, which bounds a tampered client by the token lifetime.
 467:       expect(stale.lifecycle).toEqual(['SUBSCRIBED']);
 468:       const { error: refreshError } = await removed.client.auth.refreshSession();
 469:       expect(refreshError).toBeNull();
 470:       await removed.client.realtime.setAuth((await accessToken(removed.client)) ?? undefined);
 471:       // The only lifecycle change is the one caused by the re-authorization.
 472:       expect(await waitFor(() => stale.lifecycle.length > 1, DELIVERY_TIMEOUT_MS)).toBe(true);
 473:       expect(stale.lifecycle.slice(1).every((status) => status !== 'SUBSCRIBED')).toBe(true);
 474:       // After the close this falls back to REST with the removed user's token.
 475:       await wsSend(stale, signal(removed.appUserId, `stale-after-${tag}`));
 476: 
 477:       expect(await wsSend(sender, signal(primary.appUserId, `after-${tag}`))).toBe('ok');
 478:       expect(await waitFor(() => markers(receiver).includes(`after-${tag}`), DELIVERY_TIMEOUT_MS)).toBe(true);
 479:       await sleep(GRACE_MS);
 480: 
 481:       // Before the re-authorization the stale join still heard the member's
 482:       // REST control (accepted residual, D3/D6); after it, nothing.
 483:       expect(markers(stale)).toEqual([`before-${tag}`, `rest-control-${tag}`]);
 484:       // Nothing the removed member sent after its removal (REST, or the stale
 485:       // socket after re-authorization) reached a member.
 486:       expect(markers(receiver).sort()).toEqual(
 487:         [`after-${tag}`, `before-${tag}`, `rest-control-${tag}`, `stale-before-${tag}`].sort(),
 488:       );
 489:     } finally {
 490:       await leaveAll();
 491:     }
 492:   });
