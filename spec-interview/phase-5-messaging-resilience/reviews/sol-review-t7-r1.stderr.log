 376: test.describe('Phase 5 T7 — one bubble per message, matched by clientMessageId (AC-050)', () => {
 377:   test('one tab sends a plain message and a reply with identical text; Realtime precedes each HTTP response', 
async ({
 378:     phase5World,
 379:     openDevice,
 380:     realtimeFaults,
 381:   }, testInfo) => {
 382:     const tabs = await openSenderTabs(phase5World, openDevice, realtimeFaults.attach);
 383:     const { harness, tab1, tab2, conn1, conn2, parentId, parentText } = tabs;
 384:     const text = `t7 same text ${randomUUID()}`;
 385:     // Each request is held briefly before the server so the pending bubble is
 386:     // observed deterministically, then held again after the server answered.
 387:     const hold = await holdCreates(tab1, { holdRequest: true });
 388:     for (const tab of [tab1, tab2]) await installBubbleSampler(tab, text, parentText);
 389: 
 390:     const evidence: Array<Record<string, unknown>> = [];
 391:     const sendAndHold = async (kind: BubbleClass) => {
 392:       if (kind === 'reply') await tab1.locator(`[data-testid="reply-button-${parentId}"]`).click();
 393:       const input = composerInput(tab1);
 394:       await input.fill(text);
 395:       await input.press('Enter');
 396:       const entry = await hold.next();
 397:       expect(entry.request.replyToId ?? null).toBe(kind === 'reply' ? parentId : null);
 398:       // Pending in the sending tab while the request is in flight.
 399:       await expect(tab1.locator('[data-testid="messages-feed"] [data-testid^="message-temp-"]')).toHaveCount(1);
 400:       entry.letRequestThrough();
 401:       await entry.fetched;
 402:       const id = storedId(entry);
 403:       expectKeyCarried(entry);
 404:       const at1 = await waitForInsert(harness, conn1, id);
 405:       const at2 = await waitForInsert(harness, conn2, id);
 406:       await waitForStoredBubble(tab1, id, 'sending tab shows the stored message before its HTTP response');
 407:       await waitForStoredBubble(tab2, id, 'other tab shows the stored message');
 408:       await expect(tab1.locator('[data-testid="messages-feed"] [data-testid^="message-temp-"]')).toHaveCount(0);
 409:       await tab1.waitForTimeout(SETTLE_SAMPLING_MS);
 410:       entry.release();
 411:       await entry.fulfilled;
 412:       await expect(input, 'the send resolved with the released response').toHaveValue('');
 413:       expect(entry.releasedAt as number).toBeGreaterThan(Math.max(at1, at2));
 414:       evidence.push({ kind, id, insertTab1: at1, insertTab2: at2, released: entry.releasedAt });
 415:       return id;
 416:     };
 417: 
 418:     const plainId = await sendAndHold('plain');
 419:     const replyId = await sendAndHold('reply');
 420:     await tab1.waitForTimeout(SETTLE_SAMPLING_MS);
 421: 
 422:     for (const [label, tab] of [['tab 1', tab1], ['tab 2', tab2]] as const) {
 423:       expectOneBubbleThroughout(label, await readSampler(tab), { plain: plainId, reply: replyId });
 424:       await expect(tab.locator(`[data-testid="reply-context-${replyId}"]`)).toContainText(parentText);
 425:     }
 426:     testInfo.annotations.push({ type: 't7-order', description: JSON.stringify(evidence) });
 427:   });
