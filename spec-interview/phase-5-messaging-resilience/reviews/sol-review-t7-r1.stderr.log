  24:  * with the frame times, so the order is proven, not assumed.
  25:  *
  26:  * "Throughout" is measured in the page: a MutationObserver re-counts the
  27:  * bubbles of each tracked message class (text + plain/reply) after every DOM
  28:  * change of each tab and keeps the maximum, whether a seen bubble ever
  29:  * disappeared, and whether a reply bubble ever lacked its parent quote.
  30:  *
  31:  *   1. one tab sends the plain message, then the reply (literal AC-050);
  32:  *   2. both messages are pending at once, one in each tab (the plain one's
  33:  *      request held before the server; the reply's INSERT reaches the plain
  34:  *      one's tab first): they must never be taken for each other;
  35:  *   3. the stored message reaches both tabs through a feed fetch, not
  36:  *      Realtime (the messages stream is faulted during the send; its
  37:  *      recovery catch-up refetches the feed) before the HTTP response: the
  38:  *      feed's own copy of the key must hide the pending one.
  39:  */
  40: 
  41: const STEP_TIMEOUT_MS = 20_000;
  42: /** Bubbles keep being sampled for a while after each step settles. */
  43: const SETTLE_SAMPLING_MS = 1_500;
  44: /** Local Realtime publishes a commit well within this (typically < 0.5 s). */
  45: const PUBLISH_SETTLE_MS = 3_000;
  46: 
  47: type BubbleClass = 'plain' | 'reply';
  48: 
  49: interface ClassSample {
  50:   max: number;
  51:   current: number;
  52:   seen: boolean;
  53:   lost: number;
  54:   quoteMissing: number;
  55:   ids: string[];
  56: }
  57: 
  58: interface SamplerState {
  59:   evaluations: number;
  60:   classes: Record<BubbleClass, ClassSample>;
  61:   history: Array<{ t: number; plain: string[]; reply: string[] }>;
  62: }
  63: 
  64: interface CreateResponseBody {
  65:   clientMessageId?: string;
  66:   message?: { id?: string; clientMessageId?: string; replyToId?: string };
  67: }
  68: 
  69: interface HeldCreate {
  70:   request: Record<string, unknown>;
  71:   capturedAt: number;
  72:   /** Set when the real server answered (the message is stored). */
  73:   fetchedAt?: number;
  74:   status?: number;
  75:   body?: CreateResponseBody;
  76:   /** When the held real response was handed to the page. */
  77:   releasedAt?: number;
  78:   letRequestThrough(): void;
  79:   release(): void;
  80:   fetched: Promise<void>;
  81:   fulfilled: Promise<void>;
  82: }
  83: 
  84: interface CreateHold {
  85:   next(): Promise<HeldCreate>;
  86:   all(): HeldCreate[];
  87: }
  88: 
  89: function deferred(): { promise: Promise<void>; resolve: () => void } {
  90:   let resolve!: () => void;
  91:   const promise = new Promise<void>((done) => {
  92:     resolve = done;
  93:   });
  94:   return { promise, resolve };
  95: }
  96: 
  97: /**
  98:  * Holds every create of this tab: optionally before it reaches the server
  99:  * (`holdRequest`), and always after the real server answered, until
 100:  * `release()` hands the real response to the page. Nothing is mocked.
 101:  */
 102: async function holdCreates(page: Page, { holdRequest = false }: { holdRequest?: boolean } = {}): 
Promise<CreateHold> {
 103:   const held: HeldCreate[] = [];
 104:   const waiters: Array<(entry: HeldCreate) => void> = [];
 105:   let handedOut = 0;
 106:   await page.route('**/api/messages/create', async (route: Route) => {
 107:     const requestGate = deferred();
 108:     const releaseGate = deferred();
 109:     const fetched = deferred();
 110:     const fulfilled = deferred();
 111:     const entry: HeldCreate = {
 112:       request: (route.request().postDataJSON() ?? {}) as Record<string, unknown>,
 113:       capturedAt: Date.now(),
 114:       letRequestThrough: requestGate.resolve,
 115:       release: releaseGate.resolve,
 116:       fetched: fetched.promise,
 117:       fulfilled: fulfilled.promise,
 118:     };
 119:     held.push(entry);
 120:     waiters.shift()?.(entry);
 121:     if (!holdRequest) requestGate.resolve();
 122:     await requestGate.promise;
 123:     const response = await route.fetch();
 124:     entry.status = response.status();
 125:     entry.body = (await response.json().catch(() => ({}))) as CreateResponseBody;
 126:     entry.fetchedAt = Date.now();
 127:     fetched.resolve();
 128:     await releaseGate.promise;
 129:     entry.releasedAt = Date.now();
 130:     await route.fulfill({ response });
 131:     fulfilled.resolve();
 132:   });
 133:   return {
 134:     next: () => {
 135:       const index = handedOut;
 136:       handedOut += 1;
 137:       if (held[index]) return Promise.resolve(held[index]);
 138:       return new Promise<HeldCreate>((resolve) => waiters.push(resolve));
 139:     },
 140:     all: () => [...held],
 141:   };
 142: }
 143: 
 144: async function openConversation(page: Page, conversationId: string): Promise<void> {
 145:   await page.goto('/floor-plan');
 146:   await page.waitForLoadState('networkidle');
 147:   await openDrawer(page);
 148:   await waitForRealtimeReady(page);
 149:   await selectConversation(page, { id: conversationId });
 150: }
