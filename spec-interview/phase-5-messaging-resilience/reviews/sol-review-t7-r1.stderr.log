 315: interface SenderTabs {
 316:   a: Phase5Device;
 317:   harness: RealtimeFaultController;
 318:   tab1: Page;
 319:   tab2: Page;
 320:   conn1: number;
 321:   conn2: number;
 322:   parentId: string;
 323:   parentText: string;
 324: }
 325: 
 326: /**
 327:  * A's two tabs (same device and session) on the DM, with a parent message
 328:  * whose thread (it already has one reply) is expanded in both tabs, so a
 329:  * reply renders with its parent quote.
 330:  */
 331: async function openSenderTabs(
 332:   phase5World: { conversations: { directId: string } },
 333:   openDevice: (key: 'A') => Promise<Phase5Device>,
 334:   attach: (device: Phase5Device, options?: { reload?: boolean }) => Promise<RealtimeFaultController>,
 335: ): Promise<SenderTabs> {
 336:   const { directId } = phase5World.conversations;
 337:   const a = await openDevice('A');
 338:   const harness = await attach(a, { reload: false });
 339: 
 340:   const parentText = `t7 parent ${randomUUID()}`;
 341:   const parentId = await createAs(a.page, { conversationId: directId, content: parentText });
 342:   await createAs(a.page, { conversationId: directId, content: `t7 earlier reply ${randomUUID()}`, replyToId: 
parentId });
 343: 
 344:   const tab1 = a.page;
 345:   await openConversation(tab1, directId);
 346:   const conn1 = newOpenConnection(harness, []);
 347:   await waitForMessagesStream(harness, conn1);
 348: 
 349:   const tab2 = await a.newTab();
 350:   harness.watchPage(tab2, `${a.label} tab 2`);
 351:   await openConversation(tab2, directId);
 352:   const conn2 = newOpenConnection(harness, [conn1]);
 353:   await waitForMessagesStream(harness, conn2);
 354: 
 355:   for (const tab of [tab1, tab2]) {
 356:     await tab.locator(`[data-testid="reply-count-${parentId}"]`).click();
 357:     await expect(tab.locator(`[data-testid="thread-panel-${parentId}"]`)).toBeVisible();
 358:   }
 359:   return { a, harness, tab1, tab2, conn1, conn2, parentId, parentText };
 360: }
 361: 
 362: function storedId(entry: HeldCreate): string {
 363:   const id = entry.body?.message?.id;
 364:   expect(entry.status, JSON.stringify(entry.body)).toBe(201);
 365:   expect(id, 'create response carries the stored id').toBeTruthy();
 366:   return id as string;
 367: }
 368: 
 369: function expectKeyCarried(entry: HeldCreate): void {
 370:   const sent = entry.request.clientMessageId;
 371:   expect(typeof sent, 'the create is keyed').toBe('string');
 372:   expect(entry.body?.clientMessageId).toBe(String(sent).toLowerCase());
 373:   expect(entry.body?.message?.clientMessageId).toBe(String(sent).toLowerCase());
 374: }
