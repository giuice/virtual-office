 311:       // Shown after the stored feed until its stored message arrives (FR-034).
 312:       updatePendingMessages(queryClient, pendingKey, clientMessageId, optimisticMessage);
 313: 
 314:       if (instrumentationEnabled) {
 315:         debugLogger.messaging.event('useMessages.sendMessage', 'optimistic:applied', {
 316:           traceId,
 317:           optimisticId: optimisticMessage.id,
 318:           conversationId: activeConversationId,
 319:         });
 320:       }
