 337:         if (instrumentationEnabled) {
 338:           const duration = start ? getTimestamp() - start : 0;
 339:           if (start) {
 340:             debugLogger.messaging.metric('useMessages.sendMessage', 'roundtrip', duration, {
 341:               traceId,
 342:               conversationId: activeConversationId,
 343:               messageId: savedMessage.id,
