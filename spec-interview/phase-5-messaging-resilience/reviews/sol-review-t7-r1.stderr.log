 204:   const loadHistoryUntilMessage = useCallback(
 205:     async (messageId: string, signal: AbortSignal): Promise<MessageHistorySearchResult> => {
 206:       if (!activeConversationId) return 'unavailable';
 207:       const queryKey = ['messages', activeConversationId];
 208: 
 209:       for (let round = 0; round < MAX_HISTORY_SEARCH_ROUNDS; round += 1) {
 210:         if (signal.aborted) return 'cancelled';
 211:         const query = queryClient.getQueryCache().find({ queryKey, exact: true });
 212:         if (!query) return 'unavailable';
 213:         const data = query.state.data as MessagesInfiniteData | undefined;
 214:         if (pagesContainMessage(data, messageId)) return 'found';
 215: 
 216:         const isFetching = query.state.fetchStatus === 'fetching';
 217:         if (!isFetching && !data?.pages.at(-1)?.nextCursorBefore) {
 218:           // History exhausted (or never loaded) without the message.
 219:           return 'unavailable';
 220:         }
 221: 
 222:         const failuresBefore = query.state.errorUpdateCount;
 223:         // Without cancelRefetch a fetch already in flight is awaited instead
 224:         // of being cancelled; the next round then loads the next older page.
 225:         await fetchNextPage({ cancelRefetch: false });
 226:         if (query.state.errorUpdateCount > failuresBefore) {
 227:           if (signal.aborted) return 'cancelled';
 228:           return pagesContainMessage(
 229:             queryClient.getQueryData<MessagesInfiniteData>(queryKey),
 230:             messageId
 231:           )
 232:             ? 'found'
 233:             : 'unavailable';
 234:         }
 235:       }
 236: 
 237:       if (signal.aborted) return 'cancelled';
 238:       return pagesContainMessage(queryClient.getQueryData<MessagesInfiniteData>(queryKey), messageId)
