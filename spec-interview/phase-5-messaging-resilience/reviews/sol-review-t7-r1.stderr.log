 266:       const instrumentationEnabled = debugLogger.messaging.enabled();
 267:       const traceId = instrumentationEnabled ? createTraceId('hook-send') : '';
 268: 
 269:       if (!currentUserProfile?.id || !activeConversationId || (!trimmedContent && !attachments)) {
 270:         if (instrumentationEnabled) {
 271:           debugLogger.messaging.trace('useMessages.sendMessage', 'skip:missing-context', {
 272:             traceId,
 273:             hasProfile: Boolean(currentUserProfile?.id),
 274:             conversationId: activeConversationId,
 275:             hasContent: Boolean(trimmedContent),
 276:           });
 277:         }
 278:         return;
 279:       }
 280: 
 281:       const start = instrumentationEnabled ? getTimestamp() : 0;
 282:       if (instrumentationEnabled) {
 283:         debugLogger.messaging.event('useMessages.sendMessage', 'optimistic:start', {
 284:           traceId,
 285:           conversationId: activeConversationId,
 286:           contentLength: trimmedContent.length,
 287:           type: messageType,
 288:           attachments: attachments?.length || 0,
 289:         });
 290:       }
 291: 
 292:       const clientMessageId = normalizeClientMessageId(options?.clientMessageId) ?? uuidv4();
 293:       const conversationId = activeConversationId;
 294:       const pendingKey = pendingMessagesQueryKey(currentUserProfile.id, conversationId);
 295:       const now = new Date();
 296:       const optimisticMessage: Message = {
 297:         id: `${PENDING_MESSAGE_ID_PREFIX}${clientMessageId}`,
 298:         conversationId: activeConversationId,
 299:         senderId: currentUserProfile.id, // DB ID for UI representation
 300:         content: trimmedContent,
 301:         timestamp: now,
 302:         status: MessageStatus.SENDING,
 303:         type: messageType,
 304:         replyToId: options?.replyToId,
 305:         attachments,
 306:         reactions: [],
 307:         isEdited: false,
 308:         clientMessageId,
 309:       };
