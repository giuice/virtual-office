 498:   test('a stored message reaching both tabs by a feed fetch before the HTTP response is matched by its key', 
async ({
 499:     phase5World,
 500:     openDevice,
 501:     realtimeFaults,
 502:   }, testInfo) => {
 503:     const tabs = await openSenderTabs(phase5World, openDevice, realtimeFaults.attach);
 504:     const { harness, tab1, tab2, conn1, conn2, parentText } = tabs;
 505:     const { directId } = phase5World.conversations;
 506:     const text = `t7 fetched ${randomUUID()}`;
 507:     const hold = await holdCreates(tab1);
 508:     for (const tab of [tab1, tab2]) await installBubbleSampler(tab, text, parentText);
 509:     const feedFetches = new Map<Page, number[]>([[tab1, []], [tab2, []]]);
 510:     for (const tab of [tab1, tab2]) {
 511:       tab.on('request', (request: Request) => {
 512:         const url = new URL(request.url());
 513:         if (url.pathname === '/api/messages/get' && url.searchParams.get('conversationId') === directId) {
 514:           feedFetches.get(tab)?.push(Date.now());
 515:         }
 516:       });
 517:     }
 518: 
 519:     // Both tabs' messages stream goes dark: the INSERT will not be delivered.
 520:     const fault = await harness.fail('messages', 'error');
 521:     expect(fault.kicked).toBeGreaterThan(0);
 522: 
 523:     const input = composerInput(tab1);
 524:     await input.fill(text);
 525:     await input.press('Enter');
 526:     const entry = await hold.next();
 527:     await entry.fetched;
 528:     const id = storedId(entry);
 529:     expectKeyCarried(entry);
 530:     await expect(tab1.locator('[data-testid="messages-feed"] [data-testid^="message-temp-"]')).toHaveCount(1);
 531:     // Whatever the server publishes for this commit while the stream is dark
 532:     // (an INSERT per server-side channel joined at that moment, or none if
