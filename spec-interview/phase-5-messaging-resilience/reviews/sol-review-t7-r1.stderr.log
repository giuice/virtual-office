 164: /** The single open routed socket that appeared since `knownIds`. */
 165: function newOpenConnection(harness: RealtimeFaultController, knownIds: number[]): number {
 166:   const open = harness
 167:     .connections()
 168:     .filter((connection) => connection.closedSeq === null && !knownIds.includes(connection.id));
 169:   expect(open, 'exactly one new Realtime socket').toHaveLength(1);
 170:   return open[0].id;
 171: }
 172: 
 173: async function waitForMessagesStream(harness: RealtimeFaultController, connection: number, since = 0): 
Promise<void> {
 174:   await expect
 175:     .poll(
 176:       () =>
 177:         harness
 178:           .frames({ stream: 'messages', direction: 'in', action: 'pass', events: ['system'], since })
 179:           .some(
 180:             (frame) =>
 181:               frame.connection === connection &&
 182:               frame.detail.extension === 'postgres_changes' &&
 183:               frame.detail.status === 'ok',
 184:           ),
 185:       { timeout: STEP_TIMEOUT_MS, message: `messages changes stream confirmed on socket ${connection}` },
 186:     )
 187:     .toBe(true);
 188: }
 189: 
 190: /** Time the INSERT of `messageId` was passed to (or, `dropped`, withheld from) the page on `connection`. */
 191: function insertPassedAt(
 192:   harness: RealtimeFaultController,
 193:   connection: number,
 194:   messageId: string,
 195:   action: 'pass' | 'drop' = 'pass',
 196: ): number | undefined {
 197:   return harness
 198:     .frames({ stream: 'messages', direction: 'in', action, events: ['postgres_changes'] })
 199:     .find(
 200:       (frame) =>
 201:         frame.connection === connection &&
 202:         frame.detail.table === 'messages' &&
 203:         frame.detail.type === 'INSERT' &&
 204:         frame.detail.recordId === messageId,
 205:     )?.at;
 206: }
 207: 
 208: async function waitForInsert(harness: RealtimeFaultController, connection: number, messageId: string): 
Promise<number> {
 209:   await expect
 210:     .poll(() => insertPassedAt(harness, connection, messageId) !== undefined, {
 211:       timeout: STEP_TIMEOUT_MS,
 212:       message: `INSERT ${messageId} reached socket ${connection}`,
 213:     })
 214:     .toBe(true);
 215:   return insertPassedAt(harness, connection, messageId) as number;
 216: }
 217: 
 218: /** The stored bubble (real id, not the pending temp- copy) is in the tab's feed. */
 219: async function waitForStoredBubble(page: Page, messageId: string, what: string): Promise<void> {
 220:   await expect(
 221:     page.locator(`[data-testid="messages-feed"] [data-testid="message-${messageId}"]`),
 222:     what,
 223:   ).toBeVisible({ timeout: STEP_TIMEOUT_MS });
 224: }
 225: 
 226: /** Counts the bubbles of `text` (plain / reply) after every DOM change of the tab. */
 227: async function installBubbleSampler(page: Page, text: string, parentText: string): Promise<void> {
 228:   await page.evaluate(
 229:     ({ text: trackedText, parentText: quotedParent }) => {
 230:       const classes = ['plain', 'reply'] as const;
 231:       const state = {
 232:         evaluations: 0,
 233:         classes: Object.fromEntries(
 234:           classes.map((name) => [name, { max: 0, current: 0, seen: false, lost: 0, quoteMissing: 0, ids: [] as 
string[] }]),
 235:         ),
 236:         history: [] as Array<{ t: number; plain: string[]; reply: string[] }>,
 237:       };
 238:       let lastSignature = '';
 239:       const evaluate = () => {
 240:         state.evaluations += 1;
 241:         const ids: Record<string, string[]> = { plain: [], reply: [] };
 242:         const feed = document.querySelector('[data-testid="messages-feed"]');
 243:         const wrappers = feed ? Array.from(feed.querySelectorAll('[data-message-id]')) : [];
 244:         for (const wrapper of wrappers) {
 245:           const id = wrapper.getAttribute('data-message-id') ?? '';
 246:           const item = Array.from(wrapper.children).find(
 247:             (child) => child.getAttribute('data-testid') === `message-${id}`,
 248:           );
 249:           if (!item) continue;
 250:           const hasText = Array.from(item.querySelectorAll('p')).some(
 251:             (paragraph) => paragraph.textContent === trackedText,
 252:           );
 253:           if (!hasText) continue;
 254:           const quote = item.querySelector(`[data-testid="reply-context-${id}"]`);
 255:           const name = quote ? 'reply' : 'plain';
 256:           ids[name].push(id);
 257:           if (quote && !(quote.textContent ?? '').includes(quotedParent)) {
 258:             state.classes[name].quoteMissing += 1;
 259:           }
 260:         }
 261:         for (const name of classes) {
 262:           const sample = state.classes[name];
 263:           const count = ids[name].length;
 264:           if (sample.seen && count === 0) sample.lost += 1;
 265:           if (count > 0) sample.seen = true;
 266:           sample.current = count;
 267:           sample.max = Math.max(sample.max, count);
 268:           sample.ids = ids[name];
 269:         }
 270:         const signature = JSON.stringify(ids);
 271:         if (signature !== lastSignature && state.history.length < 200) {
 272:           lastSignature = signature;
 273:           state.history.push({ t: Math.round(performance.now()), plain: ids.plain, reply: ids.reply });
 274:         }
 275:       };
 276:       (window as unknown as { __t7Bubbles?: typeof state }).__t7Bubbles = state;
 277:       evaluate();
 278:       new MutationObserver(evaluate).observe(document.body, {
 279:         subtree: true,
 280:         childList: true,
 281:         characterData: true,
 282:         attributes: true,
 283:         attributeFilter: ['data-message-id', 'data-testid'],
 284:       });
 285:     },
 286:     { text, parentText },
 287:   );
 288: }
 289: 
 290: async function readSampler(page: Page): Promise<SamplerState> {
 291:   return page.evaluate(() => (window as unknown as { __t7Bubbles: SamplerState }).__t7Bubbles);
 292: }
 293: 
 294: function expectOneBubbleThroughout(
 295:   label: string,
 296:   state: SamplerState,
 297:   expected: Record<BubbleClass, string | null>,
 298: ): void {
 299:   const history = JSON.stringify(state.history);
 300:   expect(state.evaluations, `${label}: sampler ran`).toBeGreaterThan(1);
 301:   for (const name of ['plain', 'reply'] as const) {
 302:     const sample = state.classes[name];
 303:     const id = expected[name];
 304:     if (id === null) {
 305:       expect(sample.max, `${label}: no ${name} bubble expected; history ${history}`).toBe(0);
 306:       continue;
 307:     }
 308:     expect(sample.max, `${label}: never two ${name} bubbles; history ${history}`).toBeLessThanOrEqual(1);
 309:     expect(sample.lost, `${label}: the ${name} bubble never disappeared; history ${history}`).toBe(0);
 310:     expect(sample.quoteMissing, `${label}: the ${name} bubble always quoted its parent; history 
${history}`).toBe(0);
 311:     expect(sample.ids, `${label}: exactly one ${name} bubble, the stored one; history ${history}`).toEqual([id]);
 312:   }
 313: }
