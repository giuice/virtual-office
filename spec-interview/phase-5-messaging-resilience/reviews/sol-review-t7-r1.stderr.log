 322:       try {
 323:         // Server derives sender from session; do not send senderId
 324:         const savedMessage = await messagingApi.sendMessage(
 325:           {
 326:             conversationId: activeConversationId,
 327:             content: trimmedContent,
 328:             replyToId: options?.replyToId,
 329:             type: messageType,
 330:           },
 331:           {
 332:             clientMessageId,
 333:             attachmentIds: attachments?.map((attachment) => attachment.id),
 334:           }
 335:         );
