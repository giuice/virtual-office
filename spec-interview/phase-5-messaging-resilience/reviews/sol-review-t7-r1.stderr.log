 452:   const addReaction = useCallback(
 453:     async (messageId: string, emoji: string) => {
 454:       if (!currentUserProfile?.id || !activeConversationId) return;
 455: 
 456:       const instrumentationEnabled = debugLogger.messaging.enabled();
 457:       if (instrumentationEnabled) {
 458:         debugLogger.messaging.event('useMessages.addReaction', 'toggle-start', {
 459:           messageId,
 460:           emoji,
 461:           conversationId: activeConversationId,
 462:         });
 463:       }
 464: 
 465:       // Snapshot current state for rollback
 466:       const previousData = queryClient.getQueryData(['messages', activeConversationId]);
 467: 
 468:       try {
 469:         // Optimistic toggle
 470:         queryClient.setQueryData(
 471:           ['messages', activeConversationId],
 472:           (oldData:
 473:             | { pages: Array<{ messages: Message[]; hasMore: boolean; nextCursor?: string }>; pageParams: any[] }
 474:             | undefined) => {
 475:             if (!oldData || !oldData.pages) return oldData;
 476: 
 477:             const nextPages = toggleReactionInPages({
 478:               pages: oldData.pages,
 479:               messageId,
 480:               emoji,
 481:               userId: currentUserProfile.id,
 482:               timestamp: new Date(),
 483:               mode: 'toggle',
 484:             });
 485: 
 486:             if (nextPages === oldData.pages) {
 487:               return oldData;
 488:             }
 489: 
 490:             return { ...oldData, pages: nextPages };
 491:           }
 492:         );
 493: 
 494:         const result = await messagingApi.toggleReaction(messageId, emoji);
 495: 
 496:         if (instrumentationEnabled) {
 497:           debugLogger.messaging.event('useMessages.addReaction', 'toggle-success', {
 498:             messageId,
 499:             emoji,
 500:             action: result.action,
 501:           });
 502:         }
 503:       } catch (error) {
 504:         // Rollback optimistic update
 505:         queryClient.setQueryData(['messages', activeConversationId], previousData);
 506: 
 507:         debugLogger.messaging.error('useMessages.addReaction', 'toggle-error', {
 508:           messageId,
 509:           emoji,
 510:           error: error instanceof Error ? error.message : String(error),
 511:         });
 512: 
 513:         console.error('Error toggling reaction:', error);
 514:         toast.error('Failed to update reaction', {
 515:           description: error instanceof Error ? error.message : String(error),
 516:           action: {
 517:             label: 'Retry',
 518:             onClick: () => addReaction(messageId, emoji),
 519:           },
 520:         });
 521:         throw error;
 522:       }
 523:     },
 524:     [activeConversationId, currentUserProfile?.id, queryClient]
 525:   );
