 156: async function createAs(page: Page, data: Record<string, unknown>): Promise<string> {
 157:   const response = await page.request.post('/api/messages/create', { data });
 158:   const body = (await response.json().catch(() => null)) as { message?: { id?: string } } | null;
 159:   expect(response.status(), JSON.stringify(body)).toBe(201);
 160:   expect(body?.message?.id).toBeTruthy();
 161:   return body?.message?.id as string;
 162: }
