3: /**
4:  * Phase 5 T24 — the messaging app's browser-side storage, and how tests clear it.
5:  *
6:  * Every Phase 5 device is a fresh, non-persistent Playwright browser context:
7:  * its localStorage, sessionStorage, IndexedDB, Cache Storage and cookies start
8:  * empty and are discarded when the context closes, so nothing a test (or an
9:  * interrupted run) leaves in a browser reaches a later test. Within one test,
10:  * clearMessagingBrowserState() empties the messaging state of one origin
11:  * without closing the context (e.g. to simulate a cleared browser).
12:  *
13:  * Keep this list in sync with the app (T8+ add the outbox here):
14:  *   localStorage
15:  *   - `messaging_drawer_minimized`, `messaging_drawer_active_view`,
16:  *     `messaging_active_conversation_id` (MessagingContext DRAWER_STORAGE_KEYS)
17:  *   - every key starting with `vo:messaging:` — desktop-notification
18:  *     preference `vo:messaging:desktop-notifications:<userId>`, cross-tab claims
19:  *     `vo:messaging:notified-messages`; RESERVED prefix for new Phase 5
20:  *     localStorage keys (drawer restore T20, outbox coordination T8/T10).
21:  *   IndexedDB
22:  *   - every database whose name starts with `vo-messaging` — RESERVED prefix
23:  *     for Phase 5. The app must close its connection on `versionchange`, or
24:  *     deletion stays blocked while a tab holds it open.
25:  *   - `vo-messaging-outbox` (T8, `src/lib/messaging/outbox/outbox-db.ts`):
26:  *     stores `items` (outbox items, key [ownerId, clientMessageId]) and `meta`
27:  *     (per-owner creation-order counter); closes on `versionchange`.
28:  *   Web Locks (not storage; released when the tab closes)
29:  *   - `vo-messaging-outbox:<users.id>:<conversationId>` — T8 drain lock.
30:  *   sessionStorage
31:  *   - every key starting with `vo:messaging:` (reserved; none today).
32:  */
33: export const MESSAGING_LOCAL_STORAGE_KEYS = [
34:   'messaging_drawer_minimized',
35:   'messaging_drawer_active_view',
36:   'messaging_active_conversation_id',
37: ] as const;
38: export const MESSAGING_STORAGE_KEY_PREFIX = 'vo:messaging:';
39: export const MESSAGING_INDEXED_DB_PREFIX = 'vo-messaging';
40: /** The Phase 5 outbox database (T8); covered by MESSAGING_INDEXED_DB_PREFIX. */
41: export const MESSAGING_OUTBOX_DB_NAME = 'vo-messaging-outbox';
42: 
43: export interface MessagingBrowserStateSnapshot {
44:   localStorageKeys: string[];
45:   sessionStorageKeys: string[];
46:   indexedDbNames: string[];
47: }
48: 
49: interface StorageSpec {
50:   keys: readonly string[];
51:   keyPrefix: string;
52:   dbPrefix: string;
53: }
54: 
55: const SPEC: StorageSpec = {
56:   keys: MESSAGING_LOCAL_STORAGE_KEYS,
57:   keyPrefix: MESSAGING_STORAGE_KEY_PREFIX,
58:   dbPrefix: MESSAGING_INDEXED_DB_PREFIX,
59: };
60: 
61: /**
62:  * The messaging keys and databases present on the page's origin (localStorage
63:  * and IndexedDB are shared by the context's tabs; sessionStorage is this tab's).
64:  */
65: export async function readMessagingBrowserState(page: Page): Promise<MessagingBrowserStateSnapshot> {
66:   return page.evaluate(async (spec: StorageSpec) => {
67:     const isMessagingKey = (key: string) => spec.keys.includes(key) || key.startsWith(spec.keyPrefix);
68:     const keysOf = (storage: Storage) =>
69:       Array.from({ length: storage.length }, (_, index) => storage.key(index)).filter(
70:         (key): key is string => key !== null && isMessagingKey(key),
71:       );
72:     const databases = typeof indexedDB.databases === 'function' ? await indexedDB.databases() : [];
73:     return {
74:       localStorageKeys: keysOf(window.localStorage).sort(),
75:       sessionStorageKeys: keysOf(window.sessionStorage)
76:         .filter((key) => key.startsWith(spec.keyPrefix))
77:         .sort(),
78:       indexedDbNames: databases
79:         .map((database) => database.name ?? '')
80:         .filter((name) => name.startsWith(spec.dbPrefix))
81:         .sort(),
82:     };
83:   }, SPEC);
84: }
85: 
86: /** sessionStorage is per tab: the other open tabs of `page`'s context on the same origin. */
87: function sameOriginTabs(page: Page): Page[] {
88:   const origin = new URL(page.url()).origin;
89:   return page
90:     .context()
91:     .pages()
92:     .filter((tab) => tab !== page && !tab.isClosed() && /^https?:/.test(tab.url()) && new URL(tab.url()).origin 
=== origin);
93: }
94: 
95: async function clearTabSessionStorage(tab: Page, prefix: string): Promise<string[]> {
96:   return tab.evaluate((keyPrefix) => {
97:     const keys = Array.from({ length: window.sessionStorage.length }, (_, index) => 
window.sessionStorage.key(index)).filter(
98:       (key): key is string => key !== null && key.startsWith(keyPrefix),
99:     );
100:     for (const key of keys) window.sessionStorage.removeItem(key);
101:     return keys;
102:   }, prefix);
103: }
104: 
105: /**
106:  * Removes the messaging localStorage keys and deletes every messaging IndexedDB
107:  * database of the page's origin (shared by every tab of the context), and
108:  * removes the messaging sessionStorage keys of `page` and of every other open
109:  * same-origin tab of its context (sessionStorage is per tab). Fails when a
110:  * database deletion stays blocked by an open connection for `blockedTimeoutMs`,
111:  * and verifies that nothing is left in any of those tabs. Returns what it
112:  * removed (sessionStorage keys of all tabs, deduplicated).
113:  */
114: export async function clearMessagingBrowserState(
115:   page: Page,
116:   options: { blockedTimeoutMs?: number } = {},
117: ): Promise<MessagingBrowserStateSnapshot> {
118:   const before = await readMessagingBrowserState(page);
119:   const blockedTimeoutMs = options.blockedTimeoutMs ?? 5_000;
120:   const failures = await page.evaluate(
121:     async ({ removed, timeoutMs }) => {
122:       for (const key of removed.localStorageKeys) window.localStorage.removeItem(key);
123:       for (const key of removed.sessionStorageKeys) window.sessionStorage.removeItem(key);
124:       const deleteDatabase = (name: string) =>
125:         new Promise<string | null>((resolve) => {
126:           const request = indexedDB.deleteDatabase(name);
127:           const timer = window.setTimeout(() => resolve(`${name}: still blocked after ${timeoutMs} ms`), 
timeoutMs);
128:           request.onsuccess = () => {
129:             window.clearTimeout(timer);
130:             resolve(null);
131:           };
132:           request.onerror = () => {
133:             window.clearTimeout(timer);
134:             resolve(`${name}: ${request.error?.message ?? 'delete failed'}`);
135:           };
136:         });
137:       const results = await Promise.all(removed.indexedDbNames.map(deleteDatabase));
138:       return results.filter((result): result is string => result !== null);
139:     },
140:     { removed: before, timeoutMs: blockedTimeoutMs },
141:   );
142:   if (failures.length > 0) {
143:     throw new Error(`Messaging IndexedDB cleanup failed: ${failures.join('; ')}`);
144:   }
145:   const otherTabs = sameOriginTabs(page);
146:   const otherSessionKeys: string[] = [];
147:   for (const tab of otherTabs) {
148:     otherSessionKeys.push(...(await clearTabSessionStorage(tab, MESSAGING_STORAGE_KEY_PREFIX)));
149:   }
150:   const left: string[] = [];
151:   for (const tab of [page, ...otherTabs]) {
152:     const after = await readMessagingBrowserState(tab);
153:     left.push(...after.localStorageKeys, ...after.sessionStorageKeys, ...after.indexedDbNames);
154:   }
155:   if (left.length > 0) {
156:     throw new Error(`Messaging browser state left after cleanup: ${[...new Set(left)].join(', ')}`);
157:   }
158:   return {
159:     ...before,
160:     sessionStorageKeys: [...new Set([...before.sessionStorageKeys, ...otherSessionKeys])].sort(),
161:   };
162: }
