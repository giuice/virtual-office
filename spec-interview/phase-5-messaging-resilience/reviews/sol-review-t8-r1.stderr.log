179: const composer = (page: Page) => page.getByTestId('composer');
180: const composerInput = (page: Page) => composer(page).locator('textarea').first();
181: 
182: async function sendFromComposer(page: Page, text: string): Promise<void> {
183:   await composerInput(page).fill(text);
184:   await composer(page).getByTestId('message-send-button').click();
185: }
