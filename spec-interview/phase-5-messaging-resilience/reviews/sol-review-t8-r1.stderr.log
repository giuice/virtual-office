319:     }
320:     // transient → waiting; unknown / superseded → unknown (it may be stored).
321:     const state = outcome.kind === 'transient' ? 'waiting' : 'unknown';
322:     await updateOutboxItem(this.ownerId, clientMessageId, (current) =>
323:       ownAttempt(current) ? { ...current, state, claimHolder: null, leaseExpiresAt: null, updatedAt: now } : 
undefined
324:     );
325:     await this.refreshView(conversationId);
326:     this.scheduleRetry(conversationId);
327:     return false;
328:   }
329: 
330:   private scheduleRetry(conversationId: string, delayMs?: number): void {
331:     if (this.disposed) return;
332:     const drain = this.drain(conversationId);
333:     if (drain.retryTimer) return;
334:     const delay = delayMs ?? drain.retryDelayMs;
335:     if (delayMs === undefined) drain.retryDelayMs = Math.min(drain.retryDelayMs * 2, RETRY_MAX_MS);
336:     drain.retryTimer = setTimeout(() => {
337:       drain.retryTimer = null;
338:       this.drainConversation(conversationId);
339:     }, delay);
340:   }
