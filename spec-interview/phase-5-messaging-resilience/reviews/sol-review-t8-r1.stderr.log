180: +
181: +/**
182: + * Phase 5 T8: calls `observer` with every batch of stored keyed messages
183: + * that resolvePendingMessages sees (a Realtime INSERT, the rendered feed after
184: + * a fetch), so the durable outbox confirms an item the first time its stored
185: + * key is observed from any source. Returns the unsubscribe function.
186: + */
187: +export function observeStoredMessages(queryClient: QueryClient, observer: StoredMessageObserver): () => void {
188: +  let observers = storedMessageObservers.get(queryClient);
189: +  if (!observers) {
190: +    observers = new Set();
191: +    storedMessageObservers.set(queryClient, observers);
192: +  }
193: +  observers.add(observer);
194: +  return () => {
195: +    storedMessageObservers.get(queryClient)?.delete(observer);
196: +  };
197: +}
198: +
199: +/**
200: + * Phase 5 FR-034: retires the sender's pending messages of a conversation
201: + * whose stored message has been observed (`stored`: a Realtime INSERT just
202: + * merged, or the feed as rendered after a fetch). A pending message is
203: + * resolved the first time its key is seen: it is removed from every pending
204: + * list of that conversation, so it is not shown again as "sending" if the
205: + * stored message later leaves the feed (for example a Realtime DELETE). Call
206: + * it only after the stored message is in the feed cache, so no render shows
207: + * neither copy.
208: + */
209: +export function resolvePendingMessages(
210: +  queryClient: QueryClient,
211: +  conversationId: string,
212: +  stored: readonly Message[]
213: +): void {
214: +  const storedKeys = new Set<string>();
215: +  for (const message of stored) {
216: +    const key = correlationKey(message);
217: +    if (key) storedKeys.add(key);
218: +  }
219: +  if (storedKeys.size === 0) return;
220: +  // Phase 5 T8: the outbox confirms (and deletes) the items of these keys.
221: +  storedMessageObservers.get(queryClient)?.forEach((observer) => observer(conversationId, stored));
222: +  queryClient
223: +    .getQueriesData<Message[]>({ queryKey: ['messages-pending'] })
224: +    .forEach(([queryKey, pending]) => {
225: +      if (queryKey[2] !== conversationId || !pending?.length) return;
226: +      const remaining = pending.filter((message) => {
227: +        const key = correlationKey(message);
228: +        return key === null || !storedKeys.has(key);
229: +      });
230: +      if (remaining.length !== pending.length) {
231: +        queryClient.setQueryData<Message[]>(queryKey, remaining);
232: +      }
233: +    });
234: +}
235: +
236: +/** Whether `pending` still holds the pending message of `clientMessageId` (not yet resolved). */
237: +export function isPendingMessage(pending: readonly Message[] | undefined, clientMessageId: string): boolean {
238: +  return Boolean(pending?.some((message) => normalizeClientMessageId(message.clientMessageId) === 
clientMessageId));
239: +}
240: +
241: +// Ids of messages this client saw deleted through a Realtime DELETE event, per
242: +// query client, bounded to the last 1000 (the oldest are forgotten first).
243: +// Only three merges consult it: a create response (useMessages), a Realtime
244: +// INSERT (useMessageSubscription) and the re-merge after an in-flight fetch
245: +// (keepMessageThroughInflightFetch). It does not reconcile deletions this
246: +// client missed (e.g. during a Realtime stream gap), and fetched pages are
247: +// not filtered by it: a feed GET that read the row before it was deleted can
248: +// still return it. No product path deletes stored messages today; the only
249: +// deletion is a sender's own Data API delete under RLS (delete_own_messages).
250: +const MAX_REMEMBERED_DELETIONS = 1000;
251: +const deletedMessageIds = new WeakMap<QueryClient, Set<string>>();
252: +
253: +export function markMessageDeleted(queryClient: QueryClient, messageId: string): void {
254: +  let ids = deletedMessageIds.get(queryClient);
255: +  if (!ids) {
256: +    ids = new Set();
257: +    deletedMessageIds.set(queryClient, ids);
258: +  }
259: +  ids.delete(messageId);
260: +  ids.add(messageId);
261: +  if (ids.size > MAX_REMEMBERED_DELETIONS) {
262: +    const oldest = ids.values().next().value;
263: +    if (oldest !== undefined) ids.delete(oldest);
264: +  }
265: +}
266: +
267: +export function isMessageDeleted(queryClient: QueryClient, messageId: string): boolean {
268: +  return deletedMessageIds.get(queryClient)?.has(messageId) ?? false;
269: +}
