145: interface StoredRow {
146:   id: string;
147:   key: string | null;
148:   content: string;
149:   reply_to_id: string | null;
150:   sender_id: string;
151: }
152: 
153: /** Every stored message of the conversation with one of `texts` (any key), oldest first. */
154: async function storedWithTexts(conversationId: string, texts: readonly string[]): Promise<StoredRow[]> {
155:   return withLocalMessagingDb(async (db) => {
156:     const result = await db.query<StoredRow>(
157:       `select id::text as id, client_message_id::text as key, content, reply_to_id::text as reply_to_id,
158:               sender_id::text as sender_id
159:          from public.messages
160:         where conversation_id = $1 and content = any($2::text[])
161:         order by "timestamp", id`,
162:       [conversationId, [...texts]],
163:     );
164:     return result.rows;
165:   });
166: }
