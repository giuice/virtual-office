3: // item of the browser's durable message outbox (IndexedDB), per application
4: // user (users.id) and browser.
5: 
6: /**
7:  * Item state (SPEC §9):
8:  * - `waiting`: stored, never dispatched or back to waiting after a transient
9:  *   outcome (browser offline, 429, 401);
10:  * - `claimed`: a tab holds it and its create request (generation
11:  *   `attemptGeneration`) may be in progress;
12:  * - `unknown`: an attempt ended without a usable response (network error,
13:  *   5xx, a superseded claim) — it may or may not be stored;
14:  * - `failed`: definitively rejected (`failureReason`); no automatic attempt,
15:  *   later items of the conversation wait (BR-003);
16:  * - `expired`: not stored 24 h after send (BR-006; set by T9).
17:  */
18: export type OutboxItemState = 'waiting' | 'claimed' | 'unknown' | 'failed' | 'expired';
19: 
20: /** Why a `failed` item was rejected (BR-005 definitive classes). */
21: export type OutboxFailureReason =
22:   | 'not_participant'
23:   | 'sender_mismatch'
24:   | 'client_message_id_reused'
25:   | 'content_too_large'
26:   | 'invalid_request'
27:   | 'rejected';
28: 
29: /**
30:  * A text or reply message the user pressed send on (BR-002: never files or
31:  * voice). Written before it is dispatched; removed once the server confirmed
32:  * it (create response, or its stored key observed in the feed or Realtime).
33:  * Absence therefore means delivered (or, later, cancelled/deleted — T9/T10).
34:  */
35: export interface OutboxItem {
36:   /** Owner: the application user (users.id), never the Supabase auth uid. */
37:   ownerId: string;
38:   /** Stable composition key, lowercase UUID; every attempt reuses it (BR-004). */
39:   clientMessageId: string;
40:   conversationId: string;
41:   /** Trimmed text as sent. */
42:   content: string;
43:   replyToId: string | null;
44:   /** Requested mentions (users.id), resent unchanged on every attempt. */
45:   mentionIds: string[];
46:   /** When the user pressed send (epoch ms); kept across manual retries. */
47:   pressedSendAt: number;
48:   /** Start of the current 24 h delivery window (epoch ms; BR-006). */
49:   windowStartedAt: number;
50:   /** Per-owner creation order shared by every tab of the browser. */
51:   order: number;
52:   state: OutboxItemState;
53:   /** Set only when `state` is `failed`. */
54:   failureReason: OutboxFailureReason | null;
55:   /** Last dispatched generation (0 = never dispatched); monotonic per key. */
56:   attemptGeneration: number;
57:   /** Tab that claimed the item (cross-tab ownership, T10). */
58:   claimHolder: string | null;
59:   /** When that claim's lease ends (epoch ms; enforced by T10). */
60:   leaseExpiresAt: number | null;
61:   updatedAt: number;
62:   /** Item schema version (1). */
63:   schemaVersion: number;
64: }
65: 
66: /** What the composer hands to the outbox for one send. */
67: export interface OutboxEnqueueInput {
68:   conversationId: string;
69:   clientMessageId: string;
70:   content: string;
71:   replyToId?: string | null;
72:   mentionIds?: readonly string[];
73: }
src/lib/messaging/outbox/outbox-db.ts
1: // src/lib/messaging/outbox/outbox-db.ts
2: // Phase 5 T8: IndexedDB storage of the message outbox (SPEC §9).
3: //
4: // Database `vo-messaging-outbox` (version 1):
5: // - store `items`: one OutboxItem per (ownerId, clientMessageId) (key path);
6: //   index `byConversationOrder` [ownerId, conversationId, order] (the drain
7: //   reads a conversation's oldest item) and `byOwnerOrder` [ownerId, order];
8: // - store `meta`: per-owner counter `{ ownerId, nextOrder }` that gives items
9: //   their creation order inside the same transaction as the item write, so
10: //   the order is shared by every tab of the browser.
11: // The connection closes on `versionchange` (an upgrade or a deletion from
12: // another tab or test is never blocked).
13: import type { OutboxItem } from '@/types/message-outbox';
14: 
15: export const OUTBOX_DB_NAME = 'vo-messaging-outbox';
16: const OUTBOX_DB_VERSION = 1;
17: const ITEMS_STORE = 'items';
18: const META_STORE = 'meta';
19: const BY_CONVERSATION_ORDER = 'byConversationOrder';
20: const BY_OWNER_ORDER = 'byOwnerOrder';
21: 
22: interface OwnerMeta {
23:   ownerId: string;
24:   nextOrder: number;
25: }
26: 
27: /** The outbox cannot be read or written (storage blocked, quota, failed write) — FR-033. */
28: export class OutboxStorageError extends Error {
29:   constructor(message: string, readonly cause?: unknown) {
30:     super(message);
31:     this.name = 'OutboxStorageError';
32:   }
33: }
34: 
35: export function isOutboxStorageError(error: unknown): error is OutboxStorageError {
36:   return error instanceof OutboxStorageError;
37: }
38: 
39: let connection: Promise<IDBDatabase> | null = null;
40: 
41: function describe(error: unknown): string {
42:   if (error === null || error === undefined) return 'aborted';
43:   if (error instanceof DOMException) return `${error.name}: ${error.message}`;
44:   return error instanceof Error ? error.message : String(error);
45: }
46: 
47: function openDatabase(): Promise<IDBDatabase> {
48:   return new Promise<IDBDatabase>((resolve, reject) => {
49:     let request: IDBOpenDBRequest;
50:     try {
51:       if (typeof indexedDB === 'undefined' || indexedDB === null) {
52:         throw new Error('IndexedDB is not available');
53:       }
54:       request = indexedDB.open(OUTBOX_DB_NAME, OUTBOX_DB_VERSION);
55:     } catch (error) {
56:       reject(new OutboxStorageError(`Outbox unavailable (${describe(error)})`, error));
57:       return;
58:     }
59:     request.onupgradeneeded = () => {
60:       const db = request.result;
61:       if (!db.objectStoreNames.contains(ITEMS_STORE)) {
62:         const items = db.createObjectStore(ITEMS_STORE, { keyPath: ['ownerId', 'clientMessageId'] });
63:         items.createIndex(BY_CONVERSATION_ORDER, ['ownerId', 'conversationId', 'order']);
64:         items.createIndex(BY_OWNER_ORDER, ['ownerId', 'order']);
65:       }
66:       if (!db.objectStoreNames.contains(META_STORE)) {
67:         db.createObjectStore(META_STORE, { keyPath: 'ownerId' });
68:       }
69:     };
70:     request.onblocked = () => {
71:       reject(new OutboxStorageError('Outbox upgrade blocked by another tab'));
72:     };
73:     request.onerror = () => {
74:       reject(new OutboxStorageError(`Outbox unavailable (${describe(request.error)})`, request.error));
75:     };
76:     request.onsuccess = () => {
77:       const db = request.result;
78:       db.onversionchange = () => {
79:         db.close();
80:         connection = null;
81:       };
82:       db.onclose = () => {
83:         connection = null;
84:       };
85:       resolve(db);
86:     };
87:   });
88: }
89: 
90: async function database(): Promise<IDBDatabase> {
91:   if (!connection) {
92:     const opening = openDatabase();
93:     connection = opening;
94:     opening.catch(() => {
95:       if (connection === opening) connection = null;
96:     });
97:   }
98:   return connection;
99: }
100: 
101: /**
102:  * Runs `work` in one transaction and resolves with its result once the
103:  * transaction COMMITTED (`complete`); rejects with OutboxStorageError if the
104:  * transaction errors or aborts (e.g. QuotaExceededError). Write transactions
105:  * use strict durability: the commit is flushed before `complete`.
106:  */
107: async function inTransaction<T>(
108:   mode: IDBTransactionMode,
109:   work: (stores: { items: IDBObjectStore; meta: IDBObjectStore }, done: (value: T) => void) => void
110: ): Promise<T> {
111:   const db = await database();
112:   return new Promise<T>((resolve, reject) => {
113:     let transaction: IDBTransaction;
114:     try {
115:       transaction = db.transaction([ITEMS_STORE, META_STORE], mode, { durability: mode === 'readwrite' ? 'strict' 
: 'default' });
116:     } catch (error) {
117:       if (connection) connection = null;
118:       reject(new OutboxStorageError(`Outbox transaction failed (${describe(error)})`, error));
119:       return;
120:     }
121:     let result: T | undefined;
122:     let settled = false;
123:     transaction.oncomplete = () => resolve(result as T);
124:     const fail = () => {
125:       reject(new OutboxStorageError(`Outbox transaction failed (${describe(transaction.error)})`, 
transaction.error));
126:     };
127:     transaction.onerror = (event) => {
128:       // The error event reaches the transaction before its abort; reject once.
129:       event.preventDefault();
130:       if (!settled) {
131:         settled = true;
132:         try {
133:           transaction.abort();
134:         } catch {
135:           // Already aborting.
136:         }
137:       }
138:     };
139:     transaction.onabort = fail;
140:     try {
141:       work(
142:         { items: transaction.objectStore(ITEMS_STORE), meta: transaction.objectStore(META_STORE) },
143:         (value) => {
144:           result = value;
145:         }
146:       );
147:     } catch (error) {
148:       try {
149:         transaction.abort();
150:       } catch {
151:         // Already aborting.
152:       }
153:       reject(new OutboxStorageError(`Outbox transaction failed (${describe(error)})`, error));
154:     }
155:   });
156: }
157: 
158: /** Adds a new item, giving it the owner's next creation order. Resolves once committed. */
159: export function addOutboxItem(item: Omit<OutboxItem, 'order'>): Promise<OutboxItem> {
160:   return inTransaction<OutboxItem>('readwrite', ({ items, meta }, done) => {
161:     const metaRequest = meta.get(item.ownerId);
162:     metaRequest.onsuccess = () => {
163:       const current = metaRequest.result as OwnerMeta | undefined;
164:       const order = current?.nextOrder ?? 1;
165:       const stored: OutboxItem = { ...item, order };
166:       meta.put({ ownerId: item.ownerId, nextOrder: order + 1 } satisfies OwnerMeta);
167:       items.add(stored);
168:       done(stored);
169:     };
170:   });
171: }
172: 
173: /** The owner's items of one conversation (or of all), in creation order. */
174: export function listOutboxItems(ownerId: string, conversationId?: string): Promise<OutboxItem[]> {
175:   return inTransaction<OutboxItem[]>('readonly', ({ items }, done) => {
176:     const request = conversationId
177:       ? items
178:           .index(BY_CONVERSATION_ORDER)
179:           .getAll(IDBKeyRange.bound([ownerId, conversationId, -Infinity], [ownerId, conversationId, Infinity]))
180:       : items.index(BY_OWNER_ORDER).getAll(IDBKeyRange.bound([ownerId, -Infinity], [ownerId, Infinity]));
181:     request.onsuccess = () => done(request.result as OutboxItem[]);
182:   });
183: }
184: 
185: /**
186:  * Reads the item and replaces it with `change(item)` in one transaction
187:  * (`null` deletes it; `undefined` leaves it). Resolves with the stored result
188:  * (`null` when the item is missing or was deleted).
189:  */
190: export function updateOutboxItem(
191:   ownerId: string,
192:   clientMessageId: string,
193:   change: (item: OutboxItem) => OutboxItem | null | undefined
194: ): Promise<OutboxItem | null> {
195:   return inTransaction<OutboxItem | null>('readwrite', ({ items }, done) => {
196:     const request = items.get([ownerId, clientMessageId]);
197:     request.onsuccess = () => {
198:       const item = request.result as OutboxItem | undefined;
199:       if (!item) {
200:         done(null);
201:         return;
202:       }
203:       const next = change(item);
204:       if (next === undefined) {
205:         done(item);
206:       } else if (next === null) {
207:         items.delete([ownerId, clientMessageId]);
208:         done(null);
209:       } else {
210:         items.put(next);
211:         done(next);
212:       }
213:     };
214:   });
215: }
216: 
217: export function deleteOutboxItem(ownerId: string, clientMessageId: string): Promise<void> {
218:   return inTransaction<void>('readwrite', ({ items }, done) => {
219:     items.delete([ownerId, clientMessageId]);
220:     done(undefined);
221:   });
222: }
223: 
224: export type OutboxClaim =
225:   | { kind: 'claimed'; item: OutboxItem }
226:   | { kind: 'empty' }
227:   /** The oldest unresolved item is failed or expired: later items wait (BR-003). */
228:   | { kind: 'blocked'; item: OutboxItem };
229: 
230: /**
231:  * Atomically takes the conversation's OLDEST item for a new attempt: the next
232:  * generation, state `claimed`, `claimHolder`, lease expiry. Only the oldest
233:  * item is ever eligible (BR-003). The caller must hold the conversation's
234:  * drain lock, so any `claimed` item found here belongs to a holder that is
235:  * gone and is taken over under a newer generation.
236:  */
237: export function claimOldestOutboxItem(
238:   ownerId: string,
239:   conversationId: string,
240:   claimHolder: string,
241:   leaseMs: number
242: ): Promise<OutboxClaim> {
243:   return inTransaction<OutboxClaim>('readwrite', ({ items }, done) => {
244:     const range = IDBKeyRange.bound([ownerId, conversationId, -Infinity], [ownerId, conversationId, Infinity]);
245:     const request = items.index(BY_CONVERSATION_ORDER).openCursor(range);
246:     request.onsuccess = () => {
247:       const cursor = request.result;
248:       if (!cursor) {
249:         done({ kind: 'empty' });
250:         return;
251:       }
252:       const item = cursor.value as OutboxItem;
253:       if (item.state === 'failed' || item.state === 'expired') {
254:         done({ kind: 'blocked', item });
255:         return;
256:       }
257:       const now = Date.now();
258:       const claimed: OutboxItem = {
259:         ...item,
260:         state: 'claimed',
261:         attemptGeneration: item.attemptGeneration + 1,
262:         claimHolder,
263:         leaseExpiresAt: now + leaseMs,
264:         updatedAt: now,
265:       };
266:       cursor.update(claimed);
267:       done({ kind: 'claimed', item: claimed });
268:     };
269:   });
270: }

