352:   try {
353:     const auth = await requireAuthUser();
354:     if ('errorResponse' in auth) {
355:       return auth.errorResponse;
356:     }
357:     const serviceClient = await createSupabaseServerClient('service_role');
358:     const overRequestBudget = await enforceRateLimit(serviceClient, auth.dbUser.id, 'message:create-request');
359:     if (overRequestBudget) {
360:       return overRequestBudget;
361:     }
362: 
363:     let body: Record<string, unknown>;
364:     try {
365:       body = await request.json();
366:     } catch {
367:       return jsonError(400, 'BAD_REQUEST', 'Invalid JSON payload');
368:     }
369:     if (typeof body !== 'object' || body === null || Array.isArray(body)) {
370:       return jsonError(400, 'BAD_REQUEST', 'Invalid JSON payload');
371:     }
372: 
373:     const attachmentIds = parseAttachmentIds(body.attachmentIds);
374:     if (!attachmentIds.ok) {
375:       return jsonError(400, attachmentIds.code, attachmentIds.message);
376:     }
377:     const hasAttachments = attachmentIds.value !== undefined;
378: 
379:     const conversationId = typeof body.conversationId === 'string' ? body.conversationId : null;
380:     const rawContent = body.content === undefined && hasAttachments ? '' : body.content;
381:     if (!conversationId || typeof rawContent !== 'string') {
382:       return jsonError(400, 'BAD_REQUEST', 'Missing required fields: conversationId, content');
383:     }
384:     if (!isUuid(conversationId)) {
385:       return jsonError(400, 'BAD_REQUEST', 'conversationId must be a UUID');
386:     }
387: 
388:     const trimmedContent = rawContent.trim();
389:     if (trimmedContent.length === 0 && !hasAttachments) {
390:       return jsonError(400, 'BAD_REQUEST', 'Content must not be empty');
391:     }
392:     if (trimmedContent.length > MAX_CONTENT_LENGTH) {
393:       return jsonError(413, 'CONTENT_TOO_LARGE', `Content exceeds the ${MAX_CONTENT_LENGTH} character limit`);
394:     }
395: 
396:     const clientMessageId = parseClientMessageId(body.clientMessageId);
397:     if (!clientMessageId.ok) {
398:       return jsonError(400, 'INVALID_CLIENT_MESSAGE_ID', 'clientMessageId must be a UUID');
399:     }
400:     const attemptGeneration = parseAttemptGeneration(body.attemptGeneration, clientMessageId.value !== undefined);
401:     if (!attemptGeneration.ok) {
402:       return attemptGeneration.response;
403:     }
404:     const expectedSenderId = parseExpectedSenderId(body.expectedSenderId, attemptGeneration.value !== undefined);
405:     if (!expectedSenderId.ok) {
406:       return expectedSenderId.response;
407:     }
408:     const mentionIds = parseMentionIds(body.mentionIds, clientMessageId.value !== undefined);
409:     if (!mentionIds.ok) {
410:       return mentionIds.response;
411:     }
412: 
413:     const ctx = await authorizeConversationParticipant(auth, serviceClient, conversationId, {
414:       expectedSenderId: expectedSenderId.value,
415:       missingConversationAsNotParticipant: true,
416:     });
417:     if (isAuthzFailure(ctx)) {
418:       return ctx.errorResponse;
419:     }
420:     const { dbUser, conversation } = ctx;
421: 
422:     const messageRepository: IMessageRepository = new SupabaseMessageRepository(serviceClient);
423:     const conversationRepository: IConversationRepository = new SupabaseConversationRepository(serviceClient);
424: 
425:     // Audit S-04: replyToId must reference a message in the SAME conversation.
426:     // Keyed creates are validated by the database AFTER the replay check
427:     // (create_message_attempt): an unchanged replay of a stored message is not
