149: }: MessageComposerProps) {
150:   const [content, setContent] = useState(initialValue);
151:   // A failed send keeps the draft (text and, via the parent, the reply
152:   // target) in the composer; 'send' drives the error + retry row, 'storage'
153:   // the message that the outbox cannot store messages (FR-033).
154:   const [sendError, setSendError] = useState<'send' | 'storage' | null>(null);
155:   const sendFailed = sendError === 'send';
156:   const [isSending, setIsSending] = useState(false);
157:   // Synchronous guard: a double click/Enter lands before React re-renders
158:   // the disabled send button, and must not create a second message. For a
159:   // text message (Phase 5 T8) it spans only the outbox write: delivery runs
160:   // in the background, so the next message can be written at once.
161:   const sendInFlightRef = useRef(false);
162:   // The last composition submitted without a confirmed send. A retry of the
163:   // same text and reply target reuses its key, so a create that committed on
164:   // the server but lost its response is not stored twice; any other draft is
165:   // a new composition with a new key.
166:   const unconfirmedSendRef = useRef<{
167:     key: string;
168:     content: string;
169:     replyToId: string | null;
170:     attachments: string;
171:   } | null>(null);
172:   const textareaRef = useRef<HTMLTextAreaElement>(null);
173:   const fileInputRef = useRef<HTMLInputElement>(null);
174:   const imageInputRef = useRef<HTMLInputElement>(null);
175:   const [isDraggingFiles, setIsDraggingFiles] = useState(false);
176:   const { companyUsers, currentUserProfile } = useCompany();
177:   const {
178:     items: pendingFiles,
179:     rejections: fileRejections,
180:     allUploaded,
181:     addFiles,
182:     addVoiceNote,
183:     remove: removePendingFile,
184:     retry: retryPendingFile,
185:     setSendingUploadIds,
186:     clearSent,
187:     dismissRejections,
188:     reject: rejectFiles,
189:   } = useComposerAttachments(conversationId);
190:   // Voice note (T16): a finished recording becomes the message's only
191:   // attachment and uploads at once, like a file; text may go with it.
192:   const recorder = useVoiceRecorder({ conversationId, onRecorded: addVoiceNote });
193:   const isRecording = recorder.status !== 'idle';
194:   const voiceNote = pendingFiles.find((item) => item.voice) ?? null;
195:   const regularFiles = voiceNote ? pendingFiles.filter((item) => !item.voice) : pendingFiles;
196:   const recordingUnavailable =
