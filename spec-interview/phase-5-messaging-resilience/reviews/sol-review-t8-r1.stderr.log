246:   /** Runs the drain loop while holding the conversation's cross-tab lock (when Web Locks exist). */
247:   private async withDrainLock(conversationId: string): Promise<void> {
248:     const locks = typeof navigator !== 'undefined' ? navigator.locks : undefined;
249:     if (!locks) {
250:       await this.drainLoop(conversationId);
251:       return;
252:     }
253:     const name = `vo-messaging-outbox:${this.ownerId}:${conversationId}`;
254:     const acquired = await locks.request(name, { ifAvailable: true }, async (lock) => {
255:       if (!lock) return false;
256:       await this.drainLoop(conversationId);
257:       return true;
258:     });
259:     if (!acquired) this.scheduleRetry(conversationId, LOCK_BUSY_RETRY_MS);
260:   }
261: 
262:   private async drainLoop(conversationId: string): Promise<void> {
263:     while (!this.disposed && isOnline()) {
264:       const claim = await claimOldestOutboxItem(this.ownerId, conversationId, this.tabId, CLAIM_LEASE_MS);
265:       if (claim.kind !== 'claimed') {
266:         if (claim.kind === 'empty') this.drain(conversationId).retryDelayMs = RETRY_BASE_MS;
267:         return;
268:       }
269:       const { item } = claim;
270:       void this.refreshView(conversationId);
271:       const outcome = await this.attempt(item);
272:       if (this.disposed) return;
273:       this.trace('attempt', { conversationId, generation: item.attemptGeneration, outcome: outcome.kind });
274:       const proceed = await this.applyOutcome(item, outcome);
275:       if (!proceed) return;
276:     }
277:   }
278: 
279:   private async attempt(item: OutboxItem): Promise<OutboxAttemptOutcome> {
280:     try {
281:       const response = await messagingApi.createMessageAttempt({
282:         conversationId: item.conversationId,
283:         content: item.content,
284:         replyToId: item.replyToId,
285:         clientMessageId: item.clientMessageId,
286:         attemptGeneration: item.attemptGeneration,
287:         expectedSenderId: this.ownerId,
