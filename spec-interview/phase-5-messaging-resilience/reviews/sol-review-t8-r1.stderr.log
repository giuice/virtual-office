168: /** Opens the conversation in the drawer (also when the drawer restores it directly). */
169: async function openConversation(page: Page, conversationId: string): Promise<void> {
170:   if (!page.url().includes('/floor-plan')) await page.goto('/floor-plan');
171:   await openDrawer(page);
172:   const item = page.locator(`[data-testid="conversation-item-${conversationId}"]`);
173:   const feed = page.getByTestId('messages-feed');
174:   await expect(item.or(feed).first()).toBeVisible({ timeout: STEP_TIMEOUT_MS });
175:   if (await item.isVisible()) await item.click();
176:   await expect(feed).toBeVisible({ timeout: STEP_TIMEOUT_MS });
177: }
