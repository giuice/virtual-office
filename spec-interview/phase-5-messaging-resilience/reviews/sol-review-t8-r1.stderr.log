20: interface MessageComposerSendOptions {
21:   /**
22:    * Composition key (Phase 4 FR-024): the same value for every retry of one
23:    * composition, a new value for a new composition. The server stores it and
24:    * answers a repeated key with the message it already saved.
25:    */
26:   clientMessageId: string;
27:   /** Uploaded pending files of the message (FR-008); empty for text only. */
28:   attachments: FileAttachment[];
29: }
