208:   
209:   // Set focus on textarea when reply mode is activated
210:   useEffect(() => {
211:     if (replyToMessage && textareaRef.current) {
212:       textareaRef.current.focus();
213:     }
214:   }, [replyToMessage]);
215:   
216:   // Handle content change
217:   const handleContentChange = (e: React.ChangeEvent<HTMLTextAreaElement>) => {
218:     const newContent = e.target.value;
219:     setContent(newContent);
220:     // Nothing left to retry once the draft is erased.
221:     if (!newContent.trim() && pendingFiles.length === 0) {
222:       setSendError(null);
223:       unconfirmedSendRef.current = null;
224:     }
225:     
226:     // Call onValueChange callback if provided
227:     if (onValueChange) {
228:       onValueChange(newContent);
229:     }
230:   };
231:   
232:   const submitDraft = async () => {
233:     if (!canSubmit || sendInFlightRef.current) return;
234: 
235:     const submittedContent = content;
236:     const attachments = pendingFiles.flatMap((file) => (file.uploaded ? [file.uploaded] : []));
237:     const attachmentIds = attachments.map((attachment) => attachment.id);
238:     const composition = {
239:       content: submittedContent.trim(),
240:       replyToId: replyToMessage?.id ?? null,
241:       attachments: attachmentSetKey(attachments),
242:     };
243:     const unconfirmed = unconfirmedSendRef.current;
244:     const clientMessageId =
245:       unconfirmed &&
246:       unconfirmed.content === composition.content &&
247:       unconfirmed.replyToId === composition.replyToId &&
248:       unconfirmed.attachments === composition.attachments
249:         ? unconfirmed.key
250:         : uuidv4();
