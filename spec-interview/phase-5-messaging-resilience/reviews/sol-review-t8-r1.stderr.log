252:     sendInFlightRef.current = true;
253:     setSendingUploadIds(attachmentIds);
254:     setIsSending(true);
255:     setSendError(null);
256:     try {
257:       await onSendMessage(submittedContent, { clientMessageId, attachments });
258:       unconfirmedSendRef.current = null;
259:       // Clear only what was sent: text typed or files added while the send
260:       // was in flight belong to the next message and must survive.
261:       setContent((current) => (current === submittedContent ? '' : current));
262:       clearSent(attachmentIds);
263:     } catch (error) {
264:       console.error('Failed to send message:', error);
265:       // The draft (text, reply target, files) stays in the composer; the
266:       // user can retry it.
267:       setSendError(isOutboxStorageError(error) ? 'storage' : 'send');
268:     } finally {
269:       sendInFlightRef.current = false;
270:       setSendingUploadIds([]);
271:       setIsSending(false);
272:     }
273:   };
