289:       });
290:       return classifyAttemptResponse(response);
291:     } catch {
292:       // No response (network error, the browser went offline mid-request).
293:       return { kind: 'unknown', status: null };
294:     }
295:   }
296: 
297:   /** Records the outcome; resolves whether the drain may go on with the next item. */
298:   private async applyOutcome(item: OutboxItem, outcome: OutboxAttemptOutcome): Promise<boolean> {
299:     const { conversationId, clientMessageId } = item;
300:     if (outcome.kind === 'delivered') {
301:       this.markConfirmed(clientMessageId);
302:       this.drain(conversationId).keys.delete(clientMessageId);
303:       showConfirmedOutboxMessage(this.queryClient, this.ownerId, conversationId, clientMessageId, 
