232: /** The pending copy of `key` in A's feed shows `label` as text. */
233: async function expectPendingLabel(page: Page, key: string, state: 'pending' | 'sending', label: string): 
Promise<void> {
234:   const bubble = page.getByTestId(`message-temp-${key}`);
235:   await expect(bubble).toBeVisible({ timeout: STEP_TIMEOUT_MS });
236:   const stateLabel = bubble.getByTestId(`message-delivery-state-temp-${key}`);
237:   await expect(stateLabel).toHaveText(label);
238:   await expect(stateLabel).toHaveAttribute('data-delivery-state', state);
239: }
