1: // src/lib/messaging/outbox/message-outbox.ts
2: // Phase 5 T8 (FR-001, FR-002, FR-003, BR-002, BR-003): the signed-in user's
3: // durable outbox of text/reply messages and its ordered automatic delivery.
4: //
5: // - enqueue(): writes the item to IndexedDB (committed, strict durability)
6: //   BEFORE anything is dispatched and before the composer clears; a failed
7: //   write rejects with OutboxStorageError and nothing is sent (FR-033, D5).
8: // - Drain, per conversation, in creation order: only the oldest item is ever
9: //   eligible; one attempt at a time per conversation in this tab, and a Web
10: //   Lock per (owner, conversation) keeps other tabs of the browser from
11: //   draining the same conversation at the same time (released by the browser
12: //   when the tab closes or crashes). Leases, takeover of a hung holder,
13: //   cross-tab display and cancel are T10; explicit fencing of unknown items
14: //   and the 24 h window are T27/T9.
15: // - Every attempt carries a new attempt generation and the owner as
16: //   expectedSenderId. A generation-carrying create first fences every older
17: //   generation of the key on the server and replays a stored message (T2), so
18: //   redispatching an `unknown` or orphaned `claimed` item under the next
19: //   generation can never store a second copy.
20: // - Triggers: start (page load), enqueue, the browser `online` event, and a
21: //   capped backoff after a transient or unknown outcome.
22: // - An item is confirmed — removed from the outbox and its pending copy
23: //   dropped — by a 200/201/410 response, or the first time its stored key is
24: //   observed in the feed or Realtime (observeStoredMessages), whichever comes
25: //   first; a confirmed key is never shown again.
26: import type { QueryClient } from '@tanstack/react-query';
27: 
28: import { messagingApi } from '@/lib/messaging-api';
29: import { normalizeClientMessageId, observeStoredMessages } from '@/lib/messaging/message-cache';
30: import { debugLogger } from '@/utils/debug-logger';
31: import type { Message } from '@/types/messaging';
32: import type { OutboxEnqueueInput, OutboxItem } from '@/types/message-outbox';
33: import {
34:   addOutboxItem,
35:   claimOldestOutboxItem,
36:   deleteOutboxItem,
37:   listOutboxItems,
38:   updateOutboxItem,
39: } from './outbox-db';
40: import { classifyAttemptResponse, type OutboxAttemptOutcome } from './outbox-outcome';
41: import { showConfirmedOutboxMessage, writeOutboxView } from './outbox-view';
42: 
43: /** Lease placeholder recorded with a claim (SPEC FR-004: 45 s; enforced by T10). */
44: const CLAIM_LEASE_MS = 45_000;
45: const RETRY_BASE_MS = 1_000;
46: const RETRY_MAX_MS = 15_000;
47: /** Retry when another tab holds the conversation's drain lock. */
48: const LOCK_BUSY_RETRY_MS = 2_000;
49: const MAX_REMEMBERED_CONFIRMATIONS = 1_000;
50: const SCOPE = 'MessageOutbox';
51: 
52: interface ConversationDrain {
53:   running: boolean;
54:   rerun: boolean;
55:   retryTimer: ReturnType<typeof setTimeout> | null;
56:   retryDelayMs: number;
57:   viewSeq: number;
58:   keys: Set<string>;
59: }
60: 
61: const createTabId = (): string =>
62:   typeof crypto !== 'undefined' && typeof crypto.randomUUID === 'function'
63:     ? crypto.randomUUID()
64:     : `tab-${Date.now().toString(36)}-${Math.random().toString(36).slice(2)}`;
65: 
66: const isOnline = (): boolean => typeof navigator === 'undefined' || navigator.onLine !== false;
67: 
68: export class MessageOutbox {
69:   readonly ownerId: string;
70:   private readonly queryClient: QueryClient;
71:   private readonly tabId = createTabId();
72:   private readonly conversations = new Map<string, ConversationDrain>();
73:   private readonly confirmed = new Set<string>();
74:   private disposed = false;
75:   private unsubscribeObservations: (() => void) | null = null;
76: 
77:   constructor(ownerId: string, queryClient: QueryClient) {
78:     this.ownerId = ownerId;
79:     this.queryClient = queryClient;
80:   }
81: 
82:   start(): void {
83:     // Pending views outlive an unmounted feed: they are the only copy on screen
84:     // of an item not yet delivered (they hold a few small messages per user).
85:     this.queryClient.setQueryDefaults(['messages-pending'], { gcTime: Infinity, staleTime: Infinity });
86:     window.addEventListener('online', this.handleOnline);
87:     this.unsubscribeObservations = observeStoredMessages(this.queryClient, this.handleStoredObserved);
88:     void this.loadAll();
89:   }
90: 
91:   dispose(): void {
92:     this.disposed = true;
93:     window.removeEventListener('online', this.handleOnline);
94:     this.unsubscribeObservations?.();
95:     this.unsubscribeObservations = null;
96:     this.conversations.forEach((drain) => {
97:       if (drain.retryTimer) clearTimeout(drain.retryTimer);
98:       drain.retryTimer = null;
99:     });
100:   }
101: 
102:   /**
103:    * Durably queues a text/reply message (never files or voice, BR-002) and
104:    * starts its delivery. Resolves once the item is committed to IndexedDB and
105:    * shown as pending; rejects with OutboxStorageError if it cannot be stored.
106:    */
107:   async enqueue(input: OutboxEnqueueInput): Promise<void> {
108:     if (this.disposed) throw new Error('The outbox of this user is closed');
109:     const clientMessageId = normalizeClientMessageId(input.clientMessageId);
110:     const content = input.content.trim();
111:     if (!clientMessageId || !content) throw new Error('Nothing to send');
112:     const now = Date.now();
113:     const item = await addOutboxItem({
114:       ownerId: this.ownerId,
115:       clientMessageId,
116:       conversationId: input.conversationId,
117:       content,
118:       replyToId: input.replyToId ?? null,
119:       mentionIds: [...(input.mentionIds ?? [])],
120:       pressedSendAt: now,
121:       windowStartedAt: now,
122:       state: 'waiting',
123:       failureReason: null,
124:       attemptGeneration: 0,
125:       claimHolder: null,
126:       leaseExpiresAt: null,
127:       updatedAt: now,
128:       schemaVersion: 1,
129:     });
130:     this.trace('enqueued', { conversationId: item.conversationId, order: item.order });
131:     await this.refreshView(item.conversationId);
132:     this.drainConversation(item.conversationId);
133:   }
134: 
135:   private readonly handleOnline = () => {
136:     if (this.disposed) return;
137:     this.conversations.forEach((drain) => {
138:       if (drain.retryTimer) clearTimeout(drain.retryTimer);
139:       drain.retryTimer = null;
140:       drain.retryDelayMs = RETRY_BASE_MS;
141:     });
142:     void this.loadAll();
143:   };
144: 
145:   /** A stored message with one of this owner's keys was observed: the item is delivered. */
146:   private readonly handleStoredObserved = (conversationId: string, stored: readonly Message[]) => {
147:     if (this.disposed) return;
148:     const drain = this.conversations.get(conversationId);
149:     if (!drain || drain.keys.size === 0) return;
150:     for (const message of stored) {
151:       const key = normalizeClientMessageId(message.clientMessageId);
152:       if (message.senderId !== this.ownerId || !key || !drain.keys.has(key)) continue;
153:       this.markConfirmed(key);
154:       drain.keys.delete(key);
155:       void deleteOutboxItem(this.ownerId, key)
156:         .catch((error) => this.trace('confirm-delete-failed', { error: String(error) }))
157:         .finally(() => void this.refreshView(conversationId));
158:     }
159:   };
160: 
161:   private drain(conversationId: string): ConversationDrain {
162:     let drain = this.conversations.get(conversationId);
163:     if (!drain) {
164:       drain = { running: false, rerun: false, retryTimer: null, retryDelayMs: RETRY_BASE_MS, viewSeq: 0, keys: 
new Set() };
165:       this.conversations.set(conversationId, drain);
166:     }
167:     return drain;
168:   }
169: 
170:   private markConfirmed(clientMessageId: string): void {
171:     this.confirmed.delete(clientMessageId);
172:     this.confirmed.add(clientMessageId);
173:     if (this.confirmed.size > MAX_REMEMBERED_CONFIRMATIONS) {
174:       const oldest = this.confirmed.values().next().value;
175:       if (oldest !== undefined) this.confirmed.delete(oldest);
176:     }
177:   }
178: 
179:   /** Shows every conversation's items and drains each one. */
180:   private async loadAll(): Promise<void> {
181:     let items: OutboxItem[];
182:     try {
183:       items = await listOutboxItems(this.ownerId);
184:     } catch (error) {
185:       this.trace('load-failed', { error: String(error) });
186:       return;
187:     }
188:     if (this.disposed) return;
189:     const conversationIds = new Set(items.map((item) => item.conversationId));
190:     this.conversations.forEach((_drain, conversationId) => conversationIds.add(conversationId));
191:     for (const conversationId of conversationIds) {
192:       writeOutboxView(
193:         this.queryClient,
194:         this.ownerId,
195:         conversationId,
196:         this.visible(items.filter((item) => item.conversationId === conversationId))
197:       );
198:       this.drain(conversationId).keys = new Set(
199:         items.filter((item) => item.conversationId === conversationId).map((item) => item.clientMessageId)
200:       );
201:       this.drainConversation(conversationId);
202:     }
203:   }
204: 
205:   private visible(items: readonly OutboxItem[]): OutboxItem[] {
206:     return items.filter((item) => !this.confirmed.has(item.clientMessageId));
207:   }
208: 
209:   /** Re-reads the conversation's items and renders them (latest read wins). */
210:   private async refreshView(conversationId: string): Promise<void> {
211:     const drain = this.drain(conversationId);
212:     drain.viewSeq += 1;
213:     const seq = drain.viewSeq;
214:     let items: OutboxItem[];
215:     try {
216:       items = await listOutboxItems(this.ownerId, conversationId);
217:     } catch (error) {
218:       this.trace('view-read-failed', { error: String(error) });
219:       return;
220:     }
221:     if (this.disposed || seq !== drain.viewSeq) return;
222:     drain.keys = new Set(items.map((item) => item.clientMessageId));
223:     writeOutboxView(this.queryClient, this.ownerId, conversationId, this.visible(items));
224:   }
225: 
226:   private drainConversation(conversationId: string): void {
227:     if (this.disposed) return;
228:     const drain = this.drain(conversationId);
229:     if (drain.running) {
230:       drain.rerun = true;
231:       return;
232:     }
233:     drain.running = true;
234:     drain.rerun = false;
235:     void this.withDrainLock(conversationId)
236:       .catch((error) => {
237:         this.trace('drain-failed', { error: String(error) });
238:         this.scheduleRetry(conversationId);
239:       })
240:       .finally(() => {
241:         drain.running = false;
242:         if (drain.rerun && !this.disposed) this.drainConversation(conversationId);
243:       });
244:   }
