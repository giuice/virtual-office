37: interface OutboxRow {
38:   ownerId: string;
39:   clientMessageId: string;
40:   conversationId: string;
41:   content: string;
42:   replyToId: string | null;
43:   mentionIds: string[];
44:   pressedSendAt: number;
45:   windowStartedAt: number;
46:   order: number;
47:   state: string;
48:   failureReason: string | null;
49:   attemptGeneration: number;
50:   claimHolder: string | null;
51:   leaseExpiresAt: number | null;
52:   schemaVersion: number;
53: }
