187: /** A's own API create (warms the create route; gives a reply target). */
188: async function createViaApi(page: Page, data: Record<string, unknown>): Promise<string> {
189:   const response = await page.request.post('/api/messages/create', { data });
190:   const body = (await response.json().catch(() => null)) as { message?: { id?: string } } | null;
191:   expect(response.status(), JSON.stringify(body)).toBe(201);
192:   return body?.message?.id as string;
193: }
