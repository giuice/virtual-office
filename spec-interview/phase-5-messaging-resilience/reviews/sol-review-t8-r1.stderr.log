1: // src/lib/messaging/outbox/outbox-outcome.ts
2: // Phase 5 T8: outcome classes of one outbox attempt (BR-005).
3: import type { Message } from '@/types/messaging';
4: import type { OutboxFailureReason } from '@/types/message-outbox';
5: 
6: export type OutboxAttemptOutcome =
7:   /** Stored (201) or replayed (200); `message` is null when it was deleted since (410). */
8:   | { kind: 'delivered'; message: Message | null }
9:   /** 429 / 401: retried automatically, in order (FR-008; 401 vs session end → T11). */
10:   | { kind: 'transient'; status: number }
11:   /** No usable response (network error, 5xx, unreadable 2xx): it may be stored. */
12:   | { kind: 'unknown'; status: number | null }
13:   /** 409 ATTEMPT_SUPERSEDED: a newer attempt of the key exists; ignored. */
14:   | { kind: 'superseded' }
15:   /** Definitive: no automatic retry (FR-007). */
16:   | { kind: 'failed'; status: number; reason: OutboxFailureReason };
17: 
18: export function classifyAttemptResponse(response: {
19:   status: number;
20:   code?: string;
21:   message?: Message;
22: }): OutboxAttemptOutcome {
23:   const { status, code, message } = response;
24:   if (status === 200 || status === 201) {
25:     return message ? { kind: 'delivered', message } : { kind: 'unknown', status };
26:   }
27:   if (status === 410 && code === 'MESSAGE_DELETED') return { kind: 'delivered', message: null };
28:   if (status === 429 || status === 401) return { kind: 'transient', status };
29:   if (status >= 500 || status < 200 || (status >= 300 && status < 400)) return { kind: 'unknown', status };
30:   if (status === 409 && code === 'ATTEMPT_SUPERSEDED') return { kind: 'superseded' };
31:   return { kind: 'failed', status, reason: failureReason(status, code) };
32: }
33: 
34: function failureReason(status: number, code: string | undefined): OutboxFailureReason {
35:   if (status === 403 && code === 'SENDER_MISMATCH') return 'sender_mismatch';
36:   if (status === 403) return 'not_participant';
37:   if (status === 409 && code === 'CLIENT_MESSAGE_ID_REUSED') return 'client_message_id_reused';
38:   if (status === 413) return 'content_too_large';
39:   if (status === 400) return 'invalid_request';
40:   return 'rejected';
41: }
