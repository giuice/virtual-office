  21:  * the client's messaging health metrics, written as redacted structured log
  22:  * lines (one JSON line per accepted event, schema `messaging-metrics-v1`).
  23:  *
  24:  * Body (application/json): { events: MessagingMetricEventInput[] } — see
  25:  * src/lib/messaging/metrics-contract.ts for the closed enums and bounds.
  26:  *
  27:  * Order: authenticate (401, nothing charged or logged) → charge the per-user
  28:  * 'messaging:metrics' budget, fail-closed (429) → 415 unless JSON → raw body
  29:  * at most 16 KB counted on the received bytes (413
  30:  * METRICS_PAYLOAD_TOO_LARGE) → valid JSON object with an `events` array
  31:  * (400) → at most 50 events (413 METRICS_BATCH_TOO_LARGE) → each event
  32:  * validated; invalid ones dropped, unknown fields ignored → 202
  33:  * { accepted, dropped }. A rejected request writes no metric line.
  34:  *
  35:  * Lines carry only the event type, reason, conversation type, duration,
  36:  * count, the client event time (bounded), the server receive time, and the
  37:  * server-derived app version — never user, conversation, or message data.
  38:  */
  39: export async function POST(request: NextRequest) {
  40:   try {
  41:     const auth = await requireAuthUser();
  42:     if ('errorResponse' in auth) {
  43:       await request.body?.cancel().catch(() => undefined);
  44:       return auth.errorResponse;
  45:     }
  46: 
  47:     const serviceClient = await createSupabaseServerClient('service_role');
  48:     const overBudget = await enforceRateLimit(serviceClient, auth.dbUser.id, 'messaging:metrics');
  49:     if (overBudget) {
  50:       await request.body?.cancel().catch(() => undefined);
  51:       return overBudget;
  52:     }
  53: 
  54:     const contentType = request.headers.get('content-type') ?? '';
  55:     if (contentType.split(';')[0].trim().toLowerCase() !== 'application/json') {
  56:       await request.body?.cancel().catch(() => undefined);
  57:       return jsonError(415, 'UNSUPPORTED_MEDIA_TYPE', 'Metrics must be sent as application/json');
  58:     }
  59: 
