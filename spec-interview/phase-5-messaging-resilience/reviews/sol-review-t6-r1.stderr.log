  17: const ERROR_CODE_PATTERN = /^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$/;
  18: const SECRET_PATTERN = /(?:[\w.+-]+@[\w.-]+\.[A-Za-z]{2,}|\beyJ[A-Za-z0-9_-]{8,}|bearer\s+|access[_-]?token|refre
sh[_-]?token|provider[_-]?token|service[_-]?role|sb_secret_)/i;
