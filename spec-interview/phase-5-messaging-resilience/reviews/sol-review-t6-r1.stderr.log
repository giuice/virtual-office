   1: // Messaging health metrics wire contract (Phase 5 FR-027, BR-013, AC-028).
   2: //
   3: // Shared by the client recorder and POST /api/messages/metrics. Everything a
   4: // metric can carry is a closed enum or a bounded integer: the route copies
   5: // only these fields, drops any event with an unknown type or an invalid known
   6: // field, ignores every other field, and adds the server time and the
   7: // server-derived app version itself. No identifier, name, text, or other
   8: // free-form value can reach a log line.
   9: 
  10: /** Route path of the metrics sink. */
  11: export const MESSAGING_METRICS_PATH = '/api/messages/metrics';
  12: 
  13: /** At most this many events per request (larger batches are rejected, 413). */
  14: export const MESSAGING_METRICS_MAX_EVENTS = 50;
  15: 
  16: /** At most this many bytes of raw request body (larger bodies are rejected, 413). */
  17: export const MESSAGING_METRICS_MAX_BYTES = 16 * 1024;
  18: 
  19: /** Upper bound of `durationMs` (30 days; send latency counts from the original press). */
  20: export const MESSAGING_METRICS_MAX_DURATION_MS = 30 * 24 * 60 * 60 * 1000;
  21: 
  22: /** Upper bound of `count`. */
  23: export const MESSAGING_METRICS_MAX_COUNT = 10_000;
  24: 
  25: /** `occurredAt` (client epoch ms) is accepted only within this past window... */
  26: export const MESSAGING_METRICS_MAX_EVENT_AGE_MS = 30 * 24 * 60 * 60 * 1000;
  27: /** ...and at most this far ahead of the server clock. */
  28: export const MESSAGING_METRICS_MAX_CLOCK_SKEW_MS = 5 * 60 * 1000;
  29: 
  30: export const MESSAGING_METRIC_TYPES = [
  31:   // Press → server confirmed (from the original press, also after a manual retry).
  32:   'send_latency',
  33:   // Time an item waited in the outbox before its successful dispatch.
  34:   'outbox_wait',
  35:   // Outcome of a send, by reason.
  36:   'send_outcome',
  37:   // Realtime stream health; the stream is part of the event type.
  38:   'messages_stream_drop',
  39:   'messages_stream_recovery',
  40:   'list_stream_drop',
  41:   'list_stream_recovery',
  42:   'typing_stream_drop',
  43:   'typing_stream_recovery',
  44:   // Polling fallback episodes.
  45:   'polling_start',
  46:   'polling_stop',
  47: ] as const;
  48: 
  49: export type MessagingMetricType = (typeof MESSAGING_METRIC_TYPES)[number];
  50: 
  51: export const MESSAGING_SEND_OUTCOME_REASONS = [
  52:   'delivered',
  53:   'offline',
  54:   'network_error',
  55:   'timeout',
  56:   'rate_limited',
  57:   'server_error',
  58:   'lost_access',
  59:   'expired',
  60:   'invalid_request',
  61:   'content_too_large',
  62:   'key_reused',
  63:   'sender_mismatch',
  64:   'session_ended',
  65:   'cancelled',
  66: ] as const;
  67: 
  68: export type MessagingSendOutcomeReason = (typeof MESSAGING_SEND_OUTCOME_REASONS)[number];
  69: 
  70: export const MESSAGING_STREAM_DROP_REASONS = ['error', 'timeout', 'closed', 'offline'] as const;
  71: 
  72: export type MessagingStreamDropReason = (typeof MESSAGING_STREAM_DROP_REASONS)[number];
  73: 
  74: export const MESSAGING_METRIC_CONVERSATION_TYPES = ['direct', 'group', 'room'] as const;
  75: 
  76: export type MessagingMetricConversationType = (typeof MESSAGING_METRIC_CONVERSATION_TYPES)[number];
  77: 
  78: export type MessagingMetricReason = MessagingSendOutcomeReason | MessagingStreamDropReason;
  79: 
  80: /** Field rules of one event type: required fields must be present and valid. */
  81: export interface MessagingMetricTypeRule {
  82:   readonly reasons: readonly MessagingMetricReason[] | null;
  83:   readonly reasonRequired: boolean;
  84:   readonly durationRequired: boolean;
  85:   readonly allowsDuration: boolean;
  86:   readonly allowsCount: boolean;
  87:   readonly allowsConversationType: boolean;
  88: }
  89: 
  90: const SEND_DURATION: MessagingMetricTypeRule = {
  91:   reasons: null,
