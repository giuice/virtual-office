 155: export interface MessagingMetricEventInput {
 156:   type: MessagingMetricType;
 157:   reason?: MessagingMetricReason;
 158:   conversationType?: MessagingMetricConversationType;
 159:   /** Non-negative integer milliseconds, at most MESSAGING_METRICS_MAX_DURATION_MS. */
 160:   durationMs?: number;
