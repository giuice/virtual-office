  47:     const serviceClient = await createSupabaseServerClient('service_role');
  48:     const overBudget = await enforceRateLimit(serviceClient, auth.dbUser.id, 'messaging:metrics');
  49:     if (overBudget) {
  50:       await request.body?.cancel().catch(() => undefined);
  51:       return overBudget;
  52:     }
  53: 
  54:     const contentType = request.headers.get('content-type') ?? '';
  55:     if (contentType.split(';')[0].trim().toLowerCase() !== 'application/json') {
  56:       await request.body?.cancel().catch(() => undefined);
  57:       return jsonError(415, 'UNSUPPORTED_MEDIA_TYPE', 'Metrics must be sent as application/json');
  58:     }
  59: 
  60:     const body = await readBoundedBody(request, MESSAGING_METRICS_MAX_BYTES);
  61:     if (!body.ok) {
  62:       return body.reason === 'too_large'
  63:         ? jsonError(413, 'METRICS_PAYLOAD_TOO_LARGE', 'Metrics payload exceeds 16 KB')
  64:         : jsonError(400, 'BAD_REQUEST', 'Metrics payload could not be read');
  65:     }
  66: 
  67:     let payload: unknown;
  68:     try {
  69:       payload = JSON.parse(new TextDecoder('utf-8', { fatal: true }).decode(body.bytes));
  70:     } catch {
  71:       return jsonError(400, 'BAD_REQUEST', 'Invalid JSON payload');
  72:     }
  73:     if (typeof payload !== 'object' || payload === null || Array.isArray(payload)) {
  74:       return jsonError(400, 'BAD_REQUEST', 'Invalid JSON payload');
  75:     }
  76:     const events = (payload as { events?: unknown }).events;
  77:     if (!Array.isArray(events)) {
  78:       return jsonError(400, 'BAD_REQUEST', 'events must be an array');
  79:     }
  80:     if (events.length > MESSAGING_METRICS_MAX_EVENTS) {
  81:       return jsonError(413, 'METRICS_BATCH_TOO_LARGE', 'At most 50 metric events per request');
  82:     }
  83: 
  84:     const context = { now: Date.now(), appVersion: serverAppVersion() };
  85:     const lines: MessagingMetricLogLine[] = [];
  86:     for (const event of events) {
  87:       const line = toMessagingMetricLogLine(event, context);
  88:       if (line) lines.push(line);
  89:     }
  90:     writeMessagingMetricLines(lines);
  91: 
  92:     const result: MessagingMetricsResponse = { accepted: lines.length, dropped: events.length - lines.length };
  93:     return NextResponse.json(result, { status: 202 });
  94:   } catch (error) {
  95:     // Never log the error object: it could carry request data.
  96:     console.error(JSON.stringify({ event: 'messaging_metrics_failed', errorName: error instanceof Error ? 
error.name : 'unknown' }));
  97:     return NextResponse.json({ error: 'Failed to record metrics', code: 'INTERNAL_ERROR' }, { status: 500 });
  98:   }
  99: }
src/lib/messaging/metrics-contract.ts
   1: // Messaging health metrics wire contract (Phase 5 FR-027, BR-013, AC-028).
   2: //
   3: // Shared by the client recorder and POST /api/messages/metrics. Everything a
   4: // metric can carry is a closed enum or a bounded integer: the route copies
   5: // only these fields, drops any event with an unknown type or an invalid known
   6: // field, ignores every other field, and adds the server time and the
   7: // server-derived app version itself. No identifier, name, text, or other
   8: // free-form value can reach a log line.
   9: 
  10: /** Route path of the metrics sink. */
  11: export const MESSAGING_METRICS_PATH = '/api/messages/metrics';
  12: 
  13: /** At most this many events per request (larger batches are rejected, 413). */
  14: export const MESSAGING_METRICS_MAX_EVENTS = 50;
  15: 
  16: /** At most this many bytes of raw request body (larger bodies are rejected, 413). */
  17: export const MESSAGING_METRICS_MAX_BYTES = 16 * 1024;
  18: 
  19: /** Upper bound of `durationMs` (30 days; send latency counts from the original press). */
  20: export const MESSAGING_METRICS_MAX_DURATION_MS = 30 * 24 * 60 * 60 * 1000;
  21: 
  22: /** Upper bound of `count`. */
  23: export const MESSAGING_METRICS_MAX_COUNT = 10_000;
  24: 
  25: /** `occurredAt` (client epoch ms) is accepted only within this past window... */
  26: export const MESSAGING_METRICS_MAX_EVENT_AGE_MS = 30 * 24 * 60 * 60 * 1000;
  27: /** ...and at most this far ahead of the server clock. */
  28: export const MESSAGING_METRICS_MAX_CLOCK_SKEW_MS = 5 * 60 * 1000;
  29: 
  30: export const MESSAGING_METRIC_TYPES = [
  31:   // Press → server confirmed (from the original press, also after a manual retry).
  32:   'send_latency',
  33:   // Time an item waited in the outbox before its successful dispatch.
  34:   'outbox_wait',
  35:   // Outcome of a send, by reason.
  36:   'send_outcome',
  37:   // Realtime stream health; the stream is part of the event type.
  38:   'messages_stream_drop',
  39:   'messages_stream_recovery',
  40:   'list_stream_drop',
  41:   'list_stream_recovery',
  42:   'typing_stream_drop',
  43:   'typing_stream_recovery',
  44:   // Polling fallback episodes.
  45:   'polling_start',
  46:   'polling_stop',
  47: ] as const;
  48: 
  49: export type MessagingMetricType = (typeof MESSAGING_METRIC_TYPES)[number];
  50: 
  51: export const MESSAGING_SEND_OUTCOME_REASONS = [
  52:   'delivered',
  53:   'offline',
  54:   'network_error',
  55:   'timeout',
  56:   'rate_limited',
  57:   'server_error',
  58:   'lost_access',
  59:   'expired',
  60:   'invalid_request',
  61:   'content_too_large',
  62:   'key_reused',
  63:   'sender_mismatch',
  64:   'session_ended',
  65:   'cancelled',
  66: ] as const;
  67: 
  68: export type MessagingSendOutcomeReason = (typeof MESSAGING_SEND_OUTCOME_REASONS)[number];
  69: 
  70: export const MESSAGING_STREAM_DROP_REASONS = ['error', 'timeout', 'closed', 'offline'] as const;
  71: 
  72: export type MessagingStreamDropReason = (typeof MESSAGING_STREAM_DROP_REASONS)[number];
  73: 
  74: export const MESSAGING_METRIC_CONVERSATION_TYPES = ['direct', 'group', 'room'] as const;
  75: 
  76: export type MessagingMetricConversationType = (typeof MESSAGING_METRIC_CONVERSATION_TYPES)[number];
  77: 
  78: export type MessagingMetricReason = MessagingSendOutcomeReason | MessagingStreamDropReason;
  79: 
  80: /** Field rules of one event type: required fields must be present and valid. */
  81: export interface MessagingMetricTypeRule {
  82:   readonly reasons: readonly MessagingMetricReason[] | null;
  83:   readonly reasonRequired: boolean;
  84:   readonly durationRequired: boolean;
  85:   readonly allowsDuration: boolean;
  86:   readonly allowsCount: boolean;
  87:   readonly allowsConversationType: boolean;
  88: }
  89: 
  90: const SEND_DURATION: MessagingMetricTypeRule = {
  91:   reasons: null,
  92:   reasonRequired: false,
  93:   durationRequired: true,
  94:   allowsDuration: true,
  95:   allowsCount: false,
  96:   allowsConversationType: true,
  97: };
  98: 
  99: const STREAM_DROP = (allowsConversationType: boolean): MessagingMetricTypeRule => ({
 100:   reasons: MESSAGING_STREAM_DROP_REASONS,
 101:   reasonRequired: true,
 102:   durationRequired: false,
 103:   allowsDuration: false,
 104:   allowsCount: false,
 105:   allowsConversationType,
 106: });
 107: 
 108: const STREAM_RECOVERY = (allowsConversationType: boolean): MessagingMetricTypeRule => ({
 109:   // durationMs = outage duration; count = rejoin attempts.
 110:   reasons: null,
 111:   reasonRequired: false,
 112:   durationRequired: true,
 113:   allowsDuration: true,
 114:   allowsCount: true,
 115:   allowsConversationType,
 116: });
 117: 
 118: export const MESSAGING_METRIC_TYPE_RULES: Readonly<Record<MessagingMetricType, MessagingMetricTypeRule>> = {
 119:   send_latency: SEND_DURATION,
 120:   outbox_wait: SEND_DURATION,
 121:   send_outcome: {
 122:     reasons: MESSAGING_SEND_OUTCOME_REASONS,
 123:     reasonRequired: true,
 124:     durationRequired: false,
 125:     allowsDuration: false,
 126:     allowsCount: false,
 127:     allowsConversationType: true,
 128:   },
 129:   messages_stream_drop: STREAM_DROP(true),
 130:   messages_stream_recovery: STREAM_RECOVERY(true),
 131:   list_stream_drop: STREAM_DROP(false),
 132:   list_stream_recovery: STREAM_RECOVERY(false),
 133:   typing_stream_drop: STREAM_DROP(true),
 134:   typing_stream_recovery: STREAM_RECOVERY(true),
 135:   polling_start: {
 136:     reasons: null,
 137:     reasonRequired: false,
 138:     durationRequired: false,
 139:     allowsDuration: false,
 140:     allowsCount: false,
 141:     allowsConversationType: true,
 142:   },
 143:   polling_stop: {
 144:     // durationMs = polling episode duration; count = polling cycles.
 145:     reasons: null,
 146:     reasonRequired: false,
 147:     durationRequired: true,
 148:     allowsDuration: true,
 149:     allowsCount: true,
 150:     allowsConversationType: true,
 151:   },
 152: };
 153: 
 154: /** One event as the client sends it (`{ events: MessagingMetricEventInput[] }`). */
 155: export interface MessagingMetricEventInput {
 156:   type: MessagingMetricType;
 157:   reason?: MessagingMetricReason;
 158:   conversationType?: MessagingMetricConversationType;
 159:   /** Non-negative integer milliseconds, at most MESSAGING_METRICS_MAX_DURATION_MS. */
 160:   durationMs?: number;
 161:   /** Non-negative integer, at most MESSAGING_METRICS_MAX_COUNT. */
 162:   count?: number;
 163:   /** Client epoch milliseconds of the event (integer). */
 164:   occurredAt?: number;
 165: }
 166: 
 167: /** Request body of POST /api/messages/metrics. */
 168: export interface MessagingMetricsRequest {
 169:   events: MessagingMetricEventInput[];
 170: }
 171: 
 172: /** 202 response body. */
 173: export interface MessagingMetricsResponse {
 174:   accepted: number;
 175:   dropped: number;
 176: }
