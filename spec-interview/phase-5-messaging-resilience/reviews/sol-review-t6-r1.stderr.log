  95:     // Never log the error object: it could carry request data.
  96:     console.error(JSON.stringify({ event: 'messaging_metrics_failed', errorName: error instanceof Error ? 
error.name : 'unknown' }));
  97:     return NextResponse.json({ error: 'Failed to record metrics', code: 'INTERNAL_ERROR' }, { status: 500 });
  98:   }
  99: }
