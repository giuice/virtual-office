  20: function isRecord(value: unknown): value is Record<string, unknown> {
  21:   return typeof value === 'object' && value !== null;
  22: }
  23: 
  24: export function createAuthCorrelationId(): string {
  25:   return globalThis.crypto.randomUUID();
  26: }
  27: 
  28: export function getAuthErrorCode(error: unknown): string | undefined {
  29:   if (!isRecord(error)) {
  30:     return undefined;
  31:   }
  32: 
  33:   return typeof error.code === 'string' ? error.code : undefined;
  34: }
  35: 
  36: /**
  37:  * Auth metrics are intentionally process-local log events, not counters. A
  38:  * collector can aggregate them without mixing HMR workers or concurrent users.
  39:  * Production remains dormant even if VO_AUTH_METRICS is accidentally retained.
  40:  */
  41: export function recordAuthValidation(metric: AuthValidationMetric): void {
  42:   if (process.env.VO_AUTH_METRICS !== '1' || process.env.NODE_ENV === 'production') {
  43:     return;
  44:   }
  45: 
  46:   const correlationId = typeof metric.correlationId === 'string' &&
  47:     UUID_PATTERN.test(metric.correlationId)
  48:     ? metric.correlationId
  49:     : createAuthCorrelationId();
  50:   const pathname = typeof metric.pathname === 'string' &&
  51:     metric.pathname.length <= 256 &&
  52:     PATHNAME_PATTERN.test(metric.pathname) &&
  53:     !SECRET_PATTERN.test(metric.pathname)
  54:     ? metric.pathname
  55:     : '/redacted';
  56:   const authErrorCode = typeof metric.authErrorCode === 'string' &&
  57:     ERROR_CODE_PATTERN.test(metric.authErrorCode) &&
  58:     !SECRET_PATTERN.test(metric.authErrorCode)
  59:     ? metric.authErrorCode
  60:     : undefined;
  61:   const boundary: AuthBoundary = ['proxy', 'route'].includes(metric.boundary)
  62:     ? metric.boundary
  63:     : 'route';
  64:   const authMethod: AuthMethod = ['getClaims', 'getUser'].includes(metric.authMethod)
  65:     ? metric.authMethod
  66:     : 'getUser';
  67:   const authStatus: AuthStatus = ['authenticated', 'unauthenticated', 'error'].includes(
  68:     metric.authStatus
  69:   ) ? metric.authStatus : 'error';
  70: 
  71:   const event: AuthValidationMetric & { event: 'auth_validation' } = {
  72:     event: 'auth_validation' as const,
  73:     correlationId,
  74:     boundary,
  75:     pathname,
  76:     authMethod,
  77:     authStatus,
  78:   };
  79:   if (authErrorCode !== undefined) event.authErrorCode = authErrorCode;
  80:   if (typeof metric.refreshed === 'boolean') event.refreshed = metric.refreshed;
  81:   console.info(JSON.stringify(event));
