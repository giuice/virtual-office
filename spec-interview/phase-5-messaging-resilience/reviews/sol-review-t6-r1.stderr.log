  28: //     replays, lost same-key races and refused or failed creates never
  29: //     consume it; MESSAGE_INSERTION_QUOTA hands it over. Clients cannot insert
  30: //     messages directly. Phase 4 servers charge the same counter at their
  31: //     route, so both builds share one quota.
  32: //   * 'message:create-request' — REQUEST BUDGET: every authenticated create
  33: //     request (malformed bodies, validation failures, replays, quota losers
  34: //     included), charged first, in its own transaction, so it survives an
  35: //     insertion rollback. 60/60 s = 2x the insertion quota: a full quota of
  36: //     new messages plus one replay or retry each; an outbox drain of 10 items
  37: //     with one replay each uses 20.
  38: //   * 'message:fence' — FENCE BUDGET: every authenticated fence/lookup call
  39: //     plus the fence step of each generation-carrying create. 90/60 s = the
  40: //     request budget's 60 generation-carrying creates plus 30 explicit
  41: //     lookups; a drain of 10 items (create + lookup + replay each) uses 30.
  42: //   Bound on private.message_send_attempts growth: a key row is created only
  43: //   by a fence step (<= 90 per user per minute) or a committed generation-less
  44: //   keyed create (<= 30, insertion quota): <= 120 new rows per user per minute.
  45: const RATE_LIMITS = {
  46:   'message:create': { limit: 30, windowSeconds: 60, failClosed: true },
  47:   'message:create-request': { limit: 60, windowSeconds: 60, failClosed: true },
  48:   'message:react': { limit: 60, windowSeconds: 60, failClosed: false },
  49:   // Phase 4 T13: one upload per file, up to 5 files per message, plus retries
  50:   // of failed uploads; 10/min refused the second full message in a minute.
  51:   // 30/min = six 5-file messages, in line with message:create (each file is
  52:   // still capped at 10 MB and only links to the uploader's own message).
  53:   'message:upload': { limit: 30, windowSeconds: 60, failClosed: false },
  54:   // Phase 4 T12: cancelling pending uploads (composer remove/cancel).
  55:   'message:upload-cancel': { limit: 60, windowSeconds: 60, failClosed: false },
  56:   // Phase 5 T2/T3: fence/lookup of the caller's own composition key (outbox
  57:   // recovery after unknown outcomes), see the budgets above.
  58:   'message:fence': { limit: 90, windowSeconds: 60, failClosed: true },
  59:   // Visible-message receipts are batched by the drawer while it scrolls.
  60:   'conversation:read-receipts': { limit: 120, windowSeconds: 60, failClosed: false },
  61:   // Phase 5 T6 (FR-027, AC-028): messaging metric batches (<= 50 events,
  62:   // <= 16 KB each) from all of the user's tabs, charged on every
  63:   // authenticated request (oversized and malformed ones included). Bounds the
  64:   // log volume to 30 x 50 = 1500 lines per user per minute. Fail-closed: the
  65:   // client drops a refused batch, so refusing never affects messaging.
  66:   'messaging:metrics': { limit: 30, windowSeconds: 60, failClosed: true },
  67: } as const satisfies Record<string, RateLimitPolicy>;
  68: 
  69: export type RateLimitedAction = keyof typeof RATE_LIMITS;
  70: 
  71: /**
  72:  * The message insertion quota handed to the database, which charges it to
  73:  * the 'message:create' counter in the transaction of a winning insertion.
  74:  */
  75: export const MESSAGE_INSERTION_QUOTA: InsertionQuota = {
  76:   limit: RATE_LIMITS['message:create'].limit,
  77:   windowSeconds: RATE_LIMITS['message:create'].windowSeconds,
  78: };
  79: 
  80: /** 429: the user exhausted a limit (transient). */
  81: export function rateLimitExceededResponse(): NextResponse {
  82:   return jsonError(429, 'rate_limited', 'Too many requests. Please slow down.');
  83: }
  84: 
  85: /** 429: a fail-closed limit could not be checked (transient). */
  86: export function rateLimitUnavailableResponse(): NextResponse {
  87:   return jsonError(429, 'rate_limited', 'The request could not be rate checked. Please retry shortly.');
  88: }
  89: 
  90: /**
  91:  * Returns a 429 response when the user exceeded the action's limit,
  92:  * null when the request may proceed. Call AFTER authentication, with the
  93:  * authenticated user's DB id (users.id, not supabase_uid).
  94:  *
  95:  * Fail-open actions: an RPC error (e.g. migration not applied yet) is logged
  96:  * and the request is allowed — rate limiting must never take those down.
  97:  * Fail-closed actions (Phase 5 T3: message send budgets): an RPC error or an
  98:  * unexpected result refuses the request with 429.
  99:  */
 100: export async function enforceRateLimit(
 101:   serviceClient: SupabaseClient,
 102:   userDbId: string,
 103:   action: RateLimitedAction
 104: ): Promise<NextResponse | null> {
 105:   const { limit, windowSeconds, failClosed } = RATE_LIMITS[action];
 106: 
 107:   try {
 108:     const { data: allowed, error } = await serviceClient.rpc('check_rate_limit', {
 109:       p_user_id: userDbId,
 110:       p_action: action,
 111:       p_limit: limit,
 112:       p_window_seconds: windowSeconds,
 113:     });
 114: 
 115:     if (error) {
 116:       console.error(`Rate limit check failed for ${action}:`, error);
 117:       return failClosed ? rateLimitUnavailableResponse() : null;
 118:     }
 119: 
 120:     if (allowed === false) {
 121:       return rateLimitExceededResponse();
 122:     }
 123: 
 124:     if (failClosed && allowed !== true) {
 125:       console.error(`Rate limit check returned an unexpected result for ${action}:`, allowed);
 126:       return rateLimitUnavailableResponse();
 127:     }
 128: 
 129:     return null;
 130:   } catch (error) {
 131:     console.error(`Rate limit check threw for ${action}:`, error);
 132:     return failClosed ? rateLimitUnavailableResponse() : null;
 133:   }
 134: }
src/lib/auth/session.ts
   1: // src/lib/auth/session.ts
   2: import type { NextResponse } from 'next/server';
   3: import type { SupabaseClient, User as SupabaseAuthUser } from '@supabase/supabase-js';
   4: import { API_ERROR_CODES } from '@/lib/api/error-contract';
   5: import { jsonError } from '@/lib/api/server-error';
   6: import {
   7:   createAuthCorrelationId,
   8:   getAuthErrorCode,
   9:   recordAuthValidation,
  10: } from '@/lib/auth/auth-metrics';
  11: import { createSupabaseServerClient } from '@/lib/supabase/server-client';
  12: import { SupabaseUserRepository } from '@/repositories/implementations/supabase';
  13: import type { User } from '@/types/database';
  14: 
  15: type SessionResult = {
  16:   supabaseUid?: string; // Supabase Auth UID
  17:   userDbId?: string; // Database UUID (from users table)
  18:   error?: string;
  19: };
  20: 
  21: /**
  22:  * Validates the user session and returns the user ID if valid
  23:  * Handles the relationship between Supabase Auth UIDs and Database UUIDs
  24:  *
  25:  * @returns Object containing supabaseUid (Supabase Auth UID), userDbId (Database UUID), and error (if any)
  26:  */
  27: export async function validateUserSession(): Promise<SessionResult> {
  28:   try {
  29:     const supabase = await createSupabaseServerClient();
  30:     
  31:     const { data, error } = await supabase.auth.getUser();
  32:     
  33:     if (error) {
  34:       console.error('Session error:', error.message);
  35:       return { error: error.message };
  36:     }
  37:     
  38:     if (!data.user) {
  39:       return { error: 'No active session' };
  40:     }
  41:     
  42:     const supabaseUid = data.user.id; // This is the Supabase Auth UID
  43:     
  44:     // Get the database user record to fetch the database UUID
  45:     const { data: userRecord, error: userError } = await supabase
  46:       .from('users')
  47:       .select('id') // Database UUID
  48:       .eq('supabase_uid', supabaseUid) // supabase_uid column holds the Supabase Auth UID
  49:       .single();
  50:     
  51:     if (userError) {
  52:       console.error('User lookup error:', userError.message);
  53:       return { supabaseUid, error: 'User record not found' };
  54:     }
  55:     
  56:     // Return both IDs for flexible usage
  57:     return { 
  58:       supabaseUid,   // Supabase Auth UID (from auth)
  59:       userDbId: userRecord.id // Database UUID (from users table)
  60:     };
  61:     
  62:   } catch (error) {
  63:     console.error('Session validation error:', error);
  64:     return { error: 'Failed to validate session' };
  65:   }
  66: }
  67: 
  68: type RequireAuthResult =
  69:   | { supabase: SupabaseClient; dbUser: User; authUser: SupabaseAuthUser }
  70:   | { errorResponse: NextResponse };
  71: 
  72: interface RequireAuthUserOptions {
  73:   correlationId?: string;
  74:   pathname?: string;
  75:   beforeDatabaseOperation?: () => void;
  76: }
  77: 
  78: type RequireAuthUserArgument = RequireAuthUserOptions | (() => void);
  79: 
  80: function normalizeRequireAuthOptions(argument?: RequireAuthUserArgument): RequireAuthUserOptions {
  81:   return typeof argument === 'function' ? { beforeDatabaseOperation: argument } : (argument ?? {});
  82: }
  83: 
  84: export async function requireAuthUser(argument?: RequireAuthUserArgument): Promise<RequireAuthResult> {
  85:   const { correlationId: providedCorrelationId, pathname, beforeDatabaseOperation } = 
normalizeRequireAuthOptions(argument);
  86:   const correlationId = providedCorrelationId ?? createAuthCorrelationId();
  87:   let refreshed = false;
  88:   const supabase = await createSupabaseServerClient(undefined, {
  89:     onAuthCookiesSet: () => {
  90:       refreshed = true;
  91:     },
  92:   });
  93:   let authResult: Awaited<ReturnType<typeof supabase.auth.getUser>>;
  94:   try {
  95:     authResult = await supabase.auth.getUser();
  96:   } catch (error) {
  97:     recordAuthValidation({
  98:       correlationId,
  99:       boundary: 'route',
 100:       pathname: pathname ?? '/unattributed',
 101:       authMethod: 'getUser',
 102:       authStatus: 'error',
 103:       authErrorCode: getAuthErrorCode(error),
 104:       refreshed,
 105:     });
 106:     throw error;
 107:   }
 108: 
 109:   const { data, error } = authResult;
 110:   recordAuthValidation({
 111:     correlationId,
 112:     boundary: 'route',
 113:     pathname: pathname ?? '/unattributed',
 114:     authMethod: 'getUser',
 115:     authStatus: error ? 'error' : data.user ? 'authenticated' : 'unauthenticated',
 116:     authErrorCode: getAuthErrorCode(error),
 117:     refreshed,
 118:   });
 119: 
 120:   if (error || !data.user) {
 121:     const isRateLimited = error?.status === 429;
 122:     return {
 123:       errorResponse: jsonError(
 124:         isRateLimited ? 429 : 401,
 125:         isRateLimited ? API_ERROR_CODES.RATE_LIMITED : API_ERROR_CODES.UNAUTHORIZED,
 126:         isRateLimited ? 'Authentication service rate limit reached' : 'Authentication required',
 127:         { correlationId, cause: error, context: 'requireAuthUser.getUser' }
 128:       ),
 129:     };
 130:   }
 131: 
 132:   const userRepository = new SupabaseUserRepository(supabase);
 133: 
 134:   let dbUser: User | null;
 135:   try {
 136:     beforeDatabaseOperation?.();
 137:     dbUser = await userRepository.findBySupabaseUid(data.user.id);
 138:   } catch (lookupError) {
 139:     return {
 140:       errorResponse: jsonError(
 141:         500,
 142:         API_ERROR_CODES.INTERNAL_ERROR,
 143:         'Failed to load authenticated user profile',
 144:         { correlationId, cause: lookupError, context: 'requireAuthUser.profileLookup' }
 145:       ),
 146:     };
 147:   }
 148: 
 149:   if (!dbUser) {
 150:     return {
 151:       errorResponse: jsonError(
 152:         404,
 153:         API_ERROR_CODES.PROFILE_NOT_FOUND,
 154:         'Authenticated user profile not found',
 155:         { correlationId, context: 'requireAuthUser.profileLookup' }
 156:       ),
 157:     };
 158:   }
 159: 
 160:   return { supabase, dbUser, authUser: data.user };
 161: }
src/lib/supabase/server-client.ts
   1: import { createServerClient } from '@supabase/ssr'
   2: import { createClient, type SupabaseClient } from '@supabase/supabase-js'
   3: import { cookies } from 'next/headers'
   4: 
   5: interface ServerClientOptions {
   6:   onAuthCookiesSet?: () => void;
   7: }
   8: 
   9: export async function createSupabaseServerClient(
  10:   role?: 'service_role',
  11:   options: ServerClientOptions = {}
  12: ): Promise<SupabaseClient> {
  13:   // If service_role is requested, use the service role key instead of the anon key
  14:   if (role === 'service_role') {
  15:     // Make sure the SUPABASE_SERVICE_ROLE_KEY is set in your environment variables
  16:     if (!process.env.SUPABASE_SERVICE_ROLE_KEY) {
  17:       throw new Error('SUPABASE_SERVICE_ROLE_KEY is not set in environment variables')
  18:     }
  19:     
  20:     // Create a direct Supabase client with service role permissions
  21:     return createClient(
  22:       process.env.NEXT_PUBLIC_SUPABASE_URL!,
  23:       process.env.SUPABASE_SERVICE_ROLE_KEY!,
  24:       {
  25:         auth: {
  26:           autoRefreshToken: false,
  27:           persistSession: false
  28:         }
  29:       }
  30:     )
  31:   }
  32: 
  33:   const cookieStore = await cookies()
  34:   
  35:   // Regular SSR client with cookie handling
  36:   return createServerClient(
  37:     process.env.NEXT_PUBLIC_SUPABASE_URL!,
  38:     process.env.NEXT_PUBLIC_SUPABASE_ANON_KEY!,
  39:     {
  40:       cookies: {
  41:         getAll() {
  42:           // Next.js cookies() supports getAll in route handlers/server components
  43:           return cookieStore.getAll().map(({ name, value }) => ({ name, value }))
  44:         },
  45:         setAll(cookiesToSet) {
  46:           if (cookiesToSet.length > 0) {
  47:             options.onAuthCookiesSet?.();
  48:           }
  49:           try {
  50:             for (const { name, value, options } of cookiesToSet) {
  51:               cookieStore.set(name, value, options)
  52:             }
  53:           } catch {
  54:             // When called from Server Components without response context, ignore
  55:           }
  56:         },
  57:       },
  58:     }
  59:   )
  60: }
src/lib/auth/authorize.ts
   1: // src/lib/auth/authorize.ts
   2: // Single authorization gate for messaging routes (audit S-05).
   3: // Rule: every route resolves the requester, checks participation here, and only
   4: // then may use the service-role client for the mutation. RLS stays as
   5: // defense-in-depth, never the primary gate.
   6: import type { NextResponse } from 'next/server';
   7: import type { SupabaseClient } from '@supabase/supabase-js';
   8: import { jsonError } from '@/lib/api/server-error';
   9: import { createSupabaseServerClient } from '@/lib/supabase/server-client';
  10: import { requireAuthUser } from '@/lib/auth/session';
  11: import type { User } from '@/types/database';
  12: 
  13: export { jsonError } from '@/lib/api/server-error';
  14: 
  15: export interface ConversationAccess {
  16:   id: string;
  17:   type: string;
  18:   roomId: string | null;
  19: }
  20: 
  21: export interface ParticipantContext {
  22:   /** User-scoped client — use for reads so RLS still applies. */
  23:   supabase: SupabaseClient;
  24:   /** Service-role client — use ONLY for the mutation after this check passed. */
  25:   serviceClient: SupabaseClient;
  26:   dbUser: User;
  27:   conversation: ConversationAccess;
  28: }
  29: 
  30: export interface MessageParticipantContext extends ParticipantContext {
  31:   message: {
  32:     id: string;
  33:     conversationId: string;
  34:     senderId: string | null;
  35:   };
  36: }
  37: 
  38: export interface AuthzFailure {
  39:   errorResponse: NextResponse;
  40: }
  41: 
  42: export function isAuthzFailure(result: object): result is AuthzFailure {
  43:   return 'errorResponse' in result;
  44: }
  45: 
  46: async function loadConversationAccess(
  47:   serviceClient: SupabaseClient,
  48:   conversationId: string,
  49:   dbUserId: string
  50: ): Promise<{ conversation: ConversationAccess; isMember: boolean } | AuthzFailure> {
  51:   const { data: row, error } = await serviceClient
  52:     .from('conversations')
  53:     .select('id, type, room_id, conversation_members(user_id)')
  54:     .eq('id', conversationId)
  55:     .eq('conversation_members.user_id', dbUserId)
  56:     .maybeSingle();
  57: 
  58:   if (error) {
  59:     console.error('[authorize] Failed to load conversation:', error.message);
  60:     return { errorResponse: jsonError(500, 'INTERNAL_ERROR', 'Failed to load conversation') };
  61:   }
  62:   if (!row) {
  63:     return { errorResponse: jsonError(404, 'CONVERSATION_NOT_FOUND', 'Conversation not found') };
  64:   }
  65: 
  66:   const conversationMembers = Array.isArray((row as { conversation_members?: unknown }).conversation_members)
  67:     ? ((row as { conversation_members: { user_id: string }[] }).conversation_members ?? [])
  68:     : [];
  69: 
  70:   return {
  71:     conversation: {
  72:       id: row.id,
  73:       type: row.type,
  74:       roomId: row.room_id ?? null,
  75:     },
  76:     isMember: conversationMembers.length > 0,
  77:   };
  78: }
  79: 
  80: export interface ConversationParticipantOptions {
  81:   /**
  82:    * Phase 5 FR-011: the sender the client expects (users.id of its outbox
  83:    * item's owner). When the authenticated user differs, the request is refused
  84:    * with 403 SENDER_MISMATCH before the conversation is read.
  85:    */
  86:   expectedSenderId?: string;
  87:   /**
  88:    * Phase 5 BR-005: answer a missing conversation like a non-member (403
  89:    * NOT_PARTICIPANT) instead of 404, so the outcome is uniform and does not
  90:    * reveal whether a conversation exists.
  91:    */
  92:   missingConversationAsNotParticipant?: boolean;
  93: }
  94: 
  95: function notParticipant(): AuthzFailure {
  96:   return {
  97:     errorResponse: jsonError(403, 'NOT_PARTICIPANT', 'You are not a participant of this conversation'),
  98:   };
  99: }
 100: 
 101: /**
 102:  * Resolves the session and asserts the requester participates in the
 103:  * conversation. Membership authority is now conversation_members (synced from
 104:  * participants[] by DB trigger; participants[] will be removed in Phase 3).
 105:  */
 106: export async function requireConversationParticipant(
 107:   conversationId: string,
 108:   options: ConversationParticipantOptions = {}
 109: ): Promise<ParticipantContext | AuthzFailure> {
 110:   if (!conversationId || typeof conversationId !== 'string') {
 111:     return { errorResponse: jsonError(400, 'BAD_REQUEST', 'conversationId is required') };
 112:   }
 113: 
 114:   const auth = await requireAuthUser();
 115:   if ('errorResponse' in auth) {
 116:     return auth;
 117:   }
 118: 
 119:   const serviceClient = await createSupabaseServerClient('service_role');
 120:   return authorizeConversationParticipant(auth, serviceClient, conversationId, options);
 121: }
 122: 
 123: /** A requester already authenticated by requireAuthUser (auth.getUser + users.supabase_uid). */
 124: export interface AuthenticatedRequester {
 125:   supabase: SupabaseClient;
 126:   dbUser: User;
 127: }
 128: 
 129: /**
 130:  * The participation check of requireConversationParticipant for a requester
 131:  * the route already authenticated — e.g. to charge a per-user budget before
 132:  * validating the request body (Phase 5 T3).
 133:  */
 134: export async function authorizeConversationParticipant(
 135:   auth: AuthenticatedRequester,
 136:   serviceClient: SupabaseClient,
 137:   conversationId: string,
 138:   options: ConversationParticipantOptions = {}
 139: ): Promise<ParticipantContext | AuthzFailure> {
 140:   if (!conversationId || typeof conversationId !== 'string') {
 141:     return { errorResponse: jsonError(400, 'BAD_REQUEST', 'conversationId is required') };
 142:   }
 143: 
 144:   if (
 145:     options.expectedSenderId !== undefined &&
 146:     options.expectedSenderId.toLowerCase() !== auth.dbUser.id.toLowerCase()
 147:   ) {
 148:     return {
 149:       errorResponse: jsonError(403, 'SENDER_MISMATCH', 'The authenticated user is not the expected sender'),
 150:     };
 151:   }
 152: 
 153:   const access = await loadConversationAccess(serviceClient, conversationId, auth.dbUser.id);
 154:   if (isAuthzFailure(access)) {
 155:     if (options.missingConversationAsNotParticipant && access.errorResponse.status === 404) {
 156:       return notParticipant();
 157:     }
 158:     return access;
 159:   }
 160: 
 161:   if (!access.isMember) {
 162:     return notParticipant();
 163:   }
 164: 
 165:   const { conversation } = access;
 166: 
 167:   return {
 168:     supabase: auth.supabase,
 169:     serviceClient,
 170:     dbUser: auth.dbUser,
 171:     conversation,
 172:   };
 173: }
 174: 
 175: /**
 176:  * Same as requireConversationParticipant, but scoped by message — for routes
 177:  * addressed by messageId (react, pin, star, attachment access).
 178:  */
 179: export async function requireMessageParticipant(
 180:   messageId: string
 181: ): Promise<MessageParticipantContext | AuthzFailure> {
 182:   if (!messageId || typeof messageId !== 'string') {
 183:     return { errorResponse: jsonError(400, 'BAD_REQUEST', 'messageId is required') };
 184:   }
 185: 
 186:   const auth = await requireAuthUser();
 187:   if ('errorResponse' in auth) {
 188:     return auth;
 189:   }
 190: 
 191:   const serviceClient = await createSupabaseServerClient('service_role');
 192:   const { data: messageRow, error: messageError } = await serviceClient
 193:     .from('messages')
 194:     .select('id, conversation_id, sender_id')
 195:     .eq('id', messageId)
 196:     .maybeSingle();
 197: 
 198:   if (messageError) {
 199:     console.error('[authorize] Failed to load message:', messageError.message);
 200:     return { errorResponse: jsonError(500, 'INTERNAL_ERROR', 'Failed to load message') };
 201:   }
 202:   if (!messageRow) {
 203:     return { errorResponse: jsonError(404, 'MESSAGE_NOT_FOUND', 'Message not found') };
 204:   }
 205: 
 206:   const access = await loadConversationAccess(serviceClient, messageRow.conversation_id, auth.dbUser.id);
 207:   if (isAuthzFailure(access)) {
 208:     return access;
 209:   }
 210: 
 211:   if (!access.isMember) {
 212:     return {
 213:       errorResponse: jsonError(403, 'NOT_PARTICIPANT', 'You are not a participant of this conversation'),
 214:     };
 215:   }
 216: 
 217:   return {
 218:     supabase: auth.supabase,
 219:     serviceClient,
 220:     dbUser: auth.dbUser,
 221:     conversation: access.conversation,
 222:     message: {
 223:       id: messageRow.id,
 224:       conversationId: messageRow.conversation_id,
 225:       senderId: messageRow.sender_id ?? null,
 226:     },
 227:   };
 228: }

