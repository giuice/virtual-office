 152:  * reading, but the limit is always enforced on the bytes actually received,
 153:  * so a missing (chunked) or understated Content-Length cannot bypass it.
 154:  */
 155: export async function readBoundedBody(request: Request, maxBytes: number): Promise<BoundedBodyResult> {
 156:   const declared = request.headers.get('content-length');
 157:   if (declared !== null && /^\d+$/.test(declared.trim()) && Number(declared.trim()) > maxBytes) {
 158:     await request.body?.cancel().catch(() => undefined);
 159:     return { ok: false, reason: 'too_large' };
 160:   }
 161:   if (!request.body) {
 162:     return { ok: true, bytes: new Uint8Array(0) };
 163:   }
 164: 
 165:   const reader = request.body.getReader();
 166:   const chunks: Uint8Array[] = [];
 167:   let total = 0;
 168:   try {
 169:     for (;;) {
 170:       const { done, value } = await reader.read();
 171:       if (done) break;
 172:       total += value.byteLength;
 173:       if (total > maxBytes) {
 174:         await reader.cancel().catch(() => undefined);
 175:         return { ok: false, reason: 'too_large' };
 176:       }
 177:       chunks.push(value);
 178:     }
 179:   } catch {
 180:     return { ok: false, reason: 'unreadable' };
 181:   }
 182: 
 183:   const bytes = new Uint8Array(total);
 184:   let offset = 0;
 185:   for (const chunk of chunks) {
 186:     bytes.set(chunk, offset);
 187:     offset += chunk.byteLength;
 188:   }
 189:   return { ok: true, bytes };
 190: }

