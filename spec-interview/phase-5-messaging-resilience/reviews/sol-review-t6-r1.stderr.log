 107: export const config = {
 108:   matcher: [
 109:     /*
 110:      * Match all request paths except for the ones starting with:
 111:      * - _next/ (all Next.js internal/dev assets)
 112:      * - __nextjs (Next.js dev overlay frames)
 113:      * - favicon.ico (favicon file)
 114:      * - src/ (raw source-map fetches)
 115:      * - public files with an extension (images, fonts, manifests, and similar
 116:      *   assets must never spend an Auth validation)
 117:      * - api and api/** (API route handlers are the single authoritative auth
 118:      *   boundary: requireAuthUser or an equivalent direct getUser() validation
 119:      *   in the handler. Matching API routes here would also call Auth,
 120:      *   double-hitting the Auth server per request (the VO-RUNTIME-002
 121:      *   auth-request storm). Route handlers persist rotated cookies through the
 122:      *   server client's setAll (src/lib/supabase/server-client.ts), while
 123:      *   /api/auth/callback independently exchanges its OAuth code for session
 124:      *   cookies. The api(?:/|$) boundary also excludes the exact /api pathname
 125:      *   and does NOT exclude page paths like /api-docs.
 126:      *
 127:      * The proxy continues to use getUser(), rather than getClaims(), for page
 128:      * protection and cookie refresh. This project uses legacy HS256 signing:
 129:      * its JWKS endpoint returned empty keys (verified WP0.5, 2026-07-15), so
 130:      * getClaims() would fall back to a network call and provide no benefit.
 131:      */
 132:     '/((?!_next/|__nextjs|favicon.ico|src/|api(?:/|$)|.*\\.[A-Za-z0-9]+$).*)',
 133:   ],
 134: };
