   1: export type AuthBoundary = 'proxy' | 'route';
   2: export type AuthMethod = 'getClaims' | 'getUser';
   3: export type AuthStatus = 'authenticated' | 'unauthenticated' | 'error';
   4: 
   5: export interface AuthValidationMetric {
   6:   correlationId: string;
   7:   boundary: AuthBoundary;
   8:   pathname: string;
   9:   authMethod: AuthMethod;
