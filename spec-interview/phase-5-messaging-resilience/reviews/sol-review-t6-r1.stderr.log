  81:       return jsonError(413, 'METRICS_BATCH_TOO_LARGE', 'At most 50 metric events per request');
  82:     }
  83: 
  84:     const context = { now: Date.now(), appVersion: serverAppVersion() };
  85:     const lines: MessagingMetricLogLine[] = [];
