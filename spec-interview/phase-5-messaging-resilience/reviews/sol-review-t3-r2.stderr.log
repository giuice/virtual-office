 490: set local lock_timeout = '5s';
 491: 
 492: -- ============================================================================
 493: -- No client write path around the budgets: clients cannot insert messages.
 494: -- ============================================================================
 495: drop policy if exists "send_message_as_self" on public.messages;
 496: revoke insert on table public.messages from anon, authenticated;
 497: 
 498: -- ============================================================================
 499: -- Insertion-quota charge, serialized per user across windows (see header).
 500: -- ============================================================================
 501: create or replace function private.charge_message_insertion_quota(
 502:   p_user_id uuid,
 503:   p_limit integer,
 504:   p_window_seconds integer
 505: )
 506: returns boolean
 507: language plpgsql
 508: security definer
 509: set search_path = ''
 510: as $$
 511: declare
 512:   v_window_start timestamptz;
 513:   v_count integer;
 514: begin
 515:   if p_user_id is null or p_limit is null or p_window_seconds is null or p_limit < 1 or p_window_seconds < 1 then
 516:     raise exception 'INSERT_QUOTA_INVALID' using errcode = '22023';
 517:   end if;
 518: 
 519:   -- Held until commit: this user's insertion-quota charges run one at a time.
 520:   perform pg_catalog.pg_advisory_xact_lock(
 521:     pg_catalog.hashtextextended('virtual_office.message_insertion_quota:' || p_user_id::text, 0)
 522:   );
 523: 
 524:   -- The window is read after the lock from the wall clock (not the
 525:   -- transaction start), so serialized charges see non-decreasing windows.
 526:   v_window_start := pg_catalog.to_timestamp(
 527:     (pg_catalog.floor(extract(epoch from pg_catalog.clock_timestamp()) / p_window_seconds) * 
p_window_seconds)::double precision
 528:   );
 529: 
 530:   insert into private.rate_limit_counters as c (user_id, action, window_start, count)
 531:   values (p_user_id, 'message:create', v_window_start, 1)
 532:   on conflict (user_id, action, window_start)
 533:   do update set count = c.count + 1
 534:   returning count into v_count;
 535: 
 536:   -- Older windows can no longer be charged by this user's insertions (every
 537:   -- later charge is serialized behind this one and reads a later clock).
 538:   delete from private.rate_limit_counters c
 539:   where c.user_id = p_user_id
 540:     and c.action = 'message:create'
 541:     and c.window_start < v_window_start;
 542: 
 543:   return v_count <= p_limit;
 544: end
 545: $$;
