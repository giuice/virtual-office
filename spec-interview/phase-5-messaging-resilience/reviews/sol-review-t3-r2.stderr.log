 124:     throw new MessageAttemptRpcError(error);
 125:   }
 126:   if (!isRecord(data) || typeof data.message_id !== 'string' || typeof data.created !== 'boolean') {
 127:     throw new Error('create_message_attempt returned an unexpected result');
 128:   }
 129:   return {
 130:     messageId: data.message_id,
 131:     created: data.created,
 132:     storedComposition: data.created ? null : parseStoredComposition(data.composition),
 133:   };
 134: }
