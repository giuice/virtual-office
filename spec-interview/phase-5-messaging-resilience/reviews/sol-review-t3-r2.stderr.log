  84: export async function createMessageAttempt(
  85:   client: SupabaseClient,
  86:   input: CreateMessageAttemptInput
  87: ): Promise<CreateMessageAttemptResult> {
  88:   const { data, error } = await client.rpc('create_message_attempt', {
  89:     p_conversation_id: input.data.conversationId,
  90:     p_sender_id: input.data.senderId,
  91:     p_content: input.data.content,
  92:     p_type: input.data.type,
  93:     p_reply_to_id: input.data.replyToId ?? null,
  94:     p_client_message_id: input.clientMessageId ?? null,
  95:     p_attempt_generation: input.attempt?.generation ?? null,
  96:     p_composition: input.clientMessageId && input.attempt ? input.attempt.composition : null,
  97:     p_upload_ids: [...input.uploadIds],
  98:     p_insert_quota_limit: input.insertQuota?.limit ?? null,
  99:     p_insert_quota_window_seconds: input.insertQuota?.windowSeconds ?? null,
 100:   });
