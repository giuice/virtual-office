 956: comment on function public.create_message_with_attachments(uuid, uuid, text, text, uuid, uuid, uuid[]) is
 957:   'Phase 4 T12/T15 signature (kept for older builds): delegates to create_message_attempt without an attempt 
generation (Phase 5 T2, D4) and without an insertion-quota charge (Phase 5 T3: the calling Phase 4 route charges it). 
Returns {message_id, created}. Service role only.';
 958: 
 959: revoke all on function public.create_message_with_attachments(uuid, uuid, text, text, uuid, uuid, uuid[])
 960:   from public, anon, authenticated;
 961: grant execute on function public.create_message_with_attachments(uuid, uuid, text, text, uuid, uuid, uuid[])
 962:   to service_role;
