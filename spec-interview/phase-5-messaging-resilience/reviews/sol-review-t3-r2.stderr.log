 506:   async create(messageData: MessageCreateData): Promise<Message> {
 507:     const { data, error } = await this.supabaseClient
 508:       .from(this.MSG_TABLE_NAME)
 509:       .insert(toMessageInsertRow(messageData))
 510:       .select()
 511:       .single();
 512: 
 513:     if (error || !data) {
 514:       console.error('Error creating message:', error);
 515:       throw error || new Error('Failed to create message or retrieve created data.');
 516:     }
 517:     return mapCreatedMessage(data as MessageRow);
 518:   }
 519: 
 520:   // Phase 5 T3: unkeyed create in public.create_message_attempt (null key and
 521:   // generation) so the insertion quota is charged in the insertion's own
 522:   // transaction â€” a failed INSERT is never charged (migration 20261007114454).
 523:   async createUnkeyed(messageData: MessageCreateData, insertQuota: InsertionQuota): Promise<Message> {
 524:     const result = await createMessageAttempt(this.supabaseClient, {
 525:       data: messageData,
 526:       uploadIds: [],
 527:       insertQuota,
 528:     });
 529:     return this.readCreatedMessage(result.messageId);
 530:   }
 531: 
 532:   private async readCreatedMessage(messageId: string): Promise<Message> {
 533:     const { data, error } = await this.supabaseClient
 534:       .from(this.MSG_TABLE_NAME)
 535:       .select('*')
 536:       .eq('id', messageId)
 537:       .single();
 538: 
 539:     if (error || !data) {
 540:       console.error('Error reading message after create:', error);
 541:       throw error || new Error(`Message ${messageId} not found after create`);
 542:     }
 543:     return mapCreatedMessage(data as MessageRow);
 544:   }
