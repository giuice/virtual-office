 112:     }
 113:     if (error.message === 'MESSAGE_DELETED') {
 114:       throw new MessageDeletedError();
 115:     }
 116:     const linkFailure = LINK_FAILURE_CODES.find((code) => error.message === code);
 117:     if (error.code === '22023' && linkFailure) {
