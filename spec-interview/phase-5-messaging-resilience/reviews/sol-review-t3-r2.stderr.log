 136: /**
 137:  * Calls public.fence_message_attempt. Throws NotParticipantError for the
 138:  * database's explicit membership refusal and MessageAttemptRpcError for
 139:  * anything else (including grant failures).
 140:  */
 141: export async function fenceMessageAttempt(
 142:   client: SupabaseClient,
 143:   key: ClientMessageKey,
 144:   generation: number
 145: ): Promise<MessageAttemptFenceResult> {
 146:   const { data, error } = await client.rpc('fence_message_attempt', {
 147:     p_sender_id: key.senderId,
 148:     p_conversation_id: key.conversationId,
 149:     p_client_message_id: key.clientMessageId,
 150:     p_attempt_generation: generation,
 151:   });
 152: 
 153:   if (error) {
 154:     if (isMembershipRefusal(error)) {
 155:       throw new NotParticipantError();
 156:     }
 157:     console.error('Error in fence_message_attempt RPC:', error);
 158:     throw new MessageAttemptRpcError(error);
 159:   }
 160:   if (isRecord(data)) {
 161:     if (data.outcome === 'superseded' || data.outcome === 'not_stored') {
 162:       return { outcome: data.outcome };
 163:     }
 164:     if (data.outcome === 'stored' && (typeof data.message_id === 'string' || data.message_id === null)) {
 165:       return { outcome: 'stored', messageId: data.message_id };
 166:     }
 167:   }
 168:   throw new Error('fence_message_attempt returned an unexpected result');
 169: }

