 555: -- ============================================================================
 556: -- Fence / lookup: T2 body, with the explicit membership refusal marker.
 557: -- ============================================================================
 558: create or replace function public.fence_message_attempt(
 559:   p_sender_id uuid,
 560:   p_conversation_id uuid,
 561:   p_client_message_id uuid,
 562:   p_attempt_generation bigint
 563: )
 564: returns jsonb
 565: language plpgsql
 566: security invoker
 567: set search_path = ''
 568: as $$
 569: declare
 570:   v_generation bigint;
 571:   v_committed_at timestamptz;
 572:   v_message_id uuid;
 573: begin
 574:   if p_sender_id is null or p_conversation_id is null or p_client_message_id is null or p_attempt_generation is 
null then
 575:     raise exception 'fence_message_attempt: sender, conversation, key and generation are required'
 576:       using errcode = '22004';
 577:   end if;
 578:   if p_attempt_generation < 1 then
 579:     raise exception 'ATTEMPT_GENERATION_INVALID' using errcode = '22023';
 580:   end if;
 581: 
 582:   -- Defense in depth: the route already required membership.
 583:   if not exists (
 584:     select 1
 585:     from public.conversation_members cm
 586:     where cm.conversation_id = p_conversation_id
 587:       and cm.user_id = p_sender_id
 588:   ) then
 589:     -- Explicit marker (Phase 5 T3): callers map only this to NOT_PARTICIPANT.
 590:     raise exception 'NOT_PARTICIPANT' using errcode = '42501';
 591:   end if;
 592: 
 593:   insert into private.message_send_attempts (sender_id, conversation_id, client_message_id)
 594:   values (p_sender_id, p_conversation_id, p_client_message_id)
 595:   on conflict (sender_id, conversation_id, client_message_id) do nothing;
 596: 
 597:   select a.fence_generation, a.committed_at into v_generation, v_committed_at
 598:   from private.message_send_attempts a
 599:   where a.sender_id = p_sender_id
 600:     and a.conversation_id = p_conversation_id
 601:     and a.client_message_id = p_client_message_id
 602:   for update;
 603: 
 604:   if v_generation is not null and p_attempt_generation < v_generation then
 605:     return pg_catalog.jsonb_build_object('outcome', 'superseded', 'current_generation', v_generation);
 606:   end if;
 607: 
 608:   if v_generation is null or p_attempt_generation > v_generation then
 609:     update private.message_send_attempts a
 610:     set fence_generation = p_attempt_generation,
 611:         updated_at = pg_catalog.now()
 612:     where a.sender_id = p_sender_id
 613:       and a.conversation_id = p_conversation_id
 614:       and a.client_message_id = p_client_message_id;
 615:   end if;
 616: 
 617:   -- A new statement (new snapshot) after the row lock: a create that held the
 618:   -- lock has committed by now and its message is visible.
 619:   select m.id into v_message_id
 620:   from public.messages m
 621:   where m.sender_id = p_sender_id
 622:     and m.conversation_id = p_conversation_id
 623:     and m.client_message_id = p_client_message_id;
 624: 
 625:   if v_message_id is not null then
 626:     -- Delivery record, still under the key lock: a message the row does not
 627:     -- track yet (written before this migration) is recorded now, so its later
 628:     -- deletion is never reported as not stored.
 629:     update private.message_send_attempts a
 630:     set message_id = v_message_id,
 631:         committed_at = coalesce(a.committed_at, pg_catalog.now()),
 632:         composition = case when a.message_id = v_message_id then a.composition end,
 633:         updated_at = pg_catalog.now()
 634:     where a.sender_id = p_sender_id
 635:       and a.conversation_id = p_conversation_id
 636:       and a.client_message_id = p_client_message_id
 637:       and (a.message_id is distinct from v_message_id or a.committed_at is null);
 638:   end if;
 639: 
 640:   if v_message_id is not null or v_committed_at is not null then
 641:     -- message_id is null when the committed message was deleted since.
 642:     return pg_catalog.jsonb_build_object('outcome', 'stored', 'message_id', v_message_id);
 643:   end if;
 644:   return pg_catalog.jsonb_build_object('outcome', 'not_stored');
 645: end
 646: $$;
 647: 
 648: comment on function public.fence_message_attempt(uuid, uuid, uuid, bigint) is
 649:   'Phase 5 T2/T3: fence/lookup of the sender''s own client key. Returns {outcome: superseded|stored|not_stored, 
message_id (null when the stored message was deleted)}; never creates a message; makes every lower generation of the 
key unable to commit. Raises NOT_PARTICIPANT (42501) when the sender is not a member. Service role only; callers 
authorize the sender first.';
 650: 
 651: revoke all on function public.fence_message_attempt(uuid, uuid, uuid, bigint)
 652:   from public, anon, authenticated;
 653: grant execute on function public.fence_message_attempt(uuid, uuid, uuid, bigint)
 654:   to service_role;
