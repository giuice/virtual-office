 546:   // Idempotent create (Phase 4 FR-024): the composition key is unique per
 547:   // (sender_id, conversation_id) through the partial unique index
 548:   // messages_sender_conversation_client_message_id_key. Phase 5 T2: the insert
 549:   // runs in public.create_message_attempt, which returns the stored message on
 550:   // a replay or a lost same-key race, and refuses to commit a fenced attempt
 551:   // (AttemptSupersededError) â€” see migration 20261007095045. Phase 5 T3: a
 552:   // winning insertion charges insertQuota in the same transaction
 553:   // (InsertionRateLimitError, nothing stored) â€” migration 20261007114454.
 554:   async createWithClientKey(
 555:     messageData: MessageCreateData,
 556:     clientMessageId: string,
 557:     attempt: MessageAttempt | undefined,
 558:     insertQuota: InsertionQuota | null
 559:   ): Promise<MessageCreateResult> {
 560:     const result = await createMessageAttempt(this.supabaseClient, {
 561:       data: messageData,
 562:       clientMessageId,
 563:       attempt,
 564:       uploadIds: [],
 565:       insertQuota,
 566:     });
 567: 
 568:     return {
 569:       message: await this.readCreatedMessage(result.messageId),
 570:       created: result.created,
 571:       storedComposition: result.storedComposition,
 572:     };
 573:   }
