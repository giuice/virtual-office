 308:   async function withGrantFailure<T>(failure: keyof typeof GRANT_FAILURES, fn: () => Promise<T>): Promise<T> {
 309:     const [revoke, restore] = GRANT_FAILURES[failure];
 310:     await world.query(revoke);
 311:     try {
 312:       return await fn();
 313:     } finally {
 314:       await world.query(restore);
 315:     }
 316:   }
