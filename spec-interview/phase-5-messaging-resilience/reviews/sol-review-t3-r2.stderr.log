 269:   /** Waits until one backend other than the holder waits on a lock; returns its pid. */
 270:   async function waitForLockWaiter(holderPid: number): Promise<number> {
 271:     let waiter = 0;
 272:     await expect
 273:       .poll(
 274:         async () => {
 275:           const rows = await world.query<{ pid: number }>(
 276:             `select pid from pg_catalog.pg_stat_activity
 277:              where pid <> $1 and pid <> pg_backend_pid() and wait_event_type = 'Lock' and datname = 
current_database()`,
 278:             [holderPid],
 279:           );
 280:           waiter = rows.length === 1 ? rows[0].pid : 0;
 281:           return rows.length;
 282:         },
 283:         { timeout: 10_000, interval: 50 },
 284:       )
 285:       .toBe(1);
 286:     return waiter;
 287:   }
 288: 
 289:   /** Database clock position in fixed windows of `seconds`. */
 290:   async function windowPosition(seconds: number): Promise<{ index: number; offset: number }> {
 291:     const [row] = await world.query<{ index: string; offset: string }>(
 292:       `select floor(extract(epoch from clock_timestamp()) / $1)::text as index,
 293:               (extract(epoch from clock_timestamp())::numeric % $1::numeric)::text as offset`,
 294:       [seconds],
 295:     );
 296:     return { index: Number(row.index), offset: Number(row.offset) };
 297:   }
 298: 
 299:   /** Waits for the start of a window (later than window `after` when given); returns its index. */
 300:   async function waitForWindowStart(seconds: number, maxOffset: number, after = -1): Promise<number> {
 301:     for (;;) {
 302:       const { index, offset } = await windowPosition(seconds);
 303:       if (index > after && offset >= 0.1 && offset <= maxOffset) return index;
 304:       await new Promise((resolve) => setTimeout(resolve, Math.max(50, Math.ceil((seconds - offset + 0.15) * 
1000))));
 305:     }
 306:   }
