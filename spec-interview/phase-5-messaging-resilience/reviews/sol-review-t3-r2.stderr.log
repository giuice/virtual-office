 657: -- ============================================================================
 658: -- Fenced create (keyed text, unkeyed text, attachments) with the insertion
 659: -- quota charged by the winning insertion.
 660: -- ============================================================================
 661: drop function if exists public.create_message_attempt(uuid, uuid, text, text, uuid, uuid, bigint, jsonb, uuid[]);
 662: 
 663: create or replace function public.create_message_attempt(
 664:   p_conversation_id uuid,
 665:   p_sender_id uuid,
 666:   p_content text,
 667:   p_type text,
 668:   p_reply_to_id uuid,
 669:   p_client_message_id uuid,
 670:   p_attempt_generation bigint,
 671:   p_composition jsonb,
 672:   p_upload_ids uuid[],
 673:   p_insert_quota_limit integer,
 674:   p_insert_quota_window_seconds integer
 675: )
 676: returns jsonb
 677: language plpgsql
 678: security invoker
 679: set search_path = ''
 680: as $$
 681: declare
 682:   v_count integer;
 683:   v_locked integer;
 684:   v_voice integer;
 685:   v_message_id uuid;
 686:   v_new_id uuid := pg_catalog.gen_random_uuid();
 687:   v_generation bigint;
 688:   v_committed_at timestamptz;
 689:   v_quota_allowed boolean;
 690: begin
 691:   if p_conversation_id is null or p_sender_id is null or p_content is null or p_type is null then
 692:     raise exception 'create_message_attempt: conversation, sender, content and type are required'
 693:       using errcode = '22004';
 694:   end if;
 695:   if p_attempt_generation is not null and (p_client_message_id is null or p_attempt_generation < 1) then
 696:     raise exception 'ATTEMPT_GENERATION_INVALID' using errcode = '22023';
 697:   end if;
 698:   if p_composition is not null and (p_client_message_id is null or pg_catalog.jsonb_typeof(p_composition) <> 
'object') then
 699:     raise exception 'create_message_attempt: a composition needs a client key and must be an object'
 700:       using errcode = '22023';
 701:   end if;
 702:   -- Phase 5 T3: both NULL (no charge: callers that charged elsewhere) or both
 703:   -- positive.
 704:   if (p_insert_quota_limit is null) <> (p_insert_quota_window_seconds is null)
 705:      or p_insert_quota_limit < 1
 706:      or p_insert_quota_window_seconds < 1 then
 707:     raise exception 'INSERT_QUOTA_INVALID' using errcode = '22023';
 708:   end if;
 709: 
 710:   v_count := coalesce(pg_catalog.cardinality(p_upload_ids), 0);
 711:   -- Same bound as the route's attachment policy (5 per message).
 712:   if v_count > 5 then
 713:     raise exception 'ATTACHMENT_COUNT_INVALID' using errcode = '22023';
 714:   end if;
 715:   if v_count > 0 then
 716:     if (select pg_catalog.count(distinct u) from pg_catalog.unnest(p_upload_ids) as u) <> v_count then
 717:       raise exception 'ATTACHMENT_DUPLICATE' using errcode = '22023';
 718:     end if;
 719:     -- Attachment messages are typed image or file (the only types allowed to
 720:     -- carry empty content).
 721:     if p_type not in ('image', 'file') then
 722:       raise exception 'create_message_attempt: type must be image or file'
 723:         using errcode = '22023';
 724:     end if;
 725:   end if;
 726: 
 727:   -- Defense in depth: the route already required membership.
 728:   if not exists (
 729:     select 1
 730:     from public.conversation_members cm
 731:     where cm.conversation_id = p_conversation_id
 732:       and cm.user_id = p_sender_id
 733:   ) then
 734:     -- Explicit marker (Phase 5 T3): callers map only this to NOT_PARTICIPANT.
 735:     raise exception 'NOT_PARTICIPANT' using errcode = '42501';
 736:   end if;
 737: 
 738:   -- Replay of a key whose create already committed: answer with the stored
 739:   -- message and link nothing (its uploads were consumed by the first create).
 740:   -- Checked before the reply target: an unchanged replay is compared against
 741:   -- the original composition, not re-validated (FR-024), so a reply target
 742:   -- deleted since does not turn it into a refusal. Not an insertion: the
 743:   -- insertion quota is not charged (Phase 5 T3, D1).
 744:   if p_client_message_id is not null then
 745:     select m.id into v_message_id
 746:     from public.messages m
 747:     where m.sender_id = p_sender_id
 748:       and m.conversation_id = p_conversation_id
 749:       and m.client_message_id = p_client_message_id;
 750:     if v_message_id is not null then
 751:       return private.message_attempt_replay(
 752:         p_sender_id, p_conversation_id, p_client_message_id, p_attempt_generation, v_message_id);
 753:     end if;
 754:   end if;
 755: 
 756:   -- A reply target must be a message of the same conversation.
 757:   if p_reply_to_id is not null and not exists (
 758:     select 1
 759:     from public.messages r
 760:     where r.id = p_reply_to_id
 761:       and r.conversation_id = p_conversation_id
 762:   ) then
 763:     raise exception 'INVALID_REPLY_TARGET' using errcode = '22023';
 764:   end if;
 765: 
 766:   if v_count > 0 then
 767:     -- Lock the caller's pending uploads for this conversation (id order avoids
 768:     -- deadlocks between overlapping sets). A concurrent cancel or link of the
 769:     -- same upload waits here; once it commits the row is gone.
 770:     select pg_catalog.count(*), pg_catalog.count(*) filter (where locked.duration is not null)
 771:     into v_locked, v_voice
 772:     from (
 773:       select u.id, u.duration
 774:       from public.message_attachment_uploads u
 775:       where u.id = any (p_upload_ids)
 776:         and u.uploader_id = p_sender_id
 777:         and u.conversation_id = p_conversation_id
 778:       order by u.id
 779:       for update
 780:     ) as locked;
 781: 
 782:     if v_locked <> v_count then
 783:       -- A concurrent create with the same key may have consumed them.
 784:       if p_client_message_id is not null then
 785:         select m.id into v_message_id
 786:         from public.messages m
 787:         where m.sender_id = p_sender_id
 788:           and m.conversation_id = p_conversation_id
 789:           and m.client_message_id = p_client_message_id;
 790:         if v_message_id is not null then
 791:           return private.message_attempt_replay(
 792:             p_sender_id, p_conversation_id, p_client_message_id, p_attempt_generation, v_message_id);
 793:         end if;
 794:       end if;
 795:       -- Unknown, foreign, other-conversation, cancelled, or already linked.
 796:       raise exception 'ATTACHMENT_UPLOAD_NOT_FOUND' using errcode = '22023';
 797:     end if;
 798: 
 799:     -- Phase 4 T15: a voice note is the only attachment of its message, which
 800:     -- is typed file.
 801:     if v_voice > 0 and v_count > 1 then
 802:       raise exception 'VOICE_NOTE_NOT_ALONE' using errcode = '22023';
 803:     end if;
 804:     if v_voice > 0 and p_type <> 'file' then
 805:       raise exception 'create_message_attempt: a voice note message must be typed file'
 806:         using errcode = '22023';
 807:     end if;
 808:   end if;
 809: 
 810:   -- This INSERT is checked below (commit-time fence check); the
 811:   -- messages_keyed_insert_fence trigger recognizes it by its pre-generated id
 812:   -- and leaves it to this function. Any other keyed insert is checked by the
 813:   -- trigger itself.
 814:   perform pg_catalog.set_config('virtual_office.create_message_attempt_id', v_new_id::text, true);
 815:   insert into public.messages (id, conversation_id, sender_id, content, type, status, reply_to_id, 
client_message_id)
 816:   values (
 817:     v_new_id,
 818:     p_conversation_id,
 819:     p_sender_id,
 820:     p_content,
 821:     p_type::public.message_type,
 822:     'sent'::public.message_status,
 823:     p_reply_to_id,
 824:     p_client_message_id
 825:   )
 826:   on conflict (sender_id, conversation_id, client_message_id) where client_message_id is not null
 827:   do nothing
 828:   returning id into v_message_id;
 829:   perform pg_catalog.set_config('virtual_office.create_message_attempt_id', '', true);
 830: 
 831:   if v_message_id is null then
 832:     -- Lost the race on the same key: the winner's message is committed. Not
 833:     -- an insertion: the insertion quota is not charged.
 834:     select m.id into v_message_id
 835:     from public.messages m
 836:     where m.sender_id = p_sender_id
 837:       and m.conversation_id = p_conversation_id
 838:       and m.client_message_id = p_client_message_id;
 839:     return private.message_attempt_replay(
 840:       p_sender_id, p_conversation_id, p_client_message_id, p_attempt_generation, v_message_id);
 841:   end if;
 842: 
 843:   if v_count > 0 then
 844:     insert into public.message_attachments (id, message_id, name, type, size, url, duration, waveform_data)
 845:     select u.id, v_message_id, u.name, u.type, u.size, u.storage_path, u.duration, u.waveform_data
 846:     from public.message_attachment_uploads u
 847:     where u.id = any (p_upload_ids);
 848: 
 849:     delete from public.message_attachment_uploads u
 850:     where u.id = any (p_upload_ids);
 851:   end if;
 852: 
 853:   -- Commit-time fence check (see the T2 migration header): lock the key row
 854:   -- only now, after the INSERT, and hold it until commit.
 855:   if p_client_message_id is not null then
 856:     insert into private.message_send_attempts (sender_id, conversation_id, client_message_id)
 857:     values (p_sender_id, p_conversation_id, p_client_message_id)
 858:     on conflict (sender_id, conversation_id, client_message_id) do nothing;
 859: 
 860:     select a.fence_generation, a.committed_at into v_generation, v_committed_at
 861:     from private.message_send_attempts a
 862:     where a.sender_id = p_sender_id
 863:       and a.conversation_id = p_conversation_id
 864:       and a.client_message_id = p_client_message_id
 865:     for update;
 866: 
 867:     if v_generation is not null and (p_attempt_generation is null or p_attempt_generation < v_generation) then
 868:       raise exception 'ATTEMPT_SUPERSEDED' using errcode = 'P0001';
 869:     end if;
 870:     -- Our INSERT succeeded, so no message holds the key now: a commit
 871:     -- recorded earlier means that message was deleted.
 872:     if p_attempt_generation is not null and v_committed_at is not null then
 873:       raise exception 'MESSAGE_DELETED' using errcode = 'P0001';
 874:     end if;
 875: 
 876:     update private.message_send_attempts a
 877:     set fence_generation = case
 878:           when p_attempt_generation is null then a.fence_generation
 879:           else greatest(coalesce(a.fence_generation, 0), p_attempt_generation)
 880:         end,
 881:         committed_at = pg_catalog.now(),
 882:         message_id = v_message_id,
 883:         composition = p_composition,
 884:         updated_at = pg_catalog.now()
 885:     where a.sender_id = p_sender_id
 886:       and a.conversation_id = p_conversation_id
 887:       and a.client_message_id = p_client_message_id;
 888:   end if;
