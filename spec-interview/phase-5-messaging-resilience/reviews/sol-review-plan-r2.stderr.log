 10: export default {
 11:   HEADER_LENGTH: 1,
 12:   META_LENGTH: 4,
 13:   KINDS: {push: 0, reply: 1, broadcast: 2},
 14: 
 15:   /**
 16:   * @template T
 17:   * @param {Message<Record<string, any>>} msg
 18:   * @param {(msg: ArrayBuffer | string) => T} callback
 19:   * @returns {T}
 20:   */
 21:   encode(msg, callback){
 22:     if(msg.payload.constructor === ArrayBuffer){
 23:       return callback(this.binaryEncode(msg))
 24:     } else {
 25:       let payload = [msg.join_ref, msg.ref, msg.topic, msg.event, msg.payload]
 26:       return callback(JSON.stringify(payload))
 27:     }
 28:   },
 29: 
 30:   /**
 31:   * @template T
 32:   * @param {ArrayBuffer | string} rawPayload
 33:   * @param {(msg: Message<unknown>) => T} callback
 34:   * @returns {T}
 35:   */
 36:   decode(rawPayload, callback){
 37:     if(rawPayload.constructor === ArrayBuffer){
 38:       return callback(this.binaryDecode(rawPayload))
 39:     } else {
 40:       let [join_ref, ref, topic, event, payload] = JSON.parse(rawPayload)
 41:       return callback({join_ref, ref, topic, event, payload})
 42:     }
 43:   },
 44: 
 45:   /** @private */
 46:   binaryEncode(message){
 47:     let {join_ref, ref, event, topic, payload} = message
 48:     let encoder = new TextEncoder()
 49:     let joinRefBytes = encoder.encode(join_ref)
 50:     let refBytes = encoder.encode(ref)
 51:     let topicBytes = encoder.encode(topic)
 52:     let eventBytes = encoder.encode(event)
 53: 
 54:     this.assertFieldSize(joinRefBytes.byteLength, "join_ref")
 55:     this.assertFieldSize(refBytes.byteLength, "ref")
 56:     this.assertFieldSize(topicBytes.byteLength, "topic")
 57:     this.assertFieldSize(eventBytes.byteLength, "event")
 58: 
 59:     let metaLength = this.META_LENGTH + joinRefBytes.byteLength + refBytes.byteLength + topicBytes.byteLength + 
eventBytes.byteLength
 60:     let header = new ArrayBuffer(this.HEADER_LENGTH + metaLength)
 61:     let headerBytes = new Uint8Array(header)
 62:     let view = new DataView(header)
 63:     let offset = 0
 64: 
 65:     view.setUint8(offset++, this.KINDS.push) // kind
 66:     view.setUint8(offset++, joinRefBytes.byteLength)
 67:     view.setUint8(offset++, refBytes.byteLength)
 68:     view.setUint8(offset++, topicBytes.byteLength)
 69:     view.setUint8(offset++, eventBytes.byteLength)
 70:     headerBytes.set(joinRefBytes, offset); offset += joinRefBytes.byteLength
 71:     headerBytes.set(refBytes, offset); offset += refBytes.byteLength
 72:     headerBytes.set(topicBytes, offset); offset += topicBytes.byteLength
 73:     headerBytes.set(eventBytes, offset); offset += eventBytes.byteLength
 74: 
 75:     var combined = new Uint8Array(header.byteLength + payload.byteLength)
 76:     combined.set(headerBytes, 0)
 77:     combined.set(new Uint8Array(payload), header.byteLength)
 78: 
 79:     return combined.buffer
 80:   },
 81: 
 82:   assertFieldSize(size, name){
 83:     if(size > 255){
 84:       throw new Error(`unable to convert ${name} to binary: must be less than or equal to 255 bytes, but is 
${size} bytes`)
 85:     }
 86:   },
 87: 
 88:   /**
 89:   * @private
 90:   */
 91:   binaryDecode(buffer){
 92:     let view = new DataView(buffer)
 93:     let kind = view.getUint8(0)
 94:     let decoder = new TextDecoder()
 95:     switch(kind){
 96:       case this.KINDS.push: return this.decodePush(buffer, view, decoder)
 97:       case this.KINDS.reply: return this.decodeReply(buffer, view, decoder)
 98:       case this.KINDS.broadcast: return this.decodeBroadcast(buffer, view, decoder)
 99:     }
100:   },
101: 
102:   /** @private */
103:   decodePush(buffer, view, decoder){
104:     let joinRefSize = view.getUint8(1)
105:     let topicSize = view.getUint8(2)
106:     let eventSize = view.getUint8(3)
107:     let offset = this.HEADER_LENGTH + this.META_LENGTH - 1 // pushes have no ref
108:     let joinRef = decoder.decode(buffer.slice(offset, offset + joinRefSize))
109:     offset = offset + joinRefSize
110:     let topic = decoder.decode(buffer.slice(offset, offset + topicSize))

