1: // src/app/api/messages/fence/route.ts
2: import { NextRequest, NextResponse } from 'next/server';
3: import { IMessageRepository, NotParticipantError } from '@/repositories/interfaces';
4: import { SupabaseMessageRepository } from '@/repositories/implementations/supabase';
5: import { authorizeConversationParticipant, isAuthzFailure, jsonError } from '@/lib/auth/authorize';
6: import { enforceRateLimit } from '@/lib/auth/rate-limit';
7: import { requireAuthUser } from '@/lib/auth/session';
8: import { createSupabaseServerClient } from '@/lib/supabase/server-client';
9: import {
10:   attemptSupersededResponse,
11:   isUuid,
12:   parseAttemptGeneration,
13:   parseExpectedSenderId,
14: } from '@/lib/messaging/message-attempts';
15: 
16: /**
17:  * POST /api/messages/fence — Phase 5 T2 (FR-006, FR-011, FR-034, BR-001,
18:  * BR-005; SPEC section 12): fence/lookup of the CALLER'S OWN composition key.
19:  * Body: { conversationId, clientMessageId, attemptGeneration, expectedSenderId }
20:  * (all required). The key is always scoped to the authenticated sender
21:  * (users.id resolved from the session), so another user's key is never read
22:  * or changed: it is simply a different (empty) key of the caller.
23:  *
24:  * 200 { outcome: 'stored', clientMessageId, attemptGeneration, message } — the
25:  *     key's message is committed (the item resolves as delivered); `message`
26:  *     is null when it was committed and has been deleted since;
27:  * 200 { outcome: 'not_stored', clientMessageId, attemptGeneration } — nothing
28:  *     is stored and no attempt older than attemptGeneration can commit any more;
29:  * 409 ATTEMPT_SUPERSEDED — a newer generation exists (nothing changed);
30:  * 403 SENDER_MISMATCH (expectedSenderId is not the authenticated user; nothing
31:  *     fenced), 403 NOT_PARTICIPANT (incl. a missing conversation), 401 when not
32:  *     signed in, 400 for malformed fields, 429 when rate limited.
33:  * Never creates a message.
34:  *
35:  * Phase 5 T3 (FR-008): authenticated first (401, nobody charged); every
36:  * authenticated call — malformed ones included — then consumes the caller's
37:  * fence budget ('message:fence', shared with the fence step of
38:  * generation-carrying creates). Exhausted, or not checkable (fail-closed):
39:  * 429 `rate_limited`.
40:  */
41: export async function POST(request: NextRequest) {
42:   try {
43:     const auth = await requireAuthUser();
44:     if ('errorResponse' in auth) {
45:       return auth.errorResponse;
46:     }
47:     const serviceClient = await createSupabaseServerClient('service_role');
48:     const overFenceBudget = await enforceRateLimit(serviceClient, auth.dbUser.id, 'message:fence');
49:     if (overFenceBudget) {
50:       return overFenceBudget;
51:     }
52: 
53:     let body: Record<string, unknown>;
54:     try {
55:       body = await request.json();
56:     } catch {
57:       return jsonError(400, 'BAD_REQUEST', 'Invalid JSON payload');
58:     }
59:     if (typeof body !== 'object' || body === null || Array.isArray(body)) {
60:       return jsonError(400, 'BAD_REQUEST', 'Invalid JSON payload');
61:     }
62: 
63:     if (!isUuid(body.conversationId)) {
64:       return jsonError(400, 'BAD_REQUEST', 'conversationId must be a UUID');
65:     }
66:     const conversationId = body.conversationId.toLowerCase();
67:     if (!isUuid(body.clientMessageId)) {
68:       return jsonError(400, 'INVALID_CLIENT_MESSAGE_ID', 'clientMessageId must be a UUID');
69:     }
70:     const clientMessageId = body.clientMessageId.toLowerCase();
71:     if (body.attemptGeneration === undefined || body.attemptGeneration === null) {
72:       return jsonError(400, 'INVALID_ATTEMPT_GENERATION', 'attemptGeneration is required');
73:     }
74:     const attemptGeneration = parseAttemptGeneration(body.attemptGeneration, true);
75:     if (!attemptGeneration.ok) {
76:       return attemptGeneration.response;
77:     }
78:     const generation = attemptGeneration.value as number;
79:     const expectedSenderId = parseExpectedSenderId(body.expectedSenderId, true);
80:     if (!expectedSenderId.ok) {
81:       return expectedSenderId.response;
82:     }
83: 
84:     const ctx = await authorizeConversationParticipant(auth, serviceClient, conversationId, {
85:       expectedSenderId: expectedSenderId.value,
86:       missingConversationAsNotParticipant: true,
87:     });
88:     if (isAuthzFailure(ctx)) {
89:       return ctx.errorResponse;
90:     }
91:     const { dbUser, conversation } = ctx;
92: 
93:     const messageRepository: IMessageRepository = new SupabaseMessageRepository(serviceClient);
94:     let fence;
95:     try {
96:       fence = await messageRepository.fenceClientMessage(
97:         { senderId: dbUser.id, conversationId: conversation.id, clientMessageId },
98:         generation
99:       );
100:     } catch (error) {
101:       // Only the database's explicit membership refusal is a 403; a grant or
102:       // other infrastructure failure answers 500 (recoverable).
103:       if (error instanceof NotParticipantError) {
104:         return jsonError(403, 'NOT_PARTICIPANT', 'You are not a participant of this conversation');
105:       }
106:       throw error;
107:     }
108: 
109:     if (fence.outcome === 'superseded') {
110:       return attemptSupersededResponse();
111:     }
112:     if (fence.outcome === 'not_stored') {
113:       return NextResponse.json(
114:         { outcome: 'not_stored', clientMessageId, attemptGeneration: generation },
115:         { status: 200 }
116:       );
117:     }
118: 
119:     const stored = fence.messageId ? await messageRepository.findById(fence.messageId) : null;
120:     if (!stored) {
121:       // Committed under the key and deleted since: delivered, never resent.
122:       return NextResponse.json(
123:         { outcome: 'stored', clientMessageId, attemptGeneration: generation, message: null },
124:         { status: 200 }
125:       );
126:     }
127:     return NextResponse.json(
128:       {
129:         outcome: 'stored',
130:         clientMessageId,
131:         attemptGeneration: generation,
132:         // Not other users' pins or stars, which findById (service client) loads.
133:         message: { ...stored, pins: undefined, stars: undefined, clientMessageId },
134:       },
135:       { status: 200 }
136:     );
137:   } catch (error) {
138:     console.error('Error fencing message attempt:', error);
139:     return jsonError(500, 'INTERNAL_ERROR', 'Failed to fence message attempt');
140:   }
141: }


src/app/api/messages/get/route.ts
1: // src/app/api/messages/get/route.ts
2: import { NextRequest, NextResponse } from 'next/server';
3: import { Message } from '@/types/messaging';
4: import { IMessageRepository } from '@/repositories/interfaces';
5: import { SupabaseMessageRepository } from '@/repositories/implementations/supabase';
6: import { PaginationOptions, PaginatedResult } from '@/types/common'; // Assuming path
7: import { isAuthzFailure, requireConversationParticipant } from '@/lib/auth/authorize';
8: 
9: export async function GET(request: NextRequest) {
10:   try {
11:     // Get query parameters
12:     const { searchParams } = new URL(request.url);
13:     const conversationId = searchParams.get('conversationId');
14:     const limit = parseInt(searchParams.get('limit') || '20', 10);
15:     const cursorBefore = searchParams.get('cursorBefore');
16:     const cursorAfter = searchParams.get('cursorAfter');
17: 
18:     // Validate required parameters
19:     if (!conversationId) {
20:       return NextResponse.json(
21:         { error: 'conversationId is required' },
22:         { status: 400 }
23:       );
24:     }
25: 
26:     // Validate limit range
27:     if (limit < 1 || limit > 100) {
28:       return NextResponse.json(
29:         { error: 'limit must be between 1 and 100' },
30:         { status: 400 }
31:       );
32:     }
33: 
34:     const ctx = await requireConversationParticipant(conversationId);
35:     if (isAuthzFailure(ctx)) {
36:       return ctx.errorResponse;
37:     }
38: 
39:     const messageRepository: IMessageRepository = new SupabaseMessageRepository(ctx.supabase);
40:     const paginationOptions: PaginationOptions = {
41:       limit,
42:       cursorBefore: cursorBefore || undefined,
43:       cursorAfter: cursorAfter || undefined,
44:     };
45: 
46:     const result: PaginatedResult<Message> = await messageRepository.findByConversation(
47:       conversationId,
48:       paginationOptions
49:     );
50: 
51:     // Audit M-03: the repository already fetches limit + 1 and computes
52:     // hasMore plus a composite (timestamp, id) cursor — no probe query.
53:     // nextCursorBefore is only set when older messages actually exist, so the
54:     // client's hasNextPage matches reality.
55:     const isPagingNewer = Boolean(cursorAfter);
56:     const hasMoreOlder = !isPagingNewer && result.hasMore;
57:     const nextCursorBefore =
58:       hasMoreOlder && typeof result.nextCursor === 'string' ? result.nextCursor : undefined;
59: 
60:     // Phase 4 FR-003: reader counts are sender-only. Another member's
61:     // message never carries one (RLS would only have let the viewer count
62:     // their own receipt anyway). Phase 5 FR-034: the composition key
63:     // (clientMessageId) is echoed only to its sender, who matches pending
64:     // messages with it. Not a confidentiality boundary: members can read the
65:     // column (RLS, Realtime payloads); a key grants nothing, since create and
66:     // fence act only on the caller's own (sender, conversation, key).
67:     const viewerId = ctx.dbUser.id;
68:     const messages = result.items.map((message) =>
69:       message.senderId === viewerId
70:         ? message
71:         : { ...message, readCount: undefined, clientMessageId: undefined }
72:     );
73: 
74:     return NextResponse.json({
75:       messages,
76:       nextCursorBefore,
77:       hasMoreOlder,
78:     });
79:   } catch (error) {
80:     console.error('Error getting messages:', error);
81:     return NextResponse.json(
82:       { error: 'Failed to retrieve messages' },
83:       { status: 500 }
84:     );
85:   }
86: }


