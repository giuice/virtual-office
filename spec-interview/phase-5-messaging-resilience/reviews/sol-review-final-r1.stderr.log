245: /**
246:  * Block A fix F4: a success of `generation` may remove its item unless the
247:  * item is now claimed by another holder at a newer generation (that holder
248:  * removes it). The server keeps at most one stored message per key either way.
249:  */
250: const confirmedRemovable = (item: OutboxItem, claimHolder: string, generation: number): boolean =>
251:   !(item.state === 'claimed' && item.claimHolder !== claimHolder && item.attemptGeneration > generation);
252: 
253: /**
254:  * Removes an item the server confirmed under `generation` (see
255:  * confirmedRemovable). Relaxed durability: if the removal were lost (OS
256:  * crash), the item would only be fenced under a newer generation and
257:  * resolved as the already stored message.
258:  */
259: export async function deleteConfirmedOutboxItem(
260:   ownerId: string,
261:   clientMessageId: string,
262:   claimHolder: string,
263:   generation: number
264: ): Promise<void> {
265:   await updateOutboxItem(ownerId, clientMessageId, (item) =>
266:     confirmedRemovable(item, claimHolder, generation) ? null : undefined
267:   );
268: }
