930: begin
931:   if p_conversation_id is null or p_user_id is null then
932:     raise exception 'restore_conversation_membership: conversation and user are required' using errcode = '22004';
933:   end if;
934: 
935:   select c.* into v_conversation
936:   from public.conversations c
937:   where c.id = p_conversation_id;
938:   if not found then
939:     raise exception 'CONVERSATION_NOT_FOUND' using errcode = 'P0002';
940:   end if;
941:   if exists (
942:     select 1
943:     from public.conversation_members cm
944:     where cm.conversation_id = p_conversation_id
945:       and cm.user_id = p_user_id
946:   ) then
947:     return false;
948:   end if;
949:   v_type := v_conversation.type;
950:   v_room_id := v_conversation.room_id;
951: 
952:   if v_type = 'room'::public.conversation_type then
953:     if v_room_id is null then
954:       raise exception 'ROOM_NOT_FOUND' using errcode = 'P0002';
955:     end if;
956:     perform private.authorize_room_membership(array[p_user_id], v_room_id);
957:   else
958:     perform 1 from public.users u where u.id = p_user_id for share;
959:     if not found then
960:       raise exception 'USER_NOT_FOUND' using errcode = 'P0002';
961:     end if;
962:   end if;
963: 
964:   select c.* into v_conversation
965:   from public.conversations c
966:   where c.id = p_conversation_id
967:   for no key update;
968:   if not found then
969:     raise exception 'CONVERSATION_NOT_FOUND' using errcode = 'P0002';
970:   end if;
971:   if v_conversation.type is distinct from v_type
