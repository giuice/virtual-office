461:   if p_space_id is null or p_user_ids is null or pg_catalog.cardinality(p_user_ids) = 0 then
462:     raise exception 'ROOM_NOT_FOUND' using errcode = 'P0002';
463:   end if;
464: 
465:   select pg_catalog.count(*) into v_count
466:   from (
467:     select u.id
468:     from public.users u
469:     where u.id = any (p_user_ids)
470:     order by u.id
471:     for share
472:   ) as locked;
473:   if v_count <> (select pg_catalog.count(distinct x) from pg_catalog.unnest(p_user_ids) as t(x) where x is not 
null)
