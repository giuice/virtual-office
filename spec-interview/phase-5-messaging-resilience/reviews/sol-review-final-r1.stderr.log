497:       if (mode === 'error') {
498:         // The request reaches the real route; its answer is lost and a gateway 500 arrives instead.
499:         await route.fetch().catch(() => null);
500:         await route.fulfill({ status: 500, contentType: 'application/json', body: '{"error":"Failed to record 
metrics","code":"INTERNAL_ERROR"}' });
501:       } else if (mode === 'hang') {
502:         await new Promise<void>((resolve) => held.push(resolve));
503:         await route.abort().catch(() => undefined);
504:       } else {
505:         await route.continue();
506:       }
507:     });
508:     await openConversation(a.page, directId);
509:     await waitForRealtimeReady(a.page);
