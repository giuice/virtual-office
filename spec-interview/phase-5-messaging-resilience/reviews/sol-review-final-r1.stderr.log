838:   if p_conversation_id is null or p_user_id is null then
839:     raise exception 'join_room_conversation: conversation and user are required' using errcode = '22004';
840:   end if;
841: 
842:   -- Unlocked read: a current member is answered without any lock (no grant).
843:   select c.* into v_conversation
844:   from public.conversations c
845:   where c.id = p_conversation_id;
846:   if not found then
847:     raise exception 'CONVERSATION_NOT_FOUND' using errcode = 'P0002';
848:   end if;
849:   if exists (
850:     select 1
851:     from public.conversation_members cm
852:     where cm.conversation_id = p_conversation_id
853:       and cm.user_id = p_user_id
