200: /**
201:  * Reads the item and replaces it with `change(item)` in one transaction
202:  * (`null` deletes it; `undefined` leaves it). Resolves with the stored result
203:  * (`null` when the item is missing or was deleted). A result with another
204:  * `clientMessageId` replaces the item under that new key (T9: the
205:  * CLIENT_MESSAGE_ID_REUSED retry); the new key must not exist yet. Relaxed
206:  * durability (the writes after a claim: losing one to an OS crash leaves the
207:  * item claimed, so it is fenced before anything is sent again), unless
208:  * `strict` is asked (a cancel must survive an OS crash: a cancelled item is
209:  * never dispatched, T10).
210:  */
211: export function updateOutboxItem(
212:   ownerId: string,
213:   clientMessageId: string,
214:   change: (item: OutboxItem) => OutboxItem | null | undefined,
215:   durability: 'strict' | 'relaxed' = 'relaxed'
216: ): Promise<OutboxItem | null> {
217:   return inTransaction<OutboxItem | null>('readwrite', ({ items }, done) => {
218:     const request = items.get([ownerId, clientMessageId]);
219:     request.onsuccess = () => {
220:       const item = request.result as OutboxItem | undefined;
221:       if (!item) {
222:         done(null);
223:         return;
224:       }
225:       const next = change(item);
226:       if (next === undefined) {
227:         done(item);
228:       } else if (next === null) {
229:         items.delete([ownerId, clientMessageId]);
230:         done(null);
231:       } else if (next.ownerId !== ownerId) {
232:         throw new Error('An outbox item cannot change owner');
233:       } else if (next.clientMessageId !== clientMessageId) {
234:         items.delete([ownerId, clientMessageId]);
235:         items.add(next);
236:         done(next);
237:       } else {
238:         items.put(next);
239:         done(next);
240:       }
241:     };
242:   }, durability);
243: }
