123: interface MetricsRequest {
124:   startedAt: number;
125:   endedAt?: number;
126:   status?: number;
127:   failure?: string;
128:   body: string;
129: }
130: 
131: /** A's metric deliveries as the page issues them, with how many were in flight at once. */
132: function trackMetricsRequests(page: Page): { requests: MetricsRequest[]; maxInFlight(): number } {
133:   const requests: MetricsRequest[] = [];
134:   const byRequest = new Map<Request, MetricsRequest>();
135:   let inFlight = 0;
136:   let maxInFlight = 0;
137:   const end = (request: Request, update: Partial<MetricsRequest>) => {
138:     const record = byRequest.get(request);
139:     if (!record || record.endedAt !== undefined) return;
140:     Object.assign(record, update, { endedAt: Date.now() });
141:     inFlight -= 1;
142:   };
143:   page.on('request', (request) => {
144:     if (request.method() !== 'POST' || new URL(request.url()).pathname !== METRICS_PATH) return;
145:     const record: MetricsRequest = { startedAt: Date.now(), body: request.postData() ?? '' };
146:     requests.push(record);
147:     byRequest.set(request, record);
148:     inFlight += 1;
149:     maxInFlight = Math.max(maxInFlight, inFlight);
150:   });
151:   // A route-fulfilled answer is reported by 'response' (its headers arrived: the request is answered).
152:   page.on('response', (response) => end(response.request(), { status: response.status() }));
153:   page.on('requestfailed', (request) => end(request, { failure: request.failure()?.errorText ?? 'failed' }));
154:   return { requests, maxInFlight: () => maxInFlight };
155: }
156: 
157: /** Each delivered batch: ≤ 50 events, ≤ 16 KB, only contract fields. */
158: function expectBatchesWithinContract(requests: readonly MetricsRequest[]): void {
159:   for (const request of requests) {
160:     expect(Buffer.byteLength(request.body, 'utf8')).toBeLessThanOrEqual(MAX_BATCH_BYTES);
161:     const { events } = JSON.parse(request.body) as { events: Array<Record<string, unknown>> };
162:     expect(events.length).toBeGreaterThan(0);
163:     expect(events.length).toBeLessThanOrEqual(MAX_BATCH_EVENTS);
164:     for (const event of events) {
165:       expect(Object.keys(event).filter((key) => !METRIC_EVENT_KEYS.has(key))).toEqual([]);
166:       expect(METRIC_TYPES.has(String(event.type))).toBe(true);
167:     }
168:   }
169: }
