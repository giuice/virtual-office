448: /** Another tab completed a sign-in as C through a server response: the cookies are C's; no tab is told. */
449: async function switchAuthCookies(context: BrowserContext, cookies: Cookie[]): Promise<void> {
450:   await context.clearCookies({ name: AUTH_COOKIE });
451:   await context.addCookies(cookies);
452: }


