421:     ) => {
422:       if (payload.eventType === 'INSERT' && payload.new) {
423:         const { message_id: messageId, user_id: userId, emoji } = payload.new;
424:         // Only a well-formed reaction row reaches the cache.
425:         if (typeof messageId !== 'string' || typeof userId !== 'string' || typeof emoji !== 'string' || !emoji) {
426:           return;
427:         }
428:         const timestampValue = payload.new.created_at ?? payload.new.timestamp;
429:         const parsed = typeof timestampValue === 'string' ? new Date(timestampValue) : null;
430:         const timestamp = parsed && !Number.isNaN(parsed.getTime()) ? parsed : new Date();
431:         handleReactionUpdate(queryClient, messageId, userId, emoji, 'INSERT', timestamp);
432:         return;
433:       }
434: 
435:       if (payload.eventType === 'DELETE') {
436:         // Under RLS the DELETE payload only carries the reaction row's PK, so
437:         // the affected message is unknown — invalidate and let the active
438:         // conversation refetch (this is what syncs reaction removal live).
439:         queryClient.invalidateQueries({ queryKey: ['messages'] });
440:       }
441:     };
442: 
443:     // T13 (FR-015): the shared recovering lifecycle (realtime-health.ts) —
444:     // rejoins after an error, a timeout or a terminal closure with capped
445:     // backoff, on a new topic each time, and reports the stream's health.
446:     const stop = startRecoveringChannel({
447:       stream: 'messages',
448:       health,
449:       traceScope: 'useMessageSubscription',
450:       traceChannel: CHANNEL_NAME,
451:       createTopic: () => createChannelTopic(companyId, currentUserId),
452:       bind: (channel, isCurrent) => {
453:         joinCatchUp.joinStarted();
454:         return channel
455:           .on(
456:             'postgres_changes',
457:             { event: '*', schema: 'public', table: 'messages' },
458:             (payload) => {
459:               // Only this binding's own table (see isPostgresChangeOf).
460:               if (isCurrent() && isPostgresChangeOf(payload, 'messages')) handleMessageChange(payload);
461:             }
462:           )
463:           .on(
464:             'postgres_changes',
465:             { event: 'INSERT', schema: 'public', table: 'message_read_receipts' },
466:             (payload) => {
467:               if (isCurrent() && isPostgresChangeOf(payload, 'message_read_receipts', ['INSERT'])) {
468:                 handleReceiptInsert(payload);
469:               }
470:             }
471:           )
472:           .on(
473:             'postgres_changes',
474:             { event: '*', schema: 'public', table: 'message_reactions' },
475:             (payload) => {
476:               if (isCurrent() && isPostgresChangeOf(payload, 'message_reactions')) handleReactionChange(payload);
477:             }
478:           )
479:           .on('system', {}, (payload: RealtimeSystemPayload) => {
480:             if (
481:               isCurrent()
482:               && payload.extension === 'postgres_changes'
483:               && payload.status === 'ok'
484:             ) {
485:               joinCatchUp.confirmed();
486:             }
487:           });
488:       },
489:       onStatus: (nextStatus) => {
490:         publishStatus(nextStatus);
491:         joinCatchUp.status(nextStatus);
492:       },
493:       onRecovered: () => onRecoveredRef.current?.(),
494:     });
495: 
496:     return () => {
497:       isMounted = false;
498:       deferredRefetchTimers.forEach((timer) => clearTimeout(timer));
499:       deferredRefetchTimers.clear();
500:       stop();
501:     };
502:   }, [companyId, currentUserId, health, isActive, queryClient, publishStatus]);
503: 
504:   return { status: isActive && companyId && currentUserId ? status : null };
505: }


