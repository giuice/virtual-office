451: create or replace function private.authorize_room_membership(p_user_ids uuid[], p_space_id uuid)
452: returns void
453: language plpgsql
454: set search_path = ''
455: as $$
456: declare
457:   v_user public.users;
458:   v_space public.spaces;
459:   v_count integer;
