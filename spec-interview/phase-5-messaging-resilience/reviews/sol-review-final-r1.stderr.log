8: import { ConversationType, MessageType, type Conversation, type Message } from '@/types/messaging';
9: 
10: /**
11:  * What the drawer control shows:
12:  * - unsupported: the browser has no Notifications API;
13:  * - blocked: the browser permission is "denied";
14:  * - enabled: the user turned them on here and the permission is "granted";
15:  * - available: anything else (never asked, dismissed, or turned off in-app).
16:  */
17: export type DesktopNotificationStatus = 'unsupported' | 'blocked' | 'enabled' | 'available';
18: 
19: const PREFERENCE_KEY_PREFIX = 'vo:messaging:desktop-notifications:';
20: const PREFERENCE_ON = 'on';
21: const PREFERENCE_OFF = 'off';
22: /** In-tab signal that the preference changed (`storage` only fires in other tabs). */
23: const PREFERENCE_EVENT = 'vo:messaging:desktop-notifications-change';
24: 
25: const NOTIFIED_STORAGE_KEY = 'vo:messaging:notified-messages';
26: const NOTIFIED_LOCK_NAME = 'vo:messaging:notification-claim';
27: /** How long a claimed message id is remembered across tabs. */
28: const NOTIFIED_TTL_MS = 10 * 60_000;
29: const MAX_TAB_CLAIMS = 500;
30: const PREVIEW_MAX_LENGTH = 120;
31: 
32: export function notificationsSupported(): boolean {
33:   return typeof window !== 'undefined' && typeof window.Notification === 'function';
34: }
35: 
36: function readPermission(): NotificationPermission | null {
37:   if (!notificationsSupported()) return null;
38:   try {
39:     return window.Notification.permission;
40:   } catch {
41:     return null;
42:   }
43: }
44: 
45: const preferenceKey = (userId: string) => `${PREFERENCE_KEY_PREFIX}${userId}`;
46: 
47: /** The user's in-app opt-in on this browser. Absent (never chosen) means off. */
48: function readPreference(userId: string): boolean {
49:   try {
50:     return window.localStorage.getItem(preferenceKey(userId)) === PREFERENCE_ON;
51:   } catch {
52:     return false;
53:   }
54: }
55: 
56: export function writeDesktopNotificationPreference(userId: string, enabled: boolean): void {
57:   try {
58:     window.localStorage.setItem(preferenceKey(userId), enabled ? PREFERENCE_ON : PREFERENCE_OFF);
59:   } catch {
60:     // Storage unavailable: the choice cannot be kept; nothing else depends on it.
61:   }
62:   window.dispatchEvent(new Event(PREFERENCE_EVENT));
63: }
64: 
65: /**
66:  * Opt-in rule: notifications are on only when the user enabled them in the
67:  * drawer on this browser AND the browser permission is "granted". A granted
68:  * permission alone (e.g. given to another account or before turning them off
69:  * in-app) does not enable them; a denied/revoked permission disables them.
70:  */
71: export function readDesktopNotificationStatus(userId: string | null | undefined): DesktopNotificationStatus {
72:   const permission = readPermission();
73:   if (permission === null) return 'unsupported';
74:   if (permission === 'denied') return 'blocked';
75:   if (permission === 'granted' && userId && readPreference(userId)) return 'enabled';
76:   return 'available';
77: }
78: 
79: /**
80:  * Asks the browser for permission. Call only from a user action (the drawer
81:  * control); never on load. Resolves to the permission after the request.
82:  */
83: export async function requestDesktopNotificationPermission(): Promise<NotificationPermission | null> {
84:   if (!notificationsSupported()) return null;
85:   const current = readPermission();
86:   if (current !== 'default') return current;
87:   try {
88:     return await window.Notification.requestPermission();
89:   } catch {
90:     return readPermission();
91:   }
92: }
