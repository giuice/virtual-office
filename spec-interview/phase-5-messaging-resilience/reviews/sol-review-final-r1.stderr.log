268:   private async enrichMessages(messages: Message[]): Promise<Message[]> {
269:     if (messages.length === 0) {
270:       return messages;
271:     }
272: 
273:     const messageIds = messages.map(m => m.id);
274:     // Started first, awaited after the other reads (one fewer serial round trip).
275:     const mentionsPromise = this.loadMentionedUserIds(messageIds);
276:     // Settle it even when an await below throws (no unhandled rejection).
277:     mentionsPromise.catch(() => undefined);
278: 
279:     const { data: attachmentsData } = await this.supabaseClient
280:       .from(this.ATTACHMENT_TABLE_NAME)
281:       .select('*')
282:       .in('message_id', messageIds);
283: 
284:     const attachmentsByMessageId = (attachmentsData as AttachmentRow[] | null || []).reduce((acc: Record<string, 
FileAttachment[]>, row: AttachmentRow) => {
285:       const msgId = row.message_id as string;
286:       if (!acc[msgId]) acc[msgId] = [];
287:       acc[msgId].push(mapAttachmentToCamelCase(row));
