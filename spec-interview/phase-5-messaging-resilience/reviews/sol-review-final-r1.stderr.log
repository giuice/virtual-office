22: /**
23:  * Phase 5 T19 — client messaging metrics that never affect messaging
24:  * (FR-009 send time, FR-027, FR-028; AC-028 end-to-end clause, AC-029).
25:  *
26:  * Everything is real: the app's metric recorder, its outbox and Realtime
27:  * streams, POST /api/messages/metrics (T6) and the raw dev-server log the
28:  * Phase 5 runner captures (T24). Faults are network shaping only (SPEC §15):
29:  * one Realtime stream closed by the T25 harness, creates/fences failed in
30:  * transit, browser offline mode, and the metrics route reached but its
31:  * answer replaced by a gateway 500, held without an answer, or flooded with
32:  * real traffic of the same user until its real per-user budget answers 429
33:  * (started early in a budget bucket). Time: the page clock (`setSystemTime`)
34:  * puts the browser 25 h after a send whose delivery failed in transit.
35:  *
36:  * The recorder's own debug traces (`[MessagingMetrics] recorded|send|sent|
37:  * send-failed`, on in the dev server) report its buffer size; requests are
38:  * observed on A's page.
39:  */
40: 
41: /** The fields a metric log line may carry (BR-013; metrics-contract.ts). */
42: const METRIC_LINE_KEYS = new Set(['ts', 'appVersion', 'type', 'reason', 'conversationType', 'durationMs', 'count', 
'occurredAt']);
43: /** The fields a client event may carry. */
44: const METRIC_EVENT_KEYS = new Set(['type', 'reason', 'conversationType', 'durationMs', 'count', 'occurredAt']);
45: const METRIC_TYPES = new Set([
46:   'send_latency',
47:   'outbox_wait',
48:   'send_outcome',
49:   'messages_stream_drop',
50:   'messages_stream_recovery',
51:   'list_stream_drop',
52:   'list_stream_recovery',
53:   'typing_stream_drop',
54:   'typing_stream_recovery',
55:   'polling_start',
56:   'polling_stop',
57: ]);
58: const METRICS_PATH = '/api/messages/metrics';
59: /** Client bounds under test (metrics-recorder.ts, metrics-contract.ts). */
60: const MAX_BUFFERED_EVENTS = 100;
61: const MAX_BATCH_EVENTS = 50;
62: const MAX_BATCH_BYTES = 16 * 1024;
63: const REQUEST_TIMEOUT_MS = 5_000;
64: /** After a 429 the tab sends nothing for one budget window (metrics-recorder.ts). */
65: const OVERLOAD_PAUSE_MS = 60_000;
66: /** The route's per-user budget: 30 requests per fixed 60 s bucket (rate-limit.ts 'messaging:metrics'). */
67: const METRICS_BUDGET_WINDOW_MS = 60_000;
68: /**
69:  * Block C fix F9: the flood starts with at least this long left in its
70:  * bucket, so the bucket stays exhausted until A's tab has sent its next batch
71:  * (flood ~8 s to 429, offline cycle, then the tab's next request ≤ 15 s).
72:  */
73: const FLOOD_MIN_BUCKET_LEFT_MS = 40_000;
74: const POLL_AFTER_UNHEALTHY_MS = 30_000;
75: /** AC-002: three queued messages reach B within 10 s of connectivity returning. */
76: const AC002_DEADLINE_MS = 10_000;
77: const DAY_MS = 24 * 60 * 60 * 1_000;
78: const HOUR_MS = 60 * 60 * 1_000;
79: const UUID = /[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/i;
80: const ANSI = /\u001b\[[0-9;]*m/g;
81: 
82: interface MetricLine {
83:   raw: string;
84:   ts: string;
85:   appVersion: string;
86:   type: string;
87:   reason?: string;
88:   durationMs?: number;
89:   count?: number;
90:   [key: string]: unknown;
91: }
92: 
93: /**
94:  * Every metric line in the raw log since `mark`: a line carrying an
95:  * `appVersion` must be exactly one JSON object with only BR-013 fields and a
96:  * known type (anything else fails the scan).
97:  */
98: function metricLinesSince(serverLog: { linesSince(mark: ServerLogMark): string[] }, mark: ServerLogMark): 
MetricLine[] {
99:   const lines: MetricLine[] = [];
100:   for (const raw of serverLog.linesSince(mark)) {
101:     if (!raw.includes('"appVersion"')) continue;
102:     const text = raw.replace(ANSI, '');
103:     const parsed = JSON.parse(text) as Record<string, unknown>;
104:     expect(Object.keys(parsed).filter((key) => !METRIC_LINE_KEYS.has(key)), `only BR-013 fields: 
${text}`).toEqual([]);
105:     expect(METRIC_TYPES.has(String(parsed.type)), `known type: ${text}`).toBe(true);
106:     expect(String(parsed.appVersion)).toMatch(/^[0-9A-Za-z.-]{1,32}\+(local|[0-9a-f]{12})$/);
107:     lines.push({ ...parsed, raw: text } as MetricLine);
108:   }
109:   return lines;
110: }


