562:         await expect
563:           .poll(() => (overloaded = since(floodPhase).find((request) => request.status === 429)) !== undefined, {
564:             timeout: Math.max(1_000, floodBucketEndsAt - Date.now()),
565:             message: "A's tab answered 429 while the flooded bucket was exhausted",
566:           })
