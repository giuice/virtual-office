1: // src/lib/messaging/metrics-recorder.ts
2: // Phase 5 T19 (FR-027, FR-028, BR-013, AC-028, AC-029): the client half of
3: // the messaging health metrics. Messaging code records events here
4: // synchronously and never waits for them; this tab delivers them, fire and
5: // forget, to POST /api/messages/metrics (T6, metrics-contract.ts).
6: //
7: // - Bounded buffer: at most MAX_BUFFERED_EVENTS events; when full the oldest
8: //   one is dropped for each new one.
9: // - Batches: at most MESSAGING_METRICS_MAX_EVENTS events and
10: //   MESSAGING_METRICS_MAX_BYTES bytes of JSON body each; the events of a
11: //   batch leave the buffer when it is sent and are never sent again, whatever
12: //   the answer (dropped under overload, never retried).
13: // - At most one request in flight per tab, aborted after REQUEST_TIMEOUT_MS.
14: //   Requests start at least MIN_REQUEST_INTERVAL_MS apart (the route's budget
15: //   is 30 requests per minute per user, shared by the user's tabs); after a
16: //   failure (error status, no answer, abort) the next one waits
17: //   FAILURE_PAUSE_MS, after a 429 OVERLOAD_PAUSE_MS (one budget window).
18: // - Never throws into its caller, never logs an error, never shows anything:
19: //   every failure only drops the batch (debug traces when messaging debug is on).
20: // - Events carry only the contract's closed enums and bounded integers (no
21: //   identifiers, names, text, or client times: the server stamps `ts`).
22: // - Identity: delivery runs only while a user is active (MessagingContext,
23: //   users.id). Events recorded while no user is active wait in the buffer for
24: //   the same user; activating another user empties the buffer first.
25: import {
26:   MESSAGING_METRICS_MAX_BYTES,
27:   MESSAGING_METRICS_MAX_COUNT,
28:   MESSAGING_METRICS_MAX_EVENTS,
29:   MESSAGING_METRICS_PATH,
30:   type MessagingMetricEventInput,
31: } from '@/lib/messaging/metrics-contract';
32: import { debugLogger } from '@/utils/debug-logger';
33: 
34: /** Most events kept waiting for delivery in this tab (oldest dropped first). */
35: export const MESSAGING_METRICS_MAX_BUFFERED_EVENTS = 100;
36: /** A request still unanswered after this long is aborted and its batch dropped. */
37: export const MESSAGING_METRICS_REQUEST_TIMEOUT_MS = 5_000;
38: /** Events are gathered this long after the first one waiting before a batch is sent. */
39: const FLUSH_DELAY_MS = 5_000;
40: /** Least time between the starts of two requests of this tab (≤ 6 per minute). */
41: const MIN_REQUEST_INTERVAL_MS = 10_000;
42: /** After a failed or aborted request. */
43: const FAILURE_PAUSE_MS = 15_000;
44: /** After a 429: the route's budget window. */
45: const OVERLOAD_PAUSE_MS = 60_000;
46: const SCOPE = 'MessagingMetrics';
47: 
48: /**
49:  * Scheduling clock: monotonic, so a wall-clock jump (a corrected or changed
50:  * system time) neither stalls delivery nor bursts it.
51:  */
52: const monotonicNow = (): number =>
53:   typeof performance !== 'undefined' && typeof performance.now === 'function' ? performance.now() : Date.now();
54: 
55: const encoder = typeof TextEncoder !== 'undefined' ? new TextEncoder() : null;
56: const byteLength = (text: string): number => (encoder ? encoder.encode(text).byteLength : text.length * 3);
57: 
58: const tracing = (): boolean => {
59:   try {
60:     return debugLogger.messaging.enabled();
61:   } catch {
62:     return false;
63:   }
64: };
65: 
66: const trace = (event: string, details: Record<string, unknown>): void => {
67:   if (tracing()) debugLogger.messaging.event(SCOPE, event, details);
68: };
69: 
