154:       setActive({ key: activeKey, index: (activeIndex + step + options.length) % options.length });
155:     } else if ((event.key === 'Enter' || event.key === 'Tab') && !event.shiftKey) {
156:       choose(options[activeIndex]);
157:     } else if (event.key === 'Escape') {
158:       setDismissedStart(trigger.start);
159:     } else {
160:       return false;
161:     }
162:     event.preventDefault();
163:     event.stopPropagation();
164:     return true;
165:   };
166: 
167:   const trackCaret = useCallback((event: React.SyntheticEvent<HTMLTextAreaElement>) => {
168:     setCaret(event.currentTarget.selectionStart === event.currentTarget.selectionEnd ? 
event.currentTarget.selectionStart : null);
169:   }, []);
170: 
171:   const segments: MentionSegment[] = segmentMentions(content, mentions);
172:   const mentionIds = mentionIdsInText(content, mentions);
173: 
174:   const list: ComposerMentionList | null = isOpen
175:     ? { id: listId, options, activeIndex, optionId, choose, setActiveIndex }
176:     : null;
177: 
178:   return {
179:     list,
180:     /** Props for the composer's textarea (combined with its own handlers by the caller). */
181:     textareaProps: {
182:       'aria-autocomplete': 'list' as const,
183:       'aria-controls': isOpen ? listId : undefined,
184:       'aria-activedescendant': isOpen ? optionId(activeIndex) : undefined,
185:     },
186:     handleKeyDown,
187:     trackCaret,
188:     onFocus: () => setFocused(true),
189:     onBlur: () => setFocused(false),
190:     /** Text split into plain pieces and chosen mention tokens (the composer's highlight). */
191:     segments,
192:     hasMentions: mentions.length > 0,
193:     /** users.id of the chosen mentions still in the text, sorted. */
