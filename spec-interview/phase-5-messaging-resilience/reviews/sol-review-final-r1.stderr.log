188: /** The owner's items of one conversation (or of all), in creation order. */
189: export function listOutboxItems(ownerId: string, conversationId?: string): Promise<OutboxItem[]> {
190:   return inTransaction<OutboxItem[]>('readonly', ({ items }, done) => {
191:     const request = conversationId
192:       ? items
193:           .index(BY_CONVERSATION_ORDER)
194:           .getAll(IDBKeyRange.bound([ownerId, conversationId, -Infinity], [ownerId, conversationId, Infinity]))
195:       : items.index(BY_OWNER_ORDER).getAll(IDBKeyRange.bound([ownerId, -Infinity], [ownerId, Infinity]));
196:     request.onsuccess = () => done(request.result as OutboxItem[]);
197:   });
198: }
