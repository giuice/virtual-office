185: /** The recorder's debug traces on `page`, in the order the page wrote them. */
186: function watchRecorder(page: Page): RecorderTrace[] {
187:   const traces: RecorderTrace[] = [];
188:   page.on('console', (message: ConsoleMessage) => {
189:     const match = /^\[MessagingMetrics\] (recorded|send|sent|send-failed|discarded)\b/.exec(message.text());
190:     if (!match) return;
191:     // Placed now (console order); its details arrive asynchronously.
192:     const trace: RecorderTrace = { event: match[1], at: Date.now() };
193:     traces.push(trace);
194:     void (async () => {
195:       const value = (await message.args()[1]?.jsonValue()) as Omit<RecorderTrace, 'event' | 'at'> | undefined;
196:       Object.assign(trace, value ?? {});
197:     })().catch(() => {});
198:   });
199:   return traces;
200: }
201: 
202: const UNKNOWN_EVENT = '?';
203: 
204: /**
205:  * Replays the recorder's traces up to (not including) `until` under a drop
206:  * policy and returns the buffer's event types at that point, oldest first.
207:  * Events already waiting when tracing began are UNKNOWN_EVENT. Each step's
208:  * buffer size is checked against the trace (no trace missed).
209:  */
210: function replayBuffer(traces: readonly RecorderTrace[], until: RecorderTrace, policy: 'drop-oldest' | 
'drop-newest'): string[] {
211:   let buffer: string[] | null = null;
212:   for (const trace of traces) {
213:     if (trace === until) break;
214:     if (trace.event === 'discarded') {
215:       buffer = [];
216:       continue;
217:     }
218:     if (trace.event !== 'recorded' && trace.event !== 'send') continue;
219:     const buffered = trace.buffered as number;
220:     if (buffer === null) {
221:       const before = trace.event === 'recorded'
222:         ? (buffered < MAX_BUFFERED_EVENTS ? buffered - 1 : MAX_BUFFERED_EVENTS)
223:         : buffered + (trace.events as number);
224:       buffer = Array.from({ length: before }, () => UNKNOWN_EVENT);
225:     }
226:     if (trace.event === 'recorded') {
227:       if (buffer.length < MAX_BUFFERED_EVENTS) buffer.push(trace.type as string);
228:       else if (policy === 'drop-oldest') buffer = [...buffer.slice(1), trace.type as string];
229:     } else {
230:       buffer = buffer.slice(trace.events as number);
231:     }
232:     expect(buffer.length, `replayed buffer size at ${trace.event} (${policy})`).toBe(buffered);
233:   }
234:   return buffer ?? [];
235: }
