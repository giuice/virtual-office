173: /** Adds a new item, giving it the owner's next creation order. Resolves once committed. */
174: export function addOutboxItem(item: Omit<OutboxItem, 'order'>): Promise<OutboxItem> {
175:   return inTransaction<OutboxItem>('readwrite', ({ items, meta }, done) => {
176:     const metaRequest = meta.get(item.ownerId);
177:     metaRequest.onsuccess = () => {
178:       const current = metaRequest.result as OwnerMeta | undefined;
179:       const order = current?.nextOrder ?? 1;
180:       const stored: OutboxItem = { ...item, order };
181:       meta.put({ ...current, ownerId: item.ownerId, nextOrder: order + 1 } satisfies OwnerMeta);
182:       items.add(stored);
183:       done(stored);
184:     };
185:   });
186: }
