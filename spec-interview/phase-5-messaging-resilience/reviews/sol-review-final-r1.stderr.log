991:   where r.conversation_id = p_conversation_id
992:     and r.user_id = p_user_id;
993: 
994:   if not v_in_participants then
995:     update public.conversations c
996:     set participants = pg_catalog.array_append(coalesce(c.participants, '{}'::uuid[]), p_user_id)
997:     where c.id = p_conversation_id;
998:   else
999:     insert into public.conversation_members (conversation_id, user_id, last_read_at)
1000:     values (p_conversation_id, p_user_id, pg_catalog.now())
1001:     on conflict (conversation_id, user_id) do nothing;
1002:   end if;
1003:   return true;
1004: end;
1005: $$;
