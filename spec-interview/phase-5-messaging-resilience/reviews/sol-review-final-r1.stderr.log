476:   async findByConversation(conversationId: string, options?: PaginationOptions): 
Promise<PaginatedResult<Message>> {
477:     const limit = options?.limit ?? 50; // Default limit for messages
478: 
479:     // Keyset pagination by timestamp when provided
480:     const hasCursorBefore = !!options?.cursorBefore;
481:     const hasCursorAfter = !!options?.cursorAfter;
482: 
483:     let data: any[] | null = null;
484:     let error: any | null = null;
485: 
486:     if (hasCursorBefore || hasCursorAfter) {
487:       // Use keyset pagination - fetch limit + 1 to check for more results.
488:       // Audit M-03: composite (timestamp, id) cursor so equal timestamps
489:       // cannot skip or duplicate rows across pages. Legacy timestamp-only
490:       // cursors are still accepted.
491:       let query = this.supabaseClient
492:         .from(this.MSG_TABLE_NAME)
493:         .select('*')
494:         .eq('conversation_id', conversationId);
495: 
496:       if (hasCursorBefore) {
497:         const { ts, id } = parseCompositeCursor(options!.cursorBefore!);
498:         query = id
499:           ? query.or(`timestamp.lt."${ts}",and(timestamp.eq."${ts}",id.lt."${id}")`)
500:           : query.lt('timestamp', ts);
501:         // Get older messages relative to cursorBefore, newest-first to apply limit
502:         query = query
503:           .order('timestamp', { ascending: false })
504:           .order('id', { ascending: false })
505:           .limit(limit + 1);

