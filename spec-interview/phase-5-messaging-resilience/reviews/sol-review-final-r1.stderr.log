2: import { NextResponse } from 'next/server';
3: import { SupabaseConversationRepository } from '@/repositories/implementations/supabase';
4: import { IConversationRepository, NotParticipantError } from '@/repositories/interfaces';
5: import { isAuthzFailure, jsonError, requireConversationParticipant } from '@/lib/auth/authorize';
6: 
7: export async function PATCH(request: Request) {
8:   try {
9:     const { conversationId, isArchived } = await request.json();
10: 
11:     // Basic validation
12:     if (!conversationId || typeof isArchived !== 'boolean') {
13:       return NextResponse.json(
14:         { error: 'Missing required fields: conversationId, isArchived (boolean)' },
15:         { status: 400 }
16:       );
17:     }
18: 
19:     const ctx = await requireConversationParticipant(conversationId);
20:     if (isAuthzFailure(ctx)) {
21:       return ctx.errorResponse;
22:     }
23: 
24:     const conversationRepository: IConversationRepository = new SupabaseConversationRepository(ctx.serviceClient);
25:     console.log(
26:       `API: Setting per-user archive status for conversation ${conversationId} to ${isArchived} for user 
${ctx.dbUser.id}`
27:     );
28: 
29:     // NEW: Use per-user preference instead of global archive status
30:     const preferences = await conversationRepository.setUserPreference(conversationId, ctx.dbUser.id, {
31:       isArchived,
32:     });
33: 
34:     if (!preferences) {
35:       return NextResponse.json({ error: 'Failed to update archive status' }, { status: 500 });
36:     }
37: 
38:     return NextResponse.json({ success: true, preferences }, { status: 200 });
39:   } catch (error) {
40:     if (error instanceof NotParticipantError) {
41:       // Phase 5 T28: the membership vanished after authorization; nothing written.
42:       return jsonError(403, 'NOT_PARTICIPANT', 'You are not a participant of this conversation');
43:     }
44:     console.error('Error setting conversation archive status:', error);
45:     if (error instanceof SyntaxError) {
46:       return NextResponse.json({ error: 'Invalid JSON payload' }, { status: 400 });
47:     }
48:     return NextResponse.json({ error: 'Internal Server Error' }, { status: 500 });
49:   }
50: }


