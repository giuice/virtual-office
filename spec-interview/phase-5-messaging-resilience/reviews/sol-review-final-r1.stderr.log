14:  * Phase 5 T15: the current members of a conversation (users.id, display
15:  * names) — typing names (FR-018) and the viewer's own membership (FR-019).
16:  * `null` data: the viewer is not (or no longer) a member. Refetched when the
17:  * viewer's own membership changes (useConversationRealtime) and on every
18:  * conversation-list (re)join.
19:  */
20: export function useConversationMembers(conversationId: string | null, viewerId: string | null) {
21:   return useQuery<ConversationMember[] | null, Error>({
22:     queryKey: conversationMembersQueryKey(viewerId ?? '', conversationId ?? ''),
23:     queryFn: () => messagingApi.getConversationMembers(conversationId as string),
24:     enabled: Boolean(conversationId && viewerId),
25:     staleTime: 60_000,
26:   });
