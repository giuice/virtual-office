858:     raise exception 'JOIN_FORBIDDEN' using errcode = '42501';
859:   end if;
860:   v_room_id := v_conversation.room_id;
861: 
862:   perform private.authorize_room_membership(array[p_user_id], v_room_id);
863: 
864:   select c.* into v_conversation
865:   from public.conversations c
866:   where c.id = p_conversation_id
867:   for no key update;
868:   if not found then
869:     raise exception 'CONVERSATION_NOT_FOUND' using errcode = 'P0002';
870:   end if;
871:   if v_conversation.type <> 'room'::public.conversation_type
872:      or v_conversation.room_id is distinct from v_room_id then
873:     raise exception 'JOIN_FORBIDDEN' using errcode = '42501';
874:   end if;
875:   if exists (
876:     select 1
877:     from public.conversation_members cm
878:     where cm.conversation_id = p_conversation_id
879:       and cm.user_id = p_user_id
880:   ) then
881:     return false;
882:   end if;
883:   if exists (
884:     select 1
885:     from private.conversation_member_revocations r
886:     where r.conversation_id = p_conversation_id
887:       and r.user_id = p_user_id
888:   ) then
889:     raise exception 'MEMBERSHIP_REVOKED' using errcode = '42501';
890:   end if;
891: 
892:   if array_position(coalesce(v_conversation.participants, '{}'::uuid[]), p_user_id) is null then
893:     -- sync_conversation_members creates the membership (same checks; the
