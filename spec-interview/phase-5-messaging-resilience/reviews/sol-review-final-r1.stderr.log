14: const CHANNEL_NAME = 'conversations-changes';
15: 
16: /** A new topic for every join of the stream (T13: a left channel's topic is never reused). */
17: function createChannelTopic(userId: string): string {
18:   const entropy = typeof crypto !== 'undefined' && typeof crypto.randomUUID === 'function'
19:     ? crypto.randomUUID()
20:     : `${Date.now()}-${Math.random().toString(36).slice(2)}`;
21:   return `${CHANNEL_NAME}:${userId}:${entropy}`;
22: }
23: 
24: /**
25:  * T15 (FR-019, BR-009): a conversation_members row was deleted. Realtime
26:  * cannot evaluate RLS on a deleted row, so every subscriber receives every
27:  * DELETE with the row id only; the viewer's own row ids come with its
28:  * conversation list (`preferences.id`). On the viewer's own removal its
29:  * roster is refetched (403 -> typing leaves the topic) and the list
30:  * refreshed (the conversation leaves it); block C fix F1: the removal is
31:  * also recorded at once (membership-removals.ts), so a notification decided
32:  * meanwhile is dropped before those refetches land. Any other deletion may be
33:  * another member leaving an open conversation (block C fix F6: the "@" list
34:  * and typing names) or the viewer's removal from a conversation whose own row
35:  * id the list does not carry (archived, beyond the first page): open rosters
36:  * are re-checked.
37:  */
38: function handleMembershipRowDeleted(queryClient: QueryClient, userId: string, rowId: unknown): void {
39:   if (typeof rowId !== 'string') return;
40:   const conversations = queryClient.getQueryData<Conversation[]>(['conversations', userId]) ?? [];
41:   const removedFrom = conversations.find((conversation) => conversation.preferences?.id === rowId);
42:   if (removedFrom) {
43:     recordMembershipRemoval(userId, removedFrom.id);
44:     void queryClient.invalidateQueries({ queryKey: conversationMembersQueryKey(userId, removedFrom.id) });
45:     void queryClient.invalidateQueries({ queryKey: ['conversations', userId] });
46:     return;
47:   }
48:   void queryClient.invalidateQueries({
49:     queryKey: conversationMembersQueryPrefix(userId),
50:     refetchType: 'active',
51:   });
52: }
53: 
54: /**
55:  * Subscribe to real-time conversation changes and keep React Query caches fresh.
56:  * Expects `userId` to be the Database User ID (not Supabase UID).
57:  *
58:  * T13 (FR-015): the conversation-list stream rejoins after an error, a
59:  * timeout or a terminal closure with capped backoff (realtime-health.ts) and
60:  * reports its health as stream 'list'; every (re)join the server confirms
61:  * refetches the list (catch-up).
62:  *
63:  * T15 (FR-019): the same channel carries the viewer's own membership changes
64:  * (conversation_members DELETE / own INSERT), the removal signal that typing
65:  * relies on whether or not the conversation is open.
66:  */
67: export function useConversationRealtime(userId: string | undefined, health: MessagingRealtimeHealth) {
68:   const queryClient = useQueryClient();
69: 
70:   useEffect(() => {
71:     if (!userId) return;
72: 
73:     // Changes committed before this channel was streaming (between the list's
74:     // first fetch and the join, or while reconnecting) never arrive as events,
75:     // so unread counts and order would stay stale: the list refetches once
76:     // per (re)join, when it is both SUBSCRIBED and server-confirmed (block B
77:     // fix F5: whichever comes second); open rosters too (a removal missed
78:     // meanwhile, T15).
79:     const joinCatchUp = createJoinCatchUp(() => {
80:       void queryClient.invalidateQueries({ queryKey: ['conversations', userId] });
81:       void queryClient.invalidateQueries({
82:         queryKey: conversationMembersQueryPrefix(userId),
83:         refetchType: 'active',
84:       });
85:     });
86: 
87:     return startRecoveringChannel({
88:       stream: 'list',
89:       health,
90:       traceScope: 'useConversationRealtime',
91:       traceChannel: CHANNEL_NAME,
92:       createTopic: () => createChannelTopic(userId),
93:       onStatus: joinCatchUp.status,
94:       bind: (channel, isCurrent) => {
95:         joinCatchUp.joinStarted();
96:         return channel
97:           .on(
98:             'postgres_changes',
99:             { event: 'INSERT', schema: 'public', table: 'conversations' },
100:             (payload) => {
101:               if (!isCurrent() || !isPostgresChangeOf(payload, 'conversations', ['INSERT'])) return;
102:               const row = payload.new as any;
103:               const participants: string[] = row?.participants ?? [];
104:               if (participants.includes(userId)) {
105:                 queryClient.invalidateQueries({ queryKey: ['conversations', userId] });
106:               }
107:             }
108:           )
109:           .on(
110:             'postgres_changes',
111:             { event: 'UPDATE', schema: 'public', table: 'conversations' },
112:             (payload) => {
113:               if (!isCurrent() || !isPostgresChangeOf(payload, 'conversations', ['UPDATE'])) return;
114:               const row = payload.new as any;
115:               const participants: string[] = row?.participants ?? [];
116:               if (participants.includes(userId)) {
117:                 queryClient.invalidateQueries({ queryKey: ['conversations', userId] });
118:                 queryClient.invalidateQueries({ queryKey: ['conversation', row.id] });
119:               }
120:             }
121:           )
122:           .on(
123:             'postgres_changes',
124:             { event: 'DELETE', schema: 'public', table: 'conversations' },
125:             (payload) => {
126:               if (!isCurrent() || !isPostgresChangeOf(payload, 'conversations', ['DELETE'])) return;
127:               const row = payload.old as any;
128:               const participants: string[] = row?.participants ?? [];
129:               if (participants.includes(userId)) {
130:                 queryClient.invalidateQueries({ queryKey: ['conversations', userId] });
131:                 queryClient.removeQueries({ queryKey: ['conversation', row.id] });
132:               }
133:             }
134:           )
135:           // T15: the viewer's own membership changes -- a signal that does not
136:           // depend on still having access to the conversation (the typing
137:           // topic's authorization is cached per join).
138:           .on(
139:             'postgres_changes',
140:             { event: 'DELETE', schema: 'public', table: 'conversation_members' },
141:             (payload) => {
142:               if (!isCurrent() || !isPostgresChangeOf(payload, 'conversation_members', ['DELETE'])) return;
143:               handleMembershipRowDeleted(queryClient, userId, (payload.old as { id?: unknown } | null)?.id);
144:             }
145:           )
146:           .on(
147:             'postgres_changes',
148:             { event: 'INSERT', schema: 'public', table: 'conversation_members', filter: `user_id=eq.${userId}` },
149:             (payload) => {
150:               if (!isCurrent() || !isPostgresChangeOf(payload, 'conversation_members', ['INSERT'])) return;
151:               const conversationId = (payload.new as { conversation_id?: unknown } | null)?.conversation_id;
152:               if (typeof conversationId === 'string') {
153:                 void queryClient.invalidateQueries({ queryKey: conversationMembersQueryKey(userId, 
conversationId) });
154:               }
155:             }
156:           )
157:           // The server confirmed this join's postgres_changes stream (catch-up above).
158:           .on('system', {}, (payload: RealtimeSystemPayload) => {
159:             if (isCurrent() && payload.extension === 'postgres_changes' && payload.status === 'ok') {
160:               joinCatchUp.confirmed();
161:             }
162:           });
163:       },
164:     });
