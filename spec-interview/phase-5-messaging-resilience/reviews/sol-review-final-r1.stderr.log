112: /**
113:  * Runs `work` in one transaction and resolves with its result once the
114:  * transaction COMMITTED (`complete`); rejects with OutboxStorageError if the
115:  * transaction errors or aborts (e.g. QuotaExceededError). Write transactions
116:  * use strict durability (the commit is flushed before `complete`) unless
117:  * `relaxed` is asked for a write whose loss after an OS crash is harmless.
118:  */
119: async function inTransaction<T>(
120:   mode: IDBTransactionMode,
121:   work: (stores: { items: IDBObjectStore; meta: IDBObjectStore }, done: (value: T) => void) => void,
122:   writeDurability: 'strict' | 'relaxed' = 'strict'
123: ): Promise<T> {
124:   const db = await database();
125:   return new Promise<T>((resolve, reject) => {
126:     let transaction: IDBTransaction;
127:     try {
128:       transaction = db.transaction([ITEMS_STORE, META_STORE], mode, {
129:         durability: mode === 'readwrite' ? writeDurability : 'default',
130:       });
131:     } catch (error) {
132:       if (connection) connection = null;
133:       reject(new OutboxStorageError(`Outbox transaction failed (${describe(error)})`, error));
134:       return;
135:     }
136:     let result: T | undefined;
137:     let settled = false;
138:     transaction.oncomplete = () => resolve(result as T);
139:     const fail = () => {
140:       reject(new OutboxStorageError(`Outbox transaction failed (${describe(transaction.error)})`, 
transaction.error));
141:     };
142:     transaction.onerror = (event) => {
143:       // The error event reaches the transaction before its abort; reject once.
144:       event.preventDefault();
145:       if (!settled) {
146:         settled = true;
147:         try {
148:           transaction.abort();
149:         } catch {
150:           // Already aborting.
151:         }
152:       }
153:     };
154:     transaction.onabort = fail;
155:     try {
156:       work(
157:         { items: transaction.objectStore(ITEMS_STORE), meta: transaction.objectStore(META_STORE) },
158:         (value) => {
159:           result = value;
160:         }
161:       );
162:     } catch (error) {
163:       try {
164:         transaction.abort();
165:       } catch {
166:         // Already aborting.
167:       }
168:       reject(new OutboxStorageError(`Outbox transaction failed (${describe(error)})`, error));
169:     }
170:   });
171: }
