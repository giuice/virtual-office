522:       await expect.poll(() => since(errorPhase).filter((request) => request.status === 500).length, { timeout: 
30_000 }).toBeGreaterThan(0);
523:       await expectNoVisibleError(a.page, errors);
524: 
525:       // ---- The route hangs: the request is aborted after 5 s.
526:       mode = 'hang';
527:       const hangPhase = Date.now();
