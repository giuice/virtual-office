475:     raise exception 'USER_NOT_FOUND' using errcode = 'P0002';
476:   end if;
477: 
478:   select s.* into v_space
479:   from public.spaces s
480:   where s.id = p_space_id
481:   for share;
482:   if not found then
483:     raise exception 'ROOM_NOT_FOUND' using errcode = 'P0002';
484:   end if;
