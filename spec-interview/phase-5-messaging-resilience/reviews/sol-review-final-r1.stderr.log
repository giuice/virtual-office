src/app/api/conversations/join/route.ts
1: // src/app/api/conversations/join/route.ts
2: import { NextRequest, NextResponse } from 'next/server';
3: import { createSupabaseServerClient } from '@/lib/supabase/server-client';
4: import { requireAuthUser } from '@/lib/auth/session';
5: import { jsonError } from '@/lib/auth/authorize';
6: import { ConversationMembershipError, IConversationRepository } from '@/repositories/interfaces';
7: import { SupabaseConversationRepository } from '@/repositories/implementations/supabase';
8: 
9: /**
10:  * POST { conversationId } — joins the requester to a ROOM conversation.
11:  *
12:  * Phase 5 T28: the membership is written by public.join_room_conversation,
13:  * which re-checks, under row locks, that the conversation is a room
14:  * conversation, that the requester passes the room's access rules
15:  * (ConversationResolverService.assertRoomAccess, mirrored in SQL), and that
16:  * the requester's membership was not revoked — so a revocation that commits
17:  * while this request is in flight is never overridden. Direct/group
18:  * conversations are never joinable (audit S-01). Idempotent for a current
19:  * member (membership row, not the participants array).
20:  */
21: export async function POST(request: NextRequest) {
22:   try {
23:     const auth = await requireAuthUser();
24:     if ('errorResponse' in auth) {
25:       return auth.errorResponse;
26:     }
27:     const { dbUser } = auth;
28: 
29:     let body: { conversationId?: unknown };
30:     try {
31:       body = await request.json();
32:     } catch {
33:       return jsonError(400, 'BAD_REQUEST', 'Invalid JSON payload');
34:     }
35: 
36:     const conversationId = typeof body.conversationId === 'string' ? body.conversationId : null;
37:     if (!conversationId) {
38:       return jsonError(400, 'BAD_REQUEST', 'conversationId is required');
39:     }
40: 
41:     const serviceClient = await createSupabaseServerClient('service_role');
42:     const convoRepo: IConversationRepository = new SupabaseConversationRepository(serviceClient);
43: 
44:     const existing = await convoRepo.findById(conversationId);
45:     if (!existing) {
46:       return jsonError(404, 'CONVERSATION_NOT_FOUND', 'Conversation not found');
47:     }
48: 
49:     try {
50:       await convoRepo.joinRoomConversation(conversationId, dbUser.id);
51:     } catch (joinError) {
52:       if (joinError instanceof ConversationMembershipError) {
53:         return jsonError(joinError.status, joinError.code, joinMessage(joinError));
54:       }
55:       throw joinError;
56:     }
57: 
58:     const conversation = await convoRepo.findById(conversationId);
59:     if (!conversation) {
60:       return jsonError(404, 'CONVERSATION_NOT_FOUND', 'Conversation not found');
61:     }
62:     return NextResponse.json({ conversation }, { status: 200 });
63:   } catch (error) {
64:     console.error('Error joining conversation:', error);
65:     return jsonError(500, 'INTERNAL_ERROR', 'Internal server error');
66:   }
67: }
68: 
69: function joinMessage(error: ConversationMembershipError): string {
70:   switch (error.code) {
71:     case 'JOIN_FORBIDDEN':
72:       return 'Only room conversations can be joined';
73:     case 'ROOM_ACCESS_DENIED':
74:       return 'Room conversation not accessible for this user';
75:     case 'MEMBERSHIP_REVOKED':
76:       return 'Your membership in this conversation was removed';
77:     case 'ROOM_NOT_FOUND':
78:       return 'Room not found';
79:     case 'USER_NOT_FOUND':
80:       return 'User not found';
81:     case 'CONVERSATION_NOT_FOUND':
82:       return 'Conversation not found';
83:   }
84: }


src/app/api/conversations/read/route.ts
1: // src/app/api/conversations/read/route.ts
2: import { NextRequest, NextResponse } from 'next/server';
3: import { z } from 'zod';
4: import { IConversationRepository, NotParticipantError } from '@/repositories/interfaces';
5: import { SupabaseConversationRepository } from '@/repositories/implementations/supabase';
6: import { isAuthzFailure, jsonError, requireConversationParticipant } from '@/lib/auth/authorize';
7: import { enforceRateLimit } from '@/lib/auth/rate-limit';
8: 
9: /** Upper bound of visible message ids per request (mirrored by the RPC). */
10: const MAX_READ_RECEIPT_MESSAGE_IDS = 100;
11: 
12: const messageIdsSchema = z
13:   .array(z.guid())
14:   .min(1)
15:   .max(MAX_READ_RECEIPT_MESSAGE_IDS);
16: 
17: /**
18:  * PATCH { conversationId }               — legacy mark-all (published clients):
19:  *   advances last_read_at and receipts every message from others.
20:  * PATCH { conversationId, messageIds }   — Phase 4 per-message receipts: records
21:  *   receipts only for the given visible ids of this conversation, never for the
22:  *   caller's own messages, without moving last_read_at.
23:  */
24: export async function PATCH(request: NextRequest) {
25:   try {
26:     let body: Record<string, unknown>;
27:     try {
28:       const parsedBody: unknown = await request.json();
29:       if (typeof parsedBody !== 'object' || parsedBody === null || Array.isArray(parsedBody)) {
30:         return jsonError(400, 'BAD_REQUEST', 'Invalid JSON payload');
31:       }
32:       body = parsedBody as Record<string, unknown>;
33:     } catch {
34:       return jsonError(400, 'BAD_REQUEST', 'Invalid JSON payload');
35:     }
36: 
37:     const conversationId = typeof body.conversationId === 'string' ? body.conversationId : null;
38:     if (!conversationId) {
39:       return jsonError(400, 'BAD_REQUEST', 'Missing required field: conversationId');
40:     }
41: 
42:     let messageIds: string[] | null = null;
43:     if (body.messageIds !== undefined) {
44:       const parsed = messageIdsSchema.safeParse(body.messageIds);
45:       if (!parsed.success) {
46:         return jsonError(
47:           400,
48:           'BAD_REQUEST',
49:           `messageIds must be 1-${MAX_READ_RECEIPT_MESSAGE_IDS} message UUIDs`
50:         );
51:       }
52:       messageIds = [...new Set(parsed.data.map((id) => id.toLowerCase()))];
53:     }
54: 
55:     // Audit B-01: participants hold DB UUIDs, so the participant check must use
56:     // dbUser.id — the gate already compares the right identity. The legacy route
57:     // compared the Supabase UID and returned a permanent 403.
58:     const ctx = await requireConversationParticipant(conversationId);
59:     if (isAuthzFailure(ctx)) {
60:       return ctx.errorResponse;
61:     }
62: 
63:     const conversationRepository: IConversationRepository = new SupabaseConversationRepository(
64:       ctx.serviceClient
65:     );
66: 
67:     if (messageIds) {
68:       const rateLimited = await enforceRateLimit(
69:         ctx.serviceClient,
70:         ctx.dbUser.id,
71:         'conversation:read-receipts'
72:       );
73:       if (rateLimited) {
74:         return rateLimited;
75:       }
76: 
77:       const recorded = await conversationRepository.markMessagesRead(
78:         conversationId,
79:         ctx.dbUser.id,
80:         messageIds
81:       );
82:       return NextResponse.json({ success: true, recorded }, { status: 200 });
83:     }
84: 
85:     // Phase 2.2: atomic RPC — sets conversation_members.last_read_at and
86:     // writes per-message read receipts in one transaction.
87:     const success = await conversationRepository.markConversationRead(conversationId, ctx.dbUser.id);
88: 
89:     if (!success) {
90:       return jsonError(500, 'INTERNAL_ERROR', 'Failed to mark conversation as read');
91:     }
92: 
93:     return NextResponse.json({ success: true }, { status: 200 });
94:   } catch (error) {
95:     if (error instanceof NotParticipantError) {
96:       // Phase 5 T28: the membership vanished after authorization; nothing written.
97:       return jsonError(403, 'NOT_PARTICIPANT', 'You are not a participant of this conversation');
98:     }
99:     console.error('Error marking conversation as read:', error);
100:     return jsonError(500, 'INTERNAL_ERROR', 'Internal Server Error');
101:   }
102: }


