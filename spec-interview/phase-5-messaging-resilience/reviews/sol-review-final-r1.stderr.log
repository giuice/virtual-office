2: import { NextRequest, NextResponse } from 'next/server';
3: import { SupabaseConversationRepository } from '@/repositories/implementations/supabase';
4: import { IConversationRepository, NotParticipantError } from '@/repositories/interfaces';
5: import { isAuthzFailure, jsonError, requireConversationParticipant } from '@/lib/auth/authorize';
6: 
7: /**
8:  * GET /api/conversations/preferences?conversationId={id}
9:  * Get user's preferences for a specific conversation
10:  */
11: export async function GET(request: NextRequest) {
12:   try {
13:     const searchParams = new URL(request.url).searchParams;
14:     const conversationId = searchParams.get('conversationId');
15: 
16:     if (!conversationId) {
17:       return NextResponse.json({ error: 'Missing required parameter: conversationId' }, { status: 400 });
18:     }
19: 
20:     const ctx = await requireConversationParticipant(conversationId);
21:     if (isAuthzFailure(ctx)) {
22:       return ctx.errorResponse;
23:     }
24: 
25:     const conversationRepository: IConversationRepository = new SupabaseConversationRepository(ctx.serviceClient);
26: 
27:     // Get user's preferences for this conversation
28:     const preferences = await conversationRepository.getUserPreference(conversationId, ctx.dbUser.id);
29: 
30:     if (!preferences) {
31:       // Return default preferences if none exist
32:       return NextResponse.json({
33:         preferences: {
34:           isPinned: false,
35:           pinnedOrder: null,
36:           isStarred: false,
37:           isArchived: false,
38:           notificationsEnabled: true,
39:         },
40:       });
41:     }
42: 
43:     return NextResponse.json({
44:       preferences: {
45:         ...preferences,
46:         createdAt: preferences.createdAt.toISOString(),
47:         updatedAt: preferences.updatedAt.toISOString(),
48:       },
49:     });
50:   } catch (error) {
51:     console.error('Error getting conversation preferences:', error);
52:     return NextResponse.json({ error: 'Internal Server Error' }, { status: 500 });
53:   }
54: }
