40: /**
41:  * Phase 5 T17 (FR-023, BR-010, AC-023, AC-037): the composer's "@" mention
42:  * list. Typing "@" (at the start or after a space) offers the conversation's
43:  * current members except the viewer — the members route roster
44:  * (`useConversationMembers`, T4/T15), so a removed or never-joined user is
45:  * never offered — filtered as the user types. Arrows move, Enter/Tab choose,
46:  * Escape closes it (until the caret leaves that "@"), and the mouse picks an
47:  * option. A chosen member is inserted as "@<name> " and stays a mention while
48:  * that token is intact; "@name" typed without choosing is plain text.
49:  * `mentionIds` is what the send carries (users.id, sorted).
50:  */
51: export function useComposerMentions({
52:   conversationId,
53:   viewerId,
54:   content,
55:   setContent,
56:   textareaRef,
57: }: UseComposerMentionsOptions) {
58:   const listId = useId();
59:   const { data: roster, refetch: refetchRoster } = useConversationMembers(conversationId, viewerId);
60:   const candidates = useMemo<MentionCandidate[]>(
61:     () =>
62:       (roster ?? [])
63:         .filter((member) => member.userId !== viewerId)
64:         .map((member) => ({ userId: member.userId, label: mentionLabel(member.displayName) })),
65:     [roster, viewerId]
66:   );
67: 
68:   // Chosen mentions belong to the draft of one conversation, and only while
69:   // their token is still in the text (render-time adjustment, no effect).
70:   const [chosen, setChosen] = useState<{ conversationId: string | null; mentions: MentionCandidate[] }>(() => ({
71:     conversationId,
72:     mentions: [],
73:   }));
74:   const current = chosen.conversationId === conversationId ? chosen.mentions : [];
75:   const mentions = current.filter((mention) => hasMentionToken(content, mention.label));
76:   if (chosen.conversationId !== conversationId || mentions.length !== chosen.mentions.length) {
77:     setChosen({ conversationId, mentions });
78:   }
79: 
80:   const [caret, setCaret] = useState<number | null>(null);
81:   const [focused, setFocused] = useState(false);
82:   // An "@" closed with Escape stays closed until the caret leaves it.
83:   const [dismissedStart, setDismissedStart] = useState<number | null>(null);
84:   const [active, setActive] = useState<{ key: string; index: number }>({ key: '', index: 0 });
85: 
86:   const trigger = focused && caret !== null ? findMentionQuery(content, caret) : null;
87:   if (dismissedStart !== null && trigger?.start !== dismissedStart) {
88:     setDismissedStart(null);
89:   }
90:   const options =
91:     trigger && trigger.start !== dismissedStart ? filterMentionCandidates(candidates, trigger.query) : [];
92:   const isOpen = options.length > 0;
93:   const activeKey = trigger ? `${trigger.start}:${trigger.query}` : '';
94:   const activeIndex = isOpen && active.key === activeKey ? Math.min(active.index, options.length - 1) : 0;
95:   const optionId = useCallback((index: number) => `${listId}-option-${index}`, [listId]);
96: 
97:   // Block C fix F6: each "@" query that opens re-reads the roster (the cached
98:   // one shows meanwhile). Another member joining or coming back sends this
99:   // viewer no event (RLS shows only the viewer's own member rows), so any
100:   // cached roster may be stale here; removals also refresh it live
101:   // (useConversationRealtime). Already submitted sends keep their ids.
102:   const triggerStart = trigger?.start ?? null;
103:   useEffect(() => {
104:     if (triggerStart === null || !conversationId || !viewerId) return;
105:     void refetchRoster({ cancelRefetch: false });
106:   }, [conversationId, refetchRoster, triggerStart, viewerId]);
107: 
108:   // The caret goes after an inserted mention once React has written the text.
109:   const pendingCaretRef = useRef<number | null>(null);
110:   useLayoutEffect(() => {
111:     const position = pendingCaretRef.current;
112:     const textarea = textareaRef.current;
113:     if (position === null || !textarea || textarea.value !== content) return;
114:     pendingCaretRef.current = null;
115:     textarea.focus();
116:     textarea.setSelectionRange(position, position);
117:   }, [content, textareaRef]);
118: 
119:   const choose = useCallback(
120:     (candidate: MentionCandidate) => {
121:       if (!trigger) return;
122:       const end = trigger.start + 1 + trigger.query.length;
123:       const next = insertMention(content, trigger.start, end, candidate.label);
124:       setChosen((state) => ({
125:         conversationId,
126:         mentions: [
127:           ...(state.conversationId === conversationId ? state.mentions : []).filter(
128:             (mention) => mention.userId !== candidate.userId
129:           ),
130:           candidate,
131:         ],
132:       }));
133:       pendingCaretRef.current = next.caret;
134:       setCaret(next.caret);
135:       setContent(next.text);
136:     },
137:     [content, conversationId, setContent, trigger]
138:   );
139: 
140:   const setActiveIndex = useCallback(
141:     (index: number) => setActive({ key: activeKey, index }),
142:     [activeKey]
143:   );
144: 
145:   /** Handles the list's keys; returns true when the key was used by the list. */
146:   const handleKeyDown = (event: React.KeyboardEvent<HTMLTextAreaElement>): boolean => {
147:     if (!isOpen || !trigger) return false;
148:     // Block C fix F7: keys that confirm or move within an IME composition are the IME's.
149:     if (event.nativeEvent.isComposing || event.keyCode === 229) return false;
