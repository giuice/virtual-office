824: -- membership: users -> spaces, the Presence order), THEN the conversation —
825: -- the order of a space DELETE, which locks the space and then, through
826: -- ON DELETE SET NULL, its room conversation. The conversation is re-read
827: -- under its lock and must still belong to the authorized room.
828: create or replace function public.join_room_conversation(p_conversation_id uuid, p_user_id uuid)
829: returns boolean
830: language plpgsql
831: security definer
832: set search_path = ''
833: as $$
