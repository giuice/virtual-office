63: // Deterministic output whatever launched the runner (a terminal, a pipe, a
64: // file redirect, NO_COLOR in the shell): Next colours its log lines only when
65: // NO_COLOR is absent and FORCE_COLOR is set or stdout is a TTY — and the
66: // server's stdout is always this pipe. Colour on, so raw lines keep their
67: // escape codes.
68: // (Windows environment names are case-insensitive, so match them that way.)
69: const serverEnvironment = Object.fromEntries(
70:   Object.entries(process.env).filter(([name]) => !['NO_COLOR', 'FORCE_COLOR'].includes(name.toUpperCase())),
71: );
72: serverEnvironment.FORCE_COLOR = '1';
73: 
74: // `command` is the Node binary path or a script given by the config, never user
75: // input; no shell is involved.
76: const child = spawn(command === 'node' ? process.execPath : command, args, {
77:   stdio: ['ignore', 'pipe', 'pipe'],
78:   env: serverEnvironment,
79:   windowsHide: true,
80: });
81: 
82: const drained = Promise.all([tee(child.stdout, process.stdout), tee(child.stderr, process.stderr)]);
83: 
84: for (const signal of ['SIGINT', 'SIGTERM']) {
85:   process.on(signal, () => {
86:     child.kill(signal);
87:   });
88: }
89: 
90: child.once('error', (error) => {
91:   console.error(`[server-log-tee] Failed to start the server: ${error.message}`);
92:   process.exitCode = 1;
93: });
94: 
95: child.once('exit', async (code, signal) => {
96:   await drained;
97:   closeSync(fd);
98:   process.exit(code ?? (signal ? 1 : 0));
99: });

