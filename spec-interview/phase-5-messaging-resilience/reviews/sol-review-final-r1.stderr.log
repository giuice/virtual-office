56: /** Messages read from just before the INSERT's time to find it (a 1 ms window holds far fewer). */
57: const AUTHORIZATION_READ_LIMIT = 20;
58: 
59: /**
60:  * Phase 5 T18 (FR-025, BR-011): the message as the server shows it to the
61:  * browser's signed-in user now. The feed route checks membership under that
62:  * session (403 for a removed or never-member user) and carries the stored
63:  * mentions, which live INSERTs lack (TRACK T4). Null when refused, not found,
64:  * or the read failed: nothing is announced.
65:  */
66: async function readAuthorizedMessage(message: Message): Promise<Message | null> {
67:   const sentAt = new Date(message.timestamp).getTime();
68:   if (!Number.isFinite(sentAt)) return null;
69:   try {
70:     const { messages } = await messagingApi.getMessages(message.conversationId, {
71:       limit: AUTHORIZATION_READ_LIMIT,
72:       // Newer than 1 ms before the INSERT's time (ms precision; the server keeps µs).
73:       cursorAfter: new Date(sentAt - 1).toISOString(),
74:       source: 'notification',
75:     });
76:     return messages.find((candidate) => candidate.id === message.id) ?? null;
77:   } catch {
78:     return null;
79:   }
80: }
