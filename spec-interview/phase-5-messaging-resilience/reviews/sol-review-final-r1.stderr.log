430: /**
431:  * When the page received each conversation_members DELETE on its Realtime
432:  * sockets (the list stream's removal signal; every subscriber gets every
433:  * DELETE). Start before the page navigates.
434:  */
435: function watchMembershipDeletes(page: Page): number[] {
436:   const receivedAt: number[] = [];
437:   page.on('websocket', (socket) => {
438:     if (!socket.url().includes('/realtime/v1/websocket')) return;
439:     socket.on('framereceived', ({ payload }) => {
440:       if (typeof payload === 'string' && payload.includes('conversation_members') && 
payload.includes('"DELETE"')) {
441:         receivedAt.push(Date.now());
442:       }
443:     });
444:   });
445:   return receivedAt;
446: }
