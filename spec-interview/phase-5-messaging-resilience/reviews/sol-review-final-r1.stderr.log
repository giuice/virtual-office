28: stable
29: security definer
30: set search_path = public, pg_temp
31: as $$
32:   select exists (
33:     select 1
34:     from public.conversation_members cm
35:     where cm.conversation_id = p_conversation_id
36:       and cm.user_id = private.current_app_user_id()
37:   )
38: $$;
39: 
40: comment on function private.is_conversation_member is
41:   'True when the current authenticated app user is a member of the conversation (conversation_members).';
42: 
43: revoke all on function private.is_conversation_member(uuid) from public;
44: grant execute on function private.is_conversation_member(uuid) to authenticated, service_role;
45: 
46: -- ============================================================================
47: -- 2) conversations
48: -- ============================================================================
49: drop policy if exists "read_own_conversations" on public.conversations;
