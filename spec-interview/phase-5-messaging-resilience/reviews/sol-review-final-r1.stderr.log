1: // src/app/api/conversations/members/route.ts
2: import { NextRequest, NextResponse } from 'next/server';
3: import { z } from 'zod';
4: import { IConversationRepository, NotParticipantError } from '@/repositories/interfaces';
5: import { SupabaseConversationRepository } from '@/repositories/implementations/supabase';
6: import { isAuthzFailure, jsonError, requireConversationParticipant } from '@/lib/auth/authorize';
7: 
8: const conversationIdSchema = z.guid();
9: 
10: /**
11:  * GET /api/conversations/members?conversationId= — Phase 5 T4 (FR-023).
12:  *
13:  * The conversation's CURRENT members (conversation_members; a removed member
14:  * is not listed), for the mention autocomplete:
15:  * { members: [{ userId, displayName, avatarUrl }] } — userId is users.id; the
16:  * caller is included (the composer leaves itself out).
17:  *
18:  * Only a current member gets the list: non-member (including a member who
19:  * left) or missing conversation → 403 NOT_PARTICIPANT; no session → 401;
20:  * invalid conversationId → 400. The read runs with the caller's own session
21:  * (public.list_conversation_members re-checks membership for auth.uid()).
22:  */
23: export async function GET(request: NextRequest) {
24:   try {
25:     const parsed = conversationIdSchema.safeParse(new URL(request.url).searchParams.get('conversationId') ?? 
undefined);
26:     if (!parsed.success) {
27:       return jsonError(400, 'BAD_REQUEST', 'conversationId must be a UUID');
28:     }
29:     const conversationId = parsed.data.toLowerCase();
30: 
31:     const ctx = await requireConversationParticipant(conversationId, { missingConversationAsNotParticipant: true 
});
32:     if (isAuthzFailure(ctx)) {
33:       return ctx.errorResponse;
34:     }
35: 
36:     // User-scoped client: the database answers only a current member.
37:     const conversationRepository: IConversationRepository = new SupabaseConversationRepository(ctx.supabase);
38:     let members;
39:     try {
40:       members = await conversationRepository.listMembers(conversationId);
41:     } catch (error) {
42:       if (error instanceof NotParticipantError) {
43:         // Removed between the check above and the read.
44:         return jsonError(403, 'NOT_PARTICIPANT', 'You are not a participant of this conversation');
45:       }
46:       throw error;
47:     }
48: 
49:     return NextResponse.json({ members }, { status: 200, headers: { 'Cache-Control': 'private, no-store' } });
50:   } catch (error) {
51:     console.error('Error listing conversation members:', error);
52:     return jsonError(500, 'INTERNAL_ERROR', 'Failed to list conversation members');
53:   }
54: }


