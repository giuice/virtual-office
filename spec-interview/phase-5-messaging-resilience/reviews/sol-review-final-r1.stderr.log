src/lib/messaging/outbox/outbox-sign-out.ts
1: // src/lib/messaging/outbox/outbox-sign-out.ts
2: // Phase 5 T12 (FR-013, BR-008): the outbox side of an explicit sign-out.
3: //
4: // - countUnsentOutboxItems(): the owner's unsent items in this browser (every
5: //   conversation and tab: they share one IndexedDB outbox), for the "Sair"
6: //   confirmation.
7: // - beginOutboxSignOut(): "Sair mesmo". Stops every outbox instance of the
8: //   owner in every tab of the browser FIRST — this tab's at once, the others
9: //   through the owner's BroadcastChannel — then waits (bounded) until no tab
10: //   holds a drain lock of the owner, so no drain is between a claim and its
11: //   request, and only then deletes every item of the owner and clears the
12: //   pending views. The caller then runs the existing sign-out (Presence
13: //   logout sequence unchanged) and calls release() whatever its outcome:
14: //   every tab then lets the browser's identity decide again (held while
15: //   signed out; resumed, with an empty outbox, if the sign-out failed).
16: // Late create/fence responses cannot bring an item back: they are ignored
17: // while stopped, and an update never creates a missing item.
18: // Block A fix F2: both the count and the deletion first check that the
19: // browser is signed in as the owner (`isOwner`); otherwise — a stale tab of
20: // the owner whose browser now holds another user's session, or none — the
21: // count is 0 and nothing is deleted: that user's sign-out never touches the
22: // owner's items.
23: import type { QueryClient } from '@tanstack/react-query';
24: 
25: import { debugLogger } from '@/utils/debug-logger';
26: import { deleteAllOutboxItems, listOutboxItems } from './outbox-db';
27: import { MessageOutbox, outboxChannelName, outboxDrainLockPrefix } from './message-outbox';
28: import { recordCancelledMetrics } from './outbox-metrics';
29: import { clearOutboxViews } from './outbox-view';
30: 
31: /** Longest wait for other tabs' drains to stop (a hung tab cannot delay the sign-out longer). */
32: const DRAIN_STOP_WAIT_MS = 3_000;
33: /**
34:  * Longest wait for one outbox read or delete before the sign-out: an
35:  * IndexedDB open or transaction that never settles must not keep the user
36:  * signed in (local storage never blocks the sign-out).
37:  */
38: const STORAGE_WAIT_MS = 3_000;
39: const SCOPE = 'OutboxSignOut';
40: 
41: class OutboxSignOutTimeoutError extends Error {
42:   constructor(step: string) {
43:     super(`The outbox ${step} did not finish in time`);
44:     this.name = 'OutboxSignOutTimeoutError';
45:   }
46: }
47: 
48: /** `work`, or a rejection after `ms` (the work itself is not cancelled). */
49: function within<T>(work: Promise<T>, ms: number, step: string): Promise<T> {
50:   let timer: ReturnType<typeof setTimeout> | null = null;
51:   const timeout = new Promise<never>((_resolve, reject) => {
52:     timer = setTimeout(() => reject(new OutboxSignOutTimeoutError(step)), ms);
53:   });
54:   return Promise.race([work, timeout]).finally(() => {
55:     if (timer) clearTimeout(timer);
56:   });
57: }
58: 
59: export interface OutboxSignOut {
60:   /**
61:    * Waits (at most 3 s) for the drains to stop, then deletes every item of the
62:    * owner if the browser is still signed in as the owner (F2; else deletes
63:    * nothing); rejects if the delete fails or takes more than 3 s.
64:    */
65:   discard(): Promise<void>;
66:   /** The sign-out ended (or failed): every tab's outbox follows the browser's identity again. Idempotent. */
67:   release(): void;
68: }
69: 
70: /** Whether the browser is signed in as the owner now (its users.supabase_uid), read from its session. */
71: export type OutboxOwnerCheck = () => Promise<boolean>;
72: 
73: /**
74:  * The owner's unsent outbox items in this browser (all conversations, all
75:  * tabs); 0 unless the browser is signed in as the owner (F2). Rejects when
76:  * the identity check or the read takes more than 3 s.
77:  */
78: export async function countUnsentOutboxItems(ownerId: string, isOwner: OutboxOwnerCheck): Promise<number> {
79:   if (!(await within(isOwner(), STORAGE_WAIT_MS, 'identity check'))) return 0;
80:   const items = await within(listOutboxItems(ownerId), STORAGE_WAIT_MS, 'read');
81:   // F3: a retired item is already delivered.
82:   return items.filter((item) => !item.retired).length;
83: }
84: 
85: /** Waits until no tab holds (or waits for) a drain lock of the owner, at most `maxMs`. */
86: async function waitForDrainsToStop(ownerId: string, maxMs: number): Promise<void> {
87:   const locks = typeof navigator !== 'undefined' ? navigator.locks : undefined;
88:   if (!locks) return;
89:   const prefix = outboxDrainLockPrefix(ownerId);
90:   let names: string[];
91:   try {
92:     const snapshot = await locks.query();
93:     names = [...(snapshot.held ?? []), ...(snapshot.pending ?? [])]
94:       .map((lock) => lock.name ?? '')
95:       .filter((name) => name.startsWith(prefix));
96:   } catch {
97:     return;
98:   }
99:   const deadline = AbortSignal.timeout(maxMs);
100:   // Taking each lock in turn means its holder's drain loop has returned.
101:   await Promise.allSettled([...new Set(names)].map((name) => locks.request(name, { signal: deadline }, async () 
=> undefined)));
102: }
103: 
104: /** "Sair mesmo": stops every drain of the owner in this browser now (see the file header). */
105: export function beginOutboxSignOut(ownerId: string, queryClient: QueryClient, isOwner: OutboxOwnerCheck): 
OutboxSignOut {
106:   const local = MessageOutbox.liveFor(ownerId);
107:   local.forEach((outbox) => outbox.stopForSignOut());
108:   const channel = typeof BroadcastChannel !== 'undefined' ? new BroadcastChannel(outboxChannelName(ownerId)) : 
null;
109:   const post = (message: { signOutStop: true } | { signOutDone: true }) => {
110:     try {
111:       channel?.postMessage(message);
112:     } catch {
113:       // The other tabs then stop on the auth change (signed out) or their stop expires.
114:     }
115:   };
116:   post({ signOutStop: true });
117:   clearOutboxViews(queryClient, ownerId);
118:   let released = false;
119:   return {
120:     async discard() {
121:       // Past the wait the delete goes ahead anyway (a frozen tab cannot hold the sign-out).
122:       await within(waitForDrainsToStop(ownerId, DRAIN_STOP_WAIT_MS), DRAIN_STOP_WAIT_MS + 500, 'drain 
stop').catch(
123:         () => undefined
124:       );
