381: declare
382:   v_ac jsonb := p_space.access_control;
383:   v_users jsonb;
384:   v_roles jsonb;
385:   v_truthy boolean;
386:   v_public boolean;
387: begin
388:   if p_space.company_id is not null
389:      and p_user.company_id is not null
390:      and p_space.company_id <> p_user.company_id then
391:     return 'COMPANY_MISMATCH';
392:   end if;
393: 
394:   -- `if (accessControl)`: a falsy value (null, false, 0, "") skips every
395:   -- access-control check.
396:   v_truthy := private.jsonb_js_truthy(v_ac);
397:   if v_truthy is null then
398:     return 'ROOM_ACL_INVALID';
399:   end if;
400:   if not v_truthy then
401:     return null;
402:   end if;
403:   if pg_catalog.jsonb_typeof(v_ac) <> 'object' then
404:     -- A truthy JavaScript non-object (true, string, number, array) has no
405:     -- such properties.
406:     v_ac := '{}'::jsonb;
407:   end if;
408: 
409:   v_users := v_ac -> 'allowedUsers';
410:   v_roles := v_ac -> 'allowedRoles';
411:   if v_users is null or pg_catalog.jsonb_typeof(v_users) = 'null' then
412:     v_users := '[]'::jsonb;
413:   end if;
414:   if v_roles is null or pg_catalog.jsonb_typeof(v_roles) = 'null' then
415:     v_roles := '[]'::jsonb;
416:   end if;
417:   if pg_catalog.jsonb_typeof(v_users) <> 'array' or pg_catalog.jsonb_typeof(v_roles) <> 'array' then
418:     return 'ROOM_ACL_INVALID';
419:   end if;
420: 
421:   if pg_catalog.jsonb_array_length(v_users) > 0 and not (v_users ? (p_user.id)::text) then
422:     return 'NOT_ALLOWED_USER';
423:   end if;
424:   if pg_catalog.jsonb_array_length(v_roles) > 0
425:      and p_user.role is not null
426:      and not (v_roles ? (p_user.role)::text) then
427:     return 'NOT_ALLOWED_ROLE';
428:   end if;
429: 
430:   v_public := private.jsonb_js_truthy(v_ac -> 'isPublic');
431:   if v_public is null then
432:     return 'ROOM_ACL_INVALID';
433:   end if;
434:   if not v_public
435:      and pg_catalog.jsonb_array_length(v_users) = 0
436:      and pg_catalog.jsonb_array_length(v_roles) = 0
437:      and p_user.company_id is null then
438:     return 'PRIVATE_NO_COMPANY';
439:   end if;
440: 
441:   return null;
442: end;
443: $$;
