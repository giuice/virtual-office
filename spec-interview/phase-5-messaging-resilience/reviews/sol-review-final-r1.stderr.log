138: export const MESSAGING_METRIC_TYPE_RULES: Readonly<Record<MessagingMetricType, MessagingMetricTypeRule>> = {
139:   send_latency: SEND_DURATION,
140:   outbox_wait: SEND_DURATION,
141:   send_outcome: {
