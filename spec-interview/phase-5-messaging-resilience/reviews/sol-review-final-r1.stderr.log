93: function captureLoadBaseline(userId: string, conversations: Conversation[]): LoadBaseline {
94:   const lastActivityByConversation = new Map<string, number>();
95:   for (const conversation of conversations) {
96:     const at = new Date(conversation.lastActivity).getTime();
97:     if (Number.isFinite(at)) lastActivityByConversation.set(conversation.id, at);
98:   }
99:   return { userId, lastActivityByConversation };
100: }
