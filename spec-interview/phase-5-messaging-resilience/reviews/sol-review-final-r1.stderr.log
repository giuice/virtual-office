1: // src/hooks/useMessageOutbox.ts
2: // Phase 5 T8: runs the signed-in user's durable message outbox (one per
3: // application user, users.id) for as long as the messaging provider is
4: // mounted, and returns the function that queues a text/reply send — plus
5: // (T27) "Tentar de novo" and "Apagar" for a failed or expired item, and
6: // (T10) "Cancelar" for a never-dispatched waiting item, and (T12) the count
7: // and deletion behind the "Sair" confirmation. T11: the outbox sends
8: // and applies responses only while the browser's authenticated user is its
9: // owner (users.id `ownerId`, whose auth identity is `ownerAuthUid`, that
10: // user's users.supabase_uid).
11: import { useCallback, useEffect, useMemo, useRef } from 'react';
12: import { useQueryClient } from '@tanstack/react-query';
13: 
14: import { MessageOutbox } from '@/lib/messaging/outbox/message-outbox';
15: import { createOutboxIdentity } from '@/lib/messaging/outbox/outbox-identity';
16: import {
17:   beginOutboxSignOut,
18:   countUnsentOutboxItems,
19:   type OutboxSignOut,
20: } from '@/lib/messaging/outbox/outbox-sign-out';
21: import type { OutboxEnqueueInput } from '@/types/message-outbox';
22: 
23: export type QueueTextMessage = (input: OutboxEnqueueInput) => Promise<void>;
24: 
25: export interface MessageOutboxActions {
26:   queueTextMessage: QueueTextMessage;
27:   /** "Tentar de novo" on a failed or expired item (by its clientMessageId). */
28:   retryOutboxMessage: (clientMessageId: string) => Promise<void>;
29:   /** "Apagar": removes a failed or expired item from this browser only. */
30:   discardOutboxMessage: (clientMessageId: string) => Promise<void>;
31:   /** "Cancelar" (T10): removes a never-dispatched waiting item in every tab, unless a claim won. */
32:   cancelOutboxMessage: (clientMessageId: string) => Promise<void>;
33:   /**
34:    * T12: the signed-in user's unsent items in this browser (0 when there is no
35:    * outbox user, or the browser is not signed in as that user — F2).
36:    */
37:   countUnsentOutboxMessages: () => Promise<number>;
38:   /**
39:    * T12 "Sair mesmo": stops every drain of the user in every tab now; then
40:    * `discard()` deletes the user's outbox and `release()` ends the stop once
41:    * the sign-out finished. Null when there is no outbox user.
42:    */
43:   beginOutboxSignOut: () => OutboxSignOut | null;
44:   /**
45:    * T13 (FR-002): the messages Realtime stream recovered; every conversation
46:    * drains again (owner check and sign-out stop still apply). No-op without an outbox.
47:    */
48:   resumeOutboxDrains: () => void;
49:   /**
50:    * Block B fix F3: this tab's Realtime socket is down — a connectivity loss
51:    * whose recovery (resumeOutboxDrains) advances the owner's shared recovery
52:    * epoch. No-op without an outbox.
53:    */
54:   noteOutboxConnectivityLost: () => void;
55: }
56: 
57: export function useMessageOutbox(
58:   ownerId: string | null | undefined,
59:   ownerAuthUid: string | null | undefined
60: ): MessageOutboxActions {
61:   const queryClient = useQueryClient();
62:   const outboxRef = useRef<MessageOutbox | null>(null);
63: 
64:   // The browser's authenticated user compared with the owner (T11); also gates
65:   // the sign-out count and deletion (block A fix F2).
66:   const identity = useMemo(() => (ownerAuthUid ? createOutboxIdentity(ownerAuthUid) : null), [ownerAuthUid]);
67: 
68:   useEffect(() => {
69:     if (!ownerId || !identity) return;
70:     const outbox = new MessageOutbox(ownerId, queryClient, identity);
71:     outboxRef.current = outbox;
72:     outbox.start();
73:     return () => {
74:       outbox.dispose();
75:       if (outboxRef.current === outbox) outboxRef.current = null;
76:     };
77:   }, [ownerId, identity, queryClient]);
78: 
79:   const currentOutbox = useCallback((): MessageOutbox => {
80:     const outbox = outboxRef.current;
81:     if (!outbox || outbox.ownerId !== ownerId) {
82:       throw new Error('The message outbox is not ready');
83:     }
84:     return outbox;
85:   }, [ownerId]);
86: 
87:   const queueTextMessage = useCallback(
88:     async (input: OutboxEnqueueInput) => {
89:       await currentOutbox().enqueue(input);
90:     },
91:     [currentOutbox]
92:   );
93:   const retryOutboxMessage = useCallback(
94:     async (clientMessageId: string) => {
95:       await currentOutbox().retry(clientMessageId);
96:     },
97:     [currentOutbox]
98:   );
99:   const discardOutboxMessage = useCallback(
100:     async (clientMessageId: string) => {
101:       await currentOutbox().discard(clientMessageId);
102:     },
103:     [currentOutbox]
104:   );
105:   const cancelOutboxMessage = useCallback(
106:     async (clientMessageId: string) => {
107:       await currentOutbox().cancel(clientMessageId);
108:     },
109:     [currentOutbox]
110:   );
111: 
112:   // T12: read from and act on the outbox database by owner (users.id), so they
113:   // work whether or not this tab's instance has started — only while the
114:   // browser is signed in as the owner (F2: a stale tab's other user gets 0
115:   // and deletes nothing).
116:   const isOwner = useCallback(
117:     async () => (identity ? (await identity.check()) === 'owner' : false),
118:     [identity]
119:   );
120:   const countUnsentOutboxMessages = useCallback(
121:     async () => (ownerId ? countUnsentOutboxItems(ownerId, isOwner) : 0),
122:     [ownerId, isOwner]
123:   );
124:   const resumeOutboxDrains = useCallback(() => {
125:     const outbox = outboxRef.current;
126:     if (outbox && outbox.ownerId === ownerId) outbox.resumeDrains();
127:   }, [ownerId]);
128:   const noteOutboxConnectivityLost = useCallback(() => {
129:     const outbox = outboxRef.current;
130:     if (outbox && outbox.ownerId === ownerId) outbox.noteConnectivityLost('realtime');
131:   }, [ownerId]);
132:   const beginSignOut = useCallback(
133:     () => (ownerId ? beginOutboxSignOut(ownerId, queryClient, isOwner) : null),
134:     [ownerId, queryClient, isOwner]
135:   );
136: 
137:   return useMemo(
138:     () => ({
139:       queueTextMessage,
140:       retryOutboxMessage,
141:       discardOutboxMessage,
142:       cancelOutboxMessage,
143:       countUnsentOutboxMessages,
144:       beginOutboxSignOut: beginSignOut,
145:       resumeOutboxDrains,
146:       noteOutboxConnectivityLost,
147:     }),
148:     [
149:       queueTextMessage,
150:       retryOutboxMessage,
151:       discardOutboxMessage,
152:       cancelOutboxMessage,
153:       countUnsentOutboxMessages,
154:       beginSignOut,
155:       resumeOutboxDrains,
156:       noteOutboxConnectivityLost,
157:     ]
158:   );
159: }


src/lib/messaging/outbox/outbox-outcome.ts
1: // src/lib/messaging/outbox/outbox-outcome.ts
2: // Phase 5 T8: outcome classes of one outbox attempt (BR-005).
3: import type { Message } from '@/types/messaging';
4: import type { OutboxFailureReason } from '@/types/message-outbox';
5: import { parseStoredMessage, type AttemptedItem } from './outbox-ack';
6: 
7: export type { AttemptedItem } from './outbox-ack';
8: 
9: /**
10:  * T19: why a create or fence got no answer — its own deadline (`timeout`),
11:  * aborted because connectivity returned or failed while the browser is
12:  * offline (`offline`), or any other network failure (`network`). Metrics only.
13:  */
14: export type OutboxRequestFailure = 'timeout' | 'offline' | 'network';
15: 
16: export type OutboxAttemptOutcome =
17:   /** Stored (201) or replayed (200); `message` is null when it was deleted since (410). */
18:   | { kind: 'delivered'; message: Message | null }
19:   /** 429 / 401: retried automatically, in order (FR-008; 401 vs session end → T11). */
20:   | { kind: 'transient'; status: number }
21:   /**
22:    * No usable response (network error, 5xx, any 2xx without this item's
23:    * stored message — e.g. a 204 or a malformed body): it may be stored, so the
24:    * item is kept and sent again.
25:    */
26:   | { kind: 'unknown'; status: number | null; failure?: OutboxRequestFailure }
27:   /** 409 ATTEMPT_SUPERSEDED: a newer attempt of the key exists; ignored. */
28:   | { kind: 'superseded' }
29:   /** Definitive 4xx: no automatic retry (FR-007). */
30:   | { kind: 'failed'; status: number; reason: OutboxFailureReason }
31:   /** Fenced as not stored after its 24 h delivery window: never sent automatically (FR-009). */
32:   | { kind: 'expired' };
33: 
34: /** What a fence (T27, FR-006) says about an item whose earlier attempt may be stored. */
35: export type OutboxFenceOutcome =
36:   /** Stored under the key (`message` null when deleted since): the item is delivered. */
37:   | { kind: 'delivered'; message: Message | null }
38:   /** Nothing stored, and no older attempt can commit any more. */
39:   | { kind: 'not_stored' }
40:   /**
41:    * Definitive refusal, e.g. 403 NOT_PARTICIPANT after access was lost: the
42:    * item fails (BR-005) — it is never treated as not stored (no expiry, no
43:    * cancel, no create).
44:    */
45:   | { kind: 'failed'; status: number; reason: OutboxFailureReason }
46:   /**
47:    * Still unknown: no response, 5xx, 429/401, a newer generation exists
48:    * (409 ATTEMPT_SUPERSEDED), or a 200 that is not this item's answer. The
49:    * item stays unknown and is fenced again later.
50:    */
51:   | { kind: 'unknown'; status: number | null; failure?: OutboxRequestFailure };
52: 
53: export function classifyFenceResponse(
54:   response: { status: number; code?: string; outcome?: string; message?: unknown },
55:   item: AttemptedItem
56: ): OutboxFenceOutcome {
57:   const { status, code, outcome, message } = response;
58:   if (status === 200 && outcome === 'not_stored') return { kind: 'not_stored' };
59:   if (status === 200 && outcome === 'stored') {
60:     if (message === null) return { kind: 'delivered', message: null };
61:     const stored = parseStoredMessage(message, item);
62:     return stored ? { kind: 'delivered', message: stored } : { kind: 'unknown', status };
63:   }
64:   if (status >= 400 && status < 500 && status !== 401 && status !== 429 && status !== 409) {
65:     return { kind: 'failed', status, reason: failureReason(status, code) };
66:   }
67:   return { kind: 'unknown', status };
68: }
69: 
70: export function classifyAttemptResponse(
71:   response: { status: number; code?: string; message?: unknown },
72:   item: AttemptedItem
73: ): OutboxAttemptOutcome {
74:   const { status, code, message } = response;
75:   if (status >= 200 && status < 300) {
76:     // Only 200/201 carrying this item's stored message (outbox-ack) confirm it.
77:     const stored = status === 200 || status === 201 ? parseStoredMessage(message, item) : null;
78:     return stored ? { kind: 'delivered', message: stored } : { kind: 'unknown', status };
79:   }
80:   if (status === 410 && code === 'MESSAGE_DELETED') return { kind: 'delivered', message: null };
81:   if (status === 429 || status === 401) return { kind: 'transient', status };
82:   if (status >= 500 || status < 200 || (status >= 300 && status < 400)) return { kind: 'unknown', status };
83:   if (status === 409 && code === 'ATTEMPT_SUPERSEDED') return { kind: 'superseded' };
84:   return { kind: 'failed', status, reason: failureReason(status, code) };
85: }
86: 
87: function failureReason(status: number, code: string | undefined): OutboxFailureReason {
88:   if (status === 403 && code === 'SENDER_MISMATCH') return 'sender_mismatch';
89:   if (status === 403) return 'not_participant';
90:   if (status === 409 && code === 'CLIENT_MESSAGE_ID_REUSED') return 'client_message_id_reused';
91:   if (status === 413) return 'content_too_large';
92:   if (status === 400) return 'invalid_request';
93:   return 'rejected';
94: }


src/lib/messaging/outbox/outbox-ack.ts
1: // src/lib/messaging/outbox/outbox-ack.ts
2: // Phase 5 T8: reads a create response's `message` as the stored message of
3: // an outbox item. A response confirms the item only if it parses here; the
4: // result is built from validated fields only (nothing else is copied), so a
5: // malformed response can neither confirm a send nor reach the feed renderers.
6: import {
7:   MessageStatus,
8:   MessageType,
9:   type Message,
10:   type MessageReaction,
11: } from '@/types/messaging';
12: 
13: /** The item an attempt was made for: a confirmation must be its own stored message. */
14: export interface AttemptedItem {
15:   senderId: string;
16:   conversationId: string;
17:   clientMessageId: string;
18: }
19: 
20: const UUID_PATTERN = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
21: const MESSAGE_TYPES = new Set<string>(Object.values(MessageType));
22: const MESSAGE_STATUSES = new Set<string>(Object.values(MessageStatus));
23: 
24: const isUuid = (value: unknown): value is string => typeof value === 'string' && UUID_PATTERN.test(value);
25: 
26: const isPlainObject = (value: unknown): value is Record<string, unknown> =>
27:   typeof value === 'object' && value !== null && !Array.isArray(value);
28: 
29: const parseDate = (value: unknown): Date | null => {
30:   if (typeof value !== 'string' && typeof value !== 'number') return null;
31:   const date = new Date(value);
32:   return Number.isNaN(date.getTime()) ? null : date;
33: };
34: 
35: /** Reactions as the repository maps them: emoji, reacting user (users.id), time. */
36: function parseReactions(value: unknown): MessageReaction[] | null {
37:   if (value === undefined) return [];
38:   if (!Array.isArray(value)) return null;
39:   const reactions: MessageReaction[] = [];
40:   for (const entry of value) {
41:     if (!isPlainObject(entry)) return null;
42:     const timestamp = parseDate(entry.timestamp);
43:     if (typeof entry.emoji !== 'string' || entry.emoji.length === 0 || !isUuid(entry.userId) || !timestamp) {
44:       return null;
45:     }
46:     reactions.push({ emoji: entry.emoji, userId: entry.userId, timestamp });
47:   }
48:   return reactions;
49: }
50: 
51: /** Stored mentions (users.id); absent on responses that carry none. */
52: function parseMentionedUserIds(value: unknown): string[] | undefined | null {
53:   if (value === undefined) return undefined;
54:   if (!Array.isArray(value) || !value.every(isUuid)) return null;
55:   return [...value];
56: }
57: 
58: /**
59:  * The stored message of `item` in the feed's shape, or null when `raw` is not
60:  * one. Correlation uses only what never changes for a stored message: a UUID
61:  * `id`, the sender (users.id), the conversation and the composition key
62:  * (case-insensitive). The stored text and reply target are not compared with
63:  * the item's (a replay returns the current row: reply target deleted since,
64:  * edited text), but must be renderable. Every field copied is checked, with
65:  * the shapes the create route returns for a created (201) or replayed (200)
66:  * keyed text message (repository mapper + key):
67:  * - `content` string; `replyToId` absent, null or a UUID;
68:  * - `timestamp` parseable; `type` and `status` known values;
69:  * - `isEdited` absent, null or boolean;
70:  * - `reactions` absent or a list of {emoji string, userId UUID, timestamp};
71:  * - `attachments` absent or empty (an outbox item is text only);
72:  * - `mentionedUserIds` absent or a list of UUIDs;
73:  * - `readCount` absent or a non-negative integer.
74:  * Other fields (pins, stars — the route strips them — or anything else) are
75:  * not copied.
76:  */
77: export function parseStoredMessage(raw: unknown, item: AttemptedItem): Message | null {
78:   if (!isPlainObject(raw)) return null;
79:   const timestamp = parseDate(raw.timestamp);
80:   const reactions = parseReactions(raw.reactions);
81:   const mentionedUserIds = parseMentionedUserIds(raw.mentionedUserIds);
82:   const correlated =
83:     isUuid(raw.id) &&
84:     raw.senderId === item.senderId &&
85:     raw.conversationId === item.conversationId &&
86:     typeof raw.clientMessageId === 'string' &&
87:     raw.clientMessageId.toLowerCase() === item.clientMessageId.toLowerCase();
88:   const renderable =
89:     typeof raw.content === 'string' &&
90:     (raw.replyToId === undefined || raw.replyToId === null || isUuid(raw.replyToId)) &&
91:     timestamp !== null &&
92:     typeof raw.type === 'string' &&
93:     MESSAGE_TYPES.has(raw.type) &&
94:     typeof raw.status === 'string' &&
95:     MESSAGE_STATUSES.has(raw.status) &&
96:     (raw.isEdited === undefined || raw.isEdited === null || typeof raw.isEdited === 'boolean') &&
97:     reactions !== null &&
98:     (raw.attachments === undefined || (Array.isArray(raw.attachments) && raw.attachments.length === 0)) &&
99:     mentionedUserIds !== null &&
100:     (raw.readCount === undefined ||
101:       (typeof raw.readCount === 'number' && Number.isInteger(raw.readCount) && raw.readCount >= 0));
102:   if (!correlated || !renderable || timestamp === null || reactions === null || mentionedUserIds === null) {
103:     return null;
104:   }
105:   return {
106:     id: raw.id as string,
107:     conversationId: item.conversationId,
108:     senderId: item.senderId,
109:     content: raw.content as string,
110:     timestamp,
111:     type: raw.type as MessageType,
112:     status: raw.status as MessageStatus,
113:     replyToId: typeof raw.replyToId === 'string' ? raw.replyToId : undefined,
114:     attachments: [],
115:     reactions,
116:     isEdited: raw.isEdited === true,
117:     clientMessageId: item.clientMessageId.toLowerCase(),
118:     ...(mentionedUserIds !== undefined ? { mentionedUserIds } : {}),
119:     ...(typeof raw.readCount === 'number' ? { readCount: raw.readCount } : {}),
120:   };
121: }


src/lib/messaging/outbox/outbox-view.ts
1: // src/lib/messaging/outbox/outbox-view.ts
2: // Phase 5 T8: renders outbox items through the sender's pending store
3: // (['messages-pending', users.id, conversationId], T7) — the outbox is the
4: // durable source, the pending query only its render view.
5: import type { QueryClient } from '@tanstack/react-query';
6: 
7: import { MessageStatus, MessageType, type Message, type MessageDeliveryState } from '@/types/messaging';
8: import type { OutboxItem } from '@/types/message-outbox';
9: import {
10:   appendMessageToPages,
11:   isMessageDeleted,
12:   isPendingMessage,
13:   keepMessageThroughInflightFetch,
14:   normalizeClientMessageId,
15:   pendingMessagesQueryKey,
16:   PENDING_MESSAGE_ID_PREFIX,
17:   type MessagesInfiniteData,
18: } from '@/lib/messaging/message-cache';
19: 
20: const deliveryStateOf = (item: OutboxItem): MessageDeliveryState => {
21:   switch (item.state) {
22:     case 'waiting':
23:       return 'pending';
24:     case 'failed':
25:       return 'failed';
26:     case 'expired':
27:       return 'expired';
28:     default:
29:       // claimed / unknown: an attempt is (or may still be) in progress (FR-005).
30:       return 'sending';
31:   }
32: };
33: 
34: export function outboxItemToPendingMessage(item: OutboxItem): Message {
35:   const deliveryState = deliveryStateOf(item);
36:   return {
37:     id: `${PENDING_MESSAGE_ID_PREFIX}${item.clientMessageId}`,
38:     conversationId: item.conversationId,
39:     senderId: item.ownerId,
40:     content: item.content,
41:     timestamp: new Date(item.pressedSendAt),
42:     type: MessageType.TEXT,
43:     status: deliveryState === 'failed' || deliveryState === 'expired' ? MessageStatus.FAILED : 
MessageStatus.SENDING,
44:     replyToId: item.replyToId ?? undefined,
45:     reactions: [],
46:     isEdited: false,
47:     clientMessageId: item.clientMessageId,
48:     // Phase 5 T17: the requested mentions render on the sender's pending copy.
49:     ...(item.mentionIds.length > 0 ? { mentionedUserIds: [...item.mentionIds] } : {}),
50:     deliveryState,
51:     cancellable: item.state === 'waiting' && item.attemptGeneration === 0,
52:   };
53: }
54: 
55: /**
56:  * Replaces the outbox copies of a conversation's pending view with `items`
57:  * (in creation order), keeping the pending copies that are not outbox items
58:  * (attachment/voice sends, which are never queued).
59:  */
60: export function writeOutboxView(
61:   queryClient: QueryClient,
62:   ownerId: string,
63:   conversationId: string,
64:   items: readonly OutboxItem[]
65: ): void {
66:   const outboxCopies = [...items].sort((a, b) => a.order - b.order).map(outboxItemToPendingMessage);
67:   const outboxKeys = new Set(outboxCopies.map((message) => message.clientMessageId));
68:   queryClient.setQueryData<Message[]>(pendingMessagesQueryKey(ownerId, conversationId), (current) => {
69:     const others = (current ?? []).filter(
70:       (message) =>
71:         message.deliveryState === undefined && !outboxKeys.has(normalizeClientMessageId(message.clientMessageId) 
?? '')
72:     );
73:     if (others.length === 0) return outboxCopies;
74:     return [...others, ...outboxCopies].sort((a, b) => a.timestamp.getTime() - b.timestamp.getTime());
75:   });
76: }
77: 
78: /**
79:  * T12 (FR-013): empties every pending view of the owner (all conversations),
80:  * for "Sair mesmo". The queries stay (their observers keep working) but hold
81:  * no copy.
82:  */
83: export function clearOutboxViews(queryClient: QueryClient, ownerId: string): void {
84:   queryClient.setQueriesData<Message[]>({ queryKey: ['messages-pending', ownerId] }, []);
85: }
86: 
87: /**
88:  * Shows one just-committed item in its conversation's pending view (added, or
89:  * replacing its earlier copy), without reading the outbox again.
90:  */
91: export function publishOutboxItem(queryClient: QueryClient, item: OutboxItem): void {
92:   const copy = outboxItemToPendingMessage(item);
93:   queryClient.setQueryData<Message[]>(pendingMessagesQueryKey(item.ownerId, item.conversationId), (current) =>
94:     [
95:       ...(current ?? []).filter(
96:         (message) => normalizeClientMessageId(message.clientMessageId) !== item.clientMessageId
97:       ),
98:       copy,
99:     ].sort((a, b) => a.timestamp.getTime() - b.timestamp.getTime())
100:   );
101: }
102: 
103: /**
104:  * The server confirmed the item (`message` stored or replayed; null when it
105:  * was deleted since). As for a direct send (useMessages.sendMessage): unless
106:  * the feed already observed the key or this client saw the message deleted,
107:  * merge the stored message into a loaded (or loading) feed first, then drop
108:  * the pending copy — never two bubbles, never none.
109:  */
110: export function showConfirmedOutboxMessage(
111:   queryClient: QueryClient,
112:   ownerId: string,
113:   conversationId: string,
114:   clientMessageId: string,
115:   message: Message | null
116: ): void {
117:   const pendingKey = pendingMessagesQueryKey(ownerId, conversationId);
118:   const feedKey = ['messages', conversationId] as const;
119:   const unresolved = isPendingMessage(queryClient.getQueryData<Message[]>(pendingKey), clientMessageId);
120:   const feed = queryClient.getQueryCache().find<MessagesInfiniteData>({ queryKey: feedKey, exact: true });
121:   // A feed never loaded is fetched (with this message) when it is opened; a
122:   // cache built from this one message would hide the older history.
123:   const feedPresent = Boolean(feed?.state.data) || feed?.state.fetchStatus === 'fetching';
124:   if (message && unresolved && feedPresent && !isMessageDeleted(queryClient, message.id)) {
125:     const confirmed: Message = {
126:       ...message,
127:       clientMessageId: normalizeClientMessageId(message.clientMessageId) ?? clientMessageId,
128:     };
129:     queryClient.setQueryData<MessagesInfiniteData | undefined>(feedKey, (oldData) =>
130:       appendMessageToPages(oldData, confirmed)
131:     );
132:     keepMessageThroughInflightFetch(queryClient, conversationId, confirmed);
133:   }
134:   queryClient.setQueryData<Message[]>(pendingKey, (current) =>
135:     (current ?? []).filter((pending) => normalizeClientMessageId(pending.clientMessageId) !== clientMessageId)
136:   );
137: }


