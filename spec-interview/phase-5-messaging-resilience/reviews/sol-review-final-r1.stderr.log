487:     const b = await openDevice('B');
488:     await openConversation(b.page, directId);
489:     await waitForRealtimeReady(b.page);
490:     const metrics = trackMetricsRequests(a.page);
491:     const recorder = watchRecorder(a.page);
492:     const errors = watchErrors(a.page);
