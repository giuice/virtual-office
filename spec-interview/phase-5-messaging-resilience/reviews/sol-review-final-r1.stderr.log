237:   private async loadMentionedUserIds(messageIds: readonly string[]): Promise<Map<string, string[]>> {
238:     // Keys lowercase: the database answers with lowercase uuid text.
239:     const byMessageId = new Map<string, string[]>(messageIds.map((id) => [id.toLowerCase(), []]));
240:     const uniqueIds = [...byMessageId.keys()];
241:     const batches: string[][] = [];
242:     for (let start = 0; start < uniqueIds.length; start += MENTION_READ_BATCH_SIZE) {
243:       batches.push(uniqueIds.slice(start, start + MENTION_READ_BATCH_SIZE));
244:     }
245:     const answers = await Promise.all(
246:       batches.map((batch) => this.supabaseClient.rpc('list_message_mentions', { p_message_ids: batch }))
247:     );
248:     for (const { data, error } of answers) {
249:       if (error) {
250:         console.error('Error fetching message mentions:', error);
251:         throw error;
252:       }
253:       if (typeof data !== 'object' || data === null || Array.isArray(data)) {
254:         throw new Error('list_message_mentions returned an unexpected result');
255:       }
256:       for (const [messageId, ids] of Object.entries(data as Record<string, unknown>)) {
257:         const target = byMessageId.get(messageId);
258:         if (!target || !Array.isArray(ids) || ids.some((id) => typeof id !== 'string')) {
259:           throw new Error('list_message_mentions returned an unexpected result');
260:         }
261:         target.push(...(ids as string[]));
262:       }
263:     }
264:     byMessageId.forEach((ids) => ids.sort());
265:     return byMessageId;
266:   }
