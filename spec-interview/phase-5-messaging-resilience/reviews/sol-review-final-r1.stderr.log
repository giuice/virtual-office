21: /** Query key of the sender's pending (not yet confirmed) messages of a conversation. */
22: export const pendingMessagesQueryKey = (userId: string, conversationId: string) =>
23:   ['messages-pending', userId, conversationId] as const;
24: 
25: /** Prefix of a pending message's id (`temp-<clientMessageId>`); never a stored id. */
26: export const PENDING_MESSAGE_ID_PREFIX = 'temp-';
27: 
28: /** A composition key in canonical form (lowercase), or null when absent. */
29: export const normalizeClientMessageId = (value: string | null | undefined): string | null =>
30:   typeof value === 'string' && value.length > 0 ? value.toLowerCase() : null;
31: 
32: const correlationKey = (message: Message): string | null => {
33:   const key = normalizeClientMessageId(message.clientMessageId);
34:   return key ? `${message.senderId}:${key}` : null;
35: };
36: 
37: /**
38:  * Phase 5 FR-034: the pending messages still to show next to the stored feed.
39:  * A pending message is matched to a stored one ONLY by its sender and
40:  * `clientMessageId` (the server stores at most one message per sender,
41:  * conversation and key): once the feed holds the stored message — from a
42:  * Realtime INSERT, a feed fetch or the create response, in any order — the
43:  * pending copy is hidden, so the message is one bubble. Content, timestamps
44:  * and reply targets are never compared; a stored message without a key (an
45:  * unkeyed or pre-Phase-4 create) matches nothing.
46:  */
47: export function visiblePendingMessages(stored: readonly Message[], pending: readonly Message[]): Message[] {
48:   if (pending.length === 0) return [];
49:   const storedKeys = new Set<string>();
50:   for (const message of stored) {
51:     const key = correlationKey(message);
52:     if (key) storedKeys.add(key);
53:   }
54:   return pending.filter((message) => {
55:     const key = correlationKey(message);
56:     return key === null || !storedKeys.has(key);
57:   });
58: }
59: 
60: type StoredMessageObserver = (conversationId: string, stored: readonly Message[]) => void;
61: const storedMessageObservers = new WeakMap<QueryClient, Set<StoredMessageObserver>>();
62: 
63: /**
64:  * Phase 5 T8: calls `observer` with every batch of stored keyed messages
65:  * that resolvePendingMessages sees (a Realtime INSERT, the rendered feed after
66:  * a fetch), so the durable outbox confirms an item the first time its stored
67:  * key is observed from any source. Returns the unsubscribe function.
68:  */
69: export function observeStoredMessages(queryClient: QueryClient, observer: StoredMessageObserver): () => void {
70:   let observers = storedMessageObservers.get(queryClient);
71:   if (!observers) {
72:     observers = new Set();
73:     storedMessageObservers.set(queryClient, observers);
74:   }
75:   observers.add(observer);
76:   return () => {
77:     storedMessageObservers.get(queryClient)?.delete(observer);
78:   };
79: }
80: 
81: /**
82:  * Phase 5 FR-034: retires the sender's pending messages of a conversation
83:  * whose stored message has been observed (`stored`: a Realtime INSERT just
84:  * merged, or the feed as rendered after a fetch). A pending message is
85:  * resolved the first time its key is seen: it is removed from every pending
86:  * list of that conversation, so it is not shown again as "sending" if the
87:  * stored message later leaves the feed (for example a Realtime DELETE). Call
88:  * it only after the stored message is in the feed cache, so no render shows
89:  * neither copy.
90:  */
91: export function resolvePendingMessages(
92:   queryClient: QueryClient,
93:   conversationId: string,
94:   stored: readonly Message[]
95: ): void {
96:   const storedKeys = new Set<string>();
97:   for (const message of stored) {
98:     const key = correlationKey(message);
99:     if (key) storedKeys.add(key);
100:   }
101:   if (storedKeys.size === 0) return;
102:   // Phase 5 T8: the outbox confirms (and deletes) the items of these keys.
103:   storedMessageObservers.get(queryClient)?.forEach((observer) => observer(conversationId, stored));
104:   queryClient
105:     .getQueriesData<Message[]>({ queryKey: ['messages-pending'] })
106:     .forEach(([queryKey, pending]) => {
107:       if (queryKey[2] !== conversationId || !pending?.length) return;
108:       const remaining = pending.filter((message) => {
109:         const key = correlationKey(message);
110:         return key === null || !storedKeys.has(key);
111:       });
112:       if (remaining.length !== pending.length) {
113:         queryClient.setQueryData<Message[]>(queryKey, remaining);
114:       }
115:     });
116: }
117: 
118: /** Whether `pending` still holds the pending message of `clientMessageId` (not yet resolved). */
119: export function isPendingMessage(pending: readonly Message[] | undefined, clientMessageId: string): boolean {
120:   return Boolean(pending?.some((message) => normalizeClientMessageId(message.clientMessageId) === 
clientMessageId));
121: }
122: 
123: // Ids of messages this client saw deleted through a Realtime DELETE event, per
124: // query client, bounded to the last 1000 (the oldest are forgotten first).
125: // Only three merges consult it: a create response (useMessages), a Realtime
126: // INSERT (useMessageSubscription) and the re-merge after an in-flight fetch
127: // (keepMessageThroughInflightFetch). It does not reconcile deletions this
128: // client missed (e.g. during a Realtime stream gap), and fetched pages are
129: // not filtered by it: a feed GET that read the row before it was deleted can
130: // still return it. No product path deletes stored messages today; the only
131: // deletion is a sender's own Data API delete under RLS (delete_own_messages).
132: const MAX_REMEMBERED_DELETIONS = 1000;
133: const deletedMessageIds = new WeakMap<QueryClient, Set<string>>();
134: 
135: export function markMessageDeleted(queryClient: QueryClient, messageId: string): void {
136:   let ids = deletedMessageIds.get(queryClient);
137:   if (!ids) {
138:     ids = new Set();
139:     deletedMessageIds.set(queryClient, ids);
140:   }
141:   ids.delete(messageId);
142:   ids.add(messageId);
143:   if (ids.size > MAX_REMEMBERED_DELETIONS) {
144:     const oldest = ids.values().next().value;
145:     if (oldest !== undefined) ids.delete(oldest);
146:   }
147: }
148: 
149: export function isMessageDeleted(queryClient: QueryClient, messageId: string): boolean {
150:   return deletedMessageIds.get(queryClient)?.has(messageId) ?? false;
151: }
152: 
153: /**
154:  * Merges a stored message (a Realtime INSERT, a create response) into the
155:  * infinite-query cache:
156:  * - id already present in ANY page → no-op (realtime echo / duplicate event);
157:  * - otherwise → appended to page 0, the newest window.
158:  * Pending messages live outside this cache (pendingMessagesQueryKey) and are
159:  * matched to stored ones by key only (visiblePendingMessages).
160:  */
161: export function appendMessageToPages(
162:   oldData: MessagesInfiniteData | undefined,
163:   message: Message
164: ): MessagesInfiniteData {
165:   if (!oldData || !oldData.pages || oldData.pages.length === 0) {
166:     return { pages: [{ messages: [message] }], pageParams: [undefined] };
167:   }
168: 
169:   for (const page of oldData.pages) {
170:     if (page.messages.some((existing) => existing.id === message.id)) {
171:       return oldData;
172:     }
173:   }
174: 
175:   const pages = [...oldData.pages];
176:   pages[0] = { ...pages[0], messages: [...pages[0].messages, message] };
177:   return { ...oldData, pages };
178: }
179: 
180: const messagesQueryKey = (conversationId: string) => ['messages', conversationId] as const;
181: 
182: const isMessageCached = (data: MessagesInfiniteData | undefined, messageId: string): boolean =>
183:   Boolean(data?.pages?.some((page) => page.messages.some((existing) => existing.id === messageId)));
184: 
185: /**
186:  * Whether a conversation's feed cache holds the message right now. Components
187:  * render the feed from a provider that re-renders only once TanStack Query
188:  * delivers its (deferred) observer notification, so the rendered list can
189:  * briefly lag behind the cache.
190:  */
191: export function isMessageInFeedCache(
192:   queryClient: QueryClient,
193:   conversationId: string,
194:   messageId: string
195: ): boolean {
196:   return isMessageCached(
197:     queryClient.getQueryData<MessagesInfiniteData>(messagesQueryKey(conversationId)),
198:     messageId
199:   );
200: }
201: 
202: /**
203:  * Phase 5 T17: mentions are not in Realtime payloads (TRACK T4), so a live
204:  * INSERT reaches the feed without `mentionedUserIds`. A message whose text has
205:  * an "@" may mention someone (the composer writes every chosen mention as
206:  * "@<name>"); while the feed's copy of it lacks the stored mentions (no create
207:  * response or fetch delivered them yet), the feed must be refetched to get
208:  * them. A message without "@" is never refetched for this.
209:  */
210: export function lacksStoredMentions(queryClient: QueryClient, message: Message): boolean {
211:   if (typeof message.content !== 'string' || !message.content.includes('@')) return false;
212:   const data = queryClient.getQueryData<MessagesInfiniteData>(messagesQueryKey(message.conversationId));
213:   for (const page of data?.pages ?? []) {
214:     const cached = page.messages.find((existing) => existing.id === message.id);
215:     if (cached) return cached.mentionedUserIds === undefined;
216:   }
217:   return false;
218: }
219: 
220: /**
221:  * Keeps a just-merged message (a resolved send, a realtime INSERT) in the
222:  * feed when a fetch of that feed is already in flight.
223:  *
224:  * A fetch resolves with the server rows it read when it started and replaces
225:  * the cached pages. If the message was committed after that read, the result
226:  * lacks it and would silently drop it from the feed until some later
227:  * refetch. Once the in-flight fetch settles the message is merged again
228:  * (a no-op when the result already has it). If the message leaves the cache
229:  * while the fetch is still running (deleted, or a failed send rolled back),
230:  * it is not brought back, and neither is a message this client has seen
231:  * deleted by a Realtime DELETE (isMessageDeleted) by the time the fetch
232:  * settles.
233:  */
234: export function keepMessageThroughInflightFetch(
235:   queryClient: QueryClient,
236:   conversationId: string,
237:   message: Message
238: ): void {
239:   const queryKey = messagesQueryKey(conversationId);
240:   const queryCache = queryClient.getQueryCache();
241:   const query = queryCache.find<MessagesInfiniteData>({ queryKey, exact: true });
242:   if (!query || query.state.fetchStatus !== 'fetching') {
243:     return;
244:   }
245: 
246:   const unsubscribe = queryCache.subscribe((event) => {
247:     if (event.query !== query) {
248:       return;
249:     }
250:     if (event.type === 'removed') {
251:       unsubscribe();
252:       return;
253:     }
254:     if (event.type !== 'updated') {
255:       return;
256:     }
257:     if (query.state.fetchStatus === 'fetching') {
258:       // Until the fetch settles, data only changes through local updates.
259:       if (!isMessageCached(query.state.data, message.id)) {
260:         unsubscribe();
261:       }
262:       return;
263:     }
264:     unsubscribe();
265:     if (isMessageDeleted(queryClient, message.id)) {
266:       return;
267:     }
268:     queryClient.setQueryData<MessagesInfiniteData | undefined>(queryKey, (oldData) =>
269:       oldData ? appendMessageToPages(oldData, message) : oldData
270:     );
271:   });
272: }
273: 
274: /** Feed order: oldest first by timestamp, then id (the server's keyset order). */
275: const compareFeedOrder = (a: Message, b: Message): number => {
276:   const byTime = new Date(a.timestamp).getTime() - new Date(b.timestamp).getTime();
277:   if (byTime !== 0) return byTime;
278:   return a.id < b.id ? -1 : a.id > b.id ? 1 : 0;
279: };
280: 
281: const sameMessage = (a: Message, b: Message): boolean => JSON.stringify(a) === JSON.stringify(b);
282: 
283: export interface PolledMessagesMerge {
284:   data: MessagesInfiniteData;
285:   /** Messages the poll added to page 0 (not cached before). */
286:   added: Message[];
287:   changed: boolean;
288: }
289: 
290: /**
291:  * Phase 5 T14 (FR-016, AC-048): merges a polling-fallback read of a
292:  * conversation (`polled`, oldest first) into its cached feed without ever
293:  * going back to older data:
294:  * - a message is never duplicated: one already in ANY page is never added
295:  *   again, and one the cache held when the poll started (`cachedAtStart`) but
296:  *   no longer holds (removed meanwhile), or seen deleted, is not brought back;
297:  * - an existing message is replaced by its polled copy only when
298:  *   `replaceExisting` — the caller's proof that nothing wrote the feed since
299:  *   the poll started, so the polled copy is the newer state (receipts,
300:  *   reactions, attachments, mentions); otherwise the cached copy is kept;
301:  * - a new message is placed in page 0 (the newest window) in feed order, and
302:  *   only when it is not older than page 0's oldest message: an older one
303:  *   belongs to history that is not loaded. Older pages are never replaced,
304:  *   dropped or reordered.
305:  */
306: export function mergePolledMessages(
307:   oldData: MessagesInfiniteData,
308:   polled: readonly Message[],
309:   options: {
310:     replaceExisting: boolean;
311:     cachedAtStart: ReadonlySet<string>;
312:     isDeleted: (messageId: string) => boolean;
313:   }
314: ): PolledMessagesMerge {
315:   const polledById = new Map(polled.map((message) => [message.id, message]));
316:   const cached = new Set<string>();
317:   let changed = false;
318: 
319:   const pages = oldData.pages.map((page) => {
320:     let pageChanged = false;
321:     const messages = page.messages.map((existing) => {
322:       cached.add(existing.id);
323:       if (!options.replaceExisting) return existing;
324:       const next = polledById.get(existing.id);
325:       if (!next || options.isDeleted(existing.id) || sameMessage(existing, next)) return existing;
326:       pageChanged = true;
327:       return next;
328:     });
329:     if (!pageChanged) return page;
330:     changed = true;
331:     return { ...page, messages };
332:   });
333: 
334:   const newest = pages[0];
335:   const floor = newest.messages[0] ?? pages.slice(1).find((page) => page.messages.length > 0)?.messages.at(-1);
336:   const added = polled.filter(
337:     (message) =>
338:       !cached.has(message.id) &&
339:       !options.cachedAtStart.has(message.id) &&
340:       !options.isDeleted(message.id) &&
341:       (!floor || compareFeedOrder(message, floor) >= 0)
342:   );
343:   if (added.length > 0) {
344:     const merged = [...newest.messages];
345:     for (const message of added) {
346:       const index = merged.findIndex((existing) => compareFeedOrder(existing, message) > 0);
347:       if (index === -1) merged.push(message);
348:       else merged.splice(index, 0, message);
349:     }
350:     pages[0] = { ...newest, messages: merged };
351:     changed = true;
352:   }
353: 
354:   return { data: changed ? { ...oldData, pages } : oldData, added, changed };
355: }


src/hooks/useMessages.ts
1: // src/hooks/useMessages.ts
2: import { useCallback, useEffect, useMemo, useState } from 'react';
3: import { useInfiniteQuery, useQuery, useQueryClient, type QueryClient } from '@tanstack/react-query';
4: import { v4 as uuidv4 } from 'uuid';
5: import { useCompany } from '@/contexts/CompanyContext';
6: import {
7:   Message,
8:   MessageStatus,
9:   MessageType,
10:   FileAttachment,
11:   type MessageHistorySearchResult,
12: } from '@/types/messaging';
13: import { messagingApi } from '@/lib/messaging-api';
14: import { toggleReactionInPages } from '@/lib/messaging/reaction-cache';
15: import { attachmentMessageType } from '@/lib/messaging/attachment-policy';
16: import {
17:   appendMessageToPages,
18:   isMessageDeleted,
19:   isPendingMessage,
20:   keepMessageThroughInflightFetch,
21:   normalizeClientMessageId,
22:   pendingMessagesQueryKey,
23:   PENDING_MESSAGE_ID_PREFIX,
24:   resolvePendingMessages,
25:   visiblePendingMessages,
26:   type MessagesInfiniteData,
27: } from '@/lib/messaging/message-cache';
28: import { debugLogger } from '@/utils/debug-logger';
29: import { toast } from 'sonner';
30: 
31: const getTimestamp = (): number => {
32:   if (typeof performance !== 'undefined' && typeof performance.now === 'function') {
33:     return performance.now();
34:   }
35:   return Date.now();
36: };
37: 
38: const createTraceId = (prefix: string): string => {
39:   try {
40:     if (typeof crypto !== 'undefined' && typeof crypto.randomUUID === 'function') {
41:       return crypto.randomUUID();
42:     }
43:   } catch (error) {
44:     // Ignore and fallback to timestamp-based identifier
45:   }
46:   return `${prefix}-${Date.now().toString(36)}-${Math.random().toString(36).slice(2)}`;
47: };
48: 
49: const MESSAGES_PAGE_SIZE = 20;
50: 
51: /**
52:  * Upper bound on fetch rounds while searching history for one message (each
53:  * round loads an older page or waits for a fetch already running): about
54:  * MAX_HISTORY_SEARCH_ROUNDS * MESSAGES_PAGE_SIZE messages.
55:  */
56: const MAX_HISTORY_SEARCH_ROUNDS = 100;
57: 
58: const pagesContainMessage = (data: MessagesInfiniteData | undefined, messageId: string): boolean =>
59:   data?.pages.some((page) => page.messages.some((message) => message.id === messageId)) ?? false;
60: 
61: const NO_PENDING_MESSAGES: Message[] = [];
62: 
63: /** Adds (or replaces) or removes one pending message, by key, in the sender's pending list. */
64: const updatePendingMessages = (
65:   queryClient: QueryClient,
66:   queryKey: ReturnType<typeof pendingMessagesQueryKey>,
67:   clientMessageId: string,
68:   pendingMessage?: Message
69: ) => {
70:   queryClient.setQueryData<Message[]>(queryKey, (current) => {
71:     const others = (current ?? []).filter(
72:       (message) => normalizeClientMessageId(message.clientMessageId) !== clientMessageId
73:     );
74:     return pendingMessage ? [...others, pendingMessage] : others;
75:   });
76: };
77: 
78: export function useMessages(activeConversationId: string | null) {
79:   const queryClient = useQueryClient();
80:   const { currentUserProfile } = useCompany();
81: 
82:   // Realtime is handled by a dedicated hook: useMessageSubscription.
83:   // Audit M-07: caches for other conversations are intentionally kept —
84:   // switching back reuses them; TanStack's gcTime evicts idle ones.
85: 
86:   const {
87:     data,
88:     isLoading,
89:     isFetchingNextPage,
90:     error,
91:     hasNextPage,
92:     fetchNextPage,
93:     refetch,
94:   } = useInfiniteQuery({
95:     queryKey: ['messages', activeConversationId],
96:     enabled: !!activeConversationId,
97:     initialPageParam: undefined as string | undefined,
98:     queryFn: async ({ pageParam }) => {
99:       if (!activeConversationId) {
100:         return { messages: [], hasMoreOlder: false, nextCursorBefore: undefined };
101:       }
102:       // When pageParam is provided, it is an opaque keyset cursor produced by
103:       // the server (composite "timestamp|id")
104:       const res = await messagingApi.getMessages(activeConversationId, {
105:         limit: MESSAGES_PAGE_SIZE,
106:         cursorBefore: pageParam,
107:       });
108:       return res; // { messages, hasMoreOlder, nextCursorBefore }
109:     },
110:     getNextPageParam: (lastPage) => lastPage.nextCursorBefore,
111:   });
112: 
113:   // Phase 5 FR-034: the sender's pending messages are kept apart from the
114:   // stored feed (a feed fetch replaces the cached pages and must not drop
115:   // them) and keyed by the signed-in user (users.id), so they never show to
116:   // another account. Client-only state: this query never fetches.
117:   const pendingQueryKey = pendingMessagesQueryKey(currentUserProfile?.id ?? '', activeConversationId ?? '');
118:   const { data: pendingMessages = NO_PENDING_MESSAGES } = useQuery<Message[]>({
119:     queryKey: pendingQueryKey,
120:     queryFn: () => queryClient.getQueryData<Message[]>(pendingQueryKey) ?? [],
121:     enabled: false,
122:     staleTime: Infinity,
123:     // Phase 5 T8: also the render view of the durable outbox; never collected.
124:     gcTime: Infinity,
125:   });
126: 
127:   // Pages are returned Newest -> Oldest (Page 0 is newest)
128:   // We want to display Oldest -> Newest
129:   // So we reverse the pages array before flattening
130:   const storedMessages: Message[] = useMemo(
131:     () => (data?.pages ? [...data.pages].reverse().flatMap((p) => p.messages) : []),
132:     [data]
133:   );
134:   // A pending message shows until the feed holds the stored message with its
135:   // key (Realtime, fetch or create response, whichever comes first).
136:   const visiblePending = useMemo(
137:     () => (activeConversationId ? visiblePendingMessages(storedMessages, pendingMessages) : []),
138:     [activeConversationId, storedMessages, pendingMessages]
139:   );
140:   const messages: Message[] = useMemo(
141:     () => (visiblePending.length > 0 ? [...storedMessages, ...visiblePending] : storedMessages),
142:     [storedMessages, visiblePending]
143:   );
144:   // Once the rendered feed holds a pending message's stored copy (e.g. from
145:   // a fetch), the pending message is resolved for good: if the stored message
146:   // later leaves the feed (e.g. a Realtime DELETE), it is not shown again as
147:   // "sending".
148:   const hasObservedPending = pendingMessages.length > visiblePending.length;
149:   useEffect(() => {
150:     if (activeConversationId && hasObservedPending) {
151:       resolvePendingMessages(queryClient, activeConversationId, storedMessages);
152:     }
153:   }, [activeConversationId, hasObservedPending, queryClient, storedMessages]);
154: 
155:   // Initial load only. Background refetches (realtime/receipt invalidations,
156:   // focus) and older-page fetches must not swap the feed for a skeleton: that
157:   // unmounts the composer and discards whatever the user is typing.
158:   const loadingMessages = isLoading;
159:   const loadingMoreMessages = isFetchingNextPage;
160:   // A failed "Load more" keeps the loaded feed (below); the feed says so next
161:   // to the button until the user retries or opens another conversation. Kept
162:   // here rather than read from the query: a background refetch of the loaded
163:   // pages (e.g. a receipt invalidation) would clear the query error first.
164:   const [loadMoreFailedConversationId, setLoadMoreFailedConversationId] = useState<string | null>(null);
165:   const loadMoreMessagesFailed =
166:     activeConversationId !== null && loadMoreFailedConversationId === activeConversationId;
167:   // Only a conversation that never loaded shows the error state. Once the
168:   // feed has messages, a failed older page or background refetch keeps them
169:   // on screen (a member who lost access keeps a stable feed, FR-022).
170:   const errorMessages = error && !data ? (error as Error).message : null;
171:   const hasMoreMessages = !!hasNextPage;
172: 
173:   const refreshMessages = useCallback(async () => {
174:     if (debugLogger.messaging.enabled()) {
175:       debugLogger.messaging.event('useMessages.refreshMessages', 'start', {
176:         conversationId: activeConversationId,
177:       });
178:     }
179: 
180:     await refetch();
181: 
182:     if (debugLogger.messaging.enabled()) {
183:       debugLogger.messaging.event('useMessages.refreshMessages', 'finish', {
184:         conversationId: activeConversationId,
185:       });
186:     }
187:   }, [activeConversationId, refetch]);
188: 
189:   const loadMoreMessages = useCallback(async () => {
190:     if (!hasNextPage) {
191:       if (debugLogger.messaging.enabled()) {
192:         debugLogger.messaging.trace('useMessages.loadMoreMessages', 'skip:no-more-pages', {
193:           conversationId: activeConversationId,
194:         });
195:       }
196:       return;
197:     }
198: 
199:     if (debugLogger.messaging.enabled()) {
200:       debugLogger.messaging.event('useMessages.loadMoreMessages', 'start', {
201:         conversationId: activeConversationId,
202:       });
203:     }
204: 
205:     setLoadMoreFailedConversationId(null);
206:     const result = await fetchNextPage();
207:     if (result.isError) setLoadMoreFailedConversationId(activeConversationId);
208: 
209:     if (debugLogger.messaging.enabled()) {
210:       debugLogger.messaging.event('useMessages.loadMoreMessages', 'finish', {
211:         conversationId: activeConversationId,
212:         failed: result.isError,
213:       });
214:     }
215:   }, [activeConversationId, fetchNextPage, hasNextPage]);
216: 
217:   /**
218:    * Loads older pages of the active conversation until `messageId` is in the
219:    * feed (Phase 4 FR-022). Every round re-reads the cache, so it survives
220:    * fetches it does not own: a refetch that cancels its older-page request
221:    * (or one already running) is awaited and the search continues from the
222:    * pages the cache then holds. It stops when the message is loaded, the
223:    * history ends without it, a page fails (e.g. 403 after losing access),
224:    * `signal` aborts, or after MAX_HISTORY_SEARCH_ROUNDS rounds.
225:    */
226:   const loadHistoryUntilMessage = useCallback(
227:     async (messageId: string, signal: AbortSignal): Promise<MessageHistorySearchResult> => {
228:       if (!activeConversationId) return 'unavailable';
229:       const queryKey = ['messages', activeConversationId];
230: 
231:       for (let round = 0; round < MAX_HISTORY_SEARCH_ROUNDS; round += 1) {
232:         if (signal.aborted) return 'cancelled';
233:         const query = queryClient.getQueryCache().find({ queryKey, exact: true });
234:         if (!query) return 'unavailable';
235:         const data = query.state.data as MessagesInfiniteData | undefined;
236:         if (pagesContainMessage(data, messageId)) return 'found';
237: 
238:         const isFetching = query.state.fetchStatus === 'fetching';
239:         if (!isFetching && !data?.pages.at(-1)?.nextCursorBefore) {
240:           // History exhausted (or never loaded) without the message.
241:           return 'unavailable';
242:         }
243: 
244:         const failuresBefore = query.state.errorUpdateCount;
245:         // Without cancelRefetch a fetch already in flight is awaited instead
246:         // of being cancelled; the next round then loads the next older page.
247:         await fetchNextPage({ cancelRefetch: false });
248:         if (query.state.errorUpdateCount > failuresBefore) {
249:           if (signal.aborted) return 'cancelled';
250:           return pagesContainMessage(
251:             queryClient.getQueryData<MessagesInfiniteData>(queryKey),
252:             messageId
253:           )
254:             ? 'found'
255:             : 'unavailable';
256:         }
257:       }
258: 
259:       if (signal.aborted) return 'cancelled';
260:       return pagesContainMessage(queryClient.getQueryData<MessagesInfiniteData>(queryKey), messageId)
261:         ? 'found'
262:         : 'unavailable';
263:     },
264:     [activeConversationId, fetchNextPage, queryClient]
265:   );
266: 
267:   const sendMessage = useCallback(
268:     async (
269:       content: string,
270:       options?: {
271:         replyToId?: string;
272:         attachments?: FileAttachment[];
273:         type?: MessageType;
274:         // Composition key (FR-024): a retry with the same key gets back the
275:         // message already stored. Phase 5 FR-034: every send is keyed (one
276:         // is generated when the caller has none), because the pending copy
