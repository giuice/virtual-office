58: function openDatabase(): Promise<IDBDatabase> {
59:   return new Promise<IDBDatabase>((resolve, reject) => {
60:     let request: IDBOpenDBRequest;
61:     try {
62:       if (typeof indexedDB === 'undefined' || indexedDB === null) {
63:         throw new Error('IndexedDB is not available');
64:       }
65:       request = indexedDB.open(OUTBOX_DB_NAME, OUTBOX_DB_VERSION);
66:     } catch (error) {
67:       reject(new OutboxStorageError(`Outbox unavailable (${describe(error)})`, error));
68:       return;
69:     }
70:     request.onupgradeneeded = () => {
71:       const db = request.result;
72:       if (!db.objectStoreNames.contains(ITEMS_STORE)) {
73:         const items = db.createObjectStore(ITEMS_STORE, { keyPath: ['ownerId', 'clientMessageId'] });
74:         items.createIndex(BY_CONVERSATION_ORDER, ['ownerId', 'conversationId', 'order']);
75:         items.createIndex(BY_OWNER_ORDER, ['ownerId', 'order']);
76:       }
77:       if (!db.objectStoreNames.contains(META_STORE)) {
78:         db.createObjectStore(META_STORE, { keyPath: 'ownerId' });
79:       }
80:     };
81:     request.onblocked = () => {
82:       reject(new OutboxStorageError('Outbox upgrade blocked by another tab'));
83:     };
84:     request.onerror = () => {
85:       reject(new OutboxStorageError(`Outbox unavailable (${describe(request.error)})`, request.error));
86:     };
87:     request.onsuccess = () => {
88:       const db = request.result;
89:       db.onversionchange = () => {
90:         db.close();
91:         connection = null;
92:       };
93:       db.onclose = () => {
94:         connection = null;
95:       };
96:       resolve(db);
97:     };
98:   });
99: }
100: 
101: async function database(): Promise<IDBDatabase> {
102:   if (!connection) {
103:     const opening = openDatabase();
104:     connection = opening;
105:     opening.catch(() => {
106:       if (connection === opening) connection = null;
107:     });
108:   }
109:   return connection;
110: }
