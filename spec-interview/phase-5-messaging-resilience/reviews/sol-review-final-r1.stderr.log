489:     if private.room_access_denial(v_user, v_space) is not null then
490:       raise exception 'ROOM_ACCESS_DENIED' using errcode = '42501',
491:         detail = private.room_access_denial(v_user, v_space);
492:     end if;
493:   end loop;
494: end;
495: $$;
