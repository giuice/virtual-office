793:   if exists (
794:     select 1
795:     from private.conversation_member_revocations r
796:     where r.conversation_id = new.id
797:       and r.user_id = any (v_added)
798:   ) then
799:     raise exception 'MEMBERSHIP_REVOKED' using errcode = '42501';
800:   end if;
