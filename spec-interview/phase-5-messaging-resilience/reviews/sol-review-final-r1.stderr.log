1184:    * only a not-stored answer lets the item be sent, and only while it is
1185:    * still this tab's claim and inside its delivery window, and this drain may
1186:    * still dispatch (F4/F5: not held, stopped, or taken over meanwhile).
1187:    */
1188:   private async fenceThenAttempt(
1189:     item: OutboxItem,
1190:     session: DrainSession,
1191:     timing: DispatchTiming
1192:   ): Promise<OutboxAttemptOutcome> {
1193:     let fence: OutboxFenceOutcome;
1194:     const deadline: RequestDeadline = { hit: false };
1195:     try {
1196:       const response = await this.withDeadline(item, (signal) =>
1197:         messagingApi.fenceMessageAttempt(
1198:           {
1199:             conversationId: item.conversationId,
1200:             clientMessageId: item.clientMessageId,
1201:             attemptGeneration: item.attemptGeneration,
1202:             expectedSenderId: this.ownerId,
1203:           },
1204:           signal
1205:         ),
1206:         deadline
1207:       );
1208:       this.observeResponse();
1209:       fence = classifyFenceResponse(response, {
1210:         senderId: this.ownerId,
1211:         conversationId: item.conversationId,
1212:         clientMessageId: item.clientMessageId,
1213:       });
1214:     } catch (error) {
1215:       this.observeRequestFailure(error);
1216:       fence = { kind: 'unknown', status: null, failure: requestFailure(error, deadline) };
1217:     }
1218:     this.trace('fence', { conversationId: item.conversationId, generation: item.attemptGeneration, outcome: 
fence.kind });
1219:     if (fence.kind !== 'not_stored') return fence;
1220:     if (Date.now() >= item.windowStartedAt + DELIVERY_WINDOW_MS) return { kind: 'expired' };
1221:     // T11 (FR-011): the create is a new dispatch; the drain discards this outcome when the owner is gone.
1222:     if (!(await this.verifyOwner())) return { kind: 'superseded' };
1223:     const current = await updateOutboxItem(this.ownerId, item.clientMessageId, () => undefined);
1224:     if (
1225:       !this.mayDispatch(session) ||
1226:       current?.state !== 'claimed' ||
1227:       current.claimHolder !== this.tabId ||
1228:       current.attemptGeneration !== item.attemptGeneration
1229:     ) {
1230:       return { kind: 'superseded' };
1231:     }
1232:     // The fence's generation is now the key's current one: the create may commit under it.
1233:     timing.dispatchedAt = Date.now();
1234:     return this.attempt(item);
1235:   }
1236: 
1237:   /**
1238:    * The server confirmed the item: from now on it is never shown again as
1239:    * pending (its stored message is shown by the drain, showConfirmedOutboxMessage).
1240:    */
1241:   private confirmDelivered(item: OutboxItem): void {
1242:     const { conversationId, clientMessageId } = item;
1243:     this.markConfirmed(clientMessageId);
1244:     this.drain(conversationId).keys.delete(clientMessageId);
1245:     this.drain(conversationId).retryDelayMs = RETRY_BASE_MS;
1246:   }
1247: 
1248:   /**
1249:    * T11: puts back a claim that sent nothing (the browser's user was not the
1250:    * owner) — the item as it was before the claim, unless it changed since
1251:    * (a retired mark made meanwhile is kept, F3).
1252:    */
1253:   private async releaseUnsentClaim(claimed: OutboxItem, previous: OutboxItem): Promise<void> {
1254:     try {
1255:       await updateOutboxItem(this.ownerId, claimed.clientMessageId, (stored) => {
1256:         if (
1257:           stored.state !== 'claimed' ||
1258:           stored.claimHolder !== this.tabId ||
1259:           stored.attemptGeneration !== claimed.attemptGeneration
1260:         ) {
1261:           return undefined;
1262:         }
1263:         return stored.retired ? { ...previous, retired: true } : previous;
1264:       });
1265:     } catch (error) {
1266:       // Left claimed: the next drain fences it before anything is sent.
1267:       this.trace('release-failed', { error: String(error) });
1268:     }
1269:   }
1270: 
1271:   /** Records an outcome other than delivered; the drain of the conversation stops. */
1272:   private async recordUndelivered(
1273:     item: OutboxItem,
1274:     outcome: Exclude<OutboxAttemptOutcome, { kind: 'delivered' }>
1275:   ): Promise<void> {
1276:     const { conversationId, clientMessageId } = item;
1277:     const ownAttempt = (current: OutboxItem) =>
1278:       current.claimHolder === this.tabId && current.attemptGeneration === item.attemptGeneration;
1279:     const now = Date.now();
1280:     const released = { claimHolder: null, leaseExpiresAt: null, retryNotBefore: null, retryDelayMs: null, 
updatedAt: now };
1281:     if (outcome.kind === 'failed' || outcome.kind === 'expired') {
1282:       // No automatic attempt: the item waits for "Tentar de novo" / "Apagar".
1283:       const state = outcome.kind;
1284:       const failureReason = outcome.kind === 'failed' ? outcome.reason : null;
1285:       // A reused key already names another stored message: the item moves to a
1286:       // new key now, so observing that message never resolves it (FR-007).
1287:       const rekey = failureReason === 'client_message_id_reused';
1288:       let retiredEnded = false;
1289:       const current = await updateOutboxItem(
1290:         this.ownerId,
1291:         clientMessageId,
1292:         (stored) => {
1293:           if (!ownAttempt(stored)) return undefined;
1294:           // F3: its stored message was already observed: delivered, the claim ends with the item.
1295:           if (stored.retired) {
1296:             retiredEnded = true;
1297:             return null;
1298:           }
1299:           const failed: OutboxItem = { ...stored, ...released, state, failureReason };
1300:           return rekey ? withNewKey(failed) : failed;
1301:         },
1302:         rekey ? 'strict' : 'relaxed'
1303:       );
1304:       this.announce(conversationId);
1305:       if (rekey || retiredEnded) {
1306:         await this.refreshView(conversationId);
1307:       } else {
1308:         await this.showStored(conversationId, current);
1309:       }
1310:       // The later items of the conversation are not held behind a delivered item.
1311:       if (retiredEnded) this.scheduleRetry(conversationId, RETRY_BASE_MS);
1312:       return;
1313:     }
1314:     if (outcome.kind === 'transient') {
1315:       // Waiting again, claimable by any tab only after the backoff (FR-008).
1316:       let delayMs = RETRY_BASE_MS;
1317:       const current = await updateOutboxItem(this.ownerId, clientMessageId, (stored) => {
1318:         if (!ownAttempt(stored)) return undefined;
1319:         const previous = stored.retryDelayMs;
1320:         delayMs = typeof previous === 'number' && previous > 0 ? Math.min(previous * 2, RETRY_MAX_MS) : 
RETRY_BASE_MS;
1321:         return { ...stored, ...released, state: 'waiting', retryNotBefore: now + delayMs, retryDelayMs: delayMs 
};
1322:       });
1323:       this.announce(conversationId);
1324:       await this.showStored(conversationId, current);
1325:       this.scheduleRetry(conversationId, delayMs);
1326:       return;
1327:     }
1328:     // unknown / superseded → unknown (it may be stored).
1329:     const current = await updateOutboxItem(this.ownerId, clientMessageId, (stored) =>
1330:       ownAttempt(stored) ? { ...stored, ...released, state: 'unknown' } : undefined
1331:     );
1332:     this.announce(conversationId);
1333:     await this.showStored(conversationId, current);
1334:     this.scheduleRetry(conversationId);
1335:   }
1336: 
1337:   /**
1338:    * Shows `item` as just read or written by this tab, without reading the
1339:    * outbox again (unless it was confirmed meanwhile). An older re-read still
1340:    * in flight is superseded, so it cannot put back a previous state.
1341:    */
1342:   private showItem(item: OutboxItem): void {
1343:     if (this.disposed || this.signOutStop || this.held || this.confirmed.has(item.clientMessageId)) return;
1344:     const drain = this.drain(item.conversationId);
1345:     drain.viewSeq += 1;
1346:     drain.keys.add(item.clientMessageId);
1347:     drain.shown.set(item.clientMessageId, item);
1348:     publishOutboxItem(this.queryClient, item);
1349:   }
1350: 
1351:   /** Shows the item's stored state after an update; re-reads when it is gone. */
1352:   private async showStored(conversationId: string, item: OutboxItem | null): Promise<void> {
1353:     if (item) {
1354:       this.showItem(item);
1355:     } else {
1356:       await this.refreshView(conversationId);
1357:     }
1358:   }
1359: 
1360:   private scheduleRetry(conversationId: string, delayMs?: number): void {
1361:     if (this.disposed || this.held) return;
1362:     const drain = this.drain(conversationId);
1363:     if (drain.retryTimer) return;
1364:     const delay = delayMs ?? drain.retryDelayMs;
1365:     if (delayMs === undefined) drain.retryDelayMs = Math.min(drain.retryDelayMs * 2, RETRY_MAX_MS);
1366:     drain.retryTimer = setTimeout(() => {
1367:       drain.retryTimer = null;
1368:       this.drainConversation(conversationId);
1369:     }, delay);
1370:   }
1371: 
1372:   private trace(event: string, details: Record<string, unknown>): void {
1373:     if (debugLogger.messaging.enabled()) {
1374:       debugLogger.messaging.event(SCOPE, event, details);
1375:     }
1376:   }
1377: }


