111:   requested: MessageComposition
112: ): boolean {
113:   if (storedComposition) {
114:     return isSameStoredComposition(storedComposition, requested);
115:   }
116:   const storedAttachmentIds = [...storedAttachmentIdList].sort();
117:   const expectedAttachmentIds = [...requested.attachmentIds].sort();
118:   return (
119:     requested.mentionIds.length === 0 &&
120:     stored.content === requested.content &&
121:     (requested.type === null || stored.type === requested.type) &&
122:     (stored.replyToId ?? null) === requested.replyToId &&
123:     storedAttachmentIds.length === expectedAttachmentIds.length &&
124:     storedAttachmentIds.every((id, index) => id === expectedAttachmentIds[index])
125:   );
126: }
127: 
128: // Responses carry the message, its attachments and reactions — not other
129: // users' pins or stars, which findById (service client) also loads. Keyed
130: // responses carry the key (FR-034) on the message and at the top level, plus
131: // the attempt generation they answer.
132: function messageResponse(message: Message, status: 200 | 201, keyed?: KeyedCreate): NextResponse {
133:   const responseMessage: Message = { ...message, pins: undefined, stars: undefined };
134:   if (!keyed) {
135:     return NextResponse.json({ message: responseMessage }, { status });
136:   }
137:   return NextResponse.json(
138:     {
139:       message: { ...responseMessage, clientMessageId: keyed.clientMessageId },
140:       clientMessageId: keyed.clientMessageId,
141:       ...(keyed.attempt.generation !== undefined ? { attemptGeneration: keyed.attempt.generation } : {}),
142:     },
143:     { status }
144:   );
145: }
146: 
147: function clientKeyReused() {
148:   return jsonError(409, 'CLIENT_MESSAGE_ID_REUSED', 'clientMessageId was already used for a different message');
149: }
150: 
151: function attachmentNotFound() {
152:   return jsonError(400, 'ATTACHMENT_NOT_FOUND', 'An attachment was not found; upload it again');
153: }
154: 
155: function invalidReplyTarget() {
156:   return jsonError(400, 'INVALID_REPLY_TARGET', 'replyToId must reference a message in the same conversation');
157: }
158: 
159: function notParticipant() {
160:   return jsonError(403, 'NOT_PARTICIPANT', 'You are not a participant of this conversation');
161: }
162: 
163: function attachmentLinkFailure(error: AttachmentLinkError) {
164:   switch (error.code) {
165:     case 'NOT_PARTICIPANT':
166:       return notParticipant();
167:     case 'ATTACHMENT_COUNT_INVALID':
168:       return jsonError(400, 'TOO_MANY_ATTACHMENTS', TOO_MANY_ATTACHMENTS_MESSAGE);
169:     case 'ATTACHMENT_DUPLICATE':
170:       return jsonError(400, 'DUPLICATE_ATTACHMENT', 'attachmentIds must not repeat an upload');
171:     case 'ATTACHMENT_UPLOAD_NOT_FOUND':
172:       return attachmentNotFound();
173:     case 'INVALID_REPLY_TARGET':
174:       return invalidReplyTarget();
175:     case 'VOICE_NOTE_NOT_ALONE':
176:       return voiceNoteNotAlone();
177:   }
178: }
179: 
180: function voiceNoteNotAlone() {
181:   return jsonError(400, 'VOICE_NOTE_NOT_ALONE', 'A voice note must be the only attachment of its message');
182: }
183: 
184: /**
185:  * Database refusals of a create (fenced attempt, validation race, explicit
186:  * membership refusal, insertion quota) as BR-005 / FR-008 outcomes; null
187:  * otherwise — grant and other infrastructure failures answer 500 (recoverable).
188:  */
189: function createRefusal(error: unknown): NextResponse | null {
190:   if (error instanceof InsertionRateLimitError) {
191:     return error.reason === 'exceeded' ? rateLimitExceededResponse() : rateLimitUnavailableResponse();
192:   }
193:   if (error instanceof AttemptSupersededError) {
194:     return attemptSupersededResponse();
195:   }
196:   if (error instanceof MessageDeletedError) {
197:     return messageDeletedResponse();
198:   }
199:   if (error instanceof AttachmentLinkError) {
200:     return attachmentLinkFailure(error);
201:   }
202:   if (error instanceof NotParticipantError) {
203:     return notParticipant();
204:   }
205:   return null;
206: }
207: 
208: /**
209:  * Creates the message and links its pending uploads in one transaction
210:  * (BR-007: never visible partially attached). The uploads must belong to the
211:  * caller for this conversation and pass the attachment policy on their STORED
212:  * objects. A keyed create commits only while its attempt is current (Phase 5
213:  * T2); a fenced one stores and links nothing.
214:  */
215: async function createWithAttachments(
216:   serviceClient: SupabaseClient,
217:   messageRepository: IMessageRepository,
218:   conversationRepository: IConversationRepository,
219:   uploads: IMessageAttachmentUploadRepository,
220:   messageData: Omit<MessageCreateData, 'type'>,
221:   attachmentIds: string[],
222:   keyed: KeyedCreate | undefined
223: ): Promise<NextResponse> {
224:   const owned = await uploads.findOwned(attachmentIds, messageData.senderId, messageData.conversationId);
225: 
226:   let type = MessageType.FILE;
227:   const allUploadsPending = owned.length === attachmentIds.length;
228:   if (allUploadsPending) {
229:     // Phase 4 T15: a voice note travels alone (the database enforces it too).
230:     if (owned.length > 1 && owned.some((upload) => upload.duration !== undefined)) {
231:       return voiceNoteNotAlone();
232:     }
233:     const violation = await validateUploadsForLink(serviceClient, owned);
234:     if (violation) {
235:       return jsonError(violation.status, violation.code, violation.message);
236:     }
237:     type = attachmentMessageType(owned.map((upload) => upload.type));
238:   } else if (!keyed) {
239:     // Unknown, another user's, another conversation's, cancelled, or sent.
240:     return attachmentNotFound();
241:   }
242:   // With a key and missing uploads the database decides: a replay of a
243:   // committed create (its uploads were consumed) or ATTACHMENT_NOT_FOUND.
244: 
245:   let outcome: { messageId: string; created: boolean; storedComposition?: MessageComposition | null };
246:   try {
247:     outcome = await uploads.createMessageWithAttachments(
248:       { ...messageData, type },
249:       attachmentIds,
250:       keyed?.clientMessageId,
251:       keyed?.attempt,
252:       MESSAGE_INSERTION_QUOTA
253:     );
254:   } catch (error) {
255:     const refusal = createRefusal(error);
256:     if (refusal) {
257:       return refusal;
258:     }
259:     throw error;
260:   }
261: 
262:   if (outcome.created && !allUploadsPending) {
263:     // The database can only replay or refuse when uploads were missing here.
264:     throw new Error('create_message_attempt linked uploads that failed the policy pre-check');
265:   }
266:   if (outcome.created) {
267:     // Committed: bump activity now so a failed read-back below (500, then a
268:     // 200 replay on retry) never skips the recipients' badge refresh.
269:     await touchConversation(conversationRepository, messageData.conversationId);
270:   }
271: 
272:   const stored = await messageRepository.findById(outcome.messageId);
273:   if (!stored) {
274:     throw new Error(`Message ${outcome.messageId} not found after create`);
275:   }
276:   // Read strictly: findById degrades attachment read errors to [] (which would
277:   // turn a genuine replay into a false 409 or answer 201 without files).
278:   const linkedIds = await uploads.listLinkedAttachmentIds(outcome.messageId);
279:   if (!outcome.created) {
280:     // Only a keyed create can replay.
281:     if (!keyed || !isSameComposition(outcome.storedComposition, stored, linkedIds, keyed.attempt.composition)) {
282:       return clientKeyReused();
283:     }
284:     return messageResponse(stored, 200, keyed);
285:   }
286:   if ((stored.attachments ?? []).length !== linkedIds.length) {
287:     // The message and its files are committed; a retry with the same key
288:     // replays it (200) once the read succeeds.
289:     throw new Error(`Attachments of message ${outcome.messageId} could not be read after create`);
290:   }
291:   return messageResponse(stored, 201, keyed);
292: }
293: 
294: // Update conversation last activity. Besides ordering the list, this UPDATE on
295: // conversations is what fires useConversationRealtime's cache invalidation so
296: // recipients' unread badges refresh. Unread counts are derived from
297: // conversation_members.last_read_at (Phase 2.2) — nothing to increment here.
298: async function touchConversation(conversationRepository: IConversationRepository, conversationId: string) {
299:   try {
300:     await conversationRepository.updateLastActivityTimestamp(conversationId);
301:   } catch (updateError) {
302:     console.warn('Failed to update conversation activity:', updateError);
303:     // Don't fail the request if conversation update fails
304:   }
305: }
306: 
307: /**
308:  * POST /api/messages/create
309:  * Body: { conversationId, content, type?, replyToId?, clientMessageId?,
310:  *         attachmentIds?, attemptGeneration?, expectedSenderId? }
311:  * `content` may be empty (or omitted) only when `attachmentIds` lists 1–5 of
312:  * the caller's pending uploads for this conversation (Phase 4 T12); the type
313:  * of such a message is derived from its attachments (image or file; a voice
314:  * note — Phase 4 T15 — is the only attachment of a file message).
315:  * 201 created; 200 replay of `clientMessageId` (nothing inserted or linked);
316:  * 409 CLIENT_MESSAGE_ID_REUSED when the replay's composition differs.
317:  *
318:  * Phase 5 T2 (FR-006, FR-011, BR-005): `attemptGeneration` (positive integer,
319:  * requires `clientMessageId` and `expectedSenderId`) makes this dispatch an
320:  * attempt of its key: it first fences every older generation, and commits only
321:  * if no newer generation was fenced or dispatched before its commit; otherwise
322:  * 409 ATTEMPT_SUPERSEDED and nothing is stored. A keyed create without a
323:  * generation (Phase 4 client) commits only while the key has no fence state.
324:  * `expectedSenderId` (users.id) different from the authenticated user → 403
325:  * SENDER_MISMATCH, nothing stored or fenced. A generation-carrying create
326:  * whose key's committed message was deleted since → 410 MESSAGE_DELETED
327:  * (nothing stored; the item counts as delivered). A missing conversation answers
328:  * 403 NOT_PARTICIPANT. Keyed responses carry `clientMessageId` (and
329:  * `attemptGeneration` when sent).
330:  *
331:  * Phase 5 T4 (FR-024, BR-010): `mentionIds` (optional array of at most 50
332:  * users.id; requires `clientMessageId`; else 400 INVALID_MENTION_IDS) are the
333:  * requested mentions. They are part of the original composition (a replay
334:  * requesting a different set → 409 CLIENT_MESSAGE_ID_REUSED; an unchanged
335:  * replay → 200 even if a mentioned user left since) and, on first creation,
336:  * the database stores in the same transaction a mention for each one that is
337:  * a current member other than the sender (others create nothing). Messages in
338:  * responses carry `mentionedUserIds` (stored mentions, sorted).
339:  *
340:  * Phase 5 T3 (FR-008): budgets, each a transient 429 `rate_limited` when
341:  * exhausted or when it cannot be checked (fail-closed). The request is
342:  * authenticated first (401, nobody charged); then every authenticated request
343:  * — malformed or invalid bodies, replays and quota losers included — consumes
344:  * the request budget before anything else; a generation-carrying create's
345:  * fence step consumes the fence budget; only a winning insertion consumes the
346:  * insertion quota (charged by the database in the insertion's transaction,
347:  * for keyed, unkeyed and attachment creates alike). A grant or other
348:  * infrastructure failure answers 500; only the database's explicit membership
349:  * refusal answers 403 NOT_PARTICIPANT.
350:  */
351: export async function POST(request: NextRequest) {
352:   try {
353:     const auth = await requireAuthUser();
354:     if ('errorResponse' in auth) {
355:       return auth.errorResponse;
356:     }
357:     const serviceClient = await createSupabaseServerClient('service_role');
358:     const overRequestBudget = await enforceRateLimit(serviceClient, auth.dbUser.id, 'message:create-request');
359:     if (overRequestBudget) {
360:       return overRequestBudget;
361:     }
362: 
363:     let body: Record<string, unknown>;
364:     try {
365:       body = await request.json();
366:     } catch {
367:       return jsonError(400, 'BAD_REQUEST', 'Invalid JSON payload');
368:     }
369:     if (typeof body !== 'object' || body === null || Array.isArray(body)) {
370:       return jsonError(400, 'BAD_REQUEST', 'Invalid JSON payload');
371:     }
372: 
373:     const attachmentIds = parseAttachmentIds(body.attachmentIds);
374:     if (!attachmentIds.ok) {
375:       return jsonError(400, attachmentIds.code, attachmentIds.message);
376:     }
377:     const hasAttachments = attachmentIds.value !== undefined;
378: 
379:     const conversationId = typeof body.conversationId === 'string' ? body.conversationId : null;
380:     const rawContent = body.content === undefined && hasAttachments ? '' : body.content;
381:     if (!conversationId || typeof rawContent !== 'string') {
382:       return jsonError(400, 'BAD_REQUEST', 'Missing required fields: conversationId, content');
383:     }
384:     if (!isUuid(conversationId)) {
385:       return jsonError(400, 'BAD_REQUEST', 'conversationId must be a UUID');
386:     }
387: 
388:     const trimmedContent = rawContent.trim();
389:     if (trimmedContent.length === 0 && !hasAttachments) {
390:       return jsonError(400, 'BAD_REQUEST', 'Content must not be empty');
391:     }
392:     if (trimmedContent.length > MAX_CONTENT_LENGTH) {
393:       return jsonError(413, 'CONTENT_TOO_LARGE', `Content exceeds the ${MAX_CONTENT_LENGTH} character limit`);
394:     }
395: 
396:     const clientMessageId = parseClientMessageId(body.clientMessageId);
397:     if (!clientMessageId.ok) {
398:       return jsonError(400, 'INVALID_CLIENT_MESSAGE_ID', 'clientMessageId must be a UUID');
399:     }
400:     const attemptGeneration = parseAttemptGeneration(body.attemptGeneration, clientMessageId.value !== undefined);
401:     if (!attemptGeneration.ok) {
402:       return attemptGeneration.response;
403:     }
404:     const expectedSenderId = parseExpectedSenderId(body.expectedSenderId, attemptGeneration.value !== undefined);
405:     if (!expectedSenderId.ok) {
406:       return expectedSenderId.response;
407:     }
408:     const mentionIds = parseMentionIds(body.mentionIds, clientMessageId.value !== undefined);
409:     if (!mentionIds.ok) {
410:       return mentionIds.response;
411:     }
412: 
413:     const ctx = await authorizeConversationParticipant(auth, serviceClient, conversationId, {
414:       expectedSenderId: expectedSenderId.value,
415:       missingConversationAsNotParticipant: true,
416:     });
417:     if (isAuthzFailure(ctx)) {
418:       return ctx.errorResponse;
419:     }
420:     const { dbUser, conversation } = ctx;
421: 
422:     const messageRepository: IMessageRepository = new SupabaseMessageRepository(serviceClient);
423:     const conversationRepository: IConversationRepository = new SupabaseConversationRepository(serviceClient);
424: 
425:     // Audit S-04: replyToId must reference a message in the SAME conversation.
426:     // Keyed creates are validated by the database AFTER the replay check
427:     // (create_message_attempt): an unchanged replay of a stored message is not
428:     // re-validated (FR-024), so a reply target deleted since cannot turn it
429:     // into a refusal; a new insertion still gets 400 INVALID_REPLY_TARGET.
430:     let replyToId: string | undefined;
431:     if (body.replyToId !== undefined && body.replyToId !== null) {
432:       if (typeof body.replyToId !== 'string') {
433:         return jsonError(400, 'BAD_REQUEST', 'replyToId must be a string');
434:       }
435:       if (!isUuid(body.replyToId)) {
436:         return invalidReplyTarget();
437:       }
438:     }
439:     if (typeof body.replyToId === 'string' && clientMessageId.value) {
440:       replyToId = body.replyToId.toLowerCase();
441:     } else if (typeof body.replyToId === 'string') {
442:       const { data: replyTarget, error: replyError } = await serviceClient
443:         .from('messages')
444:         .select('id, conversation_id')
445:         .eq('id', body.replyToId)
446:         .maybeSingle();
447:       if (replyError) {
448:         console.error('Failed to validate replyToId:', replyError.message);
449:         return jsonError(500, 'INTERNAL_ERROR', 'Failed to create message');
450:       }
451:       if (!replyTarget || replyTarget.conversation_id !== conversation.id) {
452:         return invalidReplyTarget();
453:       }
454:       replyToId = replyTarget.id;
455:     }
456: 
457:     const baseMessageData: Omit<MessageCreateData, 'type'> = {
458:       conversationId: conversation.id,
459:       senderId: dbUser.id,
460:       content: trimmedContent,
461:       // Audit S-04: never trust client-supplied status (pre-marked read/delivered).
462:       status: MessageStatus.SENT,
463:       replyToId,
464:     };
465: 
466:     const safeType: MessageType = Object.values(MessageType).includes(body.type as MessageType)
467:       ? (body.type as MessageType)
468:       : MessageType.TEXT;
469: 
470:     let keyed: KeyedCreate | undefined;
471:     if (clientMessageId.value) {
472:       keyed = {
473:         clientMessageId: clientMessageId.value,
474:         attempt: {
475:           generation: attemptGeneration.value,
476:           composition: buildComposition({
477:             content: trimmedContent,
478:             type: attachmentIds.value ? null : safeType,
479:             replyToId,
480:             attachmentIds: attachmentIds.value ?? [],
481:             mentionIds: mentionIds.value,
482:           }),
483:         },
484:       };
485:     }
486: 
487:     if (keyed?.attempt.generation !== undefined) {
488:       // FR-006: an attempt that reached the server fences every older
489:       // generation before its INSERT, so a stale fence or request arriving
490:       // later is refused; the create below re-checks at commit time.
491:       // Phase 5 T3: this fence step consumes the fence budget.
492:       const overFenceBudget = await enforceRateLimit(serviceClient, dbUser.id, 'message:fence');
493:       if (overFenceBudget) {
494:         return overFenceBudget;
495:       }
496:       let fence;
497:       try {
498:         fence = await messageRepository.fenceClientMessage(
499:           { senderId: dbUser.id, conversationId: conversation.id, clientMessageId: keyed.clientMessageId },
500:           keyed.attempt.generation
501:         );
502:       } catch (error) {
503:         const refusal = createRefusal(error);
504:         if (refusal) {
505:           return refusal;
506:         }
507:         throw error;
508:       }
509:       if (fence.outcome === 'superseded') {
510:         return attemptSupersededResponse();
511:       }
512:       if (fence.outcome === 'stored' && fence.messageId === null) {
513:         // Delivered under this key and deleted since: never recreate it.
514:         return messageDeletedResponse();
515:       }
516:     }
517: 
518:     if (attachmentIds.value) {
519:       return await createWithAttachments(
520:         serviceClient,
521:         messageRepository,
522:         conversationRepository,
523:         new SupabaseMessageAttachmentUploadRepository(serviceClient),
524:         baseMessageData,
525:         attachmentIds.value,
526:         keyed
527:       );
528:     }
529: 
530:     const messageData: MessageCreateData = { ...baseMessageData, type: safeType };
531: 
532:     if (!keyed) {
533:       // Unkeyed text create (published client): created by the transactional
534:       // create function, which charges the insertion quota only when the
535:       // insertion commits (Phase 5 T3). Same legacy response.
536:       let createdMessage: Message;
537:       try {
538:         createdMessage = await messageRepository.createUnkeyed(messageData, MESSAGE_INSERTION_QUOTA);
539:       } catch (error) {
540:         const refusal = createRefusal(error);
541:         if (refusal) {
542:           return refusal;
543:         }
544:         throw error;
545:       }
546:       await touchConversation(conversationRepository, conversation.id);
547:       return NextResponse.json({ message: createdMessage }, { status: 201 });
548:     }
549: 
550:     let outcome;
551:     try {
552:       outcome = await messageRepository.createWithClientKey(
553:         messageData,
554:         keyed.clientMessageId,
555:         keyed.attempt,
556:         MESSAGE_INSERTION_QUOTA
557:       );
558:     } catch (error) {
559:       const refusal = createRefusal(error);
560:       if (refusal) {
561:         return refusal;
562:       }
563:       throw error;
564:     }
565:     if (!outcome.created) {
566:       // A retry of a composition whose create already committed (e.g. its
567:       // response was lost): answer with the stored message, insert nothing.
568:       // The key is per composition, so a different payload — including a
569:       // stored message that carries attachments — is a client bug.
570:       const stored = (await messageRepository.findById(outcome.message.id)) ?? outcome.message;
571:       const linkedIds = await new 
SupabaseMessageAttachmentUploadRepository(serviceClient).listLinkedAttachmentIds(stored.id);
572:       if (!isSameComposition(outcome.storedComposition, stored, linkedIds, keyed.attempt.composition)) {
573:         return clientKeyReused();
574:       }
575:       return messageResponse(stored, 200, keyed);
576:     }
577: 
578:     await touchConversation(conversationRepository, conversation.id);
579: 
580:     return messageResponse(outcome.message, 201, keyed);
581:   } catch (error) {
582:     console.error('Error creating message:', error);
583:     return jsonError(500, 'INTERNAL_ERROR', 'Failed to create message');
584:   }
585: }


