973:     raise exception 'MEMBERSHIP_GRANT_FORBIDDEN' using errcode = '42501';
974:   end if;
975:   if exists (
976:     select 1
977:     from public.conversation_members cm
978:     where cm.conversation_id = p_conversation_id
979:       and cm.user_id = p_user_id
980:   ) then
981:     return false;
982:   end if;
