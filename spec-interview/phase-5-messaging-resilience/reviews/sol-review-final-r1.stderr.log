899:     insert into public.conversation_members (conversation_id, user_id, last_read_at)
900:     values (p_conversation_id, p_user_id, pg_catalog.now())
901:     on conflict (conversation_id, user_id) do nothing;
902:   end if;
903:   return true;
904: end;
