217:   return inTransaction<OutboxItem | null>('readwrite', ({ items }, done) => {
218:     const request = items.get([ownerId, clientMessageId]);
219:     request.onsuccess = () => {
220:       const item = request.result as OutboxItem | undefined;
221:       if (!item) {
222:         done(null);
223:         return;
224:       }
225:       const next = change(item);
226:       if (next === undefined) {
227:         done(item);
228:       } else if (next === null) {
229:         items.delete([ownerId, clientMessageId]);
230:         done(null);
231:       } else if (next.ownerId !== ownerId) {
232:         throw new Error('An outbox item cannot change owner');
233:       } else if (next.clientMessageId !== clientMessageId) {
234:         items.delete([ownerId, clientMessageId]);
235:         items.add(next);
236:         done(next);
237:       } else {
238:         items.put(next);
239:         done(next);
240:       }
241:     };
242:   }, durability);
243: }
244: 
245: /**
246:  * Block A fix F4: a success of `generation` may remove its item unless the
247:  * item is now claimed by another holder at a newer generation (that holder
248:  * removes it). The server keeps at most one stored message per key either way.
249:  */
250: const confirmedRemovable = (item: OutboxItem, claimHolder: string, generation: number): boolean =>
251:   !(item.state === 'claimed' && item.claimHolder !== claimHolder && item.attemptGeneration > generation);
252: 
253: /**
254:  * Removes an item the server confirmed under `generation` (see
255:  * confirmedRemovable). Relaxed durability: if the removal were lost (OS
256:  * crash), the item would only be fenced under a newer generation and
257:  * resolved as the already stored message.
258:  */
259: export async function deleteConfirmedOutboxItem(
260:   ownerId: string,
261:   clientMessageId: string,
262:   claimHolder: string,
263:   generation: number
264: ): Promise<void> {
265:   await updateOutboxItem(ownerId, clientMessageId, (item) =>
266:     confirmedRemovable(item, claimHolder, generation) ? null : undefined
267:   );
268: }
269: 
270: /**
271:  * T12 (FR-013, BR-008): removes every item of the owner ("Sair mesmo").
272:  * Strict durability: a deleted item must never come back after a crash and be
273:  * sent when the owner signs in again. Resolves with the number of items removed.
274:  */
275: export function deleteAllOutboxItems(ownerId: string): Promise<number> {
276:   return inTransaction<number>('readwrite', ({ items }, done) => {
277:     const range = IDBKeyRange.bound([ownerId, -Infinity], [ownerId, Infinity]);
278:     const request = items.index(BY_OWNER_ORDER).getAllKeys(range);
279:     request.onsuccess = () => {
280:       const keys = request.result;
281:       for (const key of keys) items.delete(key);
282:       done(keys.length);
283:     };
284:   });
285: }
286: 
287: export type OutboxClaim =
288:   /**
289:    * `previous`: the item as it was before this claim. A `previous.state` of
290:    * `unknown`, or `claimed` (a holder that is gone), means an earlier attempt
291:    * may have been stored: the item must be fenced before it is sent again
292:    * (T27). T11: a claim that sends nothing (the browser's user is not the
293:    * owner) puts `previous` back.
294:    */
295:   | { kind: 'claimed'; item: OutboxItem; previous: OutboxItem }
296:   | { kind: 'empty' }
297:   /** The oldest unresolved item is failed or expired: later items wait (BR-003). */
298:   | { kind: 'blocked'; item: OutboxItem }
299:   /**
300:    * T9 (FR-008): the oldest item is waiting out the backoff of a transient
301:    * rejection (`retryNotBefore`, shared by every tab); claim again in `retryInMs`.
302:    */
303:   | { kind: 'deferred'; item: OutboxItem; retryInMs: number }
304:   /**
305:    * Block A fix F4: the oldest item is claimed by another holder whose claim
306:    * must not be replaced (see ClaimTakeover); nothing changed.
307:    */
308:   | { kind: 'busy'; item: OutboxItem };
309: 
310: /**
311:  * Block A fix F4: which live claim of another holder this drain may take over.
312:  * - `acquiredAt`: when this drain got the conversation's lock. A live claim
313:  *   made before it belongs to a holder that let the lock go without ending
314:  *   its claim (tab closed or crashed): taken over. A live claim made at or
315:  *   after it was made by a tab that took the lock from this one: never replaced.
316:  * - `stolen`: this drain took the lock over from a holder whose lease had
317:  *   ended; only a claim whose lease has ended is replaced (the steal checked
318:  *   that lease, not a claim made meanwhile).
319:  * - `supersedeEpoch` (T13 #7, block B fix F3; FR-004): this drain took the
320:  *   lock over after a connectivity recovery that advanced the owner's shared
321:  *   recovery epoch to this value; a live claim of an OLDER epoch is a
322:  *   pre-outage attempt of a holder that neither superseded nor re-stamped it
323:  *   (frozen): it is replaced under a newer generation (fenced first). A claim
324:  *   made — or re-stamped by its live holder — under this epoch is never
325:  *   replaced, however late any tab processes its own recovery.
326:  */
327: export interface ClaimTakeover {
328:   acquiredAt: number;
329:   stolen: boolean;
330:   supersedeEpoch?: number | null;
331: }
332: 
333: /** F3: the owner's shared recovery state. */
334: export interface RecoveryState {
335:   epoch: number;
336:   outageOpen: boolean;
337: }
338: 
339: /** F3: reads the owner's recovery epoch. */
340: export function readRecoveryState(ownerId: string): Promise<RecoveryState> {
341:   return inTransaction<RecoveryState>('readonly', ({ meta }, done) => {
342:     const request = meta.get(ownerId);
343:     request.onsuccess = () => {
344:       const current = request.result as OwnerMeta | undefined;
345:       done({ epoch: epochOf(current), outageOpen: current?.outageOpen === true });
346:     };
347:   });
348: }
349: 
350: /**
351:  * F3: a tab observed a connectivity loss (the browser `offline` event, its
352:  * Realtime socket down, or a create/fence network failure). Opens the
353:  * owner's outage unless one is open already — and only if the tab is current
354:  * (`knownEpoch` is the epoch it last saw, null if none yet): a tab that
355:  * processes a loss late, after another tab already recorded the recovery of
356:  * that outage, opens nothing. Resolves with the state after the call.
357:  */
358: export function noteOutageObserved(ownerId: string, knownEpoch: number | null): Promise<RecoveryState> {
359:   return inTransaction<RecoveryState>('readwrite', ({ meta }, done) => {
360:     const request = meta.get(ownerId);
361:     request.onsuccess = () => {
362:       const current = request.result as OwnerMeta | undefined;
363:       const epoch = epochOf(current);
364:       if (current?.outageOpen === true) {
365:         done({ epoch, outageOpen: true });
366:         return;
367:       }
368:       if (knownEpoch !== null && knownEpoch !== epoch) {
369:         done({ epoch, outageOpen: false });
370:         return;
371:       }
372:       meta.put({ ...current, ownerId, nextOrder: current?.nextOrder ?? 1, outageOpen: true } satisfies OwnerMeta);
373:       done({ epoch, outageOpen: true });
374:     };
375:   });
376: }
377: 
378: /** Re-stamps `claimHolder`'s live claims older than `epoch` (they belong to a tab that is evidently alive). */
379: function restampLiveClaimsIn(items: IDBObjectStore, ownerId: string, claimHolder: string, epoch: number): void {
380:   const now = Date.now();
381:   const range = IDBKeyRange.bound([ownerId, -Infinity], [ownerId, Infinity]);
382:   const request = items.index(BY_OWNER_ORDER).openCursor(range);
383:   request.onsuccess = () => {
384:     const cursor = request.result;
385:     if (!cursor) return;
386:     const item = cursor.value as OutboxItem;
387:     if (
388:       item.state === 'claimed' &&
389:       item.claimHolder === claimHolder &&
390:       item.leaseExpiresAt !== null &&
391:       item.leaseExpiresAt > now &&
392:       (item.claimEpoch ?? 0) < epoch
393:     ) {
394:       cursor.update({ ...item, claimEpoch: epoch });
395:     }
396:     cursor.continue();
397:   };
398: }
399: 
400: /**
401:  * F3: a tab observed connectivity return (the browser `online` event, or a
402:  * Realtime or create/fence recovery after a loss it observed). If an outage is
403:  * open, closes it and advances the owner's recovery epoch — once per outage:
404:  * a tab that processes the same recovery later finds it closed and advances
405:  * nothing. Either way `claimHolder`'s own live claims are re-stamped with the
406:  * current epoch (this tab is alive: its claims are not pre-outage attempts of
407:  * a frozen holder). Resolves with the epoch and whether it advanced.
408:  */
409: export function noteRecoveryObserved(
410:   ownerId: string,
411:   claimHolder: string
412: ): Promise<{ epoch: number; advanced: boolean }> {
413:   return inTransaction<{ epoch: number; advanced: boolean }>('readwrite', ({ items, meta }, done) => {
414:     const request = meta.get(ownerId);
415:     request.onsuccess = () => {
416:       const current = request.result as OwnerMeta | undefined;
417:       let epoch = epochOf(current);
418:       const advanced = current?.outageOpen === true;
419:       if (advanced) {
420:         epoch += 1;
421:         meta.put({ ...current, ownerId, nextOrder: current?.nextOrder ?? 1, recoveryEpoch: epoch, outageOpen: 
false } satisfies OwnerMeta);
422:       }
423:       restampLiveClaimsIn(items, ownerId, claimHolder, epoch);
424:       done({ epoch, advanced });
425:     };
426:   });
427: }
428: 
429: /** F3: another tab advanced the epoch to `epoch`; `claimHolder`'s live claims are re-stamped (see 
noteRecoveryObserved). */
430: export function restampLiveClaims(ownerId: string, claimHolder: string, epoch: number): Promise<void> {
431:   return inTransaction<void>('readwrite', ({ items }, done) => {
432:     restampLiveClaimsIn(items, ownerId, claimHolder, epoch);
433:     done(undefined);
434:   });
435: }
436: 
437: /** The server confirmed `key` under `generation`: removed in the claim's transaction (see confirmedRemovable). */
438: export interface ConfirmedRemoval {
439:   key: string;
440:   generation: number;
441: }
442: 
443: /**
444:  * Atomically takes the conversation's OLDEST item for a new attempt: the next
445:  * generation, state `claimed`, `claimHolder`, lease expiry. Only the oldest
446:  * item is ever eligible (BR-003). The caller must hold the conversation's
447:  * drain lock (Web Lock, T10); a `claimed` item of another holder is taken over
448:  * under a newer generation only as `takeover` allows, else `busy`. Retired
449:  * items (F3: delivered, kept only for their claim) are removed on the way,
450:  * unless their claim may not be replaced (`busy`).
451:  *
452:  * Strict durability (block A fix F1): the claim — the item's new generation
453:  * and dispatched state — is flushed before its request can leave the
454:  * machine, so an OS crash can never bring back an earlier state (e.g. a
455:  * cancellable generation 0) of an item whose attempt may be stored.
456:  *
457:  * `confirmed`: an item of this owner just confirmed by the server, removed in
458:  * the same transaction before the next one is taken. `maxDeferMs`: the
459:  * longest transient backoff; a waiting item whose `retryNotBefore` is at most
460:  * that far ahead is not claimed yet (`deferred`).
461:  */
462: export function claimOldestOutboxItem(
463:   ownerId: string,
464:   conversationId: string,
465:   claimHolder: string,
466:   leaseMs: number,
467:   takeover: ClaimTakeover,
468:   confirmed: ConfirmedRemoval | null = null,
469:   maxDeferMs = 0
470: ): Promise<OutboxClaim> {
471:   return inTransaction<OutboxClaim>(
472:     'readwrite',
473:     ({ items, meta }, done) => {
474:       const now = Date.now();
475:       // F3: the claim carries the owner's recovery epoch, read in this transaction.
476:       let epoch = 0;
477:       /** A live claim of another holder that this drain must leave alone (F4, F3). */
478:       const untouchable = (item: OutboxItem): boolean =>
479:         item.state === 'claimed' &&
480:         item.claimHolder !== null &&
481:         item.claimHolder !== claimHolder &&
482:         item.leaseExpiresAt !== null &&
483:         item.leaseExpiresAt > now &&
484:         (takeover.stolen || item.updatedAt >= takeover.acquiredAt) &&
485:         !(typeof takeover.supersedeEpoch === 'number' && (item.claimEpoch ?? 0) < takeover.supersedeEpoch);
486:       const claimOldest = () => {
487:         const range = IDBKeyRange.bound([ownerId, conversationId, -Infinity], [ownerId, conversationId, 
Infinity]);
488:         const request = items.index(BY_CONVERSATION_ORDER).openCursor(range);
489:         request.onsuccess = () => {
490:           const cursor = request.result;
491:           if (!cursor) {
492:             done({ kind: 'empty' });
493:             return;
494:           }
495:           const item = cursor.value as OutboxItem;
496:           if (untouchable(item)) {
497:             done({ kind: 'busy', item });
498:             return;
499:           }
500:           if (item.retired) {
501:             // Delivered (F3) and its claim may end now: removed; the next item follows.
502:             cursor.delete();
503:             cursor.continue();
504:             return;
505:           }
506:           if (item.state === 'failed' || item.state === 'expired') {
507:             done({ kind: 'blocked', item });
508:             return;
509:           }
510:           // A backoff longer than the longest one possible means the clock went
511:           // back: the item is due now rather than held indefinitely.
512:           const retryInMs =
513:             item.state === 'waiting' && typeof item.retryNotBefore === 'number' ? item.retryNotBefore - now : 0;
514:           if (retryInMs > 0 && retryInMs <= maxDeferMs) {
515:             done({ kind: 'deferred', item, retryInMs });
516:             return;
517:           }
518:           const claimed: OutboxItem = {
519:             ...item,
520:             state: 'claimed',
521:             attemptGeneration: item.attemptGeneration + 1,
522:             claimHolder,
523:             leaseExpiresAt: now + leaseMs,
524:             claimEpoch: epoch,
525:             updatedAt: now,
526:           };
527:           cursor.update(claimed);
528:           done({ kind: 'claimed', item: claimed, previous: item });
529:         };
530:       };
531:       const metaRequest = meta.get(ownerId);
532:       metaRequest.onsuccess = () => {
533:         epoch = epochOf(metaRequest.result as OwnerMeta | undefined);
534:         if (confirmed === null) {
535:           claimOldest();
536:           return;
537:         }
538:         // The confirmed item is removed (or left to a newer holder) before the oldest is read.
539:         const confirmedRequest = items.get([ownerId, confirmed.key]);
540:         confirmedRequest.onsuccess = () => {
541:           const item = confirmedRequest.result as OutboxItem | undefined;
542:           if (item && confirmedRemovable(item, claimHolder, confirmed.generation)) items.delete([ownerId, 
confirmed.key]);
543:           claimOldest();
544:         };
545:       };
546:     },
547:     'strict'
548:   );
549: }


