1010: -- ---------------------------------------------------------------------------
1011: -- 7. Per-message read receipts: lock the membership (never for a removed one).
1012: -- ---------------------------------------------------------------------------
1013: create or replace function public.mark_messages_read(p_conversation_id uuid, p_user_id uuid, p_message_ids 
uuid[])
1014: returns integer
1015: language plpgsql
1016: security definer
1017: set search_path = ''
1018: as $$
1019: declare
1020:   v_recorded integer;
1021: begin
1022:   if p_conversation_id is null or p_user_id is null then
1023:     raise exception 'mark_messages_read: conversation and user are required'
1024:       using errcode = '22004';
1025:   end if;
1026: 
1027:   if p_message_ids is null or pg_catalog.cardinality(p_message_ids) = 0 then
1028:     return 0;
1029:   end if;
1030: 
1031:   -- Bounded input: the route caps the batch at 100 ids as well.
1032:   if pg_catalog.cardinality(p_message_ids) > 100 then
1033:     raise exception 'mark_messages_read: at most 100 message ids per call'
1034:       using errcode = '22023';
1035:   end if;
1036: 
1037:   -- Phase 5 T28: the membership row is locked until commit, so a concurrent
1038:   -- removal either committed first (refused here) or waits for these receipts.
1039:   perform 1
1040:   from public.conversation_members cm
1041:   where cm.conversation_id = p_conversation_id
1042:     and cm.user_id = p_user_id
1043:   for key share;
1044:   if not found then
1045:     raise exception 'mark_messages_read: user is not a member of the conversation'
1046:       using errcode = '42501';
1047:   end if;
1048: 
1049:   -- Ids outside the conversation are ignored; the caller's own messages never
1050:   -- get a receipt (system messages with a null sender may). Repeats are
1051:   -- idempotent on the unique (message_id, user_id).
1052:   insert into public.message_read_receipts (message_id, conversation_id, user_id)
1053:   select m.id, m.conversation_id, p_user_id
1054:   from public.messages m
1055:   where m.conversation_id = p_conversation_id
1056:     and m.id = any (p_message_ids)
1057:     and m.sender_id is distinct from p_user_id
1058:   on conflict (message_id, user_id) do nothing;
1059: 
1060:   get diagnostics v_recorded = row_count;
1061:   return v_recorded;
1062: end;
1063: $$;
1064: 
1065: commit;


