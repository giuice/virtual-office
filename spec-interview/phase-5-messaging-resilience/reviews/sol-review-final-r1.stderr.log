1: // src/lib/messaging/outbox/outbox-db.ts
2: // Phase 5 T8: IndexedDB storage of the message outbox (SPEC §9).
3: //
4: // Database `vo-messaging-outbox` (version 1):
5: // - store `items`: one OutboxItem per (ownerId, clientMessageId) (key path);
6: //   index `byConversationOrder` [ownerId, conversationId, order] (the drain
7: //   reads a conversation's oldest item) and `byOwnerOrder` [ownerId, order];
8: // - store `meta`: per-owner counter `{ ownerId, nextOrder }` that gives items
9: //   their creation order inside the same transaction as the item write, so
10: //   the order is shared by every tab of the browser.
11: // The connection closes on `versionchange` (an upgrade or a deletion from
12: // another tab or test is never blocked).
13: import type { OutboxItem } from '@/types/message-outbox';
14: 
15: export const OUTBOX_DB_NAME = 'vo-messaging-outbox';
16: const OUTBOX_DB_VERSION = 1;
17: const ITEMS_STORE = 'items';
18: const META_STORE = 'meta';
19: const BY_CONVERSATION_ORDER = 'byConversationOrder';
20: const BY_OWNER_ORDER = 'byOwnerOrder';
21: 
22: interface OwnerMeta {
23:   ownerId: string;
24:   nextOrder: number;
25:   /**
26:    * Block B fix F3 (FR-004, AC-041): the owner's recovery epoch, shared by
27:    * every tab of the browser — advanced once per connectivity outage, when a
28:    * tab observes the recovery of an outage still open (see noteRecoveryObserved).
29:    * Absent: 0.
30:    */
31:   recoveryEpoch?: number;
32:   /** F3: a tab observed a connectivity loss that no recovery has closed yet. */
33:   outageOpen?: boolean;
34: }
35: 
36: const epochOf = (meta: OwnerMeta | undefined): number => meta?.recoveryEpoch ?? 0;
37: 
38: /** The outbox cannot be read or written (storage blocked, quota, failed write) — FR-033. */
39: export class OutboxStorageError extends Error {
40:   constructor(message: string, readonly cause?: unknown) {
41:     super(message);
42:     this.name = 'OutboxStorageError';
43:   }
44: }
45: 
46: export function isOutboxStorageError(error: unknown): error is OutboxStorageError {
47:   return error instanceof OutboxStorageError;
48: }
49: 
50: let connection: Promise<IDBDatabase> | null = null;
51: 
52: function describe(error: unknown): string {
53:   if (error === null || error === undefined) return 'aborted';
54:   if (error instanceof DOMException) return `${error.name}: ${error.message}`;
55:   return error instanceof Error ? error.message : String(error);
56: }
