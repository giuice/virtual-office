1: // Phase 5 T24: runs the local E2E web server and copies its raw output to a file
2: // that tests can read (helpers/server-log.ts), while still passing it through to
3: // Playwright's `[WebServer]` output.
4: //
5: // Usage: node scripts/playwright-server-log-tee.mjs <command> [args...]
6: // Env:   VO_E2E_SERVER_LOG_FILE — absolute path of the raw log (truncated at start).
7: //
8: // Nothing is filtered, redacted, or reformatted: every stdout and stderr line is
9: // written byte for byte as the server printed it. The only processing is
10: // line-atomic interleaving: each stream is buffered up to its next newline and
11: // only whole lines are written, so a stdout line and a stderr line never splice
12: // into one another. When a stream ends with an unterminated fragment, the
13: // fragment is written followed by a line feed (0x0a) — the one byte the tee ever adds — so
14: // the next line of the other stream still starts on a line of its own. This is
15: // a local test aid only; the log file lives in an ignored directory and is never
16: // uploaded.
17: import { closeSync, mkdirSync, openSync, writeSync } from 'node:fs';
18: import { spawn } from 'node:child_process';
19: import { dirname, isAbsolute } from 'node:path';
20: 
21: const logPath = process.env.VO_E2E_SERVER_LOG_FILE;
22: if (!logPath || !isAbsolute(logPath)) {
23:   console.error('[server-log-tee] VO_E2E_SERVER_LOG_FILE must be an absolute path.');
24:   process.exit(2);
25: }
26: const [command, ...args] = process.argv.slice(2);
27: if (!command) {
28:   console.error('[server-log-tee] Missing the server command.');
29:   process.exit(2);
30: }
31: 
32: mkdirSync(dirname(logPath), { recursive: true });
33: const fd = openSync(logPath, 'w');
34: 
35: const LINE_FEED = Buffer.from([0x0a]);
36: 
37: function tee(stream, destination) {
38:   let pending = Buffer.alloc(0);
39:   stream.on('data', (chunk) => {
40:     destination.write(chunk);
41:     pending = Buffer.concat([pending, chunk]);
42:     const lastNewline = pending.lastIndexOf(0x0a);
43:     if (lastNewline >= 0) {
44:       writeSync(fd, pending.subarray(0, lastNewline + 1));
45:       pending = pending.subarray(lastNewline + 1);
46:     }
47:   });
48:   return new Promise((resolveEnd) => {
49:     const flush = () => {
50:       if (pending.length > 0) {
51:         // Terminate the EOF fragment (the only byte the tee adds).
52:         writeSync(fd, Buffer.concat([pending, LINE_FEED]));
53:         pending = Buffer.alloc(0);
54:       }
55:       resolveEnd();
56:     };
57:     stream.once('end', flush);
58:     stream.once('close', flush);
59:     stream.once('error', flush);
60:   });
