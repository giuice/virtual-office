529:       await expect.poll(() => since(hangPhase).filter((request) => request.failure !== undefined).length, { 
timeout: 45_000 }).toBeGreaterThan(0);
530:       const hung = since(hangPhase).find((request) => request.failure !== undefined) as MetricsRequest;
531:       const abortedAfterMs = (hung.endedAt as number) - hung.startedAt;
532:       expect(abortedAfterMs, 'a hanging metrics request is aborted after 5 
s').toBeGreaterThanOrEqual(REQUEST_TIMEOUT_MS - 250);
533:       expect(abortedAfterMs).toBeLessThanOrEqual(REQUEST_TIMEOUT_MS + 1_500);
534:       await expectNoVisibleError(a.page, errors);
535: 
536:       // ---- The route is flooded: sustained real traffic of the same user
537:       // exhausts its real per-user budget, so A's tab is answered 429.
538:       // Block C fix F9: the budget is a fixed 60 s bucket and the flood
539:       // re-opens it at each rollover, so it starts early in a bucket (waiting
540:       // for the next one if needed) and A's next batch lands while it is exhausted.
541:       mode = 'real';
542:       const bucketLeftMs = await msLeftInMetricsBucket();
543:       if (bucketLeftMs < FLOOD_MIN_BUCKET_LEFT_MS) await a.page.waitForTimeout(bucketLeftMs + 250);
544:       const floodStartedAt = Date.now();
545:       const floodBucketEndsAt = floodStartedAt + (await msLeftInMetricsBucket());
546:       let flooding = true;
547:       const floodStatuses: number[] = [];
548:       const flood = (async () => {
549:         while (flooding) {
550:           const response = await a.context.request
551:             .post(METRICS_PATH, { data: { events: [{ type: 'polling_start' }] } })
552:             .catch(() => null);
