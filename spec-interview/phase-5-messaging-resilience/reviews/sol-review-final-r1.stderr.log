595:         .toBeGreaterThan(0);
596:       const pauseEnd = (overloaded as MetricsRequest).startedAt + OVERLOAD_PAUSE_MS - 1_000;
597:       expect(since(burstStart).filter((request) => request.startedAt < pauseEnd), 'no delivery during the 
overload pause').toEqual([]);
