56: /**
57:  * PATCH /api/conversations/preferences
58:  * Update user's preferences for a conversation (pin, star, notifications)
59:  * Body: { conversationId, isPinned?, pinnedOrder?, isStarred?, notificationsEnabled? }
60:  */
61: export async function PATCH(request: NextRequest) {
62:   try {
63:     const body = await request.json();
64:     const { conversationId, isPinned, pinnedOrder, isStarred, notificationsEnabled } = body;
65: 
66:     // Basic validation
67:     if (!conversationId) {
68:       return NextResponse.json({ error: 'Missing required field: conversationId' }, { status: 400 });
69:     }
70: 
71:     // Validate at least one preference field is provided
72:     if (
73:       isPinned === undefined &&
74:       pinnedOrder === undefined &&
75:       isStarred === undefined &&
76:       notificationsEnabled === undefined
77:     ) {
78:       return NextResponse.json(
79:         { error: 'At least one preference field must be provided (isPinned, pinnedOrder, isStarred, 
notificationsEnabled)' },
80:         { status: 400 }
81:       );
82:     }
83: 
84:     const ctx = await requireConversationParticipant(conversationId);
85:     if (isAuthzFailure(ctx)) {
86:       return ctx.errorResponse;
87:     }
88: 
89:     const conversationRepository: IConversationRepository = new SupabaseConversationRepository(ctx.serviceClient);
90: 
91:     // Build preferences update object
92:     const preferencesUpdate: any = {};
93:     if (isPinned !== undefined) {
94:       preferencesUpdate.isPinned = isPinned;
95:       // If unpinning, clear pinned order
96:       if (!isPinned) {
97:         preferencesUpdate.pinnedOrder = null;
98:       }
99:     }
100:     if (pinnedOrder !== undefined) preferencesUpdate.pinnedOrder = pinnedOrder;
101:     if (isStarred !== undefined) preferencesUpdate.isStarred = isStarred;
102:     if (notificationsEnabled !== undefined) preferencesUpdate.notificationsEnabled = notificationsEnabled;
103: 
104:     console.log(
105:       `API: Updating preferences for conversation ${conversationId} for user ${ctx.dbUser.id}:`,
106:       preferencesUpdate
107:     );
108: 
109:     // Update preferences
110:     const updatedPreferences = await conversationRepository.setUserPreference(
111:       conversationId,
112:       ctx.dbUser.id,
113:       preferencesUpdate
114:     );
115: 
116:     return NextResponse.json({
117:       success: true,
118:       preferences: {
119:         ...updatedPreferences,
120:         createdAt: updatedPreferences.createdAt.toISOString(),
121:         updatedAt: updatedPreferences.updatedAt.toISOString(),
122:       },
123:     });
124:   } catch (error) {
125:     if (error instanceof NotParticipantError) {
126:       // Phase 5 T28: the membership vanished after authorization; nothing written.
127:       return jsonError(403, 'NOT_PARTICIPANT', 'You are not a participant of this conversation');
128:     }
129:     console.error('Error updating conversation preferences:', error);
130:     if (error instanceof SyntaxError) {
131:       return NextResponse.json({ error: 'Invalid JSON payload' }, { status: 400 });
132:     }
133:     return NextResponse.json({ error: 'Internal Server Error' }, { status: 500 });
134:   }
135: }


