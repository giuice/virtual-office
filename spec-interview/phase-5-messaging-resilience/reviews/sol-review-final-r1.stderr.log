14: import { metricCount, metricDurationMs, recordMessagingMetric } from '@/lib/messaging/metrics-recorder';
15: import {
16:   POLL_AFTER_UNHEALTHY_MS,
17:   POLL_INTERVAL_MS,
18:   POLL_ROUND_DEADLINE_MS,
19:   pollConversationFeed,
20:   pollQueryIfUnchanged,
21:   type PollRequestControl,
22: } from '@/lib/messaging/polling-fallback';
23: import { debugLogger } from '@/utils/debug-logger';
24: 
25: interface UseMessagingPollingFallbackOptions {
26:   /** This tab's messaging stream health (T13). */
27:   health: MessagingRealtimeHealth;
28:   /** The signed-in user's users.id (null/undefined: signed out, nothing polls). */
29:   userId: string | null | undefined;
30:   /** The open conversation, whose feed is polled (null: none open). */
31:   conversationId: string | null;
32: }
33: 
34: const isTabVisible = (): boolean => typeof document === 'undefined' || document.visibilityState !== 'hidden';
35: 
36: const subscribeVisibility = (listener: () => void): (() => void) => {
37:   document.addEventListener('visibilitychange', listener);
38:   return () => document.removeEventListener('visibilitychange', listener);
39: };
40: 
41: /** T19 (FR-027): the polling episode in progress — when its first round started, and its rounds. */
42: interface PollingEpisode {
43:   startedAt: number;
44:   rounds: number;
45: }
46: 
47: /** T19: a round starts; the first one of an episode records `polling_start`. */
48: function notePollingRound(episode: MutableRefObject<PollingEpisode | null>): void {
49:   if (!episode.current) {
50:     episode.current = { startedAt: Date.now(), rounds: 0 };
51:     recordMessagingMetric({ type: 'polling_start' });
52:   }
53:   episode.current.rounds += 1;
54: }
55: 
56: /** T19: the episode ends (streams healthy again, user changed, unmounted): `polling_stop` with its duration and 
rounds. */
57: function endPollingEpisode(episode: MutableRefObject<PollingEpisode | null>): void {
58:   const current = episode.current;
59:   if (!current) return;
60:   episode.current = null;
61:   const durationMs = metricDurationMs(current.startedAt, Date.now());
62:   if (durationMs !== null) recordMessagingMetric({ type: 'polling_stop', durationMs, count: 
metricCount(current.rounds) });
63: }
64: 
65: /**
66:  * One polling round: the open feed, open reader lists, and the conversation
67:  * list, together. Block B fix F6: it ends at its deadline (`control.signal`
68:  * aborted) whatever is still running — the feed and list requests are
69:  * aborted; a reader-list refetch left running belongs to its own query.
70:  */
71: async function pollOnce(
72:   queryClient: QueryClient,
73:   userId: string,
74:   conversationId: string | null,
75:   control: PollRequestControl
76: ): Promise<void> {
77:   if (debugLogger.messaging.enabled()) {
78:     debugLogger.messaging.event('useMessagingPollingFallback', 'poll', { conversationId });
79:   }
80:   const deadline = new Promise<void>((resolve) => {
81:     if (control.signal.aborted) resolve();
82:     else control.signal.addEventListener('abort', () => resolve(), { once: true });
83:   });
84:   await Promise.race([
85:     deadline,
86:     Promise.allSettled([
87:       conversationId ? pollConversationFeed(queryClient, conversationId, control) : Promise.resolve(),
88:       // An open reader list refetches through its own query: a Realtime
89:       // receipt reconciles after a fetch in flight (useMessageSubscription,
90:       // F7), so a stale poll never stands.
91:       queryClient.refetchQueries({ queryKey: MESSAGE_READERS_QUERY_KEY, type: 'active' }, { cancelRefetch: false 
}),
92:       pollQueryIfUnchanged(
93:         queryClient,
94:         conversationsQueryKey(userId),
95:         (signal) => fetchConversationList(userId, 'poll', signal),
96:         control
97:       ),
98:     ]),
99:   ]);
100: }
101: 
102: /**
103:  * Phase 5 T14 (FR-016, BR-012): polling fallback while Realtime is unhealthy.
104:  * Once any required messaging stream (messages, list) has been unhealthy for
105:  * more than 30 s and the tab is visible, the open conversation's feed (new
106:  * messages, receipt summaries of its loaded messages), any open reader list
107:  * and the conversation list are fetched every 15 s; on becoming visible while
108:  * that holds, at once. Nothing polls while the tab is hidden, and no round
109:  * starts once every required stream is healthy again (a round in flight
110:  * finishes; its results merge without replacing newer state; a multi-page
111:  * feed read starts no further page then, F11). A round ends within 10 s
112:  * (block B fix F6: its requests are aborted at that deadline) and blocks only
113:  * the next round of the same signed-in identity. Health is this
114:  * tab's (T13: healthy means SUBSCRIBED, not "no event missed"); there is no
115:  * reconciliation while the streams are healthy.
116:  */
117: export function useMessagingPollingFallback({ health, userId, conversationId }: 
UseMessagingPollingFallbackOptions): void {
118:   const queryClient = useQueryClient();
119:   const snapshot = useSyncExternalStore(health.subscribe, health.getSnapshot, health.getSnapshot);
120:   const since = unhealthySince(snapshot, REQUIRED_MESSAGING_STREAMS);
121:   const visible = useSyncExternalStore(subscribeVisibility, isTabVisible, () => true);
122: 
123:   const userRef = useRef(userId);
124:   const conversationRef = useRef(conversationId);
125:   /** Block B fix F6: identity generation — a new one on every user change (A → C → A included). */
126:   const generationRef = useRef(0);
127:   /** T19: metrics of the polling episode in progress (null: not polling). */
128:   const episodeRef = useRef<PollingEpisode | null>(null);
129:   useEffect(() => () => endPollingEpisode(episodeRef), []);
130: 
131:   useEffect(() => {
132:     if (userRef.current !== userId) {
133:       generationRef.current += 1;
134:       endPollingEpisode(episodeRef);
135:     }
136:     userRef.current = userId;
137:     conversationRef.current = conversationId;
138:   }, [userId, conversationId]);
139: 
140:   const lastRoundAtRef = useRef<number | null>(null);
141:   /** The round in flight and the identity generation it belongs to (F6). */
142:   const roundRef = useRef<{ generation: number; controller: AbortController } | null>(null);
143:   const wasHiddenRef = useRef(false);
144: 
145:   useEffect(() => {
146:     // T19: the episode ends once every required stream is healthy again
147:     // (whether or not the tab is visible), or without a user.
148:     if (!userId || since === null) endPollingEpisode(episodeRef);
149:     if (!visible) {
150:       wasHiddenRef.current = true;
151:       return;
152:     }
153:     const becameVisible = wasHiddenRef.current;
154:     wasHiddenRef.current = false;
155:     if (!userId || since === null) return;
156: 
157:     let stopped = false;
158:     let timer: ReturnType<typeof setTimeout> | null = null;
159:     const schedule = (delay: number) => {
160:       timer = setTimeout(tick, Math.max(0, delay));
161:     };
162: 
163:     function tick() {
164:       timer = null;
165:       if (stopped || !userId) return;
166:       // Read at fire time (the store can change before React re-runs this effect).
167:       const unhealthyFrom = unhealthySince(health.getSnapshot(), REQUIRED_MESSAGING_STREAMS);
168:       if (unhealthyFrom === null || !isTabVisible()) return;
169:       const dueAt = unhealthyFrom + POLL_AFTER_UNHEALTHY_MS;
170:       if (Date.now() < dueAt) {
171:         schedule(dueAt - Date.now());
172:         return;
173:       }
174:       schedule(POLL_INTERVAL_MS);
175:       // One round at a time per identity (F6): a round of a previous identity
176:       // never blocks this one — it is aborted (its results are dropped anyway).
177:       const generation = generationRef.current;
178:       const inFlight = roundRef.current;
179:       if (inFlight?.generation === generation) return;
180:       inFlight?.controller.abort();
181:       const controller = new AbortController();
182:       const round = { generation, controller };
183:       roundRef.current = round;
184:       lastRoundAtRef.current = Date.now();
185:       notePollingRound(episodeRef);
186:       const pollUser = userId;
187:       const isCurrent = () => userRef.current === pollUser && generationRef.current === generation;
188:       const control: PollRequestControl = {
189:         isCurrent,
190:         // F11: before each further request, the round must still be eligible.
191:         mayRequest: () =>
192:           isCurrent()
193:           && !controller.signal.aborted
194:           && isTabVisible()
195:           && unhealthySince(health.getSnapshot(), REQUIRED_MESSAGING_STREAMS) !== null,
196:         signal: controller.signal,
197:       };
198:       const deadline = setTimeout(() => controller.abort(), POLL_ROUND_DEADLINE_MS);
199:       void pollOnce(queryClient, pollUser, conversationRef.current, control).finally(() => {
200:         clearTimeout(deadline);
201:         // Only this round releases its own slot (an obsolete one never frees a newer round's).
202:         if (roundRef.current === round) roundRef.current = null;
203:       });
204:     }
205: 
206:     const now = Date.now();
207:     const eligibleAt = since + POLL_AFTER_UNHEALTHY_MS;
208:     const lastRoundAt = lastRoundAtRef.current;
209:     const at = becameVisible || lastRoundAt === null
210:       ? Math.max(now, eligibleAt)
211:       : Math.max(eligibleAt, lastRoundAt + POLL_INTERVAL_MS);
212:     schedule(at - now);
213: 
214:     return () => {
215:       stopped = true;
216:       if (timer) clearTimeout(timer);
217:     };
218:   }, [health, queryClient, since, userId, visible]);
219: }


src/lib/messaging/polling-fallback.ts
1: // src/lib/messaging/polling-fallback.ts
2: // Phase 5 T14 (FR-016, BR-012, AC-016, AC-048): what one polling-fallback
3: // round fetches while a required messaging Realtime stream is unhealthy, and
4: // how its results reach the caches without ever replacing newer state. The
5: // schedule (unhealthy > 30 s, visible tab, every 15 s) lives in
6: // useMessagingPollingFallback.
7: import type { QueryClient, QueryKey } from '@tanstack/react-query';
8: 
9: import { messagingApi } from '@/lib/messaging-api';
10: import {
11:   isMessageDeleted,
12:   keepMessageThroughInflightFetch,
13:   mergePolledMessages,
14:   type MessagesInfiniteData,
15: } from '@/lib/messaging/message-cache';
16: import type { Message } from '@/types/messaging';
17: 
18: /** Polling starts once a required stream has been unhealthy this long (BR-012). */
19: export const POLL_AFTER_UNHEALTHY_MS = 30_000;
20: /** Interval between polling rounds (BR-012). */
21: export const POLL_INTERVAL_MS = 15_000;
22: /** Messages per poll request (the route's maximum). */
23: const POLL_PAGE_SIZE = 100;
24: /** Bound on the requests of one feed poll (POLL_PAGE_SIZE messages each). */
25: const MAX_FEED_POLL_REQUESTS = 10;
26: /**
27:  * Block B fix F6: deadline of one polling round; its requests still running
28:  * then are aborted and the round ends (a stalled request never holds the
29:  * next round).
30:  */
31: export const POLL_ROUND_DEADLINE_MS = 10_000;
32: 
33: /** How a round's requests run (block B fixes F6, F11). */
34: export interface PollRequestControl {
35:   /** The round's results still belong to the signed-in user (else they are dropped). */
36:   isCurrent: () => boolean;
37:   /**
38:    * F11: a further request may start now (visible tab, a stream still
39:    * unhealthy, same user); checked before each page of a multi-page poll.
40:    */
41:   mayRequest: () => boolean;
42:   /** F6: aborted at the round's deadline. */
43:   signal: AbortSignal;
44: }
45: 
46: type Snapshot<T> = { data: T | undefined; dataUpdatedAt: number };
47: 
48: const snapshotOf = <T>(queryClient: QueryClient, queryKey: QueryKey): Snapshot<T> | null => {
49:   const query = queryClient.getQueryCache().find<T>({ queryKey, exact: true });
50:   return query ? { data: query.state.data, dataUpdatedAt: query.state.dataUpdatedAt } : null;
51: };
52: 
53: /**
54:  * Nothing wrote the query since `start` (no Realtime update, fetch, or local
55:  * change) and no fetch of its own is running (which would replace whatever
56:  * is written now): a result read by the server after `start` is the newest
57:  * state the query can hold.
58:  */
59: const unchangedSince = <T>(queryClient: QueryClient, queryKey: QueryKey, start: Snapshot<T>): boolean => {
60:   const query = queryClient.getQueryCache().find<T>({ queryKey, exact: true });
61:   return Boolean(
62:     query &&
63:       query.state.data === start.data &&
64:       query.state.dataUpdatedAt === start.dataUpdatedAt &&
65:       query.state.fetchStatus !== 'fetching'
66:   );
67: };
68: 
69: const messageTime = (message: Message): number => new Date(message.timestamp).getTime();
70: 
71: /**
72:  * Polls the open conversation's feed: its new messages and the current state
73:  * (receipt summaries, reactions, attachments) of its loaded messages, read
74:  * newest first until the oldest loaded message is covered. Merged by
75:  * mergePolledMessages: new messages are added once; loaded messages take the
76:  * polled state only when the feed was not written while the poll ran (a
77:  * Realtime event, a refetch or a local change that lands first is newer and
78:  * wins; the next round catches up). A feed never loaded is left to its own
79:  * first fetch.
80:  */
81: export async function pollConversationFeed(
82:   queryClient: QueryClient,
83:   conversationId: string,
84:   { isCurrent, mayRequest, signal }: PollRequestControl
85: ): Promise<void> {
86:   const queryKey = ['messages', conversationId] as const;
87:   const start = snapshotOf<MessagesInfiniteData>(queryClient, queryKey);
88:   const startData = start?.data;
89:   if (!start || !startData?.pages?.length) return;
90: 
91:   const cachedAtStart = new Set<string>();
92:   let oldestLoaded: Message | undefined;
93:   for (const page of startData.pages) {
94:     for (const message of page.messages) {
95:       cachedAtStart.add(message.id);
96:       if (!oldestLoaded || messageTime(message) < messageTime(oldestLoaded)) oldestLoaded = message;
97:     }
98:   }
99: 
100:   const polled: Message[] = [];
101:   let cursorBefore: string | undefined;
102:   let moreOlder = false;
103:   for (let request = 0; request < MAX_FEED_POLL_REQUESTS; request += 1) {
104:     // F11: no further page once the tab is hidden, Realtime recovered or the
105:     // user changed; a partial read is not merged.
106:     if (!mayRequest()) return;
107:     const page = await messagingApi.getMessages(conversationId, {
108:       limit: POLL_PAGE_SIZE,
109:       cursorBefore,
110:       source: 'poll',
111:       signal,
112:     });
113:     if (!isCurrent()) return;
114:     polled.unshift(...page.messages);
115:     moreOlder = Boolean(page.hasMoreOlder && page.nextCursorBefore);
116:     const oldestPolled = page.messages[0];
117:     if (!moreOlder || !oldestLoaded || (oldestPolled && messageTime(oldestPolled) <= messageTime(oldestLoaded))) {
118:       break;
119:     }
120:     cursorBefore = page.nextCursorBefore;
121:   }
122: 
123:   // More new messages than the bounded read reaches: merging them would leave
124:   // a hole between them and the loaded feed. The feed refetches instead
125:   // (without cancelling a fetch in flight).
126:   if (moreOlder && !polled.some((message) => cachedAtStart.has(message.id))) {
127:     void queryClient.invalidateQueries({ queryKey, exact: true }, { cancelRefetch: false });
128:     return;
129:   }
130: 
131:   const current = queryClient.getQueryData<MessagesInfiniteData>(queryKey);
132:   if (!current?.pages?.length) return;
133:   const merge = mergePolledMessages(current, polled, {
134:     replaceExisting: unchangedSince(queryClient, queryKey, start),
135:     cachedAtStart,
136:     isDeleted: (messageId) => isMessageDeleted(queryClient, messageId),
137:   });
138:   if (!merge.changed) return;
139:   queryClient.setQueryData<MessagesInfiniteData>(queryKey, merge.data);
140:   // A fetch of the feed's own already in flight replaces the pages when it
141:   // settles; the added messages are merged again after it.
142:   for (const message of merge.added) keepMessageThroughInflightFetch(queryClient, conversationId, message);
143: }
144: 
145: /**
146:  * Polls a whole-result query (the conversation list) with `fetcher` and
147:  * stores the result only if nothing wrote the query while the poll ran: a
148:  * Realtime update, local change or fetch of its own that lands first is at
149:  * least as new and wins (the next round catches up). Returns whether the
150:  * result was stored.
151:  */
152: export async function pollQueryIfUnchanged<T>(
153:   queryClient: QueryClient,
154:   queryKey: QueryKey,
155:   fetcher: (signal: AbortSignal) => Promise<T>,
156:   { isCurrent, mayRequest, signal }: PollRequestControl
157: ): Promise<boolean> {
158:   const start = snapshotOf<T>(queryClient, queryKey);
159:   if (!start || start.data === undefined || !mayRequest()) return false;
160:   const result = await fetcher(signal);
161:   if (!isCurrent() || !unchangedSince(queryClient, queryKey, start)) return false;
162:   queryClient.setQueryData<T>(queryKey, result);
163:   return true;
164: }


