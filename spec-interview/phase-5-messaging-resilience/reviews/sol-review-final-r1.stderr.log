153:   viewedConversationId: string | null;
154:   tabVisible: boolean;
155: }): IncomingMessageDecision {
156:   const { message, conversation, currentUserId, viewedConversationId, tabVisible } = input;
157:   // users.id comparison (the realtime row's sender_id is the application id).
158:   if (message.senderId === currentUserId) return 'skip';
159:   if (message.type === MessageType.SYSTEM) return 'skip';
160:   const directOrGroup = conversation.type === ConversationType.DIRECT || conversation.type === 
ConversationType.GROUP;
161:   if (!directOrGroup && !(conversation.type === ConversationType.ROOM && mayMention(message))) return 'skip';
162:   if (tabVisible && viewedConversationId === conversation.id) return 'viewing';
163:   return directOrGroup ? 'notify' : 'mention-only';
164: }
165: 
166: /**
167:  * Phase 5 FR-025 (browser-wide suppression): each tab of the user records in
168:  * localStorage, under its own key, the conversation it shows while it is
169:  * visible; a tab about to announce a message first reads every other tab's
170:  * record, synchronously. So no tab announces a conversation another visible
171:  * tab of the same user is viewing, whichever tab received the message first.
172:  * A visible tab refreshes its record (VIEW_HEARTBEAT_MS); a record older than
173:  * VIEW_TTL_MS (a tab that crashed or froze without hiding) no longer counts.
174:  */
175: const VIEW_KEY_PREFIX = 'vo:messaging:notification-view:';
176: export const VIEW_HEARTBEAT_MS = 10_000;
177: const VIEW_TTL_MS = 30_000;
178: 
179: const viewKeyPrefix = (userId: string) => `${VIEW_KEY_PREFIX}${userId}:`;
180: 
181: interface ConversationViewRecord {
182:   conversationId: string;
183:   at: number;
184: }
185: 
186: function parseViewRecord(raw: string | null): ConversationViewRecord | null {
187:   if (!raw) return null;
188:   try {
189:     const parsed: unknown = JSON.parse(raw);
190:     if (!parsed || typeof parsed !== 'object') return null;
191:     const { conversationId, at } = parsed as Record<string, unknown>;
192:     return typeof conversationId === 'string' && typeof at === 'number' ? { conversationId, at } : null;
193:   } catch {
194:     return null;
195:   }
196: }
197: 
198: /** Records (or, with null, removes) the conversation this visible tab shows. */
199: export function publishConversationView(userId: string, tabId: string, conversationId: string | null): void {
200:   try {
201:     const key = `${viewKeyPrefix(userId)}${tabId}`;
202:     if (conversationId) {
203:       window.localStorage.setItem(key, JSON.stringify({ conversationId, at: Date.now() }));
204:     } else {
205:       window.localStorage.removeItem(key);
206:     }
207:   } catch {
208:     // Storage unavailable: other tabs cannot see this one (best effort).
209:   }
210: }
211: 
212: /** Whether another visible tab of the user shows `conversationId` now. Removes expired records. */
213: export function isConversationViewedElsewhere(userId: string, tabId: string, conversationId: string): boolean {
214:   try {
215:     const prefix = viewKeyPrefix(userId);
216:     const own = `${prefix}${tabId}`;
217:     const now = Date.now();
218:     const expired: string[] = [];
219:     let viewed = false;
220:     for (let index = 0; index < window.localStorage.length; index += 1) {
221:       const key = window.localStorage.key(index);
222:       if (!key || !key.startsWith(prefix) || key === own) continue;
223:       const record = parseViewRecord(window.localStorage.getItem(key));
224:       if (!record || now - record.at >= VIEW_TTL_MS) {
225:         expired.push(key);
226:       } else if (record.conversationId === conversationId) {
227:         viewed = true;
228:       }
229:     }
230:     expired.forEach((key) => window.localStorage.removeItem(key));
231:     return viewed;
232:   } catch {
233:     return false;
234:   }
235: }
236: 
237: const tabClaims = new Set<string>();
238: 
239: function rememberTabClaim(messageId: string): boolean {
240:   if (tabClaims.has(messageId)) return false;
241:   tabClaims.add(messageId);
242:   if (tabClaims.size > MAX_TAB_CLAIMS) {
243:     const oldest = tabClaims.values().next().value;
244:     if (oldest !== undefined) tabClaims.delete(oldest);
245:   }
246:   return true;
247: }
248: 
249: function claimAcrossTabs(messageId: string): boolean {
250:   try {
251:     const now = Date.now();
252:     const raw = window.localStorage.getItem(NOTIFIED_STORAGE_KEY);
253:     const parsed: unknown = raw ? JSON.parse(raw) : {};
254:     const claims: Record<string, number> = {};
255:     if (parsed && typeof parsed === 'object' && !Array.isArray(parsed)) {
256:       for (const [id, at] of Object.entries(parsed as Record<string, unknown>)) {
257:         if (typeof at === 'number' && now - at < NOTIFIED_TTL_MS) claims[id] = at;
258:       }
259:     }
260:     if (claims[messageId] !== undefined) return false;
261:     claims[messageId] = now;
262:     window.localStorage.setItem(NOTIFIED_STORAGE_KEY, JSON.stringify(claims));
263:     return true;
264:   } catch {
265:     // No shared storage: this tab alone decides.
266:     return true;
267:   }
268: }
