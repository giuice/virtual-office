743:   -- Phase 5 T3 (FR-008, D1): the insertion quota, charged by this winning
744:   -- insertion in its own transaction, as the last step before commit.
745:   -- private.charge_message_insertion_quota serializes this sender's charges
746:   -- until commit and reads the window after that lock, so the count is exact
747:   -- at a quota boundary and across a window rollover. Refused or uncheckable →
748:   -- raise: the whole insertion (and this counter increment) rolls back and
749:   -- nothing is stored.
750:   if p_insert_quota_limit is not null then
751:     begin
752:       v_quota_allowed := private.charge_message_insertion_quota(
753:         p_sender_id, p_insert_quota_limit, p_insert_quota_window_seconds);
754:     exception when others then
755:       raise exception 'RATE_LIMIT_UNAVAILABLE'
756:         using errcode = 'P0001', detail = pg_catalog.format('%s: %s', sqlstate, sqlerrm);
757:     end;
758:     if v_quota_allowed is distinct from true then
759:       raise exception 'RATE_LIMITED' using errcode = 'P0001';
760:     end if;
761:   end if;
762: 
763:   return pg_catalog.jsonb_build_object(
764:     'message_id', v_message_id,
765:     'created', true,
766:     'composition', p_composition,
767:     'message', pg_catalog.to_jsonb(v_row),
768:     'mentioned_user_ids', pg_catalog.to_jsonb(v_mentioned)
769:   );
770: end
