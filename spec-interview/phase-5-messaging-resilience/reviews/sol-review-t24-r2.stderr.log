1: /**
2:  * Phase 5 T24 — strict parser for the LOCAL messaging test database URL.
3:  *
4:  * The E2E fixtures connect to Postgres as a superuser and delete test state, so
5:  * the target must be the loopback Supabase CLI database. Validating a URL with
6:  * one parser and connecting with another is unsafe (a URL such as
7:  * `postgresql://u:p@127.0.0.1\@example.invalid:54322/db` looks loopback to the
8:  * WHATWG URL parser but `pg` connects to example.invalid). So this module
9:  * accepts only one plain shape and returns explicit connection fields; callers
10:  * pass those fields to `pg` (never the URL itself):
11:  *
12:  *   postgres[ql]://<user>:<password>@<127.0.0.1 | localhost | [::1]>:<port>/<database>
13:  *
14:  * Refused: an empty password (pg would fall back to PGPASSWORD/.pgpass),
15:  * backslashes, any query string or fragment, multiple hosts (comma lists),
16:  * Unix-socket forms, percent-encoding outside the password, and any host other
17:  * than the three loopback spellings. Self-contained (no imports).
18:  */
19: export interface LocalDbConnectionConfig {
20:   host: '127.0.0.1' | 'localhost' | '::1';
21:   port: number;
22:   user: string;
23:   password: string;
24:   database: string;
25: }
26: 
27: const LOCAL_DB_URL_PATTERN =
28:   /^postgres(?:ql)?:\/\/([A-Za-z0-9_.-]{1,63}):([A-Za-z0-9_.~!$&'()*+;=%-]{1,256})@(127\.0\.0\.1|localhost|\[::1\])
:(\d{1,5})\/([A-Za-z0-9_-]{1,63})$/;
29: 
30: export function parseLoopbackDatabaseUrl(url: string): LocalDbConnectionConfig {
31:   const refuse = (reason: string): never => {
32:     throw new Error(`Refusing the messaging test database URL (${reason}); only a plain loopback URL is 
accepted.`);
33:   };
34:   if (/[\\\s,?#]/.test(url)) {
35:     refuse('backslash, whitespace, comma, query string or fragment');
36:   }
37:   const match = LOCAL_DB_URL_PATTERN.exec(url);
38:   if (!match) {
39:     return refuse('not postgres[ql]://user:password@<loopback>:<port>/<database>');
40:   }
41:   const [, user, encodedPassword, rawHost, rawPort, database] = match;
42:   let password: string;
43:   try {
44:     password = decodeURIComponent(encodedPassword);
45:   } catch {
46:     return refuse('malformed percent-encoding in the password');
47:   }
48:   const port = Number(rawPort);
49:   if (!Number.isInteger(port) || port < 1 || port > 65_535) {
50:     return refuse('invalid port');
51:   }
52:   const host = rawHost === '[::1]' ? '::1' : (rawHost as '127.0.0.1' | 'localhost');
53:   return { host, port, user, password, database };
54: }
