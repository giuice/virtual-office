141:     otherSessionKeys.push(...(await clearTabSessionStorage(tab, MESSAGING_STORAGE_KEY_PREFIX)));
142:   }
143:   const left: string[] = [];
144:   for (const tab of [page, ...otherTabs]) {
145:     const after = await readMessagingBrowserState(tab);
146:     left.push(...after.localStorageKeys, ...after.sessionStorageKeys, ...after.indexedDbNames);
147:   }
148:   if (left.length > 0) {
149:     throw new Error(`Messaging browser state left after cleanup: ${[...new Set(left)].join(', ')}`);
