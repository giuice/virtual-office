160:     `select count from private.rate_limit_counters
161:       where user_id = $1::uuid and action = $2::text
162:         and window_start <= clock_timestamp()
163:         and window_start > clock_timestamp() - make_interval(secs => $3::int)`,
164:     [userId, action, BUDGET_WINDOW_SECONDS],
165:   );
166:   return rows[0]?.count ?? 0;
