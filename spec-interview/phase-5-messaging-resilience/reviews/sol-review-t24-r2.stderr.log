27: /**
28:  * Phase 5 T24 — E2E fixtures for the Phase 5 runner
29:  * (playwright.messaging-phase5.config.ts; local Supabase, real Chrome/Edge).
30:  *
31:  *   phase5World   users A–E in one company; a DM (A–B), a group (A–E) and a room
32:  *                 conversation (A–E, in reusable room "Test Space Fixed 1");
33:  *                 removed with all their server state after the test.
34:  *   openDevice    openDevice('A') → a signed-in device: a fresh browser context
35:  *                 with its own sign-in (its own Supabase session). Call it again
36:  *                 for the same user to get a second device; device.newTab()
37:  *                 opens another tab of the same device (same session/storage).
38:  *   membership    remove(conversationId, 'E') — administrative removal through
39:  *                 the seed route (service-role DELETE → revocation, T28);
40:  *                 restore(conversationId, 'E') — re-add through
41:  *                 restore_conversation_membership, the only authorized rejoin.
42:  *   budgets       exhaust('A') — A's insertion quota ('message:create') charged
43:  *                 by the real check_rate_limit and held exhausted (also
44:  *                 'message:create-request' / 'message:fence'); reset('A').
45:  *   serverLog     raw local server log lines (helpers/server-log.ts).
46:  *
47:  * Cleanup (after each test, and in global setup for interrupted runs): the
48:  * world's conversations (cascading members, messages, mentions, attempt/fence
49:  * rows, revocations), then every budget counter and attempt/fence row of A–E
50:  * and their revocations/mentions in test-only conversations; the teardown
51:  * fails the test if any of that is left. Browser state is discarded with each
52:  * device's context (helpers/messaging-browser-state.ts).
53:  */
54: 
55: export const PHASE5_USER_KEYS = ['A', 'B', 'C', 'D', 'E'] as const;
56: export type Phase5UserKey = (typeof PHASE5_USER_KEYS)[number];
57: 
58: /** Env prefix of each account (PLAYWRIGHT_<X>_EMAIL/_PASSWORD/_DISPLAY_NAME). */
59: const ACCOUNT_ENV_PREFIX: Record<Phase5UserKey, string> = {
60:   A: 'PLAYWRIGHT_PRIMARY',
61:   B: 'PLAYWRIGHT_SECONDARY',
62:   C: 'PLAYWRIGHT_TERTIARY',
63:   D: 'PLAYWRIGHT_FOURTH',
64:   E: 'PLAYWRIGHT_FIFTH',
65: };
66: 
67: export interface Phase5User {
68:   key: Phase5UserKey;
69:   /** users.id (application id). */
70:   userId: string;
71:   /** users.supabase_uid (auth.uid()). */
72:   supabaseUid: string;
73:   email: string;
74:   password: string;
75:   displayName: string;
76: }
77: 
78: export interface Phase5World {
79:   runId: string;
80:   companyId: string;
81:   users: Record<Phase5UserKey, Phase5User>;
82:   conversations: {
83:     /** Direct conversation of A and B. */
84:     directId: string;
85:     /** Group conversation of A–E. */
86:     groupId: string;
87:     /** Room conversation of A–E. */
88:     roomId: string;
89:   };
90:   /** The room (space) of `conversations.roomId`. */
91:   roomSpaceId: string;
92:   seededMessageIds: string[];
93: }
94: 
95: export interface Phase5Device {
96:   user: Phase5User;
97:   /** Unique per test, e.g. "A#1", "A#2" (second device of A). */
98:   label: string;
99:   context: BrowserContext;
100:   /** The device's first tab, signed in and on the post-login page. */
101:   page: Page;
102:   /** Another tab of this device (same session and browser storage). */
103:   newTab(): Promise<Page>;
104: }
105: 
106: export type OpenDevice = (user: Phase5UserKey) => Promise<Phase5Device>;
107: 
108: export interface MembershipControl {
109:   /** Administrative removal (service-role DELETE → revocation). Returns rows removed. */
110:   remove(conversationId: string, user: Phase5UserKey): Promise<number>;
111:   /** Re-add via restore_conversation_membership; verifies the row is back and the revocation lifted. */
112:   restore(conversationId: string, user: Phase5UserKey): Promise<void>;
113:   isMember(conversationId: string, user: Phase5UserKey): Promise<boolean>;
114:   isRevoked(conversationId: string, user: Phase5UserKey): Promise<boolean>;
115: }
116: 
117: export interface BudgetControl {
118:   /** Exhausts the user's budget (default: insertion quota 'message:create'). */
119:   exhaust(
120:     user: Phase5UserKey,
121:     action?: MessagingBudgetAction,
122:     options?: { windows?: number; minRemainingMs?: number },
123:   ): Promise<ExhaustedBudget>;
124:   /** Deletes the users' counters (default: every budget of A–E). */
125:   reset(users?: readonly Phase5UserKey[], actions?: readonly MessagingBudgetAction[]): Promise<number>;
126:   /** The user's counter in the current window. */
127:   count(user: Phase5UserKey, action: MessagingBudgetAction): Promise<number>;
128: }
