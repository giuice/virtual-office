242: async function signInDevice(browser: Browser, user: Phase5User, label: string) {
243:   const context = await browser.newContext();
244:   const page = await context.newPage();
245:   const verifyTraffic = guardLocalSupabaseTraffic(page, label);
246:   await closePlacementToasts(page);
247:   await login(page, user.email, user.password);
248:   return { context, page, verifyTraffic };
249: }
