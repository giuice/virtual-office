41: /** Opens the drawer on a conversation, as the Phase 4 specs do. */
42: async function openConversation(page: Page, conversationId: string): Promise<void> {
43:   await page.goto('/floor-plan');
44:   await page.waitForLoadState('networkidle');
45:   await openDrawer(page);
46:   await waitForRealtimeReady(page);
47:   await selectConversation(page, { id: conversationId });
48: }
