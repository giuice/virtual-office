46: function readBytesFrom(path: string, offset: number): Buffer {
47:   if (!existsSync(path)) {
48:     throw new Error(`The raw server log ${path} does not exist; run through the Phase 5 runner.`);
49:   }
50:   const content = readFileSync(path);
51:   // The tee truncates the file when a new server starts; a mark from before
52:   // that restart reads the whole new file.
53:   return content.length >= offset ? content.subarray(offset) : content;
54: }
55: 
56: function completeLines(bytes: Buffer): string[] {
57:   const lastNewline = bytes.lastIndexOf(0x0a);
58:   if (lastNewline < 0) return [];
59:   return bytes
60:     .subarray(0, lastNewline)
61:     .toString('utf8')
62:     .split('\n')
63:     .map((line) => (line.endsWith('\r') ? line.slice(0, -1) : line));
64: }
65: 
66: export function openServerLog(path = process.env[SERVER_LOG_FILE_ENV]): ServerLog {
67:   if (!path) {
68:     throw new Error(`${SERVER_LOG_FILE_ENV} is not set: raw server logs exist only under the Phase 5 runner.`);
69:   }
70:   const logPath = path;
71:   return {
72:     path: logPath,
73:     mark() {
74:       return { offset: existsSync(logPath) ? statSync(logPath).size : 0 };
75:     },
76:     linesSince(since) {
77:       return completeLines(readBytesFrom(logPath, since.offset));
78:     },
79:     async waitForLine(match, { since, timeoutMs = 10_000 }) {
80:       const deadline = Date.now() + timeoutMs;
81:       let seen = 0;
82:       for (;;) {
83:         const lines = completeLines(readBytesFrom(logPath, since.offset));
84:         seen = lines.length;
85:         const found = lines.find(match);
86:         if (found !== undefined) return found;
87:         if (Date.now() >= deadline) {
88:           throw new Error(`No matching server log line within ${timeoutMs} ms (${seen} line(s) since the mark).`);
89:         }
90:         await new Promise((resolve) => setTimeout(resolve, POLL_INTERVAL_MS));
91:       }
92:     },
93:   };
94: }
