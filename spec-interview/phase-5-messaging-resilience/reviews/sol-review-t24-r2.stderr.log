141: /** Deletes the users' budget counters (every action unless `actions` is given). Returns the rows removed. */
142: export async function resetBudgets(
143:   db: Client,
144:   userIds: readonly string[],
145:   actions?: readonly string[],
146: ): Promise<number> {
147:   if (userIds.length === 0) return 0;
148:   const result = actions
149:     ? await db.query(
150:         'delete from private.rate_limit_counters where user_id = any($1::uuid[]) and action = any($2::text[])',
151:         [userIds, actions],
152:       )
153:     : await db.query('delete from private.rate_limit_counters where user_id = any($1::uuid[])', [userIds]);
154:   return result.rowCount ?? 0;
155: }
