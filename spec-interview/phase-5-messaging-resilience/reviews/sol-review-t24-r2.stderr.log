  ['?host= override', 'postgresql://postgres:demo@127.0.0.1:54322/postgres?host=example.invalid', false],
  ['?hostaddr= override', 'postgresql://postgres:demo@127.0.0.1:54322/postgres?hostaddr=192.0.2.1', false],
  ['socket path (encoded host)', 'postgresql://postgres:demo@%2Fvar%2Frun%2Fpostgresql:5432/postgres', false],
  ['socket path (no host + ?host=)', 'postgresql:///postgres?host=/var/run/postgresql', false],
  ['socket: scheme', 'socket:/var/run/postgresql?db=postgres', false],
  ['non-loopback host', 'postgresql://postgres:demo@db.example.invalid:5432/postgres', false],
  ['empty password (PGPASSWORD fallback)', 'postgresql://postgres:@127.0.0.1:54322/postgres', false],
  ['fragment', 'postgresql://postgres:demo@127.0.0.1:54322/postgres#x', false],
];

let failures = 0;
for (const [label, url, expectAccepted] of cases) {
  let pgHost;
  try {
    pgHost = new ConnectionParameters(url).host;
