44: function realBrowser(device: 'Desktop Chrome' | 'Desktop Edge', channel: 'chrome' | 'msedge'): Project['use'] {
45:   const { userAgent: _presetUserAgent, ...preset } = devices[device];
46:   void _presetUserAgent;
