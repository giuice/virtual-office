121:           request.onsuccess = () => {
122:             window.clearTimeout(timer);
123:             resolve(null);
124:           };
125:           request.onerror = () => {
126:             window.clearTimeout(timer);
127:             resolve(`${name}: ${request.error?.message ?? 'delete failed'}`);
128:           };
