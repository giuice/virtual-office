130: const PLAYWRIGHT_SECRET = process.env.PLAYWRIGHT_TEST_SECRET ?? '';
131: const seedHeaders = () => ({ 'x-test-secret': PLAYWRIGHT_SECRET });
132: 
133: function requireEnv(key: string): string {
134:   const value = process.env[key];
135:   if (!value) {
136:     throw new Error(`${key} must be set (Phase 5 runner sets it in local mode).`);
137:   }
138:   return value;
139: }
