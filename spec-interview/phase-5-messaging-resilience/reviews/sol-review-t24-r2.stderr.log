58: // ---------------------------------------------------------------------------
59: // Budgets (private.rate_limit_counters, charged by public.check_rate_limit)
60: // ---------------------------------------------------------------------------
61: 
62: /** The send budgets of SPEC FR-008 / TRACK T3 (src/lib/auth/rate-limit.ts). */
63: export type MessagingBudgetAction = 'message:create' | 'message:create-request' | 'message:fence';
64: 
65: /**
66:  * Window length of every messaging budget (rate-limit.ts: 60 s each). Used
67:  * only to place the window rows; the probe proves a real create is refused.
68:  */
69: export const BUDGET_WINDOW_SECONDS = 60;
70: 
71: /** Far above any configured limit: an exhausted window stays exhausted however the limit is tuned. */
72: const EXHAUSTED_COUNT = 1_000_000;
73: 
74: export interface ExhaustedBudget {
75:   action: MessagingBudgetAction;
76:   /** Start of the first exhausted window (database clock). */
77:   windowStart: Date;
78:   /** End of the last exhausted window (database clock). */
79:   exhaustedUntil: Date;
80: }
81: 
82: /**
83:  * Exhausts `userId`'s `action` budget: charges it once through the real
84:  * `public.check_rate_limit` (for 'message:create' that is the insertion-quota
85:  * helper, the same counter create_message_attempt charges), then raises that
86:  * window's counter far above any limit. With `windows` > 1 the following
87:  * windows are pre-charged too, so exhaustion outlasts a window rollover.
88:  * When less than `minRemainingMs` of the current window is left, it first
89:  * waits for the next window so the caller gets at least that long.
90:  */
91: export async function exhaustBudget(
92:   db: Client,
93:   userId: string,
94:   action: MessagingBudgetAction,
95:   options: { windows?: number; minRemainingMs?: number } = {},
96: ): Promise<ExhaustedBudget> {
97:   const windows = Math.min(Math.max(1, Math.floor(options.windows ?? 1)), 10);
98:   const minRemainingMs = options.minRemainingMs ?? 20_000;
99:   const windowMs = BUDGET_WINDOW_SECONDS * 1000;
100: 
101:   const { rows: clock } = await db.query<{ now_ms: string }>(
102:     'select floor(extract(epoch from clock_timestamp()) * 1000)::bigint::text as now_ms',
103:   );
104:   const nowMs = Number(clock[0].now_ms);
105:   const remainingMs = windowMs - (nowMs % windowMs);
106:   if (remainingMs < minRemainingMs) {
107:     await new Promise((resolve) => setTimeout(resolve, remainingMs + 250));
108:   }
109: 
110:   const { rows: charged } = await db.query<{ allowed: boolean }>(
111:     'select public.check_rate_limit($1::uuid, $2::text, 1, $3::integer) as allowed',
112:     [userId, action, BUDGET_WINDOW_SECONDS],
113:   );
114:   if (typeof charged[0]?.allowed !== 'boolean') {
115:     throw new Error(`check_rate_limit returned no result for ${action}`);
116:   }
117:   const { rows: current } = await db.query<{ window_start: Date }>(
118:     `select window_start from private.rate_limit_counters
119:       where user_id = $1::uuid and action = $2::text and window_start <= clock_timestamp()
120:       order by window_start desc limit 1`,
121:     [userId, action],
122:   );
123:   if (current.length === 0) {
124:     throw new Error(`check_rate_limit charged no ${action} counter for the user`);
125:   }
126:   const windowStart = current[0].window_start;
127:   await db.query(
128:     `insert into private.rate_limit_counters (user_id, action, window_start, count)
129:      select $1::uuid, $2::text, $3::timestamptz + make_interval(secs => $4::int * step), $5::int
130:        from generate_series(0, $6::int - 1) as step
131:      on conflict (user_id, action, window_start) do update set count = excluded.count`,
132:     [userId, action, windowStart, BUDGET_WINDOW_SECONDS, EXHAUSTED_COUNT, windows],
133:   );
134:   return {
135:     action,
136:     windowStart,
137:     exhaustedUntil: new Date(windowStart.getTime() + windows * windowMs),
138:   };
139: }
