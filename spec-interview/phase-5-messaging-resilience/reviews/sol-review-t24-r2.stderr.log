37: function tee(stream, destination) {
38:   let pending = Buffer.alloc(0);
39:   stream.on('data', (chunk) => {
40:     destination.write(chunk);
41:     pending = Buffer.concat([pending, chunk]);
42:     const lastNewline = pending.lastIndexOf(0x0a);
43:     if (lastNewline >= 0) {
44:       writeSync(fd, pending.subarray(0, lastNewline + 1));
45:       pending = pending.subarray(lastNewline + 1);
46:     }
47:   });
48:   return new Promise((resolveEnd) => {
49:     const flush = () => {
50:       if (pending.length > 0) {
51:         // Terminate the EOF fragment (the only byte the tee adds).
52:         writeSync(fd, Buffer.concat([pending, LINE_FEED]));
53:         pending = Buffer.alloc(0);
54:       }
55:       resolveEnd();
56:     };
57:     stream.once('end', flush);
58:     stream.once('close', flush);
59:     stream.once('error', flush);
60:   });
61: }
