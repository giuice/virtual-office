418:   /**
419:    * LOCAL SUPABASE ONLY — the caller must have confirmed local mode. Deletes
420:    * the conversations that earlier interrupted or partially failed runs left
421:    * behind: only conversations with a seeded name (test_dm_, Test Room
422:    * Conversation N, Test Group) whose participants and members are all
423:    * `allowedEmails` accounts. Deleting a conversation cascades to its members,
424:    * messages (with their receipts, reactions, stars, pins), receipts, stars,
425:    * and pins. Users, the shared company, and spaces are kept (presence history
426:    * references seeded spaces). Returns the deleted conversation ids.
427:    */
428:   async sweepSeededLeftovers(allowedEmails: ReadonlySet<string>): Promise<string[]> {
429:     if (allowedEmails.size === 0) {
