190: // Cleanup of Phase 5 server state
191: // ---------------------------------------------------------------------------
192: 
193: /** Rows of Phase 5 server state that belong to the test accounts. */
194: export interface MessagingServerStateCounts {
195:   /** private.rate_limit_counters of the users (all budgets). */
196:   budgetCounters: number;
197:   /** private.message_send_attempts (fence state) sent by the users. */
198:   attemptRows: number;
199:   /** private.conversation_member_revocations of the users in test-only conversations. */
200:   revocations: number;
201:   /** public.message_mentions on messages of test-only conversations. */
202:   mentions: number;
203: }
204: 
205: /**
206:  * A conversation whose participants and current members are all `$1` test
207:  * accounts (the shape of every seeded or test-created conversation).
208:  */
209: const TEST_ONLY_CONVERSATIONS = `
210:   select c.id from public.conversations c
211:    where coalesce(cardinality(c.participants), 0) > 0
212:      and c.participants <@ $1::uuid[]
213:      and not exists (
214:        select 1 from public.conversation_members m
215:         where m.conversation_id = c.id and not (m.user_id = any($1::uuid[]))
216:      )`;
217: 
218: export async function countMessagingServerState(
219:   db: Client,
220:   userIds: readonly string[],
221: ): Promise<MessagingServerStateCounts> {
222:   if (userIds.length === 0) {
223:     return { budgetCounters: 0, attemptRows: 0, revocations: 0, mentions: 0 };
224:   }
225:   const { rows } = await db.query<{ budgets: number; attempts: number; revocations: number; mentions: number }>(
226:     `select
227:        (select count(*)::int from private.rate_limit_counters where user_id = any($1::uuid[])) as budgets,
228:        (select count(*)::int from private.message_send_attempts where sender_id = any($1::uuid[])) as attempts,
229:        (select count(*)::int from private.conversation_member_revocations r
230:          where r.user_id = any($1::uuid[]) and r.conversation_id in (${TEST_ONLY_CONVERSATIONS})) as revocations,
231:        (select count(*)::int from public.message_mentions mm
232:           join public.messages msg on msg.id = mm.message_id
233:          where msg.conversation_id in (${TEST_ONLY_CONVERSATIONS})) as mentions`,
234:     [userIds],
235:   );
236:   const row = rows[0];
237:   return {
238:     budgetCounters: row.budgets,
239:     attemptRows: row.attempts,
240:     revocations: row.revocations,
241:     mentions: row.mentions,
242:   };
243: }
244: 
245: /**
246:  * Deletes the test accounts' Phase 5 server state that survives the removal of
247:  * their conversations (or that a run interrupted before its cleanup left
248:  * behind): every budget counter and fence/attempt row of these users, their
249:  * revocations in test-only conversations, and mentions on messages of
250:  * test-only conversations. Conversations themselves are removed by the seed
251:  * route (deleting a conversation cascades to its members, messages, mentions,
252:  * attempt rows, and revocations). Returns the rows deleted.
253:  */
254: export async function cleanupMessagingServerState(
255:   db: Client,
256:   userIds: readonly string[],
257: ): Promise<MessagingServerStateCounts> {
258:   if (userIds.length === 0) {
259:     return { budgetCounters: 0, attemptRows: 0, revocations: 0, mentions: 0 };
260:   }
261:   await db.query('begin');
262:   try {
263:     const mentions = await db.query(
264:       `delete from public.message_mentions mm using public.messages msg
265:         where msg.id = mm.message_id and msg.conversation_id in (${TEST_ONLY_CONVERSATIONS})`,
266:       [userIds],
267:     );
268:     const revocations = await db.query(
269:       `delete from private.conversation_member_revocations r
270:         where r.user_id = any($1::uuid[]) and r.conversation_id in (${TEST_ONLY_CONVERSATIONS})`,
271:       [userIds],
272:     );
273:     const attempts = await db.query('delete from private.message_send_attempts where sender_id = 
any($1::uuid[])', [
274:       userIds,
275:     ]);
276:     const budgets = await db.query('delete from private.rate_limit_counters where user_id = any($1::uuid[])', [
277:       userIds,
278:     ]);
279:     await db.query('commit');
280:     return {
281:       budgetCounters: budgets.rowCount ?? 0,
282:       attemptRows: attempts.rowCount ?? 0,
283:       revocations: revocations.rowCount ?? 0,
284:       mentions: mentions.rowCount ?? 0,
285:     };
286:   } catch (error) {
287:     await db.query('rollback');
288:     throw error;
289:   }
290: }
