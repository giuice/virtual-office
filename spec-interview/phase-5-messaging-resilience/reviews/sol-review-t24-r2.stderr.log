130:       const results = await Promise.all(removed.indexedDbNames.map(deleteDatabase));
131:       return results.filter((result): result is string => result !== null);
132:     },
133:     { removed: before, timeoutMs: blockedTimeoutMs },
134:   );
135:   if (failures.length > 0) {
136:     throw new Error(`Messaging IndexedDB cleanup failed: ${failures.join('; ')}`);
137:   }
138:   const otherTabs = sameOriginTabs(page);
139:   const otherSessionKeys: string[] = [];
