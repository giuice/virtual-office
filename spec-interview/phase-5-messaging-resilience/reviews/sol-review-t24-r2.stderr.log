50: /** The Supabase session id (JWT `session_id`) of a browser context's auth cookie. */
51: async function sessionIdOf(context: BrowserContext): Promise<string> {
52:   const cookies = (await context.cookies()).filter((cookie) => /^sb-.+-auth-token(\.\d+)?$/.test(cookie.name));
53:   expect(cookies.length, 'Supabase auth cookie').toBeGreaterThan(0);
54:   const chunkIndex = (name: string) => Number(/\.(\d+)$/.exec(name)?.[1] ?? 0);
55:   const raw = cookies
56:     .sort((left, right) => chunkIndex(left.name) - chunkIndex(right.name))
57:     .map((cookie) => cookie.value)
58:     .join('');
59:   const json = raw.startsWith('base64-') ? Buffer.from(raw.slice('base64-'.length), 'base64url').toString('utf8') 
: raw;
60:   const accessToken = (JSON.parse(json) as { access_token: string }).access_token;
61:   const payload = JSON.parse(Buffer.from(accessToken.split('.')[1], 'base64url').toString('utf8')) as {
62:     session_id?: string;
63:   };
64:   expect(payload.session_id, 'session_id claim').toBeTruthy();
65:   return payload.session_id as string;
66: }
67: 
68: async function memberIdsVia(page: Page, conversationId: string): Promise<{ status: number; ids: string[] }> {
69:   const response = await page.request.get(`/api/conversations/members?conversationId=${conversationId}`);
70:   if (response.status() !== 200) return { status: response.status(), ids: [] };
71:   const body = (await response.json()) as { members: Array<{ userId: string }> };
72:   return { status: 200, ids: body.members.map((member) => member.userId).sort() };
73: }
74: 
75: async function createVia(page: Page, data: Record<string, unknown>) {
76:   const response = await page.request.post('/api/messages/create', { data });
77:   return { status: response.status(), body: (await response.json().catch(() => null)) as Record<string, unknown> | 
null };
78: }
