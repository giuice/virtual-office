141: interface SeedResponseUser {
142:   id: string;
143:   email: string;
144:   supabaseUid: string;
145: }
146: 
147: interface SeedResponse {
148:   runId: string;
149:   company: { id: string };
150:   users: SeedResponseUser[];
151:   spaces: Array<{ id: string }>;
152:   conversations: { directId: string; roomIds: string[]; groupId?: string };
153:   messages: Array<{ id: string }>;
154: }
155: 
156: export async function seedPhase5World(request: APIRequestContext): Promise<Phase5World> {
157:   const response = await request.post('/api/test/messaging/seed', {
158:     headers: seedHeaders(),
159:     data: { includePhase5World: true, roomCount: 1, includePinnedRoom: false },
160:   });
161:   if (!response.ok()) {
162:     throw new Error(`Failed to seed the Phase 5 world: ${response.status()} ${await response.text()}`);
163:   }
164:   const { data } = (await response.json()) as { data: SeedResponse };
165:   const byEmail = new Map(data.users.map((user) => [user.email.trim().toLowerCase(), user]));
166:   const users = Object.fromEntries(
167:     PHASE5_USER_KEYS.map((key) => {
168:       const prefix = ACCOUNT_ENV_PREFIX[key];
169:       const email = requireEnv(`${prefix}_EMAIL`);
170:       const seeded = byEmail.get(email.trim().toLowerCase());
171:       if (!seeded) {
172:         throw new Error(`The Phase 5 seed did not return user ${key}`);
173:       }
174:       const user: Phase5User = {
175:         key,
176:         userId: seeded.id,
177:         supabaseUid: seeded.supabaseUid,
178:         email,
179:         password: requireEnv(`${prefix}_PASSWORD`),
180:         displayName: requireEnv(`${prefix}_DISPLAY_NAME`),
181:       };
182:       return [key, user];
183:     }),
184:   ) as Record<Phase5UserKey, Phase5User>;
185:   const [roomId] = data.conversations.roomIds;
186:   const [roomSpaceId] = data.spaces.map((space) => space.id);
187:   if (!roomId || !roomSpaceId || !data.conversations.groupId) {
188:     throw new Error('The Phase 5 seed did not return a room and a group conversation');
189:   }
190:   return {
191:     runId: data.runId,
192:     companyId: data.company.id,
193:     users,
194:     conversations: { directId: data.conversations.directId, groupId: data.conversations.groupId, roomId },
195:     roomSpaceId,
196:     seededMessageIds: data.messages.map((message) => message.id),
197:   };
198: }
199: 
200: function worldUserIds(world: Phase5World): string[] {
201:   return PHASE5_USER_KEYS.map((key) => world.users[key].userId);
202: }
203: 
204: function worldConversationIds(world: Phase5World): string[] {
205:   return [world.conversations.directId, world.conversations.groupId, world.conversations.roomId];
206: }
207: 
208: /**
209:  * Removes the world: its conversations through the seed route (cascading
210:  * members, messages, mentions, attempt rows, revocations), then the users'
211:  * remaining Phase 5 server state. Idempotent. Returns what is left afterwards
212:  * (all zero when clean) plus the world conversations that still exist.
213:  */
214: export async function cleanupPhase5World(
215:   request: APIRequestContext,
216:   world: Phase5World,
217: ): Promise<{ left: MessagingServerStateCounts; conversationsLeft: number }> {
218:   const response = await request.delete('/api/test/messaging/seed', {
219:     headers: seedHeaders(),
220:     data: {
221:       companyId: world.companyId,
222:       userIds: worldUserIds(world),
223:       conversationIds: worldConversationIds(world),
224:       messageIds: world.seededMessageIds,
225:       spaceIds: [world.roomSpaceId],
226:     },
227:   });
228:   if (!response.ok()) {
229:     throw new Error(`Failed to clean up the Phase 5 world: ${response.status()} ${await response.text()}`);
230:   }
231:   return withLocalMessagingDb(async (db) => {
232:     await cleanupMessagingServerState(db, worldUserIds(world));
233:     const left = await countMessagingServerState(db, worldUserIds(world));
234:     const { rows } = await db.query<{ count: number }>(
235:       'select count(*)::int as count from public.conversations where id = any($1::uuid[])',
236:       [worldConversationIds(world)],
237:     );
238:     return { left, conversationsLeft: rows[0].count };
239:   });
240: }
