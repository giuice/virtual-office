92: export function isLoopbackUrl(value: string): boolean {
93:   try {
94:     return LOOPBACK_HOSTS.has(new URL(value).hostname);
95:   } catch {
96:     return false;
97:   }
98: }
99: 
100: /** True for any URL whose host is a hosted Supabase domain. */
101: export function isHostedSupabaseUrl(value: string): boolean {
102:   try {
103:     const host = new URL(value).hostname;
104:     return host.endsWith('.supabase.co') || host.endsWith('.supabase.com');
105:   } catch {
106:     return /\.supabase\.(co|com)\b/i.test(value);
107:   }
108: }
109: 
110: /**
111:  * Fail closed: every Supabase URL must be loopback and no environment value may
112:  * reference a hosted Supabase domain.
113:  */
114: export function assertLocalSupabaseOnly(env: NodeJS.ProcessEnv): void {
115:   for (const key of ['NEXT_PUBLIC_SUPABASE_URL', 'SUPABASE_URL']) {
116:     const value = env[key];
117:     if (!value || !isLoopbackUrl(value)) {
118:       throw new Error(`Local messaging mode requires ${key} to be a loopback URL.`);
119:     }
120:   }
121:   const leaked = Object.entries(env)
122:     .filter(([, value]) => typeof value === 'string' && /\.supabase\.(co|com)\b/i.test(value))
123:     .map(([key]) => key);
124:   if (leaked.length > 0) {
125:     throw new Error(
126:       `Local messaging mode refuses to start: hosted Supabase values remain in ${leaked.join(', ')}.`,
127:     );
128:   }
129: }
