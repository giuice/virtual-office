  73:   const expectedDigest = createHash('sha256').update(expected).digest();
  74:   return timingSafeEqual(providedDigest, expectedDigest);
  75: }
  76: 
  77: function requireSecret(request: NextRequest): NextResponse | null {
  78:   if (!PLAYWRIGHT_SECRET) {
  79:     return NextResponse.json(
  80:       { error: 'PLAYWRIGHT_TEST_SECRET is not configured' },
  81:       { status: 500 },
  82:     );
  83:   }
  84: 
  85:   const providedSecret = request.headers.get('x-test-secret') ?? '';
  86: 
  87:   if (!secretsMatch(providedSecret, PLAYWRIGHT_SECRET)) {
  88:     return NextResponse.json({ error: 'Unauthorized' }, { status: 401 });
  89:   }
  90: 
  91:   return null;
  92: }
  93: 
  94: /**
  95:  * Lower-cased emails of the Playwright test accounts
  96:  * (PLAYWRIGHT_PRIMARY/SECONDARY/TERTIARY/FOURTH/FIFTH_EMAIL). The route only
  97:  * provisions, resets, or acts as these accounts.
  98:  */
  99: function seededAccountEmails(): Set<string> {
 100:   return new Set(
 101:     [
 102:       process.env.PLAYWRIGHT_PRIMARY_EMAIL,
 103:       process.env.PLAYWRIGHT_SECONDARY_EMAIL,
 104:       process.env.PLAYWRIGHT_TERTIARY_EMAIL,
 105:       process.env.PLAYWRIGHT_FOURTH_EMAIL,
 106:       process.env.PLAYWRIGHT_FIFTH_EMAIL,
 107:     ]
 108:       .filter((email): email is string => typeof email === 'string' && email.trim().length > 0)
 109:       .map((email) => email.trim().toLowerCase()),
 110:   );
 111: }
 112: 
 113: function requiredEnv(key: string, fallbackError?: string): string {
 114:   const value = process.env[key];
 115:   if (!value) {
 116:     throw new Error(fallbackError ?? `Missing required environment variable ${key}`);
 117:   }
 118:   return value;
 119: }
 120: 
 121: function resolveDefaultUsers(): [SeedUserDefinition, SeedUserDefinition] {
 122:   return [
 123:     {
 124:       email: requiredEnv('PLAYWRIGHT_PRIMARY_EMAIL'),
 125:       password: requiredEnv('PLAYWRIGHT_PRIMARY_PASSWORD'),
 126:       displayName: process.env.PLAYWRIGHT_PRIMARY_DISPLAY_NAME ?? 'Playwright Primary',
 127:       role: 'admin',
 128:       status: 'online',
 129:     },
 130:     {
 131:       email: requiredEnv('PLAYWRIGHT_SECONDARY_EMAIL'),
 132:       password: requiredEnv('PLAYWRIGHT_SECONDARY_PASSWORD'),
 133:       displayName: process.env.PLAYWRIGHT_SECONDARY_DISPLAY_NAME ?? 'Playwright Secondary',
 134:       role: 'member',
 135:       status: 'online',
 136:     },
 137:   ];
 138: }
 139: 
 140: /**
 141:  * Opt-in third group member. It never signs in (reads are recorded through
 142:  * PATCH below), so only its email is required; the password is per-run.
 143:  */
 144: function resolveThirdUser(): SeedUserDefinition {
 145:   return {
 146:     email: requiredEnv('PLAYWRIGHT_TERTIARY_EMAIL'),
 147:     password: process.env.PLAYWRIGHT_TERTIARY_PASSWORD || randomBytes(24).toString('hex'),
 148:     displayName: process.env.PLAYWRIGHT_TERTIARY_DISPLAY_NAME ?? 'Playwright Tertiary',
 149:     role: 'member',
 150:     status: 'offline',
 151:   };
 152: }
 153: 
 154: /**
 155:  * Phase 5 E2E world members C, D, E (A and B are the default users). All five
 156:  * sign in, so every password is required (local mode sets them).
 157:  */
 158: function resolvePhase5WorldMembers(): SeedUserDefinition[] {
 159:   const members: Array<[prefix: string, fallbackName: string]> = [
 160:     ['PLAYWRIGHT_TERTIARY', 'Playwright Tertiary'],
 161:     ['PLAYWRIGHT_FOURTH', 'Playwright Fourth'],
 162:     ['PLAYWRIGHT_FIFTH', 'Playwright Fifth'],
 163:   ];
 164:   return members.map(([prefix, fallbackName]): SeedUserDefinition => ({
 165:     email: requiredEnv(`${prefix}_EMAIL`),
 166:     password: requiredEnv(`${prefix}_PASSWORD`),
 167:     displayName: process.env[`${prefix}_DISPLAY_NAME`] ?? fallbackName,
 168:     role: 'member',
 169:     status: 'online',
 170:   }));
 171: }
 172: 
 173: function normalizeSeedUsers(users?: SeedUserDefinition[]): [SeedUserDefinition, SeedUserDefinition] {
 174:   if (!users || users.length === 0) {
 175:     return resolveDefaultUsers();
 176:   }
 177: 
 178:   if (users.length < 2) {
 179:     throw new Error('At least two users are required for messaging drawer scenarios');
 180:   }
 181: 
 182:   return [users[0], users[1]];
 183: }
