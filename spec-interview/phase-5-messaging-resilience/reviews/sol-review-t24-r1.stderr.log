 141: /** Deletes the users' budget counters (every action unless `actions` is given). Returns the rows removed. */
 142: export async function resetBudgets(
 143:   db: Client,
 144:   userIds: readonly string[],
 145:   actions?: readonly string[],
 146: ): Promise<number> {
 147:   if (userIds.length === 0) return 0;
 148:   const result = actions
 149:     ? await db.query(
 150:         'delete from private.rate_limit_counters where user_id = any($1::uuid[]) and action = any($2::text[])',
 151:         [userIds, actions],
 152:       )
 153:     : await db.query('delete from private.rate_limit_counters where user_id = any($1::uuid[])', [userIds]);
 154:   return result.rowCount ?? 0;
 155: }
 156: 
 157: /** The user's counter for `action` in the window containing the database clock (0 when none). */
 158: export async function readBudgetCount(db: Client, userId: string, action: string): Promise<number> {
 159:   const { rows } = await db.query<{ count: number }>(
 160:     `select count from private.rate_limit_counters
 161:       where user_id = $1::uuid and action = $2::text
 162:         and window_start <= clock_timestamp()
 163:         and window_start > clock_timestamp() - make_interval(secs => $3::int)`,
 164:     [userId, action, BUDGET_WINDOW_SECONDS],
 165:   );
 166:   return rows[0]?.count ?? 0;
 167: }
