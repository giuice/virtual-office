 104:   const nowMs = Number(clock[0].now_ms);
 105:   const remainingMs = windowMs - (nowMs % windowMs);
 106:   if (remainingMs < minRemainingMs) {
 107:     await new Promise((resolve) => setTimeout(resolve, remainingMs + 250));
 108:   }
 109: 
 110:   const { rows: charged } = await db.query<{ allowed: boolean }>(
 111:     'select public.check_rate_limit($1::uuid, $2::text, 1, $3::integer) as allowed',
 112:     [userId, action, BUDGET_WINDOW_SECONDS],
 113:   );
 114:   if (typeof charged[0]?.allowed !== 'boolean') {
 115:     throw new Error(`check_rate_limit returned no result for ${action}`);
 116:   }
 117:   const { rows: current } = await db.query<{ window_start: Date }>(
 118:     `select window_start from private.rate_limit_counters
 119:       where user_id = $1::uuid and action = $2::text and window_start <= clock_timestamp()
 120:       order by window_start desc limit 1`,
 121:     [userId, action],
 122:   );
 123:   if (current.length === 0) {
 124:     throw new Error(`check_rate_limit charged no ${action} counter for the user`);
 125:   }
 126:   const windowStart = current[0].window_start;
 127:   await db.query(
 128:     `insert into private.rate_limit_counters (user_id, action, window_start, count)
 129:      select $1::uuid, $2::text, $3::timestamptz + make_interval(secs => $4::int * step), $5::int
 130:        from generate_series(0, $6::int - 1) as step
 131:      on conflict (user_id, action, window_start) do update set count = excluded.count`,
 132:     [userId, action, windowStart, BUDGET_WINDOW_SECONDS, EXHAUSTED_COUNT, windows],
 133:   );
 134:   return {
 135:     action,
 136:     windowStart,
 137:     exhaustedUntil: new Date(windowStart.getTime() + windows * windowMs),
 138:   };
 139: }
