 382: /**
 383:  * PATCH: record a seeded member's reads of the given messages through the same
 384:  * RPC as PATCH /api/conversations/read — for members that never sign in (the
 385:  * opt-in third member). Body: { conversationId, userId, messageIds }.
 386:  * With { action: 'remove-member', conversationId, userId } it instead removes
 387:  * that member from the conversation (deletes the conversation_members row;
 388:  * star rows are kept), to test a member who lost access. Since Phase 5 T28
 389:  * that service-role delete is an administrative revocation.
 390:  * With { action: 'restore-member', conversationId, userId } (local Supabase
 391:  * only) it re-adds a removed participant through
 392:  * restore_conversation_membership, the only authorized rejoin.
 393:  * 403 unless userId is a PLAYWRIGHT_*_EMAIL account and every member of the
 394:  * conversation is one too.
 395:  */
 396: export async function PATCH(request: NextRequest) {
 397:   if (isBlockedEnvironment) {
 398:     return notFound();
 399:   }
 400: 
 401:   const secretError = requireSecret(request);
 402:   if (secretError) {
 403:     return secretError;
 404:   }
 405: 
 406:   let payload: unknown;
 407:   try {
 408:     payload = await request.json();
 409:   } catch (error) {
 410:     return NextResponse.json(
 411:       { error: 'Invalid JSON payload', details: (error as Error).message },
 412:       { status: 400 },
 413:     );
 414:   }
 415: 
 416:   const isRemoveMember =
 417:     !!payload && typeof payload === 'object' && (payload as { action?: unknown }).action === 'remove-member';
 418:   if (isRemoveMember) {
 419:     return removeSeededMember(payload);
 420:   }
 421:   const isRestoreMember =
 422:     !!payload && typeof payload === 'object' && (payload as { action?: unknown }).action === 'restore-member';
 423:   if (isRestoreMember) {
 424:     return restoreSeededMember(payload);
 425:   }
 426: 
 427:   const parsed = markReadSchema.safeParse(payload);
 428:   if (!parsed.success) {
 429:     return NextResponse.json(
 430:       { error: 'conversationId, userId (UUIDs), and messageIds (1-100 UUIDs) are required' },
 431:       { status: 400 },
 432:     );
 433:   }
 434:   const conversationId = parsed.data.conversationId.toLowerCase();
 435:   const userId = parsed.data.userId.toLowerCase();
 436:   const messageIds = parsed.data.messageIds.map((id) => id.toLowerCase());
 437: 
 438:   try {
 439:     const supabase = await createSupabaseServerClient('service_role');
 440:     const seeder = new MessagingTestSeeder(supabase);
 441:     // Only a Playwright account, in a conversation whose members are all
 442:     // Playwright accounts (the shape of every seeded conversation).
 443:     const isSeeded = await seeder.isSeededConversationMember(conversationId, userId, seededAccountEmails());
 444:     if (!isSeeded) {
 445:       return NextResponse.json(
 446:         { error: 'Only seeded Playwright accounts in seeded conversations can be marked read' },
 447:         { status: 403 },
 448:       );
 449:     }
 450:     const recorded = await seeder.markMessagesRead(conversationId, userId, messageIds);
 451:     return NextResponse.json({ success: true, recorded }, { status: 200 });
 452:   } catch (error) {
 453:     console.error('[Messaging Seed Route] Failed to mark messages read', error);
 454:     return NextResponse.json(
 455:       { error: 'Failed to mark messages read', details: (error as Error).message },
 456:       { status: 500 },
 457:     );
 458:   }
 459: }
