 960:   -- only now, after the INSERT, and hold it until commit.
 961:   if p_client_message_id is not null then
 962:     insert into private.message_send_attempts (sender_id, conversation_id, client_message_id)
 963:     values (p_sender_id, p_conversation_id, p_client_message_id)
