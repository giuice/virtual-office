 185: function buildCleanupInput(payload: unknown): MessagingSeedCleanupInput {
 186:   if (!payload || typeof payload !== 'object') {
 187:     throw new Error('Cleanup payload must be an object');
 188:   }
 189: 
 190:   const objectPayload = payload as Partial<MessagingSeedResult> & {
 191:     companyId?: string;
 192:     userIds?: string[];
 193:     conversationIds?: string[];
 194:     messageIds?: string[];
 195:     spaceIds?: string[];
 196:   };
 197: 
 198:   const companyId = objectPayload.company?.id ?? objectPayload.companyId;
 199: 
 200:   if (!companyId) {
 201:     throw new Error('Cleanup payload requires companyId');
 202:   }
 203: 
 204:   const userIds = new Set<string>([
 205:     ...(objectPayload.users?.map((user) => user.id) ?? []),
 206:     ...(objectPayload.userIds ?? []),
 207:   ]);
 208: 
 209:   const conversationIds = new Set<string>([
 210:     ...(objectPayload.conversations?.directId
 211:       ? [objectPayload.conversations.directId]
 212:       : []),
 213:     ...(objectPayload.conversations?.roomIds ?? []),
 214:     ...(objectPayload.conversations?.groupId ? [objectPayload.conversations.groupId] : []),
 215:     ...(objectPayload.conversationIds ?? []),
 216:   ]);
 217: 
 218:   const messageIds = new Set<string>([
 219:     ...(objectPayload.messages?.map((message) => message.id) ?? []),
 220:     ...(objectPayload.messageIds ?? []),
 221:   ]);
 222: 
 223:   const spaceIds = new Set<string>([
 224:     ...(objectPayload.spaces?.map((space) => space.id) ?? []),
 225:     ...(objectPayload.spaceIds ?? []),
 226:   ]);
 227: 
 228:   return {
 229:     companyId,
 230:     userIds: Array.from(userIds),
 231:     conversationIds: Array.from(conversationIds),
 232:     messageIds: Array.from(messageIds),
 233:     spaceIds: Array.from(spaceIds),
 234:   };
 235: }
