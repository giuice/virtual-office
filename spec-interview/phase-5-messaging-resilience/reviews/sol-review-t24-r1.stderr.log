 237: export async function POST(request: NextRequest) {
 238:   if (isBlockedEnvironment) {
 239:     return notFound();
 240:   }
 241: 
 242:   const secretError = requireSecret(request);
 243:   if (secretError) {
 244:     return secretError;
 245:   }
 246: 
 247:   let payload: Partial<
 248:     MessagingSeedOptions & {
 249:       users?: SeedUserDefinition[];
 250:       includeThirdMember?: boolean;
 251:       /** Phase 5 E2E world: users A–E, a DM (A–B), a group and room conversations of all five. */
 252:       includePhase5World?: boolean;
 253:     }
 254:   > = {};
 255: 
 256:   // Accept empty body (defaults) and only error on malformed non-empty JSON
 257:   try {
 258:     const raw = await request.text();
 259:     payload = raw && raw.trim().length > 0 ? JSON.parse(raw) : {};
 260:   } catch (error) {
 261:     return NextResponse.json(
 262:       { error: 'Invalid JSON payload', details: (error as Error).message },
 263:       { status: 400 },
 264:     );
 265:   }
 266: 
 267:   // The Phase 5 world is a local-Supabase-only fixture.
 268:   if (payload.includePhase5World === true && !isLocalSupabaseMode()) {
 269:     return notFound();
 270:   }
 271: 
 272:   let users: [SeedUserDefinition, SeedUserDefinition];
 273:   let thirdUser: SeedUserDefinition | undefined;
 274:   let worldMembers: SeedUserDefinition[] = [];
 275:   try {
 276:     if (payload.includePhase5World === true && (payload.includeThirdMember || payload.users)) {
 277:       throw new Error('includePhase5World cannot be combined with includeThirdMember or users');
 278:     }
 279:     users = normalizeSeedUsers(payload.users);
 280:     thirdUser = payload.includeThirdMember ? resolveThirdUser() : undefined;
 281:     worldMembers = payload.includePhase5World === true ? resolvePhase5WorldMembers() : [];
 282:   } catch (error) {
 283:     return NextResponse.json(
 284:       { error: (error as Error).message },
 285:       { status: 400 },
 286:     );
 287:   }
 288: 
 289:   // The seeder creates auth users or resets their passwords by email, so it
 290:   // may only touch the configured Playwright accounts.
 291:   const allowedEmails = seededAccountEmails();
 292:   const seedUsers = [...users, ...(thirdUser ? [thirdUser] : []), ...worldMembers];
 293:   if (seedUsers.some((user) => !allowedEmails.has(user.email.trim().toLowerCase()))) {
 294:     return NextResponse.json(
 295:       { error: 'Seed users must be the configured PLAYWRIGHT_*_EMAIL accounts' },
 296:       { status: 403 },
 297:     );
 298:   }
 299: 
 300:   try {
 301:     const supabase = await createSupabaseServerClient('service_role');
 302:     const seeder = new MessagingTestSeeder(supabase);
 303: 
 304:     const seedResult = await seeder.seed({
 305:       allowedEmails,
 306:       runId: payload.runId,
 307:       users,
 308:       roomCount: payload.roomCount,
 309:       includePinnedRoom: payload.includePinnedRoom,
 310:       includeGroupConversation: payload.includeGroupConversation,
 311:       historyMessageCount: payload.historyMessageCount,
 312:       thirdUser,
 313:       worldMembers,
 314:     });
 315: 
 316:     return NextResponse.json(
 317:       { success: true, data: seedResult },
 318:       { status: 200 },
 319:     );
 320:   } catch (error) {
 321:     console.error('[Messaging Seed Route] Failed to seed test data', error);
 322:     return NextResponse.json(
 323:       { error: 'Failed to seed messaging test data', details: (error as Error).message },
 324:       { status: 500 },
 325:     );
 326:   }
 327: }
