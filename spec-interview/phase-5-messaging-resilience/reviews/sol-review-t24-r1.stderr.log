 828:   end if;
 829: 
 830:   -- Defense in depth: the route already required membership.
 831:   if not exists (
 832:     select 1
 833:     from public.conversation_members cm
 834:     where cm.conversation_id = p_conversation_id
 835:       and cm.user_id = p_sender_id
 836:   ) then
