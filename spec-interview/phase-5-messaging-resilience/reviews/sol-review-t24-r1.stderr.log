 370:     await seeder.cleanup(cleanupInput);
 371: 
 372:     return NextResponse.json({ success: true }, { status: 200 });
 373:   } catch (error) {
 374:     console.error('[Messaging Seed Route] Failed to cleanup test data', error);
 375:     return NextResponse.json(
