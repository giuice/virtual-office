  50: /** The Supabase session id (JWT `session_id`) of a browser context's auth cookie. */
  51: async function sessionIdOf(context: BrowserContext): Promise<string> {
  52:   const cookies = (await context.cookies()).filter((cookie) => /^sb-.+-auth-token(\.\d+)?$/.test(cookie.name));
  53:   expect(cookies.length, 'Supabase auth cookie').toBeGreaterThan(0);
  54:   const chunkIndex = (name: string) => Number(/\.(\d+)$/.exec(name)?.[1] ?? 0);
  55:   const raw = cookies
  56:     .sort((left, right) => chunkIndex(left.name) - chunkIndex(right.name))
  57:     .map((cookie) => cookie.value)
  58:     .join('');
  59:   const json = raw.startsWith('base64-') ? Buffer.from(raw.slice('base64-'.length), 
'base64url').toString('utf8') : raw;
  60:   const accessToken = (JSON.parse(json) as { access_token: string }).access_token;
  61:   const payload = JSON.parse(Buffer.from(accessToken.split('.')[1], 'base64url').toString('utf8')) as {
  62:     session_id?: string;
  63:   };
  64:   expect(payload.session_id, 'session_id claim').toBeTruthy();
  65:   return payload.session_id as string;
  66: }
