   1: // Phase 5 T24: runs the local E2E web server and copies its raw output to a file
   2: // that tests can read (helpers/server-log.ts), while still passing it through to
   3: // Playwright's `[WebServer]` output.
   4: //
   5: // Usage: node scripts/playwright-server-log-tee.mjs <command> [args...]
   6: // Env:   VO_E2E_SERVER_LOG_FILE — absolute path of the raw log (truncated at start).
   7: //
   8: // Nothing is filtered, redacted, or reformatted: every stdout and stderr line is
   9: // written byte for byte as the server printed it. The only processing is
  10: // line-atomic interleaving — each stream is buffered up to its next newline so a
  11: // stdout line and a stderr line never splice into one another; a trailing
  12: // partial line is written when its stream ends. This is a local test aid only;
  13: // the log file lives in an ignored directory and is never uploaded.
  14: import { closeSync, mkdirSync, openSync, writeSync } from 'node:fs';
  15: import { spawn } from 'node:child_process';
  16: import { dirname, isAbsolute } from 'node:path';
  17: 
  18: const logPath = process.env.VO_E2E_SERVER_LOG_FILE;
  19: if (!logPath || !isAbsolute(logPath)) {
  20:   console.error('[server-log-tee] VO_E2E_SERVER_LOG_FILE must be an absolute path.');
  21:   process.exit(2);
  22: }
  23: const [command, ...args] = process.argv.slice(2);
  24: if (!command) {
  25:   console.error('[server-log-tee] Missing the server command.');
  26:   process.exit(2);
  27: }
  28: 
  29: mkdirSync(dirname(logPath), { recursive: true });
  30: const fd = openSync(logPath, 'w');
  31: 
  32: function tee(stream, destination) {
  33:   let pending = Buffer.alloc(0);
  34:   stream.on('data', (chunk) => {
  35:     destination.write(chunk);
  36:     pending = Buffer.concat([pending, chunk]);
  37:     const lastNewline = pending.lastIndexOf(0x0a);
  38:     if (lastNewline >= 0) {
  39:       writeSync(fd, pending.subarray(0, lastNewline + 1));
  40:       pending = pending.subarray(lastNewline + 1);
  41:     }
  42:   });
  43:   return new Promise((resolveEnd) => {
  44:     const flush = () => {
  45:       if (pending.length > 0) {
  46:         writeSync(fd, pending);
  47:         pending = Buffer.alloc(0);
  48:       }
  49:       resolveEnd();
  50:     };
  51:     stream.once('end', flush);
  52:     stream.once('close', flush);
  53:     stream.once('error', flush);
  54:   });
  55: }
  56: 
  57: // `command` is the Node binary path or a script given by the config, never user
  58: // input; no shell is involved.
  59: const child = spawn(command === 'node' ? process.execPath : command, args, {
  60:   stdio: ['ignore', 'pipe', 'pipe'],
  61:   env: process.env,
  62:   windowsHide: true,
  63: });
  64: 
  65: const drained = Promise.all([tee(child.stdout, process.stdout), tee(child.stderr, process.stderr)]);
  66: 
  67: for (const signal of ['SIGINT', 'SIGTERM']) {
  68:   process.on(signal, () => {
  69:     child.kill(signal);
  70:   });
  71: }
