   3: /**
   4:  * Phase 5 T24 — the messaging app's browser-side storage, and how tests clear it.
   5:  *
   6:  * Every Phase 5 device is a fresh, non-persistent Playwright browser context:
   7:  * its localStorage, sessionStorage, IndexedDB, Cache Storage and cookies start
   8:  * empty and are discarded when the context closes, so nothing a test (or an
   9:  * interrupted run) leaves in a browser reaches a later test. Within one test,
  10:  * clearMessagingBrowserState() empties the messaging state of one origin
  11:  * without closing the context (e.g. to simulate a cleared browser).
  12:  *
  13:  * Keep this list in sync with the app (T8+ add the outbox here):
  14:  *   localStorage
  15:  *   - `messaging_drawer_minimized`, `messaging_drawer_active_view`,
  16:  *     `messaging_active_conversation_id` (MessagingContext DRAWER_STORAGE_KEYS)
  17:  *   - every key starting with `vo:messaging:` — desktop-notification
  18:  *     preference `vo:messaging:desktop-notifications:<userId>`, cross-tab claims
  19:  *     `vo:messaging:notified-messages`; RESERVED prefix for new Phase 5
  20:  *     localStorage keys (drawer restore T20, outbox coordination T8/T10).
  21:  *   IndexedDB
  22:  *   - every database whose name starts with `vo-messaging` — RESERVED prefix
  23:  *     for the Phase 5 outbox (T8). The app must close its connection on
  24:  *     `versionchange`, or deletion stays blocked while a tab holds it open.
  25:  *   sessionStorage
  26:  *   - every key starting with `vo:messaging:` (reserved; none today).
  27:  */
  28: export const MESSAGING_LOCAL_STORAGE_KEYS = [
  29:   'messaging_drawer_minimized',
  30:   'messaging_drawer_active_view',
  31:   'messaging_active_conversation_id',
  32: ] as const;
  33: export const MESSAGING_STORAGE_KEY_PREFIX = 'vo:messaging:';
  34: export const MESSAGING_INDEXED_DB_PREFIX = 'vo-messaging';
  35: 
  36: export interface MessagingBrowserStateSnapshot {
  37:   localStorageKeys: string[];
  38:   sessionStorageKeys: string[];
  39:   indexedDbNames: string[];
  40: }
  41: 
  42: interface StorageSpec {
  43:   keys: readonly string[];
  44:   keyPrefix: string;
  45:   dbPrefix: string;
  46: }
  47: 
  48: const SPEC: StorageSpec = {
  49:   keys: MESSAGING_LOCAL_STORAGE_KEYS,
  50:   keyPrefix: MESSAGING_STORAGE_KEY_PREFIX,
  51:   dbPrefix: MESSAGING_INDEXED_DB_PREFIX,
  52: };
  53: 
  54: /** The messaging keys and databases currently present on the page's origin. */
  55: export async function readMessagingBrowserState(page: Page): Promise<MessagingBrowserStateSnapshot> {
  56:   return page.evaluate(async (spec: StorageSpec) => {
  57:     const isMessagingKey = (key: string) => spec.keys.includes(key) || key.startsWith(spec.keyPrefix);
  58:     const keysOf = (storage: Storage) =>
  59:       Array.from({ length: storage.length }, (_, index) => storage.key(index)).filter(
  60:         (key): key is string => key !== null && isMessagingKey(key),
  61:       );
  62:     const databases = typeof indexedDB.databases === 'function' ? await indexedDB.databases() : [];
  63:     return {
  64:       localStorageKeys: keysOf(window.localStorage).sort(),
  65:       sessionStorageKeys: keysOf(window.sessionStorage)
  66:         .filter((key) => key.startsWith(spec.keyPrefix))
  67:         .sort(),
  68:       indexedDbNames: databases
  69:         .map((database) => database.name ?? '')
  70:         .filter((name) => name.startsWith(spec.dbPrefix))
  71:         .sort(),
  72:     };
  73:   }, SPEC);
  74: }
  75: 
  76: /**
  77:  * Removes the messaging localStorage/sessionStorage keys and deletes every
  78:  * messaging IndexedDB database of the page's origin (all tabs of the context
  79:  * share them). Fails when a deletion stays blocked by an open connection for
  80:  * `blockedTimeoutMs`, and verifies that nothing is left. Returns what it removed.
  81:  */
  82: export async function clearMessagingBrowserState(
  83:   page: Page,
  84:   options: { blockedTimeoutMs?: number } = {},
  85: ): Promise<MessagingBrowserStateSnapshot> {
  86:   const before = await readMessagingBrowserState(page);
  87:   const blockedTimeoutMs = options.blockedTimeoutMs ?? 5_000;
  88:   const failures = await page.evaluate(
  89:     async ({ removed, timeoutMs }) => {
  90:       for (const key of removed.localStorageKeys) window.localStorage.removeItem(key);
  91:       for (const key of removed.sessionStorageKeys) window.sessionStorage.removeItem(key);
  92:       const deleteDatabase = (name: string) =>
  93:         new Promise<string | null>((resolve) => {
  94:           const request = indexedDB.deleteDatabase(name);
  95:           const timer = window.setTimeout(() => resolve(`${name}: still blocked after ${timeoutMs} ms`), 
timeoutMs);
  96:           request.onsuccess = () => {
  97:             window.clearTimeout(timer);
  98:             resolve(null);
  99:           };
 100:           request.onerror = () => {
 101:             window.clearTimeout(timer);
 102:             resolve(`${name}: ${request.error?.message ?? 'delete failed'}`);
 103:           };
 104:         });
 105:       const results = await Promise.all(removed.indexedDbNames.map(deleteDatabase));
 106:       return results.filter((result): result is string => result !== null);
 107:     },
 108:     { removed: before, timeoutMs: blockedTimeoutMs },
 109:   );
 110:   if (failures.length > 0) {
 111:     throw new Error(`Messaging IndexedDB cleanup failed: ${failures.join('; ')}`);
 112:   }
 113:   const after = await readMessagingBrowserState(page);
 114:   const left = [...after.localStorageKeys, ...after.sessionStorageKeys, ...after.indexedDbNames];
 115:   if (left.length > 0) {
 116:     throw new Error(`Messaging browser state left after cleanup: ${left.join(', ')}`);
 117:   }
 118:   return before;
 119: }

