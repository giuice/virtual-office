  70:   if (response.status() !== 200) return { status: response.status(), ids: [] };
  71:   const body = (await response.json()) as { members: Array<{ userId: string }> };
  72:   return { status: 200, ids: body.members.map((member) => member.userId).sort() };
  73: }
