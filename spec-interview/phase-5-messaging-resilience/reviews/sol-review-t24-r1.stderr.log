 176:   async seed(options: MessagingSeedOptions): Promise<MessagingSeedResult> {
 177:     const created: SeedRows = { conversationIds: [], spaceIds: [], messageIds: [] };
 178:     try {
 179:       return await this.seedTracked(options, created);
 180:     } catch (error) {
 181:       await this.removePartialSeed(created);
 182:       throw error;
 183:     }
 184:   }
 185: 
 186:   private async seedTracked(
 187:     options: MessagingSeedOptions,
 188:     created: SeedRows,
 189:   ): Promise<MessagingSeedResult> {
 190:     const runId = options.runId ?? randomUUID();
 191:     const roomCount = Math.max(1, options.roomCount ?? 2);
 192:     const includePinnedRoom = options.includePinnedRoom ?? true;
 193:     const { allowedEmails } = options;
 194: 
 195:     const authUsers = await Promise.all(
 196:       options.users.map(async (user) => this.ensureAuthUser(user, allowedEmails))
 197:     );
 198: 
 199:     const profiles = await Promise.all(
 200:       options.users.map((user, index) =>
 201:         this.ensureProfileForAuthUser(user, authUsers[index])
 202:       )
 203:     );
 204: 
 205:     const primaryProfile = profiles[0];
 206:     const company = await this.ensureSharedCompany(profiles[0], profiles[1], options.users[1]);
 207: 
 208:     const thirdProfile = options.thirdUser
 209:       ? await this.ensureProfileForAuthUser(options.thirdUser, await this.ensureAuthUser(options.thirdUser, 
allowedEmails))
 210:       : null;
 211:     if (thirdProfile && options.thirdUser) {
 212:       await this.ensureCompanyMember(company.id, profiles[0].id, thirdProfile, options.thirdUser);
 213:     }
 214: 
 215:     const worldDefinitions = options.worldMembers ?? [];
 216:     if (worldDefinitions.length > 0 && options.thirdUser) {
 217:       throw new Error('worldMembers and thirdUser cannot be combined');
 218:     }
 219:     const worldProfiles = [];
 220:     for (const definition of worldDefinitions) {
 221:       const profile = await this.ensureProfileForAuthUser(
 222:         definition,
 223:         await this.ensureAuthUser(definition, allowedEmails),
 224:       );
 225:       await this.ensureCompanyMember(company.id, profiles[0].id, profile, definition);
 226:       worldProfiles.push(profile);
 227:     }
 228:     const worldIds = worldProfiles.map((profile) => profile.id);
 229: 
 230:     const spaces = await this.ensureReusableSpaces(company.id, primaryProfile.id, roomCount, created);
 231: 
 232:     const participants = profiles.map((profile) => profile.id);
 233:     const directPromise = this.createDirectConversation(participants, runId, created);
 234:     const roomsPromise = this.createRoomConversations({
 235:       participants: [...participants, ...worldIds],
 236:       runId,
 237:       spaces,
 238:       includePinnedRoom,
 239:       allowedEmails,
 240:       created,
 241:     });
 242:     // Wait for both before failing so every created conversation is tracked.
 243:     await Promise.allSettled([directPromise, roomsPromise]);
 244:     const directConversation = await directPromise;
 245:     const roomConversations = await roomsPromise;
 246: 
 247:     await Promise.all([
 248:       this.conversationRepository.setUserPreference(directConversation.id, profiles[0].id, {
 249:         isPinned: true,
 250:         pinnedOrder: 0,
 251:       }),
 252:       this.conversationRepository.setUserPreference(directConversation.id, profiles[1].id, {
 253:         isPinned: false,
 254:       }),
 255:     ]);
 256: 
 257:     if (includePinnedRoom && roomConversations.length > 0) {
 258:       await this.conversationRepository.setUserPreference(
 259:         roomConversations[0].id,
 260:         profiles[0].id,
 261:         {
 262:           isPinned: true,
 263:           pinnedOrder: 1,
 264:         },
 265:       );
 266:     }
 267: 
 268:     const messages = await this.seedInitialMessages({
 269:       conversationId: directConversation.id,
 270:       participants,
 271:       runId,
 272:       created,
 273:     });
 274: 
 275:     const historyMessageCount = Math.min(
 276:       Math.max(0, Math.floor(options.historyMessageCount ?? 0)),
 277:       MAX_HISTORY_MESSAGE_COUNT,
 278:     );
 279:     const groupConversation =
 280:       options.includeGroupConversation || historyMessageCount > 0 || thirdProfile || worldIds.length > 0
 281:         ? await this.createGroupConversation(
 282:             [...participants, ...(thirdProfile ? [thirdProfile.id] : []), ...worldIds],
 283:             runId,
 284:             created,
 285:           )
 286:         : null;
 287: 
 288:     if (groupConversation && historyMessageCount > 0) {
 289:       messages.push(
 290:         ...(await this.seedHistoryMessages({
 291:           conversationId: groupConversation.id,
 292:           participants,
 293:           runId,
 294:           count: historyMessageCount,
 295:           created,
 296:         })),
 297:       );
 298:     }
 299: 
 300:     return {
 301:       runId,
 302:       company: {
 303:         id: company.id,
 304:         name: company.name,
 305:       },
 306:       users: [
 307:         ...profiles.map((profile, index) => ({
 308:           id: profile.id,
 309:           email: options.users[index].email,
 310:           supabaseUid: profile.supabase_uid,
 311:           role: options.users[index].role,
 312:         })),
 313:         ...(thirdProfile && options.thirdUser
 314:           ? [{
 315:               id: thirdProfile.id,
 316:               email: options.thirdUser.email,
 317:               supabaseUid: thirdProfile.supabase_uid,
 318:               role: options.thirdUser.role,
 319:             }]
 320:           : []),
 321:         ...worldProfiles.map((profile, index) => ({
 322:           id: profile.id,
 323:           email: worldDefinitions[index].email,
 324:           supabaseUid: profile.supabase_uid,
 325:           role: worldDefinitions[index].role,
 326:         })),
 327:       ],
 328:       spaces: spaces.map((space) => ({
 329:         id: space.id,
 330:         name: space.name,
 331:         type: space.type,
 332:       })),
 333:       conversations: {
 334:         directId: directConversation.id,
 335:         roomIds: roomConversations.map((room) => room.id),
 336:         ...(groupConversation ? { groupId: groupConversation.id } : {}),
 337:         ...(groupConversation && historyMessageCount > 0
 338:           ? { historyId: groupConversation.id }
 339:           : {}),
 340:       },
 341:       messages: messages.map((message) => ({
 342:         id: message.id,
 343:         conversationId: message.conversationId,
 344:       })),
 345:     };
 346:   }
 347: 
 348:   async cleanup(input: MessagingSeedCleanupInput): Promise<void> {
 349:     // companyId, userIds, and spaceIds stay in the input contract but are not
 350:     // removed: membership and placement are kept (see below) and seeded rooms
 351:     // are reusable fixtures (REUSABLE_SPACE_NAME_PREFIX).
 352:     const { conversationIds, messageIds } = input;
 353: 
 354:     if (messageIds.length > 0) {
 355:       await Promise.all(
 356:         messageIds.map(async (messageId) => {
 357:           try {
 358:             await this.messageRepository.deleteById(messageId);
 359:           } catch (error) {
 360:             console.warn('[MessagingTestSeeder] Failed to delete message', { messageId, error });
 361:           }
 362:         })
 363:       );
 364:     }
 365: 
 366:     if (conversationIds.length > 0) {
 367:       try {
 368:         await this.supabase
 369:           .from('conversation_members')
 370:           .delete()
 371:           .in('conversation_id', conversationIds);
 372:       } catch (error) {
 373:         console.warn('[MessagingTestSeeder] Failed to delete conversation preferences', { error });
 374:       }
 375: 
 376:       await Promise.all(
 377:         conversationIds.map(async (conversationId) => {
 378:           try {
 379:             await this.conversationRepository.deleteById(conversationId);
 380:           } catch (error) {
 381:             console.warn('[MessagingTestSeeder] Failed to delete conversation', { conversationId, error });
 382:           }
 383:         })
 384:       );
 385:     }
 386: 
 387:     // The shared company and both users' membership are intentionally kept:
 388:     // membership changes go through the company RPCs (the database rejects
 389:     // direct service-role company_id/role updates), and placement changes go
 390:     // through the presence transition contract, so per-run detach is not done.
 391:   }
 392: 
 393:   /**
 394:    * Removes the rows a failed seed created (a reusable room only when this
 395:    * seed created it). Conversation deletes cascade to
 396:    * their members, messages, receipts, stars, and pins. Failures are logged,
 397:    * not thrown, so the seed's own error is what the caller sees.
 398:    */
 399:   private async removePartialSeed(created: SeedRows): Promise<void> {
 400:     const steps: Array<[table: 'messages' | 'conversations' | 'spaces', ids: string[]]> = [
 401:       ['messages', created.messageIds],
 402:       ['conversations', created.conversationIds],
 403:       ['spaces', created.spaceIds],
 404:     ];
 405:     for (const [table, ids] of steps) {
 406:       for (const idChunk of chunk(ids, ID_FILTER_CHUNK)) {
 407:         const { error } = await this.supabase.from(table).delete().in('id', idChunk);
 408:         if (error) {
 409:           console.error(`[MessagingTestSeeder] Failed to remove partially seeded ${table}`, {
 410:             count: idChunk.length,
 411:             error,
 412:           });
 413:         }
 414:       }
 415:     }
 416:   }
 417: 
 418:   /**
 419:    * LOCAL SUPABASE ONLY — the caller must have confirmed local mode. Deletes
 420:    * the conversations that earlier interrupted or partially failed runs left
 421:    * behind: only conversations with a seeded name (test_dm_, Test Room
 422:    * Conversation N, Test Group) whose participants and members are all
 423:    * `allowedEmails` accounts. Deleting a conversation cascades to its members,
 424:    * messages (with their receipts, reactions, stars, pins), receipts, stars,
 425:    * and pins. Users, the shared company, and spaces are kept (presence history
 426:    * references seeded spaces). Returns the deleted conversation ids.
 427:    */
 428:   async sweepSeededLeftovers(allowedEmails: ReadonlySet<string>): Promise<string[]> {
 429:     if (allowedEmails.size === 0) {
 430:       return [];
 431:     }
 432: 
 433:     const accountIds = await this.findTestAccountIds(allowedEmails);
 434:     if (accountIds.size === 0) {
 435:       return [];
 436:     }
 437: 
 438:     const { data: candidates, error: candidatesError } = await this.supabase
 439:       .from('conversations')
 440:       .select('id, name, participants')
 441:       .containedBy('participants', [...accountIds])
 442:       .overrideTypes<
 443:         Array<{ id: string; name: string | null; participants: string[] | null }>,
 444:         { merge: false }
 445:       >();
 446:     if (candidatesError) {
 447:       throw new Error(`Failed to read leftover conversations: ${candidatesError.message}`);
 448:     }
 449:     const seededIds = (candidates ?? [])
 450:       .filter((conversation) => {
 451:         const participants = conversation.participants ?? [];
 452:         return (
 453:           SEEDED_CONVERSATION_NAME.test(conversation.name ?? '') &&
 454:           participants.length > 0 &&
 455:           participants.every((id) => accountIds.has(id))
 456:         );
 457:       })
 458:       .map((conversation) => conversation.id);
 459: 
 460:     // A conversation with any member outside the test accounts is never touched.
 461:     const foreignMemberConversations = await this.findConversationsWithForeignMembers(seededIds, accountIds);
 462:     const leftoverIds = seededIds.filter((id) => !foreignMemberConversations.has(id));
 463: 
 464:     const deleted: string[] = [];
 465:     for (const idChunk of chunk(leftoverIds, ID_FILTER_CHUNK)) {
 466:       const { data, error } = await this.supabase
 467:         .from('conversations')
 468:         .delete()
 469:         .in('id', idChunk)
 470:         .select('id')
 471:         .overrideTypes<Array<{ id: string }>, { merge: false }>();
 472:       if (error) {
 473:         throw new Error(`Failed to delete leftover conversations: ${error.message}`);
 474:       }
 475:       deleted.push(...(data ?? []).map((row) => row.id));
 476:     }
 477:     return deleted;
 478:   }
 479: 
 480:   /** App user ids of the `allowedEmails` accounts. */
 481:   private async findTestAccountIds(allowedEmails: ReadonlySet<string>): Promise<Set<string>> {
 482:     if (allowedEmails.size === 0) {
 483:       return new Set();
 484:     }
 485:     const { data: accounts, error: accountsError } = await this.supabase
 486:       .from('users')
 487:       .select('id, email')
 488:       .in('email', [...allowedEmails])
 489:       .overrideTypes<Array<{ id: string; email: string | null }>, { merge: false }>();
 490:     if (accountsError) {
 491:       throw new Error(`Failed to read test accounts: ${accountsError.message}`);
 492:     }
 493:     return new Set(
 494:       (accounts ?? [])
 495:         .filter((account) => allowedEmails.has(account.email?.trim().toLowerCase() ?? ''))
 496:         .map((account) => account.id),
 497:     );
 498:   }
 499: 
 500:   /** Of `conversationIds`, those with a conversation_members row outside `accountIds`. */
 501:   private async findConversationsWithForeignMembers(
 502:     conversationIds: readonly string[],
 503:     accountIds: ReadonlySet<string>,
 504:   ): Promise<Set<string>> {
 505:     const foreign = new Set<string>();
 506:     for (const idChunk of chunk(conversationIds, ID_FILTER_CHUNK)) {
 507:       const { data: members, error: membersError } = await this.supabase
 508:         .from('conversation_members')
 509:         .select('conversation_id, user_id')
 510:         .in('conversation_id', idChunk)
 511:         .overrideTypes<Array<{ conversation_id: string; user_id: string }>, { merge: false }>();
 512:       if (membersError) {
 513:         throw new Error(`Failed to read conversation members: ${membersError.message}`);
 514:       }
 515:       for (const member of members ?? []) {
 516:         if (!accountIds.has(member.user_id)) {
 517:           foreign.add(member.conversation_id);
 518:         }
 519:       }
 520:     }
 521:     return foreign;
 522:   }
 523: 
 524:   /**
 525:    * Put both test users in one company through the product membership RPCs:
 526:    * the primary creates (or keeps) a company as admin, and the secondary
 527:    * joins it by accepting an invitation as a member. Reused across runs.
 528:    */
 529:   private async ensureSharedCompany(
 530:     primary: { id: string; companyId?: string | null; role?: UserRole },
 531:     secondary: { id: string; companyId?: string | null; email: string },
 532:     secondaryDefinition: SeedUserDefinition,
 533:   ): Promise<{ id: string; name: string }> {
 534:     let companyId = primary.companyId ?? null;
 535: 
 536:     if (!companyId) {
 537:       const { data, error } = await this.supabase.rpc('create_company_for_user', {
 538:         p_user_id: primary.id,
 539:         p_name: SHARED_COMPANY_NAME,
 540:         p_settings: {},
 541:       });
 542:       if (error) {
 543:         throw new Error(`Failed to create shared test company: ${error.message}`);
 544:       }
 545:       companyId = (data as { companyId: string }).companyId;
 546:     } else if (primary.role !== 'admin') {
 547:       throw new Error('Primary messaging test user must be an admin of its company');
 548:     }
 549: 
 550:     await this.ensureCompanyMember(companyId, primary.id, secondary, secondaryDefinition);
 551: 
 552:     const company = await this.companyRepository.findById(companyId);
 553:     if (!company) {
 554:       throw new Error(`Shared test company ${companyId} not found`);
 555:     }
 556:     return { id: company.id, name: company.name };
 557:   }
 558: 
 559:   /**
 560:    * Join `member` to the company as a member by accepting an invitation from
 561:    * the admin (product membership RPCs). No-op when already a member.
 562:    */
 563:   private async ensureCompanyMember(
 564:     companyId: string,
 565:     adminId: string,
 566:     member: { id: string; companyId?: string | null; email: string },
 567:     definition: SeedUserDefinition,
 568:   ): Promise<void> {
 569:     if (member.companyId && member.companyId !== companyId) {
 570:       throw new Error(
 571:         `Messaging test user ${member.email} belongs to a different company; remove it from that company first`,
 572:       );
 573:     }
 574:     if (member.companyId) {
 575:       return;
 576:     }
 577: 
 578:     const { data: invitation, error: inviteError } = await this.supabase.rpc(
 579:       'create_company_invitation',
 580:       {
 581:         p_actor_user_id: adminId,
 582:         p_company_id: companyId,
 583:         p_email: member.email,
 584:         p_role: 'member',
 585:         p_token: randomBytes(32).toString('hex'),
 586:         p_expires_at: new Date(Date.now() + INVITATION_TTL_MS).toISOString(),
 587:       },
 588:     );
 589:     if (inviteError) {
 590:       throw new Error(`Failed to invite test user ${member.email}: ${inviteError.message}`);
 591:     }
 592: 
 593:     const { error: acceptError } = await this.supabase.rpc(
 594:       'accept_company_invitation_membership',
 595:       {
 596:         p_user_id: member.id,
 597:         p_invitation_id: (invitation as { invitationId: string }).invitationId,
 598:         p_company_id: companyId,
 599:         p_display_name: definition.displayName,
 600:       },
 601:     );
 602:     if (acceptError) {
 603:       throw new Error(`Failed to add test user ${member.email} to company: ${acceptError.message}`);
 604:     }
 605:   }
 620:     }
 621:     return typeof data === 'number' ? data : 0;
 622:   }
 623: 
 624:   /**
 625:    * Removes `userId` from `conversationId` (its conversation_members row) and
 626:    * returns how many rows were deleted. Star and receipt rows are kept, as for
 627:    * a member who lost access. Callers must check isSeededConversationMember.
 628:    */
 629:   async removeConversationMember(conversationId: string, userId: string): Promise<number> {
 630:     const { data, error } = await this.supabase
 631:       .from('conversation_members')
 632:       .delete()
 633:       .eq('conversation_id', conversationId)
 634:       .eq('user_id', userId)
 635:       .select('user_id');
 636:     if (error) {
 637:       throw new Error(`Failed to remove conversation member: ${error.message}`);
 638:     }
 639:     return data?.length ?? 0;
 640:   }
 641: 
 642:   /**
 643:    * Re-adds `userId` to `conversationId` through
 644:    * `public.restore_conversation_membership` (service role), the only
 645:    * authorized rejoin (Phase 5 T28): it lifts the revocation and re-creates the
 646:    * conversation_members row only when the conversation's own rules still
 647:    * allow it (room access under lock; original participants of direct/group
 648:    * conversations), and is a no-op for a current member. Callers must check
 649:    * isSeededConversationParticipant.
 650:    */
 651:   async restoreConversationMembership(conversationId: string, userId: string): Promise<void> {
 652:     await this.restoreMemberships(conversationId, [userId]);
 653:   }
 654: 
 655:   /**
 656:    * True only when `userId` is in `conversationId`'s participants, every
 657:    * participant and every current member has one of `allowedEmails` (the
 658:    * shape of every seeded conversation), whether or not `userId` is still a
 659:    * member. Unknown ids are false.
 660:    */
 661:   async isSeededConversationParticipant(
 662:     conversationId: string,
 663:     userId: string,
 664:     allowedEmails: ReadonlySet<string>,
 665:   ): Promise<boolean> {
 666:     if (allowedEmails.size === 0) {
 667:       return false;
 668:     }
 669:     const { data: conversation, error } = await this.supabase
 670:       .from('conversations')
 671:       .select('participants')
 672:       .eq('id', conversationId)
 673:       .maybeSingle()
 674:       .overrideTypes<{ participants: string[] | null }, { merge: false }>();
 675:     if (error) {
 676:       throw new Error(`Failed to read conversation participants: ${error.message}`);
 677:     }
 678:     const participants = conversation?.participants ?? [];
 679:     if (!participants.includes(userId)) {
 680:       return false;
 681:     }
 682:     const accountIds = await this.findTestAccountIds(allowedEmails);
 683:     if (!participants.every((id) => accountIds.has(id))) {
 684:       return false;
 685:     }
 686:     const foreign = await this.findConversationsWithForeignMembers([conversationId], accountIds);
 687:     return !foreign.has(conversationId);
 688:   }
 689: 
 690:   /**
 691:    * True only when `userId` is a member of `conversationId` and every member
 692:    * of that conversation (including `userId`) has one of `allowedEmails` — the
 693:    * shape of every conversation this seeder creates. Unknown ids are false.
 694:    */
 695:   async isSeededConversationMember(
 696:     conversationId: string,
 697:     userId: string,
 698:     allowedEmails: ReadonlySet<string>,
 699:   ): Promise<boolean> {
 700:     if (allowedEmails.size === 0) {
 701:       return false;
 702:     }
 703: 
 704:     const { data: members, error: membersError } = await this.supabase
 705:       .from('conversation_members')
 706:       .select('user_id')
 707:       .eq('conversation_id', conversationId)
 708:       .overrideTypes<Array<{ user_id: string }>, { merge: false }>();
 709:     if (membersError) {
 710:       throw new Error(`Failed to read conversation members: ${membersError.message}`);
 711:     }
 712:     const memberIds = [...new Set((members ?? []).map((member) => member.user_id))];
 713:     if (!memberIds.includes(userId)) {
 714:       return false;
 715:     }
 716: 
 717:     const { data: accounts, error: accountsError } = await this.supabase
 718:       .from('users')
 719:       .select('id, email')
 720:       .in('id', memberIds)
 721:       .overrideTypes<Array<{ id: string; email: string | null }>, { merge: false }>();
 722:     if (accountsError) {
 723:       throw new Error(`Failed to read conversation member accounts: ${accountsError.message}`);
 724:     }
 725:     const emailById = new Map(
 726:       (accounts ?? []).map((account) => [account.id, account.email?.trim().toLowerCase() ?? '']),
 727:     );
 728:     return memberIds.every((id) => allowedEmails.has(emailById.get(id) ?? ''));
 729:   }
 730: 
 731:   private async ensureAuthUser(
 732:     user: SeedUserDefinition,
 733:     allowedEmails: ReadonlySet<string>,
 734:   ): Promise<SupabaseAuthUser> {
 735:     // Never create, or reset the password of, an account outside the
 736:     // configured Playwright test accounts.
 737:     if (!allowedEmails.has(user.email.trim().toLowerCase())) {
 738:       throw new Error(`Refusing to provision ${user.email}: not a configured Playwright test account`);
 739:     }
 740:     // List users and find by email since getUserByEmail doesn't exist
 741:     const { data: users } = await this.supabase.auth.admin.listUsers({ perPage: 1000 });
 742:     const existing = users?.users.find(u => u.email === user.email);
 743:     if (existing) {
 744:       const existingUser = existing;
 745:       // Ensure password is updated for repeatable tests
 746:       await this.supabase.auth.admin.updateUserById(existingUser.id, {
 747:         password: user.password,
 748:         email_confirm: true,
 749:       });
 750:       return existingUser;
 751:     }
 752: 
 753:     const created = await this.supabase.auth.admin.createUser({
 754:       email: user.email,
 755:       password: user.password,
 756:       email_confirm: true,
 757:     });
 758: 
 759:     if (created.error || !created.data?.user) {
 760:       throw new Error(`Failed to provision auth user ${user.email}: ${created.error?.message ?? 'Unknown 
error'}`);
 761:     }
 762: 
 763:     return created.data.user;
 764:   }
 765: 
 766:   private async ensureProfileForAuthUser(user: SeedUserDefinition, authUser: SupabaseAuthUser) {
 767:     const existingProfile = await this.userRepository.findBySupabaseUid(authUser.id);
 768: 
 769:     if (existingProfile) {
 770:       return existingProfile;
 771:     }
 772: 
 773:     const createdProfile = await this.userRepository.create({
 774:       companyId: null,
 775:       supabase_uid: authUser.id,
 776:       email: user.email,
 777:       displayName: user.displayName,
 778:       avatarUrl: undefined,
 779:       status: user.status ?? 'online',
 780:       statusMessage: undefined,
 781:       preferences: {},
 782:       role: user.role,
 783:       currentSpaceId: null,
 784:     });
 785: 
 786:     return createdProfile;
 787:   }
 788: 
 789:   /**
 790:    * Finds or creates the company's reusable rooms `Test Space Fixed 1..roomCount`.
 791:    * A room is created (and tracked for partial-seed rollback) only when the
 792:    * company has none with that name; an existing one is returned unchanged.
 793:    */
