 813:   v_count := coalesce(pg_catalog.cardinality(p_upload_ids), 0);
 814:   -- Same bound as the route's attachment policy (5 per message).
 815:   if v_count > 5 then
 816:     raise exception 'ATTACHMENT_COUNT_INVALID' using errcode = '22023';
 817:   end if;
 818:   if v_count > 0 then
 819:     if (select pg_catalog.count(distinct u) from pg_catalog.unnest(p_upload_ids) as u) <> v_count then
 820:       raise exception 'ATTACHMENT_DUPLICATE' using errcode = '22023';
 821:     end if;
 822:     -- Attachment messages are typed image or file (the only types allowed to
 823:     -- carry empty content).
