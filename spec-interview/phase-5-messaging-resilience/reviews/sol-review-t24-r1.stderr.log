 942:   /**
 943:    * A reusable room holds at most one room conversation (uniq_room_conversation):
 944:    * the previous run's, or the one the app opened for a test account sitting
 945:    * in the room. Each seed gives the room a fresh `Test Room Conversation N
 946:    * <run>`, so the existing one is deleted first, only when its participants
 947:    * and members are all `allowedEmails` accounts (the delete cascades to its
 948:    * members, messages, receipts, reactions, stars, and pins). A room
 949:    * conversation involving anyone else fails the seed and is left untouched.
 950:    */
 951:   private async removeTestOnlyRoomConversations(
 952:     spaceIds: readonly string[],
 953:     allowedEmails: ReadonlySet<string>,
 954:   ): Promise<void> {
 955:     const { data: rooms, error } = await this.supabase
 956:       .from('conversations')
 957:       .select('id, participants')
 958:       .eq('type', ConversationType.ROOM)
 959:       .in('room_id', [...spaceIds])
 960:       .overrideTypes<Array<{ id: string; participants: string[] | null }>, { merge: false }>();
 961:     if (error) {
 962:       throw new Error(`Failed to read room conversations of reusable test spaces: ${error.message}`);
 963:     }
 964:     if (!rooms || rooms.length === 0) {
 965:       return;
 966:     }
 967: 
 968:     const accountIds = await this.findTestAccountIds(allowedEmails);
 969:     const foreignMembers = await this.findConversationsWithForeignMembers(
 970:       rooms.map((room) => room.id),
 971:       accountIds,
 972:     );
 973:     const foreign = rooms.filter(
 974:       (room) =>
 975:         foreignMembers.has(room.id) ||
 976:         (room.participants ?? []).length === 0 ||
 977:         !(room.participants ?? []).every((participant) => accountIds.has(participant)),
 978:     );
 979:     if (foreign.length > 0) {
 980:       throw new Error(
 981:         `Reusable test space room conversation ${foreign[0].id} involves a non-test account; remove it manually`,
 982:       );
 983:     }
 984: 
 985:     const { error: deleteError } = await this.supabase
 986:       .from('conversations')
 987:       .delete()
 988:       .in('id', rooms.map((room) => room.id));
 989:     if (deleteError) {
 990:       throw new Error(`Failed to replace reusable test space room conversations: ${deleteError.message}`);
 991:     }
 992:   }
