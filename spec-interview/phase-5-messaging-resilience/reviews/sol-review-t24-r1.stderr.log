 657: -- ============================================================================
 658: -- Fence / lookup: T2 body, with the explicit membership refusal marker.
 659: -- ============================================================================
 660: create or replace function public.fence_message_attempt(
 661:   p_sender_id uuid,
 662:   p_conversation_id uuid,
 663:   p_client_message_id uuid,
 664:   p_attempt_generation bigint
 665: )
 666: returns jsonb
 667: language plpgsql
 668: security invoker
 669: set search_path = ''
 670: as $$
 671: declare
 672:   v_generation bigint;
 673:   v_committed_at timestamptz;
 674:   v_message_id uuid;
 675: begin
 676:   if p_sender_id is null or p_conversation_id is null or p_client_message_id is null or p_attempt_generation is 
null then
 677:     raise exception 'fence_message_attempt: sender, conversation, key and generation are required'
 678:       using errcode = '22004';
 679:   end if;
 680:   if p_attempt_generation < 1 then
 681:     raise exception 'ATTEMPT_GENERATION_INVALID' using errcode = '22023';
 682:   end if;
 683: 
 684:   -- Defense in depth: the route already required membership.
 685:   if not exists (
 686:     select 1
 687:     from public.conversation_members cm
 688:     where cm.conversation_id = p_conversation_id
 689:       and cm.user_id = p_sender_id
 690:   ) then
 691:     -- Explicit marker (Phase 5 T3): callers map only this to NOT_PARTICIPANT.
 692:     raise exception 'NOT_PARTICIPANT' using errcode = '42501';
 693:   end if;
 694: 
 695:   insert into private.message_send_attempts (sender_id, conversation_id, client_message_id)
 696:   values (p_sender_id, p_conversation_id, p_client_message_id)
 697:   on conflict (sender_id, conversation_id, client_message_id) do nothing;
 698: 
 699:   select a.fence_generation, a.committed_at into v_generation, v_committed_at
 700:   from private.message_send_attempts a
 701:   where a.sender_id = p_sender_id
 702:     and a.conversation_id = p_conversation_id
 703:     and a.client_message_id = p_client_message_id
 704:   for update;
 705: 
 706:   if v_generation is not null and p_attempt_generation < v_generation then
 707:     return pg_catalog.jsonb_build_object('outcome', 'superseded', 'current_generation', v_generation);
 708:   end if;
 709: 
 710:   if v_generation is null or p_attempt_generation > v_generation then
 711:     update private.message_send_attempts a
 712:     set fence_generation = p_attempt_generation,
 713:         updated_at = pg_catalog.now()
 714:     where a.sender_id = p_sender_id
 715:       and a.conversation_id = p_conversation_id
 716:       and a.client_message_id = p_client_message_id;
 717:   end if;
 718: 
 719:   -- A new statement (new snapshot) after the row lock: a create that held the
 720:   -- lock has committed by now and its message is visible.
 721:   select m.id into v_message_id
 722:   from public.messages m
 723:   where m.sender_id = p_sender_id
 724:     and m.conversation_id = p_conversation_id
 725:     and m.client_message_id = p_client_message_id;
 726: 
 727:   if v_message_id is not null then
 728:     -- Delivery record, still under the key lock: a message the row does not
 729:     -- track yet (written before this migration) is recorded now, so its later
 730:     -- deletion is never reported as not stored.
 731:     update private.message_send_attempts a
 732:     set message_id = v_message_id,
 733:         committed_at = coalesce(a.committed_at, pg_catalog.now()),
 734:         composition = case when a.message_id = v_message_id then a.composition end,
 735:         updated_at = pg_catalog.now()
 736:     where a.sender_id = p_sender_id
 737:       and a.conversation_id = p_conversation_id
 738:       and a.client_message_id = p_client_message_id
 739:       and (a.message_id is distinct from v_message_id or a.committed_at is null);
 740:   end if;
 741: 
 742:   if v_message_id is not null or v_committed_at is not null then
 743:     -- message_id is null when the committed message was deleted since.
 744:     return pg_catalog.jsonb_build_object('outcome', 'stored', 'message_id', v_message_id);
 745:   end if;
 746:   return pg_catalog.jsonb_build_object('outcome', 'not_stored');
 747: end
 748: $$;
