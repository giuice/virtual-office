 156: export async function seedPhase5World(request: APIRequestContext): Promise<Phase5World> {
 157:   const response = await request.post('/api/test/messaging/seed', {
 158:     headers: seedHeaders(),
 159:     data: { includePhase5World: true, roomCount: 1, includePinnedRoom: false },
 160:   });
 161:   if (!response.ok()) {
 162:     throw new Error(`Failed to seed the Phase 5 world: ${response.status()} ${await response.text()}`);
 163:   }
 164:   const { data } = (await response.json()) as { data: SeedResponse };
 165:   const byEmail = new Map(data.users.map((user) => [user.email.trim().toLowerCase(), user]));
 166:   const users = Object.fromEntries(
 167:     PHASE5_USER_KEYS.map((key) => {
 168:       const prefix = ACCOUNT_ENV_PREFIX[key];
 169:       const email = requireEnv(`${prefix}_EMAIL`);
 170:       const seeded = byEmail.get(email.trim().toLowerCase());
 171:       if (!seeded) {
 172:         throw new Error(`The Phase 5 seed did not return user ${key}`);
 173:       }
 174:       const user: Phase5User = {
 175:         key,
 176:         userId: seeded.id,
 177:         supabaseUid: seeded.supabaseUid,
 178:         email,
 179:         password: requireEnv(`${prefix}_PASSWORD`),
 180:         displayName: requireEnv(`${prefix}_DISPLAY_NAME`),
 181:       };
 182:       return [key, user];
 183:     }),
 184:   ) as Record<Phase5UserKey, Phase5User>;
 185:   const [roomId] = data.conversations.roomIds;
 186:   const [roomSpaceId] = data.spaces.map((space) => space.id);
 187:   if (!roomId || !roomSpaceId || !data.conversations.groupId) {
 188:     throw new Error('The Phase 5 seed did not return a room and a group conversation');
 189:   }
 190:   return {
 191:     runId: data.runId,
 192:     companyId: data.company.id,
 193:     users,
 194:     conversations: { directId: data.conversations.directId, groupId: data.conversations.groupId, roomId },
 195:     roomSpaceId,
 196:     seededMessageIds: data.messages.map((message) => message.id),
 197:   };
 198: }
