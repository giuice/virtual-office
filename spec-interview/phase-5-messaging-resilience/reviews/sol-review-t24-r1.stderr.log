 296: export async function readPresenceRuntimeMode(db: Client): Promise<string | null> {
 297:   const { rows } = await db.query<{ mode: string }>('select mode::text from private.presence_runtime_control 
limit 1');
 298:   return rows[0]?.mode ?? null;
 299: }

