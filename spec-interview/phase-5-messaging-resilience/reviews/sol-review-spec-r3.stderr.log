91: function mapReactionToCamelCase(data: { emoji: string; user_id: string; timestamp: string }): MessageReaction {
92:   if (!data) return data;
93:   return {
94:     // Assuming reaction table doesn't have its own ID in the type, or map data.id if it does
95:     emoji: data.emoji,
96:     userId: data.user_id,
97:     timestamp: new Date(data.timestamp) // Convert DB timestamp string/obj to Date
98:   };
