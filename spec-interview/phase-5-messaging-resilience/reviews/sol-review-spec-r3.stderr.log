184: /**
185:  * One realtime channel for the whole messaging domain (audit M-06).
186:  *
187:  * Three postgres_changes bindings — messages, message_read_receipts,
188:  * message_reactions — share a single channel with NO client-side filters:
189:  * RLS SELECT policies (private.is_conversation_member) scope rows per
190:  * subscriber on the server, so the hook needs no conversation id list and
191:  * never re-subscribes when conversations change. The reported status is the
192:  * real status of the one channel carrying every messaging event.
193:  */
194: export function useMessageSubscription(options?: UseMessageSubscriptionOptions) {
195:   const isActive = options?.isActive ?? true;
196:   const companyId = options?.companyId;
197:   const currentUserId = options?.currentUserId;
198:   const queryClient = useQueryClient();
199:   const statusRef = useRef<string | null>(null);
200:   const statusListenersRef = useRef<Set<() => void> | null>(null);
201:   if (statusListenersRef.current === null) {
202:     statusListenersRef.current = new Set();
203:   }
204:   const statusListeners = statusListenersRef.current;
205: 
206:   const onInsertRef = useRef(options?.onInsert);
207:   const ignoreSenderIdRef = useRef(options?.ignoreSenderId);
208: 
209:   const publishStatus = useCallback((nextStatus: string | null) => {
210:     statusRef.current = nextStatus;
211:     statusListeners.forEach((listener) => listener());
212:   }, [statusListeners]);
213: 
214:   const subscribeStatus = useCallback((listener: () => void) => {
215:     statusListeners.add(listener);
216:     return () => {
217:       statusListeners.delete(listener);
218:     };
219:   }, [statusListeners]);
220: 
221:   const getStatusSnapshot = useCallback(() => statusRef.current, []);
222:   const status = useSyncExternalStore(subscribeStatus, getStatusSnapshot, getStatusSnapshot);
223: 
224:   useEffect(() => {
225:     onInsertRef.current = options?.onInsert;
226:   }, [options?.onInsert]);
227: 
228:   useEffect(() => {
229:     ignoreSenderIdRef.current = options?.ignoreSenderId;
230:   }, [options?.ignoreSenderId]);
231: 
232:   useEffect(() => {
233:     publishStatus(null);
234:     if (!isActive || !companyId || !currentUserId) {
235:       return;
236:     }
237: 
238:     let isMounted = true;
239:     let channel: RealtimeChannel | null = null;
240:     let retryTimer: ReturnType<typeof setTimeout> | null = null;
241:     let stableSubscriptionTimer: ReturnType<typeof setTimeout> | null = null;
242:     let attempt = 0;
243:     let channelGeneration = 0;
244: 
245:     const handleMessageChange = (
246:       payload: RealtimePostgresChangesPayload<Record<string, unknown>>
247:     ) => {
248:       const eventType = payload.eventType;
249: 
250:       if (eventType === 'INSERT' && payload.new) {
251:         const message = mapRowToMessage(payload.new);
252: 
253:         // M-08: image/file messages arrive without their attachments. The
254:         // bare row is not shown (BR-007: a message is never visible without
255:         // its files); the feed refetches it with them. The refetch is the
256:         // deferred, non-cancelling one, so it never aborts an older page the
257:         // reader is loading.
258:         if (ATTACHMENT_MESSAGE_TYPES.has(message.type as string)) {
259:           scheduleFeedRefetch(message.conversationId);
260:         } else {
261:           appendMessageToCache(queryClient, message);
262:         }
263: 
264:         const ignoreSenderId = ignoreSenderIdRef.current;
265:         if (ignoreSenderId && message.senderId === ignoreSenderId) {
266:           return;
267:         }
268: 
269:         const callback = onInsertRef.current;
270:         if (callback) {
271:           callback(message);
272:         }
273:         return;
274:       }
275: 
276:       if (eventType === 'UPDATE' && payload.new) {
277:         updateMessageInCache(queryClient, payload.new.conversation_id as string, payload.new);
278:         return;
279:       }
280: 
281:       if (eventType === 'DELETE' && payload.old) {
282:         removeMessageFromAllCaches(queryClient, payload.old.id as string);
283:       }
284:     };
285: 
286:     // Phase 2.2: read-receipt INSERTs (written in bulk by the
287:     // mark_conversation_read RPC) flip the sender's read indicator.
288:     // Refetch derives status from message_read_receipts server-side.
289:     // A burst of receipt events becomes one refetch per conversation, and it
290:     // never cancels an in-flight fetch: an invalidation with the default
291:     // cancelRefetch aborts an older page the reader is loading, after which
292:     // the infinite query refetches only the pages it already had. While a
293:     // fetch is running the refetch waits for it, so no receipt is lost.
294:     // The same deferred refetch catches a feed (and an open starred list,
295:     // which also pages) up after the channel (re)joins.
296:     const deferredRefetchTimers = new Map<string, ReturnType<typeof setTimeout>>();
297:     const scheduleDeferredRefetch = (queryKey: QueryKey) => {
298:       const timerKey = hashKey(queryKey);
299:       if (deferredRefetchTimers.has(timerKey)) return;
300:       deferredRefetchTimers.set(
301:         timerKey,
302:         setTimeout(() => {
303:           deferredRefetchTimers.delete(timerKey);
304:           if (!isMounted) return;
305:           const query = queryClient.getQueryCache().find({ queryKey, exact: true });
306:           if (query?.state.fetchStatus === 'fetching') {
307:             scheduleDeferredRefetch(queryKey);
308:             return;
309:           }
310:           void queryClient.invalidateQueries({ queryKey }, { cancelRefetch: false });
311:         }, RECEIPT_REFETCH_DELAY_MS)
312:       );
313:     };
314:     const scheduleFeedRefetch = (conversationId: string) => {
315:       scheduleDeferredRefetch(['messages', conversationId]);
316:     };
317: 
318:     const handleReceiptInsert = (
319:       payload: RealtimePostgresChangesPayload<Record<string, unknown>>
320:     ) => {
321:       const row = payload.new as Record<string, unknown> | null;
322:       const conversationId = row?.conversation_id;
323:       if (typeof conversationId === 'string') {
324:         scheduleFeedRefetch(conversationId);
325:       }
326:       // Phase 4 FR-005: an open reader list refetches right away (only active
327:       // queries refetch; a closed one is refetched on its next open). Its
328:       // request is small and per message, so superseding one in flight —
329:       // which may predate this receipt — is the safe default.
330:       const messageId = row?.message_id;
331:       if (typeof messageId === 'string') {
332:         void queryClient.invalidateQueries({ queryKey: messageReadersQueryKey(messageId) });
333:       }
334:     };
335: 
336:     // Changes committed while the channel was not yet (or no longer) streaming
337:     // never arrive as events: on first load, a message sent between the
338:     // initial fetches and the join would leave the unread count and the feed
339:     // stale until some later event. Once the server confirms the
340:     // postgres_changes stream for this (re)join, every cached feed refetches
341:     // (receipt counts, stars, attachment messages), and so do the caches kept
342:     // outside the feed: an open reader list (receipts) and an open starred
343:     // list (stars have no Realtime event at all; another session's change
344:     // shows on the next refetch). Closed ones are only marked stale; they
345:     // refetch whenever they open. The conversation list catches up in
346:     // useConversationRealtime.
347:     const catchUpTimelineCaches = () => {
348:       const queryCache = queryClient.getQueryCache();
349:       queryCache
350:         .findAll({ queryKey: ['messages'] })
351:         .forEach((query) => {
352:           const [, conversationId] = query.queryKey;
353:           if (query.queryKey.length === 2 && typeof conversationId === 'string') {
354:             scheduleFeedRefetch(conversationId);
355:           }
356:         });
357:       queryCache
358:         .findAll({ queryKey: STARRED_MESSAGES_QUERY_KEY })
359:         .forEach((query) => scheduleDeferredRefetch(query.queryKey));
360:       // Same policy as the receipt handler: a small per-message request, so
361:       // superseding one in flight (which may predate the reconnect) is safe.
362:       void queryClient.invalidateQueries({ queryKey: MESSAGE_READERS_QUERY_KEY });
363:     };
364: 
365:     const handleReactionChange = (
366:       payload: RealtimePostgresChangesPayload<Record<string, unknown>>
367:     ) => {
368:       if (payload.eventType === 'INSERT' && payload.new) {
369:         const messageId = payload.new.message_id as string;
370:         const userId = payload.new.user_id as string;
371:         const emoji = payload.new.emoji as string;
372:         const timestampValue = payload.new.created_at ?? payload.new.timestamp;
373:         const timestamp = timestampValue ? new Date(timestampValue as string) : new Date();
374:         handleReactionUpdate(queryClient, messageId, userId, emoji, 'INSERT', timestamp);
375:         return;
376:       }
377: 
378:       if (payload.eventType === 'DELETE') {
379:         // Under RLS the DELETE payload only carries the reaction row's PK, so
380:         // the affected message is unknown — invalidate and let the active
381:         // conversation refetch (this is what syncs reaction removal live).
382:         queryClient.invalidateQueries({ queryKey: ['messages'] });
383:       }
384:     };
385: 
386:     const clearRetryTimer = () => {
387:       if (retryTimer) {
388:         clearTimeout(retryTimer);
389:         retryTimer = null;
390:       }
391:     };
392: 
393:     const clearStableSubscriptionTimer = () => {
394:       if (stableSubscriptionTimer) {
395:         clearTimeout(stableSubscriptionTimer);
396:         stableSubscriptionTimer = null;
397:       }
398:     };
399: 
400:     const retireChannel = (ownedChannel: RealtimeChannel) => {
401:       if (channel === ownedChannel) {
402:         channel = null;
403:         channelGeneration += 1;
404:         clearStableSubscriptionTimer();
405:         if (debugLogger.messaging.enabled()) {
406:           debugLogger.messaging.trace('useMessageSubscription', 'unsubscribe', {
407:             channel: CHANNEL_NAME,
408:           });
409:         }
410:       }
411:       void supabase.removeChannel(ownedChannel).then((status) => {
412:         if (status !== 'ok') ownedChannel.teardown();
413:       }).catch(() => {
414:         ownedChannel.teardown();
415:       });
416:     };
417: 
418:     const subscribeChannel = () => {
419:       if (!isMounted) return;
420: 
421:       clearRetryTimer();
422:       clearStableSubscriptionTimer();
423:       if (channel) retireChannel(channel);
424:       attempt += 1;
425: 
426:       if (debugLogger.messaging.enabled()) {
427:         debugLogger.messaging.trace('useMessageSubscription', 'subscribe:attempt', {
428:           channel: CHANNEL_NAME,
429:           attempt,
430:         });
431:       }
432: 
433:       const generation = channelGeneration + 1;
434:       channelGeneration = generation;
435:       let nextChannel: RealtimeChannel;
436:       const isOwnedChannel = (): boolean => (
437:         isMounted
438:         && channel === nextChannel
439:         && channelGeneration === generation
440:       );
441:       nextChannel = supabase
442:         .channel(createChannelTopic(companyId, currentUserId))
443:         .on(
444:           'postgres_changes',
445:           { event: '*', schema: 'public', table: 'messages' },
446:           (payload) => {
447:             if (isOwnedChannel()) handleMessageChange(payload);
448:           }
449:         )
450:         .on(
451:           'postgres_changes',
452:           { event: 'INSERT', schema: 'public', table: 'message_read_receipts' },
453:           (payload) => {
454:             if (isOwnedChannel()) handleReceiptInsert(payload);
455:           }
456:         )
457:         .on(
458:           'postgres_changes',
459:           { event: '*', schema: 'public', table: 'message_reactions' },
460:           (payload) => {
461:             if (isOwnedChannel()) handleReactionChange(payload);
462:           }
463:         )
464:         .on('system', {}, (payload: RealtimeSystemPayload) => {
465:           if (
466:             isOwnedChannel()
467:             && payload.extension === 'postgres_changes'
468:             && payload.status === 'ok'
469:           ) {
470:             catchUpTimelineCaches();
471:           }
472:         });
473:       channel = nextChannel;
474: 
475:       nextChannel.subscribe((channelStatus) => {
476:         if (
477:           !isMounted
478:           || channel !== nextChannel
479:           || channelGeneration !== generation
480:         ) return;
481: 
482:         publishStatus(channelStatus);
483: 
484:         if (debugLogger.messaging.enabled()) {
485:           debugLogger.messaging.trace('useMessageSubscription', 'status', {
486:             channel: CHANNEL_NAME,
487:             status: channelStatus,
488:           });
489:         }
490: 
491:         if (channelStatus === 'SUBSCRIBED') {
492:           clearRetryTimer();
493:           clearStableSubscriptionTimer();
494:           stableSubscriptionTimer = setTimeout(() => {
495:             stableSubscriptionTimer = null;
496:             if (
497:               !isMounted
498:               || channel !== nextChannel
499:               || channelGeneration !== generation
500:             ) return;
501:             attempt = 0;
502:           }, RETRY_STABLE_AFTER_MS);
503:           return;
504:         }
505: 
506:         if (FAILURE_STATUSES.has(channelStatus)) {
507:           clearStableSubscriptionTimer();
508:           if (retryTimer) return;
509:           const delay = Math.min(
510:             RETRY_MAX_DELAY_MS,
511:             RETRY_BASE_DELAY_MS * Math.pow(2, Math.max(attempt - 1, 0))
512:           );
513: 
514:           if (debugLogger.messaging.enabled()) {
515:             debugLogger.messaging.warn('useMessageSubscription', 'retry', {
516:               channel: CHANNEL_NAME,
517:               status: channelStatus,
518:               delay,
519:               attempt,
520:             });
521:           }
522: 
523:           retryTimer = setTimeout(() => {
524:             retryTimer = null;
525:             if (
526:               !isMounted
527:               || channel !== nextChannel
528:               || channelGeneration !== generation
529:             ) return;
530:             subscribeChannel();
531:           }, delay);
532:         }
533:       });
534:     };
535: 
536:     subscribeChannel();
537: 
538:     return () => {
539:       isMounted = false;
540:       clearRetryTimer();
541:       clearStableSubscriptionTimer();
542:       deferredRefetchTimers.forEach((timer) => clearTimeout(timer));
543:       deferredRefetchTimers.clear();
544:       if (channel) retireChannel(channel);
545:       publishStatus(null);
546:     };
547:   }, [companyId, currentUserId, isActive, queryClient, publishStatus]);
548: 
549:   return { status: isActive && companyId && currentUserId ? status : null };
550: }

