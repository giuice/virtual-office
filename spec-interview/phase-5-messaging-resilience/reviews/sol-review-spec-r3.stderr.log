1: // src/lib/auth/session.ts
2: import type { NextResponse } from 'next/server';
3: import type { SupabaseClient, User as SupabaseAuthUser } from '@supabase/supabase-js';
4: import { API_ERROR_CODES } from '@/lib/api/error-contract';
5: import { jsonError } from '@/lib/api/server-error';
6: import {
7:   createAuthCorrelationId,
8:   getAuthErrorCode,
9:   recordAuthValidation,
10: } from '@/lib/auth/auth-metrics';
11: import { createSupabaseServerClient } from '@/lib/supabase/server-client';
12: import { SupabaseUserRepository } from '@/repositories/implementations/supabase';
13: import type { User } from '@/types/database';
14: 
15: type SessionResult = {
16:   supabaseUid?: string; // Supabase Auth UID
17:   userDbId?: string; // Database UUID (from users table)
18:   error?: string;
19: };
20: 
21: /**
22:  * Validates the user session and returns the user ID if valid
23:  * Handles the relationship between Supabase Auth UIDs and Database UUIDs
24:  *
25:  * @returns Object containing supabaseUid (Supabase Auth UID), userDbId (Database UUID), and error (if any)
26:  */
27: export async function validateUserSession(): Promise<SessionResult> {
28:   try {
29:     const supabase = await createSupabaseServerClient();
30:     
31:     const { data, error } = await supabase.auth.getUser();
32:     
33:     if (error) {
34:       console.error('Session error:', error.message);
35:       return { error: error.message };
36:     }
37:     
38:     if (!data.user) {
39:       return { error: 'No active session' };
40:     }
41:     
42:     const supabaseUid = data.user.id; // This is the Supabase Auth UID
43:     
44:     // Get the database user record to fetch the database UUID
45:     const { data: userRecord, error: userError } = await supabase
46:       .from('users')
47:       .select('id') // Database UUID
48:       .eq('supabase_uid', supabaseUid) // supabase_uid column holds the Supabase Auth UID
49:       .single();
50:     
51:     if (userError) {
52:       console.error('User lookup error:', userError.message);
53:       return { supabaseUid, error: 'User record not found' };
54:     }
55:     
56:     // Return both IDs for flexible usage
57:     return { 
58:       supabaseUid,   // Supabase Auth UID (from auth)
59:       userDbId: userRecord.id // Database UUID (from users table)
60:     };
61:     
62:   } catch (error) {
63:     console.error('Session validation error:', error);
64:     return { error: 'Failed to validate session' };
65:   }
66: }
67: 
68: type RequireAuthResult =
69:   | { supabase: SupabaseClient; dbUser: User; authUser: SupabaseAuthUser }
70:   | { errorResponse: NextResponse };
71: 
72: interface RequireAuthUserOptions {
73:   correlationId?: string;
74:   pathname?: string;
75:   beforeDatabaseOperation?: () => void;
76: }
77: 
78: type RequireAuthUserArgument = RequireAuthUserOptions | (() => void);
79: 
80: function normalizeRequireAuthOptions(argument?: RequireAuthUserArgument): RequireAuthUserOptions {
81:   return typeof argument === 'function' ? { beforeDatabaseOperation: argument } : (argument ?? {});
82: }
83: 
84: export async function requireAuthUser(argument?: RequireAuthUserArgument): Promise<RequireAuthResult> {
85:   const { correlationId: providedCorrelationId, pathname, beforeDatabaseOperation } = 
normalizeRequireAuthOptions(argument);
86:   const correlationId = providedCorrelationId ?? createAuthCorrelationId();
87:   let refreshed = false;
88:   const supabase = await createSupabaseServerClient(undefined, {
89:     onAuthCookiesSet: () => {
90:       refreshed = true;
91:     },
92:   });
93:   let authResult: Awaited<ReturnType<typeof supabase.auth.getUser>>;
94:   try {
95:     authResult = await supabase.auth.getUser();
96:   } catch (error) {
97:     recordAuthValidation({
98:       correlationId,
99:       boundary: 'route',
100:       pathname: pathname ?? '/unattributed',
101:       authMethod: 'getUser',
102:       authStatus: 'error',
103:       authErrorCode: getAuthErrorCode(error),
104:       refreshed,
105:     });
106:     throw error;
107:   }
108: 
109:   const { data, error } = authResult;
110:   recordAuthValidation({
111:     correlationId,
112:     boundary: 'route',
113:     pathname: pathname ?? '/unattributed',
114:     authMethod: 'getUser',
115:     authStatus: error ? 'error' : data.user ? 'authenticated' : 'unauthenticated',
116:     authErrorCode: getAuthErrorCode(error),
117:     refreshed,
118:   });
119: 
120:   if (error || !data.user) {
121:     const isRateLimited = error?.status === 429;
122:     return {
123:       errorResponse: jsonError(
124:         isRateLimited ? 429 : 401,
125:         isRateLimited ? API_ERROR_CODES.RATE_LIMITED : API_ERROR_CODES.UNAUTHORIZED,
126:         isRateLimited ? 'Authentication service rate limit reached' : 'Authentication required',
127:         { correlationId, cause: error, context: 'requireAuthUser.getUser' }
128:       ),
129:     };
130:   }
131: 
132:   const userRepository = new SupabaseUserRepository(supabase);
133: 
134:   let dbUser: User | null;
135:   try {
136:     beforeDatabaseOperation?.();
137:     dbUser = await userRepository.findBySupabaseUid(data.user.id);
138:   } catch (lookupError) {
139:     return {
140:       errorResponse: jsonError(
141:         500,
142:         API_ERROR_CODES.INTERNAL_ERROR,
143:         'Failed to load authenticated user profile',
144:         { correlationId, cause: lookupError, context: 'requireAuthUser.profileLookup' }
145:       ),
146:     };
147:   }
148: 
149:   if (!dbUser) {
150:     return {
151:       errorResponse: jsonError(
152:         404,
153:         API_ERROR_CODES.PROFILE_NOT_FOUND,
154:         'Authenticated user profile not found',
155:         { correlationId, context: 'requireAuthUser.profileLookup' }
156:       ),
157:     };
158:   }
159: 
160:   return { supabase, dbUser, authUser: data.user };
161: }

