680:   async removeReaction(messageId: string, userId: string, emoji: string): Promise<boolean> {
681:     // Map camelCase input to snake_case query
682:     const { error, count } = await this.supabaseClient
683:       .from(this.REACTION_TABLE_NAME)
684:       .delete({ count: 'exact' })
685:       .eq('message_id', messageId)
686:       .eq('user_id', userId)
687:       .eq('emoji', emoji);
688: 
689:     if (error) {
690:       console.error('Error removing reaction:', error);
691:       return false;
692:     }
693:     return (count ?? 0) > 0;
694:   }
