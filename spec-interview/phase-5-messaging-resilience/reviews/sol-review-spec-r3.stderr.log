576:   async update(id: string, updates: Partial<Pick<Message, 'content' | 'status' | 'isEdited'>>): Promise<Message | 
null> {
577:     // Map updates from camelCase to snake_case
578:     const dbUpdates: Partial<{ content: string; status: MessageStatus; is_edited: boolean }> = {};
579:     if (updates.content !== undefined) dbUpdates.content = updates.content;
580:     if (updates.status !== undefined) dbUpdates.status = updates.status;
581:     if (updates.isEdited !== undefined) dbUpdates.is_edited = updates.isEdited;
582: 
583:     if (Object.keys(dbUpdates).length === 0) {
584:       // If no fields to update, maybe fetch and return current? Or return null?
585:       // For now, fetch and return current state if no actual update fields provided.
586:       return this.findById(id);
587:     }
588: 
589:     const { data, error } = await this.supabaseClient
590:       .from(this.MSG_TABLE_NAME)
591:       .update(dbUpdates)
592:       .eq('id', id)
593:       .select()
594:       .single();
595: 
596:     if (error) {
597:       console.error('Error updating message:', error);
598:       if (error.code === 'PGRST116') return null;
599:       throw error;
600:     }
601:     // Audit M-08: enrich the returned message — returning emptied
602:     // attachments/reactions corrupts any cache the caller writes it into.
603:     const updatedMessage = data ? mapMessageToCamelCase(data) : null;
604:     if (updatedMessage) {
605:       await this.enrichMessages([updatedMessage]);
606:     }
607:     return updatedMessage;
608:   }
