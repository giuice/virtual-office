48: const mapRowToMessage = (row: any): Message => ({
49:   id: row.id,
50:   conversationId: row.conversation_id,
51:   senderId: row.sender_id,
52:   content: row.content,
53:   timestamp: new Date(row.timestamp),
54:   type: row.type,
55:   status: row.status,
56:   replyToId: row.reply_to_id ?? undefined,
57:   // Audit M-08: the messages row carries no attachments/reactions (separate
58:   // tables) — start empty; attachment-bearing types trigger a refetch below.
59:   attachments: [],
60:   reactions: [],
61:   isEdited: Boolean(row.is_edited),
62: });
63: 
64: // Message types whose payload lives in message_attachments — the realtime
65: // row can't carry it, so the conversation must refetch to enrich (M-08).
66: const ATTACHMENT_MESSAGE_TYPES = new Set(['image', 'file']);
67: 
68: // Audit B-04: shared cache-merge with the optimistic send path — page 0 is
69: // the newest window and dedupe runs across all pages.
70: const appendMessageToCache = (queryClient: QueryClient, message: Message) => {
71:   // A conversation whose history was never loaded has no cache entry. Creating
72:   // one from this single row would make the feed treat it as the whole history
73:   // (no older-page cursor, 5 min staleTime) and hide every earlier message, so
74:   // they could never be seen or read. Its first open fetches the history.
75:   if (!queryClient.getQueryData(['messages', message.conversationId])) {
76:     return;
77:   }
78:   queryClient.setQueryData<MessagesInfiniteData | undefined>(
79:     ['messages', message.conversationId],
80:     (oldData) => appendMessageToPages(oldData, message)
81:   );
82:   keepMessageThroughInflightFetch(queryClient, message.conversationId, message);
83: };
84: 
85: const updateMessageInCache = (queryClient: QueryClient, conversationId: string, row: any) => {
86:   queryClient.setQueryData<MessagesInfiniteData | undefined>(
87:     ['messages', conversationId],
88:     (oldData) => {
89:       if (!oldData || !oldData.pages) {
90:         return oldData;
91:       }
92: 
93:       const pages = oldData.pages.map((page) => ({
94:         ...page,
95:         messages: page.messages.map((existing) =>
96:           existing.id === row.id
97:             ? {
98:                 ...existing,
99:                 content: row.content ?? existing.content,
100:                 status: row.status ?? existing.status,
101:                 isEdited: row.is_edited ?? existing.isEdited,
102:                 reactions: row.reactions ?? existing.reactions,
103:               }
104:             : existing
105:         ),
106:       }));
107: 
108:       return { ...oldData, pages };
109:     }
110:   );
111: };
112: 
113: const handleReactionUpdate = (
114:   queryClient: QueryClient,
115:   messageId: string,
116:   userId: string,
117:   emoji: string,
118:   eventType: 'INSERT' | 'DELETE',
119:   timestamp: Date
120: ) => {
121:   if (debugLogger.messaging.enabled()) {
122:     debugLogger.messaging.trace('useMessageSubscription', 'reaction:event', {
123:       messageId,
124:       emoji,
125:       eventType,
126:     });
127:   }
128: 
129:   // Update all conversation caches that might contain this message
130:   const allMessagesQueries = queryClient.getQueriesData<MessagesInfiniteData>({
131:     queryKey: ['messages'],
132:   });
133: 
134:   allMessagesQueries.forEach(([queryKey, oldData]) => {
135:     if (!oldData?.pages) return;
136: 
137:     const currentPages = oldData.pages;
138:     const nextPages = toggleReactionInPages({
139:       pages: currentPages,
140:       messageId,
141:       emoji,
142:       userId,
143:       timestamp: eventType === 'INSERT' ? timestamp : undefined,
144:       mode: eventType === 'INSERT' ? 'add' : 'remove',
145:     });
146: 
147:     if (nextPages === currentPages) {
148:       return;
149:     }
150: 
151:     queryClient.setQueryData(queryKey, {
152:       ...oldData,
153:       pages: nextPages,
154:     });
155:   });
156: };
157: 
158: // DELETE payloads only carry the primary key under RLS, so the conversation
159: // is unknown — drop the message from every cached conversation.
160: const removeMessageFromAllCaches = (queryClient: QueryClient, messageId: string) => {
161:   const allMessagesQueries = queryClient.getQueriesData<MessagesInfiniteData>({
162:     queryKey: ['messages'],
163:   });
164: 
165:   allMessagesQueries.forEach(([queryKey, oldData]) => {
166:     if (!oldData?.pages) return;
167: 
168:     let changed = false;
169:     const pages = oldData.pages.map((page) => {
170:       const filtered = page.messages.filter((existing) => existing.id !== messageId);
171:       if (filtered.length !== page.messages.length) {
172:         changed = true;
173:         return { ...page, messages: filtered };
174:       }
175:       return page;
176:     });
177: 
178:     if (changed) {
179:       queryClient.setQueryData(queryKey, { ...oldData, pages });
180:     }
181:   });
182: };
