180: export class SupabaseMessageRepository implements IMessageRepository {
181:   private MSG_TABLE_NAME = 'messages'; // Ensure this matches your Supabase table name
182:   private REACTION_TABLE_NAME = 'message_reactions'; // Assuming separate table
183:   private ATTACHMENT_TABLE_NAME = 'message_attachments'; // Assuming separate table
184:   private READ_RECEIPT_TABLE_NAME = 'message_read_receipts'; // Read receipts table
185:   private MESSAGE_PIN_TABLE_NAME = 'pinned_messages'; // Message pins table
186:   private MESSAGE_STAR_TABLE_NAME = 'starred_messages'; // Message stars table
187:   private supabaseClient: SupabaseClient;
188: 
189:   constructor(supabaseClient: SupabaseClient) {
190:     this.supabaseClient = supabaseClient;
191:   }
192: 
193:   private async enrichMessages(messages: Message[]): Promise<Message[]> {
194:     if (messages.length === 0) {
195:       return messages;
196:     }
197: 
198:     const messageIds = messages.map(m => m.id);
199: 
200:     const { data: attachmentsData } = await this.supabaseClient
201:       .from(this.ATTACHMENT_TABLE_NAME)
202:       .select('*')
203:       .in('message_id', messageIds);
204: 
205:     const attachmentsByMessageId = (attachmentsData as AttachmentRow[] | null || []).reduce((acc: Record<string, 
FileAttachment[]>, row: AttachmentRow) => {
206:       const msgId = row.message_id as string;
207:       if (!acc[msgId]) acc[msgId] = [];
208:       acc[msgId].push(mapAttachmentToCamelCase(row));
209:       return acc;
210:     }, {} as Record<string, FileAttachment[]>);
211: 
212:     const { data: reactionsData } = await this.supabaseClient
213:       .from(this.REACTION_TABLE_NAME)
214:       .select('*')
215:       .in('message_id', messageIds);
216: 
217:     const reactionsByMessageId = (reactionsData as ReactionRow[] | null || []).reduce((acc: Record<string, 
MessageReaction[]>, row: ReactionRow) => {
218:       const msgId = row.message_id as string;
219:       if (!acc[msgId]) acc[msgId] = [];
220:       acc[msgId].push(mapReactionToCamelCase(row));
221:       return acc;
222:     }, {} as Record<string, MessageReaction[]>);
223: 
224:     messages.forEach(message => {
225:       message.attachments = attachmentsByMessageId[message.id] || [];
226:       message.reactions = reactionsByMessageId[message.id] || [];
227:     });
228: 
229:     return messages;
230:   }
231: 
232:   // Full feed enrichment shared by the paginated feed and the starred list
233:   // (Phase 4 FR-021): attachments, reactions, pins, the viewer's stars
234:   // (star RLS returns only the caller's own rows), readCount and the derived
235:   // READ status. Routes still strip readCount from messages the viewer did
236:   // not send (FR-003).
237:   private async enrichFeedMessages(messages: Message[], conversationId: string): Promise<Message[]> {
238:     if (messages.length === 0) {
239:       return messages;
240:     }
241: 
242:     const messageIds = messages.map(m => m.id);
243:     const enrichedMessages = await this.enrichMessages(messages);
244: 
245:     // Fetch all pins for these messages in bulk
246:     const { data: pinsData, error: pinsError } = await this.supabaseClient
247:       .from(this.MESSAGE_PIN_TABLE_NAME)
248:       .select('*')
249:       .in('message_id', messageIds);
250: 
251:     if (pinsError) {
252:       console.error(`Error fetching pins for conversation ${conversationId}:`, pinsError);
253:     }
254:     const pinsByMessageId = (pinsData as MessagePinRow[] | null || []).reduce((acc: Record<string, MessagePin[]>, 
row: MessagePinRow) => {
255:       const msgId = row.message_id;
256:       if (!acc[msgId]) acc[msgId] = [];
257:       acc[msgId].push(mapMessagePinToCamelCase(row));
258:       return acc;
259:     }, {} as Record<string, MessagePin[]>);
260: 
261:     // Fetch all stars for these messages in bulk
262:     const { data: starsData, error: starsError } = await this.supabaseClient
263:       .from(this.MESSAGE_STAR_TABLE_NAME)
264:       .select('*')
265:       .in('message_id', messageIds);
266: 
267:     if (starsError) {
268:       console.error(`Error fetching stars for conversation ${conversationId}:`, starsError);
269:     }
270:     const starsByMessageId = (starsData as MessageStarRow[] | null || []).reduce((acc: Record<string, 
MessageStar[]>, row: MessageStarRow) => {
271:       const msgId = row.message_id;
272:       if (!acc[msgId]) acc[msgId] = [];
273:       acc[msgId].push(mapMessageStarToCamelCase(row));
274:       return acc;
275:     }, {} as Record<string, MessageStar[]>);
276: 
277:     // Audit B-05/Phase 2.2: messages.status is frozen at 'sent' in the DB;
278:     // the read indicator derives from message_read_receipts. Rule: read if
279:     // ANY non-sender receipt exists (receipts are only ever written for
280:     // non-senders). Phase 4 FR-001: readCount is the number of distinct
281:     // non-sender readers ("Lida por N"); (message_id, user_id) is unique, so
282:     // counting rows counts readers. Receipt RLS returns every reader's row
283:     // only to the message's sender (anyone else sees just their own), so the
284:     // count is exact for the viewer's own messages — the only ones it is
285:     // shown on.
286:     const { data: receiptsData, error: receiptsError } = await this.supabaseClient
287:       .from(this.READ_RECEIPT_TABLE_NAME)
288:       .select('message_id, user_id')
289:       .in('message_id', messageIds);
290: 
291:     if (receiptsError) {
292:       console.error(`Error fetching read receipts for conversation ${conversationId}:`, receiptsError);
293:     }
294:     const senderByMessageId = new Map(enrichedMessages.map(message => [message.id, message.senderId]));
295:     const readCountByMessageId = new Map<string, number>();
296:     for (const row of (receiptsData || []) as Array<{ message_id: string; user_id: string }>) {
297:       if (row.user_id === senderByMessageId.get(row.message_id)) continue;
298:       readCountByMessageId.set(row.message_id, (readCountByMessageId.get(row.message_id) ?? 0) + 1);
299:     }
300: 
301:     enrichedMessages.forEach(message => {
302:       message.pins = pinsByMessageId[message.id] || [];
303:       message.stars = starsByMessageId[message.id] || [];
304:       message.readCount = readCountByMessageId.get(message.id) ?? 0;
305:       if (message.readCount > 0 && message.status !== MessageStatus.FAILED) {
306:         message.status = MessageStatus.READ;
307:       }
308:     });
309: 
310:     return enrichedMessages;
311:   }
312: 
313:   async findById(id: string): Promise<Message | null> {
314:     const { data, error } = await this.supabaseClient
315:       .from(this.MSG_TABLE_NAME)
316:       .select('*') // TODO: Select related reactions/attachments if needed
317:       .eq('id', id)
318:       .single();
319: 
320:     if (error && error.code !== 'PGRST116') {
321:       console.error('Error fetching message by ID:', error);
322:       throw error;
323:     }
324: 
325:     if (!data) {
326:       return null;
327:     }
328: 
329:     // Map the core message data
330:     const message = mapMessageToCamelCase(data);
331: 
332:     const [
333:       { data: attachmentsData, error: attachmentsError },
334:       { data: reactionsData, error: reactionsError },
335:       { data: pinsData, error: pinsError },
336:       { data: starsData, error: starsError }
337:     ] = await Promise.all([
338:       this.supabaseClient
339:         .from(this.ATTACHMENT_TABLE_NAME)
340:         .select('*')
341:         .eq('message_id', message.id),
342:       this.supabaseClient
343:         .from(this.REACTION_TABLE_NAME)
344:         .select('*')
345:         .eq('message_id', message.id),
346:       this.supabaseClient
347:         .from(this.MESSAGE_PIN_TABLE_NAME)
348:         .select('*')
349:         .eq('message_id', message.id),
350:       this.supabaseClient
351:         .from(this.MESSAGE_STAR_TABLE_NAME)
352:         .select('*')
353:         .eq('message_id', message.id)
354:     ]);
355: 
356:     if (attachmentsError) {
357:       console.error(`Error fetching attachments for message ID ${message.id}:`, attachmentsError);
358:       // Decide if you want to throw or return message without attachments
359:       // For now, return message with empty attachments array on error
360:       message.attachments = [];
361:     } else {
362:       message.attachments = mapAttachmentArrayToCamelCase(attachmentsData || []);
363:     }
364: 
365:     if (reactionsError) {
366:       console.error(`Error fetching reactions for message ID ${message.id}:`, reactionsError);
367:       // Return message with empty reactions array on error
368:       message.reactions = [];
369:     } else {
370:       message.reactions = mapReactionArrayToCamelCase(reactionsData || []);
371:     }
372: 
373:     if (pinsError) {
374:       console.error(`Error fetching pins for message ID ${message.id}:`, pinsError);
375:       message.pins = [];
376:     } else {
377:       // Map pins
378:       message.pins = (pinsData as MessagePinRow[] | null || []).map((p: MessagePinRow) => 
mapMessagePinToCamelCase(p));
379:     }
380: 
381:     if (starsError) {
382:       console.error(`Error fetching stars for message ID ${message.id}:`, starsError);
383:       message.stars = [];
384:     } else {
385:       // Map stars
386:       message.stars = (starsData as MessageStarRow[] | null || []).map((s: MessageStarRow) => 
mapMessageStarToCamelCase(s));
387:     }
388: 
389:     return message;
390:   }
