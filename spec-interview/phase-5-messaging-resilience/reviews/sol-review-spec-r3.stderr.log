293:         return jsonError(500, 'INTERNAL_ERROR', 'Failed to create message');
294:       }
295:       if (!replyTarget || replyTarget.conversation_id !== conversation.id) {
296:         return jsonError(400, 'INVALID_REPLY_TARGET', 'replyToId must reference a message in the same 
conversation');
297:       }
