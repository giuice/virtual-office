102: function mapMessagePinToCamelCase(data: { id: string; message_id: string; conversation_id: string; pinned_by: 
string; pinned_at: string }): MessagePin {
103:   if (!data) return data;
104:   return {
105:     id: data.id,
106:     messageId: data.message_id,
107:     conversationId: data.conversation_id,
108:     userId: data.pinned_by, // mapped from pinned_by
109:     pinnedAt: new Date(data.pinned_at)
110:   };
111: }
112: 
113: // Map DB snake_case to MessageStar type (camelCase)
114: function mapMessageStarToCamelCase(data: { id: string; message_id: string; conversation_id: string; user_id: 
string; starred_at: string }): MessageStar {
115:   if (!data) return data;
116:   return {
117:     id: data.id,
118:     messageId: data.message_id,
119:     conversationId: data.conversation_id,
120:     userId: data.user_id,
121:     starredAt: new Date(data.starred_at)
122:   };
123: }
124: 
125: // Map array helpers
126: type MessageCreateData = Omit<Message, 'id' | 'timestamp' | 'reactions' | 'attachments' | 'isEdited'>;
127: 
128: // Map Message type (camelCase) to DB schema (snake_case) for INSERT.
129: // timestamp, id and is_edited use their column defaults; reactions and
130: // attachments live in their own tables.
131: function toMessageInsertRow(messageData: MessageCreateData) {
132:   return {
133:     conversation_id: messageData.conversationId,
134:     sender_id: messageData.senderId,
135:     content: messageData.content,
136:     type: messageData.type,
137:     status: messageData.status,
138:     reply_to_id: messageData.replyToId,
139:   };
140: }
141: 
142: function mapCreatedMessage(row: MessageRow): Message {
143:   const message = mapMessageToCamelCase(row);
144:   message.reactions = message.reactions || [];
145:   message.attachments = message.attachments || [];
146:   return message;
147: }
148: 
149: // unique_violation. On a keyed insert the only reachable unique index is
150: // messages_sender_conversation_client_message_id_key (id is defaulted); the
151: // caller confirms by reading the winning row and rethrows if there is none.
152: function isUniqueViolation(error: { code?: string }): boolean {
153:   return error.code === '23505';
154: }
155: 
156: function mapMessageArrayToCamelCase(dataArray: MessageRow[]): Message[] {
157:   if (!dataArray) return [];
158:   return dataArray.map(item => mapMessageToCamelCase(item));
159: }
160: function mapAttachmentArrayToCamelCase(dataArray: AttachmentFields[]): FileAttachment[] {
161:   if (!dataArray) return [];
162:   return dataArray.map(item => mapAttachmentToCamelCase(item));
163: }
164: function mapReactionArrayToCamelCase(dataArray: { emoji: string; user_id: string; timestamp: string }[]): 
MessageReaction[] {
165:   if (!dataArray) return [];
166:   return dataArray.map(item => mapReactionToCamelCase(item));
167: }
168: 
169: type AttachmentRow = AttachmentFields & { message_id: string };
170: type ReactionRow = { message_id: string; user_id: string; emoji: string; timestamp: string };
171: type MessagePinRow = { id: string; message_id: string; conversation_id: string; pinned_by: string; pinned_at: 
string };
172: type MessageStarRow = { id: string; message_id: string; conversation_id: string; user_id: string; starred_at: 
string };
173: type MessageReaderRow = {
174:   user_id: string;
175:   read_at: string;
176:   reader: { display_name: string | null; avatar_url: string | null } | null;
177: };
