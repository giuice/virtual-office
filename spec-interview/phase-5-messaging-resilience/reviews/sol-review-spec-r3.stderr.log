8: // --- Helper Functions ---
9: 
10: // Composite keyset cursor "{raw_pg_timestamp}|{id}" (audit M-03). The raw
11: // Postgres timestamp keeps microsecond precision; the id breaks ties between
12: // equal timestamps. Legacy timestamp-only cursors parse with id = null.
13: function buildCompositeCursor(row: { timestamp: string; id: string }): string {
14:   return `${row.timestamp}|${row.id}`;
15: }
16: 
17: function parseCompositeCursor(cursor: string): { ts: string; id: string | null } {
18:   const sep = cursor.indexOf('|');
19:   if (sep === -1) {
20:     return { ts: cursor, id: null };
21:   }
22:   return { ts: cursor.slice(0, sep), id: cursor.slice(sep + 1) };
23: }
24: 
25: // Map DB snake_case to Message type (camelCase)
26: // Note: attachments and reactions are handled separately or fetched later
27: type MessageRow = {
28:   id: string;
29:   conversation_id: string;
30:   sender_id: string;
31:   content: string;
32:   timestamp: string;
33:   type: string;
34:   status: string;
35:   reply_to_id: string | null;
36:   is_edited: boolean;
37: };
38: function mapMessageToCamelCase(data: MessageRow): Message {
39:   if (!data) return data;
40:   return {
41:     id: data.id,
42:     conversationId: data.conversation_id,
43:     senderId: data.sender_id,
44:     content: data.content,
45:     timestamp: new Date(data.timestamp), // Convert DB timestamp string/obj to Date
46:     type: data.type as MessageType,
47:     status: data.status as MessageStatus,
48:     replyToId: data.reply_to_id || undefined,
49:     isEdited: data.is_edited,
50:     attachments: [], // Placeholder - fetch separately
51:     reactions: []    // Placeholder - fetch separately
52:   };
53: }
54: 
55: interface AttachmentFields {
56:   id: string;
57:   name: string;
58:   type: string;
59:   size: number;
60:   url: string;
61:   thumbnail_url?: string | null;
62:   // Voice notes (Phase 4 T15).
63:   duration?: number | null;
64:   waveform_data?: unknown;
65: }
66: 
67: // Map DB snake_case to FileAttachment type (camelCase); voice notes also
68: // carry duration and waveformData (VoiceNoteAttachment).
69: function mapAttachmentToCamelCase(data: AttachmentFields): FileAttachment | VoiceNoteAttachment {
70:   if (!data) return data;
71:   // Audit S-03: the bucket is private and `url` stores the storage path —
72:   // expose the authz'd API route, which redirects to a signed URL. Legacy
73:   // rows holding a full URL pass through (migration rewrites them to paths).
74:   const isStoragePath = (value: string): boolean => !value.startsWith('http') && !value.startsWith('/');
75:   const thumbnail = data.thumbnail_url || undefined;
76:   const attachment: FileAttachment = {
77:     id: data.id,
78:     name: data.name,
79:     type: data.type,
80:     size: data.size,
81:     url: isStoragePath(data.url) ? `/api/messages/attachment/${data.id}` : data.url,
82:     thumbnailUrl: thumbnail && isStoragePath(thumbnail) ? `/api/messages/attachment/${data.id}` : thumbnail
83:   };
84:   if (typeof data.duration === 'number') {
85:     return { ...attachment, duration: data.duration, waveformData: toVoiceNoteWaveform(data.waveform_data) ?? 
undefined };
86:   }
87:   return attachment;
88: }
