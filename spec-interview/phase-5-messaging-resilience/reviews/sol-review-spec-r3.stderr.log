510:   // Note: Input timestamp is Date object, Supabase handles conversion to TIMESTAMPTZ
511:   async create(messageData: MessageCreateData): Promise<Message> {
512:     const { data, error } = await this.supabaseClient
513:       .from(this.MSG_TABLE_NAME)
514:       .insert(toMessageInsertRow(messageData))
515:       .select()
516:       .single();
517: 
518:     if (error || !data) {
519:       console.error('Error creating message:', error);
520:       throw error || new Error('Failed to create message or retrieve created data.');
521:     }
522:     return mapCreatedMessage(data as MessageRow);
523:   }
524: 
525:   // Idempotent create (Phase 4 FR-024): the composition key is unique per
526:   // (sender_id, conversation_id) through the partial unique index
527:   // messages_sender_conversation_client_message_id_key. A retry finds the
528:   // stored row; a concurrent create with the same key loses the INSERT race
529:   // with a unique violation and reads the winner instead.
530:   async createWithClientKey(messageData: MessageCreateData, clientMessageId: string): 
Promise<MessageCreateResult> {
531:     const stored = await this.findByClientMessageId(messageData, clientMessageId);
532:     if (stored) {
533:       return { message: stored, created: false };
534:     }
535: 
536:     const { data, error } = await this.supabaseClient
537:       .from(this.MSG_TABLE_NAME)
538:       .insert({ ...toMessageInsertRow(messageData), client_message_id: clientMessageId })
539:       .select()
540:       .single();
541: 
542:     if (!error && data) {
543:       return { message: mapCreatedMessage(data as MessageRow), created: true };
544:     }
545: 
546:     if (error && isUniqueViolation(error)) {
547:       const winner = await this.findByClientMessageId(messageData, clientMessageId);
548:       if (winner) {
549:         return { message: winner, created: false };
550:       }
551:     }
552: 
553:     console.error('Error creating message:', error);
554:     throw error || new Error('Failed to create message or retrieve created data.');
555:   }
556: 
557:   private async findByClientMessageId(
558:     messageData: Pick<MessageCreateData, 'senderId' | 'conversationId'>,
559:     clientMessageId: string
560:   ): Promise<Message | null> {
561:     const { data, error } = await this.supabaseClient
562:       .from(this.MSG_TABLE_NAME)
563:       .select('*')
564:       .eq('sender_id', messageData.senderId)
565:       .eq('conversation_id', messageData.conversationId)
566:       .eq('client_message_id', clientMessageId)
567:       .maybeSingle();
568: 
569:     if (error) {
570:       console.error('Error looking up message by client key:', error);
571:       throw error;
572:     }
573:     return data ? mapCreatedMessage(data as MessageRow) : null;
574:   }
