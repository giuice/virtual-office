714:   async getMessageReaders(messageId: string, senderId: string): Promise<MessageReader[]> {
715:     // One query: receipts joined with the reader's users row, most recent
716:     // first. The sender's own receipt is excluded defensively (BR-002: the
717:     // RPCs never write one). Callers must have verified the requester IS the
718:     // sender (BR-003); on a user-scoped client RLS enforces it again.
719:     const { data, error } = await this.supabaseClient
720:       .from(this.READ_RECEIPT_TABLE_NAME)
721:       .select('user_id, read_at, reader:users!message_read_receipts_user_id_fkey(display_name, avatar_url)')
722:       .eq('message_id', messageId)
723:       .neq('user_id', senderId)
724:       .order('read_at', { ascending: false })
725:       .order('user_id', { ascending: true })
726:       .overrideTypes<MessageReaderRow[], { merge: false }>();
727: 
728:     if (error) {
729:       console.error('Error fetching message readers:', error);
730:       throw error;
731:     }
732: 
733:     return (data ?? []).map((row) => ({
734:       userId: row.user_id,
735:       displayName: row.reader?.display_name ?? null,
736:       avatarUrl: row.reader?.avatar_url ?? null,
737:       readAt: new Date(row.read_at),
738:     }));
