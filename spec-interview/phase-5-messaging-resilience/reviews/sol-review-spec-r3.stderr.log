23: interface UseMessageSubscriptionOptions {
24:   isActive?: boolean;
25:   companyId?: string;
26:   currentUserId?: string;
27:   onInsert?: (message: Message) => void;
28:   ignoreSenderId?: string;
29: }
30: 
31: const CHANNEL_NAME = 'messaging-db-changes';
32: const FAILURE_STATUSES = new Set(['TIMED_OUT', 'CHANNEL_ERROR', 'CLOSED']);
33: const RETRY_BASE_DELAY_MS = 250;
34: const RETRY_MAX_DELAY_MS = 5000;
35: const RETRY_STABLE_AFTER_MS = 30_000;
36: // A mark-read writes one receipt row per message; each row is its own event.
37: const RECEIPT_REFETCH_DELAY_MS = 100;
38: let channelTopicSequence = 0;
39: 
40: function createChannelTopic(companyId: string, currentUserId: string): string {
41:   channelTopicSequence += 1;
42:   const entropy = typeof crypto !== 'undefined' && typeof crypto.randomUUID === 'function'
43:     ? crypto.randomUUID()
44:     : `${Date.now()}-${channelTopicSequence}`;
45:   return `${CHANNEL_NAME}:${companyId}:${currentUserId}:${channelTopicSequence}:${entropy}`;
46: }
