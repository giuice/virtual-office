src/lib/messaging/desktop-notifications.ts
1: // src/lib/messaging/desktop-notifications.ts
2: // Phase 4 FR-023 / BR-010: desktop notifications for new messages from others
3: // in direct and group conversations. Page-level Notifications API only (no
4: // service worker): a notification can be shown while a tab of the app is open.
5: 
6: import { ConversationType, MessageType, type Conversation, type Message } from '@/types/messaging';
7: 
8: /**
9:  * What the drawer control shows:
10:  * - unsupported: the browser has no Notifications API;
11:  * - blocked: the browser permission is "denied";
12:  * - enabled: the user turned them on here and the permission is "granted";
13:  * - available: anything else (never asked, dismissed, or turned off in-app).
14:  */
15: export type DesktopNotificationStatus = 'unsupported' | 'blocked' | 'enabled' | 'available';
16: 
17: const PREFERENCE_KEY_PREFIX = 'vo:messaging:desktop-notifications:';
18: const PREFERENCE_ON = 'on';
19: const PREFERENCE_OFF = 'off';
20: /** In-tab signal that the preference changed (`storage` only fires in other tabs). */
21: const PREFERENCE_EVENT = 'vo:messaging:desktop-notifications-change';
22: 
23: const NOTIFIED_STORAGE_KEY = 'vo:messaging:notified-messages';
24: const NOTIFIED_LOCK_NAME = 'vo:messaging:notification-claim';
25: /** How long a claimed message id is remembered across tabs. */
26: const NOTIFIED_TTL_MS = 10 * 60_000;
27: const MAX_TAB_CLAIMS = 500;
28: const PREVIEW_MAX_LENGTH = 120;
29: 
30: export function notificationsSupported(): boolean {
31:   return typeof window !== 'undefined' && typeof window.Notification === 'function';
32: }
33: 
34: function readPermission(): NotificationPermission | null {
35:   if (!notificationsSupported()) return null;
36:   try {
37:     return window.Notification.permission;
38:   } catch {
39:     return null;
40:   }
41: }
42: 
43: const preferenceKey = (userId: string) => `${PREFERENCE_KEY_PREFIX}${userId}`;
44: 
45: /** The user's in-app opt-in on this browser. Absent (never chosen) means off. */
46: function readPreference(userId: string): boolean {
47:   try {
48:     return window.localStorage.getItem(preferenceKey(userId)) === PREFERENCE_ON;
49:   } catch {
50:     return false;
51:   }
52: }
53: 
54: export function writeDesktopNotificationPreference(userId: string, enabled: boolean): void {
55:   try {
56:     window.localStorage.setItem(preferenceKey(userId), enabled ? PREFERENCE_ON : PREFERENCE_OFF);
57:   } catch {
58:     // Storage unavailable: the choice cannot be kept; nothing else depends on it.
59:   }
60:   window.dispatchEvent(new Event(PREFERENCE_EVENT));
61: }
62: 
63: /**
64:  * Opt-in rule: notifications are on only when the user enabled them in the
65:  * drawer on this browser AND the browser permission is "granted". A granted
66:  * permission alone (e.g. given to another account or before turning them off
67:  * in-app) does not enable them; a denied/revoked permission disables them.
68:  */
69: export function readDesktopNotificationStatus(userId: string | null | undefined): DesktopNotificationStatus {
70:   const permission = readPermission();
71:   if (permission === null) return 'unsupported';
72:   if (permission === 'denied') return 'blocked';
73:   if (permission === 'granted' && userId && readPreference(userId)) return 'enabled';
74:   return 'available';
75: }
76: 
77: /**
78:  * Asks the browser for permission. Call only from a user action (the drawer
79:  * control); never on load. Resolves to the permission after the request.
80:  */
81: export async function requestDesktopNotificationPermission(): Promise<NotificationPermission | null> {
82:   if (!notificationsSupported()) return null;
83:   const current = readPermission();
84:   if (current !== 'default') return current;
85:   try {
86:     return await window.Notification.requestPermission();
87:   } catch {
88:     return readPermission();
89:   }
90: }
91: 
92: /** Calls `listener` whenever the status may have changed (preference or permission). */
93: export function subscribeDesktopNotificationStatus(listener: () => void): () => void {
94:   if (typeof window === 'undefined') return () => {};
95:   const onStorage = (event: StorageEvent) => {
96:     if (event.key === null || event.key.startsWith(PREFERENCE_KEY_PREFIX)) listener();
97:   };
98:   window.addEventListener(PREFERENCE_EVENT, listener);
99:   window.addEventListener('storage', onStorage);
100:   // A permission changed in the browser's site settings is picked up when the
101:   // user comes back to the tab, and live where the Permissions API reports it.
102:   window.addEventListener('focus', listener);
103:   document.addEventListener('visibilitychange', listener);
104:   let permissionStatus: PermissionStatus | null = null;
105:   let unsubscribed = false;
106:   navigator.permissions
107:     ?.query({ name: 'notifications' })
108:     .then((status) => {
109:       if (unsubscribed) return;
110:       permissionStatus = status;
111:       status.addEventListener('change', listener);
112:     })
113:     .catch(() => {});
114:   return () => {
115:     unsubscribed = true;
116:     window.removeEventListener(PREFERENCE_EVENT, listener);
117:     window.removeEventListener('storage', onStorage);
118:     window.removeEventListener('focus', listener);
119:     document.removeEventListener('visibilitychange', listener);
120:     permissionStatus?.removeEventListener('change', listener);
121:   };
122: }
123: 
124: export type IncomingMessageDecision = 'notify' | 'viewing' | 'skip';
125: 
126: /**
127:  * BR-010: others' messages in direct/group conversations notify when the tab
128:  * is hidden or the drawer is not open on that conversation. "Tab hidden" is
129:  * the foreground-tab definition used by read receipts (TRACK T6):
130:  * `document.visibilityState`, not window focus.
131:  */
132: export function decideIncomingMessage(input: {
133:   message: Message;
134:   conversation: Conversation;
135:   currentUserId: string;
136:   viewedConversationId: string | null;
137:   tabVisible: boolean;
138: }): IncomingMessageDecision {
139:   const { message, conversation, currentUserId, viewedConversationId, tabVisible } = input;
140:   // users.id comparison (the realtime row's sender_id is the application id).
141:   if (message.senderId === currentUserId) return 'skip';
142:   if (message.type === MessageType.SYSTEM) return 'skip';
143:   if (conversation.type !== ConversationType.DIRECT && conversation.type !== ConversationType.GROUP) {
144:     return 'skip';
145:   }
146:   if (tabVisible && viewedConversationId === conversation.id) return 'viewing';
147:   return 'notify';
148: }
149: 
150: const tabClaims = new Set<string>();
151: 
152: function rememberTabClaim(messageId: string): boolean {
153:   if (tabClaims.has(messageId)) return false;
154:   tabClaims.add(messageId);
155:   if (tabClaims.size > MAX_TAB_CLAIMS) {
156:     const oldest = tabClaims.values().next().value;
157:     if (oldest !== undefined) tabClaims.delete(oldest);
158:   }
159:   return true;
160: }
161: 
162: function claimAcrossTabs(messageId: string): boolean {
163:   try {
164:     const now = Date.now();
165:     const raw = window.localStorage.getItem(NOTIFIED_STORAGE_KEY);
166:     const parsed: unknown = raw ? JSON.parse(raw) : {};
167:     const claims: Record<string, number> = {};
168:     if (parsed && typeof parsed === 'object' && !Array.isArray(parsed)) {
169:       for (const [id, at] of Object.entries(parsed as Record<string, unknown>)) {
170:         if (typeof at === 'number' && now - at < NOTIFIED_TTL_MS) claims[id] = at;
171:       }
172:     }
173:     if (claims[messageId] !== undefined) return false;
174:     claims[messageId] = now;
175:     window.localStorage.setItem(NOTIFIED_STORAGE_KEY, JSON.stringify(claims));
176:     return true;
177:   } catch {
178:     // No shared storage: this tab alone decides.
179:     return true;
180:   }
181: }
182: 
183: /**
184:  * Claims a message so it is announced (or knowingly left unannounced) once:
185:  * once per tab, and once across this browser's tabs of the app. The
186:  * cross-tab check-and-set runs under a Web Lock, which makes it atomic
187:  * between tabs; without Web Locks it is best effort.
188:  */
189: export async function claimMessageNotification(messageId: string): Promise<boolean> {
190:   if (!rememberTabClaim(messageId)) return false;
191:   const locks = typeof navigator !== 'undefined' ? navigator.locks : undefined;
192:   if (locks?.request) {
193:     try {
194:       return await locks.request(NOTIFIED_LOCK_NAME, () => claimAcrossTabs(messageId));
195:     } catch {
196:       return claimAcrossTabs(messageId);
197:     }
198:   }
199:   return claimAcrossTabs(messageId);
200: }
201: 
202: /** Notification body: the text preview, or what kind of content was sent. */
203: export function notificationBody(message: Message, attachmentKind: 'voice' | 'file' | null): string {
204:   const text = message.content.replace(/\s+/g, ' ').trim();
205:   if (text) {
206:     return text.length > PREVIEW_MAX_LENGTH ? `${text.slice(0, PREVIEW_MAX_LENGTH - 1)}…` : text;
207:   }
208:   if (attachmentKind === 'voice') return 'Nota de voz';
209:   if (message.type === MessageType.IMAGE) return 'Imagem';
210:   return 'Anexo';
211: }
212: 
213: export function notificationTitle(conversation: Conversation, senderName: string): string {
214:   if (conversation.type === ConversationType.GROUP) {
215:     return `${senderName} em ${conversation.name?.trim() || 'grupo'}`;
216:   }
217:   return senderName;
218: }
219: 
220: /** One notification per conversation on screen: a newer one replaces it. */
221: export const notificationTag = (conversationId: string) => `vo-messaging-conversation-${conversationId}`;
222: 
223: /** Shows the notification; returns null when the browser refuses to construct it. */
224: export function showDesktopNotification(
225:   title: string,
226:   options: { body: string; tag: string },
227:   onClick: () => void,
228: ): Notification | null {
229:   if (readPermission() !== 'granted') return null;
230:   try {
231:     const notification = new window.Notification(title, options);
232:     notification.onclick = () => {
233:       try {
234:         window.focus();
235:       } catch {
236:         // Focusing is best effort.
237:       }
238:       onClick();
239:       notification.close();
240:     };
241:     return notification;
242:   } catch {
243:     // e.g. browsers that only allow notifications from a service worker.
244:     return null;
245:   }
246: }

