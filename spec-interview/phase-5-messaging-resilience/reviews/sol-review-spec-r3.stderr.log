392:   async findByConversation(conversationId: string, options?: PaginationOptions): 
Promise<PaginatedResult<Message>> {
393:     const limit = options?.limit ?? 50; // Default limit for messages
394: 
395:     // Keyset pagination by timestamp when provided
396:     const hasCursorBefore = !!options?.cursorBefore;
397:     const hasCursorAfter = !!options?.cursorAfter;
398: 
399:     let data: any[] | null = null;
400:     let error: any | null = null;
401: 
402:     if (hasCursorBefore || hasCursorAfter) {
403:       // Use keyset pagination - fetch limit + 1 to check for more results.
404:       // Audit M-03: composite (timestamp, id) cursor so equal timestamps
405:       // cannot skip or duplicate rows across pages. Legacy timestamp-only
406:       // cursors are still accepted.
407:       let query = this.supabaseClient
408:         .from(this.MSG_TABLE_NAME)
409:         .select('*')
410:         .eq('conversation_id', conversationId);
411: 
412:       if (hasCursorBefore) {
413:         const { ts, id } = parseCompositeCursor(options!.cursorBefore!);
414:         query = id
415:           ? query.or(`timestamp.lt."${ts}",and(timestamp.eq."${ts}",id.lt."${id}")`)
416:           : query.lt('timestamp', ts);
417:         // Get older messages relative to cursorBefore, newest-first to apply limit
418:         query = query
419:           .order('timestamp', { ascending: false })
420:           .order('id', { ascending: false })
421:           .limit(limit + 1);
422:       } else if (hasCursorAfter) {
423:         const { ts, id } = parseCompositeCursor(options!.cursorAfter!);
424:         query = id
425:           ? query.or(`timestamp.gt."${ts}",and(timestamp.eq."${ts}",id.gt."${id}")`)
426:           : query.gt('timestamp', ts);
427:         // Get newer messages relative to cursorAfter, oldest-first for append
428:         query = query
429:           .order('timestamp', { ascending: true })
430:           .order('id', { ascending: true })
431:           .limit(limit + 1);
432:       }
433: 
434:       const res = await query;
435:       data = res.data as any[] | null;
436:       error = res.error;
437:       if (error) {
438:         console.error('Error fetching messages by conversation (keyset):', error);
439:         throw error;
440:       }
441:       // For cursorBefore branch, data is DESC; reverse to ASC for rendering
442:       if (hasCursorBefore && data) {
443:         data = [...data].reverse();
444:       }
445:     } else {
446:       // Initial load: fetch most recent messages, newest first
447:       const res = await this.supabaseClient
448:         .from(this.MSG_TABLE_NAME)
449:         .select('*')
450:         .eq('conversation_id', conversationId)
451:         .order('timestamp', { ascending: false })
452:         .order('id', { ascending: false })
453:         .limit(limit + 1);
454:       data = res.data as any[] | null;
455:       error = res.error;
456:       if (error) {
457:         console.error('Error fetching messages by conversation (initial):', error);
458:         throw error;
459:       }
460:       // Reverse to oldest-first for UI rendering
461:       if (data) {
462:         data = [...data].reverse();
463:       }
464:     }
465: 
466:     if (!data || data.length === 0) {
467:       return {
468:         items: [],
469:         hasMore: false,
470:         nextCursor: null
471:       };
472:     }
473: 
474:     // Check if we have more results
475:     const hasMore = data.length > limit;
476:     // Trim to actual limit, preserving chronological (oldest->newest) order
477:     const trimmedData = hasMore
478:       ? (hasCursorAfter ? data.slice(0, limit) : data.slice(data.length - limit))
479:       : data;
480: 
481:     const enrichedMessages = await this.enrichFeedMessages(
482:       mapMessageArrayToCamelCase(trimmedData),
483:       conversationId
484:     );
485: 
486:     // Determine nextCursor based on pagination direction. Built from the RAW
487:     // row (full Postgres timestamp precision) — Date#toISOString truncates to
488:     // milliseconds, which can skip sub-millisecond neighbors at the boundary.
489:     let nextCursor: string | number | null = null;
490:     if (hasMore) {
491:       if (hasCursorAfter) {
492:         // Paging toward newer messages: continue after the newest returned row
493:         const newestRow = trimmedData[trimmedData.length - 1];
494:         nextCursor = buildCompositeCursor(newestRow);
495:       } else {
496:         // Initial load or paging toward older messages: continue before the
497:         // oldest returned row (trimmedData is oldest-first)
498:         const oldestRow = trimmedData[0];
499:         nextCursor = buildCompositeCursor(oldestRow);
500:       }
501:     }
502: 
503:     return {
504:       items: enrichedMessages,
505:       hasMore,
506:       nextCursor
507:     };
508:   }
