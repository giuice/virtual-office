85:   'Phase 4 T5: records read receipts for visible message ids of a conversation the user is a member of; never for 
the user''s own messages; returns the number of new receipts. service_role only.';
86: 
87: revoke all on function public.mark_messages_read(uuid, uuid, uuid[]) from public;
88: revoke all on function public.mark_messages_read(uuid, uuid, uuid[]) from anon, authenticated;
89: grant execute on function public.mark_messages_read(uuid, uuid, uuid[]) to service_role;
90: 
91: -- ============================================================================
92: -- 2) get_unread_counts: unread follows receipts above the historical floor.
93: --    Same signature, return type, and parameter names as 20260610210000, so
94: --    CREATE OR REPLACE keeps the existing ACL. The anti-join uses the unique
95: --    index message_read_receipts_unique_user_message (message_id, user_id).
96: -- ============================================================================
97: create or replace function public.get_unread_counts(p_conversation_ids uuid[])
98: returns table (conversation_id uuid, unread_count bigint)
99: language sql
100: stable
101: security definer
102: set search_path = public, pg_temp
103: as $$
104:   select cm.conversation_id, count(m.id)::bigint
105:   from public.conversation_members cm
106:   left join public.messages m
107:     on m.conversation_id = cm.conversation_id
108:    and m."timestamp" > coalesce(cm.last_read_at, '-infinity'::timestamptz)
109:    and m.sender_id is distinct from cm.user_id
110:    and not exists (
111:      select 1
112:      from public.message_read_receipts r
113:      where r.message_id = m.id
114:        and r.user_id = cm.user_id
115:    )
116:   where cm.user_id = private.current_app_user_id()
117:     and cm.conversation_id = any (p_conversation_ids)
118:   group by cm.conversation_id
119: $$;
