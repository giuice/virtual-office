1: // Invokes App Router route handlers in-process with a REAL local Supabase
2: // session. Only the Next.js request-cookie transport (`next/headers`) is
3: // replaced by this in-memory jar: auth.getUser(), the users.supabase_uid
4: // lookup, membership checks, RPCs, and RLS all run against the local stack.
5: import { createServerClient } from '@supabase/ssr';
6: import { vi } from 'vitest';
7: 
8: import { MESSAGING_DB_PASSWORD } from './fixtures';
9: import { MESSAGING_ANON_KEY, MESSAGING_API_URL, MESSAGING_SERVICE_ROLE_KEY } from './setup';
10: 
11: export interface SessionCookie {
12:   readonly name: string;
13:   readonly value: string;
14: }
15: 
16: const jar: { current: SessionCookie[] } = { current: [] };
17: 
18: /**
19:  * Replacement for `next/headers`. Register it in the test file (vi.mock is
20:  * only reliably hoisted there):
21:  *   vi.mock('next/headers', async () => (await import('./route-session')).nextHeadersMock);
22:  */
23: export const nextHeadersMock = {
24:   cookies: async () => ({
25:     getAll: () => jar.current.map(({ name, value }) => ({ name, value })),
26:     set: () => undefined,
27:   }),
28: };
29: 
30: /** Points the server Supabase clients at the loopback stack (guarded in setup.ts). */
31: export function useLocalSupabaseEnv(): void {
32:   vi.stubEnv('NEXT_PUBLIC_SUPABASE_URL', MESSAGING_API_URL);
33:   vi.stubEnv('NEXT_PUBLIC_SUPABASE_ANON_KEY', MESSAGING_ANON_KEY);
34:   vi.stubEnv('SUPABASE_SERVICE_ROLE_KEY', MESSAGING_SERVICE_ROLE_KEY);
35: }
36: 
37: /** Signs in through @supabase/ssr and returns the auth cookies it wrote. */
38: export async function signInSessionCookies(email: string): Promise<SessionCookie[]> {
39:   const written = new Map<string, string>();
40:   const client = createServerClient(MESSAGING_API_URL, MESSAGING_ANON_KEY, {
41:     cookies: {
42:       getAll: () => [...written].map(([name, value]) => ({ name, value })),
43:       setAll: (cookiesToSet) => {
44:         for (const { name, value } of cookiesToSet) {
45:           if (value) written.set(name, value);
46:           else written.delete(name);
47:         }
48:       },
49:     },
50:   });
51:   const { error } = await client.auth.signInWithPassword({ email, password: MESSAGING_DB_PASSWORD });
52:   if (error) {
53:     throw new Error(`Failed to create SSR session for ${email}: ${error.message}`);
54:   }
55:   if (written.size === 0) {
56:     throw new Error(`No auth cookies were written for ${email}`);
57:   }
58:   return [...written].map(([name, value]) => ({ name, value }));
59: }
60: 
61: /** Runs `fn` with the given session cookies as the incoming request cookies. */
62: export async function asSession<T>(cookies: readonly SessionCookie[], fn: () => Promise<T>): Promise<T> {
63:   const previous = jar.current;
64:   jar.current = [...cookies];
65:   try {
66:     return await fn();
67:   } finally {
68:     jar.current = previous;
69:   }
70: }
