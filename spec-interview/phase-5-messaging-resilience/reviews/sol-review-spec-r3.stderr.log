610:   async deleteById(id: string): Promise<boolean> {
611:     // Consider deleting related reactions/attachments as well (cascade or manual)
612:     const { error, count } = await this.supabaseClient
613:       .from(this.MSG_TABLE_NAME)
614:       .delete({ count: 'exact' })
615:       .eq('id', id);
616: 
617:     if (error) {
618:       console.error('Error deleting message:', error);
619:       return false;
620:     }
621:     // TODO: Delete related reactions/attachments (or rely on DB cascade delete)
622:     return (count ?? 0) > 0;
623:   }
