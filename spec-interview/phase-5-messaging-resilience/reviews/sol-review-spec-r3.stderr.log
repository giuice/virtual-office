17: --
18: -- INSERT: "Users can insert their own read receipts" only bound user_id to the
19: --   caller, so a signed-in user could insert receipts for messages of
20: --   conversations they are not in, for their own messages, or with a forged
21: --   conversation_id. Nothing inserts receipts with a user-scoped client:
22: --   writers are the service_role-only RPCs mark_conversation_read and
23: --   mark_messages_read (SECURITY DEFINER) behind PATCH /api/conversations/read.
24: --   The policy is dropped; with RLS enabled and no INSERT policy, anon and
25: --   authenticated inserts are denied. UPDATE/DELETE already had no policy.
26: --
27: -- Backward compatible with the published app (BR-013):
28: --   * SupabaseMessageRepository.findByConversation (user-scoped client via
29: --     GET /api/messages/get) selects message_id for the loaded page to flip
30: --     the ✓✓ READ status, which message-item.tsx renders only on the
31: --     viewer's OWN messages: receipts on own messages stay visible.
32: --   * Realtime postgres_changes INSERT on message_read_receipts applies these
33: --     SELECT policies per subscriber: the sender still receives receipt events
34: --     for their own messages; other members stop receiving events for
35: --     messages they did not send (their UI shows no status on those).
36: --   * get_unread_counts / mark_* RPCs are SECURITY DEFINER: unaffected.
37: --
38: -- Transactional and re-runnable (drop if exists + create).
39: --
40: -- Rollback (restores the exact pre-T7 policies, including the leaks above):
41: --   begin;
42: --   drop policy if exists "message_read_receipts_select_reader_or_sender" on public.message_read_receipts;
43: --   drop policy if exists "read_receipts_in_own_conversations" on public.message_read_receipts;
44: --   create policy "read_receipts_in_own_conversations" on public.message_read_receipts
45: --     for select using (private.is_conversation_member(message_read_receipts.conversation_id));
46: --   drop policy if exists "Users can view their own read receipts" on public.message_read_receipts;
47: --   create policy "Users can view their own read receipts" on public.message_read_receipts
48: --     for select using (
49: --       ((auth.uid())::text = (select users.supabase_uid from public.users where users.id = 
message_read_receipts.user_id))
50: --       or ((auth.uid())::text = (select u.supabase_uid from public.messages m join public.users u on m.sender_id 
= u.id
51: --                                 where m.id = message_read_receipts.message_id)));
52: --   drop policy if exists "Users can insert their own read receipts" on public.message_read_receipts;
53: --   create policy "Users can insert their own read receipts" on public.message_read_receipts
54: --     for insert with check (
55: --       (auth.uid())::text = (select users.supabase_uid from public.users where users.id = 
message_read_receipts.user_id));
56: --   commit;
57: 
58: begin;
59: 
60: drop policy if exists "read_receipts_in_own_conversations" on public.message_read_receipts;
61: drop policy if exists "Users can view their own read receipts" on public.message_read_receipts;
62: drop policy if exists "Users can insert their own read receipts" on public.message_read_receipts;
63: drop policy if exists "message_read_receipts_select_reader_or_sender" on public.message_read_receipts;
64: 
65: create policy "message_read_receipts_select_reader_or_sender" on public.message_read_receipts
66:   for select
67:   to authenticated
68:   using (
69:     message_read_receipts.user_id = (select private.current_app_user_id())
70:     or exists (
71:       select 1
72:       from public.messages as m
73:       where m.id = message_read_receipts.message_id
74:         and m.sender_id = (select private.current_app_user_id())
75:     )
76:   );
