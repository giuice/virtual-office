2: 'use client';
3: 
4: import { createContext, useCallback, use, useEffect, useMemo, useState } from 'react';
5: import { supabase } from '@/lib/supabase/client';
6: import { AuthContextType } from '@/types/auth';
7: import { useSession } from '@/hooks/useSession';
8: import { mapSupabaseAuthError } from '@/lib/auth/error-messages';
9: import { fencePresenceLogout } from '@/lib/presence/logout-client';
10: import { useQueryClient } from '@tanstack/react-query';
11: import { presenceQueryKeys } from '@/lib/presence/query-keys';
12: import {
13:   invalidatePresenceClientLifecycle,
14:   subscribeToPresenceClientInvalidation,
15: } from '@/lib/presence/client-lifecycle';
16: import { clearAllPresenceStorage } from '@/lib/presence/storage-keys';
17: 
18: function clearPresenceStorage(): void {
19:   try {
20:     if (typeof window === 'undefined') return;
21:     const storage = window.localStorage;
22:     if (!storage) return;
23:     clearAllPresenceStorage(storage);
24:   } catch {
25:     // Storage is advisory. Browser privacy modes must never block local auth sign-out.
26:   }
27: }
28: 
29: function toError(value: unknown): Error {
30:   return value instanceof Error ? value : new Error(String(value));
31: }
32: 
33: function combineSignOutErrors(
34:   presenceError: unknown,
35:   localSignOutError: unknown,
36:   cleanupErrors: readonly unknown[],
37: ): Error | null {
38:   const localError = localSignOutError ? toError(localSignOutError) : null;
39:   const serverError = presenceError ? toError(presenceError) : null;
40:   const normalizedCleanupErrors = cleanupErrors.map(toError);
41: 
42:   if (localError && serverError) {
43:     return new AggregateError(
44:       [localError, serverError, ...normalizedCleanupErrors],
45:       `Local authentication sign-out failed: ${localError.message}. Presence logout also failed: 
${serverError.message}`,
46:     );
47:   }
48: 
49:   if (localError) {
50:     return normalizedCleanupErrors.length > 0
51:       ? new AggregateError(
52:           [localError, ...normalizedCleanupErrors],
53:           `Local authentication sign-out failed: ${localError.message}`,
54:         )
55:       : localError;
56:   }
57: 
58:   if (serverError) {
59:     return normalizedCleanupErrors.length > 0
60:       ? new AggregateError(
61:           [serverError, ...normalizedCleanupErrors],
62:           `Presence logout failed: ${serverError.message}`,
63:         )
64:       : serverError;
65:   }
66: 
67:   if (normalizedCleanupErrors.length === 1) return normalizedCleanupErrors[0];
68:   if (normalizedCleanupErrors.length > 1) {
69:     return new AggregateError(normalizedCleanupErrors, 'Presence client cleanup failed');
70:   }
71: 
72:   return null;
73: }
74: 
75: const AuthContext = createContext<AuthContextType | undefined>(undefined);
76: 
77: export function AuthProvider({ children }: { children: React.ReactNode }) { const { user, session, loading: 
sessionLoading, error: sessionError, initialized } = useSession();
78:   const queryClient = useQueryClient();
79: 
80:   const [actionLoading, setActionLoading] = useState(false);
81:   const [actionError, setActionError] = useState<string | null>(null);
82:   const isAuthReady = initialized && !sessionLoading && !actionLoading;
83: 
84:   const supabaseClient = useMemo(() => supabase, []);
85: 
86:   useEffect(
87:     () =>
88:       subscribeToPresenceClientInvalidation((invalidation) => {
89:         if (invalidation.reason !== 'auth-session-revoked') return;
90: 
91:         void (async () => {
92:           try {
93:             queryClient.removeQueries({ queryKey: presenceQueryKeys.all });
94:           } catch {
95:             console.warn('Presence query cleanup failed after Auth-session revocation');
96:           }
97:           clearPresenceStorage();
98: 
99:           try {
100:             const { error } = await supabaseClient.auth.signOut({ scope: 'local' });
101:             if (error) {
102:               console.warn('Local Auth sign-out failed after Presence session revocation');
103:             }
104:           } catch {
105:             console.warn('Local Auth sign-out failed after Presence session revocation');
106:           }
107:         })();
108:       }),
109:     [queryClient, supabaseClient],
110:   );
111: 
112:   const signIn = useCallback(async (email: string, password: string) => {
113:     setActionLoading(true);
114:     setActionError(null);
115:     try {
116:       const { error } = await supabaseClient.auth.signInWithPassword({ email, password });
117:       if (error) throw error;
118:     } catch (error: unknown) {
119:       console.error('Sign in error:', error);
120:       const friendlyMessage = mapSupabaseAuthError(error);
121:       setActionError(friendlyMessage);
122:       throw new Error(friendlyMessage);
123:     } finally {
124:       setActionLoading(false);
125:     }
126:   }, [supabaseClient]);
127: 
128:   const signUp = useCallback(async (email: string, password: string, displayName?: string): Promise<void> => {
129:     setActionLoading(true);
130:     setActionError(null);
131:     try {
132:       const { error } = await supabaseClient.auth.signUp({
133:         email,
134:         password,
135:         options: {
136:           data: { displayName: displayName || email.split('@')[0] },
137:         },
138:       });
139:       if (error) throw error;
140: 
141:     } catch (error: unknown) {
142:       console.error('Sign up error:', error);
143:       const friendlyMessage = mapSupabaseAuthError(error);
144:       setActionError(friendlyMessage);
145:       throw new Error(friendlyMessage);
146:     } finally {
147:       setActionLoading(false);
148:     }
149:   }, [supabaseClient]);
150: 
151:   const signInWithGoogle = useCallback(async (nextPath?: string): Promise<void> => {
152:     setActionLoading(true);
153:     setActionError(null);
154:     try {
155:       const safeNextPath = nextPath && nextPath.startsWith('/') && !nextPath.startsWith('//') ? nextPath : 
undefined;
156:       const callbackUrl = safeNextPath
157:         ? `${window.location.origin}/api/auth/callback?next=${encodeURIComponent(safeNextPath)}`
158:         : `${window.location.origin}/api/auth/callback`;
159: 
160:       const { error } = await supabaseClient.auth.signInWithOAuth({
161:         provider: 'google',
162:         options: {
163:           redirectTo: callbackUrl,
164:           queryParams: {
165:             access_type: 'offline',
166:             prompt: 'consent',
167:           },
168:         },
169:       });
170:       if (error) throw error;
171:     } catch (error: unknown) {
172:       console.error('Google sign in error:', error);
173:       const friendlyMessage = mapSupabaseAuthError(error);
174:       setActionError(friendlyMessage);
175:       throw new Error(friendlyMessage);
176:     } finally {
177:       setActionLoading(false);
178:     }
179:   }, [supabaseClient]);
180: 
181:   const signOut = useCallback(async () => { setActionLoading(true);
182:     setActionError(null);
183:     let presenceError: unknown = null;
184:     let localSignOutError: unknown = null;
185:     const cleanupErrors: unknown[] = [];
186:     let cleanupAttempted = false;
187:     const cleanPresenceClient = (): void => {
188:       if (cleanupAttempted) return;
189:       cleanupAttempted = true;
190:       try {
191:         invalidatePresenceClientLifecycle({ reason: 'logout' });
192:       } catch (error) {
193:         cleanupErrors.push(error);
194:       }
195:       try {
196:         queryClient.removeQueries({ queryKey: presenceQueryKeys.all });
197:       } catch (error) {
198:         cleanupErrors.push(error);
199:       }
200:       clearPresenceStorage();
201:     };
202:     try {
203:       if (user) {
204:         try {
205:           await fencePresenceLogout();
206:         } catch (error) {
207:           presenceError = error;
208:         }
209:       }
210: 
211:       // Clear the old tenant generation before Supabase emits SIGNED_OUT and
212:       // consumers can begin rendering the next identity.
213:       cleanPresenceClient();
214: 
215:       try {
216:         const { error } = await supabaseClient.auth.signOut({ scope: 'local' });
217:         localSignOutError = error;
218:       } catch (error) {
219:         localSignOutError = error;
220:       }
221:     } finally {
222:       cleanPresenceClient();
223:       setActionLoading(false);
224:     }
225: 
226:     const signOutError = combineSignOutErrors(
227:       presenceError,
228:       localSignOutError,
229:       cleanupErrors,
230:     );
231:     if (signOutError) {
232:       console.error('Sign out error:', signOutError);
233:       const friendlyMessage = mapSupabaseAuthError(signOutError);
234:       setActionError(friendlyMessage);
235:       throw new Error(friendlyMessage, { cause: signOutError });
236:     }
237:   }, [queryClient, supabaseClient, user]);
238: 
239:   const value: AuthContextType = useMemo(
240:     () => ({ session, user, loading: sessionLoading, error: sessionError, isAuthReady, signIn, signOut, signUp, 
signInWithGoogle, actionLoading, actionError }),
241:     [
242:       actionError,
243:       actionLoading,
244:       isAuthReady,
245:       session,
246:       sessionError,
247:       sessionLoading,
248:       signIn,
249:       signInWithGoogle,
250:       signOut,
251:       signUp,
252:       user,
253:     ],
254:   );
255: 
256:   return <AuthContext.Provider value={value}>{children}</AuthContext.Provider>;
257: }
258: 
259: export function useAuth() { const context = use(AuthContext);
260:   if (context === undefined) {
261:     throw new Error('useAuth must be used within an AuthProvider'); }
262:   return context;
263: }
