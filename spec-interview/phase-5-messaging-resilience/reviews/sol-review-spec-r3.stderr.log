859: 
860:   /**
861:    * Phase 4 FR-021 / BR-009: the caller's starred messages in one
862:    * conversation, newest MESSAGE first (not star time), keyset-paginated by
863:    * the feed's composite "{raw_pg_timestamp}|{id}" cursor (`cursorBefore`
864:    * continues with older messages). Items come back newest-first with full
865:    * feed enrichment. The caller must authorize conversation membership
866:    * first; with the user-scoped client, message RLS (member-only) and star
867:    * RLS (own stars only) also apply.
868:    */
869:   async getStarredMessages(
870:     userId: string,
871:     conversationId: string,
872:     options?: Pick<PaginationOptions, 'limit' | 'cursorBefore'>
873:   ): Promise<PaginatedResult<Message>> {
874:     const limit = options?.limit ?? 20;
875: 
876:     // Driven from the caller's star rows (bounded by how many they starred),
877:     // with the starred message as an inner to-one embed: filters, ordering
878:     // and the keyset cursor apply to the MESSAGE columns, so the cursor is
879:     // the feed's. Driving from messages instead would scan (and evaluate
880:     // message RLS on) the whole conversation when stars are sparse.
881:     // messages.conversation_id is authoritative; the denormalized
882:     // starred_messages.conversation_id only narrows the star scan.
883:     let query = this.supabaseClient
884:       .from(this.MESSAGE_STAR_TABLE_NAME)
885:       .select('message:messages!message_stars_message_id_fkey!inner(*)')
886:       .eq('user_id', userId)
887:       .eq('conversation_id', conversationId)
888:       .eq('message.conversation_id', conversationId);
889: 
890:     if (options?.cursorBefore) {
891:       const { ts, id } = parseCompositeCursor(options.cursorBefore);
892:       query = id
893:         ? query.or(`timestamp.lt."${ts}",and(timestamp.eq."${ts}",id.lt."${id}")`, { referencedTable: 'message' })
894:         : query.lt('message.timestamp', ts);
895:     }
896: 
897:     const { data, error } = await query
898:       .order('message(timestamp)', { ascending: false })
899:       .order('message(id)', { ascending: false })
900:       .limit(limit + 1);
901: 
902:     if (error) {
903:       console.error('Error fetching starred messages:', error);
904:       throw error;
905:     }
906: 
907:     const rows = ((data ?? []) as unknown as Array<{ message: MessageRow }>).map((row) => row.message);
908:     const hasMore = rows.length > limit;
909:     const pageRows = hasMore ? rows.slice(0, limit) : rows;
910:     const items = await this.enrichFeedMessages(mapMessageArrayToCamelCase(pageRows), conversationId);
911:     // Personal stars only, even if a privileged client is ever passed in.
912:     items.forEach(message => {
913:       message.stars = (message.stars ?? []).filter(star => star.userId === userId);
914:     });
915: 
916:     return {
917:       items,
918:       hasMore,
919:       // RAW row timestamp keeps microsecond precision (see findByConversation).
920:       nextCursor: hasMore ? buildCompositeCursor(pageRows[pageRows.length - 1]) : null,
921:     };
922:   }
923: }
