112: /**
113:  * Holds every create of this tab: optionally before it reaches the server
114:  * (`holdRequest`), and always after the real server answered, until
115:  * `release()` hands the real response to the page. Nothing is mocked.
116:  */
117: async function holdCreates(page: Page, { holdRequest = false }: { holdRequest?: boolean } = {}): 
Promise<CreateHold> {
118:   const held: HeldCreate[] = [];
119:   const waiters: Array<(entry: HeldCreate) => void> = [];
120:   let handedOut = 0;
121:   await page.route('**/api/messages/create', async (route: Route) => {
122:     const requestGate = deferred();
123:     const releaseGate = deferred();
124:     const fetched = deferred();
125:     const fulfilled = deferred();
126:     const entry: HeldCreate = {
127:       request: (route.request().postDataJSON() ?? {}) as Record<string, unknown>,
128:       capturedAt: Date.now(),
129:       letRequestThrough: requestGate.resolve,
130:       release: releaseGate.resolve,
131:       fetched: fetched.promise,
132:       fulfilled: fulfilled.promise,
133:     };
134:     held.push(entry);
135:     waiters.shift()?.(entry);
136:     if (!holdRequest) requestGate.resolve();
137:     await requestGate.promise;
138:     const response = await route.fetch();
139:     entry.status = response.status();
140:     entry.body = (await response.json().catch(() => ({}))) as CreateResponseBody;
141:     entry.fetchedAt = Date.now();
142:     fetched.resolve();
143:     await releaseGate.promise;
144:     entry.releasedAt = Date.now();
145:     await route.fulfill({ response });
146:     fulfilled.resolve();
147:   });
148:   return {
149:     next: () => {
150:       const index = handedOut;
151:       handedOut += 1;
152:       if (held[index]) return Promise.resolve(held[index]);
153:       return new Promise<HeldCreate>((resolve) => waiters.push(resolve));
154:     },
155:     all: () => [...held],
156:   };
157: }
