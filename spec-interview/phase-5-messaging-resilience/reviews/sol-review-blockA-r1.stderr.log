248: /**
249:  * T12 (FR-013, BR-008): removes every item of the owner ("Sair mesmo").
250:  * Strict durability: a deleted item must never come back after a crash and be
251:  * sent when the owner signs in again. Resolves with the number of items removed.
252:  */
253: export function deleteAllOutboxItems(ownerId: string): Promise<number> {
254:   return inTransaction<number>('readwrite', ({ items }, done) => {
255:     const range = IDBKeyRange.bound([ownerId, -Infinity], [ownerId, Infinity]);
256:     const request = items.index(BY_OWNER_ORDER).getAllKeys(range);
257:     request.onsuccess = () => {
258:       const keys = request.result;
259:       for (const key of keys) items.delete(key);
260:       done(keys.length);
261:     };
262:   });
263: }
