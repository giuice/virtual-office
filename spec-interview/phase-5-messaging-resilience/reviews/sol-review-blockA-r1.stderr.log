196:     // AC-001: pending with a text label, composer empty, in the outbox, nothing sent.
197:     await expect.poll(async () => (await readOutbox(a.page)).length).toBe(3);
198:     const queued = await readOutbox(a.page);
199:     expect(queued.map((item) => item.content)).toEqual(texts);
200:     expect(queued.map((item) => item.replyToId)).toEqual([null, parentId, null]);
201:     for (const item of queued) {
202:       expect(item).toMatchObject({ ownerId: a.user.userId, conversationId: directId, state: 'waiting', 
attemptGeneration: 0 });
203:       await expectPendingLabel(a.page, item.clientMessageId, 'pending', 'pendente');
204:     }
