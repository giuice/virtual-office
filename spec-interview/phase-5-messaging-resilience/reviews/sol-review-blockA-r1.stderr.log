2: // Phase 5 T8: renders outbox items through the sender's pending store
3: // (['messages-pending', users.id, conversationId], T7) — the outbox is the
4: // durable source, the pending query only its render view.
5: import type { QueryClient } from '@tanstack/react-query';
6: 
7: import { MessageStatus, MessageType, type Message, type MessageDeliveryState } from '@/types/messaging';
8: import type { OutboxItem } from '@/types/message-outbox';
9: import {
10:   appendMessageToPages,
11:   isMessageDeleted,
12:   isPendingMessage,
13:   keepMessageThroughInflightFetch,
14:   normalizeClientMessageId,
15:   pendingMessagesQueryKey,
16:   PENDING_MESSAGE_ID_PREFIX,
17:   type MessagesInfiniteData,
18: } from '@/lib/messaging/message-cache';
19: 
20: const deliveryStateOf = (item: OutboxItem): MessageDeliveryState => {
21:   switch (item.state) {
22:     case 'waiting':
23:       return 'pending';
24:     case 'failed':
25:       return 'failed';
26:     case 'expired':
27:       return 'expired';
28:     default:
29:       // claimed / unknown: an attempt is (or may still be) in progress (FR-005).
30:       return 'sending';
31:   }
32: };
33: 
34: export function outboxItemToPendingMessage(item: OutboxItem): Message {
35:   const deliveryState = deliveryStateOf(item);
36:   return {
37:     id: `${PENDING_MESSAGE_ID_PREFIX}${item.clientMessageId}`,
38:     conversationId: item.conversationId,
39:     senderId: item.ownerId,
40:     content: item.content,
41:     timestamp: new Date(item.pressedSendAt),
42:     type: MessageType.TEXT,
43:     status: deliveryState === 'failed' || deliveryState === 'expired' ? MessageStatus.FAILED : 
MessageStatus.SENDING,
44:     replyToId: item.replyToId ?? undefined,
45:     reactions: [],
46:     isEdited: false,
47:     clientMessageId: item.clientMessageId,
48:     deliveryState,
49:     cancellable: item.state === 'waiting' && item.attemptGeneration === 0,
50:   };
51: }
52: 
53: /**
54:  * Replaces the outbox copies of a conversation's pending view with `items`
55:  * (in creation order), keeping the pending copies that are not outbox items
56:  * (attachment/voice sends, which are never queued).
57:  */
58: export function writeOutboxView(
59:   queryClient: QueryClient,
60:   ownerId: string,
61:   conversationId: string,
62:   items: readonly OutboxItem[]
63: ): void {
64:   const outboxCopies = [...items].sort((a, b) => a.order - b.order).map(outboxItemToPendingMessage);
65:   const outboxKeys = new Set(outboxCopies.map((message) => message.clientMessageId));
66:   queryClient.setQueryData<Message[]>(pendingMessagesQueryKey(ownerId, conversationId), (current) => {
67:     const others = (current ?? []).filter(
68:       (message) =>
69:         message.deliveryState === undefined && !outboxKeys.has(normalizeClientMessageId(message.clientMessageId) 
?? '')
70:     );
71:     if (others.length === 0) return outboxCopies;
72:     return [...others, ...outboxCopies].sort((a, b) => a.timestamp.getTime() - b.timestamp.getTime());
73:   });
74: }
75: 
76: /**
77:  * T12 (FR-013): empties every pending view of the owner (all conversations),
78:  * for "Sair mesmo". The queries stay (their observers keep working) but hold
79:  * no copy.
80:  */
81: export function clearOutboxViews(queryClient: QueryClient, ownerId: string): void {
82:   queryClient.setQueriesData<Message[]>({ queryKey: ['messages-pending', ownerId] }, []);
83: }
84: 
85: /**
86:  * Shows one just-committed item in its conversation's pending view (added, or
87:  * replacing its earlier copy), without reading the outbox again.
88:  */
89: export function publishOutboxItem(queryClient: QueryClient, item: OutboxItem): void {
90:   const copy = outboxItemToPendingMessage(item);
91:   queryClient.setQueryData<Message[]>(pendingMessagesQueryKey(item.ownerId, item.conversationId), (current) =>
92:     [
93:       ...(current ?? []).filter(
94:         (message) => normalizeClientMessageId(message.clientMessageId) !== item.clientMessageId
95:       ),
96:       copy,
97:     ].sort((a, b) => a.timestamp.getTime() - b.timestamp.getTime())
98:   );
99: }
100: 
101: /**
102:  * The server confirmed the item (`message` stored or replayed; null when it
103:  * was deleted since). As for a direct send (useMessages.sendMessage): unless
104:  * the feed already observed the key or this client saw the message deleted,
105:  * merge the stored message into a loaded (or loading) feed first, then drop
106:  * the pending copy — never two bubbles, never none.
107:  */
108: export function showConfirmedOutboxMessage(
109:   queryClient: QueryClient,
110:   ownerId: string,
111:   conversationId: string,
112:   clientMessageId: string,
113:   message: Message | null
114: ): void {
115:   const pendingKey = pendingMessagesQueryKey(ownerId, conversationId);
116:   const feedKey = ['messages', conversationId] as const;
117:   const unresolved = isPendingMessage(queryClient.getQueryData<Message[]>(pendingKey), clientMessageId);
118:   const feed = queryClient.getQueryCache().find<MessagesInfiniteData>({ queryKey: feedKey, exact: true });
119:   // A feed never loaded is fetched (with this message) when it is opened; a
120:   // cache built from this one message would hide the older history.
121:   const feedPresent = Boolean(feed?.state.data) || feed?.state.fetchStatus === 'fetching';
122:   if (message && unresolved && feedPresent && !isMessageDeleted(queryClient, message.id)) {
123:     const confirmed: Message = {
124:       ...message,
125:       clientMessageId: normalizeClientMessageId(message.clientMessageId) ?? clientMessageId,
126:     };
127:     queryClient.setQueryData<MessagesInfiniteData | undefined>(feedKey, (oldData) =>
128:       appendMessageToPages(oldData, confirmed)
129:     );
130:     keepMessageThroughInflightFetch(queryClient, conversationId, confirmed);
131:   }
132:   queryClient.setQueryData<Message[]>(pendingKey, (current) =>
133:     (current ?? []).filter((pending) => normalizeClientMessageId(pending.clientMessageId) !== clientMessageId)
134:   );
135: }

