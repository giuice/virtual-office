232: /**
233:  * Removes a confirmed item. Relaxed durability: if the removal were lost (OS
234:  * crash), the item would only be sent again under a newer generation and
235:  * resolved as the already stored message.
236:  */
237: export function deleteOutboxItem(ownerId: string, clientMessageId: string): Promise<void> {
238:   return inTransaction<void>(
239:     'readwrite',
240:     ({ items }, done) => {
241:       items.delete([ownerId, clientMessageId]);
242:       done(undefined);
243:     },
244:     'relaxed'
245:   );
246: }
