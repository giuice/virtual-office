46: export function classifyFenceResponse(
47:   response: { status: number; code?: string; outcome?: string; message?: unknown },
48:   item: AttemptedItem
49: ): OutboxFenceOutcome {
50:   const { status, code, outcome, message } = response;
51:   if (status === 200 && outcome === 'not_stored') return { kind: 'not_stored' };
52:   if (status === 200 && outcome === 'stored') {
53:     if (message === null) return { kind: 'delivered', message: null };
54:     const stored = parseStoredMessage(message, item);
55:     return stored ? { kind: 'delivered', message: stored } : { kind: 'unknown', status };
56:   }
57:   if (status >= 400 && status < 500 && status !== 401 && status !== 429 && status !== 409) {
58:     return { kind: 'failed', status, reason: failureReason(status, code) };
59:   }
60:   return { kind: 'unknown', status };
61: }
62: 
63: export function classifyAttemptResponse(
64:   response: { status: number; code?: string; message?: unknown },
65:   item: AttemptedItem
66: ): OutboxAttemptOutcome {
67:   const { status, code, message } = response;
68:   if (status >= 200 && status < 300) {
69:     // Only 200/201 carrying this item's stored message (outbox-ack) confirm it.
70:     const stored = status === 200 || status === 201 ? parseStoredMessage(message, item) : null;
71:     return stored ? { kind: 'delivered', message: stored } : { kind: 'unknown', status };
72:   }
73:   if (status === 410 && code === 'MESSAGE_DELETED') return { kind: 'delivered', message: null };
74:   if (status === 429 || status === 401) return { kind: 'transient', status };
75:   if (status >= 500 || status < 200 || (status >= 300 && status < 400)) return { kind: 'unknown', status };
76:   if (status === 409 && code === 'ATTEMPT_SUPERSEDED') return { kind: 'superseded' };
77:   return { kind: 'failed', status, reason: failureReason(status, code) };
78: }
