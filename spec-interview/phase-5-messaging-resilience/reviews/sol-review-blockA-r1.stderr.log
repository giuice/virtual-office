63: const LINK_FAILURE_CODES: readonly AttachmentLinkFailureCode[] = [
64:   'ATTACHMENT_UPLOAD_NOT_FOUND',
65:   'ATTACHMENT_COUNT_INVALID',
66:   'ATTACHMENT_DUPLICATE',
67:   'INVALID_REPLY_TARGET',
