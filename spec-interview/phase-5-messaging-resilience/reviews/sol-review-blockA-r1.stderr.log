189: /**
190:  * Reads the item and replaces it with `change(item)` in one transaction
191:  * (`null` deletes it; `undefined` leaves it). Resolves with the stored result
192:  * (`null` when the item is missing or was deleted). A result with another
193:  * `clientMessageId` replaces the item under that new key (T9: the
194:  * CLIENT_MESSAGE_ID_REUSED retry); the new key must not exist yet. Relaxed
195:  * durability, see claimOldestOutboxItem, unless `strict` is asked (a cancel
196:  * must survive an OS crash: a cancelled item is never dispatched, T10).
197:  */
198: export function updateOutboxItem(
199:   ownerId: string,
200:   clientMessageId: string,
201:   change: (item: OutboxItem) => OutboxItem | null | undefined,
202:   durability: 'strict' | 'relaxed' = 'relaxed'
203: ): Promise<OutboxItem | null> {
204:   return inTransaction<OutboxItem | null>('readwrite', ({ items }, done) => {
205:     const request = items.get([ownerId, clientMessageId]);
206:     request.onsuccess = () => {
207:       const item = request.result as OutboxItem | undefined;
208:       if (!item) {
209:         done(null);
210:         return;
211:       }
212:       const next = change(item);
213:       if (next === undefined) {
214:         done(item);
215:       } else if (next === null) {
216:         items.delete([ownerId, clientMessageId]);
217:         done(null);
218:       } else if (next.ownerId !== ownerId) {
219:         throw new Error('An outbox item cannot change owner');
220:       } else if (next.clientMessageId !== clientMessageId) {
221:         items.delete([ownerId, clientMessageId]);
222:         items.add(next);
223:         done(next);
224:       } else {
225:         items.put(next);
226:         done(next);
227:       }
228:     };
229:   }, durability);
230: }
