303:   test('AC-006: cancel in tab 2 removes a never-dispatched item in both tabs; racing a claim, exactly one wins', 
async ({
304:     phase5World,
305:     openDevice,
306:   }, testInfo) => {
307:     const { a, b, tab1, tab2, directId } = await twoTabs(phase5World, openDevice);
308:     const calls = trackApi([['tab1', tab1], ['tab2', tab2]]);
309:     await goOffline(tab1);
310: 
311:     // Without a race: the cancel wins, in both tabs, and nothing is ever sent.
312:     const cancelledText = `t10 cancelled ${randomUUID()}`;
313:     const [cancelled] = await queueOffline(a, directId, [cancelledText]);
314:     await expect(cancelButton(tab2, cancelled.clientMessageId)).toBeVisible({ timeout: STEP_TIMEOUT_MS });
315:     await cancelButton(tab2, cancelled.clientMessageId).click();
316:     for (const tab of [tab1, tab2]) {
