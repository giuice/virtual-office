364:     await expect.poll(async () => (await readOutbox(a.page)).length).toBe(0);
365:     expect(creates.map((attempt) => [attempt.body.clientMessageId, attempt.body.attemptGeneration])).toEqual([
366:       [item.clientMessageId, 1],
367:     ]);
368:     await b.page.waitForTimeout(1_500);
369:     expect((await readArrivals(b.page)).max[text]).toBe(1);
370:     expect(await storedWithTexts(directId, [text])).toHaveLength(1);
371:   });
