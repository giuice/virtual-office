1: // src/lib/messaging/message-attempts.ts
2: // Phase 5 T2 (FR-006, FR-011, FR-024, FR-034, BR-005) and T4 (mention ids):
3: // request parsing and replay comparison shared by POST /api/messages/create and
4: // POST /api/messages/fence. The database enforces attempt fencing
5: // (public.fence_message_attempt / public.create_message_attempt); this module
6: // only validates input and normalizes compositions.
7: import type { NextResponse } from 'next/server';
8: import { jsonError } from '@/lib/api/server-error';
9: import type { ApiErrorBody } from '@/lib/api/error-contract';
10: 
11: const UUID_PATTERN = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
12: 
13: export function isUuid(value: unknown): value is string {
14:   return typeof value === 'string' && UUID_PATTERN.test(value);
15: }
16: 
17: type FieldResult<T> = { ok: true; value: T } | { ok: false; response: NextResponse<ApiErrorBody> };
18: 
19: /**
20:  * Optional attempt generation: a positive safe integer. Absent → undefined
21:  * (Phase 4 client). It is only meaningful together with a clientMessageId.
22:  */
23: export function parseAttemptGeneration(value: unknown, hasClientKey: boolean): FieldResult<number | undefined> {
24:   if (value === undefined || value === null) {
25:     return { ok: true, value: undefined };
26:   }
27:   if (typeof value !== 'number' || !Number.isSafeInteger(value) || value < 1) {
28:     return {
29:       ok: false,
30:       response: jsonError(400, 'INVALID_ATTEMPT_GENERATION', 'attemptGeneration must be a positive integer'),
31:     };
32:   }
33:   if (!hasClientKey) {
34:     return {
35:       ok: false,
36:       response: jsonError(400, 'INVALID_ATTEMPT_GENERATION', 'attemptGeneration requires clientMessageId'),
37:     };
38:   }
39:   return { ok: true, value };
40: }
41: 
42: /**
43:  * Optional expected sender (users.id of the outbox item's owner, FR-011).
44:  * Required whenever an attempt generation is sent: every Phase 5 dispatch
45:  * carries both.
46:  */
47: export function parseExpectedSenderId(value: unknown, required: boolean): FieldResult<string | undefined> {
48:   if (value === undefined || value === null) {
49:     if (required) {
50:       return {
51:         ok: false,
52:         response: jsonError(400, 'INVALID_EXPECTED_SENDER', 'expectedSenderId is required with attemptGeneration'),
53:       };
54:     }
55:     return { ok: true, value: undefined };
56:   }
57:   if (!isUuid(value)) {
58:     return { ok: false, response: jsonError(400, 'INVALID_EXPECTED_SENDER', 'expectedSenderId must be a UUID') };
59:   }
60:   return { ok: true, value: value.toLowerCase() };
61: }
62: 
63: /**
64:  * Phase 5 T4 (FR-024): most mention ids one message may request (the database
65:  * enforces the same bound on the stored composition).
66:  */
67: export const MAX_MENTIONS_PER_MESSAGE = 50;
68: 
69: /**
70:  * Optional requested mention ids (users.id of the mentioned users): an array
71:  * of at most MAX_MENTIONS_PER_MESSAGE UUIDs, only together with a
72:  * clientMessageId (mentions travel in the stored original composition).
73:  * Absent → none. Returned lowercase, distinct and sorted. Which of them become
74:  * mentions (current members other than the sender) is decided by the
75:  * database at first creation.
76:  */
77: export function parseMentionIds(value: unknown, hasClientKey: boolean): FieldResult<string[]> {
78:   if (value === undefined || value === null) {
79:     return { ok: true, value: [] };
80:   }
81:   if (!Array.isArray(value) || value.length > MAX_MENTIONS_PER_MESSAGE || value.some((id) => !isUuid(id))) {
82:     return {
83:       ok: false,
84:       response: jsonError(
85:         400,
86:         'INVALID_MENTION_IDS',
87:         `mentionIds must be an array of at most ${MAX_MENTIONS_PER_MESSAGE} user ids`
88:       ),
89:     };
90:   }
91:   if (!hasClientKey) {
92:     return {
93:       ok: false,
94:       response: jsonError(400, 'INVALID_MENTION_IDS', 'mentionIds requires clientMessageId'),
95:     };
96:   }
97:   return { ok: true, value: [...new Set((value as string[]).map((id) => id.toLowerCase()))].sort() };
98: }
99: 
100: /**
101:  * Phase 5 T2: the message stored under this key was deleted since. The key's
102:  * item was delivered; nothing was stored and it must not be resent.
103:  */
104: export function messageDeletedResponse(): NextResponse<ApiErrorBody> {
105:   return jsonError(410, 'MESSAGE_DELETED', 'The message sent with this clientMessageId was deleted');
106: }
107: 
108: /** BR-005: a newer attempt of the same key exists; clients ignore this outcome. */
109: export function attemptSupersededResponse(): NextResponse<ApiErrorBody> {
110:   return jsonError(409, 'ATTEMPT_SUPERSEDED', 'A newer attempt of this clientMessageId exists');
111: }
