443:     const title =
444:       held === 'create'
445:         ? "AC-041/AC-045(b): a hung tab's held create — tab 2 waits for the lease, fences, sends once; the held 
create is rejected as stale"
446:         : "AC-045(c): a hung tab's held fence — tab 2 takes over after the lease and commits; the stale fence is 
rejected";
447:     test(title, async ({ phase5World, openDevice }) => {
448:       const { b, tab1, tab2, directId } = await twoTabs(phase5World, openDevice);
449:       const text = `t10 hung ${held} ${randomUUID()}`;
450:       await watchArrivals(b.page, [text]);
451:       const calls = trackApi([['tab1', tab1], ['tab2', tab2]]);
452: 
453:       if (held === 'fence') {
454:         // The first create fails in transit (unknown), so the next attempt starts with a fence.
455:         let creates = 0;
456:         await tab1.context().route('**/api/messages/create', async (route: Route) => {
457:           creates += 1;
458:           if (creates === 1) await route.abort('failed');
459:           else await route.continue();
460:         });
461:       }
462:       let heldRoute: Route | null = null;
463:       let holder: Page | null = null;
464:       await tab1.context().route(`**/api/messages/${held}`, async (route: Route) => {
465:         if (heldRoute) {
466:           await route.fallback();
467:           return;
468:         }
469:         heldRoute = route;
470:         holder = route.request().frame().page();
471:         // Held in the browser: it has not reached the server.
472:       });
473: 
474:       await sendFromComposer(tab1, text);
475:       await expect.poll(() => heldRoute !== null, { timeout: STEP_TIMEOUT_MS }).toBe(true);
476:       const holderTab = holder as unknown as Page;
477:       const takerTab = holderTab === tab1 ? tab2 : tab1;
478:       const takerLabel = takerTab === tab1 ? 'tab1' : 'tab2';
479:       const heldGeneration = held === 'create' ? 1 : 2;
480:       let key = '';
481:       const unfreeze = await freeze(holderTab);
482:       try {
483:         const [item] = await readOutbox(takerTab);
484:         expect(item).toMatchObject({ content: text, state: 'claimed', attemptGeneration: heldGeneration });
485:         const leaseEnd = item.leaseExpiresAt as number;
486:         expect(leaseEnd, 'the claim carries a live lease').toBeGreaterThan(Date.now());
487:         key = item.clientMessageId;
488:         const takeover = () => calls.filter((call) => call.key === key && call.generation > heldGeneration);
489: 
490:         // The holder hangs: no tab sends anything before the lease ends; then the other tab fences and sends 
once.
491:         await expect
492:           .poll(() => takeover().length, { timeout: LEASE_MS + STEP_TIMEOUT_MS, intervals: [250] })
493:           .toBeGreaterThanOrEqual(1);
494:         expect(takeover()[0].startedAt, `no takeover before the lease ends ${JSON.stringify(summary(calls, 
key))}`).toBeGreaterThanOrEqual(leaseEnd);
495:         await expect.poll(async () => (await storedWithTexts(directId, [text])).length, { timeout: 
STEP_TIMEOUT_MS }).toBe(1);
496:         await expect
497:           .poll(() => summary(takeover(), key))
498:           .toEqual([
499:             [takerLabel, 'fence', heldGeneration + 1, 200, 'not_stored'],
500:             [takerLabel, 'create', heldGeneration + 1, 201, null],
501:           ]);
502: 
503:         // The held request reaches the server only now: it is rejected as stale.
504:         const late = await releaseLate(heldRoute as unknown as Route);
505:         expect(late).toEqual({ status: 409, code: 'ATTEMPT_SUPERSEDED' });
506:         const stored = await storedWithTexts(directId, [text]);
507:         expect(stored).toHaveLength(1);
508:         expect(stored[0].key).toBe(key);
509:         await expect(b.page.getByTestId(`message-${stored[0].id}`)).toBeVisible({ timeout: STEP_TIMEOUT_MS });
510:       } finally {
511:         await unfreeze();
512:       }
513:       // The resumed tab sends nothing more for the key; both tabs show the message once.
514:       await holderTab.waitForTimeout(2_000);
515:       const stored = await storedWithTexts(directId, [text]);
516:       expect(stored).toHaveLength(1);
517:       // Only the held generation's requests (create 1; or create 1 + fence 2), then the takeover's two.
518:       expect(calls.filter((call) => call.key === key && call.generation <= 
heldGeneration)).toHaveLength(heldGeneration);
519:       expect(calls.filter((call) => call.key === key)).toHaveLength(heldGeneration + 2);
520:       for (const tab of [tab1, tab2]) {
521:         await expect(tab.getByTestId(`message-${stored[0].id}`)).toBeVisible({ timeout: STEP_TIMEOUT_MS });
522:         await expect(bubble(tab, stored[0].key as string)).toHaveCount(0);
523:       }
524:       expect(await readOutbox(tab1)).toHaveLength(0);
525:       await b.page.waitForTimeout(1_500);
526:       expect((await readArrivals(b.page)).max[text]).toBe(1);
527:     });
528:   }
