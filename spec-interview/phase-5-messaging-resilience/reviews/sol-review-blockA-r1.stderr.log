352:         expect(calls.filter((call) => call.key === key)).toHaveLength(0);
353:         for (const tab of [tab1, tab2]) await expect(bubble(tab, key)).toHaveCount(0);
354:         outcomes.push({ round, clicked, winner: 'cancel' });
355:       }
356:       await goOffline(tab1);
357:     }
358:     testInfo.annotations.push({ type: 't10-cancel-race', description: JSON.stringify(outcomes) });
359: 
360:     // Online for a while: a cancelled item is never dispatched afterwards.
361:     await a.context.setOffline(false);
362:     await tab1.waitForTimeout(3_000);
363:     expect(calls.filter((call) => call.key === cancelled.clientMessageId)).toHaveLength(0);
364:     expect(await storedWithTexts(directId, [cancelledText])).toHaveLength(0);
365:     for (const outcome of outcomes) {
