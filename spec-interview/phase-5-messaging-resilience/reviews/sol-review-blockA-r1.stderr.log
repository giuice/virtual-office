218:       } else if (next.ownerId !== ownerId) {
219:         throw new Error('An outbox item cannot change owner');
220:       } else if (next.clientMessageId !== clientMessageId) {
221:         items.delete([ownerId, clientMessageId]);
222:         items.add(next);
223:         done(next);
224:       } else {
225:         items.put(next);
226:         done(next);
227:       }
228:     };
229:   }, durability);
230: }
