242: async function installBubbleSampler(page: Page, text: string, parentText: string): Promise<void> {
243:   await page.evaluate(
244:     ({ text: trackedText, parentText: quotedParent }) => {
245:       const classes = ['plain', 'reply'] as const;
246:       const state = {
247:         evaluations: 0,
248:         maxSameId: 0,
249:         classes: Object.fromEntries(
250:           classes.map((name) => [name, { max: 0, current: 0, seen: false, lost: 0, quoteMissing: 0, ids: [] as 
string[] }]),
251:         ),
252:         history: [] as Array<{ t: number; plain: string[]; reply: string[] }>,
253:       };
254:       let lastSignature = '';
255:       const evaluate = () => {
256:         state.evaluations += 1;
257:         const ids: Record<string, string[]> = { plain: [], reply: [] };
258:         const feed = document.querySelector('[data-testid="messages-feed"]');
259:         const wrappers = feed ? Array.from(feed.querySelectorAll('[data-message-id]')) : [];
260:         const rendered = new Map<string, number>();
261:         for (const wrapper of wrappers) {
262:           const id = wrapper.getAttribute('data-message-id') ?? '';
263:           const item = Array.from(wrapper.children).find(
264:             (child) => child.getAttribute('data-testid') === `message-${id}`,
265:           );
266:           if (!item) continue;
267:           rendered.set(id, (rendered.get(id) ?? 0) + 1);
268:           state.maxSameId = Math.max(state.maxSameId, rendered.get(id) ?? 0);
269:           const hasText = Array.from(item.querySelectorAll('p')).some(
270:             (paragraph) => paragraph.textContent === trackedText,
271:           );
272:           if (!hasText) continue;
273:           const quote = item.querySelector(`[data-testid="reply-context-${id}"]`);
274:           const name = quote ? 'reply' : 'plain';
275:           ids[name].push(id);
276:           if (quote && !(quote.textContent ?? '').includes(quotedParent)) {
277:             state.classes[name].quoteMissing += 1;
278:           }
279:         }
280:         for (const name of classes) {
281:           const sample = state.classes[name];
282:           const count = ids[name].length;
283:           if (sample.seen && count === 0) sample.lost += 1;
284:           if (count > 0) sample.seen = true;
285:           sample.current = count;
286:           sample.max = Math.max(sample.max, count);
287:           sample.ids = ids[name];
288:         }
289:         const signature = JSON.stringify(ids);
290:         if (signature !== lastSignature && state.history.length < 200) {
291:           lastSignature = signature;
292:           state.history.push({ t: Math.round(performance.now()), plain: ids.plain, reply: ids.reply });
293:         }
294:       };
295:       (window as unknown as { __t7Bubbles?: typeof state }).__t7Bubbles = state;
296:       // Starts a new observation window (after an expected disappearance).
297:       (window as unknown as { __t7ResetBubbles?: () => void }).__t7ResetBubbles = () => {
298:         for (const name of classes) {
299:           const sample = state.classes[name];
300:           sample.max = sample.current;
301:           sample.seen = sample.current > 0;
302:           sample.lost = 0;
303:         }
304:       };
305:       evaluate();
306:       new MutationObserver(evaluate).observe(document.body, {
307:         subtree: true,
308:         childList: true,
309:         characterData: true,
310:         attributes: true,
311:         attributeFilter: ['data-message-id', 'data-testid'],
312:       });
313:     },
314:     { text, parentText },
315:   );
316: }
