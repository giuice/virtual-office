74: /** Every stored message of the conversation with one of `texts` (any key), oldest first. */
75: export async function storedWithTexts(conversationId: string, texts: readonly string[]): Promise<StoredRow[]> {
76:   return withLocalMessagingDb(async (db) => {
77:     const result = await db.query<StoredRow>(
78:       `select id::text as id, client_message_id::text as key, content, reply_to_id::text as reply_to_id,
79:               sender_id::text as sender_id
80:          from public.messages
81:         where conversation_id = $1 and content = any($2::text[])
82:         order by "timestamp", id`,
83:       [conversationId, [...texts]],
84:     );
85:     return result.rows;
86:   });
87: }
