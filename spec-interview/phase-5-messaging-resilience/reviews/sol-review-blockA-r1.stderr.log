125: const bubble = (page: Page, key: string) => page.getByTestId(`message-temp-${key}`);
126: const stateLabel = (page: Page, key: string) => page.getByTestId(`message-delivery-state-temp-${key}`);
127: const cancelButton = (page: Page, key: string) => page.getByTestId(`message-cancel-temp-${key}`);
128: 
129: function deferred(): { promise: Promise<void>; resolve: () => void } {
130:   let resolve: () => void = () => undefined;
131:   const promise = new Promise<void>((done) => {
132:     resolve = done;
133:   });
134:   return { promise, resolve };
135: }
