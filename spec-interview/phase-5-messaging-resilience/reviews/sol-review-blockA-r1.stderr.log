345:         expect(creates.length).toBeGreaterThanOrEqual(1);
346:         await expect(b.page.getByTestId(`message-${rows[0].id}`)).toBeVisible({ timeout: STEP_TIMEOUT_MS });
347:         outcomes.push({ round, clicked, winner: 'claim' });
348:       } else {
349:         // The cancel won: gone from both tabs and no create request was ever sent.
