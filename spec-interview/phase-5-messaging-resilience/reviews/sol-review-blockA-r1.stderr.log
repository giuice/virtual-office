220: /** Sends a held request to the server now (the release of a request held in the browser). */
221: async function releaseLate(route: Route): Promise<{ status: number; code?: string }> {
222:   const response = await route.fetch();
223:   const json = (await response.json().catch(() => null)) as { code?: string } | null;
224:   await route.fulfill({ response }).catch(() => undefined);
225:   return { status: response.status(), code: json?.code };
226: }
