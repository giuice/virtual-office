640:   test('review r1 #2: a 2xx without the item\'s stored message keeps the item, which is delivered once on a later 
generation', async ({
641:     phase5World,
642:     openDevice,
643:   }) => {
644:     const { directId } = phase5World.conversations;
645:     const a = await openDevice('A');
646:     const b = await openDevice('B');
647:     await createViaApi(a.page, { conversationId: directId, content: `t8 warm-up ${randomUUID()}` });
648:     await openConversation(b.page, directId);
649:     await waitForRealtimeReady(b.page);
650:     await openConversation(a.page, directId);
651:     const text = `t8 unusable ack ${randomUUID()}`;
652:     await watchArrivals(b.page, [text]);
653: 
654:     // Network-level faults on the first four attempts: answers that never
655:     // reached the server — 201 with an empty object, with an array, with
656:     // another key's message, and with this item's message in every respect
657:     // except a malformed reply target (review r3 #2). The fifth attempt is
658:     // held, then passed to the server; its real 201 reaches the page with
659:     // extra malformed fields the app must ignore.
660:     const attempts: Array<Record<string, unknown>> = [];
661:     let release!: () => void;
662:     const released = new Promise<void>((resolve) => {
663:       release = resolve;
664:     });
665:     await a.page.route('**/api/messages/create', async (route: Route) => {
666:       const body = (route.request().postDataJSON() ?? {}) as Record<string, unknown>;
667:       attempts.push(body);
668:       const fulfil201 = (payload: unknown) =>
669:         route.fulfill({ status: 201, contentType: 'application/json', body: JSON.stringify(payload) });
670:       if (attempts.length === 1) return fulfil201({ message: {} });
671:       if (attempts.length === 2) return fulfil201({ message: [] });
672:       if (attempts.length === 3) {
673:         return fulfil201({
674:           clientMessageId: body.clientMessageId,
675:           message: {
676:             id: randomUUID(),
677:             conversationId: directId,
678:             senderId: a.user.userId,
679:             content: text,
680:             clientMessageId: randomUUID(),
681:             timestamp: new Date().toISOString(),
682:             reactions: [],
683:           },
684:         });
685:       }
686:       if (attempts.length === 4) {
687:         return fulfil201({
688:           clientMessageId: body.clientMessageId,
689:           attemptGeneration: body.attemptGeneration,
690:           message: {
691:             id: randomUUID(),
692:             conversationId: directId,
693:             senderId: a.user.userId,
694:             content: text,
695:             clientMessageId: body.clientMessageId,
696:             replyToId: 42,
697:             timestamp: new Date().toISOString(),
698:             type: 'text',
699:             status: 'sent',
700:             isEdited: false,
701:             reactions: [],
702:             attachments: [],
703:           },
704:         });
705:       }
706:       await released;
707:       // The real stored message, plus fields the app never reads from a create
708:       // response (review r4 #1): they must not reach the feed renderers.
709:       const response = await route.fetch();
710:       const json = (await response.json()) as { message?: Record<string, unknown> };
711:       if (json.message) Object.assign(json.message, { stars: {}, pins: 7, readReceipts: 'x' });
712:       return route.fulfill({ response, json });
713:     });
714: 
715:     await sendFromComposer(a.page, text);
716:     await expect(composerInput(a.page)).toHaveValue('');
717:     // Retries back off 1, 2, 4 and 8 s.
718:     await expect.poll(() => attempts.length, { timeout: 2 * STEP_TIMEOUT_MS }).toBe(5);
719:     const key = String(attempts[0].clientMessageId);
720:     expect(attempts.map((attempt) => [attempt.clientMessageId, attempt.attemptGeneration])).toEqual([
721:       [key, 1],
722:       [key, 2],
723:       [key, 3],
724:       [key, 4],
725:       [key, 5],
726:     ]);
727:     // The item survived every unusable answer and is still being sent.
728:     await expectPendingLabel(a.page, key, 'sending', 'enviando');
729:     expect((await readOutbox(a.page)).map((row) => [row.clientMessageId, row.state, 
row.attemptGeneration])).toEqual([
730:       [key, 'claimed', 5],
731:     ]);
732:     expect(await storedWithTexts(directId, [text])).toHaveLength(0);
733: 
734:     release();
735:     await expect.poll(async () => (await storedWithTexts(directId, [text])).length, { timeout: STEP_TIMEOUT_MS 
}).toBe(1);
736:     const stored = await storedWithTexts(directId, [text]);
737:     expect(stored[0].key).toBe(key);
738:     await expectDeliveredInFeed(a.page, stored);
739:     await expect(b.page.getByTestId(`message-${stored[0].id}`)).toBeVisible({ timeout: STEP_TIMEOUT_MS });
740:     await expect.poll(async () => (await readOutbox(a.page)).length).toBe(0);
741:     await b.page.waitForTimeout(1_500);
742:     expect(attempts).toHaveLength(5);
743:     expect((await readArrivals(b.page)).max[text]).toBe(1);
744:     expect(await storedWithTexts(directId, [text])).toHaveLength(1);
745:   });
