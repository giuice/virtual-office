71: /**
72:  * The database's explicit membership refusal (Phase 5 T3, migration
73:  * 20261007114454). Any other 42501 — a revoked EXECUTE or table grant — is an
74:  * infrastructure failure, never a membership answer.
75:  */
76: function isMembershipRefusal(error: PostgrestError): boolean {
77:   return error.code === '42501' && error.message === 'NOT_PARTICIPANT';
78: }
79: 
80: function isRecord(value: unknown): value is Record<string, unknown> {
81:   return typeof value === 'object' && value !== null && !Array.isArray(value);
82: }
83: 
84: function isStringArray(value: unknown): value is string[] {
85:   return Array.isArray(value) && value.every((item) => typeof item === 'string');
86: }
