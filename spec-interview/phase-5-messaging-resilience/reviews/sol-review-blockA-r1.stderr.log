265: export type OutboxClaim =
266:   /**
267:    * `previous`: the item as it was before this claim. A `previous.state` of
268:    * `unknown`, or `claimed` (a holder that is gone), means an earlier attempt
269:    * may have been stored: the item must be fenced before it is sent again
270:    * (T27). T11: a claim that sends nothing (the browser's user is not the
271:    * owner) puts `previous` back.
272:    */
273:   | { kind: 'claimed'; item: OutboxItem; previous: OutboxItem }
274:   | { kind: 'empty' }
275:   /** The oldest unresolved item is failed or expired: later items wait (BR-003). */
276:   | { kind: 'blocked'; item: OutboxItem }
277:   /**
278:    * T9 (FR-008): the oldest item is waiting out the backoff of a transient
279:    * rejection (`retryNotBefore`, shared by every tab); claim again in `retryInMs`.
280:    */
281:   | { kind: 'deferred'; item: OutboxItem; retryInMs: number };
282: 
283: /**
284:  * Atomically takes the conversation's OLDEST item for a new attempt: the next
285:  * generation, state `claimed`, `claimHolder`, lease expiry. Only the oldest
286:  * item is ever eligible (BR-003). The caller must hold the conversation's
287:  * drain lock (Web Lock, T10), so any `claimed` item found here belongs to a
288:  * holder that is gone (tab closed or crashed) or whose lease ended (its lock
289:  * was taken over), and is taken over under a newer generation.
290:  *
291:  * Relaxed durability (as for state updates): the write survives a tab or
292:  * browser crash; only an OS crash could lose it, and then the next attempt
293:  * reuses this generation — still exactly once, since the server stores at
294:  * most one message per key and a create first fences older generations.
295:  * Only the item's first write (addOutboxItem) must be flushed (FR-001).
296:  *
297:  * `confirmedKey`: an item of this owner just confirmed by the server, removed
298:  * in the same transaction before the next one is taken. `maxDeferMs`: the
299:  * longest transient backoff; a waiting item whose `retryNotBefore` is at most
300:  * that far ahead is not claimed yet (`deferred`).
301:  */
302: export function claimOldestOutboxItem(
303:   ownerId: string,
304:   conversationId: string,
305:   claimHolder: string,
306:   leaseMs: number,
307:   confirmedKey: string | null = null,
308:   maxDeferMs = 0
309: ): Promise<OutboxClaim> {
310:   return inTransaction<OutboxClaim>('readwrite', ({ items }, done) => {
311:     if (confirmedKey !== null) items.delete([ownerId, confirmedKey]);
312:     const range = IDBKeyRange.bound([ownerId, conversationId, -Infinity], [ownerId, conversationId, Infinity]);
313:     const request = items.index(BY_CONVERSATION_ORDER).openCursor(range);
314:     request.onsuccess = () => {
315:       const cursor = request.result;
316:       if (!cursor) {
317:         done({ kind: 'empty' });
318:         return;
319:       }
320:       const item = cursor.value as OutboxItem;
321:       if (item.state === 'failed' || item.state === 'expired') {
322:         done({ kind: 'blocked', item });
323:         return;
324:       }
325:       const now = Date.now();
326:       // A backoff longer than the longest one possible means the clock went
327:       // back: the item is due now rather than held indefinitely.
328:       const retryInMs = item.state === 'waiting' && typeof item.retryNotBefore === 'number' ? item.retryNotBefore 
- now : 0;
329:       if (retryInMs > 0 && retryInMs <= maxDeferMs) {
330:         done({ kind: 'deferred', item, retryInMs });
331:         return;
332:       }
333:       const claimed: OutboxItem = {
334:         ...item,
335:         state: 'claimed',
336:         attemptGeneration: item.attemptGeneration + 1,
337:         claimHolder,
338:         leaseExpiresAt: now + leaseMs,
339:         updatedAt: now,
340:       };
341:       cursor.update(claimed);
342:       done({ kind: 'claimed', item: claimed, previous: item });
343:     };
344:   }, 'relaxed');
345: }

