232: /**
233:  * Removes a confirmed item. Relaxed durability: if the removal were lost (OS
234:  * crash), the item would only be sent again under a newer generation and
235:  * resolved as the already stored message.
236:  */
237: export function deleteOutboxItem(ownerId: string, clientMessageId: string): Promise<void> {
238:   return inTransaction<void>(
239:     'readwrite',
240:     ({ items }, done) => {
241:       items.delete([ownerId, clientMessageId]);
242:       done(undefined);
243:     },
244:     'relaxed'
641:     if (this.disposed || seq !== drain.viewSeq) return;
642:     this.render(conversationId, items);
643:   }
644: 
645:   private drainConversation(conversationId: string): void {
646:     if (this.disposed) return;
647:     if (this.held) {
648:       // T11: drains again only once the owner is authenticated again (verifyOwner resumes them).
649:       void this.verifyOwner();
650:       return;
651:     }
652:     const drain = this.drain(conversationId);
653:     if (drain.running) {
654:       drain.rerun = true;
655:       return;
656:     }
657:     drain.running = true;
658:     drain.rerun = false;
659:     void this.withDrainLock(conversationId)
660:       .catch((error) => {
661:         this.trace('drain-failed', { error: String(error) });
662:         this.scheduleRetry(conversationId);
663:       })
664:       .finally(() => {
665:         drain.running = false;
666:         if (drain.rerun && !this.disposed) this.drainConversation(conversationId);
667:       });
668:   }
