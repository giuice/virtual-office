62:     const byRequest = new Map<Request, ApiCall>();
63:     page.on('request', (request) => {
64:       if (request.method() !== 'POST') return;
65:       const path = new URL(request.url()).pathname;
66:       const kind = path === '/api/messages/create' ? 'create' : path === '/api/messages/fence' ? 'fence' : null;
67:       if (!kind) return;
68:       const body = (request.postDataJSON() ?? {}) as Record<string, unknown>;
69:       seq += 1;
70:       const call: ApiCall = {
71:         tab,
72:         kind,
73:         key: String(body.clientMessageId),
74:         generation: Number(body.attemptGeneration),
75:         conversationId: String(body.conversationId),
76:         startSeq: seq,
77:         startedAt: Date.now(),
78:       };
79:       calls.push(call);
80:       byRequest.set(request, call);
81:     });
82:     page.on('requestfinished', (request) => {
83:       const call = byRequest.get(request);
84:       if (!call) return;
85:       seq += 1;
86:       call.endSeq = seq;
87:       void request.response().then(async (response) => {
88:         if (!response) return;
89:         const json = (await response.json().catch(() => null)) as { outcome?: string; code?: string } | null;
90:         call.outcome = json?.outcome;
91:         call.code = json?.code;
92:         call.status = response.status();
93:       });
94:     });
95:     page.on('requestfailed', (request) => {
96:       const call = byRequest.get(request);
97:       if (!call) return;
98:       seq += 1;
99:       call.endSeq = seq;
100:       call.failure = request.failure()?.errorText ?? 'failed';
101:     });
102:   }
103:   return calls;
104: }
105: 
106: /** [tab, kind, generation, status | 'failed', fence outcome] of the calls for `key`. */
107: const summary = (calls: readonly ApiCall[], key: string) =>
108:   calls
109:     .filter((call) => call.key === key)
110:     .map((call) => [call.tab, call.kind, call.generation, call.failure ? 'failed' : (call.status ?? null), 
call.outcome ?? null]);
111: 
112: /** No two create requests of the conversation were in progress at once, across all tabs (AC-005). */
113: function expectNoOverlappingCreates(calls: readonly ApiCall[], conversationId: string): void {
114:   const creates = calls.filter((call) => call.kind === 'create' && call.conversationId === conversationId);
115:   creates.sort((left, right) => left.startSeq - right.startSeq);
116:   for (let index = 1; index < creates.length; index += 1) {
117:     const previous = creates[index - 1];
118:     expect(previous.endSeq, `create ${index} ended`).toBeDefined();
119:     expect(previous.endSeq as number, `create ${index + 1} started after create ${index} ended`).toBeLessThan(
120:       creates[index].startSeq,
121:     );
122:   }
123: }
