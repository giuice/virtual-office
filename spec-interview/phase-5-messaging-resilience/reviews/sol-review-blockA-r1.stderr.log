77: const bubble = (page: Page, key: string) => page.getByTestId(`message-temp-${key}`);
78: const stateLabel = (page: Page, key: string) => page.getByTestId(`message-delivery-state-temp-${key}`);
79: const retryButton = (page: Page, key: string) => page.getByTestId(`message-retry-temp-${key}`);
80: const discardButton = (page: Page, key: string) => page.getByTestId(`message-discard-temp-${key}`);
81: 
82: /** An unknown item shows "enviando" and offers no action (no cancel, retry or delete) before it is fenced. */
83: async function expectSendingWithoutActions(page: Page, key: string): Promise<void> {
84:   await expect(stateLabel(page, key)).toHaveText('enviando', { timeout: STEP_TIMEOUT_MS });
85:   await expect(stateLabel(page, key)).toHaveAttribute('data-delivery-state', 'sending');
86:   await expect(bubble(page, key).getByRole('button')).toHaveCount(0);
87: }
