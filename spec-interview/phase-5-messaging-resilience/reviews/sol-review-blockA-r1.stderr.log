26: /**
27:  * Phase 5 T8 — durable outbox with ordered automatic delivery (FR-001,
28:  * FR-002, FR-003, FR-010, FR-033, BR-002, BR-003; AC-001, AC-002, AC-004,
29:  * AC-011, AC-039; D1, D2, D5).
30:  *
31:  * Everything is real: the app, its IndexedDB outbox, the create route and the
32:  * local database. Offline is the browser context's network emulation
33:  * (`context.setOffline`: navigator.onLine false, every request fails); held
34:  * creates are delayed pass-through to the real server (route.fetch). The
35:  * outbox is read from the page's own IndexedDB (inspection only). Storage
36:  * failures (AC-039) are browser conditions installed before the app loads:
37:  * `indexedDB.open` throwing SecurityError (storage blocked for the site), and
38:  * outbox write transactions that fail to commit (as on QuotaExceededError).
39:  * Chromium's CDP quota override does not affect IndexedDB in Playwright's
40:  * off-the-record contexts (probed in Chrome and Edge), so the write failure is
41:  * produced in the page instead.
42:  *
43:  * Exactly once is checked three ways: one stored row per text (any key) in
44:  * the database, at most one bubble per text in B's feed at any moment
45:  * (MutationObserver), and one stored bubble (no pending copy) in A's feed.
46:  */
47: 
48: /** D1: with ≤ 10 pending and quota available, all delivered within 10 s of reconnecting. */
49: const D1_DEADLINE_MS = 10_000;
50: const D5_TEXT = 'Este navegador não permite guardar mensagens; libere o armazenamento do site';
51: 
52: interface CreateAttempt {
53:   body: Record<string, unknown>;
54:   startSeq: number;
55:   endSeq?: number;
56:   startedAt: number;
57:   endedAt?: number;
58:   status?: number;
59:   failure?: string;
60: }
61: 
62: /** Every create request of the page, with the order in which requests started and ended. */
63: function trackCreates(page: Page): CreateAttempt[] {
64:   const attempts: CreateAttempt[] = [];
65:   const byRequest = new Map<Request, CreateAttempt>();
66:   let seq = 0;
67:   const isCreate = (request: Request) =>
68:     request.method() === 'POST' && new URL(request.url()).pathname === '/api/messages/create';
69:   page.on('request', (request) => {
70:     if (!isCreate(request)) return;
71:     seq += 1;
72:     const attempt: CreateAttempt = {
73:       body: (request.postDataJSON() ?? {}) as Record<string, unknown>,
74:       startSeq: seq,
75:       startedAt: Date.now(),
76:     };
77:     attempts.push(attempt);
78:     byRequest.set(request, attempt);
79:   });
80:   page.on('requestfinished', (request) => {
81:     const attempt = byRequest.get(request);
82:     if (!attempt) return;
83:     seq += 1;
84:     attempt.endSeq = seq;
85:     attempt.endedAt = Date.now();
86:     void request.response().then((response) => {
87:       attempt.status = response?.status();
88:     });
89:   });
90:   page.on('requestfailed', (request) => {
91:     const attempt = byRequest.get(request);
92:     if (!attempt) return;
93:     seq += 1;
94:     attempt.endSeq = seq;
95:     attempt.endedAt = Date.now();
96:     attempt.failure = request.failure()?.errorText ?? 'failed';
97:   });
98:   return attempts;
99: }
100: 
101: /**
102:  * D1 diagnostics (ms after reconnecting): when each text first showed on the
103:  * recipient's page (null = not yet), each create's start, duration and gap
104:  * before it, and the server's own duration of each create (dev-server log).
105:  */
106: async function d1Timing(
107:   recipient: Page,
108:   texts: readonly string[],
109:   creates: readonly CreateAttempt[],
110:   reconnectedAt: number,
111:   serverLines: readonly string[],
112: ): Promise<Record<string, unknown>> {
113:   const arrivals = await recipient
114:     .evaluate(() => (window as unknown as { __t8Arrivals?: ArrivalState }).__t8Arrivals ?? null)
115:     .catch(() => null);
116:   const serverCreates = serverLines
117:     .map((line) => line.replace(/\u001b\[[0-9;]*m/g, ''))
118:     .map((line) => /POST \/api\/messages\/create (\d{3}) in (\d+)ms(?: \(.*application-code: 
(\d+)ms\))?/.exec(line))
119:     .filter((match): match is RegExpExecArray => match !== null)
120:     .map((match) => ({ status: Number(match[1]), totalMs: Number(match[2]), appMs: match[3] ? Number(match[3]) : 
null }));
121:   return {
122:     arrivalsMs: texts.map((text) => (arrivals?.first[text] === undefined ? null : arrivals.first[text] - 
reconnectedAt)),
123:     createStartMs: creates.map((attempt) => attempt.startedAt - reconnectedAt),
124:     createMs: creates.map((attempt) => (attempt.endedAt === undefined ? null : attempt.endedAt - 
attempt.startedAt)),
125:     gapMs: creates.slice(1).map((attempt, index) => {
126:       const previousEnd = creates[index].endedAt;
127:       return previousEnd === undefined ? null : attempt.startedAt - previousEnd;
128:     }),
129:     failures: creates.map((attempt) => attempt.failure ?? null),
130:     serverCreates,
131:   };
132: }
133: 
134: /** BR-003: each create of the conversation started only after the previous one ended. */
135: function expectNoOverlap(attempts: readonly CreateAttempt[]): void {
136:   for (let index = 1; index < attempts.length; index += 1) {
137:     const previous = attempts[index - 1];
138:     expect(previous.endSeq, `create ${index - 1} ended`).toBeDefined();
139:     expect(attempts[index].startSeq, `create ${index} starts after create ${index - 1} ended`).toBeGreaterThan(
140:       previous.endSeq as number,
141:     );
142:   }
143: }
144: 
145: /** Holds every create of `page` until `release()`, then passes it to the real server. */
146: async function holdCreates(page: Page): Promise<{ count(): number; release(): void }> {
147:   let release!: () => void;
148:   const released = new Promise<void>((resolve) => {
149:     release = resolve;
150:   });
151:   let count = 0;
152:   await page.route('**/api/messages/create', async (route: Route) => {
153:     count += 1;
154:     await released;
155:     await route.continue();
156:   });
157:   return { count: () => count, release };
158: }
