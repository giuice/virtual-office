36: /** The page's outbox items, in creation order (read-only; never creates the database). */
37: export async function readOutbox(page: Page): Promise<OutboxRow[]> {
38:   const rows = await page.evaluate(async (name: string) => {
39:     const databases = typeof indexedDB.databases === 'function' ? await indexedDB.databases() : [];
40:     if (!databases.some((database) => database.name === name)) return [];
41:     return new Promise<unknown[]>((resolve, reject) => {
42:       const request = indexedDB.open(name);
43:       request.onerror = () => reject(request.error);
44:       request.onsuccess = () => {
45:         const db = request.result;
46:         if (!db.objectStoreNames.contains('items')) {
47:           db.close();
48:           resolve([]);
49:           return;
50:         }
51:         const read = db.transaction('items', 'readonly').objectStore('items').getAll();
52:         read.onsuccess = () => {
53:           db.close();
54:           resolve(read.result);
55:         };
56:         read.onerror = () => {
57:           db.close();
58:           reject(read.error);
59:         };
60:       };
61:     });
62:   }, MESSAGING_OUTBOX_DB_NAME);
63:   return (rows as OutboxRow[]).sort((a, b) => a.order - b.order);
64: }
