24: /**
25:  * Phase 5 T27 — unknown-outcome recovery through the fence (FR-005, FR-006,
26:  * FR-009, BR-005, BR-007; AC-003, AC-038, AC-040, AC-042, AC-046 5xx clause).
27:  *
28:  * Everything is real: the app, its IndexedDB outbox, POST /api/messages/create
29:  * and POST /api/messages/fence, and the local database. Faults are network
30:  * shaping only (SPEC §15): a request aborted before it reaches the server
31:  * (network error), a response dropped or replaced by a gateway 502 after the
32:  * real server answered (route.fetch), a request held and then the tab closed,
33:  * and fence requests failed in transit for a while (the item stays unknown).
34:  * Expiry uses the page's test-controlled clock (Date only; timers keep
35:  * running). Removal from the room is the fixture's administrative
36:  * revocation; re-adding uses restore_conversation_membership.
37:  *
38:  * When the server stored the message, A must not learn it from its feed or
39:  * Realtime before the fence (that would confirm the item without one): the
40:  * item is queued offline, the tab is closed, and a new tab that never loads
41:  * that feed recovers it — or, where A's feed must stay visible, A's messages
42:  * Realtime stream is withheld (T25 fault harness).
43:  */
44: 
45: const DAY_MS = 24 * 60 * 60 * 1_000;
46: 
47: /** [kind, generation, status | 'network-error', fence outcome] of the calls that got an answer or failed. */
48: const summary = (calls: readonly ApiCall[]) =>
49:   calls.map((call) => [call.kind, call.generation, call.failure ? 'network-error' : (call.status ?? null), 
call.outcome ?? null]);
50: const answered = (calls: readonly ApiCall[]) => calls.filter((call) => !call.failure);
51: 
52: /**
53:  * A queues `text` offline with the conversation open, then closes the tab
54:  * without leaving that conversation restorable: a later tab never loads its
55:  * feed, so only a create or fence response can resolve the item.
56:  */
57: async function queueThenCloseTab(a: Phase5Device, conversationId: string, text: string): Promise<OutboxRow> {
58:   await openConversation(a.page, conversationId);
59:   await goOffline(a.page);
60:   const [item] = await queueOffline(a, conversationId, [text]);
61:   await a.page.evaluate(() => window.localStorage.removeItem('messaging_active_conversation_id'));
62:   await a.page.close();
63:   return item;
64: }
65: 
66: /** Fails every fence of `page` in transit while `blocked()` (the item stays unknown). */
67: async function blockFences(page: Page, blocked: () => boolean): Promise<void> {
68:   await page.route('**/api/messages/fence', async (route: Route) => {
69:     if (blocked()) {
70:       await route.abort('failed');
71:       return;
72:     }
73:     await route.continue();
74:   });
75: }
