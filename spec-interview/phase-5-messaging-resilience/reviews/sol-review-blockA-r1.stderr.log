336:       if (round === 1) await tab2.waitForTimeout(25);
337:       const [clicked] = await Promise.all([click, a.context.setOffline(false)]);
338:       await expect.poll(async () => (await readOutbox(tab1)).length, { timeout: STEP_TIMEOUT_MS }).toBe(0);
339:       await tab1.waitForTimeout(1_000);
