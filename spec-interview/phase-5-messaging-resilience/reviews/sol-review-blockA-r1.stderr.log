747:   test('review r1 #3: when the outbox read right after a committed write fails, the item still shows as pending 
and is delivered once', async ({
748:     phase5World,
749:     openDevice,
750:   }) => {
751:     const { directId } = phase5World.conversations;
752:     const a = await openDevice('A');
753:     const b = await openDevice('B');
754:     await createViaApi(a.page, { conversationId: directId, content: `t8 warm-up ${randomUUID()}` });
755:     await openConversation(b.page, directId);
756:     await waitForRealtimeReady(b.page);
757: 
758:     // Once armed: the first read-only transaction opened after the outbox
759:     // write is aborted — the read the app makes right after the commit (a
760:     // storage read failure right after a successful write).
761:     await a.context.addInitScript(() => {
762:       const scope = window as unknown as { __t8ArmReadAbort: boolean; __t8ReadAborts: number; __t8AbortNextRead: 
boolean };
763:       scope.__t8ArmReadAbort = false;
764:       scope.__t8ReadAborts = 0;
765:       scope.__t8AbortNextRead = false;
766:       const add = IDBObjectStore.prototype.add;
767:       IDBObjectStore.prototype.add = function armedAdd(this: IDBObjectStore, ...args: 
Parameters<IDBObjectStore['add']>) {
768:         const request = add.apply(this, args);
769:         if (scope.__t8ArmReadAbort) {
770:           // The app reads again as soon as this write commits (no read-only
771:           // transaction is opened in between), so the next one is that read.
772:           scope.__t8ArmReadAbort = false;
773:           scope.__t8AbortNextRead = true;
774:         }
775:         return request;
776:       };
777:       const transaction = IDBDatabase.prototype.transaction;
778:       IDBDatabase.prototype.transaction = function abortingTransaction(
779:         this: IDBDatabase,
780:         ...args: Parameters<IDBDatabase['transaction']>
781:       ) {
782:         const created = transaction.apply(this, args);
783:         const mode = args[1] ?? 'readonly';
784:         if (scope.__t8AbortNextRead && mode === 'readonly') {
785:           scope.__t8AbortNextRead = false;
786:           scope.__t8ReadAborts += 1;
787:           queueMicrotask(() => {
788:             try {
789:               created.abort();
790:             } catch {
791:               // Already finished.
792:             }
793:           });
794:         }
795:         return created;
796:       };
797:     });
798:     await a.page.goto('/floor-plan');
799:     await openConversation(a.page, directId);
800:     const text = `t8 read fails ${randomUUID()}`;
801:     await watchArrivals(b.page, [text]);
802: 
803:     await goOffline(a.page);
804:     await a.page.evaluate(() => {
805:       (window as unknown as { __t8ArmReadAbort: boolean }).__t8ArmReadAbort = true;
806:     });
807:     await sendFromComposer(a.page, text);
808:     await expect(composerInput(a.page)).toHaveValue('');
809:     await expect
810:       .poll(() => a.page.evaluate(() => (window as unknown as { __t8ReadAborts: number }).__t8ReadAborts))
811:       .toBe(1);
812:     const [item] = await readOutbox(a.page);
813:     expect(item).toMatchObject({ content: text, state: 'waiting', attemptGeneration: 0 });
814:     await expectPendingLabel(a.page, item.clientMessageId, 'pending', 'pendente');
815: 
816:     await a.context.setOffline(false);
817:     await expect.poll(async () => (await storedWithTexts(directId, [text])).length, { timeout: D1_DEADLINE_MS 
}).toBe(1);
818:     const stored = await storedWithTexts(directId, [text]);
819:     expect(stored[0].key).toBe(item.clientMessageId);
820:     await expectDeliveredInFeed(a.page, stored);
821:     await expect(b.page.getByTestId(`message-${stored[0].id}`)).toBeVisible({ timeout: STEP_TIMEOUT_MS });
822:     await expect.poll(async () => (await readOutbox(a.page)).length).toBe(0);
823:     await b.page.waitForTimeout(1_500);
824:     expect((await readArrivals(b.page)).max[text]).toBe(1);
825:   });
