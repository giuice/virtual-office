302: export function claimOldestOutboxItem(
303:   ownerId: string,
304:   conversationId: string,
305:   claimHolder: string,
306:   leaseMs: number,
307:   confirmedKey: string | null = null,
308:   maxDeferMs = 0
309: ): Promise<OutboxClaim> {
310:   return inTransaction<OutboxClaim>('readwrite', ({ items }, done) => {
311:     if (confirmedKey !== null) items.delete([ownerId, confirmedKey]);
312:     const range = IDBKeyRange.bound([ownerId, conversationId, -Infinity], [ownerId, conversationId, Infinity]);
313:     const request = items.index(BY_CONVERSATION_ORDER).openCursor(range);
314:     request.onsuccess = () => {
315:       const cursor = request.result;
316:       if (!cursor) {
317:         done({ kind: 'empty' });
318:         return;
319:       }
320:       const item = cursor.value as OutboxItem;
321:       if (item.state === 'failed' || item.state === 'expired') {
322:         done({ kind: 'blocked', item });
323:         return;
324:       }
325:       const now = Date.now();
326:       // A backoff longer than the longest one possible means the clock went
327:       // back: the item is due now rather than held indefinitely.
328:       const retryInMs = item.state === 'waiting' && typeof item.retryNotBefore === 'number' ? item.retryNotBefore 
- now : 0;
329:       if (retryInMs > 0 && retryInMs <= maxDeferMs) {
330:         done({ kind: 'deferred', item, retryInMs });
331:         return;
332:       }
333:       const claimed: OutboxItem = {
334:         ...item,
335:         state: 'claimed',
336:         attemptGeneration: item.attemptGeneration + 1,
337:         claimHolder,
338:         leaseExpiresAt: now + leaseMs,
339:         updatedAt: now,
