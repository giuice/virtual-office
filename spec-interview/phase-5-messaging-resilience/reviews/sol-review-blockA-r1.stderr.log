92:   await expect(page.getByTestId('sign-out-unsent-message')).toHaveText(unsentText(count));
93:   await expect(page.getByTestId('sign-out-unsent-cancel')).toHaveText('Cancelar');
94:   await expect(page.getByTestId('sign-out-unsent-confirm')).toHaveText('Sair mesmo');
95: }
