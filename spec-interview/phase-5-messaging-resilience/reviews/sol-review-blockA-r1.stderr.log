221:     const lastArrival = Math.max(...texts.map((text) => arrivals.first[text]));
222:     expect(lastArrival - reconnectedAt, 'B saw all three within 10 s of 
reconnecting').toBeLessThanOrEqual(D1_DEADLINE_MS);
