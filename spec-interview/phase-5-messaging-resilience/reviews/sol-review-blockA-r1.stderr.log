88: /**
89:  * Calls public.create_message_attempt. Throws AttemptSupersededError when the
90:  * attempt was fenced (nothing stored), MessageDeletedError when a
91:  * generation-carrying create would recreate a deleted message,
92:  * InsertionRateLimitError when the winning insertion could not be charged to
93:  * the insertion quota (exhausted or uncheckable; rolled back),
94:  * AttachmentLinkError for the
95:  * database's validation refusals (reply target, explicit membership refusal,
96:  * uploads), and MessageAttemptRpcError for anything else (including grant
97:  * failures).
98:  */
99: export async function createMessageAttempt(
100:   client: SupabaseClient,
101:   input: CreateMessageAttemptInput
102: ): Promise<CreateMessageAttemptResult> {
103:   const { data, error } = await client.rpc('create_message_attempt', {
104:     p_conversation_id: input.data.conversationId,
105:     p_sender_id: input.data.senderId,
106:     p_content: input.data.content,
107:     p_type: input.data.type,
108:     p_reply_to_id: input.data.replyToId ?? null,
109:     p_client_message_id: input.clientMessageId ?? null,
110:     p_attempt_generation: input.attempt?.generation ?? null,
111:     // Phase 5 T4: the composition carries the requested mention ids, which
112:     // the function stores (members other than the sender) with the insertion.
113:     p_composition: input.clientMessageId && input.attempt ? input.attempt.composition : null,
114:     p_upload_ids: [...input.uploadIds],
115:     p_insert_quota_limit: input.insertQuota?.limit ?? null,
116:     p_insert_quota_window_seconds: input.insertQuota?.windowSeconds ?? null,
117:   });
118: 
119:   if (error) {
120:     if (error.code === 'P0001' && error.message === 'RATE_LIMITED') {
121:       throw new InsertionRateLimitError('exceeded');
122:     }
123:     if (error.code === 'P0001' && error.message === 'RATE_LIMIT_UNAVAILABLE') {
124:       console.error('Insertion quota could not be charged in create_message_attempt:', error);
125:       throw new InsertionRateLimitError('unavailable');
126:     }
127:     if (error.message === 'ATTEMPT_SUPERSEDED') {
128:       throw new AttemptSupersededError();
129:     }
130:     if (error.message === 'MESSAGE_DELETED') {
131:       throw new MessageDeletedError();
132:     }
133:     const linkFailure = LINK_FAILURE_CODES.find((code) => error.message === code);
134:     if (error.code === '22023' && linkFailure) {
135:       throw new AttachmentLinkError(linkFailure);
136:     }
137:     if (isMembershipRefusal(error)) {
138:       throw new AttachmentLinkError('NOT_PARTICIPANT');
139:     }
140:     console.error('Error in create_message_attempt RPC:', error);
141:     throw new MessageAttemptRpcError(error);
142:   }
143:   if (!isRecord(data) || typeof data.message_id !== 'string' || typeof data.created !== 'boolean') {
144:     throw new Error('create_message_attempt returned an unexpected result');
145:   }
146:   return {
147:     messageId: data.message_id,
148:     created: data.created,
149:     storedComposition: data.created ? null : parseStoredComposition(data.composition),
150:     createdRow: data.created && isRecord(data.message) ? data.message : null,
151:     mentionedUserIds: data.created && isStringArray(data.mentioned_user_ids) ? data.mentioned_user_ids : null,
152:   };
153: }
154: 
155: /**
156:  * Calls public.fence_message_attempt. Throws NotParticipantError for the
157:  * database's explicit membership refusal and MessageAttemptRpcError for
158:  * anything else (including grant failures).
159:  */
160: export async function fenceMessageAttempt(
161:   client: SupabaseClient,
162:   key: ClientMessageKey,
163:   generation: number
164: ): Promise<MessageAttemptFenceResult> {
165:   const { data, error } = await client.rpc('fence_message_attempt', {
166:     p_sender_id: key.senderId,
167:     p_conversation_id: key.conversationId,
168:     p_client_message_id: key.clientMessageId,
169:     p_attempt_generation: generation,
170:   });
171: 
172:   if (error) {
173:     if (isMembershipRefusal(error)) {
174:       throw new NotParticipantError();
175:     }
176:     console.error('Error in fence_message_attempt RPC:', error);
177:     throw new MessageAttemptRpcError(error);
178:   }
179:   if (isRecord(data)) {
180:     if (data.outcome === 'superseded' || data.outcome === 'not_stored') {
181:       return { outcome: data.outcome };
182:     }
183:     if (data.outcome === 'stored' && (typeof data.message_id === 'string' || data.message_id === null)) {
184:       return { outcome: 'stored', messageId: data.message_id };
185:     }
186:   }
187:   throw new Error('fence_message_attempt returned an unexpected result');
188: }

