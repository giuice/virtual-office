177:   /** Test-runner time (ms) when the page started the request. */
178:   startedAt: number;
179:   status?: number;
180:   /** Error code of a JSON error answer. */
181:   code?: string;
182:   outcome?: string;
183:   failure?: string;
184: }
185: 
186: /** Every create and fence request of the page (moved from the T27 spec), in the order they started. */
187: export function trackOutboxCalls(page: Page, calls: OutboxApiCall[] = []): OutboxApiCall[] {
188:   const byRequest = new Map<Request, OutboxApiCall>();
189:   page.on('request', (request) => {
190:     if (request.method() !== 'POST') return;
191:     const path = new URL(request.url()).pathname;
192:     const kind = path === '/api/messages/create' ? 'create' : path === '/api/messages/fence' ? 'fence' : null;
193:     if (!kind) return;
194:     const body = (request.postDataJSON() ?? {}) as Record<string, unknown>;
195:     const call: OutboxApiCall = { kind, key: body.clientMessageId, generation: body.attemptGeneration, startedAt: 
Date.now() };
196:     calls.push(call);
197:     byRequest.set(request, call);
198:   });
199:   page.on('requestfinished', (request) => {
200:     const call = byRequest.get(request);
201:     if (!call) return;
202:     void request.response().then(async (response) => {
203:       if (!response) return;
204:       const json = (await response.json().catch(() => null)) as { outcome?: string; code?: string } | null;
205:       if (call.kind === 'fence') call.outcome = json?.outcome;
206:       call.code = json?.code;
207:       call.status = response.status();
208:     });
209:   });
210:   page.on('requestfailed', (request) => {
211:     const call = byRequest.get(request);
212:     if (call) call.failure = request.failure()?.errorText ?? 'failed';
213:   });
214:   return calls;
215: }
