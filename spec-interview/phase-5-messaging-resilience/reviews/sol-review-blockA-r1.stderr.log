137: interface Setup {
138:   a: Phase5Device;
139:   b: Phase5Device;
140:   tab1: Page;
141:   tab2: Page;
142:   directId: string;
143: }
144: 
145: /** A with two tabs on the DM and B watching it. */
146: async function twoTabs(
147:   phase5World: { conversations: { directId: string } },
148:   openDevice: (key: 'A' | 'B') => Promise<Phase5Device>,
149: ): Promise<Setup> {
150:   const { directId } = phase5World.conversations;
151:   const a = await openDevice('A');
152:   const b = await openDevice('B');
153:   await createViaApi(a.page, { conversationId: directId, content: `t10 warm-up ${randomUUID()}` });
154:   await openConversation(b.page, directId);
155:   await waitForRealtimeReady(b.page);
156:   await openConversation(a.page, directId);
157:   const tab2 = await a.newTab();
158:   await openConversation(tab2, directId);
159:   return { a, b, tab1: a.page, tab2, directId };
160: }
161: 
162: /**
163:  * Hangs the tab: its main thread is paused (CDP Debugger.pause — the next
164:  * script, timer or event of the page stops before it runs) until the returned
165:  * function resumes it. Its Web Lock stays held. (Page lifecycle freezing does
166:  * not stop timers of a visible page, so it cannot hang the holder.)
167:  */
168: async function freeze(page: Page): Promise<() => Promise<void>> {
169:   const cdp = await page.context().newCDPSession(page);
170:   await cdp.send('Debugger.enable');
171:   await cdp.send('Debugger.pause');
172:   return async () => {
173:     await cdp.send('Debugger.resume').catch(() => undefined);
174:     await cdp.send('Debugger.disable').catch(() => undefined);
175:     await cdp.detach().catch(() => undefined);
176:   };
177: }
178: 
179: /** Holds FOR UPDATE on a message row: a create replying to it blocks inside its INSERT. */
180: async function holdMessageRowLock(messageId: string): Promise<{ pid: number; release: () => Promise<void> }> {
181:   const holder = new Client({
182:     ...parseLoopbackDatabaseUrl(MESSAGING_LOCAL_DB_URL),
183:     ssl: false,
184:     application_name: 'vo-messaging-e2e-t10-row-lock',
185:     options: '-c default_transaction_read_only=off -c statement_timeout=0',
186:   });
187:   await holder.connect();
188:   await holder.query('begin');
189:   await holder.query('select id from public.messages where id = $1 for update', [messageId]);
190:   const pid = (await holder.query<{ pid: number }>('select pg_backend_pid() as pid')).rows[0].pid;
191:   let released = false;
192:   return {
193:     pid,
194:     async release() {
195:       if (released) return;
196:       released = true;
197:       await holder.query('rollback').catch(() => undefined);
198:       await holder.end();
199:     },
200:   };
201: }
202: 
203: async function waitForBlockedCreate(holderPid: number): Promise<void> {
204:   await expect
205:     .poll(
206:       () =>
207:         withLocalMessagingDb(async (db) => {
208:           const { rows } = await db.query<{ waiting: number }>(
209:             `select count(*)::int as waiting from pg_catalog.pg_stat_activity
210:               where pid <> $1 and wait_event_type = 'Lock' and query ilike '%create_message_attempt%'`,
211:             [holderPid],
212:           );
213:           return rows[0].waiting;
214:         }),
215:       { timeout: 5_000, intervals: [50] },
216:     )
217:     .toBe(1);
218: }
