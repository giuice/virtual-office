3: // compared with the owner of an outbox.
4: //
5: // The outbox belongs to an application user (users.id). Its owner's auth
6: // identity is that user's `users.supabase_uid`, and the browser's current one
7: // is the auth user of the session the Supabase browser client reads from its
8: // storage (the auth cookies every tab of the browser shares) — so a sign-out
9: // or a sign-in as another account in any tab, or cookies cleared or replaced
10: // by the server, is seen by every tab on its next check, with or without an
11: // auth event. The server still checks every request's sender (the route
12: // compares the expected sender with users.id resolved from auth.getUser()).
13: import { isAuthRetryableFetchError } from '@supabase/supabase-js';
14: 
15: import { supabase } from '@/lib/supabase/client';
16: 
17: /**
18:  * - `owner`: the browser holds a session of the outbox's owner;
19:  * - `other`: it holds another user's session (an account switch);
20:  * - `ended`: it holds no session (signed out, cookies cleared, or the
21:  *   refresh was rejected and the session removed);
22:  * - `unverified`: the session could not be read (its refresh failed in
23:  *   transit): nothing is concluded, the check is repeated later.
24:  */
25: export type OutboxIdentityState = 'owner' | 'other' | 'ended' | 'unverified';
26: 
27: export interface OutboxIdentity {
28:   /** The browser's authenticated user compared with the owner, read now. */
29:   check(): Promise<OutboxIdentityState>;
30:   /** Calls `listener` (asynchronously) after every auth state change this tab's auth client reports. */
31:   onChange(listener: () => void): () => void;
32: }
33: 
34: /** `ownerAuthUid`: the owner's `users.supabase_uid` (never users.id). */
35: export function createOutboxIdentity(ownerAuthUid: string): OutboxIdentity {
36:   return {
37:     async check() {
38:       try {
39:         const { data, error } = await supabase.auth.getSession();
40:         const session = data.session;
41:         if (session) return session.user.id === ownerAuthUid ? 'owner' : 'other';
42:         return error && isAuthRetryableFetchError(error) ? 'unverified' : 'ended';
43:       } catch {
44:         return 'unverified';
45:       }
46:     },
47:     onChange(listener) {
48:       // The auth client may still hold its lock while notifying: read the
49:       // session only after the callback returned.
50:       const { data } = supabase.auth.onAuthStateChange(() => {
51:         setTimeout(listener, 0);
52:       });
53:       return () => data.subscription.unsubscribe();
54:     },
55:   };
56: }
src/lib/messaging/outbox/outbox-sign-out.ts
1: // src/lib/messaging/outbox/outbox-sign-out.ts
2: // Phase 5 T12 (FR-013, BR-008): the outbox side of an explicit sign-out.
3: //
4: // - countUnsentOutboxItems(): the owner's unsent items in this browser (every
5: //   conversation and tab: they share one IndexedDB outbox), for the "Sair"
6: //   confirmation.
7: // - beginOutboxSignOut(): "Sair mesmo". Stops every outbox instance of the
8: //   owner in every tab of the browser FIRST — this tab's at once, the others
9: //   through the owner's BroadcastChannel — then waits (bounded) until no tab
10: //   holds a drain lock of the owner, so no drain is between a claim and its
11: //   request, and only then deletes every item of the owner and clears the
12: //   pending views. The caller then runs the existing sign-out (Presence
13: //   logout sequence unchanged) and calls release() whatever its outcome:
14: //   every tab then lets the browser's identity decide again (held while
15: //   signed out; resumed, with an empty outbox, if the sign-out failed).
16: // Late create/fence responses cannot bring an item back: they are ignored
17: // while stopped, and an update never creates a missing item.
18: import type { QueryClient } from '@tanstack/react-query';
19: 
20: import { debugLogger } from '@/utils/debug-logger';
21: import { deleteAllOutboxItems, listOutboxItems } from './outbox-db';
22: import { MessageOutbox, outboxChannelName, outboxDrainLockPrefix } from './message-outbox';
23: import { clearOutboxViews } from './outbox-view';
24: 
25: /** Longest wait for other tabs' drains to stop (a hung tab cannot delay the sign-out longer). */
26: const DRAIN_STOP_WAIT_MS = 3_000;
27: /**
28:  * Longest wait for one outbox read or delete before the sign-out: an
29:  * IndexedDB open or transaction that never settles must not keep the user
30:  * signed in (local storage never blocks the sign-out).
31:  */
32: const STORAGE_WAIT_MS = 3_000;
33: const SCOPE = 'OutboxSignOut';
34: 
35: class OutboxSignOutTimeoutError extends Error {
36:   constructor(step: string) {
37:     super(`The outbox ${step} did not finish in time`);
38:     this.name = 'OutboxSignOutTimeoutError';
39:   }
40: }
41: 
42: /** `work`, or a rejection after `ms` (the work itself is not cancelled). */
43: function within<T>(work: Promise<T>, ms: number, step: string): Promise<T> {
44:   let timer: ReturnType<typeof setTimeout> | null = null;
45:   const timeout = new Promise<never>((_resolve, reject) => {
46:     timer = setTimeout(() => reject(new OutboxSignOutTimeoutError(step)), ms);
47:   });
48:   return Promise.race([work, timeout]).finally(() => {
49:     if (timer) clearTimeout(timer);
50:   });
51: }
52: 
53: export interface OutboxSignOut {
54:   /**
55:    * Waits (at most 3 s) for the drains to stop, then deletes every item of the
56:    * owner; rejects if the delete fails or takes more than 3 s.
57:    */
58:   discard(): Promise<void>;
59:   /** The sign-out ended (or failed): every tab's outbox follows the browser's identity again. Idempotent. */
60:   release(): void;
61: }
62: 
63: /** The owner's unsent outbox items in this browser (all conversations, all tabs); rejects after 3 s. */
64: export async function countUnsentOutboxItems(ownerId: string): Promise<number> {
65:   return (await within(listOutboxItems(ownerId), STORAGE_WAIT_MS, 'read')).length;
66: }
67: 
68: /** Waits until no tab holds (or waits for) a drain lock of the owner, at most `maxMs`. */
69: async function waitForDrainsToStop(ownerId: string, maxMs: number): Promise<void> {
70:   const locks = typeof navigator !== 'undefined' ? navigator.locks : undefined;
71:   if (!locks) return;
72:   const prefix = outboxDrainLockPrefix(ownerId);
73:   let names: string[];
74:   try {
75:     const snapshot = await locks.query();
76:     names = [...(snapshot.held ?? []), ...(snapshot.pending ?? [])]
77:       .map((lock) => lock.name ?? '')
78:       .filter((name) => name.startsWith(prefix));
79:   } catch {
80:     return;
81:   }
82:   const deadline = AbortSignal.timeout(maxMs);
83:   // Taking each lock in turn means its holder's drain loop has returned.
84:   await Promise.allSettled([...new Set(names)].map((name) => locks.request(name, { signal: deadline }, async () => 
undefined)));
85: }
86: 
87: /** "Sair mesmo": stops every drain of the owner in this browser now (see the file header). */
88: export function beginOutboxSignOut(ownerId: string, queryClient: QueryClient): OutboxSignOut {
89:   const local = MessageOutbox.liveFor(ownerId);
90:   local.forEach((outbox) => outbox.stopForSignOut());
91:   const channel = typeof BroadcastChannel !== 'undefined' ? new BroadcastChannel(outboxChannelName(ownerId)) : 
null;
92:   const post = (message: { signOutStop: true } | { signOutDone: true }) => {
93:     try {
94:       channel?.postMessage(message);
95:     } catch {
96:       // The other tabs then stop on the auth change (signed out) or their stop expires.
97:     }
98:   };
99:   post({ signOutStop: true });
100:   clearOutboxViews(queryClient, ownerId);
101:   let released = false;
102:   return {
103:     async discard() {
104:       // Past the wait the delete goes ahead anyway (a frozen tab cannot hold the sign-out).
105:       await within(waitForDrainsToStop(ownerId, DRAIN_STOP_WAIT_MS), DRAIN_STOP_WAIT_MS + 500, 'drain 
stop').catch(
106:         () => undefined
107:       );
108:       const removed = await within(deleteAllOutboxItems(ownerId), STORAGE_WAIT_MS, 'delete');
109:       clearOutboxViews(queryClient, ownerId);
110:       if (debugLogger.messaging.enabled()) {
111:         debugLogger.messaging.event(SCOPE, 'outbox-deleted', { removed });
112:       }
113:     },
114:     release() {
115:       if (released) return;
116:       released = true;
117:       post({ signOutDone: true });
118:       channel?.close();
119:       local.forEach((outbox) => outbox.endSignOutStop());
120:     },
121:   };
122: }
src/lib/messaging/outbox/outbox-outcome.ts
1: // src/lib/messaging/outbox/outbox-outcome.ts
2: // Phase 5 T8: outcome classes of one outbox attempt (BR-005).
3: import type { Message } from '@/types/messaging';
4: import type { OutboxFailureReason } from '@/types/message-outbox';
5: import { parseStoredMessage, type AttemptedItem } from './outbox-ack';
6: 
7: export type { AttemptedItem } from './outbox-ack';
8: 
9: export type OutboxAttemptOutcome =
10:   /** Stored (201) or replayed (200); `message` is null when it was deleted since (410). */
11:   | { kind: 'delivered'; message: Message | null }
12:   /** 429 / 401: retried automatically, in order (FR-008; 401 vs session end → T11). */
13:   | { kind: 'transient'; status: number }
14:   /**
15:    * No usable response (network error, 5xx, any 2xx without this item's
16:    * stored message — e.g. a 204 or a malformed body): it may be stored, so the
17:    * item is kept and sent again.
18:    */
19:   | { kind: 'unknown'; status: number | null }
20:   /** 409 ATTEMPT_SUPERSEDED: a newer attempt of the key exists; ignored. */
21:   | { kind: 'superseded' }
22:   /** Definitive 4xx: no automatic retry (FR-007). */
23:   | { kind: 'failed'; status: number; reason: OutboxFailureReason }
24:   /** Fenced as not stored after its 24 h delivery window: never sent automatically (FR-009). */
25:   | { kind: 'expired' };
26: 
27: /** What a fence (T27, FR-006) says about an item whose earlier attempt may be stored. */
28: export type OutboxFenceOutcome =
29:   /** Stored under the key (`message` null when deleted since): the item is delivered. */
30:   | { kind: 'delivered'; message: Message | null }
31:   /** Nothing stored, and no older attempt can commit any more. */
32:   | { kind: 'not_stored' }
33:   /**
34:    * Definitive refusal, e.g. 403 NOT_PARTICIPANT after access was lost: the
35:    * item fails (BR-005) — it is never treated as not stored (no expiry, no
36:    * cancel, no create).
37:    */
38:   | { kind: 'failed'; status: number; reason: OutboxFailureReason }
39:   /**
40:    * Still unknown: no response, 5xx, 429/401, a newer generation exists
41:    * (409 ATTEMPT_SUPERSEDED), or a 200 that is not this item's answer. The
42:    * item stays unknown and is fenced again later.
43:    */
44:   | { kind: 'unknown'; status: number | null };
45: 
46: export function classifyFenceResponse(
47:   response: { status: number; code?: string; outcome?: string; message?: unknown },
48:   item: AttemptedItem
49: ): OutboxFenceOutcome {
50:   const { status, code, outcome, message } = response;
51:   if (status === 200 && outcome === 'not_stored') return { kind: 'not_stored' };
52:   if (status === 200 && outcome === 'stored') {
53:     if (message === null) return { kind: 'delivered', message: null };
54:     const stored = parseStoredMessage(message, item);
55:     return stored ? { kind: 'delivered', message: stored } : { kind: 'unknown', status };
56:   }
57:   if (status >= 400 && status < 500 && status !== 401 && status !== 429 && status !== 409) {
58:     return { kind: 'failed', status, reason: failureReason(status, code) };
59:   }
60:   return { kind: 'unknown', status };
61: }
62: 
63: export function classifyAttemptResponse(
64:   response: { status: number; code?: string; message?: unknown },
65:   item: AttemptedItem
66: ): OutboxAttemptOutcome {
67:   const { status, code, message } = response;
68:   if (status >= 200 && status < 300) {
69:     // Only 200/201 carrying this item's stored message (outbox-ack) confirm it.
70:     const stored = status === 200 || status === 201 ? parseStoredMessage(message, item) : null;
71:     return stored ? { kind: 'delivered', message: stored } : { kind: 'unknown', status };
72:   }
73:   if (status === 410 && code === 'MESSAGE_DELETED') return { kind: 'delivered', message: null };
74:   if (status === 429 || status === 401) return { kind: 'transient', status };
75:   if (status >= 500 || status < 200 || (status >= 300 && status < 400)) return { kind: 'unknown', status };
76:   if (status === 409 && code === 'ATTEMPT_SUPERSEDED') return { kind: 'superseded' };
77:   return { kind: 'failed', status, reason: failureReason(status, code) };
78: }
79: 
80: function failureReason(status: number, code: string | undefined): OutboxFailureReason {
81:   if (status === 403 && code === 'SENDER_MISMATCH') return 'sender_mismatch';
82:   if (status === 403) return 'not_participant';
83:   if (status === 409 && code === 'CLIENT_MESSAGE_ID_REUSED') return 'client_message_id_reused';
84:   if (status === 413) return 'content_too_large';
85:   if (status === 400) return 'invalid_request';
86:   return 'rejected';
87: }
src/types/message-outbox.ts
1: // src/types/message-outbox.ts
2: // Phase 5 T8 (FR-001..FR-003, BR-001..BR-003; SPEC §9 data outputs): one
3: // item of the browser's durable message outbox (IndexedDB), per application
4: // user (users.id) and browser.
5: 
6: /**
7:  * Item state (SPEC §9):
8:  * - `waiting`: stored, never dispatched or back to waiting after a transient
9:  *   outcome (browser offline, 429, 401);
10:  * - `claimed`: a tab holds it and its create request (generation
11:  *   `attemptGeneration`) may be in progress;
12:  * - `unknown`: an attempt ended without a usable response (network error,
13:  *   5xx, a superseded claim) — it may or may not be stored;
14:  * - `failed`: definitively rejected (`failureReason`); no automatic attempt,
15:  *   later items of the conversation wait (BR-003);
16:  * - `expired`: fenced as not stored after its 24 h delivery window (BR-006).
17:  */
18: export type OutboxItemState = 'waiting' | 'claimed' | 'unknown' | 'failed' | 'expired';
19: 
20: /** Why a `failed` item was rejected (BR-005 definitive classes). */
21: export type OutboxFailureReason =
22:   | 'not_participant'
23:   | 'sender_mismatch'
24:   | 'client_message_id_reused'
25:   | 'content_too_large'
26:   | 'invalid_request'
27:   | 'rejected';
28: 
29: /**
30:  * A text or reply message the user pressed send on (BR-002: never files or
31:  * voice). Written before it is dispatched; removed once the server confirmed
32:  * it (create response, or its stored key observed in the feed or Realtime).
33:  * Absence therefore means delivered, cancelled ("Cancelar") or deleted ("Apagar").
34:  */
35: export interface OutboxItem {
36:   /** Owner: the application user (users.id), never the Supabase auth uid. */
37:   ownerId: string;
38:   /** Stable composition key, lowercase UUID; every attempt reuses it (BR-004). */
39:   clientMessageId: string;
40:   conversationId: string;
41:   /** Trimmed text as sent. */
42:   content: string;
43:   replyToId: string | null;
44:   /** Requested mentions (users.id), resent unchanged on every attempt. */
45:   mentionIds: string[];
46:   /** When the user pressed send (epoch ms); kept across manual retries. */
47:   pressedSendAt: number;
48:   /** Start of the current 24 h delivery window (epoch ms; BR-006). */
49:   windowStartedAt: number;
50:   /** Per-owner creation order shared by every tab of the browser. */
51:   order: number;
52:   state: OutboxItemState;
53:   /** Set only when `state` is `failed`. */
54:   failureReason: OutboxFailureReason | null;
55:   /** Last dispatched generation (0 = never dispatched); monotonic per key. */
56:   attemptGeneration: number;
57:   /** Tab that claimed the item (cross-tab ownership, T10). */
58:   claimHolder: string | null;
59:   /** When that claim's lease ends (epoch ms; enforced by T10). */
60:   leaseExpiresAt: number | null;
61:   /**
62:    * T9 (FR-008): after a transient rejection (429, 401 with a valid session)
63:    * the earliest time (epoch ms) any tab may claim the item again, so the
64:    * backoff holds across the user's tabs. Absent or null: not deferred.
65:    */
66:   retryNotBefore?: number | null;
67:   /** T9: backoff (ms) of the last transient rejection; doubles on each consecutive one. */
68:   retryDelayMs?: number | null;
69:   updatedAt: number;
70:   /** Item schema version (1). */
71:   schemaVersion: number;
72: }
73: 
74: /** What the composer hands to the outbox for one send. */
75: export interface OutboxEnqueueInput {
76:   conversationId: string;
77:   clientMessageId: string;
78:   content: string;
79:   replyToId?: string | null;
80:   /**
81:    * Conversation of the reply target when the caller knows it (the selected
82:    * message's). A different one than `conversationId` is refused before
83:    * anything is stored; an unknown one is left to the server.
84:    */
85:   replyToConversationId?: string | null;
86:   mentionIds?: readonly string[];
87: }
src/hooks/useMessageOutbox.ts
1: // src/hooks/useMessageOutbox.ts
2: // Phase 5 T8: runs the signed-in user's durable message outbox (one per
3: // application user, users.id) for as long as the messaging provider is
4: // mounted, and returns the function that queues a text/reply send — plus
5: // (T27) "Tentar de novo" and "Apagar" for a failed or expired item, and
6: // (T10) "Cancelar" for a never-dispatched waiting item, and (T12) the count
7: // and deletion behind the "Sair" confirmation. T11: the outbox sends
8: // and applies responses only while the browser's authenticated user is its
9: // owner (users.id `ownerId`, whose auth identity is `ownerAuthUid`, that
10: // user's users.supabase_uid).
11: import { useCallback, useEffect, useMemo, useRef } from 'react';
12: import { useQueryClient } from '@tanstack/react-query';
13: 
14: import { MessageOutbox } from '@/lib/messaging/outbox/message-outbox';
15: import { createOutboxIdentity } from '@/lib/messaging/outbox/outbox-identity';
16: import {
17:   beginOutboxSignOut,
18:   countUnsentOutboxItems,
19:   type OutboxSignOut,
20: } from '@/lib/messaging/outbox/outbox-sign-out';
21: import type { OutboxEnqueueInput } from '@/types/message-outbox';
22: 
23: export type QueueTextMessage = (input: OutboxEnqueueInput) => Promise<void>;
24: 
25: export interface MessageOutboxActions {
26:   queueTextMessage: QueueTextMessage;
27:   /** "Tentar de novo" on a failed or expired item (by its clientMessageId). */
28:   retryOutboxMessage: (clientMessageId: string) => Promise<void>;
29:   /** "Apagar": removes a failed or expired item from this browser only. */
30:   discardOutboxMessage: (clientMessageId: string) => Promise<void>;
31:   /** "Cancelar" (T10): removes a never-dispatched waiting item in every tab, unless a claim won. */
32:   cancelOutboxMessage: (clientMessageId: string) => Promise<void>;
33:   /** T12: the signed-in user's unsent items in this browser (0 when there is no outbox user). */
34:   countUnsentOutboxMessages: () => Promise<number>;
35:   /**
36:    * T12 "Sair mesmo": stops every drain of the user in every tab now; then
37:    * `discard()` deletes the user's outbox and `release()` ends the stop once
38:    * the sign-out finished. Null when there is no outbox user.
39:    */
40:   beginOutboxSignOut: () => OutboxSignOut | null;
41: }
42: 
43: export function useMessageOutbox(
44:   ownerId: string | null | undefined,
45:   ownerAuthUid: string | null | undefined
46: ): MessageOutboxActions {
47:   const queryClient = useQueryClient();
48:   const outboxRef = useRef<MessageOutbox | null>(null);
49: 
50:   useEffect(() => {
51:     if (!ownerId || !ownerAuthUid) return;
52:     const outbox = new MessageOutbox(ownerId, queryClient, createOutboxIdentity(ownerAuthUid));
53:     outboxRef.current = outbox;
54:     outbox.start();
55:     return () => {
56:       outbox.dispose();
57:       if (outboxRef.current === outbox) outboxRef.current = null;
58:     };
59:   }, [ownerId, ownerAuthUid, queryClient]);
60: 
61:   const currentOutbox = useCallback((): MessageOutbox => {
62:     const outbox = outboxRef.current;
63:     if (!outbox || outbox.ownerId !== ownerId) {
64:       throw new Error('The message outbox is not ready');
65:     }
66:     return outbox;
67:   }, [ownerId]);
68: 
69:   const queueTextMessage = useCallback(
70:     async (input: OutboxEnqueueInput) => {
71:       await currentOutbox().enqueue(input);
72:     },
73:     [currentOutbox]
74:   );
75:   const retryOutboxMessage = useCallback(
76:     async (clientMessageId: string) => {
77:       await currentOutbox().retry(clientMessageId);
78:     },
79:     [currentOutbox]
80:   );
81:   const discardOutboxMessage = useCallback(
82:     async (clientMessageId: string) => {
83:       await currentOutbox().discard(clientMessageId);
84:     },
85:     [currentOutbox]
86:   );
87:   const cancelOutboxMessage = useCallback(
88:     async (clientMessageId: string) => {
89:       await currentOutbox().cancel(clientMessageId);
90:     },
91:     [currentOutbox]
92:   );
93: 
94:   // T12: read from and act on the outbox database by owner (users.id), so they
95:   // work whether or not this tab's instance has started.
96:   const countUnsentOutboxMessages = useCallback(
97:     async () => (ownerId ? countUnsentOutboxItems(ownerId) : 0),
98:     [ownerId]
99:   );
100:   const beginSignOut = useCallback(
101:     () => (ownerId ? beginOutboxSignOut(ownerId, queryClient) : null),
102:     [ownerId, queryClient]
103:   );
104: 
105:   return useMemo(
106:     () => ({
107:       queueTextMessage,
108:       retryOutboxMessage,
109:       discardOutboxMessage,
110:       cancelOutboxMessage,
111:       countUnsentOutboxMessages,
112:       beginOutboxSignOut: beginSignOut,
113:     }),
114:     [
115:       queueTextMessage,
116:       retryOutboxMessage,
117:       discardOutboxMessage,
118:       cancelOutboxMessage,
119:       countUnsentOutboxMessages,
120:       beginSignOut,
121:     ]
122:   );
123: }

