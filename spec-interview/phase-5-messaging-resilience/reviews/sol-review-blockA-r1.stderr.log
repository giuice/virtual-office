83:   if (status === 409 && code === 'CLIENT_MESSAGE_ID_REUSED') return 'client_message_id_reused';
84:   if (status === 413) return 'content_too_large';
85:   if (status === 400) return 'invalid_request';
86:   return 'rejected';
87: }
