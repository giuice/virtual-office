2: // Phase 5 T8: reads a create response's `message` as the stored message of
3: // an outbox item. A response confirms the item only if it parses here; the
4: // result is built from validated fields only (nothing else is copied), so a
5: // malformed response can neither confirm a send nor reach the feed renderers.
6: import {
7:   MessageStatus,
8:   MessageType,
9:   type Message,
10:   type MessageReaction,
11: } from '@/types/messaging';
12: 
13: /** The item an attempt was made for: a confirmation must be its own stored message. */
14: export interface AttemptedItem {
15:   senderId: string;
16:   conversationId: string;
17:   clientMessageId: string;
18: }
19: 
20: const UUID_PATTERN = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
21: const MESSAGE_TYPES = new Set<string>(Object.values(MessageType));
22: const MESSAGE_STATUSES = new Set<string>(Object.values(MessageStatus));
23: 
24: const isUuid = (value: unknown): value is string => typeof value === 'string' && UUID_PATTERN.test(value);
25: 
26: const isPlainObject = (value: unknown): value is Record<string, unknown> =>
27:   typeof value === 'object' && value !== null && !Array.isArray(value);
28: 
29: const parseDate = (value: unknown): Date | null => {
30:   if (typeof value !== 'string' && typeof value !== 'number') return null;
31:   const date = new Date(value);
32:   return Number.isNaN(date.getTime()) ? null : date;
33: };
34: 
35: /** Reactions as the repository maps them: emoji, reacting user (users.id), time. */
36: function parseReactions(value: unknown): MessageReaction[] | null {
37:   if (value === undefined) return [];
38:   if (!Array.isArray(value)) return null;
39:   const reactions: MessageReaction[] = [];
40:   for (const entry of value) {
41:     if (!isPlainObject(entry)) return null;
42:     const timestamp = parseDate(entry.timestamp);
43:     if (typeof entry.emoji !== 'string' || entry.emoji.length === 0 || !isUuid(entry.userId) || !timestamp) {
44:       return null;
45:     }
46:     reactions.push({ emoji: entry.emoji, userId: entry.userId, timestamp });
47:   }
48:   return reactions;
49: }
50: 
51: /** Stored mentions (users.id); absent on responses that carry none. */
52: function parseMentionedUserIds(value: unknown): string[] | undefined | null {
53:   if (value === undefined) return undefined;
54:   if (!Array.isArray(value) || !value.every(isUuid)) return null;
55:   return [...value];
56: }
57: 
58: /**
59:  * The stored message of `item` in the feed's shape, or null when `raw` is not
60:  * one. Correlation uses only what never changes for a stored message: a UUID
61:  * `id`, the sender (users.id), the conversation and the composition key
62:  * (case-insensitive). The stored text and reply target are not compared with
63:  * the item's (a replay returns the current row: reply target deleted since,
64:  * edited text), but must be renderable. Every field copied is checked, with
65:  * the shapes the create route returns for a created (201) or replayed (200)
66:  * keyed text message (repository mapper + key):
67:  * - `content` string; `replyToId` absent, null or a UUID;
68:  * - `timestamp` parseable; `type` and `status` known values;
69:  * - `isEdited` absent, null or boolean;
70:  * - `reactions` absent or a list of {emoji string, userId UUID, timestamp};
71:  * - `attachments` absent or empty (an outbox item is text only);
72:  * - `mentionedUserIds` absent or a list of UUIDs;
73:  * - `readCount` absent or a non-negative integer.
74:  * Other fields (pins, stars — the route strips them — or anything else) are
75:  * not copied.
76:  */
77: export function parseStoredMessage(raw: unknown, item: AttemptedItem): Message | null {
78:   if (!isPlainObject(raw)) return null;
79:   const timestamp = parseDate(raw.timestamp);
80:   const reactions = parseReactions(raw.reactions);
81:   const mentionedUserIds = parseMentionedUserIds(raw.mentionedUserIds);
82:   const correlated =
83:     isUuid(raw.id) &&
84:     raw.senderId === item.senderId &&
85:     raw.conversationId === item.conversationId &&
86:     typeof raw.clientMessageId === 'string' &&
87:     raw.clientMessageId.toLowerCase() === item.clientMessageId.toLowerCase();
88:   const renderable =
89:     typeof raw.content === 'string' &&
90:     (raw.replyToId === undefined || raw.replyToId === null || isUuid(raw.replyToId)) &&
91:     timestamp !== null &&
92:     typeof raw.type === 'string' &&
93:     MESSAGE_TYPES.has(raw.type) &&
94:     typeof raw.status === 'string' &&
95:     MESSAGE_STATUSES.has(raw.status) &&
96:     (raw.isEdited === undefined || raw.isEdited === null || typeof raw.isEdited === 'boolean') &&
97:     reactions !== null &&
98:     (raw.attachments === undefined || (Array.isArray(raw.attachments) && raw.attachments.length === 0)) &&
99:     mentionedUserIds !== null &&
100:     (raw.readCount === undefined ||
101:       (typeof raw.readCount === 'number' && Number.isInteger(raw.readCount) && raw.readCount >= 0));
102:   if (!correlated || !renderable || timestamp === null || reactions === null || mentionedUserIds === null) {
103:     return null;
104:   }
105:   return {
106:     id: raw.id as string,
107:     conversationId: item.conversationId,
108:     senderId: item.senderId,
109:     content: raw.content as string,
110:     timestamp,
111:     type: raw.type as MessageType,
112:     status: raw.status as MessageStatus,
113:     replyToId: typeof raw.replyToId === 'string' ? raw.replyToId : undefined,
114:     attachments: [],
115:     reactions,
116:     isEdited: raw.isEdited === true,
117:     clientMessageId: item.clientMessageId.toLowerCase(),
118:     ...(mentionedUserIds !== undefined ? { mentionedUserIds } : {}),
119:     ...(typeof raw.readCount === 'number' ? { readCount: raw.readCount } : {}),
120:   };
121: }
