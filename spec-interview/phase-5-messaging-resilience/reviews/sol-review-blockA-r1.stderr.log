27: /** What a fence (T27, FR-006) says about an item whose earlier attempt may be stored. */
28: export type OutboxFenceOutcome =
29:   /** Stored under the key (`message` null when deleted since): the item is delivered. */
30:   | { kind: 'delivered'; message: Message | null }
31:   /** Nothing stored, and no older attempt can commit any more. */
32:   | { kind: 'not_stored' }
33:   /**
34:    * Definitive refusal, e.g. 403 NOT_PARTICIPANT after access was lost: the
35:    * item fails (BR-005) — it is never treated as not stored (no expiry, no
36:    * cancel, no create).
37:    */
38:   | { kind: 'failed'; status: number; reason: OutboxFailureReason }
39:   /**
40:    * Still unknown: no response, 5xx, 429/401, a newer generation exists
41:    * (409 ATTEMPT_SUPERSEDED), or a 200 that is not this item's answer. The
42:    * item stays unknown and is fenced again later.
43:    */
44:   | { kind: 'unknown'; status: number | null };
