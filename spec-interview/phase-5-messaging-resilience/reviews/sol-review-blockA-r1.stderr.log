318:     }
319:     expect(await readOutbox(tab1)).toHaveLength(0);
320: 
321:     // Racing: tab 2 cancels at the moment both tabs come online and try to claim.
322:     const outcomes: Array<{ round: number; clicked: boolean; winner: 'cancel' | 'claim' }> = [];
323:     const raceTexts: string[] = [];
324:     for (let round = 0; round < 3; round += 1) {
325:       const text = `t10 race ${round} ${randomUUID()}`;
326:       raceTexts.push(text);
