248:   test('D1: ten messages queued offline are delivered in order, once each, within 10 s, one create at a time', 
async ({
249:     phase5World,
250:     openDevice,
251:     serverLog,
252:   }, testInfo) => {
253:     const { directId } = phase5World.conversations;
254:     const a = await openDevice('A');
255:     const b = await openDevice('B');
256:     await createViaApi(a.page, { conversationId: directId, content: `t8 warm-up ${randomUUID()}` });
257: 
258:     await openConversation(b.page, directId);
259:     await waitForRealtimeReady(b.page);
260:     await openConversation(a.page, directId);
261:     const creates = trackCreates(a.page);
262: 
263:     const texts = Array.from({ length: 10 }, (_, index) => `t8 burst ${index + 1} ${randomUUID()}`);
264:     await watchArrivals(b.page, texts);
265:     await goOffline(a.page);
266:     const queued = await queueOffline(a, directId, texts);
267:     expect(creates, 'no create request while offline').toHaveLength(0);
268: 
269:     const logMark = serverLog.mark();
270:     const reconnectedAt = Date.now();
271:     await a.context.setOffline(false);
272:     try {
273:       await expect
274:         .poll(async () => Object.keys((await readArrivals(b.page)).first).length, { timeout: D1_DEADLINE_MS })
275:         .toBe(10);
276:       const arrivals = await readArrivals(b.page);
277:       const lastArrival = Math.max(...texts.map((text) => arrivals.first[text]));
278:       expect(lastArrival - reconnectedAt, 'B saw all ten within 10 s of 
reconnecting').toBeLessThanOrEqual(D1_DEADLINE_MS);
279:       expect([...texts].sort((x, y) => arrivals.first[x] - arrivals.first[y]), 'B saw them in send 
order').toEqual(texts);
280: 
281:       const stored = await storedWithTexts(directId, texts);
282:       expect(stored.map((row) => row.content), 'one stored row per text, in send order').toEqual(texts);
283:       expect(stored.map((row) => row.key)).toEqual(queued.map((item) => item.clientMessageId));
284: 
285:       const sent = creates;
286:       expect(sent.filter((attempt) => attempt.failure !== undefined), 'no failed create').toHaveLength(0);
287:       expect(sent.map((attempt) => attempt.body.clientMessageId), 'one create per item, in order').toEqual(
288:         queued.map((item) => item.clientMessageId),
289:       );
290:       expect(sent.every((attempt) => attempt.body.attemptGeneration === 1)).toBe(true);
291:       expectNoOverlap(sent);
292:       const lastResponse = Math.max(...sent.map((attempt) => attempt.endedAt ?? Infinity));
293:       expect(lastResponse - reconnectedAt, 'every create answered within 10 
s').toBeLessThanOrEqual(D1_DEADLINE_MS);
294: 
295:       await expectDeliveredInFeed(a.page, stored);
296:       await expect.poll(async () => (await readOutbox(a.page)).length).toBe(0);
297:       await b.page.waitForTimeout(1_500);
298:       const settled = await readArrivals(b.page);
299:       for (const text of texts) expect(settled.max[text], `B never showed "${text}" twice`).toBe(1);
300:     } finally {
301:       // Diagnostics, also when an assertion above failed (review r3 #3). Best
302:       // effort (review r4 #2): nothing here may throw and replace the original
303:       // failure; a part that cannot be read is recorded as an error.
304:       let serverLines: string[] = [];
305:       let serverLogError: string | null = null;
306:       try {
307:         serverLines = serverLog.linesSince(logMark);
308:       } catch (error) {
309:         serverLogError = error instanceof Error ? error.message : String(error);
310:       }
311:       try {
312:         const timing = await d1Timing(b.page, texts, creates, reconnectedAt, serverLines);
313:         testInfo.annotations.push({ type: 't8-d1-timing', description: JSON.stringify({ ...timing, serverLogError 
}) });
314:       } catch (error) {
315:         testInfo.annotations.push({
316:           type: 't8-d1-timing-error',
317:           description: error instanceof Error ? error.message : String(error),
318:         });
319:       }
320:     }
321:   });
