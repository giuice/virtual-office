36: const AUTH_COOKIE = /^sb-.+-auth-token(\.\d+)?$/;
37: const SIGNED_OUT_NOTICE = 'Successfully signed out!';
38: /** Longer than the longest transient backoff (15 s) would be pointless here: nothing may run at all. */
39: const QUIET_MS = 6_000;
40: 
41: const bubble = (page: Page, key: string) => page.getByTestId(`message-temp-${key}`);
42: const dialog = (page: Page) => page.getByTestId('sign-out-unsent-dialog');
43: const unsentText = (count: number) => `Você tem ${count} mensagens não enviadas. Sair apaga essas mensagens.`;
44: 
45: async function authCookieNames(context: BrowserContext): Promise<string[]> {
46:   return (await context.cookies()).filter((cookie) => AUTH_COOKIE.test(cookie.name)).map((cookie) => cookie.name);
47: }
48: 
49: interface LogoutCall {
50:   startedAt: number;
51:   status?: number;
52:   body?: Record<string, unknown> | null;
53: }
54: 
55: /** Every Presence logout request of the browser (all tabs), with its answer. */
56: function trackPresenceLogout(context: BrowserContext): LogoutCall[] {
57:   const calls: LogoutCall[] = [];
58:   const byRequest = new Map<unknown, LogoutCall>();
59:   context.on('request', (request) => {
60:     if (request.method() !== 'POST' || new URL(request.url()).pathname !== '/api/presence/logout') return;
61:     const call: LogoutCall = { startedAt: Date.now() };
62:     calls.push(call);
63:     byRequest.set(request, call);
64:   });
65:   context.on('requestfinished', (request) => {
66:     const call = byRequest.get(request);
67:     if (!call) return;
68:     void request.response().then(async (response) => {
69:       if (!response) return;
70:       call.body = (await response.json().catch(() => null)) as Record<string, unknown> | null;
71:       call.status = response.status();
72:     });
73:   });
74:   return calls;
75: }
76: 
77: /** The single, successful Presence logout of an unchanged sign-out sequence. */
78: async function expectOnePresenceLogout(calls: readonly LogoutCall[]): Promise<void> {
79:   await expect.poll(() => calls.map((call) => call.status ?? null), { timeout: STEP_TIMEOUT_MS }).toEqual([200]);
80:   expect(calls[0].body).toMatchObject({ success: true });
81:   expect(['LOCATION_UPDATED', 'LOCATION_UNCHANGED']).toContain(calls[0].body?.code);
82: }
