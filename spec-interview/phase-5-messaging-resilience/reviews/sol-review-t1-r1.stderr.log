supabase/migrations/20261004170724_revoke_mark_conversation_read_from_clients.sql
   1: -- Phase 4 T24 / AC-035 (spec-interview/phase-4-messaging-timeline): anonymous
   2: -- and signed-in clients can no longer call mark_conversation_read.
   3: --
   4: -- mark_conversation_read(p_conversation_id, p_user_id) is SECURITY DEFINER and
   5: -- trusts its p_user_id argument, so any caller that can EXECUTE it can advance
   6: -- another user's read cursor and write receipts on their behalf. Migration
   7: -- 20260610210000 revoked it from public and authenticated only; Supabase's
   8: -- default privileges for functions created by postgres in schema public
   9: -- (pg_default_acl: anon, authenticated, service_role = X) had already granted
  10: -- anon EXECUTE at CREATE time, so the anon key could still call it.
  11: --
  12: -- Backward compatible with the published app: the only caller is
  13: -- SupabaseConversationRepository.markConversationRead, which runs on the
  14: -- service-role client built by requireConversationParticipant in
  15: -- PATCH /api/conversations/read. service_role keeps EXECUTE.
  16: --
  17: -- REVOKE/GRANT are idempotent: re-running this file is a no-op.
  18: --
  19: -- Rollback restores the exact pre-T24 ACL ({postgres, anon, service_role}),
  20: -- which REOPENS the anon hole. Prefer a forward fix; use only to unblock an
  21: -- emergency where a non-service-role caller turns out to depend on it:
  22: --   grant execute on function public.mark_conversation_read(uuid, uuid) to anon;
  23: 
  24: begin;
  25: 
  26: revoke all on function public.mark_conversation_read(uuid, uuid) from public, anon, authenticated;
  27: grant execute on function public.mark_conversation_read(uuid, uuid) to service_role;
  28: 
  29: commit;

