  73:       if (rateLimited) {
  74:         return rateLimited;
  75:       }
  76: 
  77:       const recorded = await conversationRepository.markMessagesRead(
  78:         conversationId,
  79:         ctx.dbUser.id,
  80:         messageIds
  81:       );
  82:       return NextResponse.json({ success: true, recorded }, { status: 200 });
  83:     }
  84: 
  85:     // Phase 2.2: atomic RPC â€” sets conversation_members.last_read_at and
  86:     // writes per-message read receipts in one transaction.
  87:     const success = await conversationRepository.markConversationRead(conversationId, ctx.dbUser.id);
  88: 
  89:     if (!success) {
  90:       return jsonError(500, 'INTERNAL_ERROR', 'Failed to mark conversation as read');
  91:     }
  92: 
  93:     return NextResponse.json({ success: true }, { status: 200 });
  94:   } catch (error) {
  95:     console.error('Error marking conversation as read:', error);
  96:     return jsonError(500, 'INTERNAL_ERROR', 'Internal Server Error');
  97:   }
  98: }
src/lib/auth/authorize.ts
   1: // src/lib/auth/authorize.ts
   2: // Single authorization gate for messaging routes (audit S-05).
   3: // Rule: every route resolves the requester, checks participation here, and only
   4: // then may use the service-role client for the mutation. RLS stays as
   5: // defense-in-depth, never the primary gate.
   6: import type { NextResponse } from 'next/server';
   7: import type { SupabaseClient } from '@supabase/supabase-js';
   8: import { jsonError } from '@/lib/api/server-error';
   9: import { createSupabaseServerClient } from '@/lib/supabase/server-client';
  10: import { requireAuthUser } from '@/lib/auth/session';
  11: import type { User } from '@/types/database';
  12: 
  13: export { jsonError } from '@/lib/api/server-error';
  14: 
  15: export interface ConversationAccess {
  16:   id: string;
  17:   type: string;
  18:   roomId: string | null;
  19: }
  20: 
  21: export interface ParticipantContext {
  22:   /** User-scoped client â€” use for reads so RLS still applies. */
  23:   supabase: SupabaseClient;
  24:   /** Service-role client â€” use ONLY for the mutation after this check passed. */
  25:   serviceClient: SupabaseClient;
  26:   dbUser: User;
  27:   conversation: ConversationAccess;
  28: }
  29: 
  30: export interface MessageParticipantContext extends ParticipantContext {
  31:   message: {
  32:     id: string;
  33:     conversationId: string;
  34:     senderId: string | null;
  35:   };
  36: }
  37: 
  38: export interface AuthzFailure {
  39:   errorResponse: NextResponse;
  40: }
  41: 
  42: export function isAuthzFailure(result: object): result is AuthzFailure {
  43:   return 'errorResponse' in result;
  44: }
  45: 
  46: async function loadConversationAccess(
  47:   serviceClient: SupabaseClient,
  48:   conversationId: string,
  49:   dbUserId: string
  50: ): Promise<{ conversation: ConversationAccess; isMember: boolean } | AuthzFailure> {
  51:   const { data: row, error } = await serviceClient
  52:     .from('conversations')
  53:     .select('id, type, room_id, conversation_members(user_id)')
  54:     .eq('id', conversationId)
  55:     .eq('conversation_members.user_id', dbUserId)
  56:     .maybeSingle();
  57: 
  58:   if (error) {
  59:     console.error('[authorize] Failed to load conversation:', error.message);
  60:     return { errorResponse: jsonError(500, 'INTERNAL_ERROR', 'Failed to load conversation') };
  61:   }
  62:   if (!row) {
  63:     return { errorResponse: jsonError(404, 'CONVERSATION_NOT_FOUND', 'Conversation not found') };
  64:   }
  65: 
  66:   const conversationMembers = Array.isArray((row as { conversation_members?: unknown }).conversation_members)
  67:     ? ((row as { conversation_members: { user_id: string }[] }).conversation_members ?? [])
  68:     : [];
  69: 
  70:   return {
  71:     conversation: {
  72:       id: row.id,
  73:       type: row.type,
  74:       roomId: row.room_id ?? null,
  75:     },
  76:     isMember: conversationMembers.length > 0,
  77:   };
  78: }
  79: 
  80: /**
  81:  * Resolves the session and asserts the requester participates in the
  82:  * conversation. Membership authority is now conversation_members (synced from
  83:  * participants[] by DB trigger; participants[] will be removed in Phase 3).
  84:  */
  85: export async function requireConversationParticipant(
  86:   conversationId: string
  87: ): Promise<ParticipantContext | AuthzFailure> {
  88:   if (!conversationId || typeof conversationId !== 'string') {
  89:     return { errorResponse: jsonError(400, 'BAD_REQUEST', 'conversationId is required') };
  90:   }
  91: 
  92:   const auth = await requireAuthUser();
  93:   if ('errorResponse' in auth) {
  94:     return auth;
  95:   }
  96: 
  97:   const serviceClient = await createSupabaseServerClient('service_role');
  98:   const access = await loadConversationAccess(serviceClient, conversationId, auth.dbUser.id);
  99:   if (isAuthzFailure(access)) {
 100:     return access;
 101:   }
 102: 
 103:   if (!access.isMember) {
 104:     return {
 105:       errorResponse: jsonError(403, 'NOT_PARTICIPANT', 'You are not a participant of this conversation'),
 106:     };
 107:   }
 108: 
 109:   const { conversation } = access;
 110: 
 111:   return {
 112:     supabase: auth.supabase,
 113:     serviceClient,
 114:     dbUser: auth.dbUser,
 115:     conversation,
 116:   };
 117: }
 118: 
 119: /**
 120:  * Same as requireConversationParticipant, but scoped by message â€” for routes
 121:  * addressed by messageId (react, pin, star, attachment access).
 122:  */
 123: export async function requireMessageParticipant(
 124:   messageId: string
 125: ): Promise<MessageParticipantContext | AuthzFailure> {
 126:   if (!messageId || typeof messageId !== 'string') {
 127:     return { errorResponse: jsonError(400, 'BAD_REQUEST', 'messageId is required') };
 128:   }
 129: 
 130:   const auth = await requireAuthUser();
 131:   if ('errorResponse' in auth) {
 132:     return auth;
 133:   }
 134: 
 135:   const serviceClient = await createSupabaseServerClient('service_role');
 136:   const { data: messageRow, error: messageError } = await serviceClient
 137:     .from('messages')
 138:     .select('id, conversation_id, sender_id')
 139:     .eq('id', messageId)
 140:     .maybeSingle();
 141: 
 142:   if (messageError) {
 143:     console.error('[authorize] Failed to load message:', messageError.message);
 144:     return { errorResponse: jsonError(500, 'INTERNAL_ERROR', 'Failed to load message') };
 145:   }
 146:   if (!messageRow) {
 147:     return { errorResponse: jsonError(404, 'MESSAGE_NOT_FOUND', 'Message not found') };
 148:   }
 149: 
 150:   const access = await loadConversationAccess(serviceClient, messageRow.conversation_id, auth.dbUser.id);
 151:   if (isAuthzFailure(access)) {
 152:     return access;
 153:   }
 154: 
 155:   if (!access.isMember) {
 156:     return {
 157:       errorResponse: jsonError(403, 'NOT_PARTICIPANT', 'You are not a participant of this conversation'),
 158:     };
 159:   }
 160: 
 161:   return {
 162:     supabase: auth.supabase,
 163:     serviceClient,
 164:     dbUser: auth.dbUser,
 165:     conversation: access.conversation,
 166:     message: {
 167:       id: messageRow.id,
 168:       conversationId: messageRow.conversation_id,
 169:       senderId: messageRow.sender_id ?? null,
 170:     },
 171:   };
 172: }
src/app/api/conversations/get/route.ts
   1: // src/app/api/conversations/get/route.ts
   2: import { NextRequest, NextResponse } from 'next/server';
   3: import { ConversationType, Conversation } from '@/types/messaging';
   4: import { IConversationRepository } from '@/repositories/interfaces';
   5: import { SupabaseConversationRepository } from '@/repositories/implementations/supabase';
   6: import { requireAuthUser } from '@/lib/auth/session';
   7: import { PaginationOptions } from '@/types/common';
   8: import { createCorrelationId, jsonSuccess } from '@/lib/api/server-error';
   9: 
  10: // Helper to serialize conversation dates and preferences
  11: function serializeConversation(conversation: Conversation) {
  12:   return {
  13:     ...conversation,
  14:     lastActivity: conversation.lastActivity.toISOString(),
  15:     preferences: conversation.preferences
  16:       ? {
  17:           ...conversation.preferences,
  18:           createdAt: conversation.preferences.createdAt.toISOString(),
  19:           updatedAt: conversation.preferences.updatedAt.toISOString(),
  20:         }
  21:       : undefined,
  22:   };
  23: }
  24: 
  25: export async function GET(request: NextRequest) {
  26:   const correlationId = createCorrelationId();
  27:   const auth = await requireAuthUser({
  28:     correlationId,
  29:     pathname: '/api/conversations/get',
  30:   });
  31:   if ('errorResponse' in auth) {
  32:     return auth.errorResponse;
  33:   }
  34: 
  35:   try {
  36:     const searchParams = new URL(request.url).searchParams;
  37:     const typeParam = searchParams.get('type');
  38:     const includeArchived = searchParams.get('includeArchived') === 'true';
  39:     const limit = Number.parseInt(searchParams.get('limit') || '50', 10);
  40:     const cursor = searchParams.get('cursor') ?? undefined;
  41:     const pinnedOnly = searchParams.get('pinned') === 'true';
  42: 
  43:     const requesterProfile = auth.dbUser;
  44: 
  45:     const conversationRepository: IConversationRepository = new SupabaseConversationRepository(auth.supabase);
  46: 
  47:     if (pinnedOnly) {
  48:       const pinnedConversations = await conversationRepository.findPinnedByUser(requesterProfile.id);
  49: 
  50:       return jsonSuccess({
  51:         conversations: pinnedConversations.map((conversation) => serializeConversation(conversation)),
  52:       }, correlationId);
  53:     }
  54: 
  55:     // Standard paginated query
  56:     const paginationOptions: PaginationOptions & {
  57:       type?: ConversationType;
  58:       includeArchived?: boolean;
  59:     } = {
  60:       limit: Number.isNaN(limit) ? 50 : Math.min(Math.max(limit, 1), 100),
  61:       cursor,
  62:       includeArchived,
  63:     };
  64: 
  65:     if (typeParam === ConversationType.DIRECT || typeParam === ConversationType.ROOM) {
  66:       paginationOptions.type = typeParam;
  67:     }
  68: 
  69:     const result = await conversationRepository.findByUser(requesterProfile.id, paginationOptions);
  70: 
  71:     return jsonSuccess({
  72:       conversations: result.items.map((conversation) => serializeConversation(conversation)),
  73:       nextCursor: result.nextCursor ?? null,
  74:       hasMore: result.hasMore,
  75:     }, correlationId);
  76:   } catch (error) {
  77:     console.error('Error getting conversations:', error);
  78:     return NextResponse.json({ error: 'Failed to retrieve conversations' }, { status: 500 });
  79:   }
  80: }
src/app/api/conversations/join/route.ts
   1: // src/app/api/conversations/join/route.ts
   2: import { NextRequest, NextResponse } from 'next/server';
   3: import { createSupabaseServerClient } from '@/lib/supabase/server-client';
   4: import { requireAuthUser } from '@/lib/auth/session';
   5: import { jsonError } from '@/lib/auth/authorize';
   6: import { ConversationType } from '@/types/messaging';
   7: import { IConversationRepository, ISpaceRepository } from '@/repositories/interfaces';
   8: import { SupabaseConversationRepository, SupabaseSpaceRepository } from 
'@/repositories/implementations/supabase';
   9: import { ConversationResolverError, ConversationResolverService } from 
'@/lib/services/ConversationResolverService';
  10: 
  11: export async function POST(request: NextRequest) {
  12:   try {
  13:     const auth = await requireAuthUser();
  14:     if ('errorResponse' in auth) {
  15:       return auth.errorResponse;
  16:     }
  17:     const { dbUser } = auth;
  18: 
  19:     let body: { conversationId?: unknown };
  20:     try {
  21:       body = await request.json();
  22:     } catch {
  23:       return jsonError(400, 'BAD_REQUEST', 'Invalid JSON payload');
  24:     }
  25: 
  26:     const conversationId = typeof body.conversationId === 'string' ? body.conversationId : null;
  27:     if (!conversationId) {
  28:       return jsonError(400, 'BAD_REQUEST', 'conversationId is required');
  29:     }
  30: 
  31:     const serviceClient = await createSupabaseServerClient('service_role');
  32:     const convoRepo: IConversationRepository = new SupabaseConversationRepository(serviceClient);
  33: 
  34:     const existing = await convoRepo.findById(conversationId);
  35:     if (!existing) {
  36:       return jsonError(404, 'CONVERSATION_NOT_FOUND', 'Conversation not found');
  37:     }
  38: 
  39:     // Idempotent: already a participant â€” nothing to join.
  40:     if (existing.participants.includes(dbUser.id)) {
  41:       return NextResponse.json({ conversation: existing }, { status: 200 });
  42:     }
  43: 
  44:     // Only room conversations are joinable. Direct/group membership is fixed
  45:     // at creation (resolver/invite paths) â€” joining someone else's DM would
  46:     // grant full read/write of its history (audit S-01).
  47:     if (existing.type !== ConversationType.ROOM || !existing.roomId) {
  48:       return jsonError(403, 'JOIN_FORBIDDEN', 'Only room conversations can be joined');
  49:     }
  50: 
  51:     const spaceRepo: ISpaceRepository = new SupabaseSpaceRepository(serviceClient);
  52:     const space = await spaceRepo.findById(existing.roomId);
  53:     if (!space) {
  54:       return jsonError(404, 'ROOM_NOT_FOUND', 'Room not found');
  55:     }
  56: 
  57:     try {
  58:       ConversationResolverService.assertRoomAccess(dbUser, space);
  59:     } catch (accessError) {
  60:       if (accessError instanceof ConversationResolverError) {
  61:         return jsonError(accessError.status, 'ROOM_ACCESS_DENIED', accessError.message);
  62:       }
  63:       throw accessError;
  64:     }
  65: 
  66:     const conversation = await convoRepo.addParticipant(conversationId, dbUser.id);
  67:     if (!conversation) {
  68:       return jsonError(500, 'INTERNAL_ERROR', 'Failed to join conversation');
  69:     }
  70: 
  71:     return NextResponse.json({ conversation }, { status: 200 });
  72:   } catch (error) {
  73:     console.error('Error joining conversation:', error);
  74:     return jsonError(500, 'INTERNAL_ERROR', 'Internal server error');
  75:   }
  76: }

