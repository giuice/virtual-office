 433: 
 434:       const participants: string[] = Array.isArray(conversation?.participants) ? conversation.participants : [];
 435:       if (participants.includes(userId)) {
 436:         // Already a participant; return current conversation state
 437:         const existing = await this.findById(id);
 438:         return existing;
 439:       }
 440: 
 441:       const updatedParticipants = [...participants, userId];
 442: 
 443:       const { data: updated, error: updateError } = await this.supabaseClient
 444:         .from(this.TABLE_NAME)
 445:         .update({ participants: updatedParticipants })
 446:         .eq('id', id)
 447:         .select('*')
 448:         .single();
 449: 
 450:       if (updateError) {
 451:         console.error('Error updating participants in addParticipant:', updateError);
 452:         return null;
 453:       }
 454: 
 455:       return updated ? mapToCamelCase(updated as ConversationRow) : null;
