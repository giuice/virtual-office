 220:       return {
 221:         items,
 222:         nextCursor: nextCursor,
 223:         hasMore: nextCursor !== null,
 224:         totalCount: count ?? undefined,
 225:       };
 226:     } catch (error) {
 227:       console.error(`Repository error in findByUser(${userId}):`, error);
