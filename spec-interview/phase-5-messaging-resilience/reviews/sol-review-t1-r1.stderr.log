   1: -- Phase 4 T5 (spec-interview/phase-4-messaging-timeline): per-message read
   2: -- receipts and an unread counter that follows them.
   3: --
   4: -- BR-001/FR-004: "read" means the message was visibly rendered for the
   5: -- recipient, so the client reports the visible message ids and the server
   6: -- records receipts for exactly those (never for the caller's own messages,
   7: -- BR-002). BR-005/FR-006: the unread counter follows those receipts.
   8: --
   9: -- BR-013 (backward compatible with the published app, which still calls
  10: -- PATCH /api/conversations/read -> mark_conversation_read and reads
  11: -- get_unread_counts):
  12: --   * mark_conversation_read is untouched (still advances last_read_at and
  13: --     writes receipts for every non-sender message).
  14: --   * get_unread_counts keeps its signature, return shape, and ACL. Unread is
  15: --     now "from others, newer than the viewer's last_read_at, and without the
  16: --     viewer's receipt". last_read_at stays the historical floor: messages read
  17: --     before per-message receipts existed (older than last_read_at, no receipt)
  18: --     remain read, so no backfill is needed; mark-all still yields 0. The new
  19: --     per-message path never advances last_read_at.
  20: --
  21: -- Additive only: one new service_role-only RPC plus a CREATE OR REPLACE of
  22: -- get_unread_counts with an identical signature. Re-runnable.
  23: 
  24: -- ============================================================================
  25: -- 1) RPC: record receipts for the given visible message ids.
  26: --    service_role only (same pattern as mark_conversation_read and
  27: --    check_rate_limit): it takes the target user id as a parameter, so it must
  28: --    never be callable by anon/authenticated. The route authorizes first via
  29: --    requireConversationParticipant; the membership check below is defense in
  30: --    depth so the function can never write receipts for a non-member.
  31: -- ============================================================================
  32: create or replace function public.mark_messages_read(
  33:   p_conversation_id uuid,
  34:   p_user_id uuid,
  35:   p_message_ids uuid[]
  36: ) returns integer
  37: language plpgsql
  38: security definer
  39: set search_path = ''
  40: as $$
  41: declare
  42:   v_recorded integer;
  43: begin
  44:   if p_conversation_id is null or p_user_id is null then
  45:     raise exception 'mark_messages_read: conversation and user are required'
  46:       using errcode = '22004';
  47:   end if;
  48: 
  49:   if p_message_ids is null or pg_catalog.cardinality(p_message_ids) = 0 then
  50:     return 0;
  51:   end if;
  52: 
  53:   -- Bounded input: the route caps the batch at 100 ids as well.
  54:   if pg_catalog.cardinality(p_message_ids) > 100 then
  55:     raise exception 'mark_messages_read: at most 100 message ids per call'
  56:       using errcode = '22023';
  57:   end if;
  58: 
  59:   if not exists (
  60:     select 1
  61:     from public.conversation_members cm
  62:     where cm.conversation_id = p_conversation_id
  63:       and cm.user_id = p_user_id
  64:   ) then
  65:     raise exception 'mark_messages_read: user is not a member of the conversation'
  66:       using errcode = '42501';
  67:   end if;
  68: 
  69:   -- Ids outside the conversation are ignored; the caller's own messages never
  70:   -- get a receipt (system messages with a null sender may). Repeats are
  71:   -- idempotent on the unique (message_id, user_id).
  72:   insert into public.message_read_receipts (message_id, conversation_id, user_id)
  73:   select m.id, m.conversation_id, p_user_id
  74:   from public.messages m
  75:   where m.conversation_id = p_conversation_id
  76:     and m.id = any (p_message_ids)
  77:     and m.sender_id is distinct from p_user_id
  78:   on conflict (message_id, user_id) do nothing;
  79: 
  80:   get diagnostics v_recorded = row_count;
  81:   return v_recorded;
  82: end $$;
  83: 
  84: comment on function public.mark_messages_read(uuid, uuid, uuid[]) is
  85:   'Phase 4 T5: records read receipts for visible message ids of a conversation the user is a member of; never 
for the user''s own messages; returns the number of new receipts. service_role only.';
