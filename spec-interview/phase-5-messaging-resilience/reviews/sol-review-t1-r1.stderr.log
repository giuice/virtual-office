 199:           .rpc('get_unread_counts', { p_conversation_ids: items.map((c) => c.id) });
 200: 
 201:         if (countsError) {
 202:           console.error('Error fetching unread counts:', countsError);
 203:         } else if (Array.isArray(counts)) {
 204:           const countByConversation = new Map<string, number>(
 205:             counts.map((row: { conversation_id: string; unread_count: number }) => [
 206:               row.conversation_id,
 207:               Number(row.unread_count) || 0,
 208:             ])
 209:           );
