 354:   async markConversationRead(id: string, userId: string): Promise<boolean> {
 355:     try {
 356:       // Atomic: sets conversation_members.last_read_at AND inserts
 357:       // message_read_receipts for everything the user just saw, in one
 358:       // transaction. The RPC is service-role only; the route authorizes the
 359:       // user via requireConversationParticipant before calling this.
 360:       const { error } = await this.supabaseClient.rpc('mark_conversation_read', {
 361:         p_conversation_id: id,
 362:         p_user_id: userId,
 363:       });
 364: 
 365:       if (error) {
 366:         console.error('Error in mark_conversation_read RPC:', error);
 367:         return false;
 368:       }
 369: 
 370:       return true;
 371:     } catch (error) {
 372:       console.error(`Repository error in markConversationRead(${id}, ${userId}):`, error);
 373:       throw error;
 374:     }
