  97: create or replace function public.get_unread_counts(p_conversation_ids uuid[])
  98: returns table (conversation_id uuid, unread_count bigint)
  99: language sql
 100: stable
 101: security definer
 102: set search_path = public, pg_temp
 103: as $$
 104:   select cm.conversation_id, count(m.id)::bigint
 105:   from public.conversation_members cm
 106:   left join public.messages m
 107:     on m.conversation_id = cm.conversation_id
 108:    and m."timestamp" > coalesce(cm.last_read_at, '-infinity'::timestamptz)
 109:    and m.sender_id is distinct from cm.user_id
