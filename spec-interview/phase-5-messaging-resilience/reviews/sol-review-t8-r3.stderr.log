  44 type MessageCreateData = Omit<Message, 'id' | 'timestamp' | 'reactions' | 'attachments' | 'isEdited'>;
  45 
  46 /** A keyed create: its key and this dispatch's attempt (Phase 5 T2). */
  47 interface KeyedCreate {
  48   clientMessageId: string;
  49   attempt: MessageAttempt;
  50 }
  51 
  52 /**
  53  * Phase 4 FR-024: optional composition key generated by the drawer composer
  54  * and resent on every retry of the same composition. Absent (the published
  55  * app) → legacy create; present → at most one message per key, sender, and
  56  * conversation.
  57  */
  58 function parseClientMessageId(value: unknown): { ok: true; value: string | undefined } | { ok: false } {
  59   if (value === undefined || value === null) {
  60     return { ok: true, value: undefined };
  61   }
  62   if (!isUuid(value)) {
  63     return { ok: false };
  64   }
  65   return { ok: true, value: value.toLowerCase() };
  66 }
  67 
  68 const TOO_MANY_ATTACHMENTS_MESSAGE = `A message can carry at most ${MAX_ATTACHMENTS_PER_MESSAGE} attachments`;
  69 
  70 /**
  71  * Phase 4 T12 (FR-008): optional ids of the caller's pending uploads
  72  * (POST /api/messages/upload) to attach. Absent or empty → no attachments.
  73  */
  74 function parseAttachmentIds(
  75   value: unknown
  76 ): { ok: true; value: string[] | undefined } | { ok: false; code: string; message: string } {
  77   if (value === undefined || value === null) {
  78     return { ok: true, value: undefined };
  79   }
  80   if (!Array.isArray(value) || value.some((id) => !isUuid(id))) {
  81     return { ok: false, code: 'INVALID_ATTACHMENT_ID', message: 'attachmentIds must be an array of upload ids' };
  82   }
  83   const ids = (value as string[]).map((id) => id.toLowerCase());
  84   if (ids.length === 0) {
  85     return { ok: true, value: undefined };
  86   }
  87   if (ids.length > MAX_ATTACHMENTS_PER_MESSAGE) {
  88     return { ok: false, code: 'TOO_MANY_ATTACHMENTS', message: TOO_MANY_ATTACHMENTS_MESSAGE };
  89   }
  90   if (new Set(ids).size !== ids.length) {
  91     return { ok: false, code: 'DUPLICATE_ATTACHMENT', message: 'attachmentIds must not repeat an upload' };
  92   }
  93   return { ok: true, value: ids };
  94 }
