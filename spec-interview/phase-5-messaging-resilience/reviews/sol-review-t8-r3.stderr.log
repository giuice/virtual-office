  69  * A reply target the server can accept: a stored message id (UUID) of the
  70  * same conversation. A pending copy's `temp-<key>` id, or a message of another
  71  * conversation, is never one — queuing a reply to it would only end in a
  72  * definitive 400 that blocks the conversation (BR-003).
  73  */
  74 export class OutboxInvalidReplyTargetError extends Error {
  75   constructor() {
  76     super('The reply target is not a sent message');
  77     this.name = 'OutboxInvalidReplyTargetError';
  78   }
  79 }
  80 
  81 const isOnline = (): boolean => typeof navigator === 'undefined' || navigator.onLine !== false;
  82 
  83 export class MessageOutbox {
  84   readonly ownerId: string;
  85   private readonly queryClient: QueryClient;
  86   private readonly tabId = createTabId();
  87   private readonly conversations = new Map<string, ConversationDrain>();
  88   private readonly confirmed = new Set<string>();
  89   /** Confirmed by a response whose stored message the drain has not shown yet. */
  90   private readonly confirmedNotShown = new Set<string>();
  91   private disposed = false;
  92   private unsubscribeObservations: (() => void) | null = null;
  93 
  94   constructor(ownerId: string, queryClient: QueryClient) {
  95     this.ownerId = ownerId;
  96     this.queryClient = queryClient;
  97   }
  98 
  99   start(): void {
 100     // Pending views outlive an unmounted feed: they are the only copy on screen
 101     // of an item not yet delivered (they hold a few small messages per user).
 102     this.queryClient.setQueryDefaults(['messages-pending'], { gcTime: Infinity, staleTime: Infinity });
 103     window.addEventListener('online', this.handleOnline);
 104     this.unsubscribeObservations = observeStoredMessages(this.queryClient, this.handleStoredObserved);
 105     void this.loadAll();
 106   }
 107 
 108   dispose(): void {
 109     this.disposed = true;
 110     window.removeEventListener('online', this.handleOnline);
 111     this.unsubscribeObservations?.();
 112     this.unsubscribeObservations = null;
 113     this.conversations.forEach((drain) => {
 114       if (drain.retryTimer) clearTimeout(drain.retryTimer);
 115       drain.retryTimer = null;
 116     });
 117   }
 118 
 119   /**
 120    * Durably queues a text/reply message (never files or voice, BR-002) and
 121    * starts its delivery. Resolves once the item is committed to IndexedDB and
 122    * shown as pending; rejects with OutboxStorageError if it cannot be stored,
 123    * and with OutboxInvalidReplyTargetError (nothing stored) when the reply
 124    * target is not a stored message.
 125    */
 126   async enqueue(input: OutboxEnqueueInput): Promise<void> {
 127     if (this.disposed) throw new Error('The outbox of this user is closed');
 128     const clientMessageId = normalizeClientMessageId(input.clientMessageId);
 129     const content = input.content.trim();
 130     if (!clientMessageId || !content) throw new Error('Nothing to send');
 131     const replyToId = input.replyToId ?? null;
 132     // Nothing is written or dispatched; the composer keeps the draft.
 133     if (replyToId !== null && !UUID_PATTERN.test(replyToId)) throw new OutboxInvalidReplyTargetError();
 134     const replyConversationId = input.replyToConversationId ?? null;
 135     if (replyToId !== null && replyConversationId !== null && replyConversationId !== input.conversationId) {
 136       throw new OutboxInvalidReplyTargetError();
 137     }
 138     const now = Date.now();
 139     const item = await addOutboxItem({
 140       ownerId: this.ownerId,
 141       clientMessageId,
 142       conversationId: input.conversationId,
 143       content,
 144       replyToId,
 145       mentionIds: [...(input.mentionIds ?? [])],
 146       pressedSendAt: now,
 147       windowStartedAt: now,
 148       state: 'waiting',
 149       failureReason: null,
 150       attemptGeneration: 0,
 151       claimHolder: null,
 152       leaseExpiresAt: null,
 153       updatedAt: now,
 154       schemaVersion: 1,
 155     });
 156     this.trace('enqueued', { conversationId: item.conversationId, order: item.order });
 157     // The committed item is shown from the write itself, before the composer
 158     // clears: a later read of the outbox may fail, and the message must not
 159     // then be stored but invisible. The re-read only refreshes the others.
 160     this.showItem(item);
 161     void this.refreshView(item.conversationId);
 162     this.drainConversation(item.conversationId);
 163   }
 164 
 165   private readonly handleOnline = () => {
 166     if (this.disposed) return;
 167     this.conversations.forEach((drain) => {
 168       if (drain.retryTimer) clearTimeout(drain.retryTimer);
 169       drain.retryTimer = null;
 170       drain.retryDelayMs = RETRY_BASE_MS;
 171     });
 172     void this.loadAll();
 173   };
 174 
 175   /** A stored message with one of this owner's keys was observed: the item is delivered. */
 176   private readonly handleStoredObserved = (conversationId: string, stored: readonly Message[]) => {
 177     if (this.disposed) return;
 178     const drain = this.conversations.get(conversationId);
 179     if (!drain || drain.keys.size === 0) return;
 180     for (const message of stored) {
 181       const key = normalizeClientMessageId(message.clientMessageId);
 182       if (message.senderId !== this.ownerId || !key || !drain.keys.has(key)) continue;
 183       this.markConfirmed(key);
 184       // The feed now holds the stored message: the copy may go at once.
 185       this.confirmedNotShown.delete(key);
 186       drain.keys.delete(key);
 187       void deleteOutboxItem(this.ownerId, key)
 188         .catch((error) => this.trace('confirm-delete-failed', { error: String(error) }))
 189         .finally(() => void this.refreshView(conversationId));
 190     }
 191   };
 192 
 193   private drain(conversationId: string): ConversationDrain {
 194     let drain = this.conversations.get(conversationId);
 195     if (!drain) {
 196       drain = { running: false, rerun: false, retryTimer: null, retryDelayMs: RETRY_BASE_MS, viewSeq: 0, keys: 
new Set() };
 197       this.conversations.set(conversationId, drain);
 198     }
 199     return drain;
 200   }
 201 
 202   private markConfirmed(clientMessageId: string): void {
 203     this.confirmed.delete(clientMessageId);
 204     this.confirmed.add(clientMessageId);
 205     if (this.confirmed.size > MAX_REMEMBERED_CONFIRMATIONS) {
 206       const oldest = this.confirmed.values().next().value;
 207       if (oldest !== undefined) this.confirmed.delete(oldest);
 208     }
 209   }
 210 
 211   /** Shows every conversation's items and drains each one. */
 212   private async loadAll(): Promise<void> {
 213     let items: OutboxItem[];
 214     try {
 215       items = await listOutboxItems(this.ownerId);
 216     } catch (error) {
 217       this.trace('load-failed', { error: String(error) });
 218       return;
 219     }
 220     if (this.disposed) return;
 221     const conversationIds = new Set(items.map((item) => item.conversationId));
 222     this.conversations.forEach((_drain, conversationId) => conversationIds.add(conversationId));
 223     for (const conversationId of conversationIds) {
 224       writeOutboxView(
 225         this.queryClient,
 226         this.ownerId,
 227         conversationId,
 228         this.visible(items.filter((item) => item.conversationId === conversationId))
 229       );
 230       this.drain(conversationId).keys = new Set(
 231         items.filter((item) => item.conversationId === conversationId).map((item) => item.clientMessageId)
 232       );
 233       this.drainConversation(conversationId);
 234     }
 235   }
 236 
 237   private visible(items: readonly OutboxItem[]): OutboxItem[] {
 238     // A copy stays until its stored message is shown (never no bubble).
 239     return items.filter(
 240       (item) => !this.confirmed.has(item.clientMessageId) || this.confirmedNotShown.has(item.clientMessageId)
 241     );
 242   }
 243 
 244   /** Re-reads the conversation's items and renders them (latest read wins). */
 245   private async refreshView(conversationId: string): Promise<void> {
 246     const drain = this.drain(conversationId);
 247     drain.viewSeq += 1;
 248     const seq = drain.viewSeq;
 249     let items: OutboxItem[];
 250     try {
 251       items = await listOutboxItems(this.ownerId, conversationId);
 252     } catch (error) {
 253       this.trace('view-read-failed', { error: String(error) });
 254       return;
 255     }
 256     if (this.disposed || seq !== drain.viewSeq) return;
 257     drain.keys = new Set(items.map((item) => item.clientMessageId));
 258     writeOutboxView(this.queryClient, this.ownerId, conversationId, this.visible(items));
 259   }
 260 
 261   private drainConversation(conversationId: string): void {
 262     if (this.disposed) return;
 263     const drain = this.drain(conversationId);
 264     if (drain.running) {
 265       drain.rerun = true;
 266       return;
 267     }
 268     drain.running = true;
 269     drain.rerun = false;
 270     void this.withDrainLock(conversationId)
 271       .catch((error) => {
 272         this.trace('drain-failed', { error: String(error) });
 273         this.scheduleRetry(conversationId);
 274       })
 275       .finally(() => {
 276         drain.running = false;
 277         if (drain.rerun && !this.disposed) this.drainConversation(conversationId);
 278       });
 279   }
 280 
 281   /** Runs the drain loop while holding the conversation's cross-tab lock (when Web Locks exist). */
 282   private async withDrainLock(conversationId: string): Promise<void> {
 283     const locks = typeof navigator !== 'undefined' ? navigator.locks : undefined;
 284     if (!locks) {
 285       await this.drainLoop(conversationId);
 286       return;
 287     }
 288     const name = `vo-messaging-outbox:${this.ownerId}:${conversationId}`;
 289     const acquired = await locks.request(name, { ifAvailable: true }, async (lock) => {
 290       if (!lock) return false;
 291       await this.drainLoop(conversationId);
 292       return true;
 293     });
 294     if (!acquired) this.scheduleRetry(conversationId, LOCK_BUSY_RETRY_MS);
 295   }
 296 
 297   private async drainLoop(conversationId: string): Promise<void> {
 298     // A delivered item is removed together with the next claim (one
 299     // transaction), or on its own when the drain stops before that. Its
 300     // stored message is shown right after the next create is dispatched, so
 301     // rendering it does not delay that create (D1).
 302     let confirmedKey: string | null = null;
 303     let showConfirmed: (() => void) | null = null;
 304     const flushShow = () => {
 305       showConfirmed?.();
 306       showConfirmed = null;
 307     };
 308     try {
 309       while (!this.disposed && isOnline()) {
 310         const claim = await claimOldestOutboxItem(
 311           this.ownerId,
 312           conversationId,
 313           this.tabId,
 314           CLAIM_LEASE_MS,
 315           confirmedKey
 316         );
 317         confirmedKey = null;
 318         if (claim.kind !== 'claimed') {
 319           if (claim.kind === 'empty') this.drain(conversationId).retryDelayMs = RETRY_BASE_MS;
 320           return;
 321         }
 322         const { item } = claim;
 323         this.showItem(item);
 324         const attempt = this.attempt(item);
 325         flushShow();
 326         const outcome = await attempt;
 327         if (this.disposed) return;
 328         this.trace('attempt', { conversationId, generation: item.attemptGeneration, outcome: outcome.kind });
 329         if (outcome.kind === 'delivered') {
 330           const { message } = outcome;
 331           this.confirmDelivered(item);
 332           this.confirmedNotShown.add(item.clientMessageId);
 333           showConfirmed = () => {
 334             this.confirmedNotShown.delete(item.clientMessageId);
 335             showConfirmedOutboxMessage(this.queryClient, this.ownerId, conversationId, item.clientMessageId, 
message);
 336           };
 337           confirmedKey = item.clientMessageId;
 338           continue;
 339         }
 340         await this.recordUndelivered(item, outcome);
 341         return;
 342       }
 343     } finally {
 344       if (!this.disposed) flushShow();
 345       if (confirmedKey !== null) await deleteOutboxItem(this.ownerId, confirmedKey);
 346     }
 347   }
 348 
 349   private async attempt(item: OutboxItem): Promise<OutboxAttemptOutcome> {
 350     try {
 351       const response = await messagingApi.createMessageAttempt({
 352         conversationId: item.conversationId,
 353         content: item.content,
 354         replyToId: item.replyToId,
 355         clientMessageId: item.clientMessageId,
 356         attemptGeneration: item.attemptGeneration,
 357         expectedSenderId: this.ownerId,
 358         mentionIds: item.mentionIds,
 359       });
 360       return classifyAttemptResponse(response, {
 361         senderId: this.ownerId,
 362         conversationId: item.conversationId,
 363         clientMessageId: item.clientMessageId,
 364         content: item.content,
 365         replyToId: item.replyToId,
 366       });
 367     } catch {
 368       // No response (network error, the browser went offline mid-request).
 369       return { kind: 'unknown', status: null };
 370     }
 371   }
 372 
 373   /**
 374    * The server confirmed the item: from now on it is never shown again as
 375    * pending (its stored message is shown by the drain, showConfirmedOutboxMessage).
 376    */
 377   private confirmDelivered(item: OutboxItem): void {
 378     const { conversationId, clientMessageId } = item;
 379     this.markConfirmed(clientMessageId);
 380     this.drain(conversationId).keys.delete(clientMessageId);
 381     this.drain(conversationId).retryDelayMs = RETRY_BASE_MS;
 382   }
 383 
 384   /** Records an outcome other than delivered; the drain of the conversation stops. */
 385   private async recordUndelivered(
 386     item: OutboxItem,
 387     outcome: Exclude<OutboxAttemptOutcome, { kind: 'delivered' }>
 388   ): Promise<void> {
 389     const { conversationId, clientMessageId } = item;
 390     const ownAttempt = (current: OutboxItem) =>
 391       current.claimHolder === this.tabId && current.attemptGeneration === item.attemptGeneration;
 392     const now = Date.now();
 393     if (outcome.kind === 'failed') {
 394       const current = await updateOutboxItem(this.ownerId, clientMessageId, (stored) =>
 395         ownAttempt(stored)
 396           ? { ...stored, state: 'failed', failureReason: outcome.reason, claimHolder: null, leaseExpiresAt: null, 
updatedAt: now }
 397           : undefined
 398       );
 399       await this.showStored(conversationId, current);
 400       return;
 401     }
 402     // transient → waiting; unknown / superseded → unknown (it may be stored).
 403     const state = outcome.kind === 'transient' ? 'waiting' : 'unknown';
 404     const current = await updateOutboxItem(this.ownerId, clientMessageId, (stored) =>
 405       ownAttempt(stored) ? { ...stored, state, claimHolder: null, leaseExpiresAt: null, updatedAt: now } : 
undefined
 406     );
 407     await this.showStored(conversationId, current);
 408     this.scheduleRetry(conversationId);
 409   }
 410 
 411   /**
 412    * Shows `item` as just read or written by this tab, without reading the
 413    * outbox again (unless it was confirmed meanwhile). An older re-read still
 414    * in flight is superseded, so it cannot put back a previous state.
 415    */
 416   private showItem(item: OutboxItem): void {
 417     if (this.disposed || this.confirmed.has(item.clientMessageId)) return;
 418     const drain = this.drain(item.conversationId);
 419     drain.viewSeq += 1;
 420     drain.keys.add(item.clientMessageId);
 421     publishOutboxItem(this.queryClient, item);
 422   }
 423 
 424   /** Shows the item's stored state after an update; re-reads when it is gone. */
 425   private async showStored(conversationId: string, item: OutboxItem | null): Promise<void> {
 426     if (item) {
 427       this.showItem(item);
 428     } else {
 429       await this.refreshView(conversationId);
 430     }
 431   }
 432 
 433   private scheduleRetry(conversationId: string, delayMs?: number): void {
 434     if (this.disposed) return;
 435     const drain = this.drain(conversationId);
 436     if (drain.retryTimer) return;
 437     const delay = delayMs ?? drain.retryDelayMs;
 438     if (delayMs === undefined) drain.retryDelayMs = Math.min(drain.retryDelayMs * 2, RETRY_MAX_MS);
 439     drain.retryTimer = setTimeout(() => {
 440       drain.retryTimer = null;
 441       this.drainConversation(conversationId);
 442     }, delay);
 443   }
 444 
 445   private trace(event: string, details: Record<string, unknown>): void {
 446     if (debugLogger.messaging.enabled()) {
 447       debugLogger.messaging.event(SCOPE, event, details);
 448     }
 449   }
 450 }

