 202 ): void {
 203   const pendingKey = pendingMessagesQueryKey(ownerId, conversationId);
 204   const feedKey = ['messages', conversationId] as const;
 205   const unresolved = isPendingMessage(queryClient.getQueryData<Message[]>(pendingKey), clientMessageId);
