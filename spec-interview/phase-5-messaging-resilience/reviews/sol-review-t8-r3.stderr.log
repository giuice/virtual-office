 845   test('review r1 #3: when the outbox read right after a committed write fails, the item still shows as pending 
and is delivered once', async ({
 846     phase5World,
 847     openDevice,
 848   }) => {
 849     const { directId } = phase5World.conversations;
 850     const a = await openDevice('A');
 851     const b = await openDevice('B');
 852     await createViaApi(a.page, { conversationId: directId, content: `t8 warm-up ${randomUUID()}` });
 853     await openConversation(b.page, directId);
 854     await waitForRealtimeReady(b.page);
 855 
 856     // Once armed: the first read-only transaction opened after the outbox
 857     // write is aborted — the read the app makes right after the commit (a
 858     // storage read failure right after a successful write).
 859     await a.context.addInitScript(() => {
 860       const scope = window as unknown as { __t8ArmReadAbort: boolean; __t8ReadAborts: number; __t8AbortNextRead: 
boolean };
 861       scope.__t8ArmReadAbort = false;
 862       scope.__t8ReadAborts = 0;
 863       scope.__t8AbortNextRead = false;
 864       const add = IDBObjectStore.prototype.add;
 865       IDBObjectStore.prototype.add = function armedAdd(this: IDBObjectStore, ...args: 
Parameters<IDBObjectStore['add']>) {
 866         const request = add.apply(this, args);
