 156     const result = await db.query<StoredRow>(
 157       `select id::text as id, client_message_id::text as key, content, reply_to_id::text as reply_to_id,
 158               sender_id::text as sender_id
 159          from public.messages
 160         where conversation_id = $1 and content = any($2::text[])
 161         order by "timestamp", id`,
