 436         lastResponseMs: lastResponse - reconnectedAt,
 437         lastArrivalMs: lastArrival - reconnectedAt,
 438         createMs: sent.map((attempt) => (attempt.endedAt ?? 0) - attempt.startedAt),
 439         gapMs: sent.slice(1).map((attempt, index) => attempt.startedAt - (sent[index].endedAt ?? 0)),
 440       }),
