 128 // Responses carry the message, its attachments and reactions — not other
 129 // users' pins or stars, which findById (service client) also loads. Keyed
 130 // responses carry the key (FR-034) on the message and at the top level, plus
 131 // the attempt generation they answer.
 132 function messageResponse(message: Message, status: 200 | 201, keyed?: KeyedCreate): NextResponse {
 133   const responseMessage: Message = { ...message, pins: undefined, stars: undefined };
 134   if (!keyed) {
 135     return NextResponse.json({ message: responseMessage }, { status });
 136   }
 137   return NextResponse.json(
 138     {
 139       message: { ...responseMessage, clientMessageId: keyed.clientMessageId },
 140       clientMessageId: keyed.clientMessageId,
 141       ...(keyed.attempt.generation !== undefined ? { attemptGeneration: keyed.attempt.generation } : {}),
 142     },
 143     { status }
 144   );
 145 }
