  23 const normalizeDate = (value: unknown): Date => {
  24   if (value instanceof Date) {
  25     return value;
  26   }
  27 
  28   if (typeof value === 'string' || typeof value === 'number') {
  29     const parsed = new Date(value);
  30     if (!Number.isNaN(parsed.getTime())) {
  31       return parsed;
  32     }
  33   }
  34 
  35   return new Date(0);
