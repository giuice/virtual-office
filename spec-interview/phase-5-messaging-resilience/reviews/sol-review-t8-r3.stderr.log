 238   } else if (!keyed) {
 239     // Unknown, another user's, another conversation's, cancelled, or sent.
 240     return attachmentNotFound();
 241   }
 242   // With a key and missing uploads the database decides: a replay of a
 243   // committed create (its uploads were consumed) or ATTACHMENT_NOT_FOUND.
 244 
 245   let outcome: { messageId: string; created: boolean; storedComposition?: MessageComposition | null };
 246   try {
 247     outcome = await uploads.createMessageWithAttachments(
 248       { ...messageData, type },
 249       attachmentIds,
