 222   keyed: KeyedCreate | undefined
 223 ): Promise<NextResponse> {
 224   const owned = await uploads.findOwned(attachmentIds, messageData.senderId, messageData.conversationId);
 225 
 226   let type = MessageType.FILE;
 227   const allUploadsPending = owned.length === attachmentIds.length;
 228   if (allUploadsPending) {
