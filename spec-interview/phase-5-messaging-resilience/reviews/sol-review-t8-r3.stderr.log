 413       .poll(async () => Object.keys((await readArrivals(b.page)).first).length, { timeout: D1_DEADLINE_MS })
 414       .toBe(10);
 415     const arrivals = await readArrivals(b.page);
 416     const lastArrival = Math.max(...texts.map((text) => arrivals.first[text]));
 417     expect(lastArrival - reconnectedAt, 'B saw all ten within 10 s of 
reconnecting').toBeLessThanOrEqual(D1_DEADLINE_MS);
