 303 // src/hooks/useMessageOutbox.ts
 304 // Phase 5 T8: runs the signed-in user's durable message outbox (one per
 305 // application user, users.id) for as long as the messaging provider is
 306 // mounted, and returns the function that queues a text/reply send.
 307 import { useCallback, useEffect, useRef } from 'react';
 308 import { useQueryClient } from '@tanstack/react-query';
 309 
 310 import { MessageOutbox } from '@/lib/messaging/outbox/message-outbox';
 311 import type { OutboxEnqueueInput } from '@/types/message-outbox';
 312 
 313 export type QueueTextMessage = (input: OutboxEnqueueInput) => Promise<void>;
 314 
 315 export function useMessageOutbox(ownerId: string | null | undefined): QueueTextMessage {
 316   const queryClient = useQueryClient();
 317   const outboxRef = useRef<MessageOutbox | null>(null);
 318 
 319   useEffect(() => {
 320     if (!ownerId) return;
 321     const outbox = new MessageOutbox(ownerId, queryClient);
 322     outboxRef.current = outbox;
 323     outbox.start();
 324     return () => {
 325       outbox.dispose();
 326       if (outboxRef.current === outbox) outboxRef.current = null;
 327     };
 328   }, [ownerId, queryClient]);
 329 
 330   return useCallback(
 331     async (input: OutboxEnqueueInput) => {
 332       const outbox = outboxRef.current;
 333       if (!outbox || outbox.ownerId !== ownerId) {
 334         throw new Error('The message outbox is not ready');
 335       }
 336       await outbox.enqueue(input);
 337     },
 338     [ownerId]
 339   );
 340 }

