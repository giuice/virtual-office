 589   test('AC-039: when the outbox write fails nothing is sent and the draft stays; once writes work it is sent', 
async ({
 590     phase5World,
 591     openDevice,
 592   }) => {
 593     const { directId } = phase5World.conversations;
 594     const a = await openDevice('A');
 595     const b = await openDevice('B');
 596     const parentText = `t8 d5w parent ${randomUUID()}`;
 597     const parentId = await createViaApi(a.page, { conversationId: directId, content: parentText });
 598     await openConversation(b.page, directId);
 599     await waitForRealtimeReady(b.page);
 600 
 601     // Writes to the outbox fail to commit (the transaction aborts, as when the
 602     // site's storage quota is exhausted); opening and reading still work.
 603     await a.context.addInitScript(() => {
 604       const scope = window as unknown as { __t8FailOutboxWrites: boolean };
 605       scope.__t8FailOutboxWrites = true;
 606       const failWrite = (store: IDBObjectStore) => {
 607         if (!scope.__t8FailOutboxWrites) return;
 608         queueMicrotask(() => {
 609           try {
 610             store.transaction.abort();
 611           } catch {
 612             // Already finished.
 613           }
 614         });
 615       };
 616       const add = IDBObjectStore.prototype.add;
 617       IDBObjectStore.prototype.add = function failingAdd(this: IDBObjectStore, ...args: 
Parameters<IDBObjectStore['add']>) {
 618         const request = add.apply(this, args);
 619         failWrite(this);
 620         return request;
 621       };
 622     });
 623     await a.page.goto('/floor-plan');
 624     await openConversation(a.page, directId);
 625     const creates = trackCreates(a.page);
 626 
 627     await a.page.getByTestId(`reply-button-${parentId}`).click();
 628     const replyPreview = composer(a.page).getByTestId('reply-composer-preview');
 629     await expect(replyPreview).toContainText(parentText);
 630     const text = `t8 write fails ${randomUUID()}`;
 631     await sendFromComposer(a.page, text);
 632 
 633     const storageError = composer(a.page).getByTestId('composer-storage-error');
 634     await expect(storageError).toHaveText(D5_TEXT);
 635     await expect(composerInput(a.page)).toHaveValue(text);
 636     await expect(replyPreview).toContainText(parentText);
 637     await expect(a.page.locator('[data-testid="messages-feed"] [data-testid^="message-temp-"]')).toHaveCount(0);
 638     await a.page.waitForTimeout(1_500);
 639     expect(creates, 'zero create requests').toHaveLength(0);
 640     expect(await readOutbox(a.page)).toHaveLength(0);
 641     expect(await storedWithTexts(directId, [text])).toHaveLength(0);
 642 
 643     // Writes work again: the same draft is queued and delivered once.
 644     await a.page.evaluate(() => {
 645       (window as unknown as { __t8FailOutboxWrites: boolean }).__t8FailOutboxWrites = false;
 646     });
 647     await composer(a.page).getByTestId('message-send-button').click();
 648     await expect(composerInput(a.page)).toHaveValue('');
 649     await expect(storageError).toBeHidden();
 650     await expect.poll(async () => (await storedWithTexts(directId, [text])).length, { timeout: STEP_TIMEOUT_MS 
}).toBe(1);
 651     const stored = await storedWithTexts(directId, [text]);
 652     expect(stored[0].reply_to_id).toBe(parentId);
 653     expect(creates).toHaveLength(1);
 654     expect(creates[0].body).toMatchObject({ content: text, replyToId: parentId, attemptGeneration: 1 });
 655     await expect(b.page.getByTestId(`reply-count-${parentId}`)).toHaveText(/1 reply/, { timeout: STEP_TIMEOUT_MS 
});
 656   });
