 738     const pendingId = `temp-${pending.clientMessageId}`;
 739 
 740     // A stored message offers both Reply controls; the pending copy offers none.
 741     await expect(a.page.getByTestId(`reply-button-${storedId}`)).toBeVisible();
 742     await a.page.getByTestId(`message-${storedId}`).hover();
 743     await expect(a.page.getByTestId(`message-action-reply-${storedId}`)).toBeVisible();
 744     await expect(a.page.getByTestId(`reply-button-${pendingId}`)).toHaveCount(0);
 745     await a.page.getByTestId(`message-${pendingId}`).hover();
 746     await expect(a.page.getByTestId(`message-actions-${pendingId}`)).toBeVisible();
 747     await expect(a.page.getByTestId(`message-action-reply-${pendingId}`)).toHaveCount(0);
 748     await expect(composer(a.page).getByTestId('reply-composer-preview')).toHaveCount(0);
