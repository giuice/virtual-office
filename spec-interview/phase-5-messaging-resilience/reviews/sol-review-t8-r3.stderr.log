 257 /** Holds every create of `page` until `release()`, then passes it to the real server. */
 258 async function holdCreates(page: Page): Promise<{ count(): number; release(): void }> {
 259   let release!: () => void;
 260   const released = new Promise<void>((resolve) => {
 261     release = resolve;
 262   });
 263   let count = 0;
 264   await page.route('**/api/messages/create', async (route: Route) => {
 265     count += 1;
 266     await released;
 267     await route.continue();
 268   });
 269   return { count: () => count, release };
 270 }
