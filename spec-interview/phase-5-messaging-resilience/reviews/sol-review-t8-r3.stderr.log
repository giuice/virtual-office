replay confirms once', async ({
 970     phase5World,
 971     openDevice,
 972   }) => {
 973     const { directId } = phase5World.conversations;
 974     const a = await openDevice('A');
 975     const b = await openDevice('B');
 976     await createViaApi(a.page, { conversationId: directId, content: `t8 warm-up ${randomUUID()}` });
 977     await openConversation(b.page, directId);
 978     await waitForRealtimeReady(b.page);
 979     const text = `t8 malformed ack ${randomUUID()}`;
 980     await watchArrivals(b.page, [text]);
 981 
 982     // A queues the message offline and closes the tab. The next tab never
 983     // loads this conversation's feed (no restored conversation), so only a
 984     // create response can confirm the item — not the feed or Realtime.
 985     await openConversation(a.page, directId);
 986     await goOffline(a.page);
 987     const [item] = await queueOffline(a, directId, [text]);
 988     await a.page.evaluate(() => window.localStorage.removeItem('messaging_active_conversation_id'));
 989     await a.page.close();
 990 
 991     // Attempt 1: 204 without a body (never reaches the server). Attempt 2:
 992     // reaches the server, which stores the message; its 201 reaches the page
 993     // without the message text. Attempt 3: passed through (the server's replay).
 994     const attempts: Array<{ body: Record<string, unknown>; serverStatus?: number }> = [];
 995     const reopened = await a.newTab();
 996     await reopened.route('**/api/messages/create', async (route: Route) => {
 997       const attempt = { body: (route.request().postDataJSON() ?? {}) as Record<string, unknown> } as {
 998         body: Record<string, unknown>;
 999         serverStatus?: number;
1000       };
1001       attempts.push(attempt);
1002       if (attempts.length === 1) {
1003         await route.fulfill({ status: 204 });
1004         return;
1005       }
1006       const response = await route.fetch();
1007       attempt.serverStatus = response.status();
1008       if (attempts.length === 2) {
1009         const json = (await response.json()) as { message?: Record<string, unknown> };
1010         if (json.message) delete json.message.content;
1011         await route.fulfill({ response, json });
1012         return;
1013       }
1014       await route.fulfill({ response });
1015     });
1016     await a.context.setOffline(false);
1017     await reopened.goto('/floor-plan');
1018 
1019     await expect.poll(async () => (await readOutbox(reopened)).length, { timeout: STEP_TIMEOUT_MS }).toBe(0);
1020     expect(attempts.map((attempt) => [attempt.body.clientMessageId, attempt.body.attemptGeneration, 
attempt.serverStatus])).toEqual([
1021       [item.clientMessageId, 1, undefined],
1022       [item.clientMessageId, 2, 201],
1023       [item.clientMessageId, 3, 200],
1024     ]);
1025     const stored = await storedWithTexts(directId, [text]);
