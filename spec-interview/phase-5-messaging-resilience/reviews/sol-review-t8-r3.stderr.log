 768   test('review r1 #2: a 2xx without the item\'s stored message keeps the item, which is delivered once on a later 
generation', async ({
 769     phase5World,
 770     openDevice,
 771   }) => {
 772     const { directId } = phase5World.conversations;
 773     const a = await openDevice('A');
 774     const b = await openDevice('B');
 775     await createViaApi(a.page, { conversationId: directId, content: `t8 warm-up ${randomUUID()}` });
 776     await openConversation(b.page, directId);
 777     await waitForRealtimeReady(b.page);
 778     await openConversation(a.page, directId);
 779     const text = `t8 unusable ack ${randomUUID()}`;
 780     await watchArrivals(b.page, [text]);
 781 
 782     // Network-level faults on the first three attempts: answers that never
 783     // reached the server — 201 with an empty object, with an array, and with
 784     // another key's message. The fourth attempt is held, then passed through.
 785     const attempts: Array<Record<string, unknown>> = [];
 786     let release!: () => void;
 787     const released = new Promise<void>((resolve) => {
 788       release = resolve;
 789     });
 790     await a.page.route('**/api/messages/create', async (route: Route) => {
 791       const body = (route.request().postDataJSON() ?? {}) as Record<string, unknown>;
 792       attempts.push(body);
 793       const fulfil201 = (payload: unknown) =>
 794         route.fulfill({ status: 201, contentType: 'application/json', body: JSON.stringify(payload) });
 795       if (attempts.length === 1) return fulfil201({ message: {} });
 796       if (attempts.length === 2) return fulfil201({ message: [] });
 797       if (attempts.length === 3) {
 798         return fulfil201({
 799           clientMessageId: body.clientMessageId,
 800           message: {
 801             id: randomUUID(),
 802             conversationId: directId,
 803             senderId: a.user.userId,
 804             content: text,
 805             clientMessageId: randomUUID(),
 806             timestamp: new Date().toISOString(),
 807             reactions: [],
 808           },
 809         });
 810       }
 811       await released;
 812       return route.continue();
 813     });
 814 
 815     await sendFromComposer(a.page, text);
 816     await expect(composerInput(a.page)).toHaveValue('');
 817     await expect.poll(() => attempts.length, { timeout: STEP_TIMEOUT_MS }).toBe(4);
 818     const key = String(attempts[0].clientMessageId);
 819     expect(attempts.map((attempt) => [attempt.clientMessageId, attempt.attemptGeneration])).toEqual([
 820       [key, 1],
 821       [key, 2],
 822       [key, 3],
 823       [key, 4],
 824     ]);
 825     // The item survived every unusable answer and is still being sent.
 826     await expectPendingLabel(a.page, key, 'sending', 'enviando');
 827     expect((await readOutbox(a.page)).map((row) => [row.clientMessageId, row.state, 
row.attemptGeneration])).toEqual([
 828       [key, 'claimed', 4],
 829     ]);
 830     expect(await storedWithTexts(directId, [text])).toHaveLength(0);
 831 
 832     release();
 833     await expect.poll(async () => (await storedWithTexts(directId, [text])).length, { timeout: STEP_TIMEOUT_MS 
}).toBe(1);
 834     const stored = await storedWithTexts(directId, [text]);
 835     expect(stored[0].key).toBe(key);
 836     await expectDeliveredInFeed(a.page, stored);
 837     await expect(b.page.getByTestId(`message-${stored[0].id}`)).toBeVisible({ timeout: STEP_TIMEOUT_MS });
 838     await expect.poll(async () => (await readOutbox(a.page)).length).toBe(0);
 839     await b.page.waitForTimeout(1_500);
 840     expect(attempts).toHaveLength(4);
 841     expect((await readArrivals(b.page)).max[text]).toBe(1);
 842     expect(await storedWithTexts(directId, [text])).toHaveLength(1);
 843   });
