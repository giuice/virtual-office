 134 /** BR-003: each create of the conversation started only after the previous one ended. */
 135 function expectNoOverlap(attempts: readonly CreateAttempt[]): void {
 136   for (let index = 1; index < attempts.length; index += 1) {
 137     const previous = attempts[index - 1];
 138     expect(previous.endSeq, `create ${index - 1} ended`).toBeDefined();
 139     expect(attempts[index].startSeq, `create ${index} starts after create ${index - 1} ended`).toBeGreaterThan(
 140       previous.endSeq as number,
 141     );
 142   }
 143 }
