 201 /** Records, in the page, when each text first shows in the feed and the most bubbles it ever had at once. */
 202 async function watchArrivals(page: Page, texts: readonly string[]): Promise<void> {
 203   await page.evaluate((tracked: string[]) => {
 204     const state = { evaluations: 0, first: {} as Record<string, number>, max: {} as Record<string, number> };
 205     const evaluate = () => {
 206       state.evaluations += 1;
 207       const counts: Record<string, number> = {};
 208       const feed = document.querySelector('[data-testid="messages-feed"]');
 209       for (const item of feed ? Array.from(feed.querySelectorAll('[data-testid^="message-"][data-thread-depth]')) 
: []) {
 210         const own = Array.from(item.querySelectorAll('p')).map((paragraph) => paragraph.textContent ?? '');
 211         for (const text of tracked) {
 212           if (own.includes(text)) counts[text] = (counts[text] ?? 0) + 1;
 213         }
 214       }
 215       const now = Date.now();
 216       for (const text of tracked) {
 217         const count = counts[text] ?? 0;
 218         if (count > 0 && state.first[text] === undefined) state.first[text] = now;
 219         state.max[text] = Math.max(state.max[text] ?? 0, count);
 220       }
 221     };
