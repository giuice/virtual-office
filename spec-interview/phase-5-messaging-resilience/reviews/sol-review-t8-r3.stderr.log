 123 // Ids of messages this client saw deleted through a Realtime DELETE event, per
 124 // query client, bounded to the last 1000 (the oldest are forgotten first).
 125 // Only three merges consult it: a create response (useMessages), a Realtime
 126 // INSERT (useMessageSubscription) and the re-merge after an in-flight fetch
 127 // (keepMessageThroughInflightFetch). It does not reconcile deletions this
 128 // client missed (e.g. during a Realtime stream gap), and fetched pages are
 129 // not filtered by it: a feed GET that read the row before it was deleted can
 130 // still return it. No product path deletes stored messages today; the only
 131 // deletion is a sender's own Data API delete under RLS (delete_own_messages).
 132 const MAX_REMEMBERED_DELETIONS = 1000;
 133 const deletedMessageIds = new WeakMap<QueryClient, Set<string>>();
 134 
 135 export function markMessageDeleted(queryClient: QueryClient, messageId: string): void {
 136   let ids = deletedMessageIds.get(queryClient);
 137   if (!ids) {
 138     ids = new Set();
 139     deletedMessageIds.set(queryClient, ids);
 140   }
 141   ids.delete(messageId);
 142   ids.add(messageId);
 143   if (ids.size > MAX_REMEMBERED_DELETIONS) {
 144     const oldest = ids.values().next().value;
 145     if (oldest !== undefined) ids.delete(oldest);
 146   }
 147 }
 148 
 149 export function isMessageDeleted(queryClient: QueryClient, messageId: string): boolean {
 150   return deletedMessageIds.get(queryClient)?.has(messageId) ?? false;
 151 }
 152 
 153 /**
 154  * Merges a stored message (a Realtime INSERT, a create response) into the
 155  * infinite-query cache:
 156  * - id already present in ANY page → no-op (realtime echo / duplicate event);
 157  * - otherwise → appended to page 0, the newest window.
 158  * Pending messages live outside this cache (pendingMessagesQueryKey) and are
 159  * matched to stored ones by key only (visiblePendingMessages).
 160  */
 161 export function appendMessageToPages(
 162   oldData: MessagesInfiniteData | undefined,
 163   message: Message
 164 ): MessagesInfiniteData {
 165   if (!oldData || !oldData.pages || oldData.pages.length === 0) {
 166     return { pages: [{ messages: [message] }], pageParams: [undefined] };
 167   }
 168 
 169   for (const page of oldData.pages) {
 170     if (page.messages.some((existing) => existing.id === message.id)) {
 171       return oldData;
 172     }
 173   }
 174 
 175   const pages = [...oldData.pages];
 176   pages[0] = { ...pages[0], messages: [...pages[0].messages, message] };
 177   return { ...oldData, pages };
 178 }
 179 
 180 const messagesQueryKey = (conversationId: string) => ['messages', conversationId] as const;
 181 
 182 const isMessageCached = (data: MessagesInfiniteData | undefined, messageId: string): boolean =>
 183   Boolean(data?.pages?.some((page) => page.messages.some((existing) => existing.id === messageId)));
 184 
 185 /**
 186  * Whether a conversation's feed cache holds the message right now. Components
 187  * render the feed from a provider that re-renders only once TanStack Query
 188  * delivers its (deferred) observer notification, so the rendered list can
 189  * briefly lag behind the cache.
 190  */
 191 export function isMessageInFeedCache(
 192   queryClient: QueryClient,
 193   conversationId: string,
 194   messageId: string
 195 ): boolean {
 196   return isMessageCached(
 197     queryClient.getQueryData<MessagesInfiniteData>(messagesQueryKey(conversationId)),
 198     messageId
 199   );
 200 }
 201 
 202 /**
 203  * Keeps a just-merged message (a resolved send, a realtime INSERT) in the
 204  * feed when a fetch of that feed is already in flight.
 205  *
 206  * A fetch resolves with the server rows it read when it started and replaces
 207  * the cached pages. If the message was committed after that read, the result
 208  * lacks it and would silently drop it from the feed until some later
 209  * refetch. Once the in-flight fetch settles the message is merged again
 210  * (a no-op when the result already has it). If the message leaves the cache
 211  * while the fetch is still running (deleted, or a failed send rolled back),
 212  * it is not brought back, and neither is a message this client has seen
 213  * deleted by a Realtime DELETE (isMessageDeleted) by the time the fetch
 214  * settles.
 215  */
 216 export function keepMessageThroughInflightFetch(
 217   queryClient: QueryClient,
 218   conversationId: string,
 219   message: Message
 220 ): void {
 221   const queryKey = messagesQueryKey(conversationId);
 222   const queryCache = queryClient.getQueryCache();
 223   const query = queryCache.find<MessagesInfiniteData>({ queryKey, exact: true });
 224   if (!query || query.state.fetchStatus !== 'fetching') {
 225     return;
 226   }
 227 
 228   const unsubscribe = queryCache.subscribe((event) => {
 229     if (event.query !== query) {
 230       return;
 231     }
 232     if (event.type === 'removed') {
 233       unsubscribe();
 234       return;
 235     }
 236     if (event.type !== 'updated') {
 237       return;
 238     }
 239     if (query.state.fetchStatus === 'fetching') {
 240       // Until the fetch settles, data only changes through local updates.
 241       if (!isMessageCached(query.state.data, message.id)) {
 242         unsubscribe();
 243       }
 244       return;
 245     }
 246     unsubscribe();
 247     if (isMessageDeleted(queryClient, message.id)) {
 248       return;
 249     }
 250     queryClient.setQueryData<MessagesInfiniteData | undefined>(queryKey, (oldData) =>
 251       oldData ? appendMessageToPages(oldData, message) : oldData
 252     );
 253   });
 254 }

