 184 /**
 185  * Database refusals of a create (fenced attempt, validation race, explicit
 186  * membership refusal, insertion quota) as BR-005 / FR-008 outcomes; null
 187  * otherwise — grant and other infrastructure failures answer 500 (recoverable).
 188  */
 189 function createRefusal(error: unknown): NextResponse | null {
 190   if (error instanceof InsertionRateLimitError) {
 191     return error.reason === 'exceeded' ? rateLimitExceededResponse() : rateLimitUnavailableResponse();
 192   }
 193   if (error instanceof AttemptSupersededError) {
 194     return attemptSupersededResponse();
 195   }
 196   if (error instanceof MessageDeletedError) {
 197     return messageDeletedResponse();
 198   }
 199   if (error instanceof AttachmentLinkError) {
 200     return attachmentLinkFailure(error);
 201   }
 202   if (error instanceof NotParticipantError) {
 203     return notParticipant();
 204   }
 205   return null;
 206 }
