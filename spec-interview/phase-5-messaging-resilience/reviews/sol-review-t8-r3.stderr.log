  55 /** The page's outbox items, in creation order (read-only; never creates the database). */
  56 async function readOutbox(page: Page): Promise<OutboxRow[]> {
  57   const rows = await page.evaluate(async (name: string) => {
  58     const databases = typeof indexedDB.databases === 'function' ? await indexedDB.databases() : [];
  59     if (!databases.some((database) => database.name === name)) return [];
  60     return new Promise<unknown[]>((resolve, reject) => {
  61       const request = indexedDB.open(name);
  62       request.onerror = () => reject(request.error);
  63       request.onsuccess = () => {
  64         const db = request.result;
  65         if (!db.objectStoreNames.contains('items')) {
  66           db.close();
  67           resolve([]);
  68           return;
  69         }
  70         const read = db.transaction('items', 'readonly').objectStore('items').getAll();
  71         read.onsuccess = () => {
  72           db.close();
  73           resolve(read.result);
  74         };
  75         read.onerror = () => {
  76           db.close();
  77           reject(read.error);
  78         };
  79       };
  80     });
  81   }, MESSAGING_OUTBOX_DB_NAME);
  82   return (rows as OutboxRow[]).sort((a, b) => a.order - b.order);
  83 }
