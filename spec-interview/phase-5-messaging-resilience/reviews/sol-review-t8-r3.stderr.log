  96 /**
  97  * A replayed key must carry the same composition: content, reply target, the
  98  * same attachment set (attachment id = upload id), and — for messages without
  99  * attachments — the same type (attachment messages derive their type from
 100  * their attachments). Phase 5 T2 (FR-024): compared against the ORIGINAL
 101  * submitted composition recorded with the key; keyed messages created before
 102  * Phase 5 have none and are compared against the stored message (Phase 4).
 103  * Phase 5 T4: the requested mention ids are part of the composition (a stored
 104  * composition without them requested none); a message without a recorded
 105  * composition predates mentions, so only a replay requesting none matches.
 106  */
 107 function isSameComposition(
 108   storedComposition: MessageComposition | null | undefined,
 109   stored: Message,
 110   storedAttachmentIdList: readonly string[],
 111   requested: MessageComposition
 112 ): boolean {
 113   if (storedComposition) {
 114     return isSameStoredComposition(storedComposition, requested);
 115   }
 116   const storedAttachmentIds = [...storedAttachmentIdList].sort();
 117   const expectedAttachmentIds = [...requested.attachmentIds].sort();
 118   return (
 119     requested.mentionIds.length === 0 &&
 120     stored.content === requested.content &&
 121     (requested.type === null || stored.type === requested.type) &&
 122     (stored.replyToId ?? null) === requested.replyToId &&
 123     storedAttachmentIds.length === expectedAttachmentIds.length &&
 124     storedAttachmentIds.every((id, index) => id === expectedAttachmentIds[index])
 125   );
 126 }
