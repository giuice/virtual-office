  87  * stored message later leaves the feed (for example a Realtime DELETE). Call
  88  * it only after the stored message is in the feed cache, so no render shows
  89  * neither copy.
  90  */
  91 export function resolvePendingMessages(
  92   queryClient: QueryClient,
  93   conversationId: string,
  94   stored: readonly Message[]
  95 ): void {
  96   const storedKeys = new Set<string>();
  97   for (const message of stored) {
  98     const key = correlationKey(message);
  99     if (key) storedKeys.add(key);
 100   }
 101   if (storedKeys.size === 0) return;
 102   // Phase 5 T8: the outbox confirms (and deletes) the items of these keys.
 103   storedMessageObservers.get(queryClient)?.forEach((observer) => observer(conversationId, stored));
 104   queryClient
 105     .getQueriesData<Message[]>({ queryKey: ['messages-pending'] })
 106     .forEach(([queryKey, pending]) => {
 107       if (queryKey[2] !== conversationId || !pending?.length) return;
 108       const remaining = pending.filter((message) => {
 109         const key = correlationKey(message);
 110         return key === null || !storedKeys.has(key);
 111       });
 112       if (remaining.length !== pending.length) {
 113         queryClient.setQueryData<Message[]>(queryKey, remaining);
 114       }
 115     });
 116 }
 117 
 118 /** Whether `pending` still holds the pending message of `clientMessageId` (not yet resolved). */
 119 export function isPendingMessage(pending: readonly Message[] | undefined, clientMessageId: string): boolean {
 120   return Boolean(pending?.some((message) => normalizeClientMessageId(message.clientMessageId) === 
clientMessageId));
 121 }
