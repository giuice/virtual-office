(outbox-outcome isStoredMessageOf) and then normalizes it\n   * (toStoredMessage). Rejects only when no response 
arrived (network error),\n   * which the caller treats as an unknown outcome.\n   */\n  async 
createMessageAttempt(attempt: {\n    conversationId: string;\n    content: string;\n    replyToId: string | null;\n    
clientMessageId: string;\n    attemptGeneration: number;\n    expectedSenderId: string;\n    mentionIds: readonly 
string[];\n  }): Promise<{ status: number; code?: string; message?: Record<string, unknown> }> {\n    const response = 
await fetch('/api/messages/create', {\n      method: 'POST',\n      headers: { 'Content-Type': 'application/json' },\n 
     body: JSON.stringify({\n        conversationId: attempt.conversationId,\n        content: attempt.content,\n      
  type: 'text',\n        ...(attempt.replyToId ? { replyToId: attempt.replyToId } : {}),\n        clientMessageId: 
attempt.clientMessageId,\n        attemptGeneration: attempt.attemptGeneration,\n        expectedSenderId: 
attempt.expectedSenderId,\n        // Unchanged on every attempt of the key (an empty set is not sent).\n        
...(attempt.mentionIds.length > 0 ? { mentionIds: [...attempt.mentionIds] } : {}),\n      }),\n    });\n    const data 
= (await response.json().catch(() => null)) as\n      | { code?: unknown; message?: Record<string, unknown> }\n      | 
null;\n    const code = typeof data?.code === 'string' ? data.code : undefined;\n    const message = data?.message;\n  
  if (!response.ok || typeof message !== 'object' || message === null || Array.isArray(message)) {\n      return { 
status: response.status, code };\n    }\n    return { status: response.status, message };\n  },\n\n  /**\n   * Get 
