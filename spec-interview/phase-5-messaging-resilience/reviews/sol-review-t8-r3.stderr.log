 302 test.describe('Phase 5 T8 — durable outbox', () => {
 303   test.beforeEach(async ({ budgets }) => {
 304     await budgets.reset();
 305   });
 306 
 307   test('AC-001/AC-002: offline sends are queued, then delivered in order, once each, within 10 s', async ({
 308     phase5World,
 309     openDevice,
 310   }) => {
 311     const { directId } = phase5World.conversations;
 312     const a = await openDevice('A');
 313     const b = await openDevice('B');
 314 
 315     // A reply target with one earlier reply, so its thread can be expanded.
 316     const parentText = `t8 parent ${randomUUID()}`;
 317     const parentId = await createViaApi(a.page, { conversationId: directId, content: parentText });
 318     await createViaApi(a.page, { conversationId: directId, content: `t8 earlier reply ${randomUUID()}`, 
replyToId: parentId });
 319 
 320     await openConversation(b.page, directId);
 321     await waitForRealtimeReady(b.page);
 322     await b.page.getByTestId(`reply-count-${parentId}`).click();
 323     await openConversation(a.page, directId);
 324     await a.page.getByTestId(`reply-count-${parentId}`).click();
 325     const creates = trackCreates(a.page);
 326 
 327     const texts = [`t8 offline one ${randomUUID()}`, `t8 offline reply ${randomUUID()}`, `t8 offline three 
${randomUUID()}`];
 328     await watchArrivals(b.page, texts);
 329 
 330     await goOffline(a.page);
 331     await sendFromComposer(a.page, texts[0]);
 332     await a.page.getByTestId(`reply-button-${parentId}`).click();
 333     await expect(composer(a.page).getByTestId('reply-composer-preview')).toContainText(parentText);
 334     await sendFromComposer(a.page, texts[1]);
 335     await expect(composer(a.page).getByTestId('reply-composer-preview')).toBeHidden();
 336     await sendFromComposer(a.page, texts[2]);
 337 
 338     // AC-001: pending with a text label, composer empty, in the outbox, nothing sent.
 339     await expect.poll(async () => (await readOutbox(a.page)).length).toBe(3);
 340     const queued = await readOutbox(a.page);
 341     expect(queued.map((item) => item.content)).toEqual(texts);
 342     expect(queued.map((item) => item.replyToId)).toEqual([null, parentId, null]);
 343     for (const item of queued) {
 344       expect(item).toMatchObject({ ownerId: a.user.userId, conversationId: directId, state: 'waiting', 
attemptGeneration: 0 });
 345       await expectPendingLabel(a.page, item.clientMessageId, 'pending', 'pendente');
 346     }
 347     expect(queued[1].order).toBeGreaterThan(queued[0].order);
 348     expect(queued[2].order).toBeGreaterThan(queued[1].order);
 349     await expect(composerInput(a.page)).toHaveValue('');
 350     // B does not see them; nothing reached the server.
 351     await a.page.waitForTimeout(1_500);
 352     expect(creates, 'no create request while offline').toHaveLength(0);
 353     expect(await storedWithTexts(directId, texts)).toHaveLength(0);
 354     expect(Object.values((await readArrivals(b.page)).max).every((count) => count === 0)).toBe(true);
 355 
 356     // AC-002: connectivity returns; no click.
 357     const reconnectedAt = Date.now();
 358     await a.context.setOffline(false);
 359     await expect
 360       .poll(async () => Object.keys((await readArrivals(b.page)).first).length, { timeout: D1_DEADLINE_MS })
 361       .toBe(3);
 362     const arrivals = await readArrivals(b.page);
 363     const lastArrival = Math.max(...texts.map((text) => arrivals.first[text]));
 364     expect(lastArrival - reconnectedAt, 'B saw all three within 10 s of 
reconnecting').toBeLessThanOrEqual(D1_DEADLINE_MS);
 365     expect([...texts].sort((x, y) => arrivals.first[x] - arrivals.first[y]), 'B saw them in send 
order').toEqual(texts);

