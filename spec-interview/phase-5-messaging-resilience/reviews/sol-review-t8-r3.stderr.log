  85 interface CreateAttempt {
  86   body: Record<string, unknown>;
  87   startSeq: number;
  88   endSeq?: number;
  89   startedAt: number;
  90   endedAt?: number;
  91   status?: number;
  92   failure?: string;
  93 }
  94 
  95 /** Every create request of the page, with the order in which requests started and ended. */
  96 function trackCreates(page: Page): CreateAttempt[] {
  97   const attempts: CreateAttempt[] = [];
  98   const byRequest = new Map<Request, CreateAttempt>();
  99   let seq = 0;
 100   const isCreate = (request: Request) =>
 101     request.method() === 'POST' && new URL(request.url()).pathname === '/api/messages/create';
 102   page.on('request', (request) => {
 103     if (!isCreate(request)) return;
 104     seq += 1;
 105     const attempt: CreateAttempt = {
 106       body: (request.postDataJSON() ?? {}) as Record<string, unknown>,
 107       startSeq: seq,
 108       startedAt: Date.now(),
 109     };
 110     attempts.push(attempt);
 111     byRequest.set(request, attempt);
 112   });
 113   page.on('requestfinished', (request) => {
 114     const attempt = byRequest.get(request);
 115     if (!attempt) return;
 116     seq += 1;
 117     attempt.endSeq = seq;
 118     attempt.endedAt = Date.now();
 119     void request.response().then((response) => {
 120       attempt.status = response?.status();
 121     });
 122   });
 123   page.on('requestfailed', (request) => {
 124     const attempt = byRequest.get(request);
 125     if (!attempt) return;
 126     seq += 1;
 127     attempt.endSeq = seq;
 128     attempt.endedAt = Date.now();
 129     attempt.failure = request.failure()?.errorText ?? 'failed';
 130   });
 131   return attempts;
 132 }
