 398 
 399     await openConversation(b.page, directId);
 400     await waitForRealtimeReady(b.page);
 401     await openConversation(a.page, directId);
 402     const creates = trackCreates(a.page);
 403 
 404     const texts = Array.from({ length: 10 }, (_, index) => `t8 burst ${index + 1} ${randomUUID()}`);
 405     await watchArrivals(b.page, texts);
