 215 async function createWithAttachments(
 216   serviceClient: SupabaseClient,
 217   messageRepository: IMessageRepository,
 218   conversationRepository: IConversationRepository,
 219   uploads: IMessageAttachmentUploadRepository,
 220   messageData: Omit<MessageCreateData, 'type'>,
