617:        const { primary, secondary, directConversationId: conversationId } = world;
618:        const messageId = await insertRawMessage(conversationId, secondary);
619:        const holder = await openHolder();
620:        try {
621:          await holder.run(
622:            `select 1 from public.conversation_members where conversation_id = $1 and user_id = $2 for update`,
623:            [conversationId, primary.appUserId],
624:          );
625:          const pending = send(primary, conversationId, messageId);
626:          await waitForBlockedBy(holder.pid);
627:          await holder.run('delete from public.conversation_members where conversation_id = $1 and user_id = $2', [
628:            conversationId,
629:            primary.appUserId,
630:          ]);
631:          await holder.commit();
632:          const result = await pending;
633:          expect(result.status, JSON.stringify(result.body)).toBe(403);
634:          expect(result.body.code).toBe('NOT_PARTICIPANT');
635:        } finally {
636:          await holder.rollback();
637:        }
638:        expect(await isMember(conversationId, primary)).toBe(false);
639:        const receipts = await world.query('select 1 from public.message_read_receipts where message_id = $1 and 
user_id = $2', [
640:          messageId,
641:          primary.appUserId,
642:        ]);
643:        expect(receipts).toEqual([]);
644:        await expectNoAccess(primary, conversationId);
645:        expect((await restoreMember(conversationId, primary)).data).toBe(true);
646:      });
647:    }
