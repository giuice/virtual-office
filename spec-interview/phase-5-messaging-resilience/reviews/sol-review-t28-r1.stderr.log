298:  async function openHolder(): Promise<Holder> {
299:    const client = new Client({ connectionString: MESSAGING_DB_URL });
300:    await client.connect();
301:    await client.query('begin');
302:    const pid = (await client.query<{ pid: number }>('select pg_backend_pid() as pid')).rows[0].pid;
303:    let done = false;
304:    const finish = async (sql: string) => {
305:      if (done) return;
306:      done = true;
307:      await client.query(sql).catch(() => undefined);
308:      await client.end();
309:    };
310:    return {
311:      pid,
312:      run: async (sql, params = []) => {
313:        await client.query(sql, params);
314:      },
315:      commit: () => finish('commit'),
316:      rollback: () => finish('rollback'),
317:    };
318:  }
