138:--   returns trigger
139:--   language plpgsql
140:--   security definer
141:--   set search_path = public, pg_temp
142:--   as $$
143:--   begin
144:--     insert into public.conversation_members (conversation_id, user_id, last_read_at)
145:--     select new.id, p.user_id, now()
146:--     from unnest(coalesce(new.participants, '{}'::uuid[])) as p(user_id)
147:--     join public.users u on u.id = p.user_id
148:--     on conflict (conversation_id, user_id) do nothing;
149:--     return new;
150:--   end $$;
151:--   create or replace function public.mark_messages_read(
152:--     p_conversation_id uuid,
153:--     p_user_id uuid,
154:--     p_message_ids uuid[]
155:--   ) returns integer
156:--   language plpgsql
157:--   security definer
158:--   set search_path = ''
159:--   as $$
160:--   declare
161:--     v_recorded integer;
162:--   begin
163:--     if p_conversation_id is null or p_user_id is null then
164:--       raise exception 'mark_messages_read: conversation and user are required'
165:--         using errcode = '22004';
166:--     end if;
167:--
168:--     if p_message_ids is null or pg_catalog.cardinality(p_message_ids) = 0 then
169:--       return 0;
170:--     end if;
171:--
172:--     -- Bounded input: the route caps the batch at 100 ids as well.
173:--     if pg_catalog.cardinality(p_message_ids) > 100 then
174:--       raise exception 'mark_messages_read: at most 100 message ids per call'
175:--         using errcode = '22023';
176:--     end if;
177:--
178:--     if not exists (
179:--       select 1
180:--       from public.conversation_members cm
181:--       where cm.conversation_id = p_conversation_id
182:--         and cm.user_id = p_user_id
183:--     ) then
184:--       raise exception 'mark_messages_read: user is not a member of the conversation'
185:--         using errcode = '42501';
186:--     end if;
187:--
188:--     -- Ids outside the conversation are ignored; the caller's own messages never
189:--     -- get a receipt (system messages with a null sender may). Repeats are
190:--     -- idempotent on the unique (message_id, user_id).
191:--     insert into public.message_read_receipts (message_id, conversation_id, user_id)
192:--     select m.id, m.conversation_id, p_user_id
193:--     from public.messages m
194:--     where m.conversation_id = p_conversation_id
195:--       and m.id = any (p_message_ids)
196:--       and m.sender_id is distinct from p_user_id
197:--     on conflict (message_id, user_id) do nothing;
198:--
199:--     get diagnostics v_recorded = row_count;
200:--     return v_recorded;
201:--   end $$;
