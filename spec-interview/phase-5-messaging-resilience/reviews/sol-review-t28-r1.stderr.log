812:    perform 1 from public.users u where u.id = p_user_id for share;
813:    if not found then
814:      raise exception 'USER_NOT_FOUND' using errcode = 'P0002';
815:    end if;
816:  end if;
817:
818:  delete from private.conversation_member_revocations r
819:  where r.conversation_id = p_conversation_id
820:    and r.user_id = p_user_id;
821:
822:  if not v_in_participants then
823:    update public.conversations c
824:    set participants = pg_catalog.array_append(coalesce(c.participants, '{}'::uuid[]), p_user_id)
825:    where c.id = p_conversation_id;
826:  else
827:    insert into public.conversation_members (conversation_id, user_id, last_read_at)
828:    values (p_conversation_id, p_user_id, pg_catalog.now())
829:    on conflict (conversation_id, user_id) do nothing;
830:  end if;
831:  return true;
832:end;
833:$$;
834:
835:revoke all on function public.restore_conversation_membership(uuid, uuid) from public, anon, authenticated, 
service_role;
836:grant execute on function public.restore_conversation_membership(uuid, uuid) to service_role;
837:
838:-- ---------------------------------------------------------------------------
839:-- 7. Per-message read receipts: lock the membership (never for a removed one).
840:-- ---------------------------------------------------------------------------
841:create or replace function public.mark_messages_read(p_conversation_id uuid, p_user_id uuid, p_message_ids uuid[])
842:returns integer
843:language plpgsql
844:security definer
845:set search_path = ''
846:as $$
847:declare
848:  v_recorded integer;
849:begin
850:  if p_conversation_id is null or p_user_id is null then
851:    raise exception 'mark_messages_read: conversation and user are required'
852:      using errcode = '22004';
853:  end if;
854:
855:  if p_message_ids is null or pg_catalog.cardinality(p_message_ids) = 0 then
856:    return 0;
857:  end if;
858:
859:  -- Bounded input: the route caps the batch at 100 ids as well.
860:  if pg_catalog.cardinality(p_message_ids) > 100 then
861:    raise exception 'mark_messages_read: at most 100 message ids per call'
862:      using errcode = '22023';
863:  end if;
864:
865:  -- Phase 5 T28: the membership row is locked until commit, so a concurrent
866:  -- removal either committed first (refused here) or waits for these receipts.
867:  perform 1
868:  from public.conversation_members cm
869:  where cm.conversation_id = p_conversation_id
870:    and cm.user_id = p_user_id
871:  for key share;
872:  if not found then
873:    raise exception 'mark_messages_read: user is not a member of the conversation'
874:      using errcode = '42501';
875:  end if;
876:
877:  -- Ids outside the conversation are ignored; the caller's own messages never
878:  -- get a receipt (system messages with a null sender may). Repeats are
879:  -- idempotent on the unique (message_id, user_id).
880:  insert into public.message_read_receipts (message_id, conversation_id, user_id)
881:  select m.id, m.conversation_id, p_user_id
882:  from public.messages m
883:  where m.conversation_id = p_conversation_id
884:    and m.id = any (p_message_ids)
885:    and m.sender_id is distinct from p_user_id
886:  on conflict (message_id, user_id) do nothing;
887:
888:  get diagnostics v_recorded = row_count;
889:  return v_recorded;
890:end;
891:$$;
892:
893:commit;

