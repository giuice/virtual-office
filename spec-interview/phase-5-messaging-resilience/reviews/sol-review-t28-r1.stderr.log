697:-- ---------------------------------------------------------------------------
698:-- 6. Server join / authorized rejoin.
699:-- ---------------------------------------------------------------------------
700:-- Room join (POST /api/conversations/join, room resolver). Returns true when a
701:-- membership was created, false when the user already is a member. Raises
702:-- CONVERSATION_NOT_FOUND / ROOM_NOT_FOUND / USER_NOT_FOUND (P0002),
703:-- JOIN_FORBIDDEN / MEMBERSHIP_REVOKED / ROOM_ACCESS_DENIED (42501).
704:create or replace function public.join_room_conversation(p_conversation_id uuid, p_user_id uuid)
705:returns boolean
706:language plpgsql
707:security definer
708:set search_path = ''
709:as $$
710:declare
711:  v_conversation public.conversations;
712:begin
713:  if p_conversation_id is null or p_user_id is null then
714:    raise exception 'join_room_conversation: conversation and user are required' using errcode = '22004';
715:  end if;
716:
717:  select c.* into v_conversation
718:  from public.conversations c
719:  where c.id = p_conversation_id
720:  for no key update;
721:  if not found then
722:    raise exception 'CONVERSATION_NOT_FOUND' using errcode = 'P0002';
723:  end if;
724:
725:  if exists (
726:    select 1
727:    from public.conversation_members cm
728:    where cm.conversation_id = p_conversation_id
729:      and cm.user_id = p_user_id
730:  ) then
731:    return false;
732:  end if;
733:
734:  if v_conversation.type <> 'room'::public.conversation_type or v_conversation.room_id is null then
735:    raise exception 'JOIN_FORBIDDEN' using errcode = '42501';
736:  end if;
737:  if exists (
738:    select 1
739:    from private.conversation_member_revocations r
740:    where r.conversation_id = p_conversation_id
741:      and r.user_id = p_user_id
742:  ) then
743:    raise exception 'MEMBERSHIP_REVOKED' using errcode = '42501';
744:  end if;
745:
746:  perform private.authorize_room_membership(array[p_user_id], v_conversation.room_id);
747:
748:  if array_position(coalesce(v_conversation.participants, '{}'::uuid[]), p_user_id) is null then
749:    -- sync_conversation_members creates the membership (same checks, locks held).
750:    update public.conversations c
751:    set participants = pg_catalog.array_append(coalesce(c.participants, '{}'::uuid[]), p_user_id)
752:    where c.id = p_conversation_id;
753:  else
754:    insert into public.conversation_members (conversation_id, user_id, last_read_at)
755:    values (p_conversation_id, p_user_id, pg_catalog.now())
756:    on conflict (conversation_id, user_id) do nothing;
757:  end if;
758:  return true;
759:end;
760:$$;
