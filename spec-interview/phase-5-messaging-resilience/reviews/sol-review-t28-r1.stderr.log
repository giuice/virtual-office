803:  v_in_participants :=
804:    array_position(coalesce(v_conversation.participants, '{}'::uuid[]), p_user_id) is not null;
805:
806:  if v_conversation.type = 'room'::public.conversation_type and v_conversation.room_id is not null then
807:    perform private.authorize_room_membership(array[p_user_id], v_conversation.room_id);
808:  else
809:    if not v_in_participants then
810:      raise exception 'MEMBERSHIP_GRANT_FORBIDDEN' using errcode = '42501';
