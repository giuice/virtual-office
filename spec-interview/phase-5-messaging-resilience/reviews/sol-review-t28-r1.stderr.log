224:-- ---------------------------------------------------------------------------
225:-- 1. Revocations (removed memberships stay removed).
226:-- ---------------------------------------------------------------------------
227:create table if not exists private.conversation_member_revocations (
228:  conversation_id uuid not null references public.conversations (id) on delete cascade,
229:  user_id uuid not null references public.users (id) on delete cascade,
230:  revoked_at timestamptz not null default pg_catalog.now(),
231:  primary key (conversation_id, user_id)
232:);
233:
234:create index if not exists idx_conversation_member_revocations_user_id
235:  on private.conversation_member_revocations (user_id);
236:
237:alter table private.conversation_member_revocations enable row level security;
238:revoke all on table private.conversation_member_revocations from public, anon, authenticated, service_role;
239:
240:comment on table private.conversation_member_revocations is
241:  'Phase 5 T28: memberships removed (DELETE of a conversation_members row that was not an FK cascade). A revoked 
user is never re-added by participants syncs or joins; only public.restore_conversation_membership lifts it. No API 
role has any privilege.';
242:
243:-- Participants that lost their membership before this migration (a removed
244:-- member stays in conversations.participants) are revocations.
245:insert into private.conversation_member_revocations (conversation_id, user_id)
246:select distinct c.id, p.user_id
247:from public.conversations c
248:cross join lateral pg_catalog.unnest(c.participants) as p(user_id)
249:join public.users u on u.id = p.user_id
250:where not exists (
251:  select 1
252:  from public.conversation_members cm
253:  where cm.conversation_id = c.id
254:    and cm.user_id = p.user_id
255:)
256:on conflict (conversation_id, user_id) do nothing;
