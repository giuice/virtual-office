361:  if p_space_id is null or p_user_ids is null or pg_catalog.cardinality(p_user_ids) = 0 then
362:    raise exception 'ROOM_NOT_FOUND' using errcode = 'P0002';
363:  end if;
364:
365:  select pg_catalog.count(*) into v_count
366:  from (
367:    select u.id
368:    from public.users u
369:    where u.id = any (p_user_ids)
370:    order by u.id
371:    for share
372:  ) as locked;
373:  if v_count <> (select pg_catalog.count(distinct x) from pg_catalog.unnest(p_user_ids) as t(x) where x is not 
null)
374:     or array_position(p_user_ids, null) is not null then
375:    raise exception 'USER_NOT_FOUND' using errcode = 'P0002';
376:  end if;
377:
378:  select s.* into v_space
379:  from public.spaces s
380:  where s.id = p_space_id
381:  for share;
382:  if not found then
383:    raise exception 'ROOM_NOT_FOUND' using errcode = 'P0002';
384:  end if;
385:
386:  for v_user in
387:    select u.* from public.users u where u.id = any (p_user_ids) order by u.id
388:  loop
389:    if private.room_access_denial(v_user, v_space) is not null then
390:      raise exception 'ROOM_ACCESS_DENIED' using errcode = '42501',
391:        detail = private.room_access_denial(v_user, v_space);
392:    end if;
393:  end loop;
394:end;
395:$$;
