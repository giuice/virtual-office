529:-- 4. conversations: client writes.
530:-- ---------------------------------------------------------------------------
531:-- Authorizes a client-created conversation under row locks (see header).
532:-- Raises CONVERSATION_CREATE_FORBIDDEN / ROOM_ACCESS_DENIED (42501),
533:-- USER_NOT_FOUND / ROOM_NOT_FOUND (P0002).
534:create or replace function private.authorize_client_conversation_insert(
535:  p_type text,
536:  p_participants uuid[],
537:  p_room_id uuid,
538:  p_visibility text
539:)
540:returns void
541:language plpgsql
542:security definer
543:set search_path = ''
544:as $$
545:declare
546:  v_caller uuid := private.current_app_user_id();
547:  v_users public.users[];
548:  v_space public.spaces;
549:  v_derived text;
550:begin
551:  if v_caller is null
552:     or p_participants is null
553:     or array_position(p_participants, null) is not null
554:     or not (v_caller = any (p_participants)) then
555:    raise exception 'CONVERSATION_CREATE_FORBIDDEN' using errcode = '42501';
556:  end if;
557:
558:  if p_type = 'direct' then
559:    if pg_catalog.cardinality(p_participants) <> 2
560:       or (select pg_catalog.count(distinct x) from pg_catalog.unnest(p_participants) as t(x)) <> 2
561:       or p_room_id is not null
562:       or p_visibility is distinct from 'direct' then
563:      raise exception 'CONVERSATION_CREATE_FORBIDDEN' using errcode = '42501';
564:    end if;
565:
566:    select pg_catalog.array_agg(locked order by (locked).id) into v_users
567:    from (
568:      select u as locked
569:      from public.users u
570:      where u.id = any (p_participants)
571:      order by u.id
572:      for share
573:    ) as l;
574:    if coalesce(pg_catalog.cardinality(v_users), 0) <> 2 then
575:      raise exception 'USER_NOT_FOUND' using errcode = 'P0002';
576:    end if;
577:    if (v_users[1]).company_id is not null
578:       and (v_users[2]).company_id is not null
579:       and (v_users[1]).company_id <> (v_users[2]).company_id then
580:      raise exception 'CONVERSATION_CREATE_FORBIDDEN' using errcode = '42501',
581:        detail = 'COMPANY_MISMATCH';
582:    end if;
583:    return;
584:  end if;
585:
586:  if p_type = 'room' then
587:    if pg_catalog.cardinality(p_participants) <> 1 or p_room_id is null then
588:      raise exception 'CONVERSATION_CREATE_FORBIDDEN' using errcode = '42501';
589:    end if;
590:    perform private.authorize_room_membership(array[v_caller], p_room_id);

