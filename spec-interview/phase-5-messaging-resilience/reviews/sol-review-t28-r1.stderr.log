423:-- SECURITY INVOKER on purpose: current_user is the role of the INSERT
424:-- statement (anon/authenticated/service_role for Data API requests; the
425:-- function owner inside SECURITY DEFINER code such as the participants sync).
426:create or replace function private.guard_conversation_member_insert()
427:returns trigger
428:language plpgsql
429:set search_path = ''
430:as $$
431:begin
432:  if current_user in ('anon', 'authenticated', 'service_role') then
433:    -- API roles never create a membership: only the upsert of an existing
434:    -- row (which then takes the ON CONFLICT DO UPDATE path) is accepted.
435:    if not private.lock_existing_conversation_membership(new.conversation_id, new.user_id) then
436:      raise exception 'NOT_PARTICIPANT' using errcode = '42501';
437:    end if;
438:  else
439:    -- Authorized creation (SECURITY DEFINER code of this migration, which
440:    -- checked revocations and room rules, or a database administrator): a
441:    -- new membership lifts a recorded revocation.
442:    delete from private.conversation_member_revocations r
443:    where r.conversation_id = new.conversation_id
444:      and r.user_id = new.user_id;
445:  end if;
446:  return new;
447:end;
448:$$;
