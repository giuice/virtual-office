639:-- ---------------------------------------------------------------------------
640:-- 5. Participants sync: creation, and authorized additions only.
641:-- ---------------------------------------------------------------------------
642:create or replace function public.sync_conversation_members()
643:returns trigger
644:language plpgsql
645:security definer
646:set search_path = ''
647:as $$
648:declare
649:  v_added uuid[];
650:begin
651:  if tg_op = 'INSERT' then
652:    -- The memberships of a new conversation (client inserts were authorized
653:    -- by conversations_guard_client_insert; service-role/admin inserts are
654:    -- server code).
655:    insert into public.conversation_members (conversation_id, user_id, last_read_at)
656:    select new.id, u.id, pg_catalog.now()
657:    from public.users u
658:    where u.id = any (coalesce(new.participants, '{}'::uuid[]))
659:    on conflict (conversation_id, user_id) do nothing;
660:    return new;
661:  end if;
662:
663:  -- UPDATE OF participants: only ids newly added get a membership; an id
664:  -- already in the old array (e.g. a removed member) is never re-created.
665:  select coalesce(pg_catalog.array_agg(distinct u.id order by u.id), '{}'::uuid[])
666:  into v_added
667:  from public.users u
668:  where u.id = any (coalesce(new.participants, '{}'::uuid[]))
669:    and array_position(coalesce(old.participants, '{}'::uuid[]), u.id) is null;
670:
671:  if pg_catalog.cardinality(v_added) = 0 then
672:    return new;
673:  end if;
674:
675:  if new.type <> 'room'::public.conversation_type or new.room_id is null then
676:    raise exception 'MEMBERSHIP_GRANT_FORBIDDEN' using errcode = '42501';
677:  end if;
678:  if exists (
679:    select 1
680:    from private.conversation_member_revocations r
681:    where r.conversation_id = new.id
682:      and r.user_id = any (v_added)
683:  ) then
684:    raise exception 'MEMBERSHIP_REVOKED' using errcode = '42501';
685:  end if;
686:
687:  perform private.authorize_room_membership(v_added, new.room_id);
688:
689:  insert into public.conversation_members (conversation_id, user_id, last_read_at)
690:  select new.id, a.user_id, pg_catalog.now()
691:  from pg_catalog.unnest(v_added) as a(user_id)
692:  on conflict (conversation_id, user_id) do nothing;
693:  return new;
694:end;
695:$$;
