33: interface ServerMessage {
34:   id: string;
35:   readCount?: number;
36:   stars?: Array<{ userId: string }>;
37:   attachments?: Array<{ id: string }>;
38: }
39: 
40: const readBy = (page: Page, messageId: string) => page.getByTestId(`read-by-${messageId}`);
41: const readersList = (page: Page, messageId: string) => page.getByTestId(`readers-list-${messageId}`);
42: const readerItems = (list: Locator) => list.locator('[data-testid^="reader-item-"]');
43: const starredIndicator = (page: Page, messageId: string) => page.getByTestId(`message-starred-${messageId}`);
44: const starredResults = (page: Page) => page.locator('[data-testid^="starred-result-"]');
45: const feedMessage = (page: Page, messageId: string) =>
46:   page.getByTestId('messages-feed').getByTestId(`message-${messageId}`);
47: 
48: /** Opens the drawer on a conversation and waits until its Realtime stream is live. */
49: async function openConversation(page: Page, realtime: RealtimeConnectionControl, conversationId: string) {
50:   await page.goto('/floor-plan');
51:   await openDrawer(page);
52:   await waitForRealtimeReady(page);
53:   await selectConversation(page, { id: conversationId });
54:   await realtime.waitForStreamConfirmation(0);
55: }
56: 
57: async function openDrawerOnly(page: Page) {
58:   await page.goto('/floor-plan');
59:   await openDrawer(page);
60:   await waitForRealtimeReady(page);
61: }
62: 
63: /** Restores Realtime (and the network, when it was taken offline) and waits for the rejoin. */
64: async function reconnect(page: Page, realtime: RealtimeConnectionControl, { goOnline = false } = {}) {
65:   const confirmationsBefore = realtime.streamConfirmations();
66:   realtime.restore();
67:   if (goOnline) await page.context().setOffline(false);
68:   await realtime.waitForStreamConfirmation(confirmationsBefore);
69:   await waitForRealtimeReady(page);
70: }
