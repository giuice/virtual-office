3: import { useEffect, useCallback, useRef } from 'react';
4: import type { RealtimeChannel } from '@supabase/supabase-js';
5: import { supabase } from '@/lib/supabase/client';
6: import { useAuth } from '@/contexts/AuthContext';
7: import { debugLogger } from '@/utils/debug-logger';
8: 
9: export interface TypingUser {
10:   userId: string;
11:   displayName: string;
12: }
13: 
14: // How long a remote "typing" signal stays visible without a refresh.
15: const REMOTE_TYPING_TTL_MS = 4000;
16: // Inactivity window before the local user stops broadcasting "typing".
17: const LOCAL_TYPING_IDLE_MS = 2000;
18: 
19: /**
20:  * Single owner of the `conversation:{id}` Realtime channel: presence tracking
21:  * plus typing indicators over broadcast (audit B-02 — typing is ephemeral and
22:  * never touches Postgres). Both send and receive run through the ONE
23:  * subscribed channel; creating a fresh channel per send leaks channel objects
24:  * and, with Phoenix topics, can kick the subscribed one off the socket.
25:  */
26: export function useConversationPresence(conversationId: string | null) {
27:   const { user } = useAuth();
28:   const [presenceState, updatePresenceState] = useReducerState<Record<string, any>>({});
29:   const [typingUsers, updateTypingUsers] = useReducerState<TypingUser[]>([]);
30: 
31:   const channelRef = useRef<RealtimeChannel | null>(null);
32:   const isSubscribedRef = useRef(false);
33:   const remoteTypingTimersRef = useRef(new Map<string, ReturnType<typeof setTimeout>>());
34:   const localTypingRef = useRef(false);
35:   const localIdleTimerRef = useRef<ReturnType<typeof setTimeout> | null>(null);
36: 
37:   const sendTypingIndicator = useCallback((isTyping: boolean) => {
38:     const channel = channelRef.current;
39:     if (!channel || !isSubscribedRef.current || !user) return;
40: 
41:     const userDisplayName =
42:       (user.user_metadata as any)?.full_name ||
43:       (user.user_metadata as any)?.name ||
44:       user.email?.split('@')[0] ||
45:       'User';
46: 
47:     void channel.send({
48:       type: 'broadcast',
49:       event: 'typing',
50:       payload: { userId: user.id, userDisplayName, isTyping },
51:     });
52:   }, [user]);
53: 
54:   /** Stop broadcasting "typing" for the local user (blur, send, unmount). */
55:   const stopTyping = useCallback(() => {
56:     if (localIdleTimerRef.current) {
57:       clearTimeout(localIdleTimerRef.current);
58:       localIdleTimerRef.current = null;
59:     }
60:     if (localTypingRef.current) {
61:       localTypingRef.current = false;
62:       sendTypingIndicator(false);
63:     }
64:   }, [sendTypingIndicator]);
65: 
66:   /** Call on every input change; debounces the broadcast and auto-stops. */
67:   const notifyTyping = useCallback(() => {
68:     if (!localTypingRef.current) {
69:       localTypingRef.current = true;
70:       sendTypingIndicator(true);
71:     }
72:     if (localIdleTimerRef.current) {
73:       clearTimeout(localIdleTimerRef.current);
74:     }
75:     localIdleTimerRef.current = setTimeout(stopTyping, LOCAL_TYPING_IDLE_MS);
76:   }, [sendTypingIndicator, stopTyping]);
77: 
78:   useEffect(() => {
79:     if (!conversationId || !user) {
80:       return;
81:     }
82: 
83:     const remoteTimers = remoteTypingTimersRef.current;
84: 
85:     const clearRemoteTyping = (userId: string) => {
86:       const timer = remoteTimers.get(userId);
87:       if (timer) {
88:         clearTimeout(timer);
89:         remoteTimers.delete(userId);
90:       }
91:       updateTypingUsers(prev => prev.filter(t => t.userId !== userId));
92:     };
93: 
94:     const channel = supabase
95:       .channel(`conversation:${conversationId}`, {
96:         config: {
97:           broadcast: { self: false },
98:           presence: { key: user.id }
99:         }
100:       })
101:       .on('presence', { event: 'sync' }, () => {
102:         updatePresenceState(channel.presenceState());
103:       })
104:       .on('broadcast', { event: 'typing' }, (payload) => {
105:         const { userId, userDisplayName, isTyping } = payload.payload ?? {};
106:         if (!userId || userId === user.id) return;
107: 
108:         if (!isTyping) {
109:           clearRemoteTyping(userId);
110:           return;
111:         }
112: 
113:         updateTypingUsers(prev =>
114:           prev.some(t => t.userId === userId)
115:             ? prev
116:             : [...prev, { userId, displayName: userDisplayName || 'Someone' }]
117:         );
118: 
119:         // Reset (not stack) the TTL timer so continuous typing stays visible.
120:         const existing = remoteTimers.get(userId);
121:         if (existing) clearTimeout(existing);
122:         remoteTimers.set(
123:           userId,
124:           setTimeout(() => {
125:             remoteTimers.delete(userId);
126:             updateTypingUsers(prev => prev.filter(t => t.userId !== userId));
127:           }, REMOTE_TYPING_TTL_MS)
128:         );
129:       })
130:       .subscribe(async (status) => {
131:         if (debugLogger.messaging.enabled()) {
132:           debugLogger.messaging.trace('useConversationPresence', 'status', {
133:             conversationId,
134:             status,
135:           });
136:         }
137: 
138:         if (status === 'SUBSCRIBED') {
139:           isSubscribedRef.current = true;
140:           const userDisplayName =
141:             (user.user_metadata as any)?.full_name ||
142:             (user.user_metadata as any)?.name ||
143:             user.email?.split('@')[0] ||
144:             'User';
145:           await channel.track({
146:             userId: user.id,
147:             userDisplayName,
148:             joinedAt: new Date().toISOString()
149:           });
150:         } else {
151:           isSubscribedRef.current = false;
152:         }
153:       });
154: 
155:     channelRef.current = channel;
156: 
157:     return () => {
158:       remoteTimers.forEach((timer) => clearTimeout(timer));
159:       remoteTimers.clear();
160:       if (localIdleTimerRef.current) {
161:         clearTimeout(localIdleTimerRef.current);
162:         localIdleTimerRef.current = null;
163:       }
164:       localTypingRef.current = false;
165:       isSubscribedRef.current = false;
166:       channelRef.current = null;
167:       updateTypingUsers([]);
168:       void channel.unsubscribe();
169:       supabase.removeChannel(channel);
170:     };
171:   }, [conversationId, user, updatePresenceState, updateTypingUsers]);
172: 
173:   const activePresenceState = conversationId && user ? presenceState : {};
174:   const activeTypingUsers = conversationId && user ? typingUsers : [];
175: 
176:   // Get list of users currently present in conversation
177:   const presentUsers = Object.keys(activePresenceState).flatMap(userId => {
178:     if (userId === user?.id) return [];
179:     const presence = activePresenceState[userId][0]; // Get the first presence record
180:     return [{
181:       userId,
182:       userDisplayName: presence?.userDisplayName,
183:       joinedAt: presence?.joinedAt
184:     }];
185:   });
186: 
187:   return {
188:     presentUsers,
189:     typingUsers: activeTypingUsers,
190:     sendTypingIndicator,
191:     notifyTyping,
192:     stopTyping,
193:     isPresenceActive: !!conversationId && !!user
194:   };
195: }
1: // src/lib/auth/rate-limit.ts
2: import { NextResponse } from 'next/server';
3: import type { SupabaseClient } from '@supabase/supabase-js';
4: import { jsonError } from '@/lib/auth/authorize';
5: 
6: // Audit M-09: per-user fixed-window limits for messaging mutations.
7: // Enforced by the service-role-only check_rate_limit RPC (shared Postgres
8: // counter, safe across serverless instances).
9: const RATE_LIMITS = {
10:   'message:create': { limit: 30, windowSeconds: 60 },
11:   'message:react': { limit: 60, windowSeconds: 60 },
12:   // Phase 4 T13: one upload per file, up to 5 files per message, plus retries
13:   // of failed uploads; 10/min refused the second full message in a minute.
14:   // 30/min = six 5-file messages, in line with message:create (each file is
15:   // still capped at 10 MB and only links to the uploader's own message).
16:   'message:upload': { limit: 30, windowSeconds: 60 },
17:   // Phase 4 T12: cancelling pending uploads (composer remove/cancel).
18:   'message:upload-cancel': { limit: 60, windowSeconds: 60 },
19:   // Visible-message receipts are batched by the drawer while it scrolls.
20:   'conversation:read-receipts': { limit: 120, windowSeconds: 60 },
21: } as const;
22: 
23: export type RateLimitedAction = keyof typeof RATE_LIMITS;
24: 
25: /**
26:  * Returns a 429 response when the user exceeded the action's limit,
27:  * null when the request may proceed. Call AFTER the authz check, with the
28:  * authenticated user's DB id (users.id, not supabase_uid).
29:  *
30:  * Fails open: an RPC error (e.g. migration not applied yet) is logged and
31:  * the request is allowed — rate limiting must never take messaging down.
32:  */
33: export async function enforceRateLimit(
34:   serviceClient: SupabaseClient,
35:   userDbId: string,
36:   action: RateLimitedAction
37: ): Promise<NextResponse | null> {
38:   const { limit, windowSeconds } = RATE_LIMITS[action];
39: 
40:   try {
41:     const { data: allowed, error } = await serviceClient.rpc('check_rate_limit', {
42:       p_user_id: userDbId,
43:       p_action: action,
44:       p_limit: limit,
45:       p_window_seconds: windowSeconds,
46:     });
47: 
48:     if (error) {
49:       console.error(`Rate limit check failed for ${action}:`, error);
50:       return null;
51:     }
52: 
53:     if (allowed === false) {
54:       return jsonError(429, 'rate_limited', 'Too many requests. Please slow down.');
55:     }
56: 
57:     return null;
58:   } catch (error) {
59:     console.error(`Rate limit check threw for ${action}:`, error);
60:     return null;
61:   }
62: }

