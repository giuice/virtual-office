84:  */
85: export async function requireConversationParticipant(
86:   conversationId: string
87: ): Promise<ParticipantContext | AuthzFailure> {
88:   if (!conversationId || typeof conversationId !== 'string') {
89:     return { errorResponse: jsonError(400, 'BAD_REQUEST', 'conversationId is required') };
90:   }
91: 
92:   const auth = await requireAuthUser();
