42: const MESSAGES_PAGE_SIZE = 20;
43: 
44: /**
45:  * Upper bound on fetch rounds while searching history for one message (each
46:  * round loads an older page or waits for a fetch already running): about
47:  * MAX_HISTORY_SEARCH_ROUNDS * MESSAGES_PAGE_SIZE messages.
48:  */
49: const MAX_HISTORY_SEARCH_ROUNDS = 100;
50: 
51: const pagesContainMessage = (data: MessagesInfiniteData | undefined, messageId: string): boolean =>
52:   data?.pages.some((page) => page.messages.some((message) => message.id === messageId)) ?? false;
