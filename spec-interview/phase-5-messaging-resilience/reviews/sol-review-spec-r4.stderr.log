116:   const refreshMessages = useCallback(async () => {
117:     if (debugLogger.messaging.enabled()) {
118:       debugLogger.messaging.event('useMessages.refreshMessages', 'start', {
119:         conversationId: activeConversationId,
120:       });
121:     }
122: 
123:     await refetch();
124: 
125:     if (debugLogger.messaging.enabled()) {
126:       debugLogger.messaging.event('useMessages.refreshMessages', 'finish', {
127:         conversationId: activeConversationId,
128:       });
129:     }
130:   }, [activeConversationId, refetch]);
131: 
132:   const loadMoreMessages = useCallback(async () => {
133:     if (!hasNextPage) {
134:       if (debugLogger.messaging.enabled()) {
135:         debugLogger.messaging.trace('useMessages.loadMoreMessages', 'skip:no-more-pages', {
136:           conversationId: activeConversationId,
137:         });
138:       }
139:       return;
140:     }
141: 
142:     if (debugLogger.messaging.enabled()) {
143:       debugLogger.messaging.event('useMessages.loadMoreMessages', 'start', {
144:         conversationId: activeConversationId,
145:       });
146:     }
147: 
148:     setLoadMoreFailedConversationId(null);
149:     const result = await fetchNextPage();
