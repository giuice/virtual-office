77: /**
78:  * Asks the browser for permission. Call only from a user action (the drawer
79:  * control); never on load. Resolves to the permission after the request.
80:  */
81: export async function requestDesktopNotificationPermission(): Promise<NotificationPermission | null> {
82:   if (!notificationsSupported()) return null;
83:   const current = readPermission();
84:   if (current !== 'default') return current;
85:   try {
86:     return await window.Notification.requestPermission();
87:   } catch {
88:     return readPermission();
89:   }
90: }
