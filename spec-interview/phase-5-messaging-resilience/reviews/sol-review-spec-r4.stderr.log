2: // Phase 4 FR-023 / BR-010: desktop notifications for new messages from others
3: // in direct and group conversations. Page-level Notifications API only (no
4: // service worker): a notification can be shown while a tab of the app is open.
5: 
6: import { ConversationType, MessageType, type Conversation, type Message } from '@/types/messaging';
7: 
8: /**
9:  * What the drawer control shows:
10:  * - unsupported: the browser has no Notifications API;
11:  * - blocked: the browser permission is "denied";
12:  * - enabled: the user turned them on here and the permission is "granted";
13:  * - available: anything else (never asked, dismissed, or turned off in-app).
14:  */
15: export type DesktopNotificationStatus = 'unsupported' | 'blocked' | 'enabled' | 'available';
16: 
17: const PREFERENCE_KEY_PREFIX = 'vo:messaging:desktop-notifications:';
18: const PREFERENCE_ON = 'on';
19: const PREFERENCE_OFF = 'off';
20: /** In-tab signal that the preference changed (`storage` only fires in other tabs). */
21: const PREFERENCE_EVENT = 'vo:messaging:desktop-notifications-change';
22: 
23: const NOTIFIED_STORAGE_KEY = 'vo:messaging:notified-messages';
24: const NOTIFIED_LOCK_NAME = 'vo:messaging:notification-claim';
25: /** How long a claimed message id is remembered across tabs. */
26: const NOTIFIED_TTL_MS = 10 * 60_000;
27: const MAX_TAB_CLAIMS = 500;
28: const PREVIEW_MAX_LENGTH = 120;
29: 
30: export function notificationsSupported(): boolean {
31:   return typeof window !== 'undefined' && typeof window.Notification === 'function';
32: }
33: 
34: function readPermission(): NotificationPermission | null {
35:   if (!notificationsSupported()) return null;
36:   try {
37:     return window.Notification.permission;
38:   } catch {
39:     return null;
40:   }
41: }
42: 
43: const preferenceKey = (userId: string) => `${PREFERENCE_KEY_PREFIX}${userId}`;
44: 
45: /** The user's in-app opt-in on this browser. Absent (never chosen) means off. */
46: function readPreference(userId: string): boolean {
47:   try {
48:     return window.localStorage.getItem(preferenceKey(userId)) === PREFERENCE_ON;
49:   } catch {
50:     return false;
51:   }
52: }
53: 
54: export function writeDesktopNotificationPreference(userId: string, enabled: boolean): void {
55:   try {
56:     window.localStorage.setItem(preferenceKey(userId), enabled ? PREFERENCE_ON : PREFERENCE_OFF);
57:   } catch {
58:     // Storage unavailable: the choice cannot be kept; nothing else depends on it.
59:   }
60:   window.dispatchEvent(new Event(PREFERENCE_EVENT));
61: }
62: 
63: /**
64:  * Opt-in rule: notifications are on only when the user enabled them in the
65:  * drawer on this browser AND the browser permission is "granted". A granted
66:  * permission alone (e.g. given to another account or before turning them off
67:  * in-app) does not enable them; a denied/revoked permission disables them.
68:  */
69: export function readDesktopNotificationStatus(userId: string | null | undefined): DesktopNotificationStatus {
70:   const permission = readPermission();
71:   if (permission === null) return 'unsupported';
72:   if (permission === 'denied') return 'blocked';
73:   if (permission === 'granted' && userId && readPreference(userId)) return 'enabled';
74:   return 'available';
75: }
