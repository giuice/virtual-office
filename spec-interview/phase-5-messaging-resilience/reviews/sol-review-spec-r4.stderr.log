11: // Postgres timestamp keeps microsecond precision; the id breaks ties between
12: // equal timestamps. Legacy timestamp-only cursors parse with id = null.
13: function buildCompositeCursor(row: { timestamp: string; id: string }): string {
14:   return `${row.timestamp}|${row.id}`;
