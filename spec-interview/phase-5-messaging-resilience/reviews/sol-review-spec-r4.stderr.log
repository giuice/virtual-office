6: 
7: export async function POST(request: NextRequest) {
8:   try {
9:     const { messageId, emoji } = await request.json();
10: 
11:     // Input Validation
12:     if (!messageId || typeof messageId !== 'string' || !emoji || typeof emoji !== 'string') {
13:       return NextResponse.json({ error: 'Missing or invalid messageId or emoji' }, { status: 400 });
14:     }
15: 
16:     const ctx = await requireMessageParticipant(messageId);
17:     if (isAuthzFailure(ctx)) {
18:       return ctx.errorResponse;
19:     }
20: 
21:     const rateLimited = await enforceRateLimit(ctx.serviceClient, ctx.dbUser.id, 'message:react');
22:     if (rateLimited) {
23:       return rateLimited;
24:     }
25: 
26:     const messageRepository: IMessageRepository = new SupabaseMessageRepository(ctx.supabase);
27: 
28:     // Fetch the message to check current reaction state
29:     const message = await messageRepository.findById(messageId);
30: 
31:     if (!message) {
32:       return NextResponse.json({ error: 'Message not found' }, { status: 404 });
33:     }
34: 
35:     // Determine if user is adding or removing reaction
36:     // message.reactions is an array of MessageReaction objects
37:     const userHasReacted = message.reactions.some(
38:       (reaction) => reaction.userId === ctx.dbUser.id && reaction.emoji === emoji
39:     );
40:     let action: 'added' | 'removed';
41: 
42:     try {
43:       if (userHasReacted) {
44:         // User is removing their reaction
45:         await messageRepository.removeReaction(messageId, ctx.dbUser.id, emoji);
46:         action = 'removed';
47:       } else {
48:         // User is adding a new reaction
49:         await messageRepository.addReaction(messageId, { userId: ctx.dbUser.id, emoji });
50:         action = 'added';
51:       }
52:     } catch (repoError) {
53:        console.error(`Repository error during reaction ${userHasReacted ? 'removal' : 'addition'}:`, repoError);
54:        return NextResponse.json({ error: 'Error processing reaction' }, { status: 500 });
55:     }
56: 
57:     return NextResponse.json({ message: `Reaction ${action} successfully`, action }, { status: 200 });
58: 
59:   } catch (error) {
60:     console.error('Error processing reaction request:', error);
61:     return NextResponse.json({ error: 'Internal Server Error processing reaction request' }, { status: 500 });
62:   }
63: }
