160:   /**
161:    * Loads older pages of the active conversation until `messageId` is in the
162:    * feed (Phase 4 FR-022). Every round re-reads the cache, so it survives
163:    * fetches it does not own: a refetch that cancels its older-page request
164:    * (or one already running) is awaited and the search continues from the
165:    * pages the cache then holds. It stops when the message is loaded, the
166:    * history ends without it, a page fails (e.g. 403 after losing access),
167:    * `signal` aborts, or after MAX_HISTORY_SEARCH_ROUNDS rounds.
168:    */
169:   const loadHistoryUntilMessage = useCallback(
170:     async (messageId: string, signal: AbortSignal): Promise<MessageHistorySearchResult> => {
171:       if (!activeConversationId) return 'unavailable';
172:       const queryKey = ['messages', activeConversationId];
173: 
174:       for (let round = 0; round < MAX_HISTORY_SEARCH_ROUNDS; round += 1) {
175:         if (signal.aborted) return 'cancelled';
176:         const query = queryClient.getQueryCache().find({ queryKey, exact: true });
177:         if (!query) return 'unavailable';
178:         const data = query.state.data as MessagesInfiniteData | undefined;
179:         if (pagesContainMessage(data, messageId)) return 'found';
180: 
181:         const isFetching = query.state.fetchStatus === 'fetching';
182:         if (!isFetching && !data?.pages.at(-1)?.nextCursorBefore) {
183:           // History exhausted (or never loaded) without the message.
184:           return 'unavailable';
185:         }
186: 
187:         const failuresBefore = query.state.errorUpdateCount;
188:         // Without cancelRefetch a fetch already in flight is awaited instead
189:         // of being cancelled; the next round then loads the next older page.
190:         await fetchNextPage({ cancelRefetch: false });
191:         if (query.state.errorUpdateCount > failuresBefore) {
192:           if (signal.aborted) return 'cancelled';
193:           return pagesContainMessage(
194:             queryClient.getQueryData<MessagesInfiniteData>(queryKey),
195:             messageId
196:           )
197:             ? 'found'
198:             : 'unavailable';
199:         }
200:       }
201: 
202:       if (signal.aborted) return 'cancelled';
203:       return pagesContainMessage(queryClient.getQueryData<MessagesInfiniteData>(queryKey), messageId)
204:         ? 'found'
205:         : 'unavailable';
206:     },
207:     [activeConversationId, fetchNextPage, queryClient]
208:   );
