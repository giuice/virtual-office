150: const tabClaims = new Set<string>();
151: 
152: function rememberTabClaim(messageId: string): boolean {
153:   if (tabClaims.has(messageId)) return false;
154:   tabClaims.add(messageId);
155:   if (tabClaims.size > MAX_TAB_CLAIMS) {
156:     const oldest = tabClaims.values().next().value;
157:     if (oldest !== undefined) tabClaims.delete(oldest);
158:   }
159:   return true;
160: }
161: 
162: function claimAcrossTabs(messageId: string): boolean {
163:   try {
164:     const now = Date.now();
165:     const raw = window.localStorage.getItem(NOTIFIED_STORAGE_KEY);
166:     const parsed: unknown = raw ? JSON.parse(raw) : {};
167:     const claims: Record<string, number> = {};
168:     if (parsed && typeof parsed === 'object' && !Array.isArray(parsed)) {
169:       for (const [id, at] of Object.entries(parsed as Record<string, unknown>)) {
170:         if (typeof at === 'number' && now - at < NOTIFIED_TTL_MS) claims[id] = at;
171:       }
172:     }
173:     if (claims[messageId] !== undefined) return false;
174:     claims[messageId] = now;
175:     window.localStorage.setItem(NOTIFIED_STORAGE_KEY, JSON.stringify(claims));
176:     return true;
177:   } catch {
178:     // No shared storage: this tab alone decides.
179:     return true;
180:   }
181: }
182: 
183: /**
184:  * Claims a message so it is announced (or knowingly left unannounced) once:
185:  * once per tab, and once across this browser's tabs of the app. The
186:  * cross-tab check-and-set runs under a Web Lock, which makes it atomic
187:  * between tabs; without Web Locks it is best effort.
188:  */
189: export async function claimMessageNotification(messageId: string): Promise<boolean> {
190:   if (!rememberTabClaim(messageId)) return false;
191:   const locks = typeof navigator !== 'undefined' ? navigator.locks : undefined;
192:   if (locks?.request) {
193:     try {
194:       return await locks.request(NOTIFIED_LOCK_NAME, () => claimAcrossTabs(messageId));
195:     } catch {
196:       return claimAcrossTabs(messageId);
197:     }
198:   }
199:   return claimAcrossTabs(messageId);
200: }
201: 
202: /** Notification body: the text preview, or what kind of content was sent. */
203: export function notificationBody(message: Message, attachmentKind: 'voice' | 'file' | null): string {
204:   const text = message.content.replace(/\s+/g, ' ').trim();
205:   if (text) {
206:     return text.length > PREVIEW_MAX_LENGTH ? `${text.slice(0, PREVIEW_MAX_LENGTH - 1)}…` : text;
207:   }
208:   if (attachmentKind === 'voice') return 'Nota de voz';
209:   if (message.type === MessageType.IMAGE) return 'Imagem';
210:   return 'Anexo';
211: }
212: 
213: export function notificationTitle(conversation: Conversation, senderName: string): string {
214:   if (conversation.type === ConversationType.GROUP) {
215:     return `${senderName} em ${conversation.name?.trim() || 'grupo'}`;
216:   }
217:   return senderName;
218: }
219: 
220: /** One notification per conversation on screen: a newer one replaces it. */
221: export const notificationTag = (conversationId: string) => `vo-messaging-conversation-${conversationId}`;
222: 
223: /** Shows the notification; returns null when the browser refuses to construct it. */
224: export function showDesktopNotification(
225:   title: string,
226:   options: { body: string; tag: string },
227:   onClick: () => void,
228: ): Notification | null {
229:   if (readPermission() !== 'granted') return null;
230:   try {
231:     const notification = new window.Notification(title, options);
232:     notification.onclick = () => {
233:       try {
234:         window.focus();
235:       } catch {
236:         // Focusing is best effort.
237:       }
238:       onClick();
239:       notification.close();
240:     };
241:     return notification;
242:   } catch {
243:     // e.g. browsers that only allow notifications from a service worker.
244:     return null;
245:   }
246: }

