54: export function useMessages(activeConversationId: string | null) {
55:   const queryClient = useQueryClient();
56:   const { currentUserProfile } = useCompany();
57: 
58:   // Realtime is handled by a dedicated hook: useMessageSubscription.
59:   // Audit M-07: caches for other conversations are intentionally kept —
60:   // switching back reuses them; TanStack's gcTime evicts idle ones.
61: 
62:   const {
63:     data,
64:     isLoading,
65:     isFetchingNextPage,
66:     error,
67:     hasNextPage,
68:     fetchNextPage,
69:     refetch,
70:   } = useInfiniteQuery({
71:     queryKey: ['messages', activeConversationId],
72:     enabled: !!activeConversationId,
73:     initialPageParam: undefined as string | undefined,
74:     queryFn: async ({ pageParam }) => {
75:       if (!activeConversationId) {
76:         return { messages: [], hasMoreOlder: false, nextCursorBefore: undefined };
77:       }
78:       // When pageParam is provided, it is an opaque keyset cursor produced by
79:       // the server (composite "timestamp|id")
80:       const res = await messagingApi.getMessages(activeConversationId, {
81:         limit: MESSAGES_PAGE_SIZE,
82:         cursorBefore: pageParam,
83:       });
84:       return res; // { messages, hasMoreOlder, nextCursorBefore }
85:     },
86:     getNextPageParam: (lastPage) => lastPage.nextCursorBefore,
87:   });
88: 
89:   const messages: Message[] = useMemo(() => {
90:     if (!data?.pages) return [];
91:     // Pages are returned Newest -> Oldest (Page 0 is newest)
92:     // We want to display Oldest -> Newest
93:     // So we reverse the pages array before flattening
94:     const flattened = [...data.pages].reverse().flatMap((p) => p.messages);
95:     return flattened;
96:   }, [data]);
97: 
98:   // Initial load only. Background refetches (realtime/receipt invalidations,
99:   // focus) and older-page fetches must not swap the feed for a skeleton: that
100:   // unmounts the composer and discards whatever the user is typing.
101:   const loadingMessages = isLoading;
102:   const loadingMoreMessages = isFetchingNextPage;
103:   // A failed "Load more" keeps the loaded feed (below); the feed says so next
104:   // to the button until the user retries or opens another conversation. Kept
105:   // here rather than read from the query: a background refetch of the loaded
106:   // pages (e.g. a receipt invalidation) would clear the query error first.
107:   const [loadMoreFailedConversationId, setLoadMoreFailedConversationId] = useState<string | null>(null);
108:   const loadMoreMessagesFailed =
109:     activeConversationId !== null && loadMoreFailedConversationId === activeConversationId;
110:   // Only a conversation that never loaded shows the error state. Once the
111:   // feed has messages, a failed older page or background refetch keeps them
112:   // on screen (a member who lost access keeps a stable feed, FR-022).
113:   const errorMessages = error && !data ? (error as Error).message : null;
114:   const hasMoreMessages = !!hasNextPage;
