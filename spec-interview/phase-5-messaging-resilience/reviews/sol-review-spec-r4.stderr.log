31: const createTraceId = (prefix: string): string => {
32:   try {
33:     if (typeof crypto !== 'undefined' && typeof crypto.randomUUID === 'function') {
34:       return crypto.randomUUID();
35:     }
36:   } catch (error) {
37:     // Ignore and fallback to timestamp-based identifier
38:   }
39:   return `${prefix}-${Date.now().toString(36)}-${Math.random().toString(36).slice(2)}`;
40: };
