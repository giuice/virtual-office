28:   p_user_id uuid,
29:   p_action text,
30:   p_limit integer,
31:   p_window_seconds integer
32: ) returns boolean
33: language plpgsql
34: security definer
35: set search_path = ''
36: as $$
37: declare
38:   v_window_start timestamptz;
39:   v_count integer;
40: begin
41:   v_window_start := to_timestamp(
42:     floor(extract(epoch from now()) / p_window_seconds) * p_window_seconds
43:   );
44: 
45:   insert into private.rate_limit_counters as c (user_id, action, window_start, count)
46:   values (p_user_id, p_action, v_window_start, 1)
47:   on conflict (user_id, action, window_start)
48:   do update set count = c.count + 1
49:   returning count into v_count;
50: 
51:   -- Opportunistic cleanup of this user's expired windows (PK-indexed, cheap).
52:   delete from private.rate_limit_counters
53:   where user_id = p_user_id
54:     and action = p_action
55:     and window_start < v_window_start;
56: 
57:   return v_count <= p_limit;
58: end;
59: $$;
