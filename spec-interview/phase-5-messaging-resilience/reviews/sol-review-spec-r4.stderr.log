124: export type IncomingMessageDecision = 'notify' | 'viewing' | 'skip';
125: 
126: /**
127:  * BR-010: others' messages in direct/group conversations notify when the tab
128:  * is hidden or the drawer is not open on that conversation. "Tab hidden" is
129:  * the foreground-tab definition used by read receipts (TRACK T6):
130:  * `document.visibilityState`, not window focus.
131:  */
132: export function decideIncomingMessage(input: {
133:   message: Message;
134:   conversation: Conversation;
135:   currentUserId: string;
136:   viewedConversationId: string | null;
137:   tabVisible: boolean;
138: }): IncomingMessageDecision {
139:   const { message, conversation, currentUserId, viewedConversationId, tabVisible } = input;
140:   // users.id comparison (the realtime row's sender_id is the application id).
141:   if (message.senderId === currentUserId) return 'skip';
142:   if (message.type === MessageType.SYSTEM) return 'skip';
143:   if (conversation.type !== ConversationType.DIRECT && conversation.type !== ConversationType.GROUP) {
144:     return 'skip';
145:   }
146:   if (tabVisible && viewedConversationId === conversation.id) return 'viewing';
147:   return 'notify';
148: }
