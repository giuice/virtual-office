107: /** A solid-color PNG drawn by the browser. */
108: async function canvasPng(page: Page, width: number, height: number): Promise<Buffer> {
109:   const base64 = await page.evaluate(
110:     ({ w, h }) => {
111:       const canvas = document.createElement('canvas');
112:       canvas.width = w;
113:       canvas.height = h;
114:       const context = canvas.getContext('2d');
115:       if (!context) throw new Error('no 2d canvas context');
116:       context.fillStyle = '#8e24aa';
117:       context.fillRect(0, 0, w, h);
118:       return canvas.toDataURL('image/png').split(',')[1];
119:     },
120:     { w: width, h: height },
121:   );
122:   return Buffer.from(base64, 'base64');
123: }
