72: async function serverFeed(request: APIRequestContext, conversationId: string): Promise<ServerMessage[]> {
73:   const response = await request.get(`/api/messages/get?conversationId=${conversationId}&limit=50`);
74:   expect(response.ok(), await response.text()).toBe(true);
75:   return ((await response.json()) as { messages: ServerMessage[] }).messages;
76: }
77: 
78: async function serverReadCount(request: APIRequestContext, messageId: string): Promise<number> {
79:   const response = await request.get(`/api/messages/${messageId}/readers`);
80:   expect(response.ok(), await response.text()).toBe(true);
81:   return ((await response.json()) as { readCount: number }).readCount;
82: }
83: 
84: async function sendTextViaApi(request: APIRequestContext, conversationId: string, content: string): 
Promise<string> {
85:   const response = await request.post('/api/messages/create', { data: { conversationId, content } });
86:   expect(response.status(), await response.text()).toBe(201);
87:   return ((await response.json()) as { message: { id: string } }).message.id;
88: }
89: 
90: /** Uploads the files and sends them as one message, as the composer does. */
91: async function sendFilesViaApi(
92:   request: APIRequestContext,
93:   conversationId: string,
94:   files: Array<{ name: string; mimeType: string; buffer: Buffer }>,
95: ): Promise<{ messageId: string; attachmentIds: string[] }> {
96:   const attachmentIds: string[] = [];
97:   for (const file of files) {
98:     const upload = await request.post('/api/messages/upload', { multipart: { file, conversationId } });
99:     expect(upload.status(), await upload.text()).toBe(201);
100:     attachmentIds.push(((await upload.json()) as { attachment: { id: string } }).attachment.id);
101:   }
102:   const create = await request.post('/api/messages/create', { data: { conversationId, attachmentIds } });
103:   expect(create.status(), await create.text()).toBe(201);
104:   return { messageId: ((await create.json()) as { message: { id: string } }).message.id, attachmentIds };
105: }
