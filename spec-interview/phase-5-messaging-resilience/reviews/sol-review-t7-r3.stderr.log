  22: export async function withLocalMessagingDb<T>(work: (db: Client) => Promise<T>): Promise<T> {
  23:   // Explicit fields from the strict loopback parser — never the URL itself, so
  24:   // pg cannot resolve a different host than the one validated.
  25:   // TLS off and fixed session settings, so PGSSLMODE/PGOPTIONS-style
  26:   // environment variables cannot change how the local session behaves. The
  27:   // options string must be non-empty: pg treats '' as unset and falls back to
  28:   // PGOPTIONS, which could make the session read-only or time out cleanup.
  29:   const db = new Client({
  30:     ...parseLoopbackDatabaseUrl(MESSAGING_LOCAL_DB_URL),
  31:     ssl: false,
  32:     application_name: 'vo-messaging-e2e-fixtures',
  33:     options: '-c default_transaction_read_only=off -c statement_timeout=0',
  34:   });
  35:   await db.connect();
  36:   try {
  37:     return await work(db);
  38:   } finally {
  39:     await db.end();
  40:   }
  41: }
