 157: const messagesQueryKey = (conversationId: string) => ['messages', conversationId] as const;
 158: 
 159: const isMessageCached = (data: MessagesInfiniteData | undefined, messageId: string): boolean =>
 160:   Boolean(data?.pages?.some((page) => page.messages.some((existing) => existing.id === messageId)));
 161: 
 162: /**
 163:  * Whether a conversation's feed cache holds the message right now. Components
 164:  * render the feed from a provider that re-renders only once TanStack Query
 165:  * delivers its (deferred) observer notification, so the rendered list can
 166:  * briefly lag behind the cache.
 167:  */
 168: export function isMessageInFeedCache(
 169:   queryClient: QueryClient,
 170:   conversationId: string,
 171:   messageId: string
 172: ): boolean {
 173:   return isMessageCached(
 174:     queryClient.getQueryData<MessagesInfiniteData>(messagesQueryKey(conversationId)),
 175:     messageId
 176:   );
 177: }
