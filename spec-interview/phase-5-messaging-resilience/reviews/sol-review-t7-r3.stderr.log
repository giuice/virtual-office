  77: export const MESSAGING_REALTIME_STREAMS = ['messages', 'list', 'typing'] as const;
  78: export type MessagingRealtimeStream = (typeof MESSAGING_REALTIME_STREAMS)[number];
  79: export type ObservedRealtimeStream = MessagingRealtimeStream | 'presence';
  80: export type RealtimeFaultKind = 'error' | 'timeout' | 'close';
