 100: // Ids of messages this client saw deleted through a Realtime DELETE event, per
 101: // query client, bounded to the last 1000 (the oldest are forgotten first).
 102: // Only three merges consult it: a create response (useMessages), a Realtime
 103: // INSERT (useMessageSubscription) and the re-merge after an in-flight fetch
 104: // (keepMessageThroughInflightFetch). It does not reconcile deletions this
 105: // client missed (e.g. during a Realtime stream gap), and fetched pages are
 106: // not filtered by it: a feed GET that read the row before it was deleted can
 107: // still return it. No product path deletes stored messages today; the only
 108: // deletion is a sender's own Data API delete under RLS (delete_own_messages).
 109: const MAX_REMEMBERED_DELETIONS = 1000;
 110: const deletedMessageIds = new WeakMap<QueryClient, Set<string>>();
 111: 
 112: export function markMessageDeleted(queryClient: QueryClient, messageId: string): void {
 113:   let ids = deletedMessageIds.get(queryClient);
 114:   if (!ids) {
 115:     ids = new Set();
 116:     deletedMessageIds.set(queryClient, ids);
 117:   }
 118:   ids.delete(messageId);
 119:   ids.add(messageId);
 120:   if (ids.size > MAX_REMEMBERED_DELETIONS) {
 121:     const oldest = ids.values().next().value;
 122:     if (oldest !== undefined) ids.delete(oldest);
 123:   }
 124: }
