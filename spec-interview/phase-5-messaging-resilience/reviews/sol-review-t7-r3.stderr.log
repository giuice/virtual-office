response = await fetch('/api/conversations/resolve', {\n        method: 'POST',\n        headers: {\n          
'Content-Type': 'application/json',\n        },\n        body: JSON.stringify(params),\n      });\n\n      const 
duration = getTimestamp() - start;\n      debugLogger.messaging.metric(scope, 'fetch', duration, {\n        
requestId,\n        status: response.status,\n      });\n\n      if (!response.ok) {\n        const errorData = await 
