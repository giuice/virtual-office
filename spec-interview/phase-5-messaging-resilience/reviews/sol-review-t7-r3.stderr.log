 130: /**
 131:  * Merges a stored message (a Realtime INSERT, a create response) into the
 132:  * infinite-query cache:
 133:  * - id already present in ANY page → no-op (realtime echo / duplicate event);
 134:  * - otherwise → appended to page 0, the newest window.
 135:  * Pending messages live outside this cache (pendingMessagesQueryKey) and are
 136:  * matched to stored ones by key only (visiblePendingMessages).
 137:  */
 138: export function appendMessageToPages(
 139:   oldData: MessagesInfiniteData | undefined,
 140:   message: Message
 141: ): MessagesInfiniteData {
 142:   if (!oldData || !oldData.pages || oldData.pages.length === 0) {
 143:     return { pages: [{ messages: [message] }], pageParams: [undefined] };
 144:   }
 145: 
 146:   for (const page of oldData.pages) {
 147:     if (page.messages.some((existing) => existing.id === message.id)) {
 148:       return oldData;
 149:     }
 150:   }
 151: 
 152:   const pages = [...oldData.pages];
 153:   pages[0] = { ...pages[0], messages: [...pages[0].messages, message] };
 154:   return { ...oldData, pages };
 155: }
