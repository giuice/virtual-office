  51: const mapRowToMessage = (row: any): Message => ({
  52:   id: row.id,
  53:   conversationId: row.conversation_id,
  54:   senderId: row.sender_id,
  55:   content: row.content,
  56:   timestamp: new Date(row.timestamp),
