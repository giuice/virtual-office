 531:   redeliver(seq: number): FrameRecord {
 532:     const passed = this.passedChanges.get(seq);
 533:     const original = this.frameLog.find((record) => record.seq === seq);
 534:     if (!passed || !original) {
 535:       throw new Error(`No passed postgres_changes frame #${seq} to redeliver.`);
 536:     }
 537:     const { connection, message } = passed;
 538:     if (connection.record.closedSeq !== null) {
 539:       throw new Error(`Frame #${seq} came on socket ${connection.id}, which is closed.`);
 540:     }
 541:     const state = connection.topics.get(original.topic);
 542:     // postgres_changes frames carry no join ref; the topic's join must be the
 543:     // one that was current when the frame passed (no rejoin since).
 544:     const rejoined = this.frameLog.some(
 545:       (record) => record.seq > seq && record.connection === connection.id && record.topic === original.topic
 546:         && record.direction === 'out' && record.event === 'phx_join',
 547:     );
 548:     if (!state?.joined || rejoined) {
 549:       throw new Error(`Frame #${seq}'s channel ${original.topic} is no longer the same joined channel.`);
 550:     }
 551:     connection.page.send(message);
 552:     const frame = decodeFrame(message, 'in') as PhoenixFrame;
 553:     const redeliveredSeq = this.log(connection, 'in', original.stream, frame, 'redeliver');
 554:     return this.frameLog.find((record) => record.seq === redeliveredSeq) as FrameRecord;
 555:   }
 556: 
 557:   private injectToPage(
 558:     connection: RoutedConnection,
 559:     stream: ObservedRealtimeStream,
 560:     frame: [string | null, string | null, string, string, unknown],
 561:   ): void {
 562:     const encoded = encodeFrame(frame);
 563:     connection.page.send(encoded);
 564:     this.log(connection, 'in', stream, decodeFrame(encoded, 'in') as PhoenixFrame, 'inject');
 565:   }
 566: 
 567:   private openConnections(): RoutedConnection[] {
 568:     return this.routed.filter((connection) => connection.record.closedSeq === null);
 569:   }
 570: 
 571:   // --- faults --------------------------------------------------------------
 572: 
 573:   async fail(stream: MessagingRealtimeStream, kind: RealtimeFaultKind): Promise<FaultKick> {
 574:     if (this.faults.has(stream)) {
 575:       throw new Error(`The ${stream} stream is already faulted; restore it first.`);
 576:     }
 577:     const mark = this.mark();
 578:     this.faults.set(stream, { kind, since: mark, joinAttempts: 0 });
 579:     let kicked = 0;
 580:     for (const connection of this.openConnections()) {
 581:       for (const [topic, state] of connection.topics) {
 582:         if (state.stream !== stream || !state.joined || state.joinRef === null) continue;
 583:         kicked += 1;
 584:         if (kind === 'close') {
 585:           // Real server close: Realtime re-validates the channel's token,
 586:           // pushes `system` error + `phx_close`, and ends the server channel.
 587:           this.harnessRefCounter += 1;
 588:           const ref = `t25-close-${this.harnessRefCounter}`;
 589:           this.harnessRefs.add(ref);
 590:           state.closingJoinRef = state.joinRef;
 591:           const encoded = encodeFrame([state.joinRef, ref, topic, 'access_token', { access_token: 
INVALID_ACCESS_TOKEN }]);
 592:           connection.server.send(encoded);
 593:           this.log(connection, 'out', stream, decodeFrame(encoded, 'out') as PhoenixFrame, 'inject-server');
 594:         } else {
 595:           state.joined = false;
 596:           this.injectToPage(connection, stream, [state.joinRef, state.joinRef, topic, 'phx_error', {}]);
 597:         }
 598:       }
 599:     }
 600:     return { mark, kicked };
 601:   }
 602: 
 603:   restore(stream?: MessagingRealtimeStream): number {
 604:     if (stream) {
 605:       this.faults.delete(stream);
 606:     } else {
 607:       this.faults.clear();
 608:     }
 609:     return this.mark();
 610:   }
