 170: // DELETE payloads only carry the primary key under RLS, so the conversation
 171: // is unknown — drop the message from every cached conversation.
 172: const removeMessageFromAllCaches = (queryClient: QueryClient, messageId: string) => {
 173:   const allMessagesQueries = queryClient.getQueriesData<MessagesInfiniteData>({
 174:     queryKey: ['messages'],
 175:   });
 176: 
 177:   allMessagesQueries.forEach(([queryKey, oldData]) => {
 178:     if (!oldData?.pages) return;
 179: 
 180:     let changed = false;
 181:     const pages = oldData.pages.map((page) => {
 182:       const filtered = page.messages.filter((existing) => existing.id !== messageId);
 183:       if (filtered.length !== page.messages.length) {
 184:         changed = true;
 185:         return { ...page, messages: filtered };
 186:       }
 187:       return page;
 188:     });
 189: 
 190:     if (changed) {
 191:       queryClient.setQueryData(queryKey, { ...oldData, pages });
 192:     }
 193:   });
 194: };
