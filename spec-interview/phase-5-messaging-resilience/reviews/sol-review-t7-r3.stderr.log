 344: function deletePassedAt(harness: RealtimeFaultController, connection: number, messageId: string): number | 
undefined {
 345:   return harness
 346:     .frames({ stream: 'messages', direction: 'in', action: 'pass', events: ['postgres_changes'] })
 347:     .find(
 348:       (frame) =>
 349:         frame.connection === connection &&
 350:         frame.detail.table === 'messages' &&
 351:         frame.detail.type === 'DELETE' &&
 352:         frame.detail.recordId === messageId,
 353:     )?.at;
 354: }
