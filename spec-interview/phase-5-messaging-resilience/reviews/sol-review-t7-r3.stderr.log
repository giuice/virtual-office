 392: /**
 393:  * A's two tabs (same device and session) on the DM, with a parent message
 394:  * whose thread (it already has one reply) is expanded in both tabs, so a
 395:  * reply renders with its parent quote.
 396:  */
 397: async function openSenderTabs(
 398:   phase5World: { conversations: { directId: string } },
 399:   openDevice: (key: 'A') => Promise<Phase5Device>,
 400:   attach: (device: Phase5Device, options?: { reload?: boolean }) => Promise<RealtimeFaultController>,
 401: ): Promise<SenderTabs> {
 402:   const { directId } = phase5World.conversations;
 403:   const a = await openDevice('A');
 404:   const harness = await attach(a, { reload: false });
 405: 
 406:   const parentText = `t7 parent ${randomUUID()}`;
 407:   const parentId = await createAs(a.page, { conversationId: directId, content: parentText });
 408:   await createAs(a.page, { conversationId: directId, content: `t7 earlier reply ${randomUUID()}`, replyToId: 
parentId });
 409: 
 410:   const tab1 = a.page;
 411:   await openConversation(tab1, directId);
 412:   const conn1 = newOpenConnection(harness, []);
 413:   await waitForMessagesStream(harness, conn1);
 414: 
 415:   const tab2 = await a.newTab();
 416:   harness.watchPage(tab2, `${a.label} tab 2`);
 417:   await openConversation(tab2, directId);
 418:   const conn2 = newOpenConnection(harness, [conn1]);
 419:   await waitForMessagesStream(harness, conn2);
 420: 
 421:   for (const tab of [tab1, tab2]) {
 422:     await tab.locator(`[data-testid="reply-count-${parentId}"]`).click();
 423:     await expect(tab.locator(`[data-testid="thread-panel-${parentId}"]`)).toBeVisible();
 424:   }
 425:   return { a, harness, tab1, tab2, conn1, conn2, parentId, parentText };
 426: }
