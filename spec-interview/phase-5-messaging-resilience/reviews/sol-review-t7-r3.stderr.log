  88:     ['messages', message.conversationId],
  89:     (oldData) => appendMessageToPages(oldData, message)
  90:   );
  91:   keepMessageThroughInflightFetch(queryClient, message.conversationId, message);
  92:   // Phase 5 FR-034: the sender's pending copy of this key is resolved now
  93:   // (after the stored message is in the feed), and stays resolved.
  94:   resolvePendingMessages(queryClient, message.conversationId, [message]);
