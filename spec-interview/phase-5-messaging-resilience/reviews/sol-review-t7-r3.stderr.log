 395:  * reply renders with its parent quote.
 396:  */
 397: async function openSenderTabs(
 398:   phase5World: { conversations: { directId: string } },
 399:   openDevice: (key: 'A') => Promise<Phase5Device>,
 400:   attach: (device: Phase5Device, options?: { reload?: boolean }) => Promise<RealtimeFaultController>,
 401: ): Promise<SenderTabs> {
 402:   const { directId } = phase5World.conversations;
 403:   const a = await openDevice('A');
