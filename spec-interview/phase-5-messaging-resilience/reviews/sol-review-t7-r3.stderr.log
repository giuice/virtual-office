 239: /** Counts the bubbles of `text` (plain / reply) after every DOM change of the tab. */
 240: async function installBubbleSampler(page: Page, text: string, parentText: string): Promise<void> {
 241:   await page.evaluate(
 242:     ({ text: trackedText, parentText: quotedParent }) => {
 243:       const classes = ['plain', 'reply'] as const;
 244:       const state = {
 245:         evaluations: 0,
 246:         maxSameId: 0,
 247:         classes: Object.fromEntries(
 248:           classes.map((name) => [name, { max: 0, current: 0, seen: false, lost: 0, quoteMissing: 0, ids: [] as 
string[] }]),
 249:         ),
 250:         history: [] as Array<{ t: number; plain: string[]; reply: string[] }>,
 251:       };
 252:       let lastSignature = '';
 253:       const evaluate = () => {
 254:         state.evaluations += 1;
 255:         const ids: Record<string, string[]> = { plain: [], reply: [] };
 256:         const feed = document.querySelector('[data-testid="messages-feed"]');
 257:         const wrappers = feed ? Array.from(feed.querySelectorAll('[data-message-id]')) : [];
 258:         const rendered = new Map<string, number>();
 259:         for (const wrapper of wrappers) {
 260:           const id = wrapper.getAttribute('data-message-id') ?? '';
 261:           const item = Array.from(wrapper.children).find(
 262:             (child) => child.getAttribute('data-testid') === `message-${id}`,
 263:           );
 264:           if (!item) continue;
 265:           rendered.set(id, (rendered.get(id) ?? 0) + 1);
 266:           state.maxSameId = Math.max(state.maxSameId, rendered.get(id) ?? 0);
 267:           const hasText = Array.from(item.querySelectorAll('p')).some(
 268:             (paragraph) => paragraph.textContent === trackedText,
 269:           );
 270:           if (!hasText) continue;
 271:           const quote = item.querySelector(`[data-testid="reply-context-${id}"]`);
 272:           const name = quote ? 'reply' : 'plain';
 273:           ids[name].push(id);
 274:           if (quote && !(quote.textContent ?? '').includes(quotedParent)) {
 275:             state.classes[name].quoteMissing += 1;
 276:           }
 277:         }
 278:         for (const name of classes) {
 279:           const sample = state.classes[name];
 280:           const count = ids[name].length;
 281:           if (sample.seen && count === 0) sample.lost += 1;
 282:           if (count > 0) sample.seen = true;
 283:           sample.current = count;
 284:           sample.max = Math.max(sample.max, count);
 285:           sample.ids = ids[name];
 286:         }
 287:         const signature = JSON.stringify(ids);
 288:         if (signature !== lastSignature && state.history.length < 200) {
 289:           lastSignature = signature;
 290:           state.history.push({ t: Math.round(performance.now()), plain: ids.plain, reply: ids.reply });
 291:         }
 292:       };
 293:       (window as unknown as { __t7Bubbles?: typeof state }).__t7Bubbles = state;
 294:       // Starts a new observation window (after an expected disappearance).
 295:       (window as unknown as { __t7ResetBubbles?: () => void }).__t7ResetBubbles = () => {
 296:         for (const name of classes) {
 297:           const sample = state.classes[name];
 298:           sample.max = sample.current;
 299:           sample.seen = sample.current > 0;
 300:           sample.lost = 0;
 301:         }
 302:       };
 303:       evaluate();
 304:       new MutationObserver(evaluate).observe(document.body, {
 305:         subtree: true,
 306:         childList: true,
 307:         characterData: true,
 308:         attributes: true,
 309:         attributeFilter: ['data-message-id', 'data-testid'],
 310:       });
 311:     },
 312:     { text, parentText },
 313:   );
 314: }
 315: 
 316: async function resetSampler(page: Page): Promise<void> {
 317:   await page.evaluate(() => (window as unknown as { __t7ResetBubbles: () => void }).__t7ResetBubbles());
 318: }
