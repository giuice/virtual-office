 125: const handleReactionUpdate = (
 126:   queryClient: QueryClient,
 127:   messageId: string,
 128:   userId: string,
 129:   emoji: string,
 130:   eventType: 'INSERT' | 'DELETE',
 131:   timestamp: Date
 132: ) => {
 133:   if (debugLogger.messaging.enabled()) {
 134:     debugLogger.messaging.trace('useMessageSubscription', 'reaction:event', {
 135:       messageId,
 136:       emoji,
 137:       eventType,
 138:     });
 139:   }
 140: 
 141:   // Update all conversation caches that might contain this message
 142:   const allMessagesQueries = queryClient.getQueriesData<MessagesInfiniteData>({
 143:     queryKey: ['messages'],
 144:   });
 145: 
 146:   allMessagesQueries.forEach(([queryKey, oldData]) => {
 147:     if (!oldData?.pages) return;
 148: 
 149:     const currentPages = oldData.pages;
 150:     const nextPages = toggleReactionInPages({
 151:       pages: currentPages,
 152:       messageId,
 153:       emoji,
 154:       userId,
 155:       timestamp: eventType === 'INSERT' ? timestamp : undefined,
 156:       mode: eventType === 'INSERT' ? 'add' : 'remove',
 157:     });
 158: 
 159:     if (nextPages === currentPages) {
 160:       return;
 161:     }
 162: 
 163:     queryClient.setQueryData(queryKey, {
 164:       ...oldData,
 165:       pages: nextPages,
 166:     });
 167:   });
 168: };
