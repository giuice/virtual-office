  76: const appendMessageToCache = (queryClient: QueryClient, message: Message) => {
  77:   // A conversation whose history was never loaded has no cache entry. Creating
  78:   // one from this single row would make the feed treat it as the whole history
  79:   // (no older-page cursor, 5 min staleTime) and hide every earlier message, so
  80:   // they could never be seen or read. Its first open fetches the history.
  81:   if (!queryClient.getQueryData(['messages', message.conversationId])) {
  82:     return;
  83:   }
  84:   if (isMessageDeleted(queryClient, message.id)) {
  85:     return;
  86:   }
