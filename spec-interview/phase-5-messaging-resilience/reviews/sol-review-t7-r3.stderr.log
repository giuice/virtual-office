  60: /**
  61:  * Phase 5 FR-034: retires the sender's pending messages of a conversation
  62:  * whose stored message has been observed (`stored`: a Realtime INSERT just
  63:  * merged, or the feed as rendered after a fetch). A pending message is
  64:  * resolved the first time its key is seen: it is removed from every pending
  65:  * list of that conversation, so it is not shown again as "sending" if the
  66:  * stored message later leaves the feed (for example a Realtime DELETE). Call
  67:  * it only after the stored message is in the feed cache, so no render shows
  68:  * neither copy.
  69:  */
  70: export function resolvePendingMessages(
  71:   queryClient: QueryClient,
  72:   conversationId: string,
  73:   stored: readonly Message[]
  74: ): void {
  75:   const storedKeys = new Set<string>();
  76:   for (const message of stored) {
  77:     const key = correlationKey(message);
  78:     if (key) storedKeys.add(key);
  79:   }
  80:   if (storedKeys.size === 0) return;
  81:   queryClient
  82:     .getQueriesData<Message[]>({ queryKey: ['messages-pending'] })
  83:     .forEach(([queryKey, pending]) => {
  84:       if (queryKey[2] !== conversationId || !pending?.length) return;
  85:       const remaining = pending.filter((message) => {
  86:         const key = correlationKey(message);
  87:         return key === null || !storedKeys.has(key);
  88:       });
  89:       if (remaining.length !== pending.length) {
  90:         queryClient.setQueryData<Message[]>(queryKey, remaining);
  91:       }
  92:     });
  93: }
