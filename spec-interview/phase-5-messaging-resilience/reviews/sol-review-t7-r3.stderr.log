 111: // ---------------------------------------------------------------------------
 112: // Phoenix frames (realtime-js protocol 2.0.0: JSON arrays, binary broadcasts)
 113: // ---------------------------------------------------------------------------
 114: 
 115: interface PhoenixFrame {
 116:   joinRef: string | null;
 117:   ref: string | null;
 118:   topic: string;
 119:   event: string;
 120:   payload: unknown;
 121:   binary: boolean;
 122: }
 123: 
 124: type FrameDirection = 'in' | 'out';
 125: 
 126: function decodeFrame(message: string | Buffer, direction: FrameDirection): PhoenixFrame | null {
 127:   try {
 128:     return decodeFrameUnsafe(message, direction);
 129:   } catch {
 130:     return null;
 131:   }
 132: }
 133: 
 134: function decodeFrameUnsafe(message: string | Buffer, direction: FrameDirection): PhoenixFrame | null {
 135:   if (typeof message === 'string') {
 136:     try {
 137:       const frame: unknown = JSON.parse(message);
 138:       if (Array.isArray(frame) && frame.length === 5 && typeof frame[2] === 'string' && typeof frame[3] === 
'string') {
 139:         const [joinRef, ref, topic, event, payload] = frame as [unknown, unknown, string, string, unknown];
 140:         return {
 141:           joinRef: typeof joinRef === 'string' ? joinRef : null,
 142:           ref: typeof ref === 'string' ? ref : null,
 143:           topic,
 144:           event,
 145:           payload,
 146:           binary: false,
 147:         };
 148:       }
 149:     } catch {
 150:       // Not a Phoenix JSON frame.
 151:     }
 152:     return null;
 153:   }
 154:   if (message.length < 1) return null;
 155:   const kind = message.readUInt8(0);
 156:   // Server → client user broadcast: kind 4, [topic, event, meta] sizes, encoding.
 157:   if (direction === 'in' && kind === 4 && message.length >= 5) {
 158:     const topicSize = message.readUInt8(1);
 159:     const eventSize = message.readUInt8(2);
 160:     const offset = 5;
 161:     return {
 162:       joinRef: null,
 163:       ref: null,
 164:       topic: message.toString('utf8', offset, offset + topicSize),
 165:       event: 'broadcast',
 166:       payload: { event: message.toString('utf8', offset + topicSize, offset + topicSize + eventSize) },
 167:       binary: true,
 168:     };
 169:   }
 170:   // Client → server user broadcast push: kind 3, [joinRef, ref, topic, event, meta] sizes, encoding.
 171:   if (direction === 'out' && kind === 3 && message.length >= 7) {
 172:     const joinRefSize = message.readUInt8(1);
 173:     const refSize = message.readUInt8(2);
 174:     const topicSize = message.readUInt8(3);
 175:     const eventSize = message.readUInt8(4);
 176:     let offset = 7;
 177:     const joinRef = message.toString('utf8', offset, offset + joinRefSize);
 178:     offset += joinRefSize;
 179:     const ref = message.toString('utf8', offset, offset + refSize);
 180:     offset += refSize;
 181:     const topic = message.toString('utf8', offset, offset + topicSize);
 182:     offset += topicSize;
 183:     return {
 184:       joinRef: joinRef || null,
 185:       ref: ref || null,
 186:       topic,
 187:       event: 'broadcast',
 188:       payload: { event: message.toString('utf8', offset, offset + eventSize) },
 189:       binary: true,
 190:     };
 191:   }
 192:   return null;
 193: }
