 740: /**
 741:  * Routes the context's Realtime sockets through a fault harness and records
 742:  * the page's subscribe-callback statuses. With `reload` (default) the page is
 743:  * reloaded so its socket is created under the route.
 744:  */
 745: export async function attachRealtimeFaultHarness(
 746:   context: BrowserContext,
 747:   page: Page,
 748:   label: string,
 749:   { reload = true }: { reload?: boolean } = {},
 750: ): Promise<RealtimeFaultController> {
 751:   const harness = new FaultHarness();
 752:   await context.routeWebSocket(/\/realtime\/v1\/websocket/, (ws) => harness.route(ws));
 753:   await context.addInitScript((key) => {
 754:     try {
 755:       window.localStorage.setItem(key, '1');
 756:     } catch {
 757:       // Storage unavailable: the dev server enables the traces by default.
 758:     }
 759:   }, MESSAGING_DEBUG_FLAG_KEY);
 760:   harness.watchPage(page, label);
 761:   if (reload && page.url() !== 'about:blank') {
 762:     await page.reload();
 763:   }
 764:   return harness;
 765: }
