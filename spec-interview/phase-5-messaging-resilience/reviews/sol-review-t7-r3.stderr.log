 616:   // --- observation ---------------------------------------------------------
 617: 
 618:   watchPage(page: Page, label: string): void {
 619:     page.on('console', (message) => this.onConsole(message, label));
 620:   }
 621: 
 622:   private onConsole(message: ConsoleMessage, label: string): void {
 623:     const text = message.text();
 624:     const trace = STATUS_TRACE.exec(text);
 625:     if (trace) {
 626:       const seq = this.next();
 627:       const at = Date.now();
 628:       const stream = TRACE_STREAM[trace[1]];
 629:       const read = (async () => {
 630:         const value = (await message.args()[1]?.jsonValue()) as { status?: unknown; conversationId?: unknown } | 
undefined;
 631:         if (typeof value?.status !== 'string') return;
 632:         this.statusLog.push({
 633:           seq,
 634:           at,
 635:           stream,
 636:           status: value.status,
 637:           page: label,
 638:           ...(typeof value.conversationId === 'string' ? { conversationId: value.conversationId } : {}),
 639:         });
 640:       })().catch(() => {});
 641:       this.pendingStatus.add(read);
 642:       void read.finally(() => this.pendingStatus.delete(read));
 643:       return;
 644:     }
 645:     if (text.startsWith(PRESENCE_EVENT_PREFIX)) {
 646:       try {
 647:         const event = JSON.parse(text) as { category?: unknown; action?: unknown; resultCode?: unknown };
 648:         if (event.category === 'realtime' && event.action === 'subscription' && typeof event.resultCode === 
'string') {
 649:           this.statusLog.push({ seq: this.next(), at: Date.now(), stream: 'presence', status: event.resultCode, 
page: label });
 650:         }
 651:       } catch {
 652:         // Not a complete observability line.
 653:       }
 654:     }
 655:   }
 656: 
 657:   async settle(): Promise<void> {
 658:     await Promise.all([...this.pendingStatus]);
 659:   }
 660: 
 661:   statuses(stream: ObservedRealtimeStream, { since = 0 }: { since?: number } = {}): StatusRecord[] {
 662:     return this.statusLog
 663:       .filter((record) => record.stream === stream && record.seq > since)
 664:       .sort((left, right) => left.seq - right.seq);
 665:   }
 666: 
 667:   status(stream: ObservedRealtimeStream): string | null {
 668:     const all = this.statuses(stream);
 669:     return all.length ? all[all.length - 1].status : null;
 670:   }
 671: 
 672:   async waitForStatus(
 673:     stream: ObservedRealtimeStream,
 674:     status: string,
 675:     { since = 0, timeout = 30_000 }: { since?: number; timeout?: number } = {},
 676:   ): Promise<StatusRecord> {
 677:     let found: StatusRecord | undefined;
 678:     await expect
 679:       .poll(
 680:         () => {
 681:           found = this.statuses(stream, { since }).find((record) => record.status === status);
 682:           return found !== undefined;
 683:         },
 684:         { timeout, message: `${stream} stream reports ${status} (since #${since})` },
 685:       )
 686:       .toBe(true);
 687:     return found as StatusRecord;
 688:   }
 689: 
 690:   joinedTopics(stream: ObservedRealtimeStream): string[] {
 691:     return this.openConnections().flatMap((connection) =>
 692:       [...connection.topics]
 693:         .filter(([, state]) => state.stream === stream && state.joined)
 694:         .map(([topic]) => topic),
 695:     );
 696:   }
 697: 
 698:   async waitForReady(stream: ObservedRealtimeStream, { timeout = 30_000 }: { timeout?: number } = {}): 
Promise<void> {
 699:     await expect
 700:       .poll(
 701:         () => {
 702:           const subscribed = stream === 'presence'
 703:             ? ['SUBSCRIBED', 'RECONNECTED'].includes(this.status(stream) ?? '')
 704:             : this.status(stream) === 'SUBSCRIBED';
 705:           const joined = this.openConnections().some((connection) =>
 706:             [...connection.topics.values()].some(
 707:               (state) =>
 708:                 state.stream === stream
 709:                 && state.joined
 710:                 && (!POSTGRES_STREAMS.has(stream) || state.confirmedJoinRef === state.joinRef),
 711:             ),
 712:           );
 713:           return subscribed && joined;
 714:         },
 715:         { timeout, message: `${stream} stream joined, SUBSCRIBED and streaming` },
 716:       )
 717:       .toBe(true);
 718:   }
 719: 
 720:   frames({ stream, since = 0, direction, action, events }: FrameFilter = {}): FrameRecord[] {
 721:     return this.frameLog.filter(
 722:       (record) =>
 723:         record.seq > since
 724:         && (stream === undefined || record.stream === stream)
 725:         && (direction === undefined || record.direction === direction)
 726:         && (action === undefined || record.action === action)
 727:         && (events === undefined || events.includes(record.event)),
 728:     );
 729:   }
 730: 
 731:   connections(): ConnectionRecord[] {
 732:     return this.routed.map((connection) => ({ ...connection.record }));
 733:   }
 734: 
 735:   violations(): string[] {
 736:     return [...this.refused.map((host) => `refused non-loopback Realtime host ${host}`), ...this.internalErrors];
 737:   }
 738: }
