 360: function expectOneBubbleThroughout(
 361:   label: string,
 362:   state: SamplerState,
 363:   expected: Record<BubbleClass, string | null>,
 364: ): void {
 365:   const history = JSON.stringify(state.history);
 366:   expect(state.evaluations, `${label}: sampler ran`).toBeGreaterThan(1);
 367:   for (const name of ['plain', 'reply'] as const) {
 368:     const sample = state.classes[name];
 369:     const id = expected[name];
 370:     if (id === null) {
 371:       expect(sample.max, `${label}: no ${name} bubble expected; history ${history}`).toBe(0);
 372:       continue;
 373:     }
 374:     expect(sample.max, `${label}: never two ${name} bubbles; history ${history}`).toBeLessThanOrEqual(1);
 375:     expect(sample.lost, `${label}: the ${name} bubble never disappeared; history ${history}`).toBe(0);
 376:     expect(sample.quoteMissing, `${label}: the ${name} bubble always quoted its parent; history 
${history}`).toBe(0);
 377:     expect(sample.ids, `${label}: exactly one ${name} bubble, the stored one; history ${history}`).toEqual([id]);
 378:   }
 379: }
