 197: /** Identifying, content-free summary of a frame for the log. */
 198: function summarize(frame: PhoenixFrame): FrameDetail {
 199:   const payload = (frame.payload ?? {}) as Record<string, unknown>;
 200:   const detail: FrameDetail = {};
 201:   if (typeof payload.status === 'string') detail.status = payload.status;
 202:   if (typeof payload.extension === 'string') detail.extension = payload.extension;
 203:   if (frame.event === 'broadcast' && typeof payload.event === 'string') detail.broadcastEvent = payload.event;
 204:   if (frame.event === 'postgres_changes') {
 205:     const data = (payload.data ?? {}) as Record<string, unknown>;
 206:     if (typeof data.table === 'string') detail.table = data.table;
 207:     if (typeof data.type === 'string') detail.type = data.type;
 208:     const record = (data.record ?? data.old_record ?? {}) as Record<string, unknown>;
 209:     if (typeof record.id === 'string') detail.recordId = record.id;
 210:   }
 211:   return detail;
 212: }
