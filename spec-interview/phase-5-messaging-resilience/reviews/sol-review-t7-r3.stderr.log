 179: /**
 180:  * Keeps a just-merged message (a resolved send, a realtime INSERT) in the
 181:  * feed when a fetch of that feed is already in flight.
 182:  *
 183:  * A fetch resolves with the server rows it read when it started and replaces
 184:  * the cached pages. If the message was committed after that read, the result
 185:  * lacks it and would silently drop it from the feed until some later
 186:  * refetch. Once the in-flight fetch settles the message is merged again
 187:  * (a no-op when the result already has it). If the message leaves the cache
 188:  * while the fetch is still running (deleted, or a failed send rolled back),
 189:  * it is not brought back, and neither is a message this client has seen
 190:  * deleted by a Realtime DELETE (isMessageDeleted) by the time the fetch
 191:  * settles.
 192:  */
 193: export function keepMessageThroughInflightFetch(
 194:   queryClient: QueryClient,
 195:   conversationId: string,
 196:   message: Message
 197: ): void {
 198:   const queryKey = messagesQueryKey(conversationId);
 199:   const queryCache = queryClient.getQueryCache();
 200:   const query = queryCache.find<MessagesInfiniteData>({ queryKey, exact: true });
 201:   if (!query || query.state.fetchStatus !== 'fetching') {
 202:     return;
 203:   }
 204: 
 205:   const unsubscribe = queryCache.subscribe((event) => {
 206:     if (event.query !== query) {
 207:       return;
 208:     }
 209:     if (event.type === 'removed') {
 210:       unsubscribe();
 211:       return;
 212:     }
 213:     if (event.type !== 'updated') {
 214:       return;
 215:     }
 216:     if (query.state.fetchStatus === 'fetching') {
 217:       // Until the fetch settles, data only changes through local updates.
 218:       if (!isMessageCached(query.state.data, message.id)) {
 219:         unsubscribe();
 220:       }
 221:       return;
 222:     }
 223:     unsubscribe();
 224:     if (isMessageDeleted(queryClient, message.id)) {
 225:       return;
 226:     }
 227:     queryClient.setQueryData<MessagesInfiniteData | undefined>(queryKey, (oldData) =>
 228:       oldData ? appendMessageToPages(oldData, message) : oldData
 229:     );
 230:   });
 231: }
