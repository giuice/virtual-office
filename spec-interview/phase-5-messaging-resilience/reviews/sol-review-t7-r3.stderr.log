  96: 
  97: const updateMessageInCache = (queryClient: QueryClient, conversationId: string, row: any) => {
  98:   queryClient.setQueryData<MessagesInfiniteData | undefined>(
  99:     ['messages', conversationId],
 100:     (oldData) => {
 101:       if (!oldData || !oldData.pages) {
 102:         return oldData;
 103:       }
 104: 
 105:       const pages = oldData.pages.map((page) => ({
 106:         ...page,
 107:         messages: page.messages.map((existing) =>
 108:           existing.id === row.id
 109:             ? {
 110:                 ...existing,
 111:                 content: row.content ?? existing.content,
 112:                 status: row.status ?? existing.status,
 113:                 isEdited: row.is_edited ?? existing.isEdited,
 114:                 reactions: row.reactions ?? existing.reactions,
 115:               }
 116:             : existing
 117:         ),
 118:       }));
 119: 
 120:       return { ...oldData, pages };
 121:     }
 122:   );
 123: };
