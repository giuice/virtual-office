 302 /**
 303  * POST /api/messages/create
 304  * Body: { conversationId, content, type?, replyToId?, clientMessageId?,
 305  *         attachmentIds?, attemptGeneration?, expectedSenderId? }
 306  * `content` may be empty (or omitted) only when `attachmentIds` lists 1–5 of
 307  * the caller's pending uploads for this conversation (Phase 4 T12); the type
 308  * of such a message is derived from its attachments (image or file; a voice
 309  * note — Phase 4 T15 — is the only attachment of a file message).
 310  * 201 created; 200 replay of `clientMessageId` (nothing inserted or linked);
 311  * 409 CLIENT_MESSAGE_ID_REUSED when the replay's composition differs.
 312  *
 313  * Phase 5 T2 (FR-006, FR-011, BR-005): `attemptGeneration` (positive integer,
 314  * requires `clientMessageId` and `expectedSenderId`) makes this dispatch an
 315  * attempt of its key: it first fences every older generation, and commits only
 316  * if no newer generation was fenced or dispatched before its commit; otherwise
 317  * 409 ATTEMPT_SUPERSEDED and nothing is stored. A keyed create without a
 318  * generation (Phase 4 client) commits only while the key has no fence state.
 319  * `expectedSenderId` (users.id) different from the authenticated user → 403
 320  * SENDER_MISMATCH, nothing stored or fenced. A generation-carrying create
 321  * whose key's committed message was deleted since → 410 MESSAGE_DELETED
 322  * (nothing stored; the item counts as delivered). A missing conversation answers
 323  * 403 NOT_PARTICIPANT. Keyed responses carry `clientMessageId` (and
 324  * `attemptGeneration` when sent).
 325  *
 326  * Phase 5 T3 (FR-008): budgets, each a transient 429 `rate_limited` when
 327  * exhausted or when it cannot be checked (fail-closed). The request is
 328  * authenticated first (401, nobody charged); then every authenticated request
 329  * — malformed or invalid bodies, replays and quota losers included — consumes
 330  * the request budget before anything else; a generation-carrying create's
 331  * fence step consumes the fence budget; only a winning insertion consumes the
 332  * insertion quota (charged by the database in the insertion's transaction,
 333  * for keyed, unkeyed and attachment creates alike). A grant or other
 334  * infrastructure failure answers 500; only the database's explicit membership
 335  * refusal answers 403 NOT_PARTICIPANT.
 336  */
 337 export async function POST(request: NextRequest) {
 338   try {
 339     const auth = await requireAuthUser();
 340     if ('errorResponse' in auth) {
 341       return auth.errorResponse;
 342     }
 343     const serviceClient = await createSupabaseServerClient('service_role');
 344     const overRequestBudget = await enforceRateLimit(serviceClient, auth.dbUser.id, 'message:create-request');
 345     if (overRequestBudget) {
 346       return overRequestBudget;
 347     }
 348 
 349     let body: Record<string, unknown>;
 350     try {
 351       body = await request.json();
 352     } catch {
 353       return jsonError(400, 'BAD_REQUEST', 'Invalid JSON payload');
 354     }
 355     if (typeof body !== 'object' || body === null || Array.isArray(body)) {
 356       return jsonError(400, 'BAD_REQUEST', 'Invalid JSON payload');
 357     }
 358 
 359     const attachmentIds = parseAttachmentIds(body.attachmentIds);
 360     if (!attachmentIds.ok) {
 361       return jsonError(400, attachmentIds.code, attachmentIds.message);
 362     }
 363     const hasAttachments = attachmentIds.value !== undefined;
 364 
 365     const conversationId = typeof body.conversationId === 'string' ? body.conversationId : null;
 366     const rawContent = body.content === undefined && hasAttachments ? '' : body.content;
 367     if (!conversationId || typeof rawContent !== 'string') {
 368       return jsonError(400, 'BAD_REQUEST', 'Missing required fields: conversationId, content');
 369     }
 370     if (!isUuid(conversationId)) {
 371       return jsonError(400, 'BAD_REQUEST', 'conversationId must be a UUID');
 372     }
 373 
 374     const trimmedContent = rawContent.trim();
 375     if (trimmedContent.length === 0 && !hasAttachments) {
 376       return jsonError(400, 'BAD_REQUEST', 'Content must not be empty');
 377     }
 378     if (trimmedContent.length > MAX_CONTENT_LENGTH) {
 379       return jsonError(413, 'CONTENT_TOO_LARGE', `Content exceeds the ${MAX_CONTENT_LENGTH} character limit`);
 380     }
 381 
 382     const clientMessageId = parseClientMessageId(body.clientMessageId);
 383     if (!clientMessageId.ok) {
 384       return jsonError(400, 'INVALID_CLIENT_MESSAGE_ID', 'clientMessageId must be a UUID');
 385     }
 386     const attemptGeneration = parseAttemptGeneration(body.attemptGeneration, clientMessageId.value !== undefined);
 387     if (!attemptGeneration.ok) {
 388       return attemptGeneration.response;
 389     }
 390     const expectedSenderId = parseExpectedSenderId(body.expectedSenderId, attemptGeneration.value !== undefined);
 391     if (!expectedSenderId.ok) {
 392       return expectedSenderId.response;
 393     }
 394 
 395     const ctx = await authorizeConversationParticipant(auth, serviceClient, conversationId, {
 396       expectedSenderId: expectedSenderId.value,
 397       missingConversationAsNotParticipant: true,
 398     });
 399     if (isAuthzFailure(ctx)) {
 400       return ctx.errorResponse;
 401     }
 402     const { dbUser, conversation } = ctx;
 403 
 404     const messageRepository: IMessageRepository = new SupabaseMessageRepository(serviceClient);
 405     const conversationRepository: IConversationRepository = new SupabaseConversationRepository(serviceClient);
 406 
 407     // Audit S-04: replyToId must reference a message in the SAME conversation.
 408     // Keyed creates are validated by the database AFTER the replay check
 409     // (create_message_attempt): an unchanged replay of a stored message is not
 410     // re-validated (FR-024), so a reply target deleted since cannot turn it
 411     // into a refusal; a new insertion still gets 400 INVALID_REPLY_TARGET.
 412     let replyToId: string | undefined;
 413     if (body.replyToId !== undefined && body.replyToId !== null) {
 414       if (typeof body.replyToId !== 'string') {
 415         return jsonError(400, 'BAD_REQUEST', 'replyToId must be a string');
 416       }
 417       if (!isUuid(body.replyToId)) {
 418         return invalidReplyTarget();
 419       }
 420     }
 421     if (typeof body.replyToId === 'string' && clientMessageId.value) {
 422       replyToId = body.replyToId.toLowerCase();
 423     } else if (typeof body.replyToId === 'string') {
 424       const { data: replyTarget, error: replyError } = await serviceClient
 425         .from('messages')
 426         .select('id, conversation_id')
 427         .eq('id', body.replyToId)
 428         .maybeSingle();
 429       if (replyError) {
 430         console.error('Failed to validate replyToId:', replyError.message);
 431         return jsonError(500, 'INTERNAL_ERROR', 'Failed to create message');
 432       }
 433       if (!replyTarget || replyTarget.conversation_id !== conversation.id) {
 434         return invalidReplyTarget();
 435       }
 436       replyToId = replyTarget.id;
 437     }
 438 
 439     const baseMessageData: Omit<MessageCreateData, 'type'> = {
 440       conversationId: conversation.id,
 441       senderId: dbUser.id,
 442       content: trimmedContent,
 443       // Audit S-04: never trust client-supplied status (pre-marked read/delivered).
 444       status: MessageStatus.SENT,
 445       replyToId,
 446     };
 447 
 448     const safeType: MessageType = Object.values(MessageType).includes(body.type as MessageType)
 449       ? (body.type as MessageType)
 450       : MessageType.TEXT;
 451 
 452     let keyed: KeyedCreate | undefined;
 453     if (clientMessageId.value) {
 454       keyed = {
 455         clientMessageId: clientMessageId.value,
 456         attempt: {
 457           generation: attemptGeneration.value,
 458           composition: buildComposition({
 459             content: trimmedContent,
 460             type: attachmentIds.value ? null : safeType,
 461             replyToId,
 462             attachmentIds: attachmentIds.value ?? [],
 463           }),
 464         },
 465       };
 466     }
 467 
 468     if (keyed?.attempt.generation !== undefined) {
 469       // FR-006: an attempt that reached the server fences every older
 470       // generation before its INSERT, so a stale fence or request arriving
 471       // later is refused; the create below re-checks at commit time.
 472       // Phase 5 T3: this fence step consumes the fence budget.
 473       const overFenceBudget = await enforceRateLimit(serviceClient, dbUser.id, 'message:fence');
 474       if (overFenceBudget) {
 475         return overFenceBudget;
 476       }
 477       let fence;
 478       try {
 479         fence = await messageRepository.fenceClientMessage(
 480           { senderId: dbUser.id, conversationId: conversation.id, clientMessageId: keyed.clientMessageId },
 481           keyed.attempt.generation
 482         );
 483       } catch (error) {
 484         const refusal = createRefusal(error);
 485         if (refusal) {
 486           return refusal;
 487         }
 488         throw error;
 489       }
 490       if (fence.outcome === 'superseded') {
 491         return attemptSupersededResponse();
 492       }
 493       if (fence.outcome === 'stored' && fence.messageId === null) {
 494         // Delivered under this key and deleted since: never recreate it.
 495         return messageDeletedResponse();
 496       }
 497     }
 498 
 499     if (attachmentIds.value) {
 500       return await createWithAttachments(
 501         serviceClient,
 502         messageRepository,
 503         conversationRepository,
 504         new SupabaseMessageAttachmentUploadRepository(serviceClient),
 505         baseMessageData,
 506         attachmentIds.value,
 507         keyed
 508       );
 509     }
 510 
 511     const messageData: MessageCreateData = { ...baseMessageData, type: safeType };
 512 
 513     if (!keyed) {
 514       // Unkeyed text create (published client): created by the transactional
 515       // create function, which charges the insertion quota only when the
 516       // insertion commits (Phase 5 T3). Same legacy response.
 517       let createdMessage: Message;
 518       try {
 519         createdMessage = await messageRepository.createUnkeyed(messageData, MESSAGE_INSERTION_QUOTA);
 520       } catch (error) {
 521         const refusal = createRefusal(error);
 522         if (refusal) {
 523           return refusal;
 524         }
 525         throw error;
 526       }
 527       await touchConversation(conversationRepository, conversation.id);
 528       return NextResponse.json({ message: createdMessage }, { status: 201 });
 529     }
 530 
 531     let outcome;
 532     try {
 533       outcome = await messageRepository.createWithClientKey(
 534         messageData,
 535         keyed.clientMessageId,
 536         keyed.attempt,
 537         MESSAGE_INSERTION_QUOTA
 538       );
 539     } catch (error) {
 540       const refusal = createRefusal(error);
 541       if (refusal) {
 542         return refusal;
 543       }
 544       throw error;
 545     }
 546     if (!outcome.created) {
 547       // A retry of a composition whose create already committed (e.g. its
 548       // response was lost): answer with the stored message, insert nothing.
 549       // The key is per composition, so a different payload — including a
 550       // stored message that carries attachments — is a client bug.
 551       const stored = (await messageRepository.findById(outcome.message.id)) ?? outcome.message;
 552       const linkedIds = await new 
SupabaseMessageAttachmentUploadRepository(serviceClient).listLinkedAttachmentIds(stored.id);
 553       if (!isSameComposition(outcome.storedComposition, stored, linkedIds, keyed.attempt.composition)) {
 554         return clientKeyReused();
 555       }
 556       return messageResponse(stored, 200, keyed);
 557     }
 558 
 559     await touchConversation(conversationRepository, conversation.id);
 560 
 561     return messageResponse(outcome.message, 201, keyed);
 562   } catch (error) {
 563     console.error('Error creating message:', error);
 564     return jsonError(500, 'INTERNAL_ERROR', 'Failed to create message');
 565   }
 566 }

