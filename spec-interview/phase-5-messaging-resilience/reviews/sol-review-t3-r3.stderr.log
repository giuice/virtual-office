 309   /** Waits for the start of a window (later than window `after` when given); returns its index. */
 310   async function waitForWindowStart(seconds: number, maxOffset: number, after = -1): Promise<number> {
 311     for (;;) {
 312       const { index, offset } = await windowPosition(seconds);
 313       if (index > after && offset >= 0.1 && offset <= maxOffset) return index;
 314       await new Promise((resolve) => setTimeout(resolve, Math.max(50, Math.ceil((seconds - offset + 0.15) * 
1000))));
 315     }
 316   }
