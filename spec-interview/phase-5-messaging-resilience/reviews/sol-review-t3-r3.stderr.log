 636       .from(this.MSG_TABLE_NAME)
 637       .update(dbUpdates)
 638       .eq('id', id)
 639       .select()
 640       .single();
 641 
 642     if (error) {
 643       console.error('Error updating message:', error);
 644       if (error.code === 'PGRST116') return null;
 645       throw error;
 646     }
 647     // Audit M-08: enrich the returned message — returning emptied
 648     // attachments/reactions corrupts any cache the caller writes it into.
 649     const updatedMessage = data ? mapMessageToCamelCase(data) : null;
 650     if (updatedMessage) {
 651       await this.enrichMessages([updatedMessage]);
 652     }
 653     return updatedMessage;
 654   }
