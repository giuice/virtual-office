null> {
 623     // Map updates from camelCase to snake_case
 624     const dbUpdates: Partial<{ content: string; status: MessageStatus; is_edited: boolean }> = {};
 625     if (updates.content !== undefined) dbUpdates.content = updates.content;
 626     if (updates.status !== undefined) dbUpdates.status = updates.status;
 627     if (updates.isEdited !== undefined) dbUpdates.is_edited = updates.isEdited;
 628 
 629     if (Object.keys(dbUpdates).length === 0) {
