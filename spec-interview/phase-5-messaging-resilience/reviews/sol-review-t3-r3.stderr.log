 248   /**
 249    * Holds FOR UPDATE on a message row from a separate connection: an insert
 250    * replying to it blocks in its reply_to_id foreign-key check (FOR KEY SHARE)
 251    * until the holder rolls back, or deletes the row and commits.
 252    */
 253   async function lockMessageRow(messageId: string) {
 254     const holder = new Client({ connectionString: MESSAGING_DB_URL });
 255     await holder.connect();
 256     await holder.query('begin');
 257     await holder.query('select id from public.messages where id = $1 for update', [messageId]);
 258     const pid = (await holder.query<{ pid: number }>('select pg_backend_pid() as pid')).rows[0].pid;
 259     let released = false;
 260     const finish = async (sql: string[]) => {
 261       if (released) return;
 262       released = true;
 263       for (const statement of sql) await holder.query(statement).catch(() => undefined);
 264       await holder.end();
 265     };
 266     return {
 267       pid,
 268       release: () => finish(['rollback']),
 269       deleteAndCommit: () => finish([`delete from public.messages where id = '${messageId}'`, 'commit']),
 270     };
 271   }
