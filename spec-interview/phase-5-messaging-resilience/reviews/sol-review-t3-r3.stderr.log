 248   /**
 249    * Holds FOR UPDATE on a message row from a separate connection: an insert
 250    * replying to it blocks in its reply_to_id foreign-key check (FOR KEY SHARE)
 251    * until the holder rolls back, or deletes the row and commits.
 252    */
 253   async function lockMessageRow(messageId: string) {
 254     const holder = new Client({ connectionString: MESSAGING_DB_URL });
 255     await holder.connect();
 256     await holder.query('begin');
 257     await holder.query('select id from public.messages where id = $1 for update', [messageId]);
 258     const pid = (await holder.query<{ pid: number }>('select pg_backend_pid() as pid')).rows[0].pid;
 259     let released = false;
 260     const finish = async (sql: string[]) => {
 261       if (released) return;
 262       released = true;
 263       for (const statement of sql) await holder.query(statement).catch(() => undefined);
 264       await holder.end();
 265     };
 266     return {
 267       pid,
 268       release: () => finish(['rollback']),
 269       deleteAndCommit: () => finish([`delete from public.messages where id = '${messageId}'`, 'commit']),
 270     };
 271   }
 272 
 273   /**
 274    * Waits until a backend is blocked by the holder (the holder's pid is in its
 275    * pg_blocking_pids). With `waiterPid` (captured before dispatch) only that
 276    * backend counts; otherwise exactly one backend must be blocked by the
 277    * holder (the holder's lock is private to the test). Returns the waiter pid.
 278    */
 279   async function waitForBlockedBy(holderPid: number, waiterPid?: number): Promise<number> {
 280     let waiter = 0;
 281     await expect
 282       .poll(
 283         async () => {
 284           const rows = await world.query<{ pid: number }>(
 285             `select pid from pg_catalog.pg_stat_activity
 286              where $1::int = any (pg_catalog.pg_blocking_pids(pid))
 287                and ($2::int is null or pid = $2::int)`,
 288             [holderPid, waiterPid ?? null],
 289           );
 290           waiter = rows.length === 1 ? rows[0].pid : 0;
 291           return rows.length;
 292         },
 293         { timeout: 10_000, interval: 50 },
 294       )
 295       .toBe(1);
 296     return waiter;
 297   }
 298 
 299   /** Database clock position in fixed windows of `seconds`. */
 300   async function windowPosition(seconds: number): Promise<{ index: number; offset: number }> {
 301     const [row] = await world.query<{ index: string; offset: string }>(
 302       `select floor(extract(epoch from clock_timestamp()) / $1)::text as index,
 303               (extract(epoch from clock_timestamp())::numeric % $1::numeric)::text as offset`,
 304       [seconds],
 305     );
 306     return { index: Number(row.index), offset: Number(row.offset) };
 307   }
 308 
 309   /** Waits for the start of a window (later than window `after` when given); returns its index. */
 310   async function waitForWindowStart(seconds: number, maxOffset: number, after = -1): Promise<number> {
 311     for (;;) {
 312       const { index, offset } = await windowPosition(seconds);
 313       if (index > after && offset >= 0.1 && offset <= maxOffset) return index;
 314       await new Promise((resolve) => setTimeout(resolve, Math.max(50, Math.ceil((seconds - offset + 0.15) * 
1000))));
 315     }
 316   }
