  67  * 20261007114454). Any other 42501 — a revoked EXECUTE or table grant — is an
  68  * infrastructure failure, never a membership answer.
  69  */
  70 function isMembershipRefusal(error: PostgrestError): boolean {
  71   return error.code === '42501' && error.message === 'NOT_PARTICIPANT';
