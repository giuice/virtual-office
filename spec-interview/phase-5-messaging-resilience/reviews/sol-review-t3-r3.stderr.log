 318   async function withGrantFailure<T>(failure: keyof typeof GRANT_FAILURES, fn: () => Promise<T>): Promise<T> {
 319     const [revoke, restore] = GRANT_FAILURES[failure];
 320     await world.query(revoke);
 321     try {
 322       return await fn();
 323     } finally {
 324       await world.query(restore);
 325     }
 326   }
