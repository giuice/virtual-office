 545 -- ============================================================================
 546 -- No client write path around the budgets: clients cannot insert messages.
 547 -- ============================================================================
 548 drop policy if exists "send_message_as_self" on public.messages;
 549 revoke insert on table public.messages from anon, authenticated;
 550 
 551 -- ============================================================================
 552 -- Insertion-quota charge, serialized per user across windows (see header).
 553 -- ============================================================================
 554 create or replace function private.charge_message_insertion_quota(
 555   p_user_id uuid,
 556   p_limit integer,
 557   p_window_seconds integer
 558 )
 559 returns boolean
 560 language plpgsql
 561 security definer
 562 set search_path = ''
 563 as $$
 564 declare
 565   v_window_start timestamptz;
 566   v_count integer;
 567 begin
 568   if p_user_id is null or p_limit is null or p_window_seconds is null or p_limit < 1 or p_window_seconds < 1 then
 569     raise exception 'INSERT_QUOTA_INVALID' using errcode = '22023';
 570   end if;
 571 
 572   -- Held until commit: this user's insertion-quota charges run one at a time.
 573   perform pg_catalog.pg_advisory_xact_lock(
 574     pg_catalog.hashtextextended('virtual_office.message_insertion_quota:' || p_user_id::text, 0)
 575   );
 576 
 577   -- The window is read after the lock from the wall clock (not the
 578   -- transaction start), so serialized charges see non-decreasing windows.
 579   v_window_start := pg_catalog.to_timestamp(
 580     (pg_catalog.floor(extract(epoch from pg_catalog.clock_timestamp()) / p_window_seconds) * 
p_window_seconds)::double precision
 581   );
 582 
 583   insert into private.rate_limit_counters as c (user_id, action, window_start, count)
 584   values (p_user_id, 'message:create', v_window_start, 1)
 585   on conflict (user_id, action, window_start)
 586   do update set count = c.count + 1
 587   returning count into v_count;
 588 
 589   -- Older windows can no longer be charged by this user's insertions (every
 590   -- later charge is serialized behind this one and reads a later clock).
 591   delete from private.rate_limit_counters c
 592   where c.user_id = p_user_id
 593     and c.action = 'message:create'
 594     and c.window_start < v_window_start;
 595 
 596   return v_count <= p_limit;
 597 end
 598 $$;
 599 
 600 comment on function private.charge_message_insertion_quota(uuid, integer, integer) is
 601   'Phase 5 T3: charges one message insertion to the user''s ''message:create'' counter (p_limit per 
p_window_seconds) in the CALLER''S transaction; serialized per user until commit (advisory lock) with the window read 
from clock_timestamp() after the lock. Returns false when the quota is exhausted (the caller must roll back). Called 
by public.create_message_attempt; service_role only.';
 602 
 603 revoke all on function private.charge_message_insertion_quota(uuid, integer, integer)
 604   from public, anon, authenticated;
 605 grant execute on function private.charge_message_insertion_quota(uuid, integer, integer)
 606   to service_role;
 607 
 608 -- ============================================================================
 609 -- The retained limiter (Phase 4 servers' route-level 'message:create' charge)
 610 -- joins the same serialization; every other action is unchanged.
 611 -- ============================================================================
 612 create or replace function public.check_rate_limit(
 613   p_user_id uuid,
 614   p_action text,
 615   p_limit integer,
 616   p_window_seconds integer
 617 ) returns boolean
 618 language plpgsql
 619 security definer
 620 set search_path = ''
 621 as $$
 622 declare
 623   v_window_start timestamptz;
 624   v_count integer;
 625 begin
 626   -- Phase 5 T3: insertion-quota charges are serialized per user with the
 627   -- window read after the lock (private.charge_message_insertion_quota), so a
 628   -- delayed charge can never recreate an older, already cleaned-up window.
 629   if p_action = 'message:create' then
 630     return private.charge_message_insertion_quota(p_user_id, p_limit, p_window_seconds);
 631   end if;
 632 
 633   v_window_start := to_timestamp(
 634     floor(extract(epoch from now()) / p_window_seconds) * p_window_seconds
 635   );
 636 
 637   insert into private.rate_limit_counters as c (user_id, action, window_start, count)
 638   values (p_user_id, p_action, v_window_start, 1)
 639   on conflict (user_id, action, window_start)
 640   do update set count = c.count + 1
 641   returning count into v_count;
 642 
 643   -- Opportunistic cleanup of this user's expired windows (PK-indexed, cheap).
 644   delete from private.rate_limit_counters
 645   where user_id = p_user_id
 646     and action = p_action
 647     and window_start < v_window_start;
 648 
 649   return v_count <= p_limit;
 650 end;
 651 $$;
 652 
 653 revoke all on function public.check_rate_limit(uuid, text, integer, integer) from public;
 654 revoke all on function public.check_rate_limit(uuid, text, integer, integer) from anon, authenticated;
 655 grant execute on function public.check_rate_limit(uuid, text, integer, integer) to service_role;
 656 
 657 -- ============================================================================
 658 -- Fence / lookup: T2 body, with the explicit membership refusal marker.
 659 -- ============================================================================
 660 create or replace function public.fence_message_attempt(
 661   p_sender_id uuid,
 662   p_conversation_id uuid,
 663   p_client_message_id uuid,
 664   p_attempt_generation bigint
 665 )
 666 returns jsonb
 667 language plpgsql
 668 security invoker
 669 set search_path = ''
 670 as $$
 671 declare
 672   v_generation bigint;
 673   v_committed_at timestamptz;
 674   v_message_id uuid;
 675 begin
 676   if p_sender_id is null or p_conversation_id is null or p_client_message_id is null or p_attempt_generation is 
null then
 677     raise exception 'fence_message_attempt: sender, conversation, key and generation are required'
 678       using errcode = '22004';
 679   end if;
 680   if p_attempt_generation < 1 then
 681     raise exception 'ATTEMPT_GENERATION_INVALID' using errcode = '22023';
 682   end if;
 683 
 684   -- Defense in depth: the route already required membership.
 685   if not exists (
 686     select 1
 687     from public.conversation_members cm
 688     where cm.conversation_id = p_conversation_id
 689       and cm.user_id = p_sender_id
 690   ) then
 691     -- Explicit marker (Phase 5 T3): callers map only this to NOT_PARTICIPANT.
 692     raise exception 'NOT_PARTICIPANT' using errcode = '42501';
 693   end if;
 694 
 695   insert into private.message_send_attempts (sender_id, conversation_id, client_message_id)
 696   values (p_sender_id, p_conversation_id, p_client_message_id)
 697   on conflict (sender_id, conversation_id, client_message_id) do nothing;
 698 
 699   select a.fence_generation, a.committed_at into v_generation, v_committed_at
 700   from private.message_send_attempts a
 701   where a.sender_id = p_sender_id
 702     and a.conversation_id = p_conversation_id
 703     and a.client_message_id = p_client_message_id
 704   for update;
 705 
 706   if v_generation is not null and p_attempt_generation < v_generation then
 707     return pg_catalog.jsonb_build_object('outcome', 'superseded', 'current_generation', v_generation);
 708   end if;
 709 
 710   if v_generation is null or p_attempt_generation > v_generation then
 711     update private.message_send_attempts a
 712     set fence_generation = p_attempt_generation,
 713         updated_at = pg_catalog.now()
 714     where a.sender_id = p_sender_id
 715       and a.conversation_id = p_conversation_id
 716       and a.client_message_id = p_client_message_id;
 717   end if;
 718 
 719   -- A new statement (new snapshot) after the row lock: a create that held the
 720   -- lock has committed by now and its message is visible.
 721   select m.id into v_message_id
 722   from public.messages m
 723   where m.sender_id = p_sender_id
 724     and m.conversation_id = p_conversation_id
 725     and m.client_message_id = p_client_message_id;
 726 
 727   if v_message_id is not null then
 728     -- Delivery record, still under the key lock: a message the row does not
 729     -- track yet (written before this migration) is recorded now, so its later
 730     -- deletion is never reported as not stored.
 731     update private.message_send_attempts a
 732     set message_id = v_message_id,
 733         committed_at = coalesce(a.committed_at, pg_catalog.now()),
 734         composition = case when a.message_id = v_message_id then a.composition end,
 735         updated_at = pg_catalog.now()
 736     where a.sender_id = p_sender_id
 737       and a.conversation_id = p_conversation_id
 738       and a.client_message_id = p_client_message_id
 739       and (a.message_id is distinct from v_message_id or a.committed_at is null);
 740   end if;
 741 
 742   if v_message_id is not null or v_committed_at is not null then
 743     -- message_id is null when the committed message was deleted since.
 744     return pg_catalog.jsonb_build_object('outcome', 'stored', 'message_id', v_message_id);
 745   end if;
 746   return pg_catalog.jsonb_build_object('outcome', 'not_stored');
 747 end
 748 $$;
 749 
 750 comment on function public.fence_message_attempt(uuid, uuid, uuid, bigint) is
 751   'Phase 5 T2/T3: fence/lookup of the sender''s own client key. Returns {outcome: superseded|stored|not_stored, 
message_id (null when the stored message was deleted)}; never creates a message; makes every lower generation of the 
key unable to commit. Raises NOT_PARTICIPANT (42501) when the sender is not a member. Service role only; callers 
authorize the sender first.';
 752 
 753 revoke all on function public.fence_message_attempt(uuid, uuid, uuid, bigint)
 754   from public, anon, authenticated;
 755 grant execute on function public.fence_message_attempt(uuid, uuid, uuid, bigint)
 756   to service_role;
 757 
 758 
 759 -- ============================================================================
 760 -- Fenced create (keyed text, unkeyed text, attachments) with the insertion
 761 -- quota charged by the winning insertion.
 762 -- ============================================================================
 763 drop function if exists public.create_message_attempt(uuid, uuid, text, text, uuid, uuid, bigint, jsonb, uuid[]);
 764 
 765 create or replace function public.create_message_attempt(
 766   p_conversation_id uuid,
 767   p_sender_id uuid,
 768   p_content text,
 769   p_type text,
 770   p_reply_to_id uuid,
 771   p_client_message_id uuid,
 772   p_attempt_generation bigint,
 773   p_composition jsonb,
 774   p_upload_ids uuid[],
 775   p_insert_quota_limit integer,
 776   p_insert_quota_window_seconds integer
 777 )
 778 returns jsonb
 779 language plpgsql
 780 security invoker
 781 set search_path = ''
 782 as $$
 783 declare
 784   v_count integer;
 785   v_locked integer;
 786   v_voice integer;
 787   v_message_id uuid;
 788   v_new_id uuid := pg_catalog.gen_random_uuid();
 789   v_generation bigint;
 790   v_committed_at timestamptz;
 791   v_quota_allowed boolean;
 792   v_row public.messages%rowtype;
 793 begin
 794   if p_conversation_id is null or p_sender_id is null or p_content is null or p_type is null then
 795     raise exception 'create_message_attempt: conversation, sender, content and type are required'
 796       using errcode = '22004';
 797   end if;
 798   if p_attempt_generation is not null and (p_client_message_id is null or p_attempt_generation < 1) then
 799     raise exception 'ATTEMPT_GENERATION_INVALID' using errcode = '22023';
 800   end if;
 801   if p_composition is not null and (p_client_message_id is null or pg_catalog.jsonb_typeof(p_composition) <> 
'object') then
 802     raise exception 'create_message_attempt: a composition needs a client key and must be an object'
 803       using errcode = '22023';
 804   end if;
 805   -- Phase 5 T3: both NULL (no charge: callers that charged elsewhere) or both
 806   -- positive.
 807   if (p_insert_quota_limit is null) <> (p_insert_quota_window_seconds is null)
 808      or p_insert_quota_limit < 1
 809      or p_insert_quota_window_seconds < 1 then
 810     raise exception 'INSERT_QUOTA_INVALID' using errcode = '22023';
 811   end if;
 812 
 813   v_count := coalesce(pg_catalog.cardinality(p_upload_ids), 0);
 814   -- Same bound as the route's attachment policy (5 per message).
 815   if v_count > 5 then
 816     raise exception 'ATTACHMENT_COUNT_INVALID' using errcode = '22023';
 817   end if;
 818   if v_count > 0 then
 819     if (select pg_catalog.count(distinct u) from pg_catalog.unnest(p_upload_ids) as u) <> v_count then
 820       raise exception 'ATTACHMENT_DUPLICATE' using errcode = '22023';
 821     end if;
 822     -- Attachment messages are typed image or file (the only types allowed to
 823     -- carry empty content).
 824     if p_type not in ('image', 'file') then
 825       raise exception 'create_message_attempt: type must be image or file'
 826         using errcode = '22023';
 827     end if;
 828   end if;
 829 
 830   -- Defense in depth: the route already required membership.
 831   if not exists (
 832     select 1
 833     from public.conversation_members cm
 834     where cm.conversation_id = p_conversation_id
 835       and cm.user_id = p_sender_id
 836   ) then
 837     -- Explicit marker (Phase 5 T3): callers map only this to NOT_PARTICIPANT.
 838     raise exception 'NOT_PARTICIPANT' using errcode = '42501';
 839   end if;
 840 
 841   -- Replay of a key whose create already committed: answer with the stored
 842   -- message and link nothing (its uploads were consumed by the first create).
 843   -- Checked before the reply target: an unchanged replay is compared against
 844   -- the original composition, not re-validated (FR-024), so a reply target
 845   -- deleted since does not turn it into a refusal. Not an insertion: the
 846   -- insertion quota is not charged (Phase 5 T3, D1).
 847   if p_client_message_id is not null then
 848     select m.id into v_message_id
 849     from public.messages m
 850     where m.sender_id = p_sender_id
 851       and m.conversation_id = p_conversation_id
 852       and m.client_message_id = p_client_message_id;
 853     if v_message_id is not null then
 854       return private.message_attempt_replay(
 855         p_sender_id, p_conversation_id, p_client_message_id, p_attempt_generation, v_message_id);
 856     end if;
 857   end if;
 858 
 859   -- A reply target must be a message of the same conversation.
 860   if p_reply_to_id is not null and not exists (
 861     select 1
 862     from public.messages r
 863     where r.id = p_reply_to_id
 864       and r.conversation_id = p_conversation_id
 865   ) then
 866     raise exception 'INVALID_REPLY_TARGET' using errcode = '22023';
 867   end if;
 868 
 869   if v_count > 0 then
 870     -- Lock the caller's pending uploads for this conversation (id order avoids
 871     -- deadlocks between overlapping sets). A concurrent cancel or link of the
 872     -- same upload waits here; once it commits the row is gone.
 873     select pg_catalog.count(*), pg_catalog.count(*) filter (where locked.duration is not null)
 874     into v_locked, v_voice
 875     from (
 876       select u.id, u.duration
 877       from public.message_attachment_uploads u
 878       where u.id = any (p_upload_ids)
 879         and u.uploader_id = p_sender_id
 880         and u.conversation_id = p_conversation_id
 881       order by u.id
 882       for update
 883     ) as locked;
 884 
 885     if v_locked <> v_count then
 886       -- A concurrent create with the same key may have consumed them.
 887       if p_client_message_id is not null then
 888         select m.id into v_message_id
 889         from public.messages m
 890         where m.sender_id = p_sender_id
 891           and m.conversation_id = p_conversation_id
 892           and m.client_message_id = p_client_message_id;
 893         if v_message_id is not null then
 894           return private.message_attempt_replay(
 895             p_sender_id, p_conversation_id, p_client_message_id, p_attempt_generation, v_message_id);
 896         end if;
 897       end if;
 898       -- Unknown, foreign, other-conversation, cancelled, or already linked.
 899       raise exception 'ATTACHMENT_UPLOAD_NOT_FOUND' using errcode = '22023';
 900     end if;
 901 
 902     -- Phase 4 T15: a voice note is the only attachment of its message, which
 903     -- is typed file.
 904     if v_voice > 0 and v_count > 1 then
 905       raise exception 'VOICE_NOTE_NOT_ALONE' using errcode = '22023';
 906     end if;
 907     if v_voice > 0 and p_type <> 'file' then
 908       raise exception 'create_message_attempt: a voice note message must be typed file'
 909         using errcode = '22023';
 910     end if;
 911   end if;
 912 
 913   -- This INSERT is checked below (commit-time fence check); the
 914   -- messages_keyed_insert_fence trigger recognizes it by its pre-generated id
 915   -- and leaves it to this function. Any other keyed insert is checked by the
 916   -- trigger itself.
 917   perform pg_catalog.set_config('virtual_office.create_message_attempt_id', v_new_id::text, true);
 918   insert into public.messages (id, conversation_id, sender_id, content, type, status, reply_to_id, 
client_message_id)
 919   values (
 920     v_new_id,
 921     p_conversation_id,
 922     p_sender_id,
 923     p_content,
 924     p_type::public.message_type,
 925     'sent'::public.message_status,
 926     p_reply_to_id,
 927     p_client_message_id
 928   )
 929   on conflict (sender_id, conversation_id, client_message_id) where client_message_id is not null
 930   do nothing
 931   returning * into v_row;
 932   perform pg_catalog.set_config('virtual_office.create_message_attempt_id', '', true);
 933   -- Phase 5 T3: the inserted row (all fields null after a lost same-key race)
 934   -- is returned to the caller from this transaction.
 935   v_message_id := v_row.id;
 936 
 937   if v_message_id is null then
 938     -- Lost the race on the same key: the winner's message is committed. Not
 939     -- an insertion: the insertion quota is not charged.
 940     select m.id into v_message_id
 941     from public.messages m
 942     where m.sender_id = p_sender_id
 943       and m.conversation_id = p_conversation_id
 944       and m.client_message_id = p_client_message_id;
 945     return private.message_attempt_replay(
 946       p_sender_id, p_conversation_id, p_client_message_id, p_attempt_generation, v_message_id);
 947   end if;
 948 
 949   if v_count > 0 then
 950     insert into public.message_attachments (id, message_id, name, type, size, url, duration, waveform_data)
