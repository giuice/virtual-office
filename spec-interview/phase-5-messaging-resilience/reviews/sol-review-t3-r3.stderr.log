 300   async function windowPosition(seconds: number): Promise<{ index: number; offset: number }> {
 301     const [row] = await world.query<{ index: string; offset: string }>(
 302       `select floor(extract(epoch from clock_timestamp()) / $1)::text as index,
 303               (extract(epoch from clock_timestamp())::numeric % $1::numeric)::text as offset`,
 304       [seconds],
 305     );
 306     return { index: Number(row.index), offset: Number(row.offset) };
 307   }
