  57 const LINK_FAILURE_CODES: readonly AttachmentLinkFailureCode[] = [
  58   'ATTACHMENT_UPLOAD_NOT_FOUND',
  59   'ATTACHMENT_COUNT_INVALID',
  60   'ATTACHMENT_DUPLICATE',
