 549   // Phase 5 T3: unkeyed create in public.create_message_attempt (null key and
 550   // generation) so the insertion quota is charged in the insertion's own
 551   // transaction — a failed INSERT is never charged (migration 20261007114454).
 552   // The answer is the row the function built in that transaction: no
 553   // post-commit read can fail after the message is stored (a keyless retry
 554   // would duplicate it).
 555   async createUnkeyed(messageData: MessageCreateData, insertQuota: InsertionQuota): Promise<Message> {
 556     const result = await createMessageAttempt(this.supabaseClient, {
 557       data: messageData,
 558       uploadIds: [],
 559       insertQuota,
 560     });
 561     if (!result.created) {
 562       throw new Error(`create_message_attempt replayed unkeyed message ${result.messageId}`);
 563     }
 564     const row = parseCreatedRow(result.createdRow);
 565     if (row) {
 566       return mapCreatedMessage(row);
 567     }
 568     // Unreachable while the function returns its RETURNING row; the message is
 569     // committed, so read it rather than answer 500 for a stored message.
 570     console.error('create_message_attempt returned a malformed created row:', result.messageId);
 571     return this.readCreatedMessage(result.messageId);
 572   }
 573 
 574   private async readCreatedMessage(messageId: string): Promise<Message> {
 575     const { data, error } = await this.supabaseClient
 576       .from(this.MSG_TABLE_NAME)
 577       .select('*')
 578       .eq('id', messageId)
 579       .single();
 580 
 581     if (error || !data) {
 582       console.error('Error reading message after create:', error);
 583       throw error || new Error(`Message ${messageId} not found after create`);
 584     }
 585     return mapCreatedMessage(data as MessageRow);
 586   }
 587 
 588   // Idempotent create (Phase 4 FR-024): the composition key is unique per
 589   // (sender_id, conversation_id) through the partial unique index
 590   // messages_sender_conversation_client_message_id_key. Phase 5 T2: the insert
 591   // runs in public.create_message_attempt, which returns the stored message on
 592   // a replay or a lost same-key race, and refuses to commit a fenced attempt
 593   // (AttemptSupersededError) — see migration 20261007095045. Phase 5 T3: a
 594   // winning insertion charges insertQuota in the same transaction
 595   // (InsertionRateLimitError, nothing stored) — migration 20261007114454.
 596   async createWithClientKey(
 597     messageData: MessageCreateData,
 598     clientMessageId: string,
 599     attempt: MessageAttempt | undefined,
 600     insertQuota: InsertionQuota | null
 601   ): Promise<MessageCreateResult> {
 602     const result = await createMessageAttempt(this.supabaseClient, {
 603       data: messageData,
 604       clientMessageId,
 605       attempt,
 606       uploadIds: [],
 607       insertQuota,
 608     });
 609 
 610     const createdRow = result.created ? parseCreatedRow(result.createdRow) : null;
 611     return {
 612       message: createdRow ? mapCreatedMessage(createdRow) : await this.readCreatedMessage(result.messageId),
 613       created: result.created,
 614       storedComposition: result.storedComposition,
 615     };
 616   }
 617 
 618   async fenceClientMessage(key: ClientMessageKey, generation: number): Promise<MessageAttemptFenceResult> {
 619     return fenceMessageAttempt(this.supabaseClient, key, generation);
 620   }
