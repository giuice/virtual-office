  78 /**
  79  * Calls public.create_message_attempt. Throws AttemptSupersededError when the
  80  * attempt was fenced (nothing stored), MessageDeletedError when a
  81  * generation-carrying create would recreate a deleted message,
  82  * InsertionRateLimitError when the winning insertion could not be charged to
  83  * the insertion quota (exhausted or uncheckable; rolled back),
  84  * AttachmentLinkError for the
  85  * database's validation refusals (reply target, explicit membership refusal,
  86  * uploads), and MessageAttemptRpcError for anything else (including grant
  87  * failures).
  88  */
  89 export async function createMessageAttempt(
  90   client: SupabaseClient,
  91   input: CreateMessageAttemptInput
  92 ): Promise<CreateMessageAttemptResult> {
  93   const { data, error } = await client.rpc('create_message_attempt', {
  94     p_conversation_id: input.data.conversationId,
  95     p_sender_id: input.data.senderId,
  96     p_content: input.data.content,
  97     p_type: input.data.type,
  98     p_reply_to_id: input.data.replyToId ?? null,
  99     p_client_message_id: input.clientMessageId ?? null,
 100     p_attempt_generation: input.attempt?.generation ?? null,
 101     p_composition: input.clientMessageId && input.attempt ? input.attempt.composition : null,
 102     p_upload_ids: [...input.uploadIds],
 103     p_insert_quota_limit: input.insertQuota?.limit ?? null,
 104     p_insert_quota_window_seconds: input.insertQuota?.windowSeconds ?? null,
 105   });
 106 
 107   if (error) {
 108     if (error.code === 'P0001' && error.message === 'RATE_LIMITED') {
 109       throw new InsertionRateLimitError('exceeded');
 110     }
 111     if (error.code === 'P0001' && error.message === 'RATE_LIMIT_UNAVAILABLE') {
 112       console.error('Insertion quota could not be charged in create_message_attempt:', error);
 113       throw new InsertionRateLimitError('unavailable');
 114     }
 115     if (error.message === 'ATTEMPT_SUPERSEDED') {
 116       throw new AttemptSupersededError();
 117     }
 118     if (error.message === 'MESSAGE_DELETED') {
 119       throw new MessageDeletedError();
 120     }
 121     const linkFailure = LINK_FAILURE_CODES.find((code) => error.message === code);
 122     if (error.code === '22023' && linkFailure) {
 123       throw new AttachmentLinkError(linkFailure);
 124     }
 125     if (isMembershipRefusal(error)) {
 126       throw new AttachmentLinkError('NOT_PARTICIPANT');
 127     }
 128     console.error('Error in create_message_attempt RPC:', error);
 129     throw new MessageAttemptRpcError(error);
 130   }
 131   if (!isRecord(data) || typeof data.message_id !== 'string' || typeof data.created !== 'boolean') {
 132     throw new Error('create_message_attempt returned an unexpected result');
 133   }
 134   return {
 135     messageId: data.message_id,
 136     created: data.created,
 137     storedComposition: data.created ? null : parseStoredComposition(data.composition),
 138     createdRow: data.created && isRecord(data.message) ? data.message : null,
 139   };
 140 }
