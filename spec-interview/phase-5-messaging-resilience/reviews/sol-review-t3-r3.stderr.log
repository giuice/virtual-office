  58   async create(upload: Omit<PendingAttachmentUpload, 'createdAt'>): Promise<PendingAttachmentUpload> {
  59     const { data, error } = await this.supabaseClient
  60       .from(this.TABLE_NAME)
  61       .insert({
  62         id: upload.id,
  63         conversation_id: upload.conversationId,
  64         uploader_id: upload.uploaderId,
  65         storage_path: upload.storagePath,
  66         name: upload.name,
