 290 // conversations is what fires useConversationRealtime's cache invalidation so
 291 // recipients' unread badges refresh. Unread counts are derived from
 292 // conversation_members.last_read_at (Phase 2.2) — nothing to increment here.
 293 async function touchConversation(conversationRepository: IConversationRepository, conversationId: string) {
 294   try {
 295     await conversationRepository.updateLastActivityTimestamp(conversationId);
 296   } catch (updateError) {
 297     console.warn('Failed to update conversation activity:', updateError);
 298     // Don't fail the request if conversation update fails
 299   }
 300 }
