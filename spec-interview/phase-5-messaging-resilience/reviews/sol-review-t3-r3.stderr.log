 142 /**
 143  * Calls public.fence_message_attempt. Throws NotParticipantError for the
 144  * database's explicit membership refusal and MessageAttemptRpcError for
 145  * anything else (including grant failures).
 146  */
 147 export async function fenceMessageAttempt(
 148   client: SupabaseClient,
 149   key: ClientMessageKey,
 150   generation: number
 151 ): Promise<MessageAttemptFenceResult> {
 152   const { data, error } = await client.rpc('fence_message_attempt', {
 153     p_sender_id: key.senderId,
 154     p_conversation_id: key.conversationId,
 155     p_client_message_id: key.clientMessageId,
 156     p_attempt_generation: generation,
 157   });
 158 
 159   if (error) {
 160     if (isMembershipRefusal(error)) {
 161       throw new NotParticipantError();
 162     }
 163     console.error('Error in fence_message_attempt RPC:', error);
 164     throw new MessageAttemptRpcError(error);
 165   }
 166   if (isRecord(data)) {
 167     if (data.outcome === 'superseded' || data.outcome === 'not_stored') {
 168       return { outcome: data.outcome };
 169     }
 170     if (data.outcome === 'stored' && (typeof data.message_id === 'string' || data.message_id === null)) {
 171       return { outcome: 'stored', messageId: data.message_id };
 172     }
 173   }
 174   throw new Error('fence_message_attempt returned an unexpected result');
