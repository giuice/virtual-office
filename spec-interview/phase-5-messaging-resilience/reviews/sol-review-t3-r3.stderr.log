 287                and ($2::int is null or pid = $2::int)`,
 288             [holderPid, waiterPid ?? null],
 289           );
 290           waiter = rows.length === 1 ? rows[0].pid : 0;
 291           return rows.length;
 292         },
 293         { timeout: 10_000, interval: 50 },
 294       )
 295       .toBe(1);
