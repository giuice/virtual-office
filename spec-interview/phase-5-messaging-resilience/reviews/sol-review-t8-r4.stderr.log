409:   /**
410:    * Shows `item` as just read or written by this tab, without reading the
411:    * outbox again (unless it was confirmed meanwhile). An older re-read still
412:    * in flight is superseded, so it cannot put back a previous state.
413:    */
414:   private showItem(item: OutboxItem): void {
415:     if (this.disposed || this.confirmed.has(item.clientMessageId)) return;
416:     const drain = this.drain(item.conversationId);
417:     drain.viewSeq += 1;
418:     drain.keys.add(item.clientMessageId);
419:     publishOutboxItem(this.queryClient, item);
420:   }
421: 
422:   /** Shows the item's stored state after an update; re-reads when it is gone. */
423:   private async showStored(conversationId: string, item: OutboxItem | null): Promise<void> {
424:     if (item) {
425:       this.showItem(item);
426:     } else {
427:       await this.refreshView(conversationId);
428:     }
429:   }
430: 
431:   private scheduleRetry(conversationId: string, delayMs?: number): void {
432:     if (this.disposed) return;
433:     const drain = this.drain(conversationId);
434:     if (drain.retryTimer) return;
435:     const delay = delayMs ?? drain.retryDelayMs;
436:     if (delayMs === undefined) drain.retryDelayMs = Math.min(drain.retryDelayMs * 2, RETRY_MAX_MS);
437:     drain.retryTimer = setTimeout(() => {
438:       drain.retryTimer = null;
439:       this.drainConversation(conversationId);
440:     }, delay);
441:   }
