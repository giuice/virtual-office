11: interface ReactionChipsProps {
12:   reactions: MessageReaction[];
13:   currentUserId?: string;
14:   onReactionToggle: (emoji: string) => void;
15:   className?: string;
16: }
17: interface AggregatedReaction {
18:   emoji: string;
19:   count: number;
20:   userIds: string[];
21:   userReacted: boolean;
22:   latestTimestamp: Date;
23: }
24: const toDate = (value: unknown): Date => {
25:   if (value instanceof Date) {
26:     return value;
27:   }
28:   if (typeof value === 'string' || typeof value === 'number') {
29:     const parsed = new Date(value);
30:     if (!Number.isNaN(parsed.getTime())) {
31:       return parsed;
32:     }
33:   }
34:   return new Date(0);
35: };
36: export function ReactionChips({
37:   reactions,
38:   currentUserId,
39:   onReactionToggle,
40:   className
41: }: ReactionChipsProps) {
42:   const aggregatedReactions = useMemo(() => {
43:     const map = new Map<string, AggregatedReaction>();
44:     reactions.forEach(reaction => {
45:       const reactionTimestamp = toDate(reaction.timestamp);
46:       const existing = map.get(reaction.emoji);
47:       if (existing) {
48:         const alreadyReacted = existing.userIds.includes(reaction.userId);
49:         existing.userReacted = existing.userReacted || reaction.userId === currentUserId;
50:         if (!alreadyReacted) {
51:           existing.count++;
52:           existing.userIds.push(reaction.userId);
53:         }
54:         if (reactionTimestamp > existing.latestTimestamp) {
55:           existing.latestTimestamp = reactionTimestamp;
56:         }
57:       } else {
58:         map.set(reaction.emoji, {
59:           emoji: reaction.emoji,
60:           count: 1,
61:           userIds: [reaction.userId],
62:           userReacted: reaction.userId === currentUserId,
63:           latestTimestamp: reactionTimestamp
64:         });
65:       }
66:     });
67:     return Array.from(map.values()).sort((a, b) => {
68:       // Sort by most recent interaction first
69:       const timeDiff = b.latestTimestamp.getTime() - a.latestTimestamp.getTime();
70:       if (timeDiff !== 0) return timeDiff;
71:       // Then by emoji codepoint for determinism
72:       return a.emoji.localeCompare(b.emoji);
73:     });
74:   }, [reactions, currentUserId]);
75:   if (aggregatedReactions.length === 0) {
76:     return null;
77:   }
78:   const handleClick = (event: React.MouseEvent, emoji: string) => {
79:     event.stopPropagation();
80:     if (event.detail === 0) {
81:       // Keyboard activation is handled in onKeyDown to avoid double toggles.
82:       return;
83:     }
84:     onReactionToggle(emoji);
85:   };
86:   const handleKeyDown = (event: React.KeyboardEvent, emoji: string) => {
87:     if (event.key === 'Enter' || event.key === ' ') {
88:       event.preventDefault();
89:       event.stopPropagation();
90:       onReactionToggle(emoji);
91:     }
92:   };
93:   return <TooltipProvider delayDuration={300}>
94:       <div className={cn('flex flex-wrap gap-1 mt-1', className)}>
95:         {aggregatedReactions.map(({
96:         emoji,
97:         count,
98:         userReacted
99:       }) => <Tooltip key={emoji}>
100:             <TooltipTrigger asChild>
101:               <button type="button" className={cn('flex items-center gap-1 rounded-full px-2 py-0.5 text-xs 
transition-colors', 'hover:bg-accent focus:outline-none focus:ring-2 focus:ring-ring', userReacted ? 'bg-primary/20 
border border-primary' : 'bg-secondary border border-transparent')} onClick={event => handleClick(event, emoji)} 
onPointerDown={handlePointerDown} onKeyDown={event => handleKeyDown(event, emoji)} data-avatar-interactive 
data-testid={`reaction-chip-${emoji}`} aria-label={`${userReacted ? 'Remove' : 'Add'} ${emoji} reaction`}>
102:                 <span>{emoji}</span>
103:                 <span className="font-medium">{count}</span>
104:               </button>
105:             </TooltipTrigger>
106:             <TooltipContent>
107:               <p className="text-xs">
108:                 {count === 1 ? userReacted ? 'You reacted' : '1 reaction' : `${count} reactions`}
109:               </p>
110:             </TooltipContent>
111:           </Tooltip>)}
112:       </div>
113:     </TooltipProvider>;
114: }
