91: /**
92:  * The server confirmed the item (`message` stored or replayed; null when it
93:  * was deleted since). As for a direct send (useMessages.sendMessage): unless
94:  * the feed already observed the key or this client saw the message deleted,
95:  * merge the stored message into a loaded (or loading) feed first, then drop
96:  * the pending copy — never two bubbles, never none.
97:  */
98: export function showConfirmedOutboxMessage(
99:   queryClient: QueryClient,
100:   ownerId: string,
101:   conversationId: string,
102:   clientMessageId: string,
103:   message: Message | null
104: ): void {
105:   const pendingKey = pendingMessagesQueryKey(ownerId, conversationId);
106:   const feedKey = ['messages', conversationId] as const;
107:   const unresolved = isPendingMessage(queryClient.getQueryData<Message[]>(pendingKey), clientMessageId);
108:   const feed = queryClient.getQueryCache().find<MessagesInfiniteData>({ queryKey: feedKey, exact: true });
109:   // A feed never loaded is fetched (with this message) when it is opened; a
110:   // cache built from this one message would hide the older history.
111:   const feedPresent = Boolean(feed?.state.data) || feed?.state.fetchStatus === 'fetching';
112:   if (message && unresolved && feedPresent && !isMessageDeleted(queryClient, message.id)) {
113:     const confirmed: Message = {
114:       ...message,
115:       clientMessageId: normalizeClientMessageId(message.clientMessageId) ?? clientMessageId,
116:     };
117:     queryClient.setQueryData<MessagesInfiniteData | undefined>(feedKey, (oldData) =>
118:       appendMessageToPages(oldData, confirmed)
119:     );
120:     keepMessageThroughInflightFetch(queryClient, conversationId, confirmed);
121:   }
122:   queryClient.setQueryData<Message[]>(pendingKey, (current) =>
123:     (current ?? []).filter((pending) => normalizeClientMessageId(pending.clientMessageId) !== clientMessageId)
124:   );
125: }

