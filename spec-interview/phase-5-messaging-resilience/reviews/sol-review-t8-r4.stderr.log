2: // Phase 5 T8: IndexedDB storage of the message outbox (SPEC §9).
3: //
4: // Database `vo-messaging-outbox` (version 1):
5: // - store `items`: one OutboxItem per (ownerId, clientMessageId) (key path);
6: //   index `byConversationOrder` [ownerId, conversationId, order] (the drain
7: //   reads a conversation's oldest item) and `byOwnerOrder` [ownerId, order];
8: // - store `meta`: per-owner counter `{ ownerId, nextOrder }` that gives items
9: //   their creation order inside the same transaction as the item write, so
10: //   the order is shared by every tab of the browser.
11: // The connection closes on `versionchange` (an upgrade or a deletion from
12: // another tab or test is never blocked).
13: import type { OutboxItem } from '@/types/message-outbox';
14: 
15: export const OUTBOX_DB_NAME = 'vo-messaging-outbox';
16: const OUTBOX_DB_VERSION = 1;
17: const ITEMS_STORE = 'items';
18: const META_STORE = 'meta';
19: const BY_CONVERSATION_ORDER = 'byConversationOrder';
20: const BY_OWNER_ORDER = 'byOwnerOrder';
