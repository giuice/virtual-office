2: // Phase 5 T8: renders outbox items through the sender's pending store
3: // (['messages-pending', users.id, conversationId], T7) — the outbox is the
4: // durable source, the pending query only its render view.
5: import type { QueryClient } from '@tanstack/react-query';
6: 
7: import { MessageStatus, MessageType, type Message, type MessageDeliveryState } from '@/types/messaging';
8: import type { OutboxItem } from '@/types/message-outbox';
9: import {
10:   appendMessageToPages,
11:   isMessageDeleted,
12:   isPendingMessage,
13:   keepMessageThroughInflightFetch,
14:   normalizeClientMessageId,
15:   pendingMessagesQueryKey,
16:   PENDING_MESSAGE_ID_PREFIX,
17:   type MessagesInfiniteData,
18: } from '@/lib/messaging/message-cache';
19: 
20: const deliveryStateOf = (item: OutboxItem): MessageDeliveryState => {
21:   switch (item.state) {
22:     case 'waiting':
23:       return 'pending';
24:     case 'failed':
25:       return 'failed';
26:     case 'expired':
27:       return 'expired';
28:     default:
29:       // claimed / unknown: an attempt is (or may still be) in progress (FR-005).
30:       return 'sending';
31:   }
32: };
33: 
34: export function outboxItemToPendingMessage(item: OutboxItem): Message {
35:   const deliveryState = deliveryStateOf(item);
36:   return {
37:     id: `${PENDING_MESSAGE_ID_PREFIX}${item.clientMessageId}`,
38:     conversationId: item.conversationId,
39:     senderId: item.ownerId,
40:     content: item.content,
41:     timestamp: new Date(item.pressedSendAt),
42:     type: MessageType.TEXT,
43:     status: deliveryState === 'failed' || deliveryState === 'expired' ? MessageStatus.FAILED : 
MessageStatus.SENDING,
44:     replyToId: item.replyToId ?? undefined,
45:     reactions: [],
46:     isEdited: false,
47:     clientMessageId: item.clientMessageId,
48:     deliveryState,
49:   };
50: }
