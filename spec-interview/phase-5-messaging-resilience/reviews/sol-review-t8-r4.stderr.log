57: /** The page's outbox items, in creation order (read-only; never creates the database). */
58: async function readOutbox(page: Page): Promise<OutboxRow[]> {
59:   const rows = await page.evaluate(async (name: string) => {
60:     const databases = typeof indexedDB.databases === 'function' ? await indexedDB.databases() : [];
61:     if (!databases.some((database) => database.name === name)) return [];
62:     return new Promise<unknown[]>((resolve, reject) => {
63:       const request = indexedDB.open(name);
64:       request.onerror = () => reject(request.error);
65:       request.onsuccess = () => {
66:         const db = request.result;
67:         if (!db.objectStoreNames.contains('items')) {
68:           db.close();
69:           resolve([]);
70:           return;
71:         }
72:         const read = db.transaction('items', 'readonly').objectStore('items').getAll();
73:         read.onsuccess = () => {
74:           db.close();
75:           resolve(read.result);
76:         };
77:         read.onerror = () => {
78:           db.close();
79:           reject(read.error);
80:         };
81:       };
82:     });
83:   }, MESSAGING_OUTBOX_DB_NAME);
84:   return (rows as OutboxRow[]).sort((a, b) => a.order - b.order);
85: }
