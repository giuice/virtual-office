87: interface CreateAttempt {
88:   body: Record<string, unknown>;
89:   startSeq: number;
90:   endSeq?: number;
91:   startedAt: number;
92:   endedAt?: number;
93:   status?: number;
94:   failure?: string;
95: }
96: 
97: /** Every create request of the page, with the order in which requests started and ended. */
98: function trackCreates(page: Page): CreateAttempt[] {
99:   const attempts: CreateAttempt[] = [];
100:   const byRequest = new Map<Request, CreateAttempt>();
101:   let seq = 0;
102:   const isCreate = (request: Request) =>
103:     request.method() === 'POST' && new URL(request.url()).pathname === '/api/messages/create';
104:   page.on('request', (request) => {
105:     if (!isCreate(request)) return;
106:     seq += 1;
107:     const attempt: CreateAttempt = {
108:       body: (request.postDataJSON() ?? {}) as Record<string, unknown>,
109:       startSeq: seq,
110:       startedAt: Date.now(),
111:     };
112:     attempts.push(attempt);
113:     byRequest.set(request, attempt);
114:   });
115:   page.on('requestfinished', (request) => {
116:     const attempt = byRequest.get(request);
117:     if (!attempt) return;
118:     seq += 1;
119:     attempt.endSeq = seq;
120:     attempt.endedAt = Date.now();
121:     void request.response().then((response) => {
122:       attempt.status = response?.status();
123:     });
124:   });
125:   page.on('requestfailed', (request) => {
126:     const attempt = byRequest.get(request);
127:     if (!attempt) return;
128:     seq += 1;
129:     attempt.endSeq = seq;
130:     attempt.endedAt = Date.now();
131:     attempt.failure = request.failure()?.errorText ?? 'failed';
132:   });
133:   return attempts;
134: }
