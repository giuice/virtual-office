214: export async function cleanupPhase5World(
215:   request: APIRequestContext,
216:   world: Phase5World,
217: ): Promise<{ left: MessagingServerStateCounts; conversationsLeft: number }> {
218:   const response = await request.delete('/api/test/messaging/seed', {
219:     headers: seedHeaders(),
220:     data: {
221:       companyId: world.companyId,
222:       userIds: worldUserIds(world),
223:       conversationIds: worldConversationIds(world),
224:       messageIds: world.seededMessageIds,
225:       spaceIds: [world.roomSpaceId],
226:     },
227:   });
228:   if (!response.ok()) {
229:     throw new Error(`Failed to clean up the Phase 5 world: ${response.status()} ${await response.text()}`);
230:   }
231:   return withLocalMessagingDb(async (db) => {
232:     await cleanupMessagingServerState(db, worldUserIds(world));
233:     const left = await countMessagingServerState(db, worldUserIds(world));
234:     const { rows } = await db.query<{ count: number }>(
235:       'select count(*)::int as count from public.conversations where id = any($1::uuid[])',
236:       [worldConversationIds(world)],
237:     );
238:     return { left, conversationsLeft: rows[0].count };
239:   });
240: }
