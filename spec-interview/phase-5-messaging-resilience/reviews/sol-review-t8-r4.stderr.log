15: // Feed previews of a message's attachments (Phase 4 FR-011, AC-014, AC-037).
16: // Every read goes through the authorized route (`attachment.url`), which
17: // checks membership and redirects to a fresh short-lived signed URL; no
18: // signed URL is kept on the client, so an old feed can still open and
19: // download. Plain <img> on purpose: next/image's optimizer fetches the route
20: // without the user's session (400), and caching would outlive the signed URL.
21: 
22: interface MessageAttachmentsProps {
23:   attachments: readonly FileAttachment[];
24:   /** The message is still being sent: its files are not readable yet. */
25:   pending: boolean;
26: }
27: 
28: export function MessageAttachments({ attachments, pending }: MessageAttachmentsProps) {
29:   const images = attachments.filter((attachment) => attachmentPreviewKind(attachment) === 'image');
30:   const voiceNotes = attachments.filter(isVoiceNoteAttachment);
31:   const files = attachments.filter((attachment) => attachmentPreviewKind(attachment) === 'file');
32:   if (images.length === 0 && voiceNotes.length === 0 && files.length === 0) return null;
33: 
34:   return (
35:     <div className="flex min-w-0 flex-col gap-2" data-testid="message-attachments">
36:       {/* A voice note travels alone in its message (T15); one player each. */}
37:       {voiceNotes.map((attachment) => (
38:         <VoiceNotePlayer key={attachment.id} attachment={attachment} pending={pending} />
39:       ))}
40:       {images.length > 0 && (
41:         <ul aria-label="Imagens anexadas" className={cn('grid gap-1', images.length > 1 ? 'grid-cols-2' : 
'grid-cols-1')}>
42:           {images.map((attachment) => (
43:             <li key={attachment.id} className="min-w-0">
44:               <ImageThumbnail attachment={attachment} pending={pending} single={images.length === 1} />
45:             </li>
46:           ))}
47:         </ul>
48:       )}
49:       {files.length > 0 && (
50:         <ul aria-label="Arquivos anexados" className="flex min-w-0 flex-col gap-1">
51:           {files.map((attachment) => (
52:             <li key={attachment.id} className="min-w-0">
53:               <FileCard attachment={attachment} pending={pending} />
54:             </li>
55:           ))}
56:         </ul>
57:       )}
58:     </div>
59:   );
60: }
