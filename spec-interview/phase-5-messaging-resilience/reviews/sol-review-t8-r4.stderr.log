136: /**
137:  * D1 diagnostics (ms after reconnecting): when each text first showed on the
138:  * recipient's page (null = not yet), each create's start, duration and gap
139:  * before it, and the server's own duration of each create (dev-server log).
140:  */
141: async function d1Timing(
142:   recipient: Page,
143:   texts: readonly string[],
144:   creates: readonly CreateAttempt[],
145:   reconnectedAt: number,
146:   serverLines: readonly string[],
147: ): Promise<Record<string, unknown>> {
148:   const arrivals = await recipient
149:     .evaluate(() => (window as unknown as { __t8Arrivals?: ArrivalState }).__t8Arrivals ?? null)
150:     .catch(() => null);
151:   const serverCreates = serverLines
152:     .map((line) => line.replace(/\u001b\[[0-9;]*m/g, ''))
153:     .map((line) => /POST \/api\/messages\/create (\d{3}) in (\d+)ms(?: \(.*application-code: 
(\d+)ms\))?/.exec(line))
154:     .filter((match): match is RegExpExecArray => match !== null)
155:     .map((match) => ({ status: Number(match[1]), totalMs: Number(match[2]), appMs: match[3] ? Number(match[3]) : 
null }));
156:   return {
157:     arrivalsMs: texts.map((text) => (arrivals?.first[text] === undefined ? null : arrivals.first[text] - 
reconnectedAt)),
158:     createStartMs: creates.map((attempt) => attempt.startedAt - reconnectedAt),
159:     createMs: creates.map((attempt) => (attempt.endedAt === undefined ? null : attempt.endedAt - 
attempt.startedAt)),
160:     gapMs: creates.slice(1).map((attempt, index) => {
161:       const previousEnd = creates[index].endedAt;
162:       return previousEnd === undefined ? null : attempt.startedAt - previousEnd;
163:     }),
164:     failures: creates.map((attempt) => attempt.failure ?? null),
165:     serverCreates,
166:   };
167: }
168: 
169: /** BR-003: each create of the conversation started only after the previous one ended. */
170: function expectNoOverlap(attempts: readonly CreateAttempt[]): void {
171:   for (let index = 1; index < attempts.length; index += 1) {
172:     const previous = attempts[index - 1];
173:     expect(previous.endSeq, `create ${index - 1} ended`).toBeDefined();
174:     expect(attempts[index].startSeq, `create ${index} starts after create ${index - 1} ended`).toBeGreaterThan(
175:       previous.endSeq as number,
176:     );
177:   }
178: }
