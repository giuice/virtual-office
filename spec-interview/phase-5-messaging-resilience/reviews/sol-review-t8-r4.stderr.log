27: /** The outbox cannot be read or written (storage blocked, quota, failed write) — FR-033. */
28: export class OutboxStorageError extends Error {
29:   constructor(message: string, readonly cause?: unknown) {
30:     super(message);
31:     this.name = 'OutboxStorageError';
32:   }
33: }
34: 
35: export function isOutboxStorageError(error: unknown): error is OutboxStorageError {
36:   return error instanceof OutboxStorageError;
