177: /** The owner's items of one conversation (or of all), in creation order. */
178: export function listOutboxItems(ownerId: string, conversationId?: string): Promise<OutboxItem[]> {
179:   return inTransaction<OutboxItem[]>('readonly', ({ items }, done) => {
180:     const request = conversationId
181:       ? items
182:           .index(BY_CONVERSATION_ORDER)
183:           .getAll(IDBKeyRange.bound([ownerId, conversationId, -Infinity], [ownerId, conversationId, Infinity]))
184:       : items.index(BY_OWNER_ORDER).getAll(IDBKeyRange.bound([ownerId, -Infinity], [ownerId, Infinity]));
185:     request.onsuccess = () => done(request.result as OutboxItem[]);
186:   });
187: }
