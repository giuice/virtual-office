157:  * - otherwise → appended to page 0, the newest window.
158:  * Pending messages live outside this cache (pendingMessagesQueryKey) and are
159:  * matched to stored ones by key only (visiblePendingMessages).
160:  */
161: export function appendMessageToPages(
162:   oldData: MessagesInfiniteData | undefined,
163:   message: Message
164: ): MessagesInfiniteData {
165:   if (!oldData || !oldData.pages || oldData.pages.length === 0) {
166:     return { pages: [{ messages: [message] }], pageParams: [undefined] };
167:   }
168: 
169:   for (const page of oldData.pages) {
170:     if (page.messages.some((existing) => existing.id === message.id)) {
171:       return oldData;
172:     }
173:   }
174: 
175:   const pages = [...oldData.pages];
176:   pages[0] = { ...pages[0], messages: [...pages[0].messages, message] };
177:   return { ...oldData, pages };
178: }
