188: /** Every stored message of the conversation with one of `texts` (any key), oldest first. */
189: async function storedWithTexts(conversationId: string, texts: readonly string[]): Promise<StoredRow[]> {
190:   return withLocalMessagingDb(async (db) => {
191:     const result = await db.query<StoredRow>(
192:       `select id::text as id, client_message_id::text as key, content, reply_to_id::text as reply_to_id,
193:               sender_id::text as sender_id
194:          from public.messages
195:         where conversation_id = $1 and content = any($2::text[])
196:         order by "timestamp", id`,
197:       [conversationId, [...texts]],
198:     );
199:     return result.rows;
200:   });
201: }
