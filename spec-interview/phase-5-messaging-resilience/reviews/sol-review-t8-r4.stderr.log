41:  * conversation and key): once the feed holds the stored message — from a
42:  * Realtime INSERT, a feed fetch or the create response, in any order — the
43:  * pending copy is hidden, so the message is one bubble. Content, timestamps
44:  * and reply targets are never compared; a stored message without a key (an
45:  * unkeyed or pre-Phase-4 create) matches nothing.
46:  */
47: export function visiblePendingMessages(stored: readonly Message[], pending: readonly Message[]): Message[] {
48:   if (pending.length === 0) return [];
49:   const storedKeys = new Set<string>();
50:   for (const message of stored) {
51:     const key = correlationKey(message);
52:     if (key) storedKeys.add(key);
53:   }
54:   return pending.filter((message) => {
55:     const key = correlationKey(message);
