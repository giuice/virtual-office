52: /**
53:  * Replaces the outbox copies of a conversation's pending view with `items`
54:  * (in creation order), keeping the pending copies that are not outbox items
55:  * (attachment/voice sends, which are never queued).
56:  */
57: export function writeOutboxView(
58:   queryClient: QueryClient,
59:   ownerId: string,
60:   conversationId: string,
61:   items: readonly OutboxItem[]
62: ): void {
63:   const outboxCopies = [...items].sort((a, b) => a.order - b.order).map(outboxItemToPendingMessage);
64:   const outboxKeys = new Set(outboxCopies.map((message) => message.clientMessageId));
65:   queryClient.setQueryData<Message[]>(pendingMessagesQueryKey(ownerId, conversationId), (current) => {
66:     const others = (current ?? []).filter(
67:       (message) =>
68:         message.deliveryState === undefined && !outboxKeys.has(normalizeClientMessageId(message.clientMessageId) 
?? '')
69:     );
70:     if (others.length === 0) return outboxCopies;
71:     return [...others, ...outboxCopies].sort((a, b) => a.timestamp.getTime() - b.timestamp.getTime());
72:   });
73: }
74: 
75: /**
76:  * Shows one just-committed item in its conversation's pending view (added, or
77:  * replacing its earlier copy), without reading the outbox again.
78:  */
79: export function publishOutboxItem(queryClient: QueryClient, item: OutboxItem): void {
80:   const copy = outboxItemToPendingMessage(item);
81:   queryClient.setQueryData<Message[]>(pendingMessagesQueryKey(item.ownerId, item.conversationId), (current) =>
82:     [
83:       ...(current ?? []).filter(
84:         (message) => normalizeClientMessageId(message.clientMessageId) !== item.clientMessageId
85:       ),
86:       copy,
87:     ].sort((a, b) => a.timestamp.getTime() - b.timestamp.getTime())
88:   );
89: }
