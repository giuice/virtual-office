30: const UUID_PATTERN = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
31: const MESSAGE_TYPES = new Set<string>(Object.values(MessageType));
32: const MESSAGE_STATUSES = new Set<string>(Object.values(MessageStatus));
33: 
34: const isValidTimestamp = (value: unknown): boolean =>
35:   (typeof value === 'string' || typeof value === 'number') && !Number.isNaN(new Date(value).getTime());
36: 
37: const isUuid = (value: unknown): value is string => typeof value === 'string' && UUID_PATTERN.test(value);
38: 
39: /**
40:  * Whether `message` is the stored message of `item`, complete enough to render
41:  * in the feed. Correlation uses only what can never change for a stored
42:  * message: a UUID `id`, the sender (users.id), the conversation and the
43:  * composition key (case-insensitive). The stored text and reply target are
44:  * NOT compared with the item's: they may legitimately differ on a replay (the
45:  * reply target deleted since → no reply target; an edited text) and the
46:  * server answers an unchanged replay with the stored message. Their types
47:  * must still be renderable: `content` a string, `replyToId` absent, null or a
48:  * UUID. Also a parseable `timestamp`, a known `type` and `status`, and
49:  * `reactions` absent or a list — all fields the route always returns for a
50:  * created or replayed keyed message. Anything else (an empty object, an
51:  * array, another message, missing text, a malformed reply target) confirms
52:  * nothing.
53:  */
54: export function isStoredMessageOf(message: unknown, item: AttemptedItem): message is Record<string, unknown> {
55:   if (typeof message !== 'object' || message === null || Array.isArray(message)) return false;
56:   const candidate = message as Record<string, unknown>;
57:   return (
58:     isUuid(candidate.id) &&
59:     candidate.senderId === item.senderId &&
60:     candidate.conversationId === item.conversationId &&
61:     typeof candidate.clientMessageId === 'string' &&
62:     candidate.clientMessageId.toLowerCase() === item.clientMessageId.toLowerCase() &&
63:     typeof candidate.content === 'string' &&
64:     (candidate.replyToId === undefined || candidate.replyToId === null || isUuid(candidate.replyToId)) &&
65:     isValidTimestamp(candidate.timestamp) &&
66:     typeof candidate.type === 'string' &&
67:     MESSAGE_TYPES.has(candidate.type) &&
68:     typeof candidate.status === 'string' &&
69:     MESSAGE_STATUSES.has(candidate.status) &&
70:     (candidate.reactions === undefined || Array.isArray(candidate.reactions))
71:   );
72: }
73: 
74: export function classifyAttemptResponse(
75:   response: { status: number; code?: string; message?: unknown },
76:   item: AttemptedItem
77: ): OutboxAttemptOutcome {
78:   const { status, code, message } = response;
79:   if (status >= 200 && status < 300) {
80:     // Only 200/201 with this item's stored message confirm it.
81:     return (status === 200 || status === 201) && isStoredMessageOf(message, item)
82:       ? { kind: 'delivered', message: toStoredMessage(message) }
83:       : { kind: 'unknown', status };
84:   }
85:   if (status === 410 && code === 'MESSAGE_DELETED') return { kind: 'delivered', message: null };
86:   if (status === 429 || status === 401) return { kind: 'transient', status };
87:   if (status >= 500 || status < 200 || (status >= 300 && status < 400)) return { kind: 'unknown', status };
88:   if (status === 409 && code === 'ATTEMPT_SUPERSEDED') return { kind: 'superseded' };
89:   return { kind: 'failed', status, reason: failureReason(status, code) };
90: }
91: 
92: function failureReason(status: number, code: string | undefined): OutboxFailureReason {
93:   if (status === 403 && code === 'SENDER_MISMATCH') return 'sender_mismatch';
94:   if (status === 403) return 'not_participant';
95:   if (status === 409 && code === 'CLIENT_MESSAGE_ID_REUSED') return 'client_message_id_reused';
96:   if (status === 413) return 'content_too_large';
97:   if (status === 400) return 'invalid_request';
98:   return 'rejected';
99: }
