1119:   test('review r3 #1: a committed reply whose parent is deleted before its replay is confirmed by the replay, 
and the next item drains', async ({
1120:     phase5World,
1121:     openDevice,
1122:   }) => {
1123:     const { directId } = phase5World.conversations;
1124:     const a = await openDevice('A');
1125:     const b = await openDevice('B');
1126:     const parentText = `t8 parent to delete ${randomUUID()}`;
1127:     const parentId = await createViaApi(a.page, { conversationId: directId, content: parentText });
1128:     await openConversation(b.page, directId);
1129:     await waitForRealtimeReady(b.page);
1130:     const replyText = `t8 reply lost response ${randomUUID()}`;
1131:     const laterText = `t8 after the replay ${randomUUID()}`;
1132:     await watchArrivals(b.page, [laterText]);
1133: 
1134:     // A queues a reply to its own message, then a later message, offline; the
1135:     // next tab never loads this conversation's feed, so only a create
1136:     // response can confirm them (not the feed or Realtime).
1137:     await openConversation(a.page, directId);
1138:     await goOffline(a.page);
1139:     await a.page.getByTestId(`reply-button-${parentId}`).click();
1140:     await expect(composer(a.page).getByTestId('reply-composer-preview')).toContainText(parentText);
1141:     await sendFromComposer(a.page, replyText);
1142:     await expect(composerInput(a.page)).toHaveValue('');
1143:     await sendFromComposer(a.page, laterText);
1144:     await expect(composerInput(a.page)).toHaveValue('');
1145:     await expect.poll(async () => (await readOutbox(a.page)).length).toBe(2);
1146:     const [reply, later] = await readOutbox(a.page);
1147:     expect([reply.content, reply.replyToId, later.content, later.replyToId]).toEqual([replyText, parentId, 
laterText, null]);
1148:     await a.page.evaluate(() => window.localStorage.removeItem('messaging_active_conversation_id'));
1149:     await a.page.close();
1150: 
1151:     // Attempt 1 reaches the server, which stores the reply; the page gets a
1152:     // network failure instead of the 201. The next attempt waits until A has
1153:     // deleted the reply's parent; then everything passes through.
1154:     const attempts: Array<{ body: Record<string, unknown>; serverStatus?: number }> = [];
1155:     let parentDeleted!: () => void;
1156:     const parentGone = new Promise<void>((resolve) => {
1157:       parentDeleted = resolve;
1158:     });
1159:     const reopened = await a.newTab();
1160:     await reopened.route('**/api/messages/create', async (route: Route) => {
1161:       const attempt: { body: Record<string, unknown>; serverStatus?: number } = {
1162:         body: (route.request().postDataJSON() ?? {}) as Record<string, unknown>,
1163:       };
1164:       attempts.push(attempt);
1165:       if (attempts.length === 2) await parentGone;
1166:       const response = await route.fetch();
1167:       attempt.serverStatus = response.status();
1168:       if (attempts.length === 1) {
1169:         await route.abort('failed');
1170:         return;
1171:       }
1172:       await route.fulfill({ response });
1173:     });
1174:     await a.context.setOffline(false);
1175:     await reopened.goto('/floor-plan');
1176:     await expect.poll(() => attempts[0]?.serverStatus, { timeout: STEP_TIMEOUT_MS }).toBe(201);
1177:     const [storedReply] = await storedWithTexts(directId, [replyText]);
1178:     expect(storedReply.reply_to_id).toBe(parentId);
1179: 
1180:     // A deletes its own parent message from another session (Data API under
1181:     // RLS): the stored reply's reply target becomes null.
1182:     expect(await deleteOwnMessageFromAnotherSession(a.user, parentId)).toBe(1);
1183:     await expect
1184:       .poll(async () => (await storedWithTexts(directId, [replyText]))[0]?.reply_to_id ?? null)
1185:       .toBeNull();
1186:     parentDeleted();
1187: 
1188:     // The replay (200, stored message without a reply target) confirms the
1189:     // reply, and the later message is sent.
1190:     await expect.poll(async () => (await readOutbox(reopened)).length, { timeout: STEP_TIMEOUT_MS }).toBe(0);
1191:     expect(attempts.map((attempt) => [attempt.body.clientMessageId, attempt.body.attemptGeneration, 
attempt.serverStatus])).toEqual([
1192:       [reply.clientMessageId, 1, 201],
1193:       [reply.clientMessageId, 2, 200],
1194:       [later.clientMessageId, 1, 201],
