297:   private async drainLoop(conversationId: string): Promise<void> {
298:     // A delivered item is removed together with the next claim (one
299:     // transaction), or on its own when the drain stops before that. Its
300:     // stored message is shown right after the next create is dispatched, so
301:     // rendering it does not delay that create (D1).
302:     let confirmedKey: string | null = null;
303:     let showConfirmed: (() => void) | null = null;
304:     const flushShow = () => {
305:       showConfirmed?.();
306:       showConfirmed = null;
307:     };
308:     try {
309:       while (!this.disposed && isOnline()) {
310:         const claim = await claimOldestOutboxItem(
311:           this.ownerId,
312:           conversationId,
313:           this.tabId,
314:           CLAIM_LEASE_MS,
315:           confirmedKey
316:         );
317:         confirmedKey = null;
318:         if (claim.kind !== 'claimed') {
319:           if (claim.kind === 'empty') this.drain(conversationId).retryDelayMs = RETRY_BASE_MS;
320:           return;
321:         }
322:         const { item } = claim;
323:         this.showItem(item);
324:         const attempt = this.attempt(item);
325:         flushShow();
326:         const outcome = await attempt;
327:         if (this.disposed) return;
328:         this.trace('attempt', { conversationId, generation: item.attemptGeneration, outcome: outcome.kind });
329:         if (outcome.kind === 'delivered') {
330:           const { message } = outcome;
331:           this.confirmDelivered(item);
332:           this.confirmedNotShown.add(item.clientMessageId);
333:           showConfirmed = () => {
334:             this.confirmedNotShown.delete(item.clientMessageId);
335:             showConfirmedOutboxMessage(this.queryClient, this.ownerId, conversationId, item.clientMessageId, 
message);
336:           };
337:           confirmedKey = item.clientMessageId;
338:           continue;
339:         }
340:         await this.recordUndelivered(item, outcome);
341:         return;
342:       }
343:     } finally {
344:       if (!this.disposed) flushShow();
345:       if (confirmedKey !== null) await deleteOutboxItem(this.ownerId, confirmedKey);
346:     }
347:   }
348: 
349:   private async attempt(item: OutboxItem): Promise<OutboxAttemptOutcome> {
350:     try {
351:       const response = await messagingApi.createMessageAttempt({
352:         conversationId: item.conversationId,
353:         content: item.content,
354:         replyToId: item.replyToId,
355:         clientMessageId: item.clientMessageId,
356:         attemptGeneration: item.attemptGeneration,
357:         expectedSenderId: this.ownerId,
358:         mentionIds: item.mentionIds,
359:       });
360:       return classifyAttemptResponse(response, {
361:         senderId: this.ownerId,
362:         conversationId: item.conversationId,
363:         clientMessageId: item.clientMessageId,
364:       });
365:     } catch {
366:       // No response (network error, the browser went offline mid-request).
367:       return { kind: 'unknown', status: null };
368:     }
369:   }
370: 
371:   /**
372:    * The server confirmed the item: from now on it is never shown again as
373:    * pending (its stored message is shown by the drain, showConfirmedOutboxMessage).
374:    */
375:   private confirmDelivered(item: OutboxItem): void {
376:     const { conversationId, clientMessageId } = item;
377:     this.markConfirmed(clientMessageId);
378:     this.drain(conversationId).keys.delete(clientMessageId);
379:     this.drain(conversationId).retryDelayMs = RETRY_BASE_MS;
380:   }
381: 
382:   /** Records an outcome other than delivered; the drain of the conversation stops. */
383:   private async recordUndelivered(
384:     item: OutboxItem,
385:     outcome: Exclude<OutboxAttemptOutcome, { kind: 'delivered' }>
386:   ): Promise<void> {
387:     const { conversationId, clientMessageId } = item;
388:     const ownAttempt = (current: OutboxItem) =>
389:       current.claimHolder === this.tabId && current.attemptGeneration === item.attemptGeneration;
390:     const now = Date.now();
391:     if (outcome.kind === 'failed') {
392:       const current = await updateOutboxItem(this.ownerId, clientMessageId, (stored) =>
393:         ownAttempt(stored)
394:           ? { ...stored, state: 'failed', failureReason: outcome.reason, claimHolder: null, leaseExpiresAt: null, 
updatedAt: now }
395:           : undefined
396:       );
397:       await this.showStored(conversationId, current);
398:       return;
399:     }
400:     // transient → waiting; unknown / superseded → unknown (it may be stored).
401:     const state = outcome.kind === 'transient' ? 'waiting' : 'unknown';
402:     const current = await updateOutboxItem(this.ownerId, clientMessageId, (stored) =>
403:       ownAttempt(stored) ? { ...stored, state, claimHolder: null, leaseExpiresAt: null, updatedAt: now } : 
undefined
404:     );
405:     await this.showStored(conversationId, current);
406:     this.scheduleRetry(conversationId);
407:   }
