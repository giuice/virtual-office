12:  * - `unknown`: an attempt ended without a usable response (network error,
13:  *   5xx, a superseded claim) — it may or may not be stored;
14:  * - `failed`: definitively rejected (`failureReason`); no automatic attempt,
15:  *   later items of the conversation wait (BR-003);
16:  * - `expired`: not stored 24 h after send (BR-006; set by T9).
17:  */
18: export type OutboxItemState = 'waiting' | 'claimed' | 'unknown' | 'failed' | 'expired';
19: 
20: /** Why a `failed` item was rejected (BR-005 definitive classes). */
21: export type OutboxFailureReason =
22:   | 'not_participant'
23:   | 'sender_mismatch'
24:   | 'client_message_id_reused'
25:   | 'content_too_large'
26:   | 'invalid_request'
