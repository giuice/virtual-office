1: import { existsSync, readFileSync, statSync } from 'node:fs';
2: 
3: /**
4:  * Phase 5 T24 — raw log lines of the local app server, readable by tests.
5:  *
6:  * The Phase 5 runner (playwright.messaging-phase5.config.ts) starts the dev
7:  * server through scripts/playwright-server-log-tee.mjs, which copies every
8:  * stdout/stderr line, unmodified, to the file named by
9:  * VO_E2E_SERVER_LOG_FILE. Lines are read here exactly as the server printed
10:  * them — before any sanitization (no ANSI stripping, no redaction) — so a test
11:  * can, for example, scan the real `console.info` metric lines (AC-028) for
12:  * forbidden content. A test reads only the lines written after its own mark.
13:  *
14:  * Usage:
15:  *   const mark = serverLog.mark();
16:  *   // ... act ...
17:  *   const line = await serverLog.waitForLine((l) => l.includes('"type":"send_outcome"'), { since: mark });
18:  *   const all = serverLog.linesSince(mark);
19:  */
20: export interface ServerLogMark {
21:   /** Byte offset in the log file when the mark was taken. */
22:   readonly offset: number;
23: }
24: 
25: export interface ServerLog {
26:   /** Absolute path of the raw log file. */
27:   readonly path: string;
28:   /** Marks the current end of the log; later reads start here. */
29:   mark(): ServerLogMark;
30:   /** Complete lines (without their line terminator) written since `since`. */
31:   linesSince(since: ServerLogMark): string[];
32:   /**
33:    * Polls until a complete line written since `since` matches, and returns it.
34:    * Throws with the number of lines seen when `timeoutMs` (default 10 s) passes.
35:    */
36:   waitForLine(
37:     match: (line: string) => boolean,
38:     options: { since: ServerLogMark; timeoutMs?: number },
39:   ): Promise<string>;
40: }
41: 
42: export const SERVER_LOG_FILE_ENV = 'VO_E2E_SERVER_LOG_FILE';
43: 
44: const POLL_INTERVAL_MS = 100;
45: 
46: function readBytesFrom(path: string, offset: number): Buffer {
47:   if (!existsSync(path)) {
48:     throw new Error(`The raw server log ${path} does not exist; run through the Phase 5 runner.`);
49:   }
50:   const content = readFileSync(path);
51:   // The tee truncates the file when a new server starts; a mark from before
52:   // that restart reads the whole new file.
53:   return content.length >= offset ? content.subarray(offset) : content;
54: }
55: 
56: function completeLines(bytes: Buffer): string[] {
57:   const lastNewline = bytes.lastIndexOf(0x0a);
58:   if (lastNewline < 0) return [];
59:   return bytes
60:     .subarray(0, lastNewline)
61:     .toString('utf8')
62:     .split('\n')
63:     .map((line) => (line.endsWith('\r') ? line.slice(0, -1) : line));
64: }
65: 
66: export function openServerLog(path = process.env[SERVER_LOG_FILE_ENV]): ServerLog {
67:   if (!path) {
68:     throw new Error(`${SERVER_LOG_FILE_ENV} is not set: raw server logs exist only under the Phase 5 runner.`);
69:   }
70:   const logPath = path;
71:   return {
72:     path: logPath,
73:     mark() {
74:       return { offset: existsSync(logPath) ? statSync(logPath).size : 0 };
75:     },
76:     linesSince(since) {
77:       return completeLines(readBytesFrom(logPath, since.offset));
78:     },
79:     async waitForLine(match, { since, timeoutMs = 10_000 }) {
80:       const deadline = Date.now() + timeoutMs;
81:       let seen = 0;
82:       for (;;) {
83:         const lines = completeLines(readBytesFrom(logPath, since.offset));
84:         seen = lines.length;
85:         const found = lines.find(match);
86:         if (found !== undefined) return found;
87:         if (Date.now() >= deadline) {
88:           throw new Error(`No matching server log line within ${timeoutMs} ms (${seen} line(s) since the mark).`);
89:         }
90:         await new Promise((resolve) => setTimeout(resolve, POLL_INTERVAL_MS));
91:       }
92:     },
93:   };
94: }
