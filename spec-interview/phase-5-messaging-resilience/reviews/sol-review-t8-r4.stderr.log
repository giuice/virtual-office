7: export type OutboxAttemptOutcome =
8:   /** Stored (201) or replayed (200); `message` is null when it was deleted since (410). */
9:   | { kind: 'delivered'; message: Message | null }
10:   /** 429 / 401: retried automatically, in order (FR-008; 401 vs session end → T11). */
11:   | { kind: 'transient'; status: number }
12:   /**
13:    * No usable response (network error, 5xx, any 2xx without this item's
14:    * stored message — e.g. a 204 or a malformed body): it may be stored, so the
15:    * item is kept and sent again.
16:    */
17:   | { kind: 'unknown'; status: number | null }
18:   /** 409 ATTEMPT_SUPERSEDED: a newer attempt of the key exists; ignored. */
19:   | { kind: 'superseded' }
20:   /** Definitive 4xx: no automatic retry (FR-007). */
21:   | { kind: 'failed'; status: number; reason: OutboxFailureReason };
22: 
23: /** The item an attempt was made for: a confirmation must be its own stored message. */
24: export interface AttemptedItem {
25:   senderId: string;
26:   conversationId: string;
27:   clientMessageId: string;
