202: /**
203:  * Keeps a just-merged message (a resolved send, a realtime INSERT) in the
204:  * feed when a fetch of that feed is already in flight.
205:  *
206:  * A fetch resolves with the server rows it read when it started and replaces
207:  * the cached pages. If the message was committed after that read, the result
208:  * lacks it and would silently drop it from the feed until some later
209:  * refetch. Once the in-flight fetch settles the message is merged again
210:  * (a no-op when the result already has it). If the message leaves the cache
211:  * while the fetch is still running (deleted, or a failed send rolled back),
212:  * it is not brought back, and neither is a message this client has seen
213:  * deleted by a Realtime DELETE (isMessageDeleted) by the time the fetch
214:  * settles.
215:  */
216: export function keepMessageThroughInflightFetch(
217:   queryClient: QueryClient,
218:   conversationId: string,
219:   message: Message
220: ): void {
221:   const queryKey = messagesQueryKey(conversationId);
222:   const queryCache = queryClient.getQueryCache();
223:   const query = queryCache.find<MessagesInfiniteData>({ queryKey, exact: true });
224:   if (!query || query.state.fetchStatus !== 'fetching') {
225:     return;
226:   }
227: 
228:   const unsubscribe = queryCache.subscribe((event) => {
229:     if (event.query !== query) {
230:       return;
231:     }
232:     if (event.type === 'removed') {
233:       unsubscribe();
234:       return;
235:     }
236:     if (event.type !== 'updated') {
237:       return;
238:     }
239:     if (query.state.fetchStatus === 'fetching') {
240:       // Until the fetch settles, data only changes through local updates.
241:       if (!isMessageCached(query.state.data, message.id)) {
242:         unsubscribe();
243:       }
244:       return;
245:     }
246:     unsubscribe();
247:     if (isMessageDeleted(queryClient, message.id)) {
248:       return;
249:     }
250:     queryClient.setQueryData<MessagesInfiniteData | undefined>(queryKey, (oldData) =>
251:       oldData ? appendMessageToPages(oldData, message) : oldData
252:     );
253:   });
