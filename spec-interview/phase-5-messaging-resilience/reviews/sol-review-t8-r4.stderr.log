1: // src/hooks/useMessageOutbox.ts
2: // Phase 5 T8: runs the signed-in user's durable message outbox (one per
3: // application user, users.id) for as long as the messaging provider is
4: // mounted, and returns the function that queues a text/reply send.
5: import { useCallback, useEffect, useRef } from 'react';
6: import { useQueryClient } from '@tanstack/react-query';
7: 
8: import { MessageOutbox } from '@/lib/messaging/outbox/message-outbox';
9: import type { OutboxEnqueueInput } from '@/types/message-outbox';
10: 
11: export type QueueTextMessage = (input: OutboxEnqueueInput) => Promise<void>;
12: 
13: export function useMessageOutbox(ownerId: string | null | undefined): QueueTextMessage {
14:   const queryClient = useQueryClient();
15:   const outboxRef = useRef<MessageOutbox | null>(null);
16: 
17:   useEffect(() => {
18:     if (!ownerId) return;
19:     const outbox = new MessageOutbox(ownerId, queryClient);
20:     outboxRef.current = outbox;
21:     outbox.start();
22:     return () => {
23:       outbox.dispose();
24:       if (outboxRef.current === outbox) outboxRef.current = null;
25:     };
26:   }, [ownerId, queryClient]);
27: 
28:   return useCallback(
29:     async (input: OutboxEnqueueInput) => {
30:       const outbox = outboxRef.current;
31:       if (!outbox || outbox.ownerId !== ownerId) {
32:         throw new Error('The message outbox is not ready');
33:       }
34:       await outbox.enqueue(input);
35:     },
36:     [ownerId]
37:   );
38: }

