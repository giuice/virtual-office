69: export function observeStoredMessages(queryClient: QueryClient, observer: StoredMessageObserver): () => void {
70:   let observers = storedMessageObservers.get(queryClient);
71:   if (!observers) {
72:     observers = new Set();
73:     storedMessageObservers.set(queryClient, observers);
74:   }
75:   observers.add(observer);
