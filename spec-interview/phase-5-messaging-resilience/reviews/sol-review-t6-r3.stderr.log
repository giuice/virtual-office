 422:   it('request-budget charges survive refused insertions, which never charge the insertion quota', async () => {
 423:     await ensureWindowHeadroom();
 424:     const { primary, directConversationId: conversationId } = world;
 425: 
 426:     // A generation-less keyed create rolled back by the commit-time fence check.
 427:     const fencedKey = randomUUID();
 428:     expect((await postFence(primary, { conversationId, ...attempt(primary, fencedKey, 1) 
})).body.outcome).toBe('not_stored');
 429:     const fenced = await postCreate(primary, { conversationId, content: `T3 fenced ${fencedKey}`, 
clientMessageId: fencedKey });
 430:     expect(fenced.status).toBe(409);
 431:     expect(fenced.body.code).toBe('ATTEMPT_SUPERSEDED');
 432: 
 433:     // A keyed attachment create rolled back by the database (upload unknown).
 434:     const missingKey = randomUUID();
 435:     const missing = await postCreate(primary, { conversationId, content: '', clientMessageId: missingKey, 
attachmentIds: [randomUUID()] });
 436:     expect(missing.status).toBe(400);
 437:     expect(missing.body.code).toBe('ATTACHMENT_NOT_FOUND');
 438: 
 439:     expect(await counter(primary, 'message:create-request')).toBe(2);
 440:     expect(await counter(primary, 'message:create')).toBe(0);
 441: 
 442:     // A quota loser: the insertion and its own quota increment roll back; the
 443:     // request-budget charge stays; the uploads stay pending.
 444:     const uploadId = await upload(primary, conversationId);
 445:     await fill(primary, 'message:create', INSERTION_QUOTA);
 446:     const loserKey = randomUUID();
 447:     const loserBody = { conversationId, content: `T3 loser ${loserKey}`, ...attempt(primary, loserKey, 1), 
attachmentIds: [uploadId] };
 448:     expectRateLimited(await postCreate(primary, loserBody));
 449:     expect(await counter(primary, 'message:create')).toBe(INSERTION_QUOTA);
 450:     expect(await counter(primary, 'message:create-request')).toBe(3);
 451:     expect(await keyRows(primary, conversationId, loserKey)).toHaveLength(0);
 452:     expect(await pendingUpload(uploadId)).toBe(true);
 453:     const loserAttempt = await attemptRows(primary, conversationId, loserKey);
 454:     expect(loserAttempt).toHaveLength(1);
 455:     expect(loserAttempt[0].committed_at).toBeNull();
 456: 
 457:     // Once quota is available again the same attempt commits with its file.
 458:     await fill(primary, 'message:create', 0);
 459:     const retried = await postCreate(primary, loserBody);
 460:     expect(retried.status, JSON.stringify(retried.body)).toBe(201);
 461:     expect(retried.body.message?.attachments?.map((file) => file.id)).toEqual([uploadId]);
 462:     expect(await counter(primary, 'message:create')).toBe(1);
 463:     expect(await counter(primary, 'message:create-request')).toBe(4);
 464:   });
