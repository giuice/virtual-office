 212:   async function keyRows(sender: MessagingDbUser, conversationId: string, clientMessageId: string) {
 213:     return world.query<{ id: string }>(
 214:       `select id from public.messages where sender_id = $1 and conversation_id = $2 and client_message_id = $3`,
 215:       [sender.appUserId, conversationId, clientMessageId],
 216:     );
 217:   }
