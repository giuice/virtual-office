 206:     form.append('conversationId', conversationId);
 207:     const result = await call(uploadRoute, user, new NextRequest('http://localhost/api/messages/upload', { 
method: 'POST', body: form }));
 208:     expect(result.status, JSON.stringify(result.body)).toBe(201);
 209:     return result.body.attachment?.id as string;
 210:   }
