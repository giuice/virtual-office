  14: import { createMessagingWorld, type MessagingDbUser, type MessagingDbWorld } from './fixtures';
  15: import { asSession, signInSessionCookies, useLocalSupabaseEnv, type SessionCookie } from './route-session';
  16: import { MESSAGING_ANON_KEY, MESSAGING_API_URL, MESSAGING_DB_URL, MESSAGING_SERVICE_ROLE_KEY } from './setup';
  17: 
  18: vi.mock('next/headers', async () => (await import('./route-session')).nextHeadersMock);
  19: 
  20: interface RouteBody {
  21:   message?: { id: string; attachments?: { id: string }[] } | null;
  22:   outcome?: 'stored' | 'not_stored';
  23:   attachment?: { id: string };
  24:   code?: string;
  25:   error?: string;
  26: }
  27: 
  28: interface RouteResult {
  29:   status: number;
  30:   body: RouteBody;
  31: }
  32: 
  33: type RouteHandler = (request: NextRequest) => Promise<Response>;
  34: 
  35: type BudgetAction = 'message:create' | 'message:create-request' | 'message:fence';
  36: 
  37: // Budgets of src/lib/auth/rate-limit.ts (all 60-second fixed windows).
  38: const INSERTION_QUOTA = 30;
  39: const REQUEST_BUDGET = 60;
  40: const FENCE_BUDGET = 90;
  41: const WINDOW_SECONDS = 60;
  42: 
  43: const PNG_BYTES = Uint8Array.from([0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a, 5, 6, 7, 8]);
  44: 
  45: // SQL that makes the limiter fail for real, and restores it.
  46: const REVOKE_LIMITER = 'revoke execute on function public.check_rate_limit(uuid, text, integer, integer) from 
service_role';
  47: const RESTORE_LIMITER = 'grant execute on function public.check_rate_limit(uuid, text, integer, integer) to 
service_role';
  48: const BREAK_INSERTION_COUNTER = `alter table private.rate_limit_counters
  49:   add constraint t3_test_insertion_counter_unavailable check (action <> 'message:create') not valid`;
  50: const RESTORE_INSERTION_COUNTER =
  51:   'alter table private.rate_limit_counters drop constraint if exists t3_test_insertion_counter_unavailable';
  52: const CREATE_ATTEMPT_FN =
  53:   'public.create_message_attempt(uuid, uuid, text, text, uuid, uuid, bigint, jsonb, uuid[], integer, integer)';
  54: const FENCE_ATTEMPT_FN = 'public.fence_message_attempt(uuid, uuid, uuid, bigint)';
  55: // Infrastructure (grant) failures, and their restoration.
  56: const GRANT_FAILURES = {
  57:   createFunction: [`revoke execute on function ${CREATE_ATTEMPT_FN} from service_role`, `grant execute on 
function ${CREATE_ATTEMPT_FN} to service_role`],
  58:   fenceFunction: [`revoke execute on function ${FENCE_ATTEMPT_FN} from service_role`, `grant execute on function 
${FENCE_ATTEMPT_FN} to service_role`],
  59:   messageRows: [
  60:     'revoke select on table public.messages from service_role',
  61:     'grant select on table public.messages to service_role',
  62:   ],
  63:   attemptTable: [
  64:     'revoke update on table private.message_send_attempts from service_role',
  65:     'grant update on table private.message_send_attempts to service_role',
  66:   ],
  67: } as const;
  68: 
  69: // Phase 5 T3 (FR-008, AC-009, AC-035): message send budgets on the real
  70: // POST /api/messages/create and POST /api/messages/fence handlers, real local
  71: // sessions, the real check_rate_limit counter, and the insertion quota charged
  72: // inside public.create_message_attempt's transaction on the local database.
  73: describe('message send budgets (local Supabase)', () => {
  74:   let world: MessagingDbWorld;
  75:   let admin: SupabaseClient;
  76:   const sessions = new Map<string, SessionCookie[]>();
  77: 
  78:   async function restoreLimiter(): Promise<void> {
  79:     await world.query(RESTORE_LIMITER);
  80:     await world.query(RESTORE_INSERTION_COUNTER);
  81:     for (const [, restore] of Object.values(GRANT_FAILURES)) {
  82:       await world.query(restore);
  83:     }
  84:   }
  85: 
  86:   beforeAll(async () => {
  87:     useLocalSupabaseEnv();
  88:     world = await createMessagingWorld({ historyMessageCount: 0 });
  89:     // A previous run killed mid-test must not leave the limiter broken.
  90:     await restoreLimiter();
  91:     admin = createClient(MESSAGING_API_URL, MESSAGING_SERVICE_ROLE_KEY, {
  92:       auth: { persistSession: false, autoRefreshToken: false },
  93:     });
  94:     for (const user of [world.primary, world.secondary, world.outsider]) {
  95:       sessions.set(user.appUserId, await signInSessionCookies(user.email));
  96:     }
  97:   });
  98: 
  99:   beforeEach(async () => {
 100:     await resetCounters();
 101:   });
 102: 
 103:   afterAll(async () => {
 104:     vi.unstubAllEnvs();
 105:     if (world) {
 106:       await restoreLimiter();
 107:       const conversations = [world.directConversationId, world.groupConversationId, world.roomConversationId];
 108:       const objects = await world.query<{ name: string }>(
 109:         `select name from storage.objects
 110:          where bucket_id = $1 and split_part(name, '/', 2) = any($2::text[])`,
 111:         [ATTACHMENTS_BUCKET, conversations],
 112:       );
 113:       if (objects.length > 0) {
 114:         await admin.storage.from(ATTACHMENTS_BUCKET).remove(objects.map((object) => object.name));
 115:       }
 116:       await world.cleanup();
 117:     }
 118:   });
 119: 
 120:   function worldUserIds(): string[] {
 121:     return [world.primary.appUserId, world.secondary.appUserId, world.outsider.appUserId];
 122:   }
 123: 
 124:   async function resetCounters(): Promise<void> {
 125:     await world.query('delete from private.rate_limit_counters where user_id = any($1::uuid[])', 
[worldUserIds()]);
 126:   }
 127: 
 128:   /**
 129:    * Fixed windows: wait for the next window when fewer than `seconds` remain
 130:    * in the current one, so a test's charges and fills share one window.
 131:    */
 132:   async function ensureWindowHeadroom(seconds = 25): Promise<void> {
 133:     const [{ remaining }] = await world.query<{ remaining: string }>(
 134:       `select ($1::numeric - (extract(epoch from clock_timestamp())::numeric % $1::numeric))::text as remaining`,
 135:       [WINDOW_SECONDS],
 136:     );
 137:     const left = Number(remaining);
 138:     if (left < seconds) {
 139:       await new Promise((resolve) => setTimeout(resolve, Math.ceil(left * 1000) + 250));
 140:     }
 141:     await resetCounters();
 142:   }
 143: 
 144:   /** Sets the user's counter for the current window (as if `count` charges were made). */
 145:   async function fill(user: MessagingDbUser, action: BudgetAction, count: number): Promise<void> {
 146:     await world.query(
 147:       `insert into private.rate_limit_counters (user_id, action, window_start, count)
 148:        values ($1, $2, to_timestamp(floor(extract(epoch from now()) / $3) * $3), $4)
 149:        on conflict (user_id, action, window_start) do update set count = excluded.count`,
 150:       [user.appUserId, action, WINDOW_SECONDS, count],
 151:     );
 152:   }
 153: 
 154:   async function counter(user: MessagingDbUser, action: BudgetAction): Promise<number> {
 155:     const [{ total }] = await world.query<{ total: string }>(
 156:       `select coalesce(sum(count), 0)::text as total from private.rate_limit_counters
 157:        where user_id = $1 and action = $2`,
 158:       [user.appUserId, action],
 159:     );
 160:     return Number(total);
 161:   }
 162: 
 163:   async function allCounters(): Promise<number> {
 164:     const [{ total }] = await world.query<{ total: string }>(
 165:       `select coalesce(sum(count), 0)::text as total from private.rate_limit_counters where user_id = 
any($1::uuid[])`,
 166:       [worldUserIds()],
 167:     );
 168:     return Number(total);
 169:   }
 170: 
 171:   function cookiesOf(user: MessagingDbUser | null): SessionCookie[] {
 172:     return user ? (sessions.get(user.appUserId) ?? []) : [];
 173:   }
 174: 
 175:   function jsonRequest(path: string, body: unknown): NextRequest {
 176:     return new NextRequest(`http://localhost${path}`, {
 177:       method: 'POST',
 178:       headers: { 'content-type': 'application/json' },
 179:       body: typeof body === 'string' ? body : JSON.stringify(body),
 180:     });
 181:   }
 182: 
 183:   async function call(route: RouteHandler, user: MessagingDbUser | null, request: NextRequest): 
Promise<RouteResult> {
 184:     return asSession(cookiesOf(user), async () => {
 185:       const response = await route(request);
 186:       return { status: response.status, body: (await response.json()) as RouteBody };
 187:     });
 188:   }
 189: 
 190:   /** `body` as a string is sent verbatim (malformed JSON). */
 191:   function postCreate(user: MessagingDbUser | null, body: Record<string, unknown> | string) {
 192:     return call(createRoute, user, jsonRequest('/api/messages/create', body));
 193:   }
