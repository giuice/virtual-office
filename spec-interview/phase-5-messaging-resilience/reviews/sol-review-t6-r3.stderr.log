 112: set local lock_timeout = '5s';
 113: 
 114: create or replace function public.check_rate_limit(
 115:   p_user_id uuid,
 116:   p_action text,
 117:   p_limit integer,
 118:   p_window_seconds integer
 119: ) returns boolean
 120: language plpgsql
 121: security definer
 122: set search_path = ''
 123: as $$
 124: declare
 125:   v_window_start timestamptz;
 126:   v_count integer;
 127: begin
 128:   -- Phase 5 T3: insertion-quota charges are serialized per user with the
 129:   -- window read after the lock (private.charge_message_insertion_quota), so a
 130:   -- delayed charge can never recreate an older, already cleaned-up window.
 131:   if p_action = 'message:create' then
 132:     return private.charge_message_insertion_quota(p_user_id, p_limit, p_window_seconds);
 133:   end if;
 134: 
 135:   -- Phase 5 T6 r2: every other action is serialized per (user, action) until
 136:   -- commit, and its window is read from the wall clock after the lock (not
 137:   -- from the transaction start), so serialized checks see non-decreasing
 138:   -- windows and a delayed check can never recreate a cleaned-up window.
 139:   perform pg_catalog.pg_advisory_xact_lock(
 140:     pg_catalog.hashtextextended('virtual_office.rate_limit:' || p_user_id::text || ':' || p_action, 0)
 141:   );
 142: 
 143:   v_window_start := pg_catalog.to_timestamp(
 144:     (pg_catalog.floor(extract(epoch from pg_catalog.clock_timestamp()) / p_window_seconds) * 
p_window_seconds)::double precision
 145:   );
 146: 
 147:   insert into private.rate_limit_counters as c (user_id, action, window_start, count)
 148:   values (p_user_id, p_action, v_window_start, 1)
 149:   on conflict (user_id, action, window_start)
 150:   do update set count = c.count + 1
 151:   returning count into v_count;
 152: 
 153:   -- Older windows of this (user, action) can no longer be charged (every
 154:   -- later check is serialized behind this one and reads a later clock).
 155:   delete from private.rate_limit_counters c
 156:   where c.user_id = p_user_id
 157:     and c.action = p_action
 158:     and c.window_start < v_window_start;
 159: 
 160:   return v_count <= p_limit;
 161: end;
 162: $$;
