 374:     const key = randomUUID();
 375:     const valid = { conversationId, content: `T3 budget ${key}`, clientMessageId: key };
 376: 
 377:     const charged: [string, Record<string, unknown> | string, number][] = [
 378:       ['malformed JSON', '{"conversationId":', 400],
 379:       ['array body', '[]', 400],
 380:       ['missing content', { conversationId }, 400],
 381:       ['invalid conversation id', { conversationId: 'nope', content: 'x' }, 400],
 382:       ['content too large', { conversationId, content: 'x'.repeat(8193) }, 413],
 383:       ['invalid key', { conversationId, content: 'x', clientMessageId: 'nope' }, 400],
 384:       ['generation without expected sender', { conversationId, content: 'x', clientMessageId: randomUUID(), 
attemptGeneration: 1 }, 400],
