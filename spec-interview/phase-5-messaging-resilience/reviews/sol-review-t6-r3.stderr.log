 333:   it('a replay of an already-stored message does not reduce the insertion quota', async () => {
 334:     await ensureWindowHeadroom();
 335:     const { primary, directConversationId: conversationId } = world;
 336:     const legacyKey = randomUUID();
 337:     const attemptKey = randomUUID();
 338:     const legacy = { conversationId, content: `T3 replay legacy ${legacyKey}`, clientMessageId: legacyKey };
 339:     const current = { conversationId, content: `T3 replay attempt ${attemptKey}`, ...attempt(primary, 
attemptKey, 1) };
 340: 
 341:     expect((await postCreate(primary, legacy)).status).toBe(201);
 342:     expect((await postCreate(primary, current)).status).toBe(201);
 343:     expect(await counter(primary, 'message:create')).toBe(2);
 344: 
 345:     for (let index = 0; index < 3; index += 1) {
 346:       expect((await postCreate(primary, legacy)).status).toBe(200);
 347:       expect((await postCreate(primary, current)).status).toBe(200);
 348:     }
 349:     expect(await counter(primary, 'message:create')).toBe(2);
 350:     expect(await counter(primary, 'message:create-request')).toBe(8);
 351: 
 352:     // With the insertion quota exhausted, replays still answer the stored
 353:     // message; new insertions (keyed or not) are refused and store nothing.
 354:     await fill(primary, 'message:create', INSERTION_QUOTA);
 355:     expect((await postCreate(primary, legacy)).status).toBe(200);
 356:     const replay = await postCreate(primary, current);
 357:     expect(replay.status).toBe(200);
 358:     expect(replay.body.message?.id).toBeDefined();
 359: 
 360:     const freshKey = randomUUID();
 361:     expectRateLimited(await postCreate(primary, { conversationId, content: `T3 refused ${freshKey}`, 
clientMessageId: freshKey }));
 362:     expect(await keyRows(primary, conversationId, freshKey)).toHaveLength(0);
 363:     expect(await attemptRows(primary, conversationId, freshKey)).toHaveLength(0);
 364:     const unkeyed = `T3 refused unkeyed ${randomUUID()}`;
 365:     expectRateLimited(await postCreate(primary, { conversationId, content: unkeyed }));
 366:     expect(await contentRows(conversationId, unkeyed)).toHaveLength(0);
 367:     expect(await keyRows(primary, conversationId, legacyKey)).toHaveLength(1);
 368:     expect(await keyRows(primary, conversationId, attemptKey)).toHaveLength(1);
 369:   });
