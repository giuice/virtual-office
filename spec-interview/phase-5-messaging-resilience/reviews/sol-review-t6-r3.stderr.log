 409:     expectRateLimited(await postCreate(primary, valid));
 410:     const blockedKey = randomUUID();
 411:     expectRateLimited(await postCreate(primary, { conversationId, content: `T3 blocked ${blockedKey}`, 
...attempt(primary, blockedKey, 1) }));
 412:     expect(await keyRows(primary, conversationId, blockedKey)).toHaveLength(0);
 413:     expect(await attemptRows(primary, conversationId, blockedKey)).toHaveLength(0);
 414:     expect(await counter(primary, 'message:create')).toBe(0);
 415:     expect(await counter(primary, 'message:fence')).toBe(0);
