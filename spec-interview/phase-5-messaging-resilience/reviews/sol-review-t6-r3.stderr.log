 702:   it('a delayed insertion that started before a window rollover cannot reopen an exhausted insertion quota', 
async () => {
 703:     await resetCounters();
 704:     const { primary, directConversationId: conversationId } = world;
 705:     // Product limits are 30 per 60 s; the database function takes the window
 706:     // from its caller, so a short window exercises a real rollover quickly.
 707:     const window = 5;
 708:     const tag = randomUUID();
 709:     const create = `select public.create_message_attempt($1, $2, $3, 'text', $4, null, null, null, '{}'::uuid[], 
1, $5) as result`;
 710:     const target = await insertRawMessage(primary, conversationId, `T3 rollover target ${tag}`);
 711: 
 712:     const firstWindow = await waitForWindowStart(window, 1.5);
 713:     await world.query(create, [conversationId, primary.appUserId, `T3 rollover ${tag} first`, null, window]);
 714: 
 715:     const lock = await lockMessageRow(target);
 716:     const delayed = new Client({ connectionString: MESSAGING_DB_URL });
 717:     await delayed.connect();
 718:     const delayedPid = (await delayed.query<{ pid: number }>('select pg_backend_pid() as pid')).rows[0].pid;
 719:     try {
 720:       const outcome = delayed
 721:         .query(create, [conversationId, primary.appUserId, `T3 rollover ${tag} delayed`, target, window])
 722:         .then(
 723:           () => 'committed',
 724:           (error: Error) => error.message,
 725:         );
 726:       await waitForBlockedBy(lock.pid, delayedPid);
 727:       const [{ started }] = await world.query<{ started: string }>(
 728:         `select floor(extract(epoch from xact_start) / $1)::text as started from pg_catalog.pg_stat_activity 
where pid = $2`,
 729:         [window, delayedPid],
 730:       );
 731:       // The delayed insertion's transaction started in the exhausted window.
 732:       expect(Number(started)).toBe(firstWindow);
 733: 
 734:       const nextWindow = await waitForWindowStart(window, 2, firstWindow);
 735:       expect(nextWindow).toBe(firstWindow + 1);
 736:       // A next-window insertion commits (and cleans the older window up).
 737:       await world.query(create, [conversationId, primary.appUserId, `T3 rollover ${tag} next`, null, window]);
 738: 
 739:       await lock.release();
 740:       expect(await outcome).toBe('RATE_LIMITED');
 741:       expect((await windowPosition(window)).index).toBe(nextWindow);
 742:     } finally {
 743:       await lock.release();
 744:       await delayed.end();
 745:     }
 746:     const stored = await world.query(`select 1 from public.messages where conversation_id = $1 and content like 
$2`, [
 747:       conversationId,
 748:       `T3 rollover ${tag} %`,
 749:     ]);
 750:     expect(stored).toHaveLength(2);
 751:     await resetCounters();
 752:   });
 753: 
 754:   it('a Phase 4 limiter charge delayed across a rollover cannot reopen an exhausted insertion quota', async () 
=> {
 755:     await resetCounters();
 756:     const { primary, directConversationId: conversationId } = world;
 757:     const window = 5;
 758:     const tag = randomUUID();
 759:     const create = `select public.create_message_attempt($1, $2, $3, 'text', null, null, null, null, 
'{}'::uuid[], 1, $4) as result`;
 760: 
 761:     const firstWindow = await waitForWindowStart(window, 1.5);
 762:     // The new writer exhausts the first window (limit 1).
 763:     await world.query(create, [conversationId, primary.appUserId, `T3 mixed ${tag} first`, window]);
 764: 
 765:     // A Phase 4 server's route-level limiter call (public.check_rate_limit,
 766:     // 'message:create') whose transaction started in the exhausted window and
 767:     // runs only after the rollover.
 768:     const legacy = new Client({ connectionString: MESSAGING_DB_URL });
 769:     await legacy.connect();
 770:     try {
 771:       await legacy.query('begin');
 772:       const [{ started }] = (
 773:         await legacy.query<{ started: string }>('select floor(extract(epoch from now()) / $1)::text as started', 
[window])
 774:       ).rows;
 775:       expect(Number(started)).toBe(firstWindow);
 776: 
 777:       const nextWindow = await waitForWindowStart(window, 2, firstWindow);
 778:       expect(nextWindow).toBe(firstWindow + 1);
 779:       // The new writer commits in the next window (and cleans the first up).
 780:       await world.query(create, [conversationId, primary.appUserId, `T3 mixed ${tag} next`, window]);
 781: 
 782:       const [{ allowed }] = (
 783:         await legacy.query<{ allowed: boolean }>(`select public.check_rate_limit($1, 'message:create', 1, $2) as 
allowed`, [
 784:           primary.appUserId,
 785:           window,
 786:         ])
 787:       ).rows;
 788:       expect(allowed).toBe(false);
 789:       await legacy.query('commit');
 790:       expect((await windowPosition(window)).index).toBe(nextWindow);
 791:     } finally {
 792:       await legacy.query('rollback').catch(() => undefined);
 793:       await legacy.end();
 794:     }
 795:     // The first window was not recreated by the delayed legacy charge.
 796:     const [{ first }] = await world.query<{ first: string }>(
 797:       `select count(*)::text as first from private.rate_limit_counters
 798:        where user_id = $1 and action = 'message:create' and window_start = to_timestamp($2::bigint * $3)`,
 799:       [primary.appUserId, firstWindow, window],
 800:     );
 801:     expect(first).toBe('0');
 802:     // Other actions keep the original limiter behavior.
 803:     const [{ other }] = await world.query<{ other: boolean }>(
 804:       `select public.check_rate_limit($1, 'message:react', 1, 60) as other`,
 805:       [primary.appUserId],
 806:     );
 807:     expect(other).toBe(true);
 808:     await resetCounters();
 809:   });
 810: 
 811:   // Phase 5 T6 r2: every non-'message:create' action of public.check_rate_limit
 812:   // (route budgets 'message:create-request', 'message:fence',
 813:   // 'messaging:metrics', and the fail-open actions) is serialized per (user,
 814:   // action) with its window read from clock_timestamp() after the lock
 815:   // (migration 20261008012709). Before it, a check whose transaction started
 816:   // in an exhausted window W0 and ran after a W1 check had cleaned W0 up
 817:   // recreated W0 at count 1 and returned true.
 818:   it.each(['message:create-request', 'message:fence', 'messaging:metrics'] as const)(
 819:     'a %s check delayed across a rollover cannot reopen an exhausted bucket or recreate the old one',
 820:     async (action) => {
 821:       await resetCounters();
 822:       const { primary } = world;
 823:       const window = 5;
 824:       const check = 'select public.check_rate_limit($1, $2, 1, $3) as allowed';
 825:       const bucketCount = async (index: number): Promise<number> => {
 826:         const [{ total }] = await world.query<{ total: string }>(
 827:           `select coalesce(sum(count), 0)::text as total from private.rate_limit_counters
 828:            where user_id = $1 and action = $2 and window_start = to_timestamp($3::bigint * $4)`,
 829:           [primary.appUserId, action, index, window],
 830:         );
 831:         return Number(total);
 832:       };
 833: 
 834:       const firstWindow = await waitForWindowStart(window, 1.5);
 835:       // The first window's budget (limit 1) is used up.
 836:       const [{ allowed: first }] = await world.query<{ allowed: boolean }>(check, [primary.appUserId, action, 
window]);
 837:       expect(first).toBe(true);
 838: 
 839:       // A check whose transaction starts in the exhausted first window and
 840:       // reaches the limiter only after the rollover (a slow route request).
 841:       const delayed = new Client({ connectionString: MESSAGING_DB_URL });
 842:       await delayed.connect();
 843:       try {
 844:         await delayed.query('begin');
 845:         const [{ started }] = (
 846:           await delayed.query<{ started: string }>('select floor(extract(epoch from now()) / $1)::text as 
started', [window])
 847:         ).rows;
 848:         expect(Number(started)).toBe(firstWindow);
 849: 
 850:         const nextWindow = await waitForWindowStart(window, 2, firstWindow);
 851:         expect(nextWindow).toBe(firstWindow + 1);
 852:         // The next window's budget is used up too (and the first is cleaned up).
 853:         const [{ allowed: next }] = await world.query<{ allowed: boolean }>(check, [primary.appUserId, action, 
window]);
 854:         expect(next).toBe(true);
 855:         expect(await bucketCount(firstWindow)).toBe(0);
 856: 
 857:         const [{ allowed }] = (
 858:           await delayed.query<{ allowed: boolean }>(check, [primary.appUserId, action, window])
 859:         ).rows;
 860:         expect(allowed).toBe(false);
 861:         await delayed.query('commit');
 862:         expect((await windowPosition(window)).index).toBe(nextWindow);
 863:         // The delayed check was charged to the current window and did not
 864:         // recreate the first one.
 865:         expect(await bucketCount(firstWindow)).toBe(0);
 866:         expect(await bucketCount(nextWindow)).toBe(2);
 867:       } finally {
 868:         await delayed.query('rollback').catch(() => undefined);
 869:         await delayed.end();
 870:       }
 871:       await resetCounters();
 872:     },
 873:   );
