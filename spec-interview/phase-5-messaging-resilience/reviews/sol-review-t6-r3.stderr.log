 226:   async function attemptRows(sender: MessagingDbUser, conversationId: string, clientMessageId: string) {
 227:     return world.query<{ fence_generation: string | null; committed_at: Date | null }>(
 228:       `select fence_generation::text as fence_generation, committed_at from private.message_send_attempts
 229:        where sender_id = $1 and conversation_id = $2 and client_message_id = $3`,
