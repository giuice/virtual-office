clientMessageId: loserKey }));
 396:     expect(await counter(primary, 'message:create-request')).toBe(charged.length + 1);
 397: 
 398:     // Unauthenticated requests are refused without charging anyone.
 399:     const before = await allCounters();
 400:     expect((await postCreate(null, '{"conversationId":')).status).toBe(401);
 401:     expect((await postCreate(null, valid)).status).toBe(401);
