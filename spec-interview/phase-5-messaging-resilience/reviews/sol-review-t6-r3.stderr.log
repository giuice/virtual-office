 470:     expect((await postFence(primary, { conversationId, ...attempt(primary, randomUUID(), 1) 
})).status).toBe(200);
 471:     expect((await postFence(primary, '{"conversationId":')).status).toBe(400);
 472:     expect((await postFence(primary, { conversationId, ...attempt(secondary, randomUUID(), 1) 
})).status).toBe(403);
