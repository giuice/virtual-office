 386:       ['missing conversation', { conversationId: randomUUID(), content: 'x' }, 403],
 387:       ['new keyed create', valid, 201],
 388:       ['replay', valid, 200],
 389:     ];
 390:     for (const [label, body, status] of charged) {
 391:       expect((await postCreate(primary, body)).status, label).toBe(status);
