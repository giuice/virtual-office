# Example environment for Virtual Office. Copy to .env.local and fill in.
# Never commit real values. Only NEXT_PUBLIC_* variables reach the browser.

# --- Phase 6 meeting notes: AI processing tickets (server-only) ---
# HMAC-SHA256 secret that signs AI processing tickets. Required for AI
# processing: without it (or with fewer than 32 bytes) the ticket and start
# routes refuse with a configuration error; there is no fallback.
# Generate one, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Leave no placeholder here: an empty value is refused, never used.
MEETING_NOTES_TICKET_SECRET=
# Optional, verification only: set it to the PREVIOUS secret during a
# rotation so tickets issued before the rotation stay valid for their 24 hours.
# Leave empty otherwise.
MEETING_NOTES_TICKET_SECRET_PREVIOUS=

# --- Phase 6 meeting notes: AI provider deadline (server-only, optional) ---
# Deadline of one provider request in milliseconds, 1000–300000 (default
# 180000). Must stay far below the 10-minute stale-operation job.
MEETING_NOTES_AI_TIMEOUT_MS=
